# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-cronsim
pkgver=2.8
pkgrel=1
pkgdesc='Cron expression parser and evaluator'
arch=('any')
url='https://github.com/cuu508/cronsim'
license=('BSD-3-Clause')
depends=('python')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools')
source=("git+https://github.com/cuu508/cronsim.git#tag=$pkgver")
sha512sums=('8ba443b0f9491de8c9924d33c57d99e6a6164de0892becd4b7f4a5c2718bd104eea1f5992f14f939eb149e5f4ef7ea2c4258442584dc00dc1796c29c1d561eb0')

build() {
  cd cronsim
  python -m build --wheel --no-isolation
}

check() {
  cd cronsim
  python -m unittest discover -s tests
}

package() {
  cd cronsim
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
