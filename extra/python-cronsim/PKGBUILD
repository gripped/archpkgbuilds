# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-cronsim
pkgver=2.9
pkgrel=1
pkgdesc='Cron expression parser and evaluator'
arch=('any')
url='https://github.com/cuu508/cronsim'
license=('BSD-3-Clause')
depends=('python')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools')
source=("git+https://github.com/cuu508/cronsim.git#tag=$pkgver")
sha512sums=('a33c467aea83ce403ebeb738f75467c53d74549d5e33e45d25efdddbe3c8c2a0a337bb4210f5c13891b376237a9111d460d7b7c761cb37c0fc71fef833d05e77')

build() {
  cd cronsim
  python -m build --wheel --no-isolation
}

check() {
  cd cronsim
  python -m unittest discover -s tests
}

package() {
  cd cronsim
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
