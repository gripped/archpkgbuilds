pkgname=zsnes
pkgver=2.3.2
pkgrel=1
pkgdesc='Classic Super Nintendo emulator'
url='https://github.com/xyproto/zsnes'
arch=(x86_64)
license=(GPL-2.0-only)
depends=(hicolor-icon-theme libpng opengl-driver pipewire sdl3)
makedepends=(git mesa python)
source=("git+$url#tag=$pkgver")
b2sums=('73251477fc314b56f348d0d198fb9283010fcd33150f63ddfa8a24c1c716d8b926676002a561ebc188cf934580a695123def9518f8bdd93d20a2c45608f3a23e')

build() {
  make -C $pkgname
}

package() {
  DESTDIR="$pkgdir" make -C $pkgname install
}
