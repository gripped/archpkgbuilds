pkgname=zsnes
pkgver=2.3.8
pkgrel=1
pkgdesc='Classic Super Nintendo emulator'
url='https://github.com/xyproto/zsnes'
arch=(x86_64)
license=(GPL-2.0-only)
depends=(hicolor-icon-theme libpng opengl-driver pipewire sdl3)
makedepends=(git mesa python)
source=("git+$url#tag=$pkgver")
b2sums=('35f2cb6f41582b30b17949cafffcd08de5c4453476325074e42c18972765abfb1b1ba756848e146a4994c8c14a4f1dfdbd31588d66c594e72ca9ac7ce77f692e')

build() {
  make -C $pkgname
}

package() {
  DESTDIR="$pkgdir" make -C $pkgname install
}
