pkgname=zsnes
pkgver=2.3.0
pkgrel=1
pkgdesc='Super Nintendo emulator'
url='https://github.com/xyproto/zsnes'
arch=(x86_64)
license=(GPL-2.0-only)
depends=(hicolor-icon-theme libpng opengl-driver pipewire sdl3)
makedepends=(git mesa python)
source=("git+$url#tag=$pkgver")
b2sums=('dd195ffcdd27881f191469bd6d4ec432746793f3b98aa59afa429235fb999224864aae4f62545de4501272558bae46aafa447cf93339973e5d4dd732fde3c71e')

build() {
  make -C $pkgname
}

package() {
  DESTDIR="$pkgdir" make -C $pkgname install
}
