pkgname=zsnes
pkgver=2.3.6
pkgrel=1
pkgdesc='Classic Super Nintendo emulator'
url='https://github.com/xyproto/zsnes'
arch=(x86_64)
license=(GPL-2.0-only)
depends=(hicolor-icon-theme libpng opengl-driver pipewire sdl3)
makedepends=(git mesa python)
source=("git+$url#tag=$pkgver")
b2sums=('e403f0727433800219882bbecac5110f4d9100410daa1660a08b4b5ccab23829cb3fe2614da38bbd84d4e631d865071a2dfdd2efc914b1976004dac618ea10ca')

build() {
  make -C $pkgname
}

package() {
  DESTDIR="$pkgdir" make -C $pkgname install
}
