pkgname=zsnes
pkgver=2.3.3
pkgrel=1
pkgdesc='Classic Super Nintendo emulator'
url='https://github.com/xyproto/zsnes'
arch=(x86_64)
license=(GPL-2.0-only)
depends=(hicolor-icon-theme libpng opengl-driver pipewire sdl3)
makedepends=(git mesa python)
source=("git+$url#tag=$pkgver")
b2sums=('5e1126e91cb151e45aa0261d4bb5625fef48f5a89cd62e48c6f932789913f57ed251e0bc0235eee8504c9a96bfa4ca2667b96153757b578fce2f79b4b8c35dd2')

build() {
  make -C $pkgname
}

package() {
  DESTDIR="$pkgdir" make -C $pkgname install
}
