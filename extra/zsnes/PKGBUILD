pkgname=zsnes
pkgver=2.3.10
pkgrel=1
pkgdesc='Classic Super Nintendo emulator'
url='https://github.com/xyproto/zsnes'
arch=(x86_64)
license=(GPL-2.0-only)
depends=(hicolor-icon-theme libpng opengl-driver pipewire sdl3)
makedepends=(git mesa python)
source=("git+$url#tag=v$pkgver")
b2sums=('35c7d8c545f2510f8759690d91761569c7feab737f4dfce70d5768984b7ad260d8ffc426126f18445f7de3b6f5429e401fa241ef8003d1d0d5f983fa4693ba2c')

build() {
  make -C $pkgname
}

package() {
  DESTDIR="$pkgdir" make -C $pkgname install
}
