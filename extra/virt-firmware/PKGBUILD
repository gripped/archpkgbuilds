# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=virt-firmware
pkgver=26.4
pkgrel=1
pkgdesc="Collection of tools for edk2 firmware images"
arch=(any)
url="https://gitlab.com/kraxel/virt-firmware"
license=(GPL-2.0-or-later)
depends=(
  python
  python-cryptography
  python-passlib
  python-pefile
  python-pyyaml
)
makedepends=(
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-pytest
  systemd  # tests require systemd-detect-virt(?!)
)
optdepends=(
  'python-crc32c: for faster CRC checks'
)
source=($url/-/archive/v$pkgver/$pkgname-v$pkgver.tar.gz)
sha512sums=('62c60aeed1aeee72ee6dd475c4479d601a8bcb73b839a6b34d2d638cf1e0f0d8803c7f6267ceced966e6f78c6a2361223caf58dc720a7ce94f181e9ea9a4db2b')
b2sums=('e6f45df1be7d451cb9a7963554caac9d359cfd464a32516ce18c628ae84f41fc6e0deaa22e2f7fda972228f9a66c8078e9e9231050506b79c1d312a66b64c917')

build() {
  cd $pkgname-v$pkgver
  python -m build --wheel --no-isolation
}

check() {
  local _site_packages=$(python -c "import site; print(site.getsitepackages()[0])")

  cd $pkgname-v$pkgver
  python -m installer --destdir=test_dir dist/*.whl
  export PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH"

  pytest -vv tests/tests.py
}

package() {
  cd $pkgname-v$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 man/virt-*.1 -t "$pkgdir/usr/share/man/man1/"
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
