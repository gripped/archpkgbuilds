# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=virt-firmware
pkgver=26.8
pkgrel=1
pkgdesc="Collection of tools for edk2 firmware images"
arch=(any)
url="https://gitlab.com/kraxel/virt-firmware"
license=(GPL-2.0-or-later)
depends=(
  python
  python-crypt_r
  python-cryptography
  python-pefile
  python-pyyaml
)
makedepends=(
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-pytest
  systemd  # tests require systemd-detect-virt(?!)
)
optdepends=(
  'python-crc32c: for faster CRC checks'
  'python-requests: for QEMU test integration'
)
source=($url/-/archive/v$pkgver/$pkgname-v$pkgver.tar.gz)
sha512sums=('beeb34972f7588dfc102a32bcb0d3ffb800ae696d81666886e86db3012e8784112cf1ca359da60aa529309c699e914ae9fc15c12b2d920bbea257465abd2a08e')
b2sums=('0537e59098c8bb3829aa3ae5a652e707f001df4653f056b3b3411e0898babfc4e018ebcd68cd8f382c7b30b792c55e2bf688955a386001f082b6680c03395968')

build() {
  cd $pkgname-v$pkgver
  python -m build --wheel --no-isolation
}

check() {
  local _site_packages=$(python -c "import site; print(site.getsitepackages()[0])")

  cd $pkgname-v$pkgver
  python -m installer --destdir=test_dir dist/*.whl
  export PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH"

  pytest -vv tests/tests.py
}

package() {
  cd $pkgname-v$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 man/virt-*.1 -t "$pkgdir/usr/share/man/man1/"
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
