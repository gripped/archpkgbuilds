# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=virt-firmware
pkgver=26.7.1
pkgrel=1
pkgdesc="Collection of tools for edk2 firmware images"
arch=(any)
url="https://gitlab.com/kraxel/virt-firmware"
license=(GPL-2.0-or-later)
depends=(
  python
  python-crypt_r
  python-cryptography
  python-pefile
  python-pyyaml
)
makedepends=(
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-pytest
  systemd  # tests require systemd-detect-virt(?!)
)
optdepends=(
  'python-crc32c: for faster CRC checks'
  'python-requests: for QEMU test integration'
)
source=($url/-/archive/v$pkgver/$pkgname-v$pkgver.tar.gz)
sha512sums=('fdaea50e32468777deac6894e7187d748e6ff7dd6236aa12383dff08d09fcb11bd09408a4e9358dd1f3dd45b09288c93ff86c7e9e98e7447fa9f654eba3f2913')
b2sums=('b16be8da7e74f14ab001f2a1d628f20c5d97aea8b609c8ee888205a3e03816d9cfd2ffd1572a153308d8af3cc7b87d3314214ad7d13e521f71a2ecf1494d78ef')

build() {
  cd $pkgname-v$pkgver
  python -m build --wheel --no-isolation
}

check() {
  local _site_packages=$(python -c "import site; print(site.getsitepackages()[0])")

  cd $pkgname-v$pkgver
  python -m installer --destdir=test_dir dist/*.whl
  export PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH"

  pytest -vv tests/tests.py
}

package() {
  cd $pkgname-v$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 man/virt-*.1 -t "$pkgdir/usr/share/man/man1/"
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
