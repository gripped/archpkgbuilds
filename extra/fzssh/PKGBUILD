# Maintainer: Robin Candau <antiz@archlinux.org>

pkgname=fzssh
pkgver=1.5.2
pkgrel=1
pkgdesc="a SSH/SFTP library based on libfilezilla"
url="https://filezilla-project.org"
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('nettle' 'gmp' 'libfilezilla' 'argon2' 'libstdc++' 'libgcc' 'glibc')
makedepends=('meson')
# Upstream download link became (purposely) unstable
# See https://trac.filezilla-project.org/ticket/13186
source=("https://sources.archlinux.org/other/packages/${pkgname}/${pkgname}-${pkgver}.tar.xz")
sha256sums=('cd6cb4547124b4477fee0dd4d2726c2a059dd50a4668018445c5d2729ec0a845')
sha512sums=('efeb98387c28377dba6685acf01c1f6b47401414f9748c0135b8ab09d566b800b100a32971a9daa66480a3598549dd9ae1c5d2046e84b1199d0c906554826d31')

build() {
	arch-meson "${pkgname}-${pkgver}" build
	meson compile -C build
}

check() {
	meson test -C build --print-errorlogs
}

package() {
	meson install -C build --destdir "${pkgdir}"
}
