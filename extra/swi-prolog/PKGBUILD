pkgname=swi-prolog
pkgver=10.0.2
pkgrel=3
pkgdesc='Prolog environment'
arch=(x86_64)
url='https://www.swi-prolog.org'
license=(BSD-2-Clause)
depends=(db5.3 gperftools libarchive libxcrypt libyaml qt5-base util-linux-libs)
makedepends=(cmake jdk-openjdk libjpeg-turbo libxft libxinerama libxpm python-protobuf unixodbc)
checkdepends=(java-hamcrest junit)
optdepends=('java-runtime: for using Prolog from Java'
            'jdk-openjdk: for using Prolog from Java'
            'libjpeg-turbo: for using the pl2xpce library'
            'libxft: for using the pl2xpce library'
            'libxinerama: for using the pl2xpce library'
            'libxpm: for using the pl2xpce library'
            'python: for using Prolog from Python'
            'unixodbc: for using the odbc4pl library')
source=("$pkgname-$pkgver.tar.gz::$url/download/stable/src/swipl-$pkgver.tar.gz"
        openssl-4.patch
        "openssl-4-timeout.patch::https://github.com/SWI-Prolog/packages-ssl/commit/7673a282d2868d69172ecfbcc0824eb6b47d373a.patch"
        openssl-4.1-tests.patch)
b2sums=('2dd39c14030f88a6450530d46f95c57917a887bb9da9325bc565ab5f460cfc5894425d0ec84fe7a9539a98b449905534d61b0ef7255a95ebadfd047d2a04bcbe'
        '9ad91b463f0af08962da901b4b4c6d19d3595372d49d47ff7883b0052768bfc2f4de56832f05ccecdfca53f09d0b3bd9e917426c104f3d0e32d99b8fdfd711d8'
        'a5c1516066e24476fc37a568511ba0b025dc1b1ce3b1156a9335604b03d8bfc23527307ebca69056fd19b4a0c0570ff7f078a403cffe2280bb4cf64b1388a7d6'
        '0a4e73d7fac28ad6e92a32bbaa843a88c1760774c06ae676cc4890aa90ea61c6bf287bfe3db91f80c407e4bd0d6833fa5bdad66a90ba3b146cd8530224729ea8')

prepare() {
  cd "swipl-$pkgver/packages/ssl"
  # Use ASN.1 accessors and const pointers for OpenSSL 4.
  # https://github.com/SWI-Prolog/packages-ssl/pull/174
  patch -Np1 -i "$srcdir/openssl-4.patch"
  # Keep SSL streams usable after a timeout with OpenSSL 4.
  # https://github.com/SWI-Prolog/packages-ssl/issues/176
  patch -Np1 -i "$srcdir/openssl-4-timeout.patch"
  # Use SAN test certificates and check CN-only rejection with OpenSSL 4.1.
  # https://github.com/openssl/openssl/pull/31982
  patch -Np1 -i "$srcdir/openssl-4.1-tests.patch"
}

build() {
  cmake \
    -B build \
    -D BDB_INCLUDE_DIR=/usr/include/db5.3 \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_C_FLAGS="$CFLAGS -fPIC -ffile-prefix-map=$PWD= -w" \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D LIBEDIT_INCLUDE_DIR=/usr/include \
    -D LIBEDIT_LIBRARIES=/usr/lib/libedit.so.0 \
    -S swipl-$pkgver
  make -C build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" make -C build install
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" swipl-$pkgver/LICENSE
}
