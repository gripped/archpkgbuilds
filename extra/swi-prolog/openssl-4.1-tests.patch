diff --git a/test_ssl.pl b/test_ssl.pl
index 6dbbb95..8175468 100644
--- a/test_ssl.pl
+++ b/test_ssl.pl
@@ -626,7 +626,16 @@ test_crl_hook(_SSL, Cert, _Chain, _Tail, revoked):-
     \+memberchk(revoked(Serial, _RevocationTime), Revocations).
 
 
-test('Valid certificate, correct hostname in CN, signed by trusted CA', VerificationResults:Status == [verified]:true):-
+test('Certificate with hostname only in CN, signed by trusted CA', VerificationResults:Status == Expected:true):-
+    % OpenSSL 4.1 requires a matching subjectAltName by default.
+    current_prolog_flag(ssl_library_version, Version),
+    (   split_string(Version, " .", "", ["OpenSSL", Major, Minor|_]),
+        number_string(MajorVersion, Major),
+        number_string(MinorVersion, Minor),
+        ( MajorVersion > 4 ; MajorVersion =:= 4, MinorVersion >= 1 )
+    ->  Expected = [hostname_mismatch, verified]
+    ;   Expected = [verified]
+    ),
     do_verification_test(1, try_ssl_client('www.example.com', test_verify_hook), VerificationResults, Status).
 
 test('Valid certificate, correct hostname in SAN, signed by trusted CA', VerificationResults:Status == [verified]:true):-
