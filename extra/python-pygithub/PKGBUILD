# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-pygithub
pkgver=2.9.1
pkgrel=1
pkgdesc="Use the full Github API v3"
arch=('any')
license=('LGPL-3.0-or-later')
url="https://github.com/PyGithub/PyGithub"
depends=('python-deprecated' 'python-pyjwt' 'python-requests' 'python-pynacl' 'python-typing_extensions' 'python-urllib3')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools-scm' 'python-wheel')
checkdepends=('python-pytest' 'python-cryptography' 'python-httpretty' 'python-parameterized' 'python-responses')
source=("git+https://github.com/PyGithub/PyGithub.git#tag=v$pkgver")
sha512sums=('d37302e7ea1fb2c3de0684c1b4e3ad843796dbcd4f8005f5002cabdbc45efd8661ccfe6b8d626a20586391448477addcedbab7ab8958c9dbfd513653f9d9d734')

build() {
  cd PyGithub
  python -m build --wheel --no-isolation
}

check() {
  cd PyGithub
  python -m pytest
}

package() {
  cd PyGithub
  python -m installer --destdir="$pkgdir" dist/*.whl
}
