# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=fooyin
pkgver=0.15.1
pkgrel=1
pkgdesc='A customisable music player'
arch=(x86_64)
url='https://fooyin.org/'
license=(GPL-3.0-only)
depends=(
  glibc
  icu
  libstdc++
  libgcc
  qt6-base
  alsa-lib
  taglib
  ffmpeg
  kdsingleapplication
  qcoro
  hicolor-icon-theme
  zlib
)
makedepends=(
  git
  qt6-svg
  qt6-tools
  ninja
  cmake
  sdl2-compat
  libpipewire
  libopenmpt
  libgme
  libsndfile
  libarchive
  libebur128
  libprojectm
  libsoxr
  libcdio
  libcdio-paranoia
  soundtouch
  vulkan-headers
)
optdepends=(
    'sdl2: For the SDL2 audio output plugin'
    'libpipewire: For the PipeWire audio output plugin'
    'libopenmpt: For the OpenMPT audio input plugin'
    'libgme: For the GME audio input plugin'
    'libsndfile: For the GME audio input plugin'
    'libarchive: For the libarchive archive plugin'
    'libebur128: For the ReplayGain scanner plugin'
    'libsoxr: For the SoX-based DSP plugin'
    'libprojectm: For the ProjectM visualisation plugin'
    'libcdio: For the Audio CD plugin'
    'libcdio-paranoia: For the Audio CD plugin'
    'soundtouch: For the SoundTouch-based DSP plugin'
)
source=("$pkgname::git+https://github.com/fooyin/fooyin#tag=v$pkgver")
sha512sums=('86da118bc0c9881956007e164fbd9be0d2649c08393ce5759c20742979d863e1904e29d3e3c0c003752a16fe09c211aa76451922fd3271f4b10f5a234e895187')
b2sums=('ae13e8cc8eaaf4a3d056235479d5601bd14eee9c1530f3758d8929cc062e19f01060c2b708d124bd24f1879c927f8a7d42cd8eed7fbcd28706be59d5d552c4ae')

build() {
  local cmake_options=(
    -B build
    -S "$pkgname"
    -W no-author
    -G Ninja
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D BUILD_PCH=ON
    -D BUILD_TESTING=ON
    -D INSTALL_HEADERS=ON
  )

  cmake "${cmake_options[@]}"

  cmake --build build
}

check() {
  ctest --test-dir build/tests --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
