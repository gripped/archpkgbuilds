# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=fooyin
pkgver=0.14.1
pkgrel=1
pkgdesc='A customisable music player'
arch=(x86_64)
url='https://fooyin.org/'
license=(GPL-3.0-only)
depends=(
  glibc
  icu
  libstdc++
  libgcc
  qt6-base
  alsa-lib
  taglib
  ffmpeg
  kdsingleapplication
  qcoro
  hicolor-icon-theme
  zlib
)
makedepends=(
  git
  qt6-svg
  qt6-tools
  ninja
  cmake
  sdl2-compat
  libpipewire
  libopenmpt
  libgme
  libsndfile
  libarchive
  libebur128
  libprojectm
  libsoxr
  libcdio
  libcdio-paranoia
  soundtouch
  vulkan-headers
)
optdepends=(
    'sdl2: For the SDL2 audio output plugin'
    'libpipewire: For the PipeWire audio output plugin'
    'libopenmpt: For the OpenMPT audio input plugin'
    'libgme: For the GME audio input plugin'
    'libsndfile: For the GME audio input plugin'
    'libarchive: For the libarchive archive plugin'
    'libebur128: For the ReplayGain scanner plugin'
    'libsoxr: For the SoX-based DSP plugin'
    'libprojectm: For the ProjectM visualisation plugin'
    'libcdio: For the Audio CD plugin'
    'libcdio-paranoia: For the Audio CD plugin'
    'soundtouch: For the SoundTouch-based DSP plugin'
)
source=("$pkgname::git+https://github.com/fooyin/fooyin#tag=v$pkgver")
sha512sums=('68999e306c8d622a2f6463c68163f97db45bd2e6d6553b53fa8ecf7ec72ae3b64ee2651cb10bfc83d1b3e8304d1383640cfe4beb1535bbce5f74431659091408')
b2sums=('b2515164a36ec02974064eb0ce5ec54b7dde5ee94f83dba69e0695468985a2f87cb77ea8259b25eb560080d4a25086ccab9451568103a228760da73a57f81eca')

build() {
  local cmake_options=(
    -B build
    -S "$pkgname"
    -W no-author
    -G Ninja
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D BUILD_PCH=ON
    -D BUILD_TESTING=ON
    -D INSTALL_HEADERS=ON
  )

  cmake "${cmake_options[@]}"

  cmake --build build
}

check() {
  ctest --test-dir build/tests --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
