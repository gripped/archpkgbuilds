pkgname=ruby-pkg-config
_pkgname="${pkgname#ruby-}"
pkgver=1.6.8
pkgrel=1
pkgdesc='Implementation of pkg-config in Ruby'
arch=(any)
url='https://github.com/ruby-gnome/pkg-config'
license=(LGPL-2.1-only)
depends=(ruby)
makedepends=(
  git
  ruby-rdoc
)
provides=(ruby-pkgconfig)
replaces=(ruby-pkgconfig)
conflicts=(ruby-pkgconfig)
source=("$pkgname::git+$url#tag=$pkgver")
sha512sums=('a28dbe216f86232e606b0f84b5d8c6e2c9ff7cb8366989dd1df5959ba6f54ed5e8d4281beaadf08e209dfd5dee3641d7b2b1340a8f4314dc4e1d8238fb92ee5c')
b2sums=('275b95dee369b68d675d7b76037f9d4da64b00d70b890085cfc7295967c5d3ed800c363c93fe3af4388f3fcc2bc526b296cb4a3f554ab55e93bbabc8b7a5a471')

build() {
  cd "$pkgname"

  gem build "$_pkgname.gemspec"
}

package() {
  cd "$pkgname"

  local _gemdir="$(ruby -e'puts Gem.default_dir')"

  gem install \
    --local \
    --verbose \
    --ignore-dependencies \
    --no-user-install \
    --install-dir "$pkgdir/$_gemdir" \
    --bindir "$pkgdir/usr/bin" \
    "$_pkgname-$pkgver.gem"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LGPL-2.1
}
