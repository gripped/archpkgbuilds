# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>

_name=gersemi
pkgname=python-$_name
pkgver=0.27.7
pkgrel=1
pkgdesc="A formatter to make your CMake code the real treasure"
arch=(x86_64)
url="https://github.com/blankspruce/gersemi"
license=(MPL-2.0)
depends=(
  glibc
  libgcc
  python
  python-colorama
  python-ignore
  python-platformdirs
  python-yaml
)
makedepends=(
  python-build
  python-installer
  python-setuptools
  python-setuptools-rust
)
checkdepends=(
  git
  python-pytest
  python-pytest-xdist
  python-pydantic
  python-lark-parser
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
b2sums=('f0a775786400020f03cc2805cfc6a2ae36a14a8fe8fadd22948a3e239b70a9c1bc44ce866309fed7b326f30de479d034731fb405ec2308cfb2f55506ea38190c')

build() {
  cd $_name-$pkgver
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
    -W ignore::DeprecationWarning
    # distribute tests across multiple CPUs
    -n auto
    # failing as of 0.27.2
    --deselect tests/test_configuration.py::test_schema_in_repository_is_consistent_with_configuration_definition
  )

  cd $_name-$pkgver
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  # the tests use Python subprocess module to execute gersemi, so we must actually activate the venv
  (
    source test-env/bin/activate
    python -m pytest "${pytest_options[@]}" tests
  )
}

package() {
  cd $_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
