pkgname=kup
pkgver=6.8.3
_dirver=$(echo $pkgver | cut -d. -f1-3)
pkgrel=1
pkgdesc='A backup software for helping people to keep up-to-date backups'
arch=(x86_64)
url='https://apps.kde.org/kup/'
license=(GPL-2.0-only
         GPL-2.0-or-later
         GPL-3.0-only)
depends=(glibc
         kcmutils
         kcompletion
         kconfig
         kconfigwidgets
         kcoreaddons
         kcrash
         kdbusaddons
         ki18n
         kidletime
         kio
         kirigami
         kjobwidgets
         knotifications
         kwidgetsaddons
         kwindowsystem
         kxmlgui
         libgcc
         libgit2
         libplasma
         libstdc++
         qt6-base
         qt6-declarative
         solid)
makedepends=(extra-cmake-modules
             git)
optdepends=('bup: bup backend'
            'rsync: support for synced backups')
groups=(plasma)
source=(https://download.kde.org/stable/plasma/$_dirver/$pkgname-$pkgver.tar.xz{,.sig})
sha256sums=('0ece2b1047e874efaec826a67cefcb6c5ac737e89f43be8f4fbce5c77d1b794a'
            'SKIP')
validpgpkeys=('E0A3EB202F8E57528E13E72FD7574483BB57B18D'  # Jonathan Esk-Riddell <jr@jriddell.org>
              '58743C0A93487794BC44ECE873C3D7758E7A544A'  # Bhushan Shah <bshah@kde.org>
              'D07BD8662C56CB291B316EB2F5675605C74E02CF'  # David Edmundson <davidedmundson@kde.org>
              '1FA881591C26B276D7A5518EEAAF29B42A678C20') # Marco Martin <notmart@gmail.com>

build() {
  cmake -B build -S $pkgname-$pkgver \
    -DBUILD_TESTING=OFF \
    -DQT_MAJOR_VERSION=6
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
