# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=kxstitch
pkgver=3.0.0
pkgrel=1
pkgdesc='Cross stitch pattern and chart creation'
arch=(x86_64)
url='https://apps.kde.org/kxstitch/'
license=(GPL-2.0-or-later)
depends=(
  glibc
  hicolor-icon-theme
  imagemagick
  kcompletion
  kconfig
  kconfigwidgets
  kcoreaddons
  kguiaddons
  ki18n
  kio
  ktextwidgets
  kwidgetsaddons
  kxmlgui
  libgcc
  libstdc++
  qt6-base
)
makedepends=(
  cmake
  extra-cmake-modules
  git
  kdoctools
  ninja
)
source=("git+https://invent.kde.org/graphics/kxstitch.git?signed#tag=v$pkgver")
b2sums=(4194c0c2e97bac07e387c1ca075758e4f686feb0b8383341450f3cb946723d96d8d2692ca98b489aaffd54cb359070767534cee3954a2d82da5cb883e8ea06f9)
validpgpkeys=(E99F69A60D33F6D388454CCC963199D3A2B6F987) # Jeremy Whiting <jpwhiting@kde.org>

build() {
  cmake -S $pkgname -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_BUILD_TYPE=None
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
