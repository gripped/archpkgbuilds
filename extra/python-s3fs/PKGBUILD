# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-s3fs
pkgver=2026.7.0
pkgrel=1
pkgdesc='A Python file interface to S3'
arch=(any)
url='https://github.com/fsspec/s3fs'
license=(BSD-3-Clause)
depends=(
  python
  python-aiobotocore
  python-botocore
  python-urllib3
  python-fsspec
  python-aiohttp
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-pytest
  python-pytest-env
  python-pytest-asyncio
  python-flask
  python-flask-cors
  python-moto
)
source=("$pkgname::git+$url#tag=$pkgver")
sha512sums=('eb973833e24502d9af46f03082368fd02c29cdd5cf025255c6390544fbea381e3f42fcceac7eb3aa5e69870d64caf43924c9a298fcaebb7b716958ac017cc5f3')
b2sums=('3c96f936bb33d04d0bf2107d0661d3fafc9f971f1e4dc5b0dc737867eca6211999583c6385fe8f9a1d1c411ee3c033a613b35204a14fe649e3fe78067a6a0aec')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  local pytest_opts=(
    -v
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsCopy::test_copy_glob_edge_cases[fil?1-False-None-expected0]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsCopy::test_copy_glob_edge_cases[fil?1-True-None-expected1]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsCopy::test_copy_glob_edge_cases[file[1-2]-False-None-expected2]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsCopy::test_copy_glob_edge_cases[file[1-2]-True-None-expected3]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsCopy::test_copy_glob_edge_cases[subdir[1-2]-False-None-expected25]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsCopy::test_copy_glob_edge_cases[subdir[1-2]-True-None-expected26]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsCopy::test_copy_glob_edge_cases[subdir[1-2]-True-2-expected27]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsCopy::test_copy_glob_edge_cases[subdir[0-1]-False-None-expected28]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsCopy::test_copy_glob_edge_cases[subdir[0-1]-True-None-expected29]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsCopy::test_copy_glob_edge_cases[subdir[0-1]/*fil[e]*-False-None-expected30]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsCopy::test_copy_glob_edge_cases[subdir[0-1]/*fil[e]*-True-None-expected31]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsCopy::test_copy_directory_without_files_with_same_name_prefix
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsGet::test_get_glob_edge_cases[fil?1-False-None-expected0]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsGet::test_get_glob_edge_cases[fil?1-True-None-expected1]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsGet::test_get_glob_edge_cases[file[1-2]-False-None-expected2]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsGet::test_get_glob_edge_cases[file[1-2]-True-None-expected3]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsGet::test_get_glob_edge_cases[subdir[1-2]-False-None-expected25]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsGet::test_get_glob_edge_cases[subdir[1-2]-True-None-expected26]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsGet::test_get_glob_edge_cases[subdir[1-2]-True-2-expected27]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsGet::test_get_glob_edge_cases[subdir[0-1]-False-None-expected28]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsGet::test_get_glob_edge_cases[subdir[0-1]-True-None-expected29]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsGet::test_get_glob_edge_cases[subdir[0-1]/*fil[e]*-False-None-expected30]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsGet::test_get_glob_edge_cases[subdir[0-1]/*fil[e]*-True-None-expected31]
    --deselect s3fs/tests/derived/s3fs_test.py::TestS3fsGet::test_get_directory_without_files_with_same_name_prefix
    --deselect s3fs/tests/test_s3fs.py::test_s3_glob
    --deselect s3fs/tests/test_s3fs.py::test_fsspec_versions_multiple
  )

  pytest "${pytest_opts[@]}"
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE.txt
}
