pkgname=deepin-control-center
pkgver=6.1.83
pkgrel=1
pkgdesc='Control panel of Deepin Desktop Environment'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-control-center"
license=('GPL-3.0-or-later' 'LGPL-3.0-or-later' 'MIT')
# startdde: org.deepin.dde.Display1
depends=('dtk6core' 'dtk6declarative' 'dtk6gui' 'dtk6widget' 'qt6-base' 'qt6-declarative'
         'qt6-multimedia' 'qt6-svg' 'qt6-wayland' 'deepin-account-faces' 'deepin-api' 'libpwquality'
         'deepin-daemon' 'startdde' 'deepin-pw-check' 'deepin-network-core' 'deepin-desktop-theme'
         'icu' 'polkit-qt6')
makedepends=('git' 'cmake' 'deepin-tray-loader' 'gmock' 'gtest' 'ninja' 'qt6-tools'
             'deepin-gettext-tools' 'doxygen' 'libsystemd' 'extra-cmake-modules'
             'treeland-protocols' 'wlr-protocols')
# Not packaged: network-manager-l2tp
conflicts=('dde-control-center' 'dde-dock-applets')
replaces=('dde-control-center' 'dde-dock-applets')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/dde-control-center.git#tag=$pkgver")
sha512sums=('ecb74f1586b08237d5db9a105d6d646955c09cc2992c558eaed100a5953e777f3bace6584843c1efb603421869ad16e53a0a37632a741ba6975b819d3d215368')

prepare() {
  mkdir -p build

  cd dde-control-center

  # Adapt the wallpaper-manager protocol used by treeland-protocols 0.5.8+.
  # https://github.com/linuxdeepin/dde-control-center/pull/3209
  git cherry-pick -n f791e7f374212364de9e08320886651614640da7
  # Remove stale PersonalizationWallpaperContext references.
  # https://github.com/linuxdeepin/dde-control-center/pull/3297
  git diff f0e7e4067a90e1a5a2a80c7a96f76354423e6f8f^ f0e7e4067a90e1a5a2a80c7a96f76354423e6f8f -- \
    src/plugin-personalization/operation/treelandworker.cpp \
    src/plugin-personalization/operation/treelandworker.h | git apply

  # Use the structured EventLogger API provided by deepin-api 6.0.40+.
  # https://github.com/linuxdeepin/dde-control-center/pull/3192
  git diff c687c0da264bc30c50c791c9a2a636a1bd54d0b6^ c687c0da264bc30c50c791c9a2a636a1bd54d0b6 -- \
    CMakeLists.txt \
    src/dde-control-center/CMakeLists.txt \
    src/dde-control-center/dccmanager.cpp | git apply
}

build() {
  cd build
  cmake \
    -GNinja \
    -DDISABLE_AUTHENTICATION=YES \
    -DDISABLE_PRIVACY_PLUGIN=YES \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    ../dde-control-center
  ninja
}

check() {
  cd build
  #ninja test
}

package() {
  cd build
  DESTDIR="$pkgdir" ninja install
}
