pkgname=deepin-control-center
pkgver=6.1.16
pkgrel=1
pkgdesc='Control panel of Deepin Desktop Environment'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-control-center"
license=('GPL-3.0-or-later')
# startdde: org.deepin.dde.Display1
depends=('dtk6core' 'dtk6declarative' 'dtk6gui' 'dtk6widget' 'qt6-base' 'qt6-declarative'
         'qt6-multimedia' 'qt6-svg' 'deepin-account-faces' 'deepin-api' 'libpwquality'
         'deepin-daemon' 'startdde' 'deepin-pw-check' 'deepin-network-core' 'deepin-desktop-theme'
         'icu' 'polkit-qt6')
makedepends=('git' 'cmake' 'deepin-tray-loader' 'gmock' 'gtest' 'ninja' 'qt6-tools'
             'deepin-gettext-tools' 'doxygen' 'libsystemd' 'extra-cmake-modules'
             'treeland-protocols')
optdepends=('redshift: automatic color temperature support')
# Not packaged: network-manager-l2tp
conflicts=('dde-control-center' 'dde-dock-applets')
replaces=('dde-control-center' 'dde-dock-applets')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/dde-control-center.git#tag=$pkgver")
sha512sums=('b8140c3ce2527d1ead7a22aaddc7b5ccf5d23dfe19ef548da2a50c0441d962d7db3bb65719536f68b0e14efe21ac4e35abf48d1b9ede760eb9e8452293b76aa0')

prepare() {
  mkdir -p build

  cd dde-control-center

  # authentication plugin needs dareader
  sed -i '/plugin-authentication/d' CMakeLists.txt
  # privacy plugin won't work
  sed -i '/plugin-privacy/d' CMakeLists.txt
  # They broke the flag
  sed -i 's/BUILD_DCC_OLD ON/BUILD_DCC_OLD OFF/' CMakeLists.txt
  # Well, how did they compile like this?
  sed -i '/dde-control-center/d' src/plugin-accounts/CMakeLists.txt src/plugin-update/CMakeLists.txt
  # Fix build with Qt 6.10 private targets
  sed -i '/find_package(${QT_NS} COMPONENTS Core Quick Gui Network DBus Concurrent Test LinguistTools Multimedia REQUIRED)/a if(${QT_NS}_VERSION VERSION_GREATER_EQUAL 6.10)\n  find_package(${QT_NS} COMPONENTS GuiPrivate REQUIRED)\nendif()' CMakeLists.txt
  sed -i '/find_package(${QT_NS} COMPONENTS QmlModels REQUIRED)/a if(${QT_NS}_VERSION VERSION_GREATER_EQUAL 6.10)\n  find_package(${QT_NS} COMPONENTS QmlModelsPrivate REQUIRED)\nendif()' src/dde-control-center/CMakeLists.txt
  sed -i '/find_package(Qt6 REQUIRED COMPONENTS WaylandClient)/a if(Qt6_VERSION VERSION_GREATER_EQUAL 6.10)\n  find_package(Qt6 COMPONENTS WaylandClientPrivate REQUIRED)\nendif()' src/plugin-personalization/CMakeLists.txt
  sed -i '/${QT_NS}::Gui$/a\    ${QT_NS}::GuiPrivate' src/plugin-display/CMakeLists.txt
}

build() {
  cd build
  cmake \
    -GNinja \
    -DDISABLE_AUTHENTICATION=YES \
    -DDISABLE_LANGUAGE=YES \
    -DDISABLE_UPDATE=YES \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    ../dde-control-center
  ninja
}

check() {
  cd build
  #ninja test
}

package() {
  cd build
  DESTDIR="$pkgdir" ninja install
}
