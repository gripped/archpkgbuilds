+      if (pixbuf)
+        {
+          cursor = gdk_cursor_new_from_pixbuf (gdk_screen_get_display (screen),
+                                               pixbuf,
+                                               DROPPER_X_HOT, DROPPER_Y_HOT);
+          g_object_unref (pixbuf);
+        }
+    }
+
+  return cursor;
