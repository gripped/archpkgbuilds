pkgbase=ast-grep
pkgname=(
  ast-grep
  python-ast-grep
)
pkgver=0.42.2
pkgrel=1
pkgdesc='CLI tool for code structural search, lint and rewriting'
url='https://ast-grep.github.io/'
arch=(x86_64)
license=(MIT)
depends=(
  libgcc
  glibc
)
makedepends=(
  cargo
  python-build
  python-installer
  python-maturin
  python-wheel
)
options=(!lto)
source=(https://github.com/ast-grep/ast-grep/archive/${pkgver}/${pkgbase}-${pkgver}.tar.gz)
sha512sums=('d6fe0547c653d0837fbef8b4e3563e33100bcc9d5f2e30508adcef40936baed767cf7a40fa9e37c17f91223f8e7fc6cfb9c457d3c95a1a193aabe0ba9a3e28ee')
b2sums=('3968b112979c4369f2e3d7a49188d9861955ddcca9bad605348cbf50ff68e956beec9675e878955b1d6c2d88d596a3dfa01cf2a924d4e310f4d9f35d6cfb0981')

prepare() {
  cd ${pkgbase}-${pkgver}
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd ${pkgbase}-${pkgver}
  cargo build --frozen --release --all-features

	local shell; for shell in bash fish zsh; do
		./target/release/ast-grep completions "${shell}" > target/ast-grep.${shell}
	done

  cd crates/pyo3
  python -m build --wheel --no-isolation
}

check() {
  cd ${pkgbase}-${pkgver}
  cargo test --frozen --all-features --workspace
}

package_ast-grep() {
  depends=(
    libgcc
    glibc
  )

  cd ${pkgbase}-${pkgver}
  install -Dm 755 target/release/ast-grep -t "${pkgdir}/usr/bin/"
  install -Dm 644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm 644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"

	install -Dm 644 target/${pkgname}.bash "${pkgdir}"/usr/share/bash-completion/completions/${pkgname}
	install -Dm 644 target/${pkgname}.fish "${pkgdir}"/usr/share/fish/vendor_completions.d/${pkgname}.fish
	install -Dm 644 target/${pkgname}.zsh "${pkgdir}"/usr/share/zsh/site-functions/_${pkgname}
}

package_python-ast-grep() {
  depends=(
    libgcc
    glibc
    python
  )

  cd ${pkgbase}-${pkgver}
  install -Dm 644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
  cd crates/pyo3
  python -m installer --destdir="${pkgdir}" dist/*.whl
}

