# Maintainer: Jonathan Grotelüschen <tippfehlr@archlinux.org>

pkgname=python-langtool
pkgver=1.3.0
pkgrel=1
pkgdesc="Port of LanguageTool to Python for grammar and style checking and correction"
arch=(x86_64)
url="https://github.com/kovidgoyal/langtool"
license=(LGPL-2.1-or-later)
depends=(
	glibc
	python
	python-lxml
	# langtool stores serialized regex objects and needs to be rebuild for
	# python-regex updates
	python-regex
)
makedepends=(
	git
	python-build
	python-installer
	python-setuptools
	python-wheel
)
checkdepends=(
	python-pytest
	python-pytest-xdist
)
source=("$pkgname::git+$url#tag=v$pkgver")
sha256sums=('3cd2fe3d8f486c5c000af89f1f6895420b97d9e9c1265133796adf91af914c1c')

prepare() {
	cd $pkgname
	# unused upstream dictionary tooling, contains a prebuilt gradle-wrapper.jar
	# https://github.com/kovidgoyal/langtool/issues/1
	rm -r src/langtool/data/resource/crh/dev
}

build() {
	cd $pkgname
	python -m build --wheel --no-isolation
}

check() {
	cd $pkgname

	# copy rule tables to src/langtool
	python setup.py build_ext --inplace
	pytest
}

package() {
	cd $pkgname
	python -m installer --destdir="$pkgdir" dist/*.whl
}
