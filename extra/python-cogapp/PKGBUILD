# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Caleb Maclennan <caleb@alerque.com>

pkgname=python-cogapp
pkgver=3.5.1
pkgrel=1
pkgdesc="A code generator for executing Python snippets in source files"
url="https://nedbatchelder.com/code/cog"
license=('MIT')
arch=('any')
depends=('python')
makedepends=('git' 'python-build' 'python-installer' 'python-wheel' 'python-setuptools')
checkdepends=('python-pytest')
conflicts=('cocogitto')
source=("git+https://github.com/nedbat/cog.git#tag=v$pkgver")
sha512sums=('8fac29f20fae46e93c6de4673f80d78ad3b1a95a8d52c85108d649b87144fb1010ccf5e0d21eeed4a1d113e447b1e6fce0df210e4160e8f1a59b54d73c715e66')

build() {
  cd cog
  python -m build -wn
}

check() {
  cd cog
  pytest
}

package() {
  cd cog
  python -m installer -d "$pkgdir" dist/*.whl
  install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE.txt
}
