# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=kst
pkgver=3.1.1
pkgrel=1
pkgdesc='Fast real-time plotting program with light data analysis capabilities'
arch=(x86_64)
url='https://kst-plot.kde.org/'
license=(GPL-2.0-or-later)
depends=(
  cfitsio
  glibc
  gsl
  hdf5
  hicolor-icon-theme
  libgcc
  libmatio
  libstdc++
  libtiff
  netcdf-cxx
  qt6-base
  qt6-svg
)
makedepends=(
  cmake
  git
  ninja
  qt6-tools
)
source=("git+https://invent.kde.org/graphics/kst-plot.git#tag=$pkgver")
b2sums=(e721bad96cd037e69647d151ea164a662f7f603242384aa55c947c884832341e860dab12e82ade1129c4d44e3bf9bfc51075086fdac1a0ee13cd55b7a27e80ed)

build() {
  cmake -S kst-plot -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
