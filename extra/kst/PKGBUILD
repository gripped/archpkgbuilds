# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=kst
pkgver=3.1.0
pkgrel=1
pkgdesc='Fast real-time plotting program with light data analysis capabilities'
arch=(x86_64)
url='https://kst-plot.kde.org/'
license=(GPL-2.0-or-later)
depends=(
  cfitsio
  glibc
  gsl
  hdf5
  hicolor-icon-theme
  libgcc
  libmatio
  libstdc++
  libtiff
  netcdf-cxx
  qt6-base
  qt6-svg
)
makedepends=(
  cmake
  git
  ninja
  qt6-tools
)
source=("git+https://invent.kde.org/graphics/kst-plot.git#tag=$pkgver")
b2sums=(e5990563b9e26f2fed769fe073e73e58d20d16fd2b4e805b92796d895f1039cbe97eeec8559d3d24b06f8a8c258ef93fc60755737671e44098fa4e67a6921254)

build() {
  cmake -S kst-plot -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
