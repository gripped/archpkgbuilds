            '229e55b798199e9f9e4bc40690a7e2b7d55939cc25e1eeaaf6f6dea9bd76eba004a07595d955938a2653703443396d698ec22937d5ae13d8b590f51dd3156b59'
            '933f19eeb787db0fec48ae4c1e324b6e8b0bfd4d453c9be9d24a27e2d7432dd5d6404cfc751e914c9d274826064c0299cec6afa5bf350719ec5db71c54730c6a'
            '233f4bc9c108b0b66f779e03ecbde4552f2c71220fbcdb4801620db363ef4d26909a825dbd732e1c65afdf94d45c4d1e5718e1b2eed1159d0b196f6621eb87ce'
            '84da5bdb4f84540e68fd4fc042f5e0c458abdebdfeb545d03febd744e7155bfc381577ba50f2833ab43b7d0187778fd065e5de7820ca05325ce227f6a0f8499f')

prepare() {
  cd deepin-kwin
  patch -p1 -i ../gcc-16.patch
# KScreenLocker 6.8 removed AcquiringLock and lockScreenShown()
  patch -p1 -i ../kscreenlocker-6.8.patch
# kglobalacceld 6.8 removed the private interface header required by this fork
  patch -p1 -i ../disable-kglobalaccel.patch
}

build() {
  cd deepin-kwin
  cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBEXECDIR=lib \
          -DBUILD_TESTING=OFF -DKWIN_BUILD_SCREENLOCKER=ON \
          -DENABLE_KGLOBALACCEL=OFF
  ninja

  cd "$srcdir/dde-kwin"
  cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_SYSCONFDIR=/etc
  ninja
}

package() {
  cd deepin-kwin
  DESTDIR="$pkgdir" ninja install

  cd "$srcdir/dde-kwin"
  DESTDIR="$pkgdir" ninja install
}
