# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-camera
pkgver=6.5.36
pkgrel=1
pkgdesc='Tool to view camera, take photo and video'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-camera"
license=('BSD-3-Clause' 'CC-BY-4.0' 'CC0-1.0' 'GPL-3.0-or-later' 'LGPL-3.0-or-later')
depends=('dtk6core' 'dtk6gui' 'dtk6widget' 'qt6-base' 'qt6-svg' 'glib2' 'glibc' 'libgcc' 'libstdc++'
         'deepin-image-editor' 'ffmpeg' 'ffmpegthumbnailer' 'gstreamer' 'gst-plugins-base-libs'
         'libpciaccess' 'libva' 'portaudio'
         'pulse-native-provider' 'qt6-multimedia' 'hicolor-icon-theme')
makedepends=('git' 'cmake' 'deepin-gettext-tools' 'ninja' 'qt6-tools')
optdepends=('deepin-image-viewer: view camera photos'
            'deepin-movie: view camera records'
            'deepin-file-manager: open with other applications')
groups=('deepin-extra')
source=("git+https://github.com/linuxdeepin/deepin-camera.git#tag=$pkgver"
        v4l2_and_ffmpeg_fixes.patch)
sha512sums=('d2907bf3ff7085412d8ecc788668a0fd13c5648c33f0c471e3155a84a6a0aecc0097e7b914786a07d77f09f4c23db024e8c4a01ac21fa17701b9b30ff4dcc331'
            'afc44d90cea31f10ff7cbc409819a80cc93c591eb366bc68cb0ffe93c0e3e7472a3e17737d4ac596cb202a0969252d6bbe752adadb36617c8e084d2882638483')

prepare() {
  cd deepin-camera
  # adjusted patches from:
  # https://sourceforge.net/p/guvcview/git-master/ci/38e237873ece7a7e5456229cb5dc8c54051ab1ab/
  # https://sourceforge.net/p/guvcview/git-master/ci/70e7deaf84883b3e7469e319a4d07c6a6f474a52/
  # https://sourceforge.net/p/guvcview/git-master/ci/28453246e8307e1e2b0409e9c1ae66a80b03ae9f/
  # https://sourceforge.net/p/guvcview/git-master/ci/308dd55b57330a82d1d6329b78c846365ef7dbd0/
  patch -p1 -i ../v4l2_and_ffmpeg_fixes.patch

  # Declare vaGetDisplay() used by the new VA-API encoder check.
  sed -i '/#include <va\/va.h>/a #include <va/va_x11.h>' libcam/libcam_encoder/encoder.c
}

build() {
  cd deepin-camera
  cmake -GNinja . \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DVERSION=$pkgver \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
  ninja
}

package() {
  cd deepin-camera
  DESTDIR="$pkgdir" ninja install
}
