# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-sphinx-design
pkgver=0.8.0
pkgrel=1
pkgdesc='A sphinx extension for designing beautiful, view size responsive web components'
arch=(any)
url='https://github.com/executablebooks/sphinx-design'
license=(MIT)
depends=(
  python
  python-sphinx
)
makedepends=(
  git
  python-build
  python-installer
  python-flit-core
)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('3ff8af4f4aa3a14b1742f541d4eab45a77d9bd3bff9618431caf83d5f880f8f48892196841e4de8c8cdc8dc58454fd8ae37dbea1ba225d86bb7b06f7419bef86')
b2sums=('44f9cd2972fceec45c96d1ab9835d9fb1190ecf5975faaff94711d1e1f4604fb2f8ab9f4a3534aa71a25ac0a5cbbf9b2175c233676471168e40e3a8c27d1ab01')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
