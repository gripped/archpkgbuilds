pkgbase = nginx-mod-njs
	pkgdesc = nginScript module for nginx
	pkgver = 0.9.8
	pkgrel = 2
	url = https://nginx.org/en/docs/njs_about.html
	arch = x86_64
	license = BSD-2-Clause
	makedepends = nginx
	makedepends = nginx-src
	depends = glibc
	depends = libxslt
	depends = openssl
	depends = zlib
	depends = pcre2
	depends = libxml2
	source = https://github.com/nginx/njs/archive/refs/tags/0.9.8/nginx-mod-njs-0.9.8.tar.gz
	sha256sums = 016cea70b70f0abcf894366bd555e34ea839b920fac1b085fb063a2ecccc8672

pkgname = nginx-mod-njs
	depends = glibc
	depends = libxslt
	depends = openssl
	depends = zlib
	depends = pcre2
	depends = libxml2
	depends = nginx
	backup = etc/nginx/modules.d/20-njs-http.conf

pkgname = nginx-mod-njs-stream
	pkgdesc = nginScript module for nginx streams
	depends = glibc
	depends = libxslt
	depends = openssl
	depends = zlib
	depends = pcre2
	depends = libxml2
	depends = nginx
	depends = nginx-mod-stream
	backup = etc/nginx/modules.d/20-njs-stream.conf
