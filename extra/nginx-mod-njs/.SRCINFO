pkgbase = nginx-mod-njs
	pkgdesc = nginScript module for nginx
	pkgver = 1.0.0
	pkgrel = 1
	url = https://nginx.org/en/docs/njs_about.html
	arch = x86_64
	license = BSD-2-Clause
	makedepends = nginx
	makedepends = nginx-src
	depends = glibc
	depends = libxslt
	depends = openssl
	depends = zlib
	depends = pcre2
	depends = libxml2
	source = https://github.com/nginx/njs/archive/refs/tags/1.0.0/nginx-mod-njs-1.0.0.tar.gz
	sha256sums = 56fe6560549cbcb7fb5740534b541bb153250d8772aa16ac18bc30eb0cc498dd

pkgname = nginx-mod-njs
	depends = glibc
	depends = libxslt
	depends = openssl
	depends = zlib
	depends = pcre2
	depends = libxml2
	depends = nginx
	backup = etc/nginx/modules.d/20-njs-http.conf

pkgname = nginx-mod-njs-stream
	pkgdesc = nginScript module for nginx streams
	depends = glibc
	depends = libxslt
	depends = openssl
	depends = zlib
	depends = pcre2
	depends = libxml2
	depends = nginx
	depends = nginx-mod-stream
	backup = etc/nginx/modules.d/20-njs-stream.conf
