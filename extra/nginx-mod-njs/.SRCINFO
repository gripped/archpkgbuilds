pkgbase = nginx-mod-njs
	pkgdesc = nginScript module for nginx
	pkgver = 0.9.9
	pkgrel = 4
	url = https://nginx.org/en/docs/njs_about.html
	arch = x86_64
	license = BSD-2-Clause
	makedepends = nginx
	makedepends = nginx-src
	depends = glibc
	depends = libxslt
	depends = openssl
	depends = zlib
	depends = pcre2
	depends = libxml2
	source = https://github.com/nginx/njs/archive/refs/tags/0.9.9/nginx-mod-njs-0.9.9.tar.gz
	sha256sums = a07f4cf0a2076bbabde23cab48aea68641ebf5d54ea69b415ce70a8da4153843

pkgname = nginx-mod-njs
	depends = glibc
	depends = libxslt
	depends = openssl
	depends = zlib
	depends = pcre2
	depends = libxml2
	depends = nginx
	backup = etc/nginx/modules.d/20-njs-http.conf

pkgname = nginx-mod-njs-stream
	pkgdesc = nginScript module for nginx streams
	depends = glibc
	depends = libxslt
	depends = openssl
	depends = zlib
	depends = pcre2
	depends = libxml2
	depends = nginx
	depends = nginx-mod-stream
	backup = etc/nginx/modules.d/20-njs-stream.conf
