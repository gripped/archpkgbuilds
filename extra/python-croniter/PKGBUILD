# Contributor: Mark Wagie <mark dot wagie at tutanota dot com>
# Contributor: Thomas Andrejak <thomas.andrejak@gmail.com>

pkgname=python-croniter
# https://github.com/pallets-eco/croniter/blob/main/CHANGELOG.rst
pkgver=7.0.0
pkgrel=1
pkgdesc="A Python module to provide iteration for datetime object."
arch=('any')
url="https://github.com/pallets-eco/croniter"
license=('MIT')
depends=('python' 'python-dateutil')
makedepends=('git' 'python-build' 'python-hatchling' 'python-installer')
checkdepends=('python-pytest' 'python-pytz')
source=("git+https://github.com/pallets-eco/croniter.git#tag=$pkgver")
sha256sums=('b2608e789d649e83d2685a3a0cfa43e076b3962941371ad7908f262061115471')

prepare() {
  cd croniter
  # Allow Arch's build tools instead of upstream's exact version pins.
  sed -i '/^\[build-system\]/,/^\[project\]/s/==[^"]*//g' pyproject.toml
}

build() {
  cd croniter
  python -m build --wheel --no-isolation
}

check() {
  cd croniter
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd croniter
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
