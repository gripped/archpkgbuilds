# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-parsel
pkgver=1.11.0
pkgrel=1
pkgdesc="Library to extract data from HTML and XML using XPath and CSS selectors"
arch=('any')
license=('BSD-3-Clause')
url="https://github.com/scrapy/parsel"
depends=('python-cssselect' 'python-jmespath' 'python-lxml' 'python-packaging' 'python-w3lib')
makedepends=('git' 'python-build' 'python-hatchling' 'python-installer')
checkdepends=('python-pytest' 'python-sybil' 'python-psutil')
source=("git+https://github.com/scrapy/parsel.git#tag=v$pkgver")
sha512sums=('b7e1a7b4e8e30eb330e3fd075b4db99e65cc943f62e0b638f3f8f9716616ddc5b97c232598381855ea5ce57d1a36d02c3a41971bcd868dc4e4e81d0e48bb64ee')

build() {
  cd parsel
  python -m build --wheel --no-isolation
}

check() {
  cd parsel
  python -m pytest
}

package() {
  cd parsel
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
