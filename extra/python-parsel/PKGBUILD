# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-parsel
pkgver=1.12.0
pkgrel=1
pkgdesc="Library to extract data from HTML and XML using XPath and CSS selectors"
arch=('any')
license=('BSD-3-Clause')
url="https://github.com/scrapy/parsel"
depends=('python-cssselect' 'python-jmespath' 'python-lxml' 'python-w3lib')
makedepends=('git' 'python-build' 'python-hatchling' 'python-installer')
checkdepends=('python-pytest' 'python-sybil' 'python-psutil')
source=("git+https://github.com/scrapy/parsel.git#tag=v$pkgver")
sha512sums=('847b61175a060b68ec72e6dffbae7f5382b2393658c892b49e38b96da256a0559e8a842d002d86f020a175140f8225d0cea87b1bc7811ca3752c3401d68eb2f9')

build() {
  cd parsel
  python -m build --wheel --no-isolation
}

check() {
  cd parsel
  python -m pytest
}

package() {
  cd parsel
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
