prepare() {
  cd fastmcp
  # Anthropic 2.x defines MessageParam as a union, so construct plain dictionaries.
  sed -i 's/MessageParam(/dict(/g' fastmcp_slim/fastmcp/client/sampling/handlers/anthropic.py
  # The dictionary payloads also support Anthropic 2.x.
  sed -i 's/anthropic>=0.48.0,<2/anthropic>=0.48.0,<3/' fastmcp_slim/pyproject.toml
  # The packaged redis-py backports the 8.1.0 reconnection fix.
  # https://github.com/redis/redis-py/pull/4260
  sed -i 's/redis!=8.1.0/redis/' fastmcp_tasks/pyproject.toml
}

build() {
  cd fastmcp
  python -m build --wheel --no-isolation
  python -m build --wheel --no-isolation fastmcp_slim
  python -m build --wheel --no-isolation fastmcp_tasks
  python -m build --wheel --no-isolation fastmcp_remote
}

check() {
  cd fastmcp
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m installer fastmcp_slim/dist/*.whl
  test-env/bin/python -m installer fastmcp_tasks/dist/*.whl
  test-env/bin/python -m installer fastmcp_remote/dist/*.whl

  # Local GitHub OAuth tests use dummy app credentials; remote MCP needs a real token.
  FASTMCP_TEST_AUTH_GITHUB_CLIENT_ID=test-client \
    FASTMCP_TEST_AUTH_GITHUB_CLIENT_SECRET=test-secret \
    OPENAPI_DIRECTORY_PATH="$srcdir/openapi-directory" \
    RUN_REAL_WORLD_SCHEMA_TEST=1 \
    PATH="$PWD/test-env/bin:$PATH" test-env/bin/python -m pytest \
    --ignore=tests/integration_tests/test_github_mcp_remote.py
}

package_python-fastmcp() {
  depends+=('python-fastmcp-slim')

  cd fastmcp
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

package_python-fastmcp-slim() {
  pkgdesc="FastMCP library with minimal dependencies"
  depends=(
    'python'
    'python-dotenv'
    'python-email-validator'
    'python-mcp-types'
    'python-platformdirs'
    'python-pydantic'
    'python-pydantic-settings'
    'python-rich'
    'python-typing_extensions'
  )
  optdepends+=('python-fastmcp: client, server and CLI support')

  cd fastmcp
  python -m installer --destdir="$pkgdir" fastmcp_slim/dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

package_python-fastmcp-tasks() {
  pkgdesc="Background task execution for FastMCP servers"
  depends=(
    'python'
    'python-cryptography'
    'python-fastmcp'
    'python-pydocket'
    'python-redis'
  )
  optdepends=()

  cd fastmcp
  python -m installer --destdir="$pkgdir" fastmcp_tasks/dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

package_python-fastmcp-remote() {
  pkgdesc="Python stdio bridge for remote MCP servers"
  depends=(
    'python'
    'python-fastmcp'
  )
  optdepends=()

  cd fastmcp
  python -m installer --destdir="$pkgdir" fastmcp_remote/dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
