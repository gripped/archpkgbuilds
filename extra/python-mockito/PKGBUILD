# Contributor: Daniel Wallace <danielwallace at gtmanfred dot com>
# Contributor: Thomas S Hatch <thatch45@gmail.com>

pkgname=python-mockito
pkgver=2.0.1
pkgrel=1
pkgdesc='Spying framework'
arch=('any')
url='https://github.com/kaste/mockito-python'
license=('MIT')
depends=('python')
makedepends=('git' 'python-build' 'python-installer' 'python-hatchling' 'python-hatch-vcs')
checkdepends=('python-pytest' 'python-numpy')
source=("git+https://github.com/kaste/mockito-python.git#tag=$pkgver")
sha512sums=('6502871a6f876869cbc0c61b81d6bb88874aa5cb3bef4a68cd25a5e1208596a7d2e8eb5fd3e9a4b594bb167e164aa88b849830c5a636ce4aaa381f3718c361a1')

build() {
  cd mockito-python
  python -m build -nw
}

check() {
  cd mockito-python
  pytest
}

package() {
  cd mockito-python
  python -m installer -d "$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
