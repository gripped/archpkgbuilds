pkgname=pgbackrest
pkgver=2.59.2
pkgrel=1
pkgdesc='Reliable PostgreSQL backup and restore'
arch=(x86_64)
url="https://github.com/pgbackrest/pgbackrest"
license=(MIT)
depends=(bzip2 glibc libbacktrace libssh2 libxml2 lz4 openssl postgresql-libs zlib zstd)
makedepends=(git libyaml meson)
source=("git+$url#tag=release/$pkgver")
b2sums=('96660b9b10ad4770fc3ed6d056f87517c675739435dc4feec1cf8d78e40fb4160e9833de191341a83df6c46278e69ce1a68d147b8dc2ae04c351a8f7a24088b8')
backup=(etc/$pkgname/$pkgname.conf)

prepare() {
  echo '# Placeholder config. See https://pgbackrest.org/configuration.html for options.' > example.conf
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 example.conf "$pkgdir/etc/$pkgname/$pkgname.conf"
  install -Dm644 $pkgname/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
