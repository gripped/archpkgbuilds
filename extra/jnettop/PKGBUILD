# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Paul Bredbury <brebs@sent.com>

pkgname=jnettop
pkgver=0.13.0
pkgrel=10
pkgdesc="A top-like console network traffic visualizer"
arch=(x86_64)
url="https://web.archive.org/web/20160703195221/http://jnettop.kubs.info/wiki/"
license=('GPL-2.0-or-later')
depends=('glibc' 'ncurses' 'libpcap' 'glib2' 'db5.3')
makedepends=('pkgconfig')
source=("https://web.archive.org/web/20161221100811/http://jnettop.kubs.info/dist/$pkgname-$pkgver.tar.gz"
        "jnettop-0.13.0-autoconf.patch")
sha512sums=('304293cd011ce8556aabf69e91b2e831ac61aa43016bb5b616d24b45805315a815dfba37dfe9f7cd3c637931043d4123b2f46a7637ba1a0b9d30267fe6dcb051'
            'e49cbe44ed9fa6df93318cad4d9c9e8a129559d309e93cf1d9779a7324f3faa43ad30b3a33fc7fdb608b17776edd4bcb1ee76411160ae6b31119027aa18e0881')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  patch -Np1 -i ../jnettop-0.13.0-autoconf.patch
  autoreconf -fiv
}

build() {
  cd "$srcdir/$pkgname-$pkgver"

  LDFLAGS+=' -L/usr/lib/db5.3/' \
    ./configure CPPFLAGS="-I/usr/include/db5.3" \
    --prefix=/usr --mandir=/usr/share/man
  make
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}
