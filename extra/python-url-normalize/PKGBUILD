# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-url-normalize
pkgver=3.0.0
pkgrel=1
pkgdesc='URL normalization for Python'
arch=(any)
url='https://github.com/niksite/url-normalize'
license=(MIT)
depends=(python python-idna)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=(
  "$pkgname::git+$url#tag=v$pkgver"
  remove-pytest-args.patch
)
sha512sums=('4f655bfde246d63dcc0d102d6cc08d0231e782988c7095809f5e2521889d11beeb2337199bfcc697c0014d78842e3ac295b2be97d9af203d104fb890f6147b0f'
            'd5123db37bbf5982edac45a5c752271d96d89c10072ae5f582f50d575a9191f280332a5c8c0ce913a726aa6b99e0a187dfafeaec0eab9d0950c6e63cb36f65a9')
b2sums=('a03d3718b4a10268067462420f88758913383e750bf37e21e30eb0f49edfd3aa397c1d8021e088ca8b7fd24769d162d8b9a40c782b56b6eb30658e8974a59f7d'
        '0b0caa7b886ca01164f7b4a193694db8b8285398a3c77dcb9d77fbc0d6b7bb80e9153dc89e66a09fcaed8e2119e9261b5c4d0006d037c2cdc20d4e5ee322b5bb')

prepare() {
  cd "$pkgname"

  patch -p1 -i "$srcdir/remove-pytest-args.patch"
}

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  # install to temporary directory
  python -m installer --destdir="$PWD/tmp_install" dist/*.whl
  local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  export PYTHONPATH="$PWD/tmp_install$site_packages"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
