pkgname=deepin-session-shell
pkgver=6.0.33
pkgrel=1
pkgdesc='Deepin desktop-environment - session-shell module'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-session-shell-snipe"
license=('GPL-3.0-or-later')
# deepin-daemon: org.deepin.dde.Display1
# deepin-session: org.deepin.dde.Session1
depends=('bash' 'deepin-daemon' 'deepin-network-core' 'deepin-qt6integration' 'deepin-wallpapers'
         'liblightdm-qt6' 'lightdm' 'dtk6core' 'dtk6gui'
         'dtk6widget' 'libx11' 'libxcursor' 'qt6-svg' 'qt6-base' 'libxi' 'dconf'
         'libxtst' 'glibc' 'libxext' 'libxfixes' 'pam' 'libgcc' 'libstdc++'
         'libxrandr' 'libxcb' 'xcb-util-wm' 'openssl' 'deepin-session')
makedepends=('git' 'cmake' 'gmock' 'gtest' 'ninja' 'qt6-tools')
conflicts=('deepin-session-ui<5')
provides=('lightdm-deepin-greeter')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/dde-session-shell-snipe.git#tag=$pkgver"
        "fix-lightdm-qt6-visibility.patch")
sha512sums=('38073d9faf85e2b62ab230b0435d71f26531d3dfc33a513878c847659ab2e6354bd74a9e717b1bc28d2c05430a4e153a01d465e34aa2fbcadace970928da4135'
            '9eaff1aeecb04d54dff637913c06c036d29f8df9abe11760990972b732b08e47ffa55d7d060eb12ef7a6c4806d38a5da5ec783b4e8b38a18f77c1c20a925f738')

prepare() {
  cd dde-session-shell-snipe
  # We don't have common-auth on Arch
  sed -i 's/common-auth/system-login/' files/pam.d/dde-lock
  # liblightdm-qt6 1.33.0 installs raw Q_DECL_EXPORT in public headers, which
  # becomes protected visibility with Arch Qt and breaks consumer links.
  patch -Np1 -i ../fix-lightdm-qt6-visibility.patch
}

build() {
  cd dde-session-shell-snipe
  cmake . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_SYSCONFDIR=/etc -DDDE_SESSION_SHELL_SNIPE=ON
  ninja
}

package() {
  cd dde-session-shell-snipe
  DESTDIR="$pkgdir" ninja install

  chmod +x "$pkgdir"/usr/bin/deepin-greeter
}
