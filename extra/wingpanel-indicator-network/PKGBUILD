# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=wingpanel-indicator-network
pkgver=8.0.1
pkgrel=3
pkgdesc='Wingpanel Network Indicator'
arch=(x86_64)
url=https://launchpad.net/wingpanel-indicator-network
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  glib2
  glibc
  granite7
  gtk4
  libnm
  libnma-gtk4
  networkmanager
  polkit
  wingpanel
)
makedepends=(
  git
  meson
  vala
)
source=(git+https://github.com/elementary/wingpanel-indicator-network.git#tag=${pkgver})
b2sums=('74431171019661529c1825a0b94166466ba8f19468cace97d02a18e859c051990c6e39d55ceb699c56bedae46f9ae99e8fd24ec714570eb59677cf5af0e9ffdb')

prepare() {
  cd wingpanel-indicator-network

  # Update for GTK4 port
  git cherry-pick -n 8.0.1..6b1ba43c17033bb73bc6dd03e4fe57a2ca54b2bd
}

build() {
  arch-meson wingpanel-indicator-network build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}
