pkgname=libretro-flycast
pkgver=20260619.223320.gc6fe11017c61
pkgrel=1
pkgdesc='Sega Dreamcast core'
arch=(x86_64)
url=https://github.com/flyinghead/flycast
license=(GPL-2.0-only)
groups=(libretro)
depends=(
  libgl
  libretro-core-info
  zlib
)
makedepends=(
  cmake
  git
  mesa
  ninja
)
source=(
  git+https://github.com/flyinghead/flycast.git#commit=${pkgver##*.g}
  flycast-asio::git+https://github.com/flyinghead/asio.git
  git+https://github.com/KhronosGroup/glslang.git
  flycast-libchdr::git+https://github.com/flyinghead/libchdr.git
  git+https://github.com/Grumbel/tinycmmc.git
  flycast-tinygettext::git+https://github.com/flyinghead/tinygettext
  git+https://github.com/KhronosGroup/Vulkan-Headers.git
  git+https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git
  git+https://github.com/herumi/xbyak.git
)
b2sums=('3623b08896601f4f860ca88e6a851e5729376bc653eed55adfc58a3712516b753c3e956f721ce62b60f1f4504d8b3c1f177c8ff374dfbe3a52f6d869e88fac08'
        'SKIP'
        'SKIP'
        'SKIP'
        'SKIP'
        'SKIP'
        'SKIP'
        'SKIP'
        'SKIP')

prepare() {
  cd flycast
  for submodule in core/deps/{glslang,Vulkan-Headers,VulkanMemoryAllocator,xbyak}; do
    git submodule init ${submodule}
    git submodule set-url ${submodule} "${srcdir}/${submodule##*/}"
    git -c protocol.file.allow=always submodule update ${submodule}
  done
  for submodule in core/deps/{asio,libchdr,tinygettext}; do
    git submodule init ${submodule}
    git submodule set-url ${submodule} "${srcdir}/flycast-${submodule##*/}"
    git -c protocol.file.allow=always submodule update ${submodule}
  done
  cd core/deps/tinygettext
  for submodule in external/tinycmmc; do
    git submodule init ${submodule}
    git submodule set-url ${submodule} "${srcdir}/${submodule##*/}"
    git -c protocol.file.allow=always submodule update ${submodule}
  done
}

build() {
  cmake -S flycast -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DLIBRETRO=ON \
    -Wno-dev
  cmake --build build
}

package() {
  install -Dm 644 build/flycast_libretro.so -t "${pkgdir}"/usr/lib/libretro/
}

