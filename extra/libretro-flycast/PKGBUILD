pkgname=libretro-flycast
pkgver=20261024.003748.ge88b0ced2243
pkgrel=1
pkgdesc='Sega Dreamcast core'
arch=(x86_64)
url=https://github.com/flyinghead/flycast
license=(GPL-2.0-only)
groups=(libretro)
depends=(
  glibc
  libgcc
  libgl
  libgomp
  libretro-core-info
  libstdc++
)
makedepends=(
  cmake
  git
  mesa
  ninja
)
source=(
  git+https://github.com/flyinghead/flycast.git#commit=${pkgver##*.g}
  flycast-asio::git+https://github.com/flyinghead/asio.git
  git+https://github.com/KhronosGroup/glslang.git
  flycast-libchdr::git+https://github.com/flyinghead/libchdr.git
  git+https://github.com/Grumbel/tinycmmc.git
  flycast-tinygettext::git+https://github.com/flyinghead/tinygettext
  git+https://github.com/KhronosGroup/Vulkan-Headers.git
  git+https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git
  git+https://github.com/herumi/xbyak.git
)
b2sums=('b930c1b1a6aa52303d698f5119dd3e8c0bed69c4b778cf9cbf35c757d90b1b1bbca265a33a0f792206b090188b8b1c2be816087fef4965b36a6bdefdce481abc'
        'SKIP'
        'SKIP'
        'SKIP'
