# Maintainer: Torsten Keßler <tpkessler at archlinux dot org>
# Maintainer: Christian Heusel <gromit@archlinux.org>

pkgname=rocwmma
pkgver=10.1
pkgrel=1
pkgdesc='Library for accelerating mixed precision matrix multiplication'
arch=('x86_64')
url='https://rocm.docs.amd.com/projects/rocWMMA/en/latest/'
license=('MIT')
depends=(
    'hip-runtime-amd'
    'openmp'
    'rocblas'
    'rocm-core'
)
makedepends=(
    'doxygen'
    'ninja'
    'cmake'
    'rocm-cmake'
    'rocm-llvm'
    'rocm-toolchain'
)
_git='https://github.com/ROCm/rocm-libraries'
source=("$pkgname-$pkgver.tar.gz::$_git/releases/download/therock-$pkgver/$pkgname.tar.gz")
sha256sums=('2baf267c60c3cf5d95b70909daaa5180469bd9c41b44a9e4fb2967ee1177d6f4')
options=(!lto)

build() {
    local cmake_args=(
        -Wno-dev
        -B build
        -G Ninja
        -S "$pkgname"
        -D CMAKE_POLICY_VERSION_MINIMUM=3.5
        -D CMAKE_BUILD_TYPE=None
        -D CMAKE_CXX_COMPILER=amdclang++
        -D CMAKE_INSTALL_PREFIX=/opt/rocm
        -D ROCWMMA_BUILD_TESTS=OFF
        -D ROCWMMA_BUILD_SAMPLES=OFF
        -D ROCM_SYMLINK_LIBS=OFF
        -D HIP_PLATFORM=amd
        -D CMAKE_CXX_FLAGS="${CXXFLAGS} -fcf-protection=none"
        -D GPU_TARGETS=$(rocm-supported-gfx)
    )
    cmake "${cmake_args[@]}"
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    install -Dm644 "$pkgname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
