# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-langchain
pkgver=1.4.0
pkgrel=1
pkgdesc="Building applications with LLMs through composability"
arch=('any')
url="https://github.com/langchain-ai/langchain"
license=('MIT')
depends=(
  'python'
  'python-langchain-core'
  'python-langgraph'
  'python-pydantic'
)
optdepends=('python-fastmcp: MCP adapter support')
makedepends=(
  'git'
  'python-build'
  'python-hatchling'
  'python-installer'
  'python-wheel'
)
checkdepends=(
  'python-blockbuster'
  'python-dotenv'
  'python-fastmcp'
  'python-httpx'
  'python-langchain-openai'
  'python-langchain-tests'
  'python-pytest'
  'python-pytest-asyncio'
  'python-pytest-benchmark'
  'python-pytest-mock'
  'python-pytest-recording'
  'python-pytest-socket'
  'python-pytest-xdist'
  'python-requests'
  'python-syrupy'
  'python-toml'
  'python-vcrpy'
)
source=("git+https://github.com/langchain-ai/langchain.git")
sha512sums=('SKIP')

prepare() {
  cd langchain

  # makepkg's git fragment parser treats "=" inside tag values as separators.
  git checkout -q "langchain==$pkgver"

  # MCPAdapter connects cloned clients; inspect those clients' negotiated sessions.
  sed -i \
    -e 's/assert handshake_client\./assert cast("Client[Any]", handshake_adapter.client)./' \
    -e 's/assert modern_client\./assert cast("Client[Any]", modern_adapter.client)./' \
    libs/langchain_v1/tests/integration_tests/mcp/test_protocol_eras.py
  # With loopback hosts allowed, pytest-socket blocks external connections at connect().
  sed -i 's/pytest_socket.SocketBlockedError/pytest_socket.SocketConnectBlockedError/' \
    libs/langchain_v1/tests/unit_tests/test_pytest_config.py
}

build() {
  cd langchain/libs/langchain_v1
  python -m build --wheel --no-isolation
}

check() {
  cd langchain/libs/langchain_v1

  # OpenAI integration cases require provider credentials or outbound network;
  # upstream runs them in integration CI with secrets.
  # MCP integration tests need HTTP connections to local loopback servers.
  LANGGRAPH_TEST_FAST=1 python -m pytest \
    --benchmark-disable --disable-socket --allow-unix-socket \
    --allow-hosts=127.0.0.1,::1,localhost \
    --deselect=tests/integration_tests/agents/middleware/test_human_in_the_loop_integration.py::test_hitl_reject_does_not_retry[openai] \
    --deselect=tests/integration_tests/agents/middleware/test_shell_tool_integration.py::test_shell_tool_basic_execution[openai] \
    --deselect=tests/integration_tests/chat_models/test_base.py::TestStandard \
    --deselect=tests/integration_tests/embeddings/test_base.py::test_init_embedding_model[openai-text-embedding-3-large]
}

package() {
  cd langchain/libs/langchain_v1
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 ../../LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
