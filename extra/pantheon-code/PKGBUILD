pkgname=pantheon-code
pkgver=8.3.1
pkgrel=1
pkgdesc='The Pantheon Text Editor'
arch=(x86_64)
url=https://github.com/elementary/code
license=(GPL-3.0-or-later)
groups=(pantheon)
depends=(
  editorconfig-core-c
  dconf
  fontconfig
  glib2
  gtk3
  gtksourceview4
  libgee
  libgit2-glib
  libgranite.so
  libhandy-1.so
  libpeas-2.so
  pango
  polkit
  vala
  vte3
)
makedepends=(
  git
  gobject-introspection
  gtkspell3
  libsoup3
  meson
)
optdepends=(
  'gtkspell3: Spell Check plugin'
  'libsoup3: Pastebin plugin'
)
source=(pantheon-code::git+https://github.com/elementary/code.git#tag=${pkgver})
b2sums=('bb630baa0c7e8f529567a25db7b92de155316d0889ce5c8c5a12e1e648fdab090ecba827fd16fd9eb902b985482b85ae014040dd3c2d67e59dd1f942a8b8654c')

build() {
  arch-meson pantheon-code build
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}

