pkgname=pantheon-code
pkgver=8.3.0
pkgrel=1
pkgdesc='The Pantheon Text Editor'
arch=(x86_64)
url=https://github.com/elementary/code
license=(GPL-3.0-or-later)
groups=(pantheon)
depends=(
  editorconfig-core-c
  glib2
  gtk3
  gtksourceview4
  libgee
  libgit2-glib
  libgranite.so
  libhandy-1.so
  libpeas-2.so
  pango
  polkit
  vala
)
makedepends=(
  git
  gobject-introspection
  gtkspell3
  libsoup3
  meson
  vte3
)
optdepends=(
  'gtkspell3: Spell Check plugin'
  'libsoup3: Pastebin plugin'
  'vte3: Terminal plugin'
)
source=(pantheon-code::git+https://github.com/elementary/code.git#tag=${pkgver})
b2sums=('17b4f6e639ba52d9b126e4b2cc16eb57432d771c044a95ed2fc12b175fd321768bfcc2f1b37dc5271ec2dae5ef13e770b9e94407fd3a53bf57d1aeeb5b258d58')

build() {
  arch-meson pantheon-code build
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}

