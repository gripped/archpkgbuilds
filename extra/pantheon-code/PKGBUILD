pkgname=pantheon-code
pkgver=8.3.2
pkgrel=1
pkgdesc='The Pantheon Text Editor'
arch=(x86_64)
url=https://github.com/elementary/code
license=(GPL-3.0-or-later)
groups=(pantheon)
depends=(
  editorconfig-core-c
  dconf
  fontconfig
  glib2
  gtk3
  gtksourceview4
  libgee
  libgit2-glib
  libgranite.so
  libhandy-1.so
  libpeas-2.so
  pango
  polkit
  vala
  vte3
)
makedepends=(
  git
  gobject-introspection
  gtkspell3
  libsoup3
  meson
)
optdepends=(
  'gtkspell3: Spell Check plugin'
  'libsoup3: Pastebin plugin'
)
source=(pantheon-code::git+https://github.com/elementary/code.git#tag=${pkgver})
b2sums=('4c418f828aca31d29257f5048a22d75ea4ea58f7e9b6507781228fc00386e4ed2d1aa08ce29f5e32310b18d11fb636cbccc849b98e3c0a63ed39debf0e3b5552')

build() {
  arch-meson pantheon-code build
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}

