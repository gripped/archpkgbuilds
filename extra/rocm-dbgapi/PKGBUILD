# Maintainer: Torsten Keßler <tpkessler at archlinux dot org>
# Maintainer: Christian Heusel <gromit@archlinux.org>

pkgname=rocm-dbgapi
pkgver=10.1
pkgrel=1
pkgdesc="Support library necessary for a debugger of AMD's GPUs"
arch=('x86_64')
url="https://rocm.docs.amd.com/projects/ROCdbgapi/en/latest/"
license=('MIT')
depends=(
    'comgr'
    'glibc'
    'hsa-rocr'
    'libgcc'
    'libstdc++'
    'rocm-core'
)
makedepends=('cmake' 'rocm-cmake')
_git='https://github.com/ROCm/rocm-systems'
source=("rocm-$pkgver.tar.gz::$_git/archive/therock-$pkgver.tar.gz")
sha256sums=('31dc4296cb15c3eada729743731d236ee4a52e4a2a301b9da9075b94c012be19')
_dirname="$(basename "$_git")-therock-$pkgver/projects/rocdbgapi"

build() {
    local cmake_args=(
        -Wno-dev
        -B build
        -S "$_dirname"
        -D CMAKE_BUILD_TYPE=None
        -D CMAKE_INSTALL_PREFIX=/opt/rocm
        # GCC 16 added -Wsfinae-incomplete and upstream hasn't fixed this yet
        -D CMAKE_CXX_FLAGS="${CXXFLAGS} -Wno-error=sfinae-incomplete"
    )
    cmake "${cmake_args[@]}"
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$srcdir/$_dirname/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
