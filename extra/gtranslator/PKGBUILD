pkgname=gtranslator
pkgver=50.0
pkgrel=1
pkgdesc='An enhanced gettext po file editor for the GNOME desktop environment'
arch=(x86_64)
url='https://gitlab.gnome.org/GNOME/gtranslator'
license=(GPL-3.0-or-later)
depends=(
  cairo
  dconf
  gettext
  glib2
  glibc
  gtk4
  gtksourceview5
  hicolor-icon-theme
  iso-codes
  json-glib
  libadwaita
  libgcc
  libgda6
  libsoup3
  libspelling
  libxml2
  pango
  sqlite
)
makedepends=(
  appstream
  git
  glib2-devel
  gobject-introspection
  meson
  yelp-tools
)
source=("git+https://gitlab.gnome.org/GNOME/$pkgname.git#tag=${pkgver/[a-z]/.&}")
b2sums=('0e3b8c0e1bba69777e079efbed6ef104b8d35eeba5e431528980fe543324736d6a033c8478ea8ec6d87777249aed43fb85d72b445042abee0820026c81ac7047')

prepare() {
  cd $pkgname
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
