prepare() {
  cd pantheon-session-settings

  # Remove onboard
  # https://github.com/elementary/session-settings/pull/83
  git cherry-pick -n cfbcda4a045e56e0cb09ab05978598d2e9761372

  # Remove autostarts
  # https://github.com/elementary/session-settings/pull/100
  git cherry-pick -n 6e8eee77d0735744630570655d87649547a8f174

  # Default X11 building to false
  # https://github.com/elementary/session-settings/pull/98
  git cherry-pick -n 0a69481c20b73d7cd774e88e6fb043c52644e350

  # Don't install session config for X11 if support is disabled
  # https://github.com/elementary/session-settings/pull/108
  git apply -3 ../pantheon-session-no-x11-conf.patch

  # Replace Evince with Papers
  # https://github.com/elementary/session-settings/pull/109
  git apply -3 ../pantheon-session-papers.patch

  # Update GSD components
  # https://github.com/elementary/session-settings/pull/110
  git apply -3 ../pantheon-session-gsd-components.patch

  # Add more desktop components
  # https://github.com/elementary/session-settings/pull/111
  git apply -3 ../pantheon-session-desktop-components.patch

  # Rename session to make it identifiable
  sed -i 's/^Name=Secure Session/Name=Pantheon/' wayland-sessions/pantheon-wayland.desktop.in
}

build() {
  arch-meson pantheon-session-settings build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}

