# Contributor: Gilles Gagniard <gilles@gagniard.org>
# Contributor: JD Steffen <jd at steffennet dot org>

pkgname=simutrans
pkgver=124.5
pkgrel=1
pkgdesc='Transportation simulation game'
arch=(x86_64)
url='https://www.simutrans.com/'
license=(Artistic-1.0)
depends=(
  bash
  bzip2
  fontconfig
  freetype2
  glibc
  hicolor-icon-theme
  libgcc
  libpng
  libstdc++
  sdl2
  simutrans-pak
  zlib
  zstd
)
makedepends=(
  cmake
  git
  ninja
)
optdepends=('timidity++: Play MIDI music')
source=(
  "git+https://github.com/simutrans/simutrans#tag=$pkgver"
  simutrans-settings-folder.patch
)
b2sums=(
  2f39b1fdff940c55af1a6172df4c261d71a759eab31c5c8427339008479d7ea01ff100dafeb3ede28b4df996c3d52036b2e99a067bf61e3ac90b834ace5db665
  771342609e9f1ae50c2703b649db6e41bd07dadab176171c3713cc6854be608430a4b55c64be37b5e2b2009e4e0a31b87098b897b95647d9258dc781fa527e7e
)

prepare() {
  cd $pkgname

  # Use standard fallback paths
  # https://github.com/simutrans/simutrans/pull/12
  git apply -3 ../simutrans-settings-folder.patch
}

build() {
  cmake -B build -S $pkgname -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D USE_GAMES_DATADIR=1
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 -t "$pkgdir/usr/share/licenses/simutrans" simutrans/simutrans/license.txt
}
