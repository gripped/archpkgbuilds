# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=pantheon-tasks
pkgver=6.3.3
pkgrel=6
pkgdesc='The Pantheon tasks'
arch=(x86_64)
url=https://github.com/elementary/tasks
license=(GPL-3.0-or-later)
groups=(pantheon)
depends=(
  dconf
  geoclue
  geocode-glib-2
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  json-glib
  libadwaita-1.so
  libecal-2.0.so
  libedataserver-1.2.so
  libgee
  libgranite-7.so
  libical
  libportal
  libportal-gtk4
  libshumate-1.0.so
)
makedepends=(
  git
  meson
  vala
)
source=(pantheon-tasks::git+https://github.com/elementary/tasks.git#tag=${pkgver})
b2sums=('a287f60596d0723b4ff76a037840878ed75127195e68ae6046fcc3a480fa36baa7314039d67dae8da8e254e544a4f20e7ef8abdd35bd112bce2668572f67da91')

prepare() {
  cd pantheon-tasks

  # Update to git snapshot for GTK4 port (removes deprecated clutter dependency)
  git cherry-pick -n 6.3.3..1509007edfb932d60086ce4f4f14afe09440d6a0
}

build() {
  arch-meson pantheon-tasks build
  meson compile -C build
}

package() {
  DESTDIR="${pkgdir}" meson install -C build
}

