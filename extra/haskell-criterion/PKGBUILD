# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Arch Haskell Team <arch-haskell@haskell.org>

_hkgname=criterion
pkgname=haskell-criterion
pkgver=1.6.4.1
pkgrel=2
pkgdesc="Robust, reliable performance measurement and analysis"
url="https://github.com/haskell/criterion"
license=('BSD-3-Clause')
arch=('x86_64')
depends=('ghc-libs' 'haskell-aeson' 'haskell-base-compat-batteries' 'haskell-binary-orphans'
         'haskell-cassava' 'haskell-code-page' 'haskell-criterion-measurement' 'haskell-glob'
         'haskell-js-chart' 'haskell-microstache' 'haskell-mwc-random'
         'haskell-optparse-applicative' 'haskell-prettyprinter'
         'haskell-prettyprinter-ansi-terminal' 'haskell-statistics' 'haskell-transformers-compat'
         'haskell-vector' 'haskell-vector-algorithms')
makedepends=('git' 'ghc' 'haskell-base-compat' 'haskell-hunit' 'haskell-quickcheck' 'haskell-tasty'
             'haskell-tasty-hunit' 'haskell-tasty-quickcheck')
source=("git+https://github.com/haskell/criterion.git#tag=${_hkgname}-${pkgver}")
sha512sums=('663dd10d29a483c75331b46330433db1570e547f67e994ab3b081a8ba41bcbe0584a7bf9b885ecc8ec3e3a0d8a83fe6ec0ff0394522b287e2170f51e31b84c3a')

prepare() {
    cd $_hkgname
    # tests/Cleanup: prevent parallel test execution with tasty >= 1.5.4
    # https://github.com/haskell/criterion/commit/d555422d1779434432489efbc19d75011226c3e6
    git cherry-pick -n d555422d1779434432489efbc19d75011226c3e6
}

build() {
    cd $_hkgname

    runhaskell Setup configure -O --enable-shared --enable-debug-info --enable-executable-dynamic --disable-library-vanilla \
        --prefix=/usr --docdir=/usr/share/doc/$pkgname --datasubdir=$pkgname --enable-tests \
        --dynlibdir=/usr/lib --libsubdir=\$compiler/site-local/\$pkgid \
            -f-fast -f-embed-data-files
    runhaskell Setup build $MAKEFLAGS
    runhaskell Setup register --gen-script
    runhaskell Setup unregister --gen-script
    sed -i -r -e "s|ghc-pkg.*update[^ ]* |&'--force' |" register.sh
    sed -i -r -e "s|ghc-pkg.*unregister[^ ]* |&'--force' |" unregister.sh
}

check() {
    cd $_hkgname
    runhaskell Setup test --show-details=direct
}

package() {
    cd $_hkgname

    install -D -m744 register.sh "$pkgdir"/usr/share/haskell/register/$pkgname.sh
    install -D -m744 unregister.sh "$pkgdir"/usr/share/haskell/unregister/$pkgname.sh
    runhaskell Setup copy --destdir="$pkgdir"
    install -D -m644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
    rm -f "$pkgdir"/usr/share/doc/$pkgname/LICENSE
}
