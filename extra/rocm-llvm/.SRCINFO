pkgname = rocm-llvm
	pkgdesc = Radeon Open Compute - LLVM toolchain (clang, lld)
	license = Apache-2.0 WITH LLVM-exception
	depends = rocm-llvm-libs
	depends = rocm-core
	depends = perl
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = zlib
	depends = zstd
	depends = libffi
	depends = libedit
	depends = ncurses
	depends = libxml2
	optdepends = rocm-flang: Fortran compiler
	optdepends = rocm-llvm-headers: LLVM headers
	optdepends = rocm-llvm-static: LLVM static libraries and CMake config
	optdepends = rocm-llvm-tools: LLVM development tools
	optdepends = rocm-openmp: OpenMP host runtime and GPU offloading

pkgname = rocm-llvm-libs
	pkgdesc = Radeon Open Compute - LLVM runtime libraries
	license = Apache-2.0 WITH LLVM-exception
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = zlib
	depends = zstd
	depends = libffi
	depends = libedit
	depends = ncurses
	depends = libxml2

pkgname = rocm-mlir-libs
	pkgdesc = Radeon Open Compute - MLIR runtime libraries
	license = Apache-2.0 WITH LLVM-exception
	depends = rocm-llvm-libs
	depends = glibc
	depends = libgcc
	depends = libstdc++

pkgname = rocm-llvm-tools
	pkgdesc = Radeon Open Compute - LLVM development tools
	license = Apache-2.0 WITH LLVM-exception
	depends = rocm-llvm=2:10.1-6
	depends = rocm-llvm-libs
	depends = rocm-mlir-libs

pkgname = rocm-llvm-headers
	pkgdesc = Radeon Open Compute - LLVM headers
	license = Apache-2.0 WITH LLVM-exception
	depends = rocm-llvm=2:10.1-6

pkgname = rocm-llvm-static
	pkgdesc = Radeon Open Compute - LLVM static libraries and CMake configuration
	license = Apache-2.0 WITH LLVM-exception
	depends = rocm-llvm-headers=2:10.1-6
	depends = rocm-llvm-tools=2:10.1-6
	optdepends = rocm-flang: find_package(Flang)
	optdepends = python-numpy: MLIR Python bindings

pkgname = rocm-flang
	pkgdesc = Radeon Open Compute - Fortran compiler
	license = Apache-2.0 WITH LLVM-exception
	depends = rocm-llvm=2:10.1-6
	depends = rocm-llvm-libs
	depends = rocm-mlir-libs
	depends = gcc-libs
	depends = glibc
	depends = libgcc
	depends = libstdc++
	optdepends = rocm-openmp: OpenMP GPU offloading from Fortran

pkgname = rocm-device-libs
	pkgdesc = AMD specific device-side language runtime libraries
	license = NCSA
	depends = rocm-core

pkgname = comgr
	pkgdesc = AMDGPU GPU Code Object Manager
	license = NCSA
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = zstd
	depends = zlib
	depends = ncurses
	depends = rocm-core
	depends = rocm-llvm-libs
	depends = rocm-device-libs
