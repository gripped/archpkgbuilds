# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=tangram
pkgver=3.5
pkgrel=1
pkgdesc='Browser for your pinned tabs'
arch=(any)
url='https://apps.gnome.org/Tangram/'
license=(GPL-3.0-only)
groups=(gnome-circle)
depends=(
  dconf
  gdk-pixbuf2
  gjs
  glib2
  gstreamer
  gtk4
  hicolor-icon-theme
  libadwaita
  libsoup3
  webkitgtk-6.0
)
makedepends=(
  appstream
  blueprint-compiler
  git
  meson
)
source=(
  "git+https://github.com/sonnyp/Tangram.git#tag=v$pkgver"
  git+https://github.com/sonnyp/troll.git
)
b2sums=(
  1e5df6523968086b579959af4e3da0fcc05c450d951bde4b13c23c264453e2ff64530c87186ae790ee48b66ae15a755f8e62b7dd2ee503cdf5cefcfa4eac8269
  SKIP
)

prepare() {
  cd Tangram

  git submodule init
  git submodule set-url troll "$srcdir/troll"
  git -c protocol.file.allow=always submodule update
}

build() {
  arch-meson Tangram build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  ln -s re.sonny.Tangram "$pkgdir/usr/bin/tangram"
}
