# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=anewer
pkgver=0.2.1
pkgrel=1
pkgdesc="Appends lines from stdin to a file if they don't already exist in the file"
url='https://github.com/ysf/anewer'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=(
  'glibc'
  'libgcc' 'libgcc_s.so'
)
makedepends=(
  'cargo'
)
source=(https://github.com/ysf/${pkgname}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz)
b2sums=('d4a6d7f05c906633ba9aaf0f94f83ae4297393f75a5c0ece42ea8637999afa63d3de1e5220c0f8351e079daf44b782a66c32774f6c94c3078c351c82873eccc1')

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target host-tuple
}

build() {
  cd ${pkgname}-${pkgver}
  cargo build --frozen --release
}

check() {
  cd ${pkgname}-${pkgver}
  cargo test --frozen
}

package() {
  cd ${pkgname}-${pkgver}
  install -Dm 755 -t "${pkgdir}/usr/bin" \
    target/release/anewer
}

