# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=typesetter
pkgver=0.16.8
pkgrel=1
pkgdesc='A minimalist local-first Typst editor'
arch=(x86_64 aarch64)
url='https://codeberg.org/haydn/typesetter'
license=(GPL-3.0-or-later)
depends=(
  libadwaita
  gtk4
  hicolor-icon-theme
  dconf
  libgcc
  glib2
  glibc
  gtksourceview5
  libspelling
  pango
  gdk-pixbuf2
  openssl
  cairo
  graphene
  zstd
)
makedepends=(
  git
  rust
  blueprint-compiler
  meson
  libvirt
  libvirt-glib
)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('8226d8dfb3d503fed3dc7559103e72b2bd54ae0407daf1ab9348c9d47d8accadb0cef5deffd20acaead47ff9e77a9ae1a0e273eab3fabd7a5fc9c483526eee0e')
b2sums=('1aa6112e0c7472fe77ddfbe192236dffaba59312339592febba1c93bbe487aaf781917f515feb31a3bee3e2e8976b1d9dfa003d52a0ef61fd6e5a1beaeb5cc2a')

prepare() {
  cd "$pkgname"

  # download dependencies
  CARGO_HOME="$srcdir/build/cargo-home" \
    cargo fetch --locked --target host-tuple

  # use system zstd
  export ZSTD_SYS_USE_PKG_CONFIG=1

  # use system openssl
  export OPENSSL_NO_VENDOR=1
}

build() {
  arch-meson build "$pkgname" --buildtype=release
  meson compile -C build
}

check() {
  meson test -C build --no-rebuild --print-errorlogs
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
