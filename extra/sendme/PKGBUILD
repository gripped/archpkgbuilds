# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=sendme
pkgver=0.35.0
pkgrel=1
pkgdesc="A tool to send files and directories, based on iroh"
arch=(x86_64)
url="https://github.com/n0-computer/sendme"
license=('Apache-2.0 OR MIT')
depends=(
  glibc
  libgcc
)
makedepends=(
  rust
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('001c633817d9bd036facec140bc11cfe2271ed63f2c3c2eae8a9437ba7265cb21003e12cd43bb860553e09c51817aea1a9850e2fb77a66a15f7cf6f3df117231')
b2sums=('b953eb34c7af3e0a846926383b66b9a7109b8321f85306e8286b330d5af93f79aff08a88def5b98057ba76e0adbfc5fbd551f9c31635f62f8a4b3560d65b9c03')

prepare() {
  cd $pkgname-$pkgver
  cargo fetch --locked --target host-tuple
}

build() {
  cd $pkgname-$pkgver
  # NOTE: The ring dependency cannot be built/linked with LTO.
  CFLAGS+=' -ffat-lto-objects'
  cargo build --frozen --release
}

check() {
  cd $pkgname-$pkgver
  cargo test --frozen
}

package() {
  cd $pkgname-$pkgver
  install -vDm 755 target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 LICENSE-{APACHE,MIT} -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
