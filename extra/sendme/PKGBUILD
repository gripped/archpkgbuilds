# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=sendme
pkgver=0.36.0
pkgrel=1
pkgdesc="A tool to send files and directories, based on iroh"
arch=(x86_64)
url="https://github.com/n0-computer/sendme"
license=('Apache-2.0 OR MIT')
depends=(
  glibc
  libgcc
)
makedepends=(
  rust
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('aa98555782d5464c28daa1da5331cc238d2d271eb5f3ecf7e4ccb9c0a686f7ff387ff610d55f7422ee64844beb9972ac74661ef2eeace5019da4f44a27bd8ff3')
b2sums=('51c0ef089042d753b424f71d20d25128336219fc706691f35d2a4043d2603eae72f84b46efac964112aaa00ca188cc8e7b260a4110f839a0ca74d937695cde6e')

prepare() {
  cd $pkgname-$pkgver
  cargo fetch --locked --target host-tuple
}

build() {
  cd $pkgname-$pkgver
  # NOTE: The ring dependency cannot be built/linked with LTO.
  CFLAGS+=' -ffat-lto-objects'
  cargo build --frozen --release
}

check() {
  cd $pkgname-$pkgver
  cargo test --frozen
}

package() {
  cd $pkgname-$pkgver
  install -vDm 755 target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 LICENSE-{APACHE,MIT} -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
