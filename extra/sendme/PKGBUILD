# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=sendme
pkgver=0.33.0
pkgrel=1
pkgdesc="A tool to send files and directories, based on iroh"
arch=(x86_64)
url="https://github.com/n0-computer/sendme"
license=('Apache-2.0 OR MIT')
depends=(
  glibc
  libgcc
)
makedepends=(
  rust
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('b0e2364f50ac34c794653cc47c396c6dd804134ff91d3b73d912de7f80b80cb7e3473f92dbe5755a61f80515ef5e2aee380f194de16af7e2fe4d6bb508bc296a')
b2sums=('f924cba4cdee6f23d9bad47fc26ff92b5855810744043bc9c3964ac5a10649f4b056787647455e87b2301d1f6a78abb8356218de8828e4febc793bdd126796ac')

prepare() {
  cd $pkgname-$pkgver
  cargo fetch --locked --target host-tuple
}

build() {
  cd $pkgname-$pkgver
  # NOTE: The ring dependency cannot be built/linked with LTO.
  CFLAGS+=' -ffat-lto-objects'
  cargo build --frozen --release
}

check() {
  cd $pkgname-$pkgver
  cargo test --frozen
}

package() {
  cd $pkgname-$pkgver
  install -vDm 755 target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 LICENSE-{APACHE,MIT} -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
