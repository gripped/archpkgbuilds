# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=sendme
pkgver=0.36.1
pkgrel=1
pkgdesc="A tool to send files and directories, based on iroh"
arch=(x86_64)
url="https://github.com/n0-computer/sendme"
license=('Apache-2.0 OR MIT')
depends=(
  glibc
  libgcc
)
makedepends=(
  rust
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('97a04ca70519a58f33fb73b6bfe2d7ffa00d2bf607608afb7335fcce0ddd97291e3cec6a1c3c7cf8b56b8ca267e66aaf1e5f14faf1cb5be0719bbfbdbaaa0a2f')
b2sums=('9fde8a7b8fa1cc50ef64c408625af2695f3a138f749c88b35a7ae0f085fc01b0ebed5b384e3d1060c3e2ca50e15828227dc9f8927ebc88eb2d2c1d890189ac18')

prepare() {
  cd $pkgname-$pkgver
  cargo fetch --locked --target host-tuple
}

build() {
  cd $pkgname-$pkgver
  # NOTE: The ring dependency cannot be built/linked with LTO.
  CFLAGS+=' -ffat-lto-objects'
  cargo build --frozen --release
}

check() {
  cd $pkgname-$pkgver
  cargo test --frozen
}

package() {
  cd $pkgname-$pkgver
  install -vDm 755 target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 LICENSE-{APACHE,MIT} -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
