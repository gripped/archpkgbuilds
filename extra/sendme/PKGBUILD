# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=sendme
pkgver=0.34.0
pkgrel=1
pkgdesc="A tool to send files and directories, based on iroh"
arch=(x86_64)
url="https://github.com/n0-computer/sendme"
license=('Apache-2.0 OR MIT')
depends=(
  glibc
  libgcc
)
makedepends=(
  rust
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('b70ccfb19adc65a9db454b99668ee324fa7066311951e4f6be460414e3769cd35d75c91c6b8e24894d65a2a511ac26d4581ff275d6b86534cfd1b98c54d02829')
b2sums=('e86d8331f86c117a1efbc5ac748bfeb766202fd1d9dd3678ab26f1d597b459b1afb889448b7f4c9ea0dd4d0a4b1b0ec4a14d8071bc9e189e58aa10d81632b2c0')

prepare() {
  cd $pkgname-$pkgver
  cargo fetch --locked --target host-tuple
}

build() {
  cd $pkgname-$pkgver
  # NOTE: The ring dependency cannot be built/linked with LTO.
  CFLAGS+=' -ffat-lto-objects'
  cargo build --frozen --release
}

check() {
  cd $pkgname-$pkgver
  cargo test --frozen
}

package() {
  cd $pkgname-$pkgver
  install -vDm 755 target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 LICENSE-{APACHE,MIT} -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
