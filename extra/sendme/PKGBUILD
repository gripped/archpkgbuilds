# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=sendme
pkgver=0.37.1
pkgrel=1
pkgdesc="A tool to send files and directories, based on iroh"
arch=(x86_64)
url="https://github.com/n0-computer/sendme"
license=('Apache-2.0 OR MIT')
depends=(
  glibc
  libgcc
)
makedepends=(
  rust
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('dafdb1424dc6373cd7f3f918c8a40add4cf22dc58e3472db5ee76ee2ad832945b76d6c6b89f0420ceed08be47ecd9d14d0ac27ec8c993d6f7b179ba5c486ad4e')
b2sums=('08d2e8dfce1e9014cb7cf5d0ab8ffec5121ec556f78e1db6774af35e59283c232f101526b3978119bc73202c800c8c982bb13d2d5c2240d375369bdcd1f745a2')

prepare() {
  cd $pkgname-$pkgver
  cargo fetch --locked --target host-tuple
}

build() {
  cd $pkgname-$pkgver
  # NOTE: The ring dependency cannot be built/linked with LTO.
  CFLAGS+=' -ffat-lto-objects'
  cargo build --frozen --release
}

check() {
  cd $pkgname-$pkgver
  cargo test --frozen
}

package() {
  cd $pkgname-$pkgver
  install -vDm 755 target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 LICENSE-{APACHE,MIT} -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
