pkgname=setconf
pkgver=0.7.8
pkgrel=1
pkgdesc='Utility for easily changing settings in configuration files'
arch=(any)
url='https://setconf.roboticoverlords.org'
license=(GPL-2.0-or-later)
depends=(python)
validpgpkeys=('8A9BC5819C54FEB3DC2A9B48C32217F6F13FF192')
source=("$url/$pkgname-$pkgver.tar.xz"{,.asc})
b2sums=('98e179a74476c8a70350b22e69726831808684fd596ffa5d19f64aea677da56a178f593bded267f6b1d36e1e0173bede4c7ea84dda61e7c01b5db7356d08e628'
        'SKIP')

package() {
  cd $pkgname-$pkgver
  install -Dm755 $pkgname.py "$pkgdir/usr/bin/$pkgname"
  install -Dm644 $pkgname.1.gz "$pkgdir/usr/share/man/man1/$pkgname.1.gz"
}
