# Maintainer: Christian Rebischke <chris.rebischke@archlinux.org>
# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=helmfile
pkgver=1.8.0
pkgrel=1
pkgdesc="Manage multiple helm charts with a single helmfile"
arch=('x86_64')
url="https://github.com/helmfile/helmfile"
license=('MIT')
depends=(
  'glibc'
  'helm'
)
makedepends=(
  'go'
  'git'
)
options=('!lto')
source=("git+$url.git#tag=v${pkgver}")
sha512sums=('ff8faecf500d5fcb2520e94a4803b59342fb4c4791ea0efa15050f2eed04b2e527452e496f4865a1294802700e18feba3e79573cf19d822f176e89d7b43abf29')
b2sums=('356d0d4ce1c1e8907e6ec1a5efb9a2ae620aa697651624928168721c446c51c4abed17417ce26e0e13cc0b62bad10136bfda08d970aa81788896e06705161af7')

prepare() {
  cd $pkgname
  GOFLAGS="-mod=readonly" go mod vendor -v
}

build() {
  cd $pkgname
  export CGO_LDFLAGS="$LDFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export GOFLAGS="-buildmode=pie -mod=vendor -modcacherw"
  export GOPATH="$srcdir"

  local ld_flags=" \
    -compressdwarf=false \
    -linkmode=external \
  "
  go build -v -ldflags "$ld_flags" -o build/
}

check() {
  cd $pkgname
  # Not sure why this test fails
  local unit_tests=$(
    go list ./... \
      | grep -v github.com/helmfile/helmfile/test/e2e/template/helmfile \
  )
  # shellcheck disable=SC2086
  go test -v $unit_tests
}

package() {
  cd $pkgname
  install -vDm755 -t "$pkgdir/usr/bin" build/helmfile
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
