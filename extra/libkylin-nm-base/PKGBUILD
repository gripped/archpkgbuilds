# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=libkylin-nm-base
pkgver=4.20.0.2
pkgrel=2
pkgdesc="NetworkManager integration and credential libraries for UKUI"
arch=('x86_64')
license=('GPL-2.0-or-later')
url="https://gitee.com/openkylin/libkylin-nm-base"
groups=('ukui')
depends=('glib2' 'glibc' 'gsettings-qt6' 'gtk3' 'kwindowsystem' 'libcap' 'libgcc'
         'libkysdk-applications' 'libnm' 'libnma' 'libsecret' 'libstdc++'
         'networkmanager' 'networkmanager-qt' 'qt6-base' 'qt6-svg')
makedepends=('dbus-glib' 'git' 'qt6-tools')
provides=('libkylin-nm-base.so' 'libkylin-keyring.so')
source=("git+https://gitee.com/openkylin/libkylin-nm-base.git#tag=debian/$pkgver-1")
sha512sums=('c78891cddc87e9a8742e09cb62d43e00503eb188f29b73f2ec2a7c826bddef962a2736c66b25d7777d824a2f6a9f70cb671c33d2906f7dd2601093f67f0c40e8')

prepare() {
  cd libkylin-nm-base
  # Use the build flags passed to qmake instead of invoking Debian tools.
  sed -i '/dpkg-buildflags/d' kylin-keyring/kylin-keyring.pro
  # Install usable pkg-config metadata in Arch's library directory.
  sed -i -e 's|QMAKE_PKGCONFIG_DESTDIR = .*|QMAKE_PKGCONFIG_DESTDIR = pkgconfig|' \
    -e "s|QMAKE_PKGCONFIG_VERSION = .*|QMAKE_PKGCONFIG_VERSION = $pkgver|" \
    -e 's|QMAKE_PKGCONFIG_INCDIR = .*|QMAKE_PKGCONFIG_INCDIR = $$manager.path|' \
    -e 's|QMAKE_PKGCONFIG_CFLAGS += .*|QMAKE_PKGCONFIG_CFLAGS += -I/usr/include/KF6/NetworkManagerQt|' \
    -e 's|QMAKE_PKGCONFIG_REQUIRES = .*|QMAKE_PKGCONFIG_REQUIRES = gio-2.0 glib-2.0 libnm Qt6Core Qt6DBus Qt6Network|' \
    libnm-kylin/libnm-base-kylin/libnm-base-kylin.pro
}

# Upstream disables tests that require physical Ethernet/Wi-Fi devices and modify connections.
build() {
  cd libkylin-nm-base
  qmake6 kylin-nm.pro \
    QMAKE_CFLAGS_RELEASE="$CPPFLAGS $CFLAGS" \
    QMAKE_CXXFLAGS_RELEASE="$CPPFLAGS $CXXFLAGS" \
    QMAKE_LFLAGS_RELEASE="$LDFLAGS"
  make
}

package() {
  cd libkylin-nm-base
  make INSTALL_ROOT="$pkgdir" install
  # Public headers expose NetworkManagerQt types; qmake omits this link dependency.
  sed -i '/^Libs:/s/$/ -lKF6NetworkManagerQt/' "$pkgdir/usr/lib/pkgconfig/kylin-nm-base.pc"
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
