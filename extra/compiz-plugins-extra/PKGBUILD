# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=compiz-plugins-extra
pkgver=0.8.18
pkgrel=1
pkgdesc='Extra plugins for Compiz'
arch=(x86_64)
url='https://gitlab.com/compiz/compiz-plugins-extra'
license=(GPL-2.0-or-later)
depends=(
  cairo
  compiz-core
  compiz-plugins-main
  glib2
  glibc
  glu
  libnotify
  libx11
  libxext
  libxfixes
  libxrender
)
makedepends=(
  compiz-bcop
  git
  intltool
)
source=("git+https://gitlab.com/compiz/compiz-plugins-extra.git#tag=v$pkgver")
b2sums=(13409a8f9827296390656b7cf641a8c59ca3dc170ddcba7f2d752a4d9a0472950f441cdb1c3454641febd2777ed740f396c68e1769fd83943ee3c8cf3002f762)

prepare() {
  cd $pkgname

  # Fixed build with gcc-14
  # https://gitlab.com/compiz/compiz-plugins-extra/-/merge_requests/50
  git cherry-pick -n e4f0ed898dbfaffc287be7e695cd486ea2597f97

  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
