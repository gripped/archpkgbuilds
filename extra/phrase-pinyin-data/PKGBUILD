pkgname=phrase-pinyin-data
pkgver=0.20.0
pkgrel=1
pkgdesc="Pinyin Data for Phrases"
arch=('any')
license=('MIT')
url="https://github.com/mozillazg/phrase-pinyin-data"
depends=()
makedepends=('git')
source=("git+https://github.com/mozillazg/phrase-pinyin-data.git#tag=v$pkgver")
sha512sums=('19dfa4578f856135747c51c5a889243e002600a5934a28f5e8353369538a3ba276d8138d7ddf6f6a6aa1078e36ba391cba7498aa4f22549538779ae2cfc3fe2f')

package() {
  cd $pkgname
  install -Dm644 cc_cedict.txt pinyin.txt -t "$pkgdir"/usr/share/$pkgname/
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
