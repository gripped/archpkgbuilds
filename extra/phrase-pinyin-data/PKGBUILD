pkgname=phrase-pinyin-data
pkgver=0.20.1
pkgrel=1
pkgdesc="Pinyin Data for Phrases"
arch=('any')
license=('MIT')
url="https://github.com/mozillazg/phrase-pinyin-data"
depends=()
makedepends=('git')
source=("git+https://github.com/mozillazg/phrase-pinyin-data.git#tag=v$pkgver")
sha512sums=('95273caf8a14f062cd5231f6cb97c48482d29d2784a3bd094837931d7ea6d6451690511fae9e03f955a3391391635fce90bc59e5a1d4b174cd7e51bc4f0c7ee0')

package() {
  cd $pkgname
  install -Dm644 cc_cedict.txt pinyin.txt -t "$pkgdir"/usr/share/$pkgname/
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
