# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Bruce Zhang <zttt183525594@gmail.com>

pkgname=python-janus
pkgver=2.1.1
pkgrel=1
pkgdesc="Thread-safe asyncio-aware queue for Python"
arch=('any')
url="https://github.com/aio-libs/janus"
license=('Apache-2.0')
depends=('python')
makedepends=('git' 'python-build' 'python-installer' 'python-uv-build')
checkdepends=('python-pytest-asyncio' 'python-pytest-benchmark')
source=("git+https://github.com/aio-libs/janus.git#tag=v$pkgver")
sha512sums=('d9e021a05dbbc335e59057bff24e23fcf376cf6b03049931da508ef842de9da63f69f36cae537e291af5cdb08e52ba4dc66fa93b2bc8a064697f435b748d707c')

prepare() {
  cd janus
  # Disable coverage reporting for package tests.
  sed -i '/--cov-branch --cov-report/d' pyproject.toml
}

build() {
  cd janus
  python -m build --wheel --no-isolation
}

check() {
  cd janus
  # Janus reads its version from installed distribution metadata.
  python -m venv --system-site-packages --without-pip "$srcdir/test-env"
  "$srcdir/test-env/bin/python" -m installer dist/*.whl
  "$srcdir/test-env/bin/python" -m pytest
}

package() {
  cd janus
  python -m installer --destdir="$pkgdir" dist/*.whl
}
