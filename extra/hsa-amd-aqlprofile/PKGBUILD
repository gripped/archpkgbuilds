# Maintainer: Christian Heusel <gromit@archlinux.org>

pkgname=hsa-amd-aqlprofile
pkgver=10.1
pkgrel=1
pkgdesc='Architected Queuing Language Profiling Library'
arch=('x86_64')
url='https://github.com/ROCm/rocm-systems'
license=('MIT')
depends=(
    'glibc'
    'hsa-rocr'
    'libgcc'
    'libstdc++'
    'rocm-core'
)
makedepends=('cmake')
source=("rocm-${pkgver}.tar.gz::$url/archive/therock-$pkgver.tar.gz")
sha256sums=('31dc4296cb15c3eada729743731d236ee4a52e4a2a301b9da9075b94c012be19')
replaces=(hsa-amd-aqlprofile-bin)
_dirname="$(basename "$url")-therock-$pkgver"/projects/aqlprofile/

build() {
  local cmake_args=(
    -Wno-dev
    -S "$_dirname"
    -B build
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$_dirname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
