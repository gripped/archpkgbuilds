# Maintainer: Jonathan Grotelüschen <tippfehlr@archlinux.org>
# Contributor: Dominic Meiser [git at msrd0 dot de]

pkgname=cargo-clean-all
pkgver=0.6.6
pkgrel=1
pkgdesc="Recursively clean cargo target folders"
arch=('x86_64')
url="https://github.com/dnlmlr/cargo-clean-all"
license=('MIT')
depends=('libgcc' 'glibc')
makedepends=('cargo' 'git')
source=("git+$url#tag=v$pkgver")
sha512sums=('b5ee14ffb2bea6c7fa50e2ef423e84e389b20b477665caaaf4c2084d36a703bbe1f4d4ca7552070e9ae82a8c76af72c4b2a7a580d7d047fc22440432cf0e4a95')

prepare() {
	cd $pkgname
	cargo fetch --locked --target host-tuple
}

build() {
	cd $pkgname
	cargo build --frozen --release
}

package() {
	cd $pkgname
	install -Dm755 target/release/cargo-clean-all -t "$pkgdir/usr/bin/"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
