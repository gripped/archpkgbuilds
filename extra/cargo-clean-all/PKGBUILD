# Maintainer: Jonathan Grotelüschen <tippfehlr@archlinux.org>
# Contributor: Dominic Meiser [git at msrd0 dot de]

pkgname=cargo-clean-all
pkgver=0.6.4
pkgrel=3
pkgdesc="Recursively clean cargo target folders"
arch=('x86_64')
url="https://github.com/dnlmlr/cargo-clean-all"
license=('MIT')
depends=('libgcc' 'glibc')
makedepends=('cargo' 'git')
source=("git+$url#tag=v$pkgver")
sha512sums=('81eba690dc1d423f2dc025b96cde26a03a29df4d1d825f00abf8894fdba0b9c2eb353697c1be9b8459de7b0570d8761bafce5aa5a2e53c130cd0a7359779bd16')

prepare() {
	cd $pkgname
	cargo fetch --locked --target host-tuple
}

build() {
	cd $pkgname
	cargo build --frozen --release
}

package() {
	cd $pkgname
	install -Dm755 target/release/cargo-clean-all -t "$pkgdir/usr/bin/"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
