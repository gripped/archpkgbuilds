prepare() {
  cd $pkgname

  # Apply fixes from upstream
  git cherry-pick -m 1 -n v0.2.4..504f84b35da93cd281512d11da2b7b25401fbde3

  # Port to Qt6
  # https://gitlab.com/compiz/fusion-icon/-/merge_requests/9
  git apply -3 ../fusion-icon-qt6.patch

  # Add support for more window managers
  # https://gitlab.com/compiz/fusion-icon/-/merge_requests/10
  git apply -3 ../fusion-icon-wm-support.patch

  # Don't attempt to run in Wayland session
  # https://gitlab.com/compiz/fusion-icon/-/merge_requests/11
  git apply -3 ../fusion-icon-no-wayland.patch

  # Fix missing type conversation
  # https://gitlab.com/compiz/fusion-icon/-/merge_requests/12
  git apply -3 ../fusion-icon-fix-value-type.patch

  # Specify OnlyShowIn in desktop file
  # https://gitlab.com/compiz/fusion-icon/-/merge_requests/13
  git apply -3 ../fusion-icon-onlyshowin.patch

  # Don't kill old decorator on replace
  # https://gitlab.com/compiz/fusion-icon/-/merge_requests/14
  git apply -3 ../fusion-icon-decorator-replace.patch

  # Fix build with PEP 517
  sed -i "s/if sys\.argv\[1\] == 'build':/if True:/" setup.py
}

build() {
  cd $pkgname
  python -m build --wheel --no-isolation
}

package() {
  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
}
