# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=boxbuddy
pkgver=2.6.0
pkgrel=1
pkgdesc='Graphical user interface for Distrobox'
arch=(x86_64)
url='https://github.com/Dvlv/BoxBuddyRS'
license=(MIT)
depends=(
  dconf
  distrobox
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  libadwaita
  libgcc
)
makedepends=(
  git
  rust
)
source=("git+https://github.com/Dvlv/BoxBuddyRS.git#tag=$pkgver")
b2sums=(4d69d49d5246fbbcf702ac9e39bc6a629e62c6523934073533560c91bed52a9e21308bd8d9ae8df8fb94530cf326f9af781ae6b69cedecfb5ab0414c0d73d65d)


prepare() {
  cd BoxBuddyRS

  CARGO_HOME="$srcdir/cargo-home" \
    cargo fetch --locked --target "$(rustc --print host-tuple)"

  # Skip warning about Flatpak permissions
  # https://github.com/Dvlv/BoxBuddyRS/pull/247
  sed -i '/new_box_titlebar.pack_end(&info_btn);/d' src/main.rs

  # Fix Dutch translation
  # https://github.com/Dvlv/BoxBuddyRS/pull/248
  sed -i 's/ eigenaars.\\n/ eigenaars./' po/nl_NL/LC_MESSAGES/nl_NL.po

  # Set paths
  sed -i 's|"./po"|"/usr/share/locale"|
          s|"{data_home}/icons/boxbuddy/{icon}"|"/usr/share/boxbuddy/icons/{icon}"|' src/utils.rs
}

build() {
  cd BoxBuddyRS

  CARGO_HOME="$srcdir/cargo-home" \
    CARGO_PROFILE_RELEASE_LTO=true \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
    CARGO_PROFILE_RELEASE_DEBUG=2 \
    CARGO_PROFILE_RELEASE_STRIP=false \
    cargo build --frozen --release --all-features

  for i in po/*/; do
    msgfmt "$i"/LC_MESSAGES/*.po -o "$i/LC_MESSAGES/boxbuddyrs.mo"
  done
}

package() {
  cd BoxBuddyRS
  install -Dm755 -t "$pkgdir/usr/bin/" target/release/boxbuddy-rs
  install -Dm644 -t "$pkgdir/usr/share/boxbuddy/icons/" icons/build-alt-symbolic{,-light}.svg
  install -Dm644 -t "$pkgdir/usr/share/applications/" io.github.dvlv.boxbuddyrs.desktop
  install -Dm644 -t "$pkgdir/usr/share/metainfo/" io.github.dvlv.boxbuddyrs.metainfo.xml
  install -Dm644 -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/" icons/io.github.dvlv.boxbuddyrs.svg
  install -Dm644 -t "$pkgdir/usr/share/glib-2.0/schemas/" io.github.dvlv.boxbuddyrs.gschema.xml
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE

  for i in po/*/; do
    install -Dm644 -t "$pkgdir/usr/share/locale/${i#po/}/LC_MESSAGES/" "$i/LC_MESSAGES/boxbuddyrs.mo"
  done
}
