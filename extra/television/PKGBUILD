# Maintainer: Orhun Parmaksız <orhun@archlinux.org>

pkgname=television
_pkgname=tv
pkgver=0.15.7
pkgrel=1
pkgdesc="A general purpose fuzzy finder for your terminal"
arch=('x86_64')
url="https://github.com/alexpasmantier/television"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo' 'git' 'zig')
checkdepends=('fd' 'bat')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz")
sha512sums=('a89f676ff6b9f6cb13b3d55c90570f08c0a1685dc206ddfa7319ce536a3c3429f6946e6a2cfb68d2ccab68782e83b712634af6d616b4ed4d007cc91bfdee91b8')
options=('!lto')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --frozen
}

#https://github.com/alexpasmantier/television/issues/1047
#check() {
#  cd "$pkgname-$pkgver"
#  # https://github.com/alexpasmantier/television/issues/753
#  cargo test --frozen -- --skip "cli::monitoring::test_watch_reloads_source_command"
#}

package() {
  cd "$pkgname-$pkgver"
  install -Dm 755 "target/release/$_pkgname" -t "$pkgdir/usr/bin"
  install -Dm 644 "man/$_pkgname.1" -t "$pkgdir/usr/share/man/man1/"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}

