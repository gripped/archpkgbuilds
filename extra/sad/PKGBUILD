pkgname=sad
pkgver=0.4.33
pkgrel=1
pkgdesc='Space Age seD'
arch=(x86_64)
url='https://github.com/ms-jpq/sad'
license=(MIT)
depends=(
  glibc
  libgcc
)
makedepends=(
  cargo
  git
  python
)
optdepends=(
  'fzf: for tui usage'
  'diff-so-fancy: for diff colourizer'
  'git-delta: for diff colourizer'
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('8bb2c234277b84ba0b6b72c986d53c0f2449608f849d477cd23ea8db69503bca55761f033762583f4d3abef31b4ee25a4b349ccb26e548cf62d7ef666977512a')
b2sums=('68fb091f4675d02caf81a61b9e043cf60e6486738cdec6c405dde498888e7bdb4d0580fa9fbb1240d715e64d257c8b018d4305aae4e3300c93862f536404fd6f')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname"

  cargo build --frozen --release --all-features
}

check() {
  cd "$pkgname"

  cargo test --frozen --all-features
}

package() {
  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" target/release/sad

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
}

