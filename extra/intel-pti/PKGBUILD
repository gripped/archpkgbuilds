# Maintainer: Torsten Keßler <tpkessler@archlinux.org>

pkgbase=intel-pti
# TODO Package samples
pkgname=(
	intel-pti
	intel-pti-tools
	# intel-pti-samples
)
pkgver=1.2.0
pkgrel=2
_pkgdesc="Profiling Tools Interfaces for Intel GPUs"
arch=('x86_64')
url="https://intel.github.io/pti-gpu/"
license=('MIT')
depends=(
	glibc
	libgcc
	libstdc++
	spdlog
	fmt
	level-zero-loader
	intel-oneapi-compiler-shared-runtime-libs
)
makedepends=(
	cmake
	ninja
	git
	procps-ng
	libdrm
	python
	openmpi
	onedpl
	oneccl
	opencl-headers
	intel-oneapi-dpcpp-cpp
	intel-oneapi-mkl
	intel-oneapi-mkl-sycl
	intel-oneapi-dev-utilities
	intel-graphics-compiler
	intel-compute-runtime
	level-zero-headers
	intel-metrics-discovery
	intel-metrics-library
	gtpin
)
# The build fetches ittapi, Level Zero and compute-runtime headers, protobuf and
# the Perfetto proto at the versions upstream pins
source=("git+https://github.com/intel/pti-gpu#tag=pti-${pkgver}")
sha256sums=('aee18bd9fd7f668496d231acf8ccb1f4622bec367df1130ca6a06ffa226c75f4')
options=(!lto)

build() {
	source /opt/intel/oneapi/setvars.sh
	# -fcf-protection not valid with device code
	CFLAGS+=" -fcf-protection=none"
	CXXFLAGS+=" -fcf-protection=none"
	# Order in MKL linking matters
	export LDFLAGS="${LDFLAGS/-Wl,--as-needed/}"
	local cmake_args=(
		-Wno-dev
		-G Ninja
		# unitrace --version reports git rev-parse HEAD of the build directory
		-B pti-gpu/build
		-S pti-gpu
		-D CMAKE_INSTALL_PREFIX=/usr
		-D CMAKE_INSTALL_SYSCONFDIR=/etc
		-D CMAKE_BUILD_TYPE=None
		-D CMAKE_TOOLCHAIN_FILE="$srcdir"/pti-gpu/sdk/cmake/toolchains/icpx_toolchain.cmake
		-D BUILD_TESTING=OFF
	)
	cmake "${cmake_args[@]}"
	cmake --build pti-gpu/build
}

package_intel-pti() {
	pkgdesc="$_pkgdesc (SDK)"
	depends+=(
		level-zero-loader
		intel-oneapi-dpcpp-cpp
	)
	local component
	for component in Pti_Runtime Pti_Development Pti_Doc; do
		DESTDIR="${pkgdir}" cmake --install pti-gpu/build --component ${component}
	done
	install -Dm644 pti-gpu/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}

package_intel-pti-tools() {
	pkgdesc="$_pkgdesc (unitrace)"
	# Static ittnotify
	license+=('BSD-3-Clause')
	depends+=(
		python
		openmpi
		opencl-icd-loader
		intel-oneapi-compiler-shared-runtime
		intel-oneapi-openmp
	)
	optdepends=(
		'python-pandas: trace analysis scripts'
		'python-matplotlib: trace analysis scripts'
	)
	local component
	for component in Unitrace_Runtime Unitrace_Scripts Unitrace_Config; do
		DESTDIR="${pkgdir}" cmake --install pti-gpu/build --component ${component}
	done
	install -Dm644 pti-gpu/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}/
	install -Dm644 pti-gpu/build/ittapi/LICENSES/BSD-3-Clause.txt -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}
