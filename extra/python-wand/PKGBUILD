# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-wand
pkgver=0.7.3
pkgrel=1
pkgdesc="Ctypes-based simple MagickWand API binding for Python"
url="https://github.com/emcconville/wand"
license=('MIT')
arch=('any')
depends=('imagemagick' 'python')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('libjpeg-turbo' 'python-pytest')
source=("git+https://github.com/emcconville/wand.git#tag=$pkgver")
sha512sums=('e45aed1d4efab56254e4bef11295dcb8a86c98e764e8e702964f86ae722a13fde2b0f763d75485b8ce13637202edfd03e013a0616f5a675dd5cc1ba3a3cb3206')

build() {
  cd wand
  PYTHONPATH="$PWD" python -m build --wheel --no-isolation
}

check() {
  cd wand
  pytest
}

package() {
  cd wand
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
