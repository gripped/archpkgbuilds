# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-movie
epoch=1
pkgver=6.5.31
pkgrel=1
pkgdesc='Movie player based on mpv'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-movie-reborn"
license=('GPL-3.0-or-later')
depends=('dtk6core' 'dtk6gui' 'dtk6widget' 'qt6-base' 'qt6-svg' 'ffmpeg' 'ffmpegthumbnailer'
         'libxtst' 'libglvnd' 'dconf' 'glib2' 'gstreamer'
         'gst-plugins-base-libs' 'libva' 'libxcb' 'libx11' 'mpv' 'qt6-multimedia'
         'qt6mpris' 'deepin-daemon' 'xorg-xprop' 'libdrm' 'pciutils')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools')
optdepends=('pulseaudio: automatic audio output switching on Wayland')
groups=('deepin-extra')
# The 6.5.31 tag points to the old Qt5 tree; use the actual release commit.
# https://github.com/linuxdeepin/deepin-movie-reborn/pull/798
source=("git+https://github.com/linuxdeepin/deepin-movie-reborn.git#commit=71fb475870ed1254d948151b0d61c9450ddb10a1")
sha512sums=('6e09850f499b8d191835577cbfc64ca4c9e6237d19de166d97eff540ebe95f39d0f4562119e9275e52ba750d2d63e7a918b9ad09bbd98e1530ad1b738b233ea6')

prepare() {
  cd deepin-movie-reborn

  # Preserve distribution flags and keep executable PIE flags out of libdmr.
  # https://github.com/linuxdeepin/deepin-movie-reborn/pull/352
  sed -i \
    -e 's|SET(CMAKE_CXX_FLAGS "$ENV{CXXFLAGS} |SET(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} |g' \
    -e 's|SET(CMAKE_C_FLAGS "$ENV{CFLAGS} |SET(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} |g' \
    -e 's| -fPIE||g' \
    -e 's|SET(CMAKE_EXE_LINKER_FLAGS "-pie")|SET(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -pie")|g' \
    src/CMakeLists.txt
}

build() {
  cd deepin-movie-reborn

  # Match upstream's Arch build workaround for non-conforming C++ conversions.
  # https://github.com/linuxdeepin/deepin-movie-reborn/pull/122
  export CXXFLAGS+=' -fpermissive'
  cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DVERSION=$pkgver .
  ninja
}

package() {
  cd deepin-movie-reborn
  DESTDIR="$pkgdir" ninja install
}
