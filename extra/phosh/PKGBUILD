pkgname=phosh
pkgver=0.59.0
pkgrel=1
pkgdesc='A Wayland shell for GNOME on mobile devices'
arch=(x86_64)
url='https://gitlab.gnome.org/World/Phosh/phosh'
license=(GPL-3.0-or-later)
depends=(
  appstream
  at-spi2-core
  bash
