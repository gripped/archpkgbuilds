# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Gavin Lloyd <gavinhungry@gmail.com>

pkgname=acme.sh
pkgver=3.1.5
pkgrel=1
pkgdesc='An ACME Shell script, an acme client alternative to certbot'
arch=('any')
url='https://github.com/acmesh-official/acme.sh'
license=('GPL-3.0-only')
depends=('bash')
makedepends=('git')
optdepends=('socat: for standalone mode'
            'python: for standalone mode without socat'
            'oath-toolkit: Used to compute the OTP for some DNS providers')
source=("git+$url.git#tag=$pkgver")
sha512sums=('c64e84a9af0b4f30163ddc0695c94afeacb61fdd4b05f381bd74733631ad37b8870b26c9be3bbb27d98c6b9f3bb29f12026a6cd4838d6fc37da431a8b4521a83')

package() {
  cd $pkgname

  install -dm755 "$pkgdir"/usr/share/acme.sh/deploy
  install -dm755 "$pkgdir"/usr/share/acme.sh/dnsapi
  install -dm755 "$pkgdir"/usr/share/acme.sh/notify
  install -dm755 "$pkgdir"/usr/share/bash-completion/completions
  install -dm755 "$pkgdir"/usr/bin

  install -m755 acme.sh "$pkgdir"/usr/share/acme.sh/
  install -m644 acme.sh.completion "$pkgdir"/usr/share/bash-completion/completions/acme.sh
  install -m755 deploy/*.sh "$pkgdir"/usr/share/acme.sh/deploy/
  install -m755 dnsapi/*.sh "$pkgdir"/usr/share/acme.sh/dnsapi/
  install -m755 notify/*.sh "$pkgdir"/usr/share/acme.sh/notify/

  install -Dm755 /dev/stdin "$pkgdir"/usr/bin/acme.sh <<'EOF'
#!/bin/sh
export ACME_PACKAGED=1
exec /usr/share/acme.sh/acme.sh "$@"
EOF
}
