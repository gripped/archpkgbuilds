Date: Sat, 21 Mar 2026 11:26:56 +0000
Subject: [PATCH] Fix running test out of tree

This allows to run `meson test` with out of tree build by specifying the
manifest path.
---
 src/meson.build | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/meson.build b/src/meson.build
index 025b7ad..1f24420 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -63,7 +63,7 @@ cargo_build = custom_target(
 )
 
 cargo_extra_options = [
-  cargo_release_options,
+  cargo_build_options,
   '--all-targets',
   '--all-features',
   '--workspace',
-- 
