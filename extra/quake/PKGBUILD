pkgbase=quake
pkgname=librequake
pkgver=0.09_beta
pkgrel=2
pkgdesc='Open source Quake resource files'
arch=(any)
url='https://github.com/lavenderdotpet/LibreQuake'
license=(BSD-3-Clause)
conflicts=('quake<1.36.0-4')
source=(librequake-${pkgver/_/-}.zip::https://github.com/lavenderdotpet/LibreQuake/releases/download/v${pkgver/_/-}/full.zip)
b2sums=('a463ed00898d58867eb21b82a95091c6d9fa89300bc07716a1c8c5b1cd1e8b726ba18b597acbac5794ebc454f7c2875e276a2ad224a325f325ab198ba80b7940')

package() {
  install -d "$pkgdir/usr/share/librequake"
  cp -r full/id1 "$pkgdir/usr/share/librequake/"
  rm -r "$pkgdir/usr/share/librequake/id1/docs"
  install -Dm644 full/id1/docs/COPYING "$pkgdir/usr/share/licenses/$pkgname/LibreQuake-LICENSE"
  install -Dm644 full/id1/docs/CREDITS "$pkgdir/usr/share/licenses/$pkgname/LibreQuake-CREDITS"
  install -Dm644 full/id1/docs/freedoom-docs/COPYING.adoc "$pkgdir/usr/share/licenses/$pkgname/FreeDoom-LICENSE"
  install -Dm644 full/id1/docs/freedoom-docs/CREDITS "$pkgdir/usr/share/licenses/$pkgname/FreeDoom-CREDITS"
  install -Dm644 full/id1/docs/deathmatch-setup-guide.txt "$pkgdir/usr/share/doc/$pkgname/deathmatch-guide.txt"
}
