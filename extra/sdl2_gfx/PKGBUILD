# Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>
# Contributor: Jameson Pugh <imntreal@gmail.com>

pkgname=sdl2_gfx
pkgver=1.1.0
pkgrel=1
epoch=1
pkgdesc="SDL graphics drawing primitives and other support functions (Version 2)"
url="http://www.ferzkopp.net/wordpress/2016/01/02/sdl_gfx-sdl2_gfx/"
arch=(x86_64)
license=(Zlib)
makedepends=(cmake ninja)
depends=(sdl2 glibc)
source=("$pkgname-$pkgver.tar.gz::https://github.com/ferzkopp/SDL2_gfx/archive/refs/tags/v${pkgver}.tar.gz")
sha512sums=('a7244eb4b4c497df041dfd153af6bbd47704fd7381ce0045b752158f39901c32d9b662a1af4d03d7fc6e443d3781ce1e61af73df449395bb9418159e2ae0c5f1')

build() {
  cmake -S SDL2_gfx-$pkgver \
    -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=None \
    -DSDL2GFX_DEMOS=0 \
    -DSDL2GFX_TESTS=0 \
    -DSDL2GFX_BENCH=0
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  mv "$pkgdir/usr/share/licenses/SDL2_gfx" "$pkgdir/usr/share/licenses/$pkgname"
}
