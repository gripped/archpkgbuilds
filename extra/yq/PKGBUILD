pkgname=yq
pkgver=4.4.0
pkgrel=1
pkgdesc="Command-line YAML, XML, TOML processor - jq wrapper for YAML/XML/TOML documents"
arch=('any')
url="https://github.com/kislyuk/yq"
license=(Apache-2.0)
depends=(jq
         python-argcomplete
         python-tomlkit
         python-xmltodict
         python-yaml)
makedepends=(git
             python-{build,installer,wheel}
             python-hatch-vcs
             python-hatchling)
conflicts=(go-yq)
source=("git+https://github.com/kislyuk/yq.git#tag=v$pkgver")
sha256sums=('7a8836b094bca412801ea2dba607895b96b7941b7aaa3cc976eb4cef7ca3c341')
b2sums=('4f8d13dd56c97ea76523e11d3dfd9cc03715f18aba9a6f4bb77d3da52ae504beec45d0e32773a0bb1d51caa25dbd48d98fac6b2de9307bb6a8999d2ab563166e')

build() {
  cd $pkgname
  python -m build -wn
}

check() {
  cd $pkgname
  python test/test.py
}

package() {
  cd $pkgname
  python -m installer -d "$pkgdir" dist/*.whl
}
