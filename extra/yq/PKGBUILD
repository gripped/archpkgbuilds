pkgname=yq
pkgver=4.4.2
pkgrel=1
pkgdesc="Command-line YAML, XML, TOML processor - jq wrapper for YAML/XML/TOML documents"
arch=('any')
url="https://github.com/kislyuk/yq"
license=(Apache-2.0)
depends=(jq
         python-argcomplete
         python-tomlkit
         python-xmltodict
         python-yaml)
makedepends=(git
             python-{build,installer,wheel}
             python-hatch-vcs
             python-hatchling)
conflicts=(go-yq)
source=("git+https://github.com/kislyuk/yq.git#tag=v$pkgver")
sha256sums=('25fc731fe187505a142637a9191140094a39eca4e93f429340be66ea19f3a009')
b2sums=('9ee2dbcb943e648ae9fadce2e784ff71cca9c535993f7bfa5aa3a169287293109253d54bf5f4f864640d55ee7694bfa2e7e58c6bf6107a882cb013d2af9d537a')

build() {
  cd $pkgname
  python -m build -wn
}

check() {
  cd $pkgname
  python test/test.py
}

package() {
  cd $pkgname
  python -m installer -d "$pkgdir" dist/*.whl
}
