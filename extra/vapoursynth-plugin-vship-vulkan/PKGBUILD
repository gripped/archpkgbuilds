# Contributor: CreamSodass <greatvaluecreamsoda@gmail.com>

pkgname=vapoursynth-plugin-vship-vulkan
pkgrel=1
pkgver=5.1.2
pkgdesc='Vship Vapoursynth Plugin'
arch=(x86_64)
url=https://codeberg.org/Line-fr/Vship
license=(MIT)
depends=(
  glibc
  libgcc
  libstdc++
  vapoursynth
  vulkan-icd-loader
)
makedepends=(
  clang
  git
  vulkan-headers
)
provides=(
  libvship
  vapoursynth-plugin-vship
)
conflicts=(
  libvship
  vapoursynth-plugin-vship
)
source=(git+https://codeberg.org/Line-fr/Vship.git#tag=v${pkgver})
b2sums=('cfe81f10a9bf61e7cad0a9c309bb59968986e0bc09bacc516aaee66dcb59e533245b878106f3f713408e8885ca19c4256cdbc6cf12c6098606fba5902a4a45cb')

build() {
  cd Vship
  make build BACKEND=Vulkan CXX=clang++
}

package(){
  cd Vship
  install -Dm 755 libvship.so -t "${pkgdir}"/$(python -c 'import vapoursynth;print(vapoursynth.get_plugin_dir())')/
  install -Dm 644 LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}

