# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=loadtracker
pkgver=1.99.4
pkgrel=1
pkgdesc='A modernised fork of GoatTracker2'
arch=(x86_64)
url='https://github.com/libsidplayfp/loadtracker'
license=(GPL-2.0-only)
depends=(
  glibc
  libgcc libgcc_s.so
  libstdc++ libstdc++.so
  libexsid libexsid.so
  libresidfp libresidfp.so
  jack libjack.so
  rtmidi librtmidi.so
  sdl3
)
makedepends=(
  git
  cmake
  ninja
)
source=(
  "$pkgname::git+$url#tag=v$pkgver"
  use-system-rtmidi.patch
)
sha512sums=('e152cb09834ab1489a3cf6700db95cbbc0eff3252e8e42313ef31302aa33a063453c8db5b712c1e85f42b298ca551b376f94285d66ee4cdde48f1c5d5f68b873'
            '70cd66430368f355bc74d184e92a06d57a7562acf787325cf44cf56f0b3d26c5a6227115090aeaee8e7e0a8c76d7fa3f53d83afde27e6253fe5163b0f0a7688a')
b2sums=('edfa91462aa35d256debd5d844ba1df4e5780701d003842a6173d69b5af19485785e16b834edf1d7dbcb392133d290abc21e7093b34ba5ef56f188580e65bbf9'
        'e8f268a91a633ee970c2feeaffac5f92663969346b31ea3cfda1fafe223df9ff12f89644bc8f23a98cc836cf775779d6aa492a59de43d3fbddf1ed88294a0211')

prepare() {
  cd "$pkgname"

  # link to system rtmidi
  patch -p1 -i "$srcdir/use-system-rtmidi.patch"
  rm -rf src/rtmidi
}

build() {
  local cmake_options=(
    -B build
    -S "$pkgname"
    -G Ninja
    -W no-author
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
  )
  
  cmake "${cmake_options[@]}"
  
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
