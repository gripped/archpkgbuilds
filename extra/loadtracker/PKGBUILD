# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=loadtracker
pkgver=1.99.7
pkgrel=1
pkgdesc='A modernised fork of GoatTracker2'
arch=(x86_64)
url='https://github.com/libsidplayfp/loadtracker'
license=(GPL-2.0-only)
depends=(
  glibc
  libgcc libgcc_s.so
  libstdc++ libstdc++.so
  libexsid libexsid.so
  libresidfp libresidfp.so
  jack libjack.so
  rtmidi librtmidi.so
  sdl3
)
makedepends=(
  git
  cmake
  ninja
)
source=(
  "$pkgname::git+$url#tag=v$pkgver"
  use-system-rtmidi.patch
)
sha512sums=('828da06e9974dbcc265d161f313bd6a8c6d4f4de6affc6a42884e48120b06004c47fcbc75757b4b1c5fdc86c870b63349c2dcd8d36abb10580fff827755f997c'
            '474408484ae33efbed783e674f963843b0aa97ffbd620eb48acf30c4df1eb8fbc302786f45f5147c15ee38cd1a3194c0ccf4f06ce5b3667275bc661e5e8b361e')
b2sums=('f5df017864891944202fdb558d9dffb7280818b96f9c71a9ff189bd28a6eedf248d41f80a776612e45e4bd7417f30236e221dfc67c60f015c476ff5c8613850f'
        'd0991fa99008b1dc7bfd62d2213115f046d2e4f4012dfed29aa1079391f5e001d28a95c7ee4b51c6801981f6d827a1b6b1d288bf0f4dd831483fd9306fabec02')

prepare() {
  cd "$pkgname"

  # link to system rtmidi
  patch -p1 -i "$srcdir/use-system-rtmidi.patch"
  rm -rf src/rtmidi
}

build() {
  local cmake_options=(
    -B build
    -S "$pkgname"
    -G Ninja
    -W no-author
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
  )
  
  cmake "${cmake_options[@]}"
  
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
