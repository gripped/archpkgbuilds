# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=glacier-calc
pkgver=0.4.1
pkgrel=1
pkgdesc="Nemo calculator"
arch=('x86_64')
url="https://github.com/nemomobile-ux/glacier-calc"
license=('LGPL-2.1-only')
depends=('libglacierapp' 'qt5-quickcontrols-nemo')
makedepends=('git' 'cmake' 'qt6-tools')
source=("git+https://github.com/nemomobile-ux/glacier-calc.git#tag=$pkgver")
sha512sums=('361c57898acb145554ee9664ff31f0bbdf249246ef3a825bd60e77f2e9fb93b7e5ff4f66f74da018488723d97f6f3547059657a38a598aeb7f1e750661bdccfd')

build(){
  cd glacier-calc

  cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_POLICY_VERSION_MINIMUM=3.5 .
  make
}

package() {
  cd glacier-calc
  make DESTDIR="$pkgdir" install
}
