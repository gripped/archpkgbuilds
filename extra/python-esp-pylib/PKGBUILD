# Maintainer: Giovanni Harting <anonfunc@archlinux.org>

_name=esp-pylib
pkgname=python-esp-pylib
pkgver=1.2.1
pkgrel=1
pkgdesc="Logging, utilities and constants shared by Espressif's Python tools"
arch=(any)
url='https://github.com/espressif/esp-pylib'
license=(Apache-2.0)
depends=(
  python
  python-rich
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-click
  python-pyserial
  python-pytest
  python-rich-click
  python-websockets
)
optdepends=(
  'python-click: CLI option types and helpers'
  'python-rich-click: CLI option types and helpers'
  'python-pyserial: serial port discovery and reset'
  'python-websockets: IDE integration'
)
source=("git+$url.git#tag=v$pkgver")
b2sums=('9496fbc40aec81a42631b21943f008e67100da81287f76cc4000b472bf424dc459daa49d9cae8d505063d53e7f27f184c34c0d8eb6f77ac3d2cd87e14c53b71f')

build() {
  cd $_name
  python -m build --wheel --no-isolation
}

check() {
  cd $_name
  # test_highlight_enables_auto_highlighting fails when TERM=dumb
  TERM=xterm-256color python -m pytest
}

package() {
  cd $_name
  python -m installer --destdir="$pkgdir" dist/*.whl
}
