# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=libhomfly
pkgver=1.05
pkgrel=1
pkgdesc='Library to compute the homfly polynomial of a link'
arch=(x86_64)
url='https://github.com/miguelmarco/libhomfly'
license=(LicenseRef-libhomfly)
depends=(gc
         glibc)
makedepends=(git)
source=(git+https://github.com/miguelmarco/libhomfly#tag=$pkgver)
sha256sums=('042cd2c6b2dea7208cc67106973721e322688c89ca4760bbeda89b0d09021ab8')

prepare() {
  cd $pkgname
  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
