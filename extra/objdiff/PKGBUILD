# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=objdiff
pkgver=3.8.0
pkgrel=1
pkgdesc='A local diffing tool for decompilation projects'
arch=(x86_64)
url='https://github.com/encounter/objdiff'
license=('Apache-2.0 OR MIT')
depends=(
  fontconfig
  freetype2
  hicolor-icon-theme
)
makedepends=(
  git
  rust
)
options=(!lto)
source=(
  "$pkgname::git+$url#tag=v$pkgver"
  objdiff.desktop
)
sha512sums=('26d0cb27bd4638068abe671375c54864cb2cc634914d7290fae085f71314d9c826f0d8ca6a48c95d7d7f70c72de713c458d44a19fc918c1d1e4be50a15bc8cfe'
            '481c738997aa5963be4e240dd20a711e84f50ab4b0cc0bfb26c96da981cac0e0918e527301e72831e34593ff67c917c33208fa5574adadea2ed6eaab8fda00d8')
b2sums=('92943f19cc0f1cf87dcf308edbb6b65ad0f315b05f4810915657b15b9277e09de2caf96a9f5367a2150dacacb7be355f4d69d4b690125341ae6e3143ea0310bb'
        'e6317bd0ce38552b47a6d716f4df4f1e1ba3719448f3d9aedcd8aab4b30d86b95fba6cd293cc350ea9f0d2d5c87795a4f334fd5730bd1143b99bd910cdcb4840')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release --all-features
}

package() {
  depends+=(
    glibc
    libgcc libgcc_s.so
  )

  cd "$pkgname"

  # binaries
  install -vDm755 -t "$pkgdir/usr/bin" target/release/objdiff{,-cli}

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
  cp -vr assets "$pkgdir/usr/share/doc/$pkgname"

  # desktop files
  install -vDm644 -t "$pkgdir/usr/share/applications" "$srcdir/$pkgname.desktop"
  install -vDm644 objdiff-gui/assets/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/objdiff.png"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE*
}
