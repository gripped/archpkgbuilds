# Maintainer: Orhun Parmaksız <orhun@archlinux.org>

pkgname=caligula
pkgver=0.4.10
pkgrel=3
pkgdesc="A user-friendly, lightweight TUI for disk imaging"
arch=('x86_64')
url="https://github.com/ifd3f/caligula"
license=('GPL-3.0-only')
depends=('glibc' 'libgcc' 'xz')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha512sums=('8aa77fa2a17e6c83cc116fdc075f5ef63358498d75ae62b14570baaf5b73d6f388d4c14ae76e3d8573306a6f7d473dd20c25ac5721da5ad8d00da5c92fc5d0de')

prepare() {
  cd "$pkgname-$pkgver"
  sed -i '/^xz2 =/s/"static"//' Cargo.toml
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --frozen
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm 755 "target/release/$pkgname" -t "$pkgdir/usr/bin"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
}

# vim: ts=2 sw=2 et:
