Subject: [PATCH] install bundled shared libraries in the system libdir

Keep the build and bindist layouts unchanged, but install ELF shared
libraries into libdir and point the bundled package descriptions there.
Only rewrite pkgroot-relative dynamic library paths, preserving the
system C++ library's compiler-provided search directories.

Use the bindist ghc-pkg for recaching because the installed executable
cannot find the staged shared libraries through the system search path
until the package is installed.

--- a/hadrian/bindist/Makefile
+++ b/hadrian/bindist/Makefile
@@ -39,6 +39,7 @@
 	# to the doc files.
 	cat '$2' | sed 's|haddock-interfaces.*|haddock-interfaces: "$${pkgroot}/$4/html/libraries/$5/$1.haddock"|' \
 	         | sed 's|haddock-html.*|haddock-html: "$${pkgroot}/$4/html/libraries/$5"|' \
+	         | sed 's|^dynamic-library-dirs:.*$${pkgroot}/.*|dynamic-library-dirs: "$(libdir)"|' \
 		 | sed 's|    $${pkgroot}/../../doc/html/.*||' \
 	       > '$2.copy'
 	# The rts package doesn't actually supply haddocks, so we stop advertising them
@@ -172,7 +173,7 @@
 		    $(INSTALL_PROGRAM) $$i "$$dest/`dirname $$i`" ; \
 		    $(STRIP_CMD) "$$dest"/$$i ;; \
 		  *.so) \
-		    $(INSTALL_SHLIB) $$i "$$dest/`dirname $$i`" ;; \
+		    $(INSTALL_SHLIB) $$i "$(DESTDIR)$(libdir)" ;; \
 		  *.dylib) \
 		    $(INSTALL_SHLIB) $$i "$$dest/`dirname $$i`" ;; \
 		  *) \
@@ -233,7 +234,7 @@
 	@echo "Updating the package DB"
 	$(foreach p, $(PKG_CONFS),\
 		$(call patchpackageconf,$(shell echo $(notdir $p) | sed 's/-\([0-9]*[0-9]\.\)*conf//g'),$(shell echo "$p" | sed 's:\0xxx\0:   :g'),$(docdir),$(shell mk/relpath.sh "$(ActualLibsDir)" "$(docdir)"),$(shell echo $(notdir $p) | sed 's/.conf//g')))
-	'$(DESTDIR)$(ActualBinsDir)/$(CrossCompilePrefix)ghc-pkg' --global-package-db "$(DESTDIR)$(ActualLibsDir)/package.conf.d" recache
+	'./bin/$(CrossCompilePrefix)ghc-pkg' --global-package-db "$(DESTDIR)$(ActualLibsDir)/package.conf.d" recache
 
 install_mingw:
 	@echo "Installing MingGW"
