Subject: [PATCH] testsuite: match the pthread callback type

Backport of https://gitlab.haskell.org/ghc/ghc/-/commit/d6d5aafc0d9766f055a708f4d3dab9cba81d995a
Limited to the affected tests in GHC 9.6.7.

diff --git a/testsuite/tests/concurrent/should_run/hs_try_putmvar001_c.c b/testsuite/tests/concurrent/should_run/hs_try_putmvar001_c.c
index 583c23c..e5de8dd 100644
--- a/testsuite/tests/concurrent/should_run/hs_try_putmvar001_c.c
+++ b/testsuite/tests/concurrent/should_run/hs_try_putmvar001_c.c
@@ -10,12 +10,13 @@ struct callback {
     int *presult;
 };
 
-void* callback(struct callback *p)
+void* callback(void *p)
 {
+    struct callback *cb = (struct callback *) p;
     usleep(200);
-    *p->presult = 42;
-    hs_try_putmvar(p->cap,p->mvar);
-    free(p);
+    *cb->presult = 42;
+    hs_try_putmvar(cb->cap, cb->mvar);
+    free(cb);
     hs_thread_done();
     return NULL;
 }
