# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: justforlxz <justforlxz@gmail.com>

pkgname=deepin-tray-loader
pkgver=2.0.35
pkgrel=1
pkgdesc='A set of tray plugins that integrated into task bar and the tool loader which can load the plugins'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-tray-loader"
license=('GPL-3.0-or-later' 'LGPL-3.0-or-later' 'LGPL-2.1-or-later' 'CC0-1.0')
depends=('dconf' 'deepin-api' 'deepin-daemon' 'deepin-qt6platform-plugins' 'dtk6core' 'dtk6gui'
         'dtk6widget' 'glibc' 'kwindowsystem' 'libgcc' 'libstdc++' 'libx11' 'libxcb' 'libxcursor' 'libxtst'
         'qt6-base' 'qt6-svg' 'qt6-wayland' 'wayland' 'xcb-util' 'xcb-util-image' 'xcb-util-wm')
makedepends=('git' 'cmake' 'extra-cmake-modules' 'ninja' 'qt6-tools' 'wayland-protocols')
source=("git+https://github.com/linuxdeepin/dde-tray-loader.git#tag=$pkgver")
sha512sums=('9045fede37e5e5661eab83b2f0e32b18b79c3102b79c04f42c8b251b3f9b309fb5322e5da2d6780114d84a2432386b378c6e735cdb7132f79dd14dbb2b93ef01')

prepare() {
  cd dde-tray-loader
  sed -i 's/COMPONENTS Core Widgets DBus Network LinguistTools REQUIRED/COMPONENTS Core Widgets DBus Network LinguistTools CorePrivate WidgetsPrivate REQUIRED/' plugins/CMakeLists.txt
}

build() {
  cd dde-tray-loader
  cmake -B build -GNinja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DCMAKE_INSTALL_LIBEXECDIR=lib
  cmake --build build
}

package() {
  cd dde-tray-loader/build
  DESTDIR="$pkgdir" ninja install
}
