# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=ttf-mona-sans
pkgver=2.0.24
pkgrel=1
pkgdesc='Mona Sans, a variable font from GitHub'
url='https://github.com/github/mona-sans'
arch=(any)
license=('OFL-1.1')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/github/mona-sans/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('910627cd56a7c7b59f6c9c954bfcc3234866681b1fc115d00f718edd6fd5a8b0')
b2sums=('4ac74660ed3396b28d18678064de81d58da3ccc1fd29fd8c8d6035990c518dfb0869c09a9a575e5b589eafde807327e665a59d649daf9629494f383d84b4868d')

package() {
  cd mona-sans-${pkgver}
  install -Dm0644 -t "${pkgdir}/usr/share/fonts/TTF" fonts/static/ttf/*.ttf
  install -Dm0644 -t "${pkgdir}/usr/share/licenses/${pkgname}" LICENSE
}

