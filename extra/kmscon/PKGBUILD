pkgbase=kmscon
pkgname=(
  kmscon
  kmscon-terminfo
)
pkgver=10.0.2
pkgrel=2
arch=('x86_64')
pkgdesc='Kernel Mode Setting (KMS) and DRM based virtual Console Emulator'
url='https://github.com/kmscon/kmscon'
license=('MIT')
backup=('etc/kmscon/kmscon.conf')
depends=(
  bash
  dbus
  glib2
  glibc
  libdrm
  libtsm
  libxkbcommon
  systemd-libs
  zlib
)
makedepends=(
  check
  docbook-xsl
  freetype2
  git
  libxslt
  linux-api-headers
  libglvnd
  meson
  pango
)
optdepends=(
  'fontconfig: for freetype font rendering'
  'inotify-tools: for kmscon-launch-gui waiting mechanism'
  'libglvnd: for accelerated video output'
  'libx11: for XKB compose support'
  'pango: for pango font rendering'
)
source=(
  git+${url}.git#tag=v${pkgver}
  kmscon-10.0.2-crash-on-exit.patch
)
b2sums=('8faffc4945cd9e847a5d0f209a20b09243b6b54ab9aee8d9cba2c825880d0935db72a0bc815fc65e76fe5cd909a291d3fc73505088cabea212f8a9eb451604c7'
        '7051ba0ceb6d3da711cda28274e2445f8ea83d393374abde5acf1801bf72f2d82de2d11e969e38463bf9b287bda84b41b8d45257ca5f8e7fcc92ed2cbd0f74d1')

prepare() {
  cd "$pkgname"
  patch -Np1 -i ../kmscon-10.0.2-crash-on-exit.patch
  #  git pull origin pull/366/head         
}

build() {
  arch-meson "$pkgname" build
  meson compile -C build
}

package_kmscon() {
  depends+=(kmscon-terminfo)
  meson install -C build --destdir="$pkgdir"
  install -Dm644 $pkgname/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  rm -r "$pkgdir"/usr/share/terminfo
}

package_kmscon-terminfo() {
  pkgdesc='Terminfo for kmscon'
  depends=()
  optdepends=()
  mkdir -p "$pkgdir/usr/share/terminfo/k"
  tic -x kmscon/scripts/terminfo/kmscon.ti -o "$pkgdir/usr/share/terminfo/"
  install -Dm644 $pkgbase/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
