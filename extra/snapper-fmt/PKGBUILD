# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>

_name=snapper
pkgname=snapper-fmt
pkgver=0.11.2
pkgrel=1
pkgdesc="Semantic line break formatter for Org, LaTeX, Markdown, and plaintext"
arch=(x86_64)
url="https://github.com/TurtleTech-ehf/snapper"
license=(MIT)
depends=(
  glibc
  libgcc
)
makedepends=(
  cargo
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz)
b2sums=('20fa1b7f78c639c2564df59f9ca5627b0a867efd151c6c00860b9954e1e56d80530f3f6fdfe380211ad1044eec349f358a4ada011e80fd929ce036e6ff13374a')

prepare() {
  cd $_name-$pkgver
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  # fix building with LTO
  CFLAGS+=' -ffat-lto-objects'

  cd $_name-$pkgver
  cargo build --frozen --release
}

check() {
  cd $_name-$pkgver
  cargo test --frozen --release
}

package() {
  cd $_name-$pkgver
  install -vDm 755 target/release/snapper-fmt -t "$pkgdir"/usr/bin/
  install -vDm 755 target/release/snapper-gen-docs -t "$pkgdir"/usr/bin/
  install -vDm 644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
