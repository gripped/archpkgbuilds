# Maintainer: Maxime Gauduin <alucryd@archlinux.org>
# Contributor: Yakov Till <yakov.till@gmail.com>

pkgname=graft
pkgver=0.16.0
pkgrel=1
pkgdesc='Turbocharge Claude Code, Cursor, Codex, Gemini & every coding agent: faster, cheaper, with contextual understanding specific to your codebase'
arch=(x86_64)
url=https://github.com/NanoNets/Graft
license=(MIT)
depends=(
  bash
  glibc
  libgcc
  libstdc++
  nodejs
)
makedepends=(
  gcc
  git
  node-gyp
  npm
  python
)
options=(!debug)
source=(git+https://github.com/trailhq/Graft.git#tag=v${pkgver})
b2sums=('00b386f2421c06008dd96b16705d62f3543a905288dfb27508ff0301b8eab9223d315959795e01843ed01da6e07f8cd51bbfd1a744762c2a922be1686f781fd3')

prepare() {
  cd Graft

  npm ci \
    --cache "${srcdir}/npm-cache" \
    --ignore-scripts
}

build() {
  cd Graft

  export CXXFLAGS+=' -std=c++20'

  npm run build
  npm pack \
    --ignore-scripts \
    --pack-destination "${srcdir}"

  npm install \
    --global \
    --install-strategy=hoisted \
    --ignore-scripts \
    --prefix "${srcdir}/staging/usr" \
    --cache "${srcdir}/npm-cache" \
    "${srcdir}/nanonets-graft-${pkgver}.tgz"

  find "${srcdir}/staging" \
    -type d \
    -name prebuilds \
    -prune \
    -exec rm -rf {} +

  local -a gypfiles
  mapfile -t gypfiles < <(
    find "${srcdir}/staging" \
      \( -type d \( -name build -o -name deps \) -prune \) -o \
      -name binding.gyp -print
  )

  local gypfile
  for gypfile in "${gypfiles[@]}"; do
    pushd "${gypfile%/binding.gyp}"
    node-gyp rebuild --nodedir=/usr
    # Keep the addon, drop the intermediates.
    find build -mindepth 1 -maxdepth 1 ! -name Release -exec rm -rf {} +
    find build/Release -mindepth 1 -maxdepth 1 ! -name '*.node' -exec rm -rf {} +
    popd
  done
}

package() {
  cp -dr --no-preserve=ownership "${srcdir}/staging/usr" "${pkgdir}/"
  install -Dm 644 Graft/LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
