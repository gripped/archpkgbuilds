pkgname=deepin-wayland-protocols
pkgver=1.10.0.33
pkgrel=1
pkgdesc='deepin Specific Protocols for Wayland'
url="https://github.com/linuxdeepin/deepin-wayland-protocols"
arch=(any)
license=(LGPL-2.1-or-later BSD-3-Clause MIT-CMU MIT Apache-2.0)
makedepends=(git extra-cmake-modules ninja qt5-base)
source=("git+https://github.com/linuxdeepin/deepin-wayland-protocols.git#tag=$pkgver")
sha256sums=('eab6c3805ff5572374352d15c9eaa14120dce46b779860801e8b5ed4e973437f')

build() {
  cmake -GNinja -B build -S $pkgname
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
