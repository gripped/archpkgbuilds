# Maintainer: Filipe Laíns (FFY00) <lains@archlinux.org>

pkgname=soapybladerf
pkgver=0.4.4
_pkgname=SoapyBladeRF
_gitver=soapy-bladerf-$pkgver
pkgrel=1
pkgdesc='Soapy SDR plugin for the BladeRF'
arch=('x86_64')
url='https://github.com/pothosware/SoapyBladeRF'
license=('LGPL-2.1-or-later')
depends=('glibc' 'libstdc++' 'libgcc' 'soapysdr' 'bladerf')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_gitver.tar.gz")
sha512sums=('ec3d3bc72700827d153b6eaaf13aad21173dfc4fe2fca89684e6f1aeea15e93e82b4869184227f15e53973456a71487583de9b38dcb81baa812ddbeb264db2ae')

build() {
  mkdir -p $_pkgname-$_gitver/build
  cd $_pkgname-$_gitver/build

  cmake .. \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release

  make
}

package() {
  cd $_pkgname-$_gitver/build

  make DESTDIR="$pkgdir" install
}

