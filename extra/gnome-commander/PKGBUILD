pkgname=gnome-commander
pkgver=2.0.0
pkgrel=1
pkgdesc='Graphical two-pane filemanager for GNOME'
arch=(x86_64)
url='https://gnome.pages.gitlab.gnome.org/gnome-commander/'
license=(GPL-3.0-or-later)
depends=(
  cairo
  dconf
  exiv2
  gdk-pixbuf2
  glib2
  glibc
  graphene
  gtk4
  hicolor-icon-theme
  libgcc
  libgsf
  libstdc++
  pango
  poppler-glib
  taglib
  vte4
)
makedepends=(
  appstream
  gi-docgen
  git
  glib2-devel
  gobject-introspection
  gtest
  itstool
  meson
  rust
  smbclient
)
source=(
  "git+https://gitlab.gnome.org/GNOME/gnome-commander.git?signed#tag=$pkgver"
  gnome-commander-fix-build.patch
)
b2sums=(
  0176ddeee208c3335c55235ba525a1585c005ff6e4c704e34879c897fd7c84820f68370fbc7bceaa67a8a7606ca8b27992b850884fc502d7b53ebc78fae1ab3d
  e652b5be89dd32d8b3dc83ccbf765a982f04df34b65d1bb7972bd89b4bb4b8bde446126e87aa8c09e5cc125a8819766fd4e862da64c34c4fb07a555b1a8d5939
)
validpgpkeys=(7627E6FCECF4FC066A03B673F50A89A3ADE4C6E8) # Uwe Scholz <u.scholz83@gmx.de>

prepare() {
  cd $pkgname

  # Fix build
  # https://gitlab.gnome.org/GNOME/gnome-commander/-/merge_requests/516
  git apply -3 ../gnome-commander-fix-build.patch

  CARGO_HOME="$srcdir/build/cargo-home" \
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir" --no-rebuild
}
