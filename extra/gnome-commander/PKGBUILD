pkgname=gnome-commander
pkgver=2.2.4
pkgrel=1
pkgdesc='Graphical two-pane filemanager for GNOME'
arch=(x86_64)
url='https://gnome.pages.gitlab.gnome.org/gnome-commander/'
license=(GPL-3.0-or-later)
depends=(
  cairo
  dconf
  gdk-pixbuf2
  glib2
  glibc
  graphene
  gtk4
  hicolor-icon-theme
  libgcc
  pango
  vte4
)
makedepends=(
  appstream
  gi-docgen
  git
  glib2-devel
  gobject-introspection
  gtest
  itstool
  meson
  rust
  smbclient
)
optdepends=(
  'python-exifread: Image Metadata plugin'
  'python-mutagen: Multimedia Metadata plugin'
  'python-pypdf: Document Metadata plugin'
)
source=("git+https://gitlab.gnome.org/GNOME/gnome-commander.git#tag=$pkgver")
b2sums=(3f384c16fafd284777a3adf617992655a210d7a2371b1c0ba53d14a2bab1b82e2b4bda1b1cc11337cc092d9f06fade4065d97d44652630329aa58351d30f11f8)
validpgpkeys=(7627E6FCECF4FC066A03B673F50A89A3ADE4C6E8) # Uwe Scholz <u.scholz83@gmx.de>

prepare() {
  cd $pkgname

  CARGO_HOME="$srcdir/build/cargo-home" \
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  arch-meson $pkgname build

  CARGO_PROFILE_RELEASE_LTO=true \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
    CARGO_PROFILE_RELEASE_DEBUG=2 \
    CARGO_PROFILE_RELEASE_STRIP=false \
    meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir" --no-rebuild
}
