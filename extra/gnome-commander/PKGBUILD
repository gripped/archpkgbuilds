pkgname=gnome-commander
pkgver=2.0.1
pkgrel=1
pkgdesc='Graphical two-pane filemanager for GNOME'
arch=(x86_64)
url='https://gnome.pages.gitlab.gnome.org/gnome-commander/'
license=(GPL-3.0-or-later)
depends=(
  cairo
  dconf
  exiv2
  gdk-pixbuf2
  glib2
  glibc
  graphene
  gtk4
  hicolor-icon-theme
  libgcc
  libgsf
  libstdc++
  pango
  poppler-glib
  taglib
  vte4
)
makedepends=(
  appstream
  gi-docgen
  git
  glib2-devel
  gobject-introspection
  gtest
  itstool
  meson
  rust
  smbclient
)
source=("git+https://gitlab.gnome.org/GNOME/gnome-commander.git#tag=$pkgver")
b2sums=(dfcd75ae1ea3c7d82b45f677b65595e716ba264a994e221622fdfc32920cb1b447e2e28fc676294e22b359b8e9de0641eb86e5a10ae58e9510dfd519131707b7)
validpgpkeys=(7627E6FCECF4FC066A03B673F50A89A3ADE4C6E8) # Uwe Scholz <u.scholz83@gmx.de>

prepare() {
  cd $pkgname

  # Fix build
  # https://gitlab.gnome.org/GNOME/gnome-commander/-/merge_requests/516
  git cherry-pick -n 9fdb7b17ce0bc74bc85bdf813713520fc4ee2075

  CARGO_HOME="$srcdir/build/cargo-home" \
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  arch-meson $pkgname build

  CARGO_PROFILE_RELEASE_LTO=true \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
    CARGO_PROFILE_RELEASE_DEBUG=2 \
    CARGO_PROFILE_RELEASE_STRIP=false \
    meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir" --no-rebuild
}
