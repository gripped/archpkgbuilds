pkgname=crash
pkgver=9.0.2
pkgrel=1
pkgdesc='Linux kernel crashdump analysis tool'
url='https://crash-utility.github.io/'
arch=(x86_64)
license=(GPL-3.0-only)
depends=(
  glibc
  gmp
  guile
  libelf
  libgcc
  libstdc++
  lzo
  mpfr
  ncurses
  source-highlight # Provides syntax highlighting in the bundled GDB
  xxhash
  xz
  zstd
)
makedepends=(wget)
optdepends=('binutils: offline vmcore loading functionality')
source=("https://github.com/crash-utility/crash/archive/$pkgver/$pkgname-$pkgver.tar.gz")
b2sums=('c29a4f2f57f9a48cc11d17fea7815c58a87242734dee6d2a992c3e47def7c2c007123d714d9f0d4731f33e14abd7d53c468d714083b55f038732c2b6144c76e0')

build() {
  cd $pkgname-$pkgver
  # Add lzo and zstd support to match makedumpfile's capacity
  make LDFLAGS="$LDFLAGS -llzo2 -lzstd" lzo zstd
}

package() {
  cd $pkgname-$pkgver
  install -vDm755 -t "$pkgdir/usr/bin" crash
  install -vDm644 -t "$pkgdir/usr/share/man/man8" crash.8
}
