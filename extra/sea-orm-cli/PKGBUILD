# Maintainer: Levente Polyak <anthraxx[at]archlinux[dot]org>
#
pkgname=sea-orm-cli
pkgver=1.1.20
pkgrel=1
pkgdesc='An async & dynamic ORM for Rust'
url='https://www.sea-ql.org/SeaORM/'
license=(
  Apache-2.0
  MIT
)
arch=(x86_64)
makedepends=(
  cargo
  git
)
depends=(
  glibc
  gcc-libs
  openssl
)
options=(!lto)
source=(
  "git+https://github.com/SeaQL/sea-orm.git#tag=${pkgver}"
  Cargo.lock
)
sha256sums=('2b52922ea7bbef4e56202dbd3a1044deb0f428a937be4e5e7716335aa47410ff'
            '6ff6f96439abc9b9a2155966fe11ba9fa9ec52c8d4f3685bb279edc172abdc7e')

prepare() {
    cd sea-orm/sea-orm-cli
    cp "${srcdir}/Cargo.lock" .
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd sea-orm/sea-orm-cli
    cargo build --frozen --release --all-features
}

check() {
    cd sea-orm/sea-orm-cli
    cargo test --frozen --all-features
}

package() {
    cd sea-orm
    install -Dm 755 "sea-orm-cli/target/release/${pkgname}" -t "${pkgdir}/usr/bin/"
    install -Dm 644 LICENSE* -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
