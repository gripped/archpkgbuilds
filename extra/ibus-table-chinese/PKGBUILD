pkgname=ibus-table-chinese
pkgver=1.8.15
pkgrel=1
pkgdesc="Some table-based input method of tables engines for IBus"
arch=('any')
url="https://github.com/mike-fabian/ibus-table-chinese"
license=('GPL-3.0-only')
depends=('ibus-table')
makedepends=('git' 'cmake')
source=("git+https://github.com/mike-fabian/ibus-table-chinese.git#tag=$pkgver")
sha512sums=('b74c8830a937745224f248efdc02a8b4dc5efac26da73c5cbe4672b338f3cb0a16f10e6d785302e01ff7e3770a033110e31d5d5c5c6bae24054845023449f0da')

build() {
  cd $pkgname
  cmake . -DCMAKE_INSTALL_PREFIX=/usr
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
