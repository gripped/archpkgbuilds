+++ b/iodbc/dlproc.h
@@ -83,7 +83,7 @@
 #if defined(_MAC) || defined (__cplusplus)
 typedef SQLRETURN (* HPROC) (...);
 #else
-typedef SQLRETURN (* HPROC) ();
+typedef SQLRETURN (* HPROC) (...);
 #endif
 
