pkgname=tpm2-openssl
pkgver=1.3.1rc1.r3.gb3da8eb
pkgrel=1
# OpenSSL 4.1 fixes, may switch to tag once usptream 1.3.1 is released
_commit=b3da8eb80a918eb9e5212031c15d12fd6ab5a102
pkgdesc='OpenSSL Provider for Trusted Platform Module 2.0 integration'
arch=(x86_64)
url='https://github.com/tpm2-software/tpm2-openssl'
license=(BSD-3-Clause)
depends=(
  glibc
  openssl
  tpm2-tss
)
makedepends=(
  autoconf-archive
  git
)
checkdepends=(
  dbus
  swtpm
  tpm2-abrmd
  tpm2-tools
)
optdepends=('tpm2-abrmd: user space resource manager')
source=(
  git+$url.git#commit=$_commit
  tpm2-openssl_check.sh
)
sha512sums=('65d78fd0fa1079f3bd70d185f46b952eb3f237426c3f7a49b4d1d80ec1a556a2c72d174dcc1074d73c2c5bef2714167c449e8a2a90e2b31f52cb9e8e4a1ee926'
            '08818eb11a2e4f53a6af3c7e2069b04ff5a4d135414a0f7e0dd316abffd9870432fe7f9cd02a2de2f8c99d89862933c8f4af5c76c68834849defc802511290be')
b2sums=('4ae2f5d89464eca621574d669da619cf8cb7860d1ee2296b566e45bb62a1b3f466e015cb2cdde0a878f1422de293e4b07ca44602ecc8d52b7c841305449fd279'
        '36434518aecc919c5be4eab1566d9360b459e6c378e0fdcf2af4d6ad59c0f1f5269d679857d2862cb30e0fb5efa5a74f8c103cfe38327c2e2251d6ffd73e8193')
validpgpkeys=(
  'BB0C68611BD255F10FD1EE94B7900BECDB740A3B'  # Petr Gotthard <petr.gotthard@centrum.cz>
  'B7201FE8031B07AF11F5423C6329CFCB6BE6FD76'  # Petr Gotthard <petr.gotthard@centrum.cz>
)

prepare() {
  cd "$pkgname"
  ./bootstrap
}

build() {
  cd "$pkgname"
  ./configure --prefix=/usr
  make
}

check() {
  cd "$pkgname"
  dbus-run-session "$srcdir/tpm2-openssl_check.sh"
}

package() {
  depends+=(
    libtss2-esys.so
    libtss2-rc.so
    libtss2-tctildr.so
  )

  cd "$pkgname"
  make DESTDIR="$pkgdir" install
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
