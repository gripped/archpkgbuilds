# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=pantheon-applications-menu
pkgver=8.0.4
pkgrel=2
pkgdesc='The Pantheon Application Menu'
arch=(x86_64)
url=https://github.com/elementary/applications-menu
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  dconf
  gdk-pixbuf2
  glib2
  glibc
  granite7
  gtk4
  json-glib
  libadwaita
  libgee
  libswitchboard-3.so
  wingpanel
)
makedepends=(
  git
  meson
  vala
)
source=(pantheon-applications-menu::git+https://github.com/elementary/applications-menu.git#tag=${pkgver})
b2sums=('efae6864298c67fc2a402e88129b7d0f788ed96cbbdf2719de9508bbc54a387a681b2b5ea8382d6d4e9b198d313ae5a5022fc3b62c4746ea7592d27dadcbee62')

prepare() {
  cd pantheon-applications-menu

  # Update for GTK4 port
  git cherry-pick -n 8.0.4..0bf3bf5f1bd1b017d3a7d78f0ccc79ba4170b045

  # Fix activating search results with enter
  # https://github.com/elementary/applications-menu/pull/721
  git cherry-pick -n 0b152385a65de55b533fc13e406ee6d32910942a
}

build() {
  arch-meson pantheon-applications-menu build \
    -Dwith-zeitgeist=false
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" meson install -C build
}

