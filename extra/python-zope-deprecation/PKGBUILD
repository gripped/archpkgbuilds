# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=python-zope-deprecation
pkgver=6.1
pkgrel=1
pkgdesc="Zope Deprecation Infrastructure"
arch=('any')
url="https://github.com/zopefoundation/zope.deprecation"
license=('ZPL-2.1')
depends=('python')
makedepends=(
  'git'
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
checkdepends=('python-zope-testrunner')
source=("git+$url.git#tag=$pkgver")
sha512sums=('d787fc361ec38680ad0c530a64ad41453e5a5a29b5f2d2b5a9af3075689c68805dc3dc7456d1130c8274415293c7f2b7610b3cc1aa220169abf389faa8407fea')

build() {
  cd zope.deprecation
  python -m build --wheel --no-isolation --skip-dependency-check
}

check() {
  cd zope.deprecation
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m zope.testrunner -vc --test-path src/
}

package() {
  cd zope.deprecation
  python -m installer --destdir="$pkgdir" dist/*.whl
}
