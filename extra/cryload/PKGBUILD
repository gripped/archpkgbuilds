# Maintainer: Thore Bödecker <foxxx0@archlinux.org>

pkgname='cryload'
pkgver=5.0.0
pkgrel=2
pkgdesc='Cross-platform HTTP load testing CLI'
arch=(x86_64)
url='https://github.com/sdogruyol/cryload'
license=(MIT)
depends=(
  'openssl'
  'glibc'
  'gc'
  'pcre2'
  'zlib'
  'libgcc'
)
makedepends=(
  'crystal'
  'shards'
)
checkdepends=(
)
optdepends=(
)
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz"
)
sha256sums=('ca9b3a1f6389728132eec5a0e07cbf4ee0f240dfe512a749f8f9d76658c28b8e')

prepare() {
  cd "${pkgname}-${pkgver}"
}

build() {
  cd "${pkgname}-${pkgver}"
  shards build --production --release
  crystal docs
}

check() {
  cd "${pkgname}-${pkgver}"
  crystal spec
}


package() {
  cd "${pkgname}-${pkgver}"

  install -Dm755 "bin/cryload" "${pkgdir}/usr/bin/cryload"

  install -D -dm755 docs "${pkgdir}/usr/share/doc"
  cp -r docs "${pkgdir}/usr/share/doc/${pkgname}"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
