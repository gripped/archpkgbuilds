# Maintainer: Thore Bödecker <foxxx0@archlinux.org>

pkgname='cryload'
pkgver=6.0.0
pkgrel=1
pkgdesc='Cross-platform HTTP load testing CLI'
arch=(x86_64)
url='https://github.com/sdogruyol/cryload'
license=(MIT)
depends=(
  'openssl'
  'glibc'
  'gc'
  'pcre2'
  'zlib'
  'libgcc'
)
makedepends=(
  'crystal'
  'shards'
)
checkdepends=(
)
optdepends=(
)
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz"
)
sha256sums=('123a6247e8d1e36e0d5e31629e946e502d8cdf5af593321ae4ce988c06604d19')

prepare() {
  cd "${pkgname}-${pkgver}"
}

build() {
  cd "${pkgname}-${pkgver}"
  shards build --production --release
  crystal docs
}

check() {
  cd "${pkgname}-${pkgver}"
  crystal spec
}


package() {
  cd "${pkgname}-${pkgver}"

  install -Dm755 "bin/cryload" "${pkgdir}/usr/bin/cryload"

  install -D -dm755 docs "${pkgdir}/usr/share/doc"
  cp -r docs "${pkgdir}/usr/share/doc/${pkgname}"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
