# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-devicemanager
pkgver=6.0.75
pkgrel=1
pkgdesc='Deepin hardware information and device management tool'
arch=('x86_64')
url='https://github.com/linuxdeepin/deepin-devicemanager'
license=('GPL-3.0-or-later')
depends=('bluez-deprecated-tools' 'bluez-utils' 'cups' 'deepin-qt6integration'
         'deepin-service-manager' 'dmidecode' 'dtk6core' 'dtk6gui' 'dtk6widget'
         'glib2' 'glibc' 'hicolor-icon-theme' 'hwinfo' 'kmod' 'libgcc'
         'libstdc++' 'lshw' 'net-tools' 'pciutils' 'polkit-qt6' 'qt6-base'
         'qt6-svg' 'smartmontools' 'systemd' 'systemd-libs' 'upower' 'usbutils'
         'util-linux' 'xorg-xrandr')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools')
optdepends=('deepin-printer: open printer settings from printer pages'
            'deepin-shortcut-viewer: display keyboard shortcuts'
            'nvidia-utils: show NVIDIA GPU details')
groups=('deepin-extra')
source=("git+https://github.com/linuxdeepin/deepin-devicemanager.git#tag=$pkgver")
sha512sums=('d4ee87cbde562f606b9557b0103858b13ed02d0178512294858400c6334715c814006cb9dec99fadbe5c5e41389ee8cb3268b4d30ffbb123e86fd5fcf0af685e')

build() {
  cmake -GNinja -B build -S deepin-devicemanager \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DVERSION=$pkgver \
    -DDISABLE_DRIVER=ON
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
