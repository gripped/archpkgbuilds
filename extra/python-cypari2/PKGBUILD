# Maintainer: Antonio Rojas <arojas@archlinux.org>

_pyname=cypari2
pkgname=python-$_pyname
pkgver=2.2.4
pkgrel=4
pkgdesc='Cython bindings for PARI'
arch=(x86_64)
url='https://www.sagemath.org'
license=(GPL-2.0-or-later)
depends=(glibc
         pari
         python
         python-cysignals)
makedepends=(cython
             git
             meson-python
             python-build
             python-installer)
checkdepends=(python-pytest)
source=(git+https://github.com/sagemath/cypari2#tag=$pkgver
        pari-2.19.patch)
sha256sums=('1d180573f48f9fe00ead45c6aefff5479f1bb4135af62c84bb29ca189ca0e4b2'
            '3f3a763b0048355b02d1c5dcb5e20e777d2293b08abebdb9c3e60eb269db5362')

prepare() {
  cd $_pyname
  patch -p1 -i ../pari-2.19.patch
}

build() {
  cd $_pyname
  python -m build --wheel --no-isolation
}

check() {
  cd $_pyname
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  cd tests
  ../test-env/bin/python -m pytest -v
}

package() {
  cd $_pyname
  python -m installer --destdir="$pkgdir" dist/*.whl
}
