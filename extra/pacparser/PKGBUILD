pkgname=pacparser
pkgver=1.5.2
pkgrel=1
pkgdesc="Library to parse proxy auto-config (PAC) files"
arch=(x86_64)
url="https://github.com/manugarg/pacparser"
license=('LGPL-3.0-or-later')
makedepends=('git')
source=("git+https://github.com/manugarg/pacparser.git#tag=v$pkgver")
sha512sums=('bc98788d825a83c3107efc8528c16ce0e1d94c7251e35b328b8165d16ca3dd77fbcd6b2b21165044d5606193a3735b7760ed252a6367c85781aace4e0ff190e3')

build() {
  cd $pkgname
  make all -C src
}

package() {
  cd $pkgname
  make -C src DESTDIR="$pkgdir/" install
}

