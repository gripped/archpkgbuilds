pkgname=pacparser
pkgver=1.5.1
pkgrel=1
pkgdesc="Library to parse proxy auto-config (PAC) files"
arch=(x86_64)
url="https://github.com/manugarg/pacparser"
license=('LGPL-3.0-or-later')
makedepends=('git')
source=("git+https://github.com/manugarg/pacparser.git#tag=v$pkgver")
sha512sums=('d4e9f0b17aa4fdeb61f41858282016c34a74b2e3f87f8e84465cc83d93e503c4cdf9e20746e22df525de1c3fa328e42dac83d8afbbfbffe5f1f7799ad8e01ba6')

build() {
  cd $pkgname
  make all -C src
}

package() {
  cd $pkgname
  make -C src DESTDIR="$pkgdir/" install
}

