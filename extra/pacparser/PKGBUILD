pkgname=pacparser
pkgver=1.5.0
pkgrel=1
pkgdesc="Library to parse proxy auto-config (PAC) files"
arch=(x86_64)
url="https://github.com/manugarg/pacparser"
license=('LGPL-3.0-or-later')
makedepends=('git')
source=("git+https://github.com/manugarg/pacparser.git#tag=v$pkgver")
sha512sums=('b333582c531ce6f4b700ce9a7cf0432c3d616d8ec35046889abc5ad4b893ffa5af05c4d7e6a53ff30ff302707306fe1b51ab1f4099a3cfeaa0b1259da63c1f12')

build() {
  cd $pkgname
  make all -C src
}

package() {
  cd $pkgname
  make -C src DESTDIR="$pkgdir/" install
}

