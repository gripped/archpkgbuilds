# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-uuid-utils
pkgver=0.16.0
pkgrel=1
pkgdesc="Fast, drop-in replacement for Python's uuid module, powered by Rust"
arch=('x86_64')
url="https://github.com/aminalaee/uuid-utils"
license=('BSD-3-Clause')
depends=('glibc' 'libgcc' 'python')
makedepends=('cargo' 'git' 'python-build' 'python-installer' 'python-maturin' 'python-wheel')
checkdepends=('python-pytest' 'python-pytest-codspeed')
source=("git+https://github.com/aminalaee/uuid-utils.git#tag=$pkgver")
sha512sums=('760b8e4b3f81b43dbeca432891f6998195b168988e45e9f371686ecfc02b750d938e1865ba290cca8678f623f79396d5f594cb6601ecfb3137fc198816cd533d')

prepare() {
  cd uuid-utils
  cargo fetch --locked
}

build() {
  cd uuid-utils
  CARGO_NET_OFFLINE=true python -m build --wheel --no-isolation
}

check() {
  cd uuid-utils
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  # https://github.com/aminalaee/uuid-utils/issues/99
  test-env/bin/python -m pytest tests --deselect=tests/test_uuid.py::test_getnode
}

package() {
  cd uuid-utils
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.md -t "$pkgdir"/usr/share/licenses/$pkgname/
}
