# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-uuid-utils
pkgver=0.17.1
pkgrel=1
pkgdesc="Fast, drop-in replacement for Python's uuid module, powered by Rust"
arch=('x86_64')
url="https://github.com/aminalaee/uuid-utils"
license=('BSD-3-Clause')
depends=('glibc' 'libgcc' 'python')
makedepends=('cargo' 'git' 'python-build' 'python-installer' 'python-maturin' 'python-wheel')
checkdepends=('python-pytest' 'python-pytest-codspeed')
source=("git+https://github.com/aminalaee/uuid-utils.git#tag=$pkgver")
sha512sums=('cc957ee64c83eeefe3b984fc1f9905093a1d56cbbcf11ca10cafa6f7280cb2e2aca2cc5bd29f1066aef004a82313c069ce46d1305ec4fc9d3932fb88cc3f3f73')

prepare() {
  cd uuid-utils
  cargo fetch --locked
}

build() {
  cd uuid-utils
  CARGO_NET_OFFLINE=true python -m build --wheel --no-isolation
}

check() {
  cd uuid-utils
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd uuid-utils
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.md -t "$pkgdir"/usr/share/licenses/$pkgname/
}
