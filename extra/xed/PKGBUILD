pkgname=xed
pkgver=3.9.2
pkgrel=1
pkgdesc='A small and lightweight text editor'
arch=(x86_64)
url='https://github.com/linuxmint/xed'
license=(GPL-2.0-or-later)
groups=(x-apps)
depends=(
  at-spi2-core
  cairo
  dconf
  gdk-pixbuf2
  glib2
  glibc
  gspell
  gtk3
  gtksourceview4
  libpeas
  libx11
  libxml2
  pango
  python
  python-gobject
  xapp
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  intltool
  itstool
  meson
)
source=("git+https://github.com/linuxmint/xed.git#tag=$pkgver")
b2sums=(8ddce5b501c9034c38005314d19c203001e6654bc8cb60e6c72da5adf067d70f09069f98ccd69d463c3fae938ef1386e177c088219f2a62a8a21f99ace78e83e)

prepare() {
  cd $pkgname
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package(){
  meson install -C build --destdir="$pkgdir"
}
