pkgname=xed
pkgver=3.9.3
pkgrel=1
pkgdesc='A small and lightweight text editor'
arch=(x86_64)
url='https://github.com/linuxmint/xed'
license=(GPL-2.0-or-later)
groups=(x-apps)
depends=(
  at-spi2-core
  cairo
  dconf
  gdk-pixbuf2
  glib2
  glibc
  gspell
  gtk3
  gtksourceview4
  libpeas
  libx11
  libxml2
  pango
  python
  python-gobject
  xapp
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  intltool
  itstool
  meson
)
source=("git+https://github.com/linuxmint/xed.git#tag=$pkgver")
b2sums=('056867f56825ed748b7f1dad1a212d91fa9beda8a94e19483607676bb496dc5a587367a578bb66fdd89750f18c66740d0b5497eed44aea5125411891171dfca4')

prepare() {
  cd $pkgname
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package(){
  meson install -C build --destdir="$pkgdir"
}
