# Maintainer: Peter Jung <ptr1337@archlinux.org>

pkgname=labwc-tweaks
pkgver=0.2.0
pkgrel=1
pkgdesc='GUI settings application for labwc'
url="https://github.com/labwc/labwc-tweaks"
arch=('x86_64')
license=('GPL-2.0-only')
depends=(
  glib2
  glibc
  hicolor-icon-theme
  libgcc
  libstdc++
  libxml2
  qt6-base
)
makedepends=(
  cmake
  git
  qt6-tools
)
optdepends=(
  'labwc: compositor configured by this tool'
  'labwc-themes: additional themes for labwc'
)
source=("git+https://github.com/labwc/labwc-tweaks#tag=${pkgver}")
b2sums=('f480b50f955f1d2d2ff07ebe3b83fffbec92970641c972b4590cb3637edf18529a062b00c156cc874497997e70aa1a8be9363a30f36d6a6f64ce194470b30979')

build() {
  cmake -S "$pkgname" -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
