# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-genai-prices
pkgver=0.1.13
pkgrel=1
pkgdesc='Calculate prices for calling LLM inference APIs'
arch=('any')
url='https://github.com/pydantic/genai-prices'
license=('MIT')
depends=('python' 'python-httpx2' 'python-pydantic')
makedepends=('git' 'python-build' 'python-hatchling' 'python-installer' 'python-uv-dynamic-versioning')
checkdepends=(
  'jq'
  'python-anyio'
  'python-dirty-equals'
  'python-inline-snapshot'
  'python-jsonschema'
  'python-packaging'
  'python-pydantic-settings'
  'python-pytest'
  'python-pytest-recording'
  'python-rich'
  'python-rich-argparse'
  'python-ruamel-yaml'
)
optdepends=(
  'python-pydantic-settings: command-line interface'
  'python-rich: command-line interface'
  'python-rich-argparse: command-line interface'
)
source=("git+https://github.com/pydantic/genai-prices.git#tag=v$pkgver")
sha256sums=('f0f753bc11b13bdf025555f44c1551fdfde5631fed9b010478b8796acb87fc2e')

build() {
  cd genai-prices/packages/python
  python -m build --wheel --no-isolation
}

check() {
  cd genai-prices
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer packages/python/dist/*.whl

  # AWS price-maintenance tests require unpackaged boto3 stubs.
  test-env/bin/python -m pytest -o pythonpath=prices/src --ignore=tests/test_source_aws.py
}

package() {
  cd genai-prices/packages/python
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
