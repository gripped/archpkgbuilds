# Maintainer: George Rawlinson <grawlinson@archlinux.org>
# Contributor: Thayne McCombs <bytecurry.software@gmail.com>

pkgname=roswell
pkgver=26.10.119
pkgrel=1
pkgdesc='Environment for Common Lisp development'
arch=(x86_64)
url='https://roswell.github.io'
license=(MIT)
depends=(glibc bash curl)
makedepends=(git)
source=("$pkgname::git+https://github.com/roswell/roswell#tag=v$pkgver")
sha512sums=('197028a6deb059b9c976748a0ec026097262ad96625044b5fe7dcafc74432e57eb11f0874d10cdf6ca8e7bf9ec24023889d68722e5291c1182cd0f5b689d9327')
b2sums=('6de15bd10fc2f12383cc445ee8021b154d683ef8f3973571364cc1437f020647878caf6a5542b35d3a68381e01283fbb1f751d8e8128784f2f91dcf9b2a67835')

build() {
  cd "$pkgname"

  ./bootstrap

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc

  make
}

package() {
  cd "$pkgname"

  make DESTDIR="$pkgdir" install

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" COPYING
}
