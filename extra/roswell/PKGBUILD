# Contributor: Thayne McCombs <bytecurry.software@gmail.com>

pkgname=roswell
pkgver=26.10.117
pkgrel=1
pkgdesc='Environment for Common Lisp development'
arch=(x86_64)
url='https://roswell.github.io'
license=(MIT)
depends=(glibc bash curl)
makedepends=(git)
source=("$pkgname::git+https://github.com/roswell/roswell#tag=v$pkgver")
sha512sums=('966664d0ef17df98797c3d9cb6048bf640e0dc2535bdccb9280a95328c667c4c7d1dc722fa607103adf9e60689df158202763a618c6f0c78fee47db29c62e779')
b2sums=('77d6fea67a4bfa8e5e4b038659f3738a8f4ae77421ba57f8c07db1a29073bea38df0893158d4dc87adac97d2ea7040814a1954d78158fb0f3809e91df822423e')

build() {
  cd "$pkgname"

  ./bootstrap

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc

  make
}

package() {
  cd "$pkgname"

  make DESTDIR="$pkgdir" install

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" COPYING
}
