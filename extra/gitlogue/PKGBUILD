# Maintainer: Orhun Parmaksız <orhun@archlinux.org>

pkgname=gitlogue
pkgver=0.8.0
pkgrel=2
pkgdesc="A cinematic Git commit replay tool for the terminal"
arch=('x86_64')
url='https://github.com/unhappychoice/gitlogue'
license=('ISC')
depends=('glibc' 'libgcc' 'libgit2' 'openssl' 'zlib')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('443a4b07d191c9a9ebcaf89e360bb2ad382bfdec1c520e2fbfa3492eac8a4e06')
options=('!lto')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  LIBGIT2_NO_VENDOR=1 OPENSSL_NO_VENDOR=1 cargo build --release --frozen
}

check() {
  cd "$pkgname-$pkgver"
  LIBGIT2_NO_VENDOR=1 OPENSSL_NO_VENDOR=1 cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm 755 "target/release/$pkgname" -t "$pkgdir/usr/bin"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}

# vim:set ts=2 sw=2 et:
