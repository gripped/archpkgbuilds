pkgname=jdupes
pkgver=1.31.3
pkgrel=1
pkgdesc='A program for identifying duplicate files residing within specified directories'
arch=('x86_64')
url="https://www.jdupes.com"
license=('MIT')
depends=('glibc' 'libjodycode>=4' 'xxhash')
source=("${pkgname}-${pkgver}.tar.gz::https://codeberg.org/jbruchon/${pkgname}/archive/v${pkgver}.tar.gz")
sha256sums=('3f76188082330cc28d37788377f0ed06b0ba181fcd4d88827a59f26a0c396168')

build() {
    cd "${pkgname}"
    make EXTERNAL_HASH_LIB=1 LDFLAGS_EXTRA=-lxxhash
}

package() {
    cd "${pkgname}"
    make PREFIX="/usr" DESTDIR="${pkgdir}" install
    install -Dm644 LICENSE.txt -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
