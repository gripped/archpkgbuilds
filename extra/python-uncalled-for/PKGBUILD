# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-uncalled-for
pkgver=0.6.2
pkgrel=1
pkgdesc='Async dependency injection for Python functions'
arch=('any')
url='https://github.com/chrisguidry/uncalled-for'
license=('MIT')
depends=('python')
makedepends=(
  'git'
  'python-build'
  'python-hatch-vcs'
  'python-hatchling'
  'python-installer'
)
checkdepends=(
  'python-pytest'
  'python-pytest-asyncio'
  'python-pytest-cov'
  'python-pytest-randomly'
  'python-pytest-timeout'
)
source=("git+https://github.com/chrisguidry/uncalled-for.git#tag=$pkgver")
sha512sums=('aca5f8379ae687ddc3c531212cc2362ef2d82f428639c570589b976b18442a93674dcfbdb040c82f093afbaaf3045e96d606735dfa16044f63d4ea9062e90484')

build() {
  cd uncalled-for
  python -m build --wheel --no-isolation
}

check() {
  cd uncalled-for
  PYTHONPATH=src python -m pytest
}

package() {
  cd uncalled-for
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
