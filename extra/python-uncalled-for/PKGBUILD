# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-uncalled-for
pkgver=0.6.0
pkgrel=1
pkgdesc='Async dependency injection for Python functions'
arch=('any')
url='https://github.com/chrisguidry/uncalled-for'
license=('MIT')
depends=('python')
makedepends=(
  'git'
  'python-build'
  'python-hatch-vcs'
  'python-hatchling'
  'python-installer'
)
checkdepends=(
  'python-pytest'
  'python-pytest-asyncio'
  'python-pytest-cov'
  'python-pytest-randomly'
  'python-pytest-timeout'
)
source=("git+https://github.com/chrisguidry/uncalled-for.git#tag=$pkgver")
sha512sums=('998b844bacbad083618dbfe6cd5639df3d47c5a12879bfc7f7449cc449fbde7e6aac6c817bb6ce6c1e636346fdb827f16d6ae7e84775ca5fc33a251e5bda67cd')

build() {
  cd uncalled-for
  python -m build --wheel --no-isolation
}

check() {
  cd uncalled-for
  PYTHONPATH=src python -m pytest
}

package() {
  cd uncalled-for
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
