# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-uncalled-for
pkgver=0.6.1
pkgrel=1
pkgdesc='Async dependency injection for Python functions'
arch=('any')
url='https://github.com/chrisguidry/uncalled-for'
license=('MIT')
depends=('python')
makedepends=(
  'git'
  'python-build'
  'python-hatch-vcs'
  'python-hatchling'
  'python-installer'
)
checkdepends=(
  'python-pytest'
  'python-pytest-asyncio'
  'python-pytest-cov'
  'python-pytest-randomly'
  'python-pytest-timeout'
)
source=("git+https://github.com/chrisguidry/uncalled-for.git#tag=$pkgver")
sha512sums=('b70900ace0a58754691b5064e1d5d77618ce7bef40b5df49b45ced5548260d60d834d8cca12700dfaba1c6d0213b36075f9b62269fcd69ea09817eae34312ced')

build() {
  cd uncalled-for
  python -m build --wheel --no-isolation
}

check() {
  cd uncalled-for
  PYTHONPATH=src python -m pytest
}

package() {
  cd uncalled-for
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
