# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-uncalled-for
pkgver=0.4.2
pkgrel=1
pkgdesc='Async dependency injection for Python functions'
arch=('any')
url='https://github.com/chrisguidry/uncalled-for'
license=('MIT')
depends=('python')
makedepends=(
  'git'
  'python-build'
  'python-hatch-vcs'
  'python-hatchling'
  'python-installer'
)
checkdepends=(
  'python-pytest'
  'python-pytest-asyncio'
  'python-pytest-cov'
  'python-pytest-randomly'
  'python-pytest-timeout'
)
source=("git+https://github.com/chrisguidry/uncalled-for.git#tag=$pkgver")
sha512sums=('0d9a34454d4f493b50e08286a2baff24ac2b71484c474b19fc2b8395557d116fd4906843cd57123f21ddde084dc61e5957e1d8ac673493a0d21d78d685979afc')

build() {
  cd uncalled-for
  python -m build --wheel --no-isolation
}

check() {
  cd uncalled-for
  PYTHONPATH=src python -m pytest
}

package() {
  cd uncalled-for
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
