# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-draw
pkgver=6.5.42
pkgrel=1
pkgdesc="A lightweight drawing tool for Linux Deepin"
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-draw"
license=('GPL-3.0-or-later')
depends=('dtk6core' 'dtk6gui' 'dtk6widget' 'qt6-base' 'qt6-svg' 'qt6-imageformats' 'glibc' 'libgcc' 'libstdc++' 'deepin-picker'
         'adobe-source-han-sans-otc-fonts' 'hicolor-icon-theme')
makedepends=('git' 'cmake' 'qt6-declarative' 'qt6-tools')
groups=('deepin-extra')
source=("git+https://github.com/linuxdeepin/deepin-draw.git#tag=$pkgver")
sha512sums=('ddd86228898027322f1a186c5478f158b6f966fe867bc5e4494b1d22ca10a4db7860a697864669018c01660dea15759382b90b43955d8229c2b56c3f980ac7be')

build() {
  cd deepin-draw
  cmake -DCMAKE_INSTALL_PREFIX=/usr .
  make
}

package() {
  cd deepin-draw
  make DESTDIR="$pkgdir" install
}
