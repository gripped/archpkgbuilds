pkgname=rocr-debug-agent
pkgver=10.1
pkgrel=1
pkgdesc="ROCr Debug Agent Library"
arch=('x86_64')
url="https://rocm.docs.amd.com/projects/rocr_debug_agent/en/latest/"
license=('NCSA')
depends=('rocm-core' 'hip-runtime-amd' 'rocm-dbgapi' 'hsa-rocr' 'libelf')
makedepends=('cmake')
provides=("rocm-debug-agent=$pkgver")
_git='https://github.com/ROCm/rocm-systems'
source=("$pkgname-$pkgver.tar.gz::$_git/releases/download/therock-$pkgver/$pkgname.tar.gz")
sha256sums=('74c6b5a6c1b982c43fcb2c85b36464222b383ea38da22795a06557ba286c015f')

build() {
  local cmake_args=(
    -Wno-dev
    -B build
    -S "$pkgname"
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$pkgname/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
