pkgname=cinnamon-translations
pkgver=6.8.2
pkgrel=1
pkgdesc='Translations for Cinnamon and Nemo'
arch=(any)
url='https://github.com/linuxmint/cinnamon-translations'
license=(GPL-2.0-or-later)
makedepends=(git)
source=("git+https://github.com/linuxmint/cinnamon-translations.git#tag=$pkgver")
b2sums=('f5141c0a737f48b0ef899a1d4f45d8ac4f49e0a934b1f9ea347b102769b8441ecf08cf990ab94752db0875967cd93abf034cc85037a2818169669f7e907e1083')

build() {
  cd $pkgname
  make
}

package() {
  cd $pkgname
  cp -r usr/ "$pkgdir"
}
