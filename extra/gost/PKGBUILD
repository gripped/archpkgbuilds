# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=gost
pkgver=3.3.2
pkgrel=1
pkgdesc="GO Simple Tunnel"
arch=('x86_64')
url="https://github.com/go-gost/gost"
license=('MIT')
depends=('glibc')
makedepends=('go' 'git')
source=("git+https://github.com/go-gost/gost.git#tag=v$pkgver")
sha512sums=('72b75920fe33efc7e4189449685f052c97dd348ade93b126d2521bb79cfddb0e6244aec600b9525669027e0b68a9378fd8756abdfe6e2d0ad759941911738149')

prepare() {
  cd gost
  export GOPATH="${srcdir}"
  go mod download -modcacherw -x
}

build() {
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"

  cd gost/cmd/gost
  go build -ldflags "-linkmode=external -X main.version=$pkgver"
}

package() {
  cd gost
  install -Dm755 cmd/gost/gost -t "$pkgdir"/usr/bin/
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
