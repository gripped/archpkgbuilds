# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=gost
pkgver=3.3.3
pkgrel=1
pkgdesc="GO Simple Tunnel"
arch=('x86_64')
url="https://github.com/go-gost/gost"
license=('MIT')
depends=('glibc')
makedepends=('go' 'git')
source=("git+https://github.com/go-gost/gost.git#tag=v$pkgver")
sha512sums=('a5101e2a188a85467640dfde30770ff340ebee2267b7536c5f69b89f23c63e915f1cf733da93a06fad6723f1c795997af74408e27415a8622368f56a578f28ec')

prepare() {
  cd gost
  export GOPATH="${srcdir}"
  go mod download -modcacherw -x
}

build() {
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"

  cd gost/cmd/gost
  go build -ldflags "-linkmode=external -X main.version=$pkgver"
}

package() {
  cd gost
  install -Dm755 cmd/gost/gost -t "$pkgdir"/usr/bin/
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
