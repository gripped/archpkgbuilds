# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=gost
pkgver=3.3.0
pkgrel=1
pkgdesc="GO Simple Tunnel"
arch=('x86_64')
url="https://github.com/go-gost/gost"
license=('MIT')
depends=('glibc')
makedepends=('go' 'git')
source=("git+https://github.com/go-gost/gost.git#tag=v$pkgver")
sha512sums=('2da4fc84f9187a1c26b3252ebca1d2cf493b46bfa1010dbe8d13f8ba89b5cebd1cdff0817f6dabcbfe9cdb037f48f4378f6b6fae5c1504ad5024bd294ffee5d1')

prepare() {
  cd gost
  export GOPATH="${srcdir}"
  go mod download -modcacherw -x
}

build() {
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"

  cd gost/cmd/gost
  go build
}

package() {
  cd gost
  install -Dm755 cmd/gost/gost -t "$pkgdir"/usr/bin/
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
