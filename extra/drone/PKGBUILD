pkgbase=drone
pkgname=(
  drone
  drone-oss
)
pkgver=2.28.0
pkgrel=1
pkgdesc='Continuous Delivery platform built on container technology'
arch=(x86_64)
url='https://drone.io'
makedepends=(git go)
options=(!lto)
source=(
  "$pkgbase::git+https://github.com/harness/harness.git#tag=v$pkgver"
  systemd.service
  tmpfiles.conf
  sysusers.conf
)
