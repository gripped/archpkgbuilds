# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-pdfium
pkgver=1.5.6
pkgrel=1
pkgdesc='Development library for pdf on Deepin'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-pdfium"
license=('LGPL-3.0-or-later')
depends=('qt6-base' 'openjpeg2' 'libchardet' 'lcms2' 'libjpeg-turbo' 'libpng' 'icu' 'zlib'
         'glibc' 'libgcc' 'libstdc++' 'freetype2')
makedepends=('git' 'cmake')
source=("git+https://github.com/linuxdeepin/deepin-pdfium.git#tag=$pkgver")
sha512sums=('980cec34458710ae56d3bf1d2cfa0fcec3d6b684a41a8e2130b9f7c5fcb54caa9db3fddf5d2de1763ca068864f89046d8572da45ea409bef87881769f4fd2521')

build() {
  cmake -B build -S deepin-pdfium \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_DISABLE_FIND_PACKAGE_Qt5=ON \
    -DVERSION="$pkgver"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
