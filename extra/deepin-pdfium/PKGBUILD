# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-pdfium
pkgver=1.5.2
pkgrel=1
pkgdesc='Development library for pdf on Deepin'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-pdfium"
license=('LGPL-3.0-or-later')
depends=('qt6-base' 'openjpeg2' 'libchardet' 'lcms2' 'libjpeg-turbo' 'libpng' 'icu' 'zlib'
         'glibc' 'libgcc' 'libstdc++' 'freetype2')
makedepends=('git' 'cmake')
source=("git+https://github.com/linuxdeepin/deepin-pdfium.git#tag=$pkgver")
sha512sums=('cf42260893ab8b3edcf5e5fce72acf1bad6c70a6fabfb053919c0d402f03ef307d5757f7c7eb0d07fa22ff0390cd6655daf48257e39d68eb558d60747b4b592a')

build() {
  export CXXFLAGS+=" -include cstdint"

  cmake -B build -S deepin-pdfium \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_DISABLE_FIND_PACKAGE_Qt5=ON \
    -DVERSION="$pkgver"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
