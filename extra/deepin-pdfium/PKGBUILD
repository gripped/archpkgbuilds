# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-pdfium
pkgver=1.5.5
pkgrel=1
pkgdesc='Development library for pdf on Deepin'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-pdfium"
license=('LGPL-3.0-or-later')
depends=('qt6-base' 'openjpeg2' 'libchardet' 'lcms2' 'libjpeg-turbo' 'libpng' 'icu' 'zlib'
         'glibc' 'libgcc' 'libstdc++' 'freetype2')
makedepends=('git' 'cmake')
source=("git+https://github.com/linuxdeepin/deepin-pdfium.git#tag=$pkgver")
sha512sums=('79b5703329154460cbaab171beeec9151ba5148518862d58d70909acbd6026f6230977b710c4fd9a0abd283b7e71d1c8c18fbc63ad7f7383824c45d5b7cdc868')

build() {
  cmake -B build -S deepin-pdfium \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_DISABLE_FIND_PACKAGE_Qt5=ON \
    -DVERSION="$pkgver"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
