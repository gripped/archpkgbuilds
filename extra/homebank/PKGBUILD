pkgname=homebank
pkgver=5.10.2
pkgrel=1
pkgdesc="Free, easy, personal accounting for everyone"
arch=('x86_64')
url="https://www.gethomebank.org/"
license=('GPL-2.0-or-later')
depends=(
  'cairo'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libgcc'
  'libofx'
  'libsoup3'
  'pango'
)
makedepends=('intltool')
source=("https://www.gethomebank.org/public/sources/$pkgname-$pkgver.tar.gz")
b2sums=('9bb15b7dd7b54760cc5ccd0e6bfa52f3314ab0432471c0a23c5d87bfc9ea7002bc2b24223dea1ba3942eb26d8e012a6c7651490e616049d4c41be06788afe1ad')

build() {
  cd "$pkgname-$pkgver"
  ./configure --prefix=/usr
  make
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}
