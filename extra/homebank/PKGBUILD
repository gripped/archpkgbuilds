pkgname=homebank
pkgver=5.10
pkgrel=1
pkgdesc="Free, easy, personal accounting for everyone"
arch=('x86_64')
url="https://www.gethomebank.org/"
license=('GPL-2.0-or-later')
depends=(
  'cairo'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libgcc'
  'libofx'
  'libsoup3'
  'pango'
)
makedepends=('intltool')
source=("https://www.gethomebank.org/public/sources/$pkgname-$pkgver.tar.gz")
b2sums=('bbb2dbfe3b5e193c11315e568d070d9a31e201739bbad5b3446ec50dfd8d9d14a6d330b2e7de8591d8b997d9a8b41702ac8e3bb67c12c8dbd3de9b8a7a95c77a')

build() {
  cd "$pkgname-$pkgver.0"
  ./configure --prefix=/usr
  make
}

package() {
  cd "$pkgname-$pkgver.0"
  make DESTDIR="$pkgdir" install
}
