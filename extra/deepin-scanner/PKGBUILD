# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-scanner
pkgver=0.1.26
pkgrel=1
pkgdesc='Document scanning tool for Deepin'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-scanner"
license=('CC-BY-4.0' 'CC0-1.0' 'GPL-3.0-or-later' 'LGPL-3.0-or-later' 'MIT')
depends=(
  'dtk6core'
  'dtk6gui'
  'dtk6widget'
  'glibc'
  'hicolor-icon-theme'
  'libgcc'
  'libpng'
  'libstdc++'
  'qt6-5compat'
  'qt6-base'
  'qt6-imageformats'
  'qt6-svg'
  'quazip-qt6'
  'sane'
)
makedepends=(
  'cmake'
  'git'
  'ninja'
  'qt6-declarative'
  'qt6-tools'
)
groups=('deepin-extra')
source=("git+https://github.com/linuxdeepin/deepin-scanner.git#tag=$pkgver")
sha512sums=('b0c6855f8c41f974c0f2633ac1f348e784a2698c2588035b187d210e20a22c5c26e875dbef393f4b2919ebf3255f4bf9ea42d7775e343e8f556ee19d7f8cd144')

prepare() {
  cd deepin-scanner
  # Fix missing Qt include exposed by current Qt/GCC headers.
  sed -i '/#include <QDateTime>/a #include <QElapsedTimer>' src/device/webcamdevice.cpp
}

build() {
  cmake -B build -S deepin-scanner -GNinja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DVERSION=$pkgver
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
