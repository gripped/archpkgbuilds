# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: onny <onny@project-insanity.org>

pkgname=python-passlib
pkgver=1.9.5
pkgrel=1
pkgdesc="A password hashing library for Python"
arch=('any')
url="https://github.com/notypecheck/passlib"
license=(BSD-3-Clause)
depends=("python")
optdepends=("python-argon2-cffi: support Argon2 hashes"
            "python-bcrypt: accelerate Bcrypt hashes"
            "python-cryptography: support AES-encrypted TOTP wallet keys"
            "python-scrypt: accelerate SCrypt hashes")
makedepends=('git' 'python-build' 'python-hatchling' 'python-installer')
checkdepends=('python-pytest' 'python-argon2-cffi' 'python-bcrypt' 'python-cryptography'
              'python-django' 'python-scrypt')
source=("git+https://github.com/notypecheck/passlib.git#tag=$pkgver")
sha512sums=('0bbedf47843c81b6731aa6b7ea77334288518e4bb0c708efc551f8bd954d2bb0e622a7d35d47b3a4822656f2bcd5826476cf456a14fa741d537c34edb2027fb7')

build() {
  cd "$srcdir"/passlib
  python -m build --wheel --no-isolation
}


check() {
  export PASSLIB_TEST_MODE=full

  cd "$srcdir"/passlib
  # Upstream test assumes python-scrypt is absent: https://github.com/notypecheck/passlib/issues/26
  # TOTP cost timing is flaky; functional wallet encryption tests still run.
  pytest \
    --deselect=tests/test_crypto_scrypt.py::BuiltinScryptTest::test_missing_backend \
    --deselect=tests/test_totp.py::AppWalletTest::test_encrypt_cost_timing
}

package() {
  cd passlib
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

