# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Kenneth Endfinger <kaendfinger@gmail.com>

pkgname=throttled
pkgver=0.13
pkgrel=1
pkgdesc="Linux daemon for Intel CPU power limits and firmware-induced throttling"
arch=('any')
url="https://github.com/erpalma/throttled"
license=('MIT')
depends=('python-dbus-fast')
makedepends=('git')
backup=('etc/throttled.conf')
install=$pkgname.install
source=("git+https://github.com/erpalma/$pkgname.git#tag=v$pkgver")
sha512sums=('374f46f4ee459c308ae6c2481db3965d5e1cbde8c221458e86ff7c47de4c2b51957a81430664653c16be99103295ae11edec997f1d069dcadcc9a9d54b445e56')

prepare() {
  cd $pkgname
  # Skip Debian packaging tests.
  rm tests/test_build_deb.py
}

build() {
  cd $pkgname
  python -m compileall *.py
}

check() {
  cd $pkgname
  python -m unittest discover -s tests
}

package() {
  cd $pkgname
  install -Dm644 etc/throttled.conf "$pkgdir"/etc/throttled.conf
  install -Dm644 systemd/throttled.service "$pkgdir"/usr/lib/systemd/system/throttled.service
  # Use the packaged launcher instead of upstream's virtualenv.
  sed -i 's|/opt/throttled/venv/bin/throttled|/usr/bin/throttled|' "$pkgdir"/usr/lib/systemd/system/throttled.service
  install -Dm755 packaging/throttled "$pkgdir"/usr/bin/throttled
  install -Dm755 throttled.py "$pkgdir"/usr/lib/$pkgname/throttled.py
  install -Dm755 mmio.py "$pkgdir"/usr/lib/$pkgname/mmio.py
  install -Dm644 throttled_version.py "$pkgdir"/usr/lib/$pkgname/throttled_version.py
  cp -a __pycache__ "$pkgdir"/usr/lib/$pkgname/
  install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

# vim:set ts=2 sw=2 et:
