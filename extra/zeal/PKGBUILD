pkgname=zeal
pkgver=0.9.2
pkgrel=1
pkgdesc='Offline API documentation browser'
arch=(x86_64)
url='https://zealdocs.org'
license=(GPL-3.0-or-later)
depends=(
  glibc
  hicolor-icon-theme
  qt6-webengine
  qt6-base
  qt6-webchannel
  qt6-svg
  sqlite
  libarchive
  libgcc
  libstdc++
  libxcb
  libx11
  libxkbcommon
  tomlplusplus
  xcb-util-keysyms
  zlib
)
makedepends=(
  cmake
  extra-cmake-modules
  ninja
  git
  vulkan-headers
)
source=("$pkgname::git+https://github.com/zealdocs/zeal#tag=v$pkgver")
sha512sums=('4487fb89ef32dbb51e40af500c01fbdbafbd584ae74f5f217d6f960f7c2f39a157fd6862f751ff210e0d15737ff35cb5fb54da3cf8981d79b820f6650b78b45b')
b2sums=('8db940a4625fbf25e76925bd2c228762d149ef519ed23054d8b4d04e5120fc382b34faba828a473e6783ef6a4b66ac1a2a9348d28ff78a7b21721e341fb47027')

build() {
  local cmake_options=(
    -B build
    -S "$pkgname"
    -G Ninja
    -W no-author
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX=/usr
    -D ZEAL_FEATURE_UPDATE_CHECK=OFF
    -D BUILD_TESTING=ON
  )

  cmake "${cmake_options[@]}"

  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
