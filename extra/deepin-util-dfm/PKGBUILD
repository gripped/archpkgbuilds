# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-util-dfm
pkgver=1.2.29
pkgrel=1
pkgdesc='Utilities of deepin file manager'
arch=('x86_64')
license=('GPL-3.0-or-later')
url="https://github.com/linuxdeepin/util-dfm"
depends=('glib2' 'glibc' 'libgcc' 'libisoburn' 'libmediainfo' 'libsecret' 'libstdc++' 'qt5-base'
         'udisks2' 'util-linux-libs')
makedepends=('git' 'cmake' 'ninja')
source=("git+https://github.com/linuxdeepin/util-dfm.git#tag=$pkgver")
sha512sums=('7a1fc77365279743d39990039428dfca22c0c62c265009ab43a9380cca269966a4ba81ca2d3860c1a2a9215dafb848b1cf8d2a81d95fd53de1c04fa31bbe63be')

build() {
  cmake -G Ninja -B build -S util-dfm -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_POLICY_VERSION_MINIMUM=3.5
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
