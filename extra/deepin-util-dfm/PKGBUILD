# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-util-dfm
epoch=1
pkgver=1.3.2
pkgrel=1
pkgdesc='Utilities of deepin file manager'
arch=('x86_64')
license=('GPL-3.0-or-later' 'LGPL-3.0-or-later')
url="https://github.com/linuxdeepin/util-dfm"
depends=('glib2' 'glibc' 'libgcc' 'libisoburn' 'libmediainfo' 'libsecret'
         'libstdc++' 'qt6-base' 'udisks2' 'util-linux-libs')
makedepends=('git' 'cmake' 'ninja')
source=("git+https://github.com/linuxdeepin/util-dfm.git#tag=$pkgver")
sha512sums=('c10cc28246e547eb6d3e6dd50ef728af907402c30a62cbe3523ec7cac3951673e599e2b5fed5bcd016bd4c90b64fe4759fe1378baa89136e92bcf0b22e5b5b85')

prepare() {
  cd util-dfm

  # Restore the DEnumerator API used by dde-file-manager:
  # https://github.com/linuxdeepin/util-dfm/commit/d2317bbef74e80ebb0616ed2b6d57c4d028d98f8
  git cherry-pick -n d2317bbef74e80ebb0616ed2b6d57c4d028d98f8
}

build() {
  cmake -G Ninja -B build -S util-dfm -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DOPT_ENABLE_QT6=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
