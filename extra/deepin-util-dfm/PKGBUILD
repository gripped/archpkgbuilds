# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-util-dfm
epoch=1
pkgver=1.3.7
pkgrel=1
pkgdesc='Utilities of deepin file manager'
arch=('x86_64')
license=('GPL-3.0-or-later' 'LGPL-3.0-or-later')
url="https://github.com/linuxdeepin/util-dfm"
depends=('glib2' 'glibc' 'libgcc' 'libisoburn' 'libmediainfo' 'libsecret'
         'libstdc++' 'qt6-base' 'udisks2' 'util-linux-libs')
makedepends=('git' 'cmake' 'ninja')
source=("git+https://github.com/linuxdeepin/util-dfm.git#tag=$pkgver")
sha512sums=('47c8dd9064d2263a2482b4bd5316bcd8d5f89d5234fc52a2c328c6399fdb6a8ab05e8cbaf575e497691acc54164857791b9f016c1a04485ff63cb130d321dd03')

prepare() {
  cd util-dfm
  # Backport upstream's Qt6-only CMake cleanup so the package does not require Qt5:
  # https://github.com/linuxdeepin/util-dfm/commit/1415a2557ea42b057fedf6b62ed1a1991e09bc12
  git cherry-pick -n 1415a2557ea42b057fedf6b62ed1a1991e09bc12
}

build() {
  cmake -G Ninja -B build -S util-dfm -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_POLICY_VERSION_MINIMUM=3.5
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
