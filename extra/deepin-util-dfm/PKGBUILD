# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-util-dfm
pkgver=1.2.31
pkgrel=1
pkgdesc='Utilities of deepin file manager'
arch=('x86_64')
license=('GPL-3.0-or-later')
url="https://github.com/linuxdeepin/util-dfm"
depends=('dtkcore' 'glib2' 'glibc' 'libgcc' 'libisoburn' 'libmediainfo' 'libsecret'
         'libstdc++' 'lucene++' 'qt5-base' 'udisks2' 'util-linux-libs')
makedepends=('boost' 'git' 'cmake' 'ninja')
source=("git+https://github.com/linuxdeepin/util-dfm.git#tag=$pkgver")
sha512sums=('72168dea7476ecb0f9422a9a7abe208d0c66e97a4d279d87c5e8ee9ebe37e57eda5c10206c38bb5357e736a1dcaf0753e8a82fc203f148bc3f5d79bdf10b2069')

prepare() {
  cd util-dfm

  # Boost.System is header-only in Boost 1.90, so there is no boost_system library/component to find on Arch
  sed -i '/find_package(Boost REQUIRED COMPONENTS system)/d' src/dfm-search/dfm-search-lib/dfm-search.cmake
  sed -i 's/\s*Boost::system//' src/dfm-search/dfm-search-lib/dfm-search.cmake

  # dfm-search uses std::optional but forgets to include <optional>
  sed -i '/#include <QObject>/a #include <optional>' include/dfm-search/dfm-search/dsearch_global.h
}

build() {
  cmake -G Ninja -B build -S util-dfm -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_POLICY_VERSION_MINIMUM=3.5
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
