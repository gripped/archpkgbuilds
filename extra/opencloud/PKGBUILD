pkgname=opencloud
pkgver=7.2.1
pkgrel=1
pkgdesc='Open source platform for file management, sharing & collaboration'
arch=(x86_64)
url='https://opencloud.eu'
license=(Apache-2.0)
depends=(glibc sqlite)
makedepends=(
  git
  go
  pnpm
)
backup=(etc/opencloud/config.env)
install=opencloud.install
options=(!lto)
source=(
  "$pkgname::git+https://github.com/opencloud-eu/opencloud#tag=v${pkgver/_/-}"
  version-strings.patch
  config.env
  systemd.service
  sysusers.conf
  tmpfiles.conf
)
