# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=contractor
pkgver=0.3.5
pkgrel=4
pkgdesc='A desktop-wide extension service'
arch=(x86_64)
url=https://github.com/elementary/contractor
license=(GPL-3.0-or-later)
groups=(pantheon)
depends=(
  glib2
  glibc
  libgee
)
makedepends=(
  git
  meson
  vala
)
source=(git+https://github.com/elementary/contractor.git#tag=${pkgver})
b2sums=('7f37a0c084fe83287977502593a147f13ad5f1529d33258b8907d153d3d508102d1bded0baa60a63086154b1ed65276ae1d7b156c481d83fe31145cc1bc4032f')

build() {
  arch-meson contractor build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}

