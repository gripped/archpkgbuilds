pkgname=libretro-melonds
pkgver=20260420.172846.g634e51477364
pkgrel=1
pkgdesc='Nintendo DS core'
arch=(x86_64)
url=https://github.com/libretro/melonDS
license=(GPL-2.0-only)
groups=(libretro)
depends=(
  glibc
  libgcc
  libgl
  libstdc++
  libretro-core-info
)
makedepends=(
  git
  libglvnd
)
source=(libretro-melonds::git+https://github.com/libretro/melonDS.git#commit=${pkgver##*.g})
b2sums=('3215aa8b4098ad1f2ecd2909dc61cc3dc75597f55c04f1bfd12302e21e3c0ad81b492b368bd379ef419aa3f52bf08658c6721caa5e80ff146cae0b2dcbc6b5d5')

build() {
  export LDFLAGS="$LDFLAGS -lpthread"

  make -C libretro-melonds
}

package() {
  install -Dm 644 libretro-melonds/melonds_libretro.so -t "${pkgdir}"/usr/lib/libretro/
}
