pkgname=libretro-melonds
pkgver=20260625.154401.gc9550d18923f
pkgrel=2
pkgdesc='Nintendo DS core'
arch=(x86_64)
url=https://github.com/libretro/melonDS
license=(GPL-2.0-only)
groups=(libretro)
depends=(
  glibc
  libgcc
  libgl
  libstdc++
  libretro-core-info
)
makedepends=(
  git
  libglvnd
)
source=(libretro-melonds::git+https://github.com/libretro/melonDS.git#commit=${pkgver##*.g})
b2sums=('d8572b89b7be143a1a669754cec0315eda5732107513426cfee11914b694163526c334d9bec52035eb60a67848ab07edab04bb8a68bc97da321bf883f360043a')

build() {
  export LDFLAGS="$LDFLAGS -lpthread"

  make -C libretro-melonds
}

package() {
  install -Dm 644 libretro-melonds/melonds_libretro.so -t "${pkgdir}"/usr/lib/libretro/
}
