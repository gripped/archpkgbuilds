# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-application-manager
pkgver=1.2.44
pkgrel=1
pkgdesc='App manager of Deepin Desktop Environment'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-application-manager"
license=('GPL-3.0-or-later')
# deepin-services: org.deepin.dde.XSettings1
depends=('dtk6core' 'qt6-base' 'qt6-wayland' 'glibc' 'libgcc' 'libstdc++' 'systemd-libs' 'deepin-daemon'
         'libxkbcommon')
makedepends=('git' 'cmake' 'ninja' 'gtest' 'treeland-protocols')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/dde-application-manager.git#tag=$pkgver")
sha512sums=('0aa65b3ccba85ac17c8f4b21f9195f4e6f0e16621525b4cd720beee1871099939c628e7514b474bf7b3b367ddf56e06cb070e3b3845fc79c580d96f80ad6d4d3')

build() {
  cd dde-application-manager
  cmake -B build -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_SYSCONFDIR=/etc -DCMAKE_INSTALL_LIBEXECDIR=lib
  cmake --build build
}

check() {
  cd dde-application-manager/build
  ninja test
}

package() {
  cd dde-application-manager/build
  DESTDIR="$pkgdir" ninja install
  rm -r "$pkgdir"/etc/dpkg
  rmdir "$pkgdir"/etc
}
