# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-rpds-py
pkgver=2026.11.1
pkgrel=1
pkgdesc='Python bindings to the Rust rpds crate for persistent data structures'
arch=(x86_64)
url='https://github.com/crate-py/rpds'
license=(MIT)
depends=(
  glibc
  libgcc
  python
)
makedepends=(
  git
  python-build
  python-maturin
  python-installer
)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('b92647fa74095656c8a37b84c107188850454c117437c8cf7a6b44fc5bb9989b468b52aba5b8c3ed4f6be61cf18bf2639a168bb5f9488c28906a1038cc653b86')
b2sums=('9aa1466611a8a010813e0c1b2753f8d83c32d64ae7a966c488f0af0c8ac6f828b3b096d6eb0790a953edf73b775cf86d2f8b55f456da5bd822d5f043efc27385')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
