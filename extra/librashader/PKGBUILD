# Maintainer: George Rawlinson <grawlinson@archlinux.org>
# Contributor: Snowstorm64

pkgname=librashader
pkgver=0.11.1
pkgrel=1
pkgdesc="A preprocessor, compiler, and runtime for RetroArch 'slang' shaders"
arch=(x86_64)
url='https://github.com/SnowflakePowered/librashader'
license=(GPL-3.0-only MPL-2.0)
depends=(
  glibc
  libgcc
  libgl
  libstdc++
  vulkan-driver
  vulkan-icd-loader
)
makedepends=(
  git
  rust
  ninja
)
options=(!lto)
source=("$pkgname::git+$url#tag=librashader-v$pkgver")
sha512sums=('b088b84f5069d3bba9c02b2229076e27956b434388f871db51fdb33a032cd4a8c225652a1e68600b2048aa7a0b50c56af08f3dbefc5d7e1510fd1393b409ca56')
b2sums=('26eab9e89783103157b751b5d9444805afaffb472295333d18f2e7367c8e12fab65e75dc5b5ff2357dc258a41587053183647d3a0a55e1999bec45f714e5a239')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo run \
    -p librashader-build-script \
    -- \
    --stable \
    --profile optimized \
    -- \
    --no-default-features \
    --features=runtime-vulkan,runtime-opengl
}

package() {
  cd "$pkgname"

  # library
  install -vDm755 target/optimized/librashader.so "$pkgdir/usr/lib/librashader.so.${pkgver}"
  ln -rs "$pkgdir/usr/lib/librashader.so.${pkgver}" "$pkgdir/usr/lib/librashader.so"

  # headers
  install -vDm644 -t "$pkgdir/usr/include/librashader" include/*.h

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE*
}
