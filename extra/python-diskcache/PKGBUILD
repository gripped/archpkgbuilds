# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-diskcache
pkgver=5.6.3
pkgrel=1
pkgdesc="Disk and file backed persistent cache"
arch=('any')
url="https://github.com/grantjenks/python-diskcache"
license=('Apache-2.0')
depends=('python')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools')
checkdepends=('python-django' 'python-pytest' 'python-pytest-cov' 'python-pytest-django'
              'python-pytest-xdist')
optdepends=('python-django: Django cache backend')
source=("git+https://github.com/grantjenks/python-diskcache.git#tag=v$pkgver")
sha512sums=('223ca9207f2bc024b0ba764df4a4466fd0f44a4432be0b6cac642578aec02257d257aa973dc421495d5e2451b27f82e09d14bce57f4ea2c3ea3493eac4e0133f')

build() {
  cd python-diskcache
  python -m build --wheel --no-isolation
}

check() {
  cd python-diskcache
  DJANGO_SETTINGS_MODULE=tests.settings python -m pytest
}

package() {
  cd python-diskcache
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
