# Maintainer: Maxime Gauduin <alucryd@gmail.com>
# Contributor: zeroclaw-labs <bot@zeroclaw.dev>
# Contributor: Ralph Torres <mail@ralphptorr.es>
# Contributor: SteamedFish <steamedfish@hotmail.com>

pkgbase=zeroclaw
pkgname=(
  zeroclaw
  zerocode
)
pkgver=0.8.5
pkgrel=1
pkgdesc='Zero overhead. Zero compromise. 100% Rust. The fastest, smallest AI assistant.'
arch=(x86_64)
url=https://github.com/zeroclaw-labs/zeroclaw
license=(
  Apache-2.0
  MIT
)
depends=(
  glibc
  libgcc
  libstdc++
)
makedepends=(
  cargo
  clang
  git
  nodejs-lts
  npm
  rust
)
source=(git+https://github.com/zeroclaw-labs/zeroclaw.git#tag=v${pkgver})
b2sums=('6022e873c2f0747bfbefe70c25f664178ccb4bce21541af1a32ffd50f4b1f01f55101f128a74c6652dbd76f3b86b3497b88ae36cf75531b3ba40044dbda63730')

prepare() {
  cd zeroclaw
  cargo fetch --locked
  cd web
  npm ci
}

build() {
  cd zeroclaw
  export CC=clang
  export CXX=clang++
  cargo web build
  cargo build \
    --release \
    --frozen \
    --features "channel-git,channel-matrix,channel-mattermost,embedded-web,plugins-wasm,provider-github,sandbox-bubblewrap,sandbox-landlock,webauthn"
  cd apps/zerocode
  cargo build \
    --release \
    --frozen \
    -p zerocode
}

package_zeroclaw() {
  install -Dm 755 zeroclaw/target/release/zeroclaw -t "${pkgdir}"/usr/bin/
  install -Dm 644 zeroclaw/LICENSE-MIT -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}

package_zerocode() {
  install -Dm 755 zeroclaw/target/release/zerocode -t "${pkgdir}"/usr/bin/
  install -Dm 644 zeroclaw/LICENSE-MIT -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}
