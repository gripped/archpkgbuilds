# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=webapp-manager
pkgver=1.4.9
pkgrel=1
pkgdesc='Run websites as if they were apps'
arch=(any)
url='https://github.com/linuxmint/webapp-manager'
license=(GPL-3.0-or-later)
groups=(x-apps)
depends=(
  bash
  dconf
  gdk-pixbuf2
  glib2
  gtk3
  hicolor-icon-theme
  python
  python-beautifulsoup4
  python-gobject
  python-pillow
  python-requests
  python-setproctitle
  python-tldextract
  xapp
)
makedepends=(git)
source=("git+https://github.com/linuxmint/webapp-manager.git#tag=$pkgver")
b2sums=(d772b31a744c00ab890fe16eb308e4ce55089da0dbd33579e5ed7c0de3fc1bd7d3bbd5d4aea0325cf1e031babef8abda062087d27ab2278b38b00a4812d8285a)

prepare() {
  cd $pkgname

  # Set version number
  sed -i "s/__DEB_VERSION__/$pkgver/" usr/lib/webapp-manager/webapp-manager.py
}

build() {
  cd $pkgname
  make
}

package() {
  cd $pkgname
  cp -r etc usr "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
