pkgname=soapyuhd
pkgver=0.4.2
pkgrel=1
pkgdesc='Soapy SDR plugin for UHD supported SDR devices'
arch=('x86_64')
url='https://github.com/pothosware/SoapyUHD'
license=('GPL-3.0-or-later')
depends=(
  'glibc'
  'libgcc'
  'libstdc++'
  'libuhd'
  'soapysdr'
)
makedepends=(
  'boost'
  'cmake'
  'git'
)
source=("$pkgname::git+$url.git#tag=soapy-uhd-$pkgver")
b2sums=('fa03912ed13349b4f5b7e3e574428bf87514029538827d363e3ceea059e0a6b3fd92e16225ed356f8885c04f83eadeeabbb45d5c9e3a985d753b024bcf4d2ba2')

build() {
  cmake -B build -S $pkgname \
    -D CMAKE_BUILD_TYPE=None \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -W no-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
