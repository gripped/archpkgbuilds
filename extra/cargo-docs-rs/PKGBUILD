# Maintainer: Orhun Parmaksız <orhun@archlinux.org>

pkgname=cargo-docs-rs
pkgver=1.0.3
pkgrel=1
pkgdesc="Imitate the documentation build that docs.rs would do"
arch=('x86_64')
url="https://github.com/dtolnay/cargo-docs-rs"
license=('MIT' 'Apache-2.0')
depends=('glibc' 'libgcc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz"
  "Cargo.lock")
sha512sums=('e36be1ea65a0176822e18926b39df2f678eb705385776c8860be5caf3cc6ffdb7456d6d3236be0073f9d4483988feb8c88a3a8ae5c0e160dd6063be24d6785ea'
            '7ee65761cbc130b682fc03c340fa4cb0accf63f3a7e3209402a705172f3ba486a072ac1d9efab402c3690be2b9e8352b681a59a5a7ba0c5c57218811ed1fde95')

prepare() {
  cd "$pkgname-$pkgver"
  cp "$srcdir/Cargo.lock" .
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --frozen
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm 755 "target/release/$pkgname" -t "$pkgdir/usr/bin"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm 644 LICENSE-MIT -t "$pkgdir/usr/share/licenses/$pkgname"
}

# vim:set ts=2 sw=2 et:
