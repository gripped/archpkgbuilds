# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=argo-workflows
pkgver=4.0.2
pkgrel=1
pkgdesc='Workflow Engine for Kubernetes'
arch=(x86_64)
url='https://github.com/argoproj/argo-workflows'
license=(Apache-2.0)
depends=(glibc)
makedepends=(
  git
  go
)
options=('!lto')
source=("git+$url#tag=v$pkgver")
b2sums=('4d244033bdb1f546549482bc5b79185a85ead05fd851f31d1c35a1b84dc2a203f9c5025214b65d82000b1e3850da47a9a6fcec8792fb342d4d4c4ca3525d6a70')

prepare() {
  cd $pkgname
  GOFLAGS="-mod=readonly" go mod vendor -v
  # Satisfy //go:embed directive for UI assets not needed by the CLI
  install -vDm644 /dev/null ui/dist/app/placeholder
}

build() {
  cd $pkgname
  export CGO_LDFLAGS="$LDFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export GOFLAGS="-buildmode=pie -mod=vendor -modcacherw"
  export GOPATH="$srcdir"

  local ld_flags=" \
    -compressdwarf=false \
    -linkmode=external \
    -X github.com/argoproj/argo-workflows/v4.version=$pkgver \
    -X github.com/argoproj/argo-workflows/v4.gitTag=v$pkgver \
  "
  go build -v -ldflags "$ld_flags" -o build/argo ./cmd/argo
}

check() {
  cd $pkgname
  # Skip tests requiring a Kubernetes cluster
  go test ./cmd/argo/... ./pkg/...
}

package() {
  cd $pkgname
  build/argo completion bash \
    | install -vDm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/argo"
  build/argo completion zsh \
    | install -vDm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_argo"
  build/argo completion fish \
    | install -vDm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/argo.fish"
  install -vDm755 -t "$pkgdir/usr/bin" build/argo
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
