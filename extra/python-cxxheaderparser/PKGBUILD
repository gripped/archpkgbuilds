# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-cxxheaderparser
pkgver=1.8.1
pkgrel=1
pkgdesc='Modern C++ header parser'
arch=('any')
url='https://github.com/robotpy/cxxheaderparser'
license=('BSD-3-Clause')
depends=('python')
optdepends=('python-pcpp: PCPP-based preprocessing support')
makedepends=('git' 'python-build' 'python-hatchling' 'python-hatch-vcs' 'python-installer'
             'python-wheel')
checkdepends=('python-pcpp' 'python-pytest')
source=("git+https://github.com/robotpy/cxxheaderparser.git#tag=$pkgver")
sha512sums=('41e2a71cb64e10bd54f5c318a008b61b88b63a95e8bfbbc1999684ab88fcf322b45bbb4f91f28cc5fe18372f5f4a97d9a0d250ab6380558db22392fcea1ef997')

build() {
  cd cxxheaderparser
  python -m build --wheel --no-isolation
}

check() {
  cd cxxheaderparser
  PYTHONPATH="$PWD" pytest
}

package() {
  cd cxxheaderparser
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
