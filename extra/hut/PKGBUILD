pkgname=hut
pkgver=0.8.0
pkgrel=1
pkgdesc='A CLI tool for Sourcehut'
arch=(x86_64)
url='https://sr.ht/~xenrox/hut'
license=(AGPL-3.0-only)
depends=(glibc)
makedepends=(git go scdoc)
options=(!lto !debug)
source=("$pkgname::git+https://git.sr.ht/~xenrox/hut#tag=v$pkgver")
sha512sums=('8dbc5d33c9c9e0e8ef86db28c01f49fac2e7c2cbd7e0aa628cbbd4eec86c4874523d9a9c0b724f7f6c27da137c11c9ebb5909ef22583101d026d3f0fbcb6b662')
b2sums=('ac8e3a0aa8f68504efd5539b4bb10098b49aa5bb97c43bc52dd6626a72f559f14da59cddb28e0a0e61f19029bf36a6129a32df8cd92bdcf2b258b9f9e0ffb752')

prepare() {
  cd "$pkgname"

  # download dependencies
  go mod download
}

build() {
  cd "$pkgname"

  # set Go flags
  export CGO_LDFLAGS="${LDFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"

  make --environment-overrides
}

check() {
  cd "$pkgname"

  go test -v ./...
}

package() {
  cd "$pkgname"

  make PREFIX=/usr DESTDIR="$pkgdir" install
}
