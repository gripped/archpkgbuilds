pkgname=jc
pkgver=1.25.7
pkgrel=1
pkgdesc='Converts the output of popular command-line tools and file-types to JSON'
arch=(any)
url='https://github.com/kellyjonbrazil/jc'
license=(MIT)
depends=(
  python
  python-pygments
  python-ruamel-yaml
  python-xmltodict
)
makedepends=(
  git
  python-build
  python-installer
  python-wheel
  python-setuptools
)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('0c96952516de0984f84696e7d93090679e7f06a780f57a94995632d3f98f671a85178bb24225de5496b6dbf26a21e38bbf77c18df929c875503328ff4f5834f2')
b2sums=('27086ab7c4bd922557b128891727136feccc1fbf613913c7e3b2fa56545d69815a31549bc469993e7de0eaac3cb11814b71fe380d87b2cb992b96e132a15682d')

build(){
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

#check() {
#  cd "$pkgname"
#
#  python -m unittest -v
#}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md EXAMPLES.md
  cp -vr docs "$pkgdir/usr/share/doc/$pkgname"

  # man page
  install -vDm644 -t "$pkgdir/usr/share/man/man1" man/jc.1

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE.md
}
