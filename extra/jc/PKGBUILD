pkgname=jc
pkgver=1.26.0
pkgrel=1
pkgdesc='Converts the output of popular command-line tools and file-types to JSON'
arch=(any)
url='https://github.com/kellyjonbrazil/jc'
license=(MIT)
depends=(
  python
  python-pygments
  python-ruamel-yaml
  python-xmltodict
)
makedepends=(
  git
  python-build
  python-installer
  python-wheel
  python-setuptools
)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('2e1c08a64e892595caa1e59a8b6d34c6ef69f037036d911f390b81c9c75729fc84148ad9848ff6b096e2736e84f00aa9c32127311faf88c025cb8b5a37e33bcb')
b2sums=('100da13ed7286bc753dcb97a6fe81a9e86699a80fa0020ef05e2594fd796cb8d172e07986abb73867ac1b4d3c60f9f5eb0029864f0469afdaa7cbc577f88d83d')

build(){
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

#check() {
#  cd "$pkgname"
#
#  python -m unittest -v
#}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md EXAMPLES.md
  cp -vr docs "$pkgdir/usr/share/doc/$pkgname"

  # man page
  install -vDm644 -t "$pkgdir/usr/share/man/man1" man/jc.1

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE.md
}
