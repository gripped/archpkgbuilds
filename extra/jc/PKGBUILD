pkgname=jc
pkgver=1.26.2
pkgrel=1
pkgdesc='Converts the output of popular command-line tools and file-types to JSON'
arch=(any)
url='https://github.com/kellyjonbrazil/jc'
license=(MIT)
depends=(
  python
  python-pygments
  python-ruamel-yaml
  python-xmltodict
)
makedepends=(
  git
  python-build
  python-installer
  python-wheel
  python-setuptools
)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('87675b9a0df9488787f0c9c73701441be2d05a02013cc8c8e71f0a9caa0472015bb4c50cf2e9ae41be81e18469d108319453a297a1cb60e3cc27531daaa228d5')
b2sums=('51f48e14c36267be1edd6e1ef17a75fde07b7faf01c7b06cc3ccf0ece14ac8ef10eac4498be2f6c1174bc23d70fa58981ea7e521b33d8e6180f6d4a79d573883')

build(){
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

#check() {
#  cd "$pkgname"
#
#  python -m unittest -v
#}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md EXAMPLES.md
  cp -vr docs "$pkgdir/usr/share/doc/$pkgname"

  # man page
  install -vDm644 -t "$pkgdir/usr/share/man/man1" man/jc.1

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE.md
}
