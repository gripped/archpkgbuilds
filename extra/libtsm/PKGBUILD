pkgname=libtsm
pkgver=4.6.0
pkgrel=1
pkgdesc='Terminal-emulator State Machine'
arch=('x86_64')
url='https://github.com/kmscon/libtsm'
license=('MIT')
depends=('glibc')
makedepends=(
  check
  git
  meson
  libxkbcommon
)
options=(!libtool)
source=(git+${url}.git#tag=v$pkgver)
b2sums=('863793ce1d3c81b960c5ba6cbc668ce6f1df0e82dfaa729cb1306c870a5ff496b538c6cb6c80cca7778c0eff363bbb54ed5657a6706c22495e52af48e54512eb')

build() {
  arch-meson "$pkgname" build
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
  install -Dm644 $pkgname/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
