pkgname=libtsm
pkgver=4.7.1
pkgrel=1
pkgdesc='Terminal-emulator State Machine'
arch=('x86_64')
url='https://github.com/kmscon/libtsm'
license=('MIT')
depends=('glibc')
makedepends=(
  check
  git
  meson
  libxkbcommon
)
options=(!libtool)
source=(git+${url}.git#tag=v$pkgver)
b2sums=('7113e06a7c0b2cb90bc009eec12087edc02352fc40376f9717b7cc87ebf36b31971f6696a19176c2441e13977340969144a9bd9d1a621c8f06f1e543c247cd39')

build() {
  arch-meson "$pkgname" build
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
  install -Dm644 $pkgname/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
