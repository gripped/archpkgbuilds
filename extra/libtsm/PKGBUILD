pkgname=libtsm
pkgver=4.4.3
pkgrel=1
pkgdesc='Terminal-emulator State Machine'
arch=('x86_64')
url='https://github.com/kmscon/libtsm'
license=('MIT')
depends=('glibc')
makedepends=(
  check
  git
  meson
  libxkbcommon
)
options=(!libtool)
source=(git+${url}.git#tag=v$pkgver)
b2sums=('57a55e2646fa9ffd12047fd9731c2ab6f960c814265df5ab570a8a0d3cfd8b7f8648100397d6dd0a7a33ac96f2f2fe27b647e7d4b86f574d01b40b22e9033d64')

build() {
  arch-meson "$pkgname" build
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
  install -Dm644 $pkgname/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
