pkgname=libtsm
pkgver=4.7.0
pkgrel=1
pkgdesc='Terminal-emulator State Machine'
arch=('x86_64')
url='https://github.com/kmscon/libtsm'
license=('MIT')
depends=('glibc')
makedepends=(
  check
  git
  meson
  libxkbcommon
)
options=(!libtool)
source=(git+${url}.git#tag=v$pkgver)
b2sums=('9bc796401236838497dcdc15e5e7412bd554a0f6604b46d9241e8da3c9fd698747f1082f0e10b7ea3bf78aa2ec2f2fed7ce0612e7e9e35be4e6e8523284c46b0')

build() {
  arch-meson "$pkgname" build
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
  install -Dm644 $pkgname/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
