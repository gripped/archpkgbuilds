pkgbase = wallabag
	pkgdesc = Self hostable application for saving web pages
	pkgver = 2.6.15
	pkgrel = 1
	url = https://www.wallabag.org/
	arch = any
	license = MIT
	makedepends = systemd
	depends = php
	depends = php-gd
	depends = php-tidy
	depends = php-intl
	optdepends = php-fpm: to run in FastCGI process manager
	optdepends = php-pgsql: to use a local PostgreSQL server
	optdepends = php-sqlite: to use the SQLite database backend
	optdepends = rabbitmq: to use a local RabbitMQ server for async import
	optdepends = valkey: to use a local Redis server for async import
	options = !strip
	backup = etc/wallabag/parameters.yml
	source = wallabag-2.6.15.tar.gz::https://github.com/wallabag/wallabag/releases/download/2.6.15/wallabag-2.6.15.tar.gz
