# Maintainer: Jakub Klinkovský <lahwaacz@archlinux.org>

_name=nsight
pkgname=python-$_name
pkgver=1.0.0
pkgrel=1
pkgdesc="Python kernel profiling interface based on NVIDIA Nsight Tools"
arch=(any)
url="https://docs.nvidia.com/nsight-python/index.html"
license=(Apache-2.0)
depends=(
  nsight-compute  # ncu binary and ncu_report Python module
  python
  python-cuda-core
  python-deepdiff
  python-matplotlib
  python-numpy
  python-nvidia-ml-py
  python-nvtx
  python-pandas
)
makedepends=(
  python-build
  python-hatchling
  python-hatch-vcs
  python-installer
  python-wheel
)
source=(
  $pkgname-$pkgver.tar.gz::https://github.com/NVIDIA/nsight-python/archive/refs/tags/v$pkgver.tar.gz
)
b2sums=('d73d63c2c0d28355e6de44626986970e4d7f4c6fe22875058efa7c45eaacc6fa044dedf785932f8354bb9209653df2ca23f1470726fb832c43de8426642e2a58')

build() {
  cd $_name-python-$pkgver
  SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver \
  python -m build --wheel --no-isolation
}

package() {
  cd $_name-python-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
