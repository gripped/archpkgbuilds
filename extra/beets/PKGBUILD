build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  local pytest_args=(
    --override-ini="addopts="
    --ignore=test/plugins/test_player.py
    --deselect=test/test_ui.py::CompletionTest::test_completion
    --deselect=test/plugins/test_embedart.py::EmbedartCliTest::test_reject_different_art
    --deselect=test/plugins/test_bpd.py::BPDReflectionTest::test_cmd_decoders
    --deselect=test/plugins/test_aura.py
    --deselect=test/plugins/test_replaygain.py::TestReplayGainGstCli::test_cli_skips_calculated_tracks
    --deselect=test/plugins/test_replaygain.py::TestReplayGainGstCli::test_cli_does_not_skip_wrong_tag_type
    --deselect=test/plugins/test_replaygain.py::TestReplayGainGstCli::test_cli_writes_only_r128_tags
    --deselect=test/plugins/test_replaygain.py::TestReplayGainGstCli::test_r128_targetlevel_has_effect
  )
  pytest "${pytest_args[@]}"
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # shell completions
  install -Dm 644 "$srcdir/beet" -t "${pkgdir}"/usr/share/bash-completion/completions/
  install -Dm 644 extra/_beet -t "${pkgdir}"/usr/share/zsh/site-functions/

  # license
  install -Dm 644 LICENSE -t "${pkgdir}"/usr/share/licenses/beets/
}

