# Maintainer: Peter Jung <ptr1337@archlinux.org>
# Contributor: Rafael Dominiquini <rafaeldominiquini at gmail dot com>

pkgname=bazaar
pkgver=0.9.8
pkgrel=1
pkgdesc="A fast and modern store for GNOME with focus on Flatpaks, particularly from Flathub"
arch=(x86_64)
url="https://apps.gnome.org/Bazaar/"
license=(GPL-3.0-or-later)
groups=(gnome-circle)
depends=(
  appstream
  cairo
  dbus
  dconf
  flatpak
  glib2
  glibc
  glycin
  glycin-gtk4
  graphene
  gtk4
  gtksourceview5
  hicolor-icon-theme
  json-glib
  libadwaita
  libdex
  libgcc
  libmalcontent
  libproxy
  libsecret
  libsoup3
  libxmlb
  libyaml
  md4c
  pango
  systemd-libs
  webkitgtk-6.0
)
makedepends=(
  blueprint-compiler
  git
  glib2-devel
  meson
  ninja
  python-babel
  vala
)
source=("git+https://gitlab.gnome.org/World/bazaar.git#tag=v${pkgver}")
b2sums=('acdf22d76dbc15eafcb0205ef1452a2445572374e7004470fbb3166f20de84099e494bb1fbe4e8f8939405822754349ef55e32bbc7b70c9725e987bcc94958cb')

prepare() {
  cd $pkgname
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() (
  meson test -C build --print-errorlogs
)

package() {
  meson install -C build --destdir "$pkgdir"
}
