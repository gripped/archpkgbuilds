# Maintainer: Peter Jung <ptr1337@archlinux.org>
# Contributor: Rafael Dominiquini <rafaeldominiquini at gmail dot com>

pkgname=bazaar
pkgver=0.9.7
pkgrel=1
pkgdesc="A fast and modern store for GNOME with focus on Flatpaks, particularly from Flathub"
arch=(x86_64)
url="https://apps.gnome.org/Bazaar/"
license=(GPL-3.0-or-later)
groups=(gnome-circle)
depends=(
  appstream
  cairo
  dbus
  dconf
  flatpak
  glib2
  glibc
  glycin
  glycin-gtk4
  graphene
  gtk4
  gtksourceview5
  hicolor-icon-theme
  json-glib
  libadwaita
  libdex
  libgcc
  libmalcontent
  libproxy
  libsecret
  libsoup3
  libxmlb
  libyaml
  md4c
  pango
  systemd-libs
  webkitgtk-6.0
)
makedepends=(
  blueprint-compiler
  git
  glib2-devel
  meson
  ninja
  python-babel
  vala
)
source=("git+https://gitlab.gnome.org/World/bazaar.git#tag=v${pkgver}")
b2sums=('995cc8af0c4c13c658e88e085e6b0b7249fb5631f91e28445312fb885a1cd45afd95103aa3435a278cc75d476ef7635dc4cd2f71f1fb5506372494faf8d6d7c6')

prepare() {
  cd $pkgname

  # Fix build
  git cherry-pick -n 4a54d688ff3bd8b2c7f357a03d5b6bd3f3c973ed
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() (
  meson test -C build --print-errorlogs
)

package() {
  meson install -C build --destdir "$pkgdir"
}
