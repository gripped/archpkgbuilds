# Maintainer: Peter Jung <ptr1337@archlinux.org>
# Contributor: Rafael Dominiquini <rafaeldominiquini at gmail dot com>

pkgname=bazaar
pkgver=0.9.6
pkgrel=1
pkgdesc="A fast and modern store for GNOME with focus on Flatpaks, particularly from Flathub"
arch=(x86_64)
url="https://apps.gnome.org/Bazaar/"
license=(GPL-3.0-or-later)
groups=(gnome-circle)
depends=(
  appstream
  cairo
  dbus
  dconf
  flatpak
  glib2
  glibc
  glycin
  glycin-gtk4
  graphene
  gtk4
  gtksourceview5
  hicolor-icon-theme
  json-glib
  libadwaita
  libdex
  libgcc
  libmalcontent
  libproxy
  libsecret
  libsoup3
  libxmlb
  libyaml
  md4c
  pango
  systemd-libs
  webkitgtk-6.0
)
makedepends=(
  blueprint-compiler
  git
  glib2-devel
  meson
  ninja
  python-babel
  vala
)
source=("git+https://gitlab.gnome.org/World/bazaar.git#tag=v${pkgver}")
b2sums=(c59f71121eb5d1f527fd9a0883fee049e476c06068eccd0801aad695f1af2a3f687d9f4d1c2bcaccc67798a5e0eefcb8e8b1b5399d3c90c890e3cb9b0c2c44d0)

prepare() {
  cd $pkgname

  # Fix build
  git cherry-pick -n 4a54d688ff3bd8b2c7f357a03d5b6bd3f3c973ed
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() (
  meson test -C build --print-errorlogs
)

package() {
  meson install -C build --destdir "$pkgdir"
}
