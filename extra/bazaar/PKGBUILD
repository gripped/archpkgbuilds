# Maintainer: Peter Jung <ptr1337@archlinux.org>
# Contributor: Rafael Dominiquini <rafaeldominiquini at gmail dot com>

pkgname=bazaar
pkgver=0.9.4
pkgrel=4
pkgdesc="A fast and modern store for GNOME with focus on Flatpaks, particularly from Flathub"
arch=(x86_64)
url="https://apps.gnome.org/Bazaar/"
license=(GPL-3.0-or-later)
groups=(gnome-circle)
depends=(
  appstream
  cairo
  dconf
  flatpak
  glib2
  glibc
  glycin
  glycin-gtk4
  graphene
  gtk4
  gtksourceview5
  hicolor-icon-theme
  json-glib
  libadwaita
  libatomic
  libgcc
  libmalcontent
  libproxy
  libsecret
  libsoup3
  liburing
  libxmlb
  libyaml
  md4c
  pango
  systemd-libs
  webkitgtk-6.0
)
makedepends=(
  blueprint-compiler
  git
  glib2-devel
  meson
  ninja
  python-babel
)
source=(
  "git+https://gitlab.gnome.org/World/bazaar.git#tag=v${pkgver}"
  git+https://gitlab.gnome.org/GNOME/libdex.git
)
b2sums=(
  25d0cdd9fab5ae2ec1c50f1cc0179b7e07b6a3f86e3452da0ee20084966a44bfe89597721074c303e432967c5b11c5d3eb18ec46bb8489204260d55955e2f15e
  SKIP
)

prepare() {
  ln -s "$srcdir/libdex" "$pkgname/subprojects/libdex"
  meson subprojects checkout --sourcedir $pkgname
}

build() {
  arch-meson $pkgname build \
    -Dlibdex:default_library=static \
    -Dlibdex:docs=false \
    -Dlibdex:examples=false \
    -Dlibdex:gdbus=disabled \
    -Dlibdex:introspection=disabled \
    -Dlibdex:pygobject=false \
    -Dlibdex:tests=false \
    -Dlibdex:vapi=false
  meson compile -C build
}

check() (
  meson test -C build --print-errorlogs
)

package() {
  meson install -C build --destdir "$pkgdir"
  rm -r "${pkgdir}"/usr/include/libdex-1
  rm "${pkgdir}"/usr/lib/libdex-1.a
  rm "${pkgdir}"/usr/lib/pkgconfig/libdex-1.pc
}
