# Maintainer: Peter Jung <ptr1337@archlinux.org>
# Contributor: Rafael Dominiquini <rafaeldominiquini at gmail dot com>

pkgname=bazaar
pkgver=0.9.4
pkgrel=1
pkgdesc="A new app store for GNOME with focus on flatpaks, particularly Flathub"
arch=('x86_64')
url="https://github.com/kolunmi/bazaar"
license=(GPL-3.0-only)
depends=(
  glibc
  libgcc
  glib2
  gtk4
  glycin-gtk4
  json-glib
  glycin
  cairo
  pango
  graphene
  gtksourceview5
  flatpak
  appstream
  dconf
  md4c
  webkitgtk-6.0
  hicolor-icon-theme
  libadwaita
  libdex
  libheif
  libxmlb
  libyaml
  libsoup3
  libsecret
  libproxy
  libmalcontent
  malcontent
)
makedepends=(
  meson
  ninja
  gcc
  pkgconf
  git
  glib2-devel
  gobject-introspection
  python-babel
  blueprint-compiler
  vala
)
optdepends=('krunner-bazaar: krunner integration')

source=(git+https://github.com/kolunmi/bazaar#tag=v${pkgver})
sha256sums=('74aad31514c18c06d93ea3936b7be51e15336c2095732bdd51083026402ee93d')

build() {
  cd "${pkgname}"

  meson setup build --prefix=/usr
  ninja -C build
}

package() {
  cd "${pkgname}"

  DESTDIR="${pkgdir}" ninja -C build install
}
