# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=antimicrox
pkgver=3.6.0
pkgrel=1
pkgdesc='Graphical program used to map keyboard buttons & mouse controls to a gamepad'
arch=(x86_64)
url='https://github.com/AntiMicroX/antimicrox'
license=(GPL-3.0-only)
depends=(
  glibc
  hicolor-icon-theme
  libxtst
  libxi
  libx11
  libgcc
  libstdc++
  sdl2-compat
  qt6-base
)
makedepends=(
  git
  cmake
  extra-cmake-modules
  ninja
  itstool
  qt6-tools
)
source=("$pkgname::git+$url#tag=$pkgver")
sha512sums=('87f6f26cf80c4b3f169d75634374add5ed2c913e98e1c6fca0fff3e60c92eae23c69e1520a532a6f3f201dbc06b1134262da34dbce014b583628fbd57897a4e7')
b2sums=('f20f171e51ec650340ac48d67cfd11c5a789fb0fdc5b384e1c70e364d1b05c87229a9e447a8b28bdc41ae722e5e14d6692101329df6fea08ee28b3f8be8f278d')

build() {
  local cmake_options=(
    -B build
    -S "$pkgname"
    -W no-dev
    -G Ninja
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D ANTIMICROX_PKG_VERSION="$pkgver"
    -D USE_QT6_BY_DEFAULT=ON
  )

  cmake "${cmake_options[@]}"

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
