[Unit]
Description=Shairport Sync - AirPlay Audio Receiver
After=sound.target

[Service]
ExecStartPre=/usr/bin/systemctl is-active -q avahi-daemon.service
ExecStartPre=/usr/bin/systemctl is-active -q nqptp.service
ExecStart=/usr/bin/shairport-sync --log-to-syslog
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
