# Maintainer: Giovanni Harting <anonfunc@archlinux.org>
# Contributor: Corey Hinshaw <corey(at)electrickite(dot)org>

pkgname=batsignal
pkgver=1.8.0
pkgrel=3
pkgdesc='A lightweight battery monitor daemon'
arch=(x86_64)
url="https://github.com/electrickite/$pkgname"
license=(ISC)
depends=(glibc libnotify)
makedepends=(git)
source=("git+$url#tag=$pkgver"
        "$pkgname-signal-handler.patch::$url/commit/92a1982011adec7f093ba11d440cddb459701efa.patch")
b2sums=('c04719a5f568897b5ef5362abf4ab946d17a1514e0ed4c147b59a55b508b0eb46bc81faadf528762c0db04046ff9b44577e2c984e412ca43ba8103a36cd7e36f'
        '5ae00a50db085c6ce0149f675cbcbe184ec6b05b762bdeb773936b4bda6d74c95001199bf9fbafb46e1c1b661e9c94e3918991c56d24346679b703f044c7d2e3')

prepare() {
  cd $pkgname
  patch -Np1 -i ../$pkgname-signal-handler.patch
}

build() {
  cd $pkgname
  # upstream LDFLAGS_EXTRA=-s strips the binary before makepkg can split debug info
  make LDFLAGS_EXTRA=
}

package() {
  cd $pkgname
  make PREFIX=/usr DESTDIR="$pkgdir" install-service

  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

