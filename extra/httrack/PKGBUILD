pkgname=httrack
pkgver=3.50.0
pkgrel=1
pkgdesc="An easy-to-use offline browser utility"
arch=('x86_64')
url="https://www.httrack.com/"
license=('GPL-3.0-or-later')
depends=('bash' 'xdg-utils' 'hicolor-icon-theme' 'openssl')
source=(https://github.com/xroche/${pkgname}/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.gz{,.asc})
validpgpkeys=('BB71C7E6CB1AD8FAF53FE42A60C3AA7180598EFB') # Xavier Roche
sha256sums=('8d86694cc84cf25c00fc544c090c3c0605102be9b30020f28533ab3c4f7008fe'
            'SKIP')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure --prefix=/usr --enable-static=no
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
