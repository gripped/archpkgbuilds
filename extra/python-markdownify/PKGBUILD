# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-markdownify
pkgver=1.2.4
pkgrel=1
pkgdesc='Convert HTML to Markdown'
arch=(any)
url='https://github.com/matthewwithanm/python-markdownify'
license=(MIT)
depends=(
  python
  python-beautifulsoup4
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=$pkgver")
sha512sums=('5555066348f992b5e0ba97aded8c49646586f954aebde3e1c9dc807083d17dbf0ea5322b7a5772765954d10db13a3929d5743f67bb6d38ea9d2d8f626c28aabc')
b2sums=('695ac2dccc282aa9a82271915e52ceffddd0a0814aaaee7cd058c754a0b0cf60822f9ad036e7a4c68d195c424628f085d5ce63e9e3ad2514f5152ac10eba6a16')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
