# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-webadmin
_pkgname=stalwart-webui
pkgver=1.0.4
pkgrel=1
pkgdesc='Web UI for Stalwart'
arch=(any)
url='https://github.com/stalwartlabs/webui'
license=(AGPL-3.0-only)
makedepends=(git npm)
source=("$_pkgname::git+$url#tag=v$pkgver")
sha512sums=('fed57fcca7645e7ba7772ed1064256e5886800279efd1915e6ee5573b11ea1bb5559ba2ab521ca30e2b994bcbdd43b245635ccd5f9efe24ef148da0601d09c9c')
b2sums=('e95ee059da2b3e7c0f515b3a97e0a4a79e81f7caff037b651950ed77feb0018eec7ba232fd114d2060bedf9b9745a310e127e7c44e35a1a65874c89bb1f571ff')

prepare() {
  cd "$_pkgname"

  # install dev dependencies
  npm install --include=dev
}

build() {
  cd "$_pkgname"

  npm run build

  bsdtar --directory dist --auto-compress --create --file webui.zip .
}

package() {
  cd "$_pkgname"

  install -vDm644 -t "$pkgdir/usr/share/stalwart" webui.zip
}
