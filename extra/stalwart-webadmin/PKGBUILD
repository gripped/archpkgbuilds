# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-webadmin
_pkgname=stalwart-webui
pkgver=1.0.10
pkgrel=1
pkgdesc='Web UI for Stalwart'
arch=(any)
url='https://github.com/stalwartlabs/webui'
license=(AGPL-3.0-only)
makedepends=(git npm zip)
source=("$_pkgname::git+$url#tag=v$pkgver")
sha512sums=('bbd0bd161b4975e72a90adf8215e4765b0ca86eb338610bd68d496e81002b5091466c2b1a88ff47033ec230267f2b870090b67bbadb9f9ef8a4085f58215f211')
b2sums=('61067bfdfba6246cadf8a15e1aa4550a7ae12347df7b6bc244149adbb8fb88e942185f9c630fc9d3a2503c1ee3a2d28c5469d940fd7d328c323e5fb0711cf797')

prepare() {
  cd "$_pkgname"

  # install dev dependencies
  npm install --include=dev
}

build() {
  cd "$_pkgname"

  npm run build

  cd dist
  zip -r ../webui.zip .
}

package() {
  cd "$_pkgname"

  install -vDm644 -t "$pkgdir/usr/share/stalwart" webui.zip
}
