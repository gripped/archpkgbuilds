# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-webadmin
_pkgname=stalwart-webui
pkgver=1.0.8
pkgrel=1
pkgdesc='Web UI for Stalwart'
arch=(any)
url='https://github.com/stalwartlabs/webui'
license=(AGPL-3.0-only)
makedepends=(git npm zip)
source=("$_pkgname::git+$url#tag=v$pkgver")
sha512sums=('40fc8eccc8c1502909a365e09671e536a647221566e60cac580bac02ad55b5cad483a623e7e07a10034376c57f204834aa8870bd94a2928521dc477c9ffc1ab8')
b2sums=('2ec55647a1c8187cfbd0d4105472c921565958ef8fcb6c3897cf49afda91214886415a956112c8ae2362ddd88a127371d8938ae97041a67c3bb307e026561d58')

prepare() {
  cd "$_pkgname"

  # install dev dependencies
  npm install --include=dev
}

build() {
  cd "$_pkgname"

  npm run build

  cd dist
  zip -r ../webui.zip .
}

package() {
  cd "$_pkgname"

  install -vDm644 -t "$pkgdir/usr/share/stalwart" webui.zip
}
