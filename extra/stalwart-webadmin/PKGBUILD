pkgname=stalwart-webadmin
_pkgname=stalwart-webui
pkgver=1.0.9
pkgrel=1
pkgdesc='Web UI for Stalwart'
arch=(any)
url='https://github.com/stalwartlabs/webui'
license=(AGPL-3.0-only)
makedepends=(git npm zip)
source=("$_pkgname::git+$url#tag=v$pkgver")
sha512sums=('44d5b12bb72f7657b911eafc8b64882e256772f44c8ea2226422a89d57593519e533ffc03919f01e61c0e0de441f1c0836be2143780005893f6f098ae37b3a14')
b2sums=('ffaaff5eb6ea0e2cdb99774d0af6317ec3cbe2b19fb4798102bbccdbe6465481a11eb88bfaf93cc72abbf4f6b7a12f392adb3ec0bb3dd86b22f516aac4cd31de')

prepare() {
  cd "$_pkgname"

  # install dev dependencies
  npm install --include=dev
}

build() {
  cd "$_pkgname"

  npm run build

  cd dist
  zip -r ../webui.zip .
}

package() {
  cd "$_pkgname"

  install -vDm644 -t "$pkgdir/usr/share/stalwart" webui.zip
}
