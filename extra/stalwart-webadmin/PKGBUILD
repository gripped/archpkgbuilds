# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-webadmin
pkgver=0.1.37
pkgrel=1
pkgdesc='Web-admin WASM blob for Stalwart'
arch=(any)
url='https://github.com/stalwartlabs/webadmin'
license=(AGPL-3.0-only)
makedepends=(
  git
  trunk
  npm
  rustup
  python
)
_stalwart_ver=0.15.5
source=(
  "$pkgname::git+$url#tag=v$pkgver"
  "stalwart-${_stalwart_ver}-ossify.py::https://raw.githubusercontent.com/stalwartlabs/stalwart/refs/tags/v${_stalwart_ver}/resources/scripts/ossify.py"
)
sha512sums=('af1ec30bd52bcbaa8ad8460355ca733e998a6dc67bcd904b8a389959c5ad8ef5ce2311fa5f1ac830f6653a1b48b8ca43af29f532200052ca542a9d078b0f94bf'
            'ce438abc41e164f40b026ecf91491896836fc1d8ac5719a352592e25c4da751cea8cfb521bb8a8df1e882d654c8a471076405969a9059fd93584c0f34de09181')
b2sums=('df3e97c80e702926a12e0e29a97117cc5de2cd314ac235b70d402feda6f63c5939ccb1159addcb4d1e43f0713ae29078111b50c7eea2cdabe9004d0b6865109c'
        '147128ddf06764501d08f5340d678e476a62a438edc0afafed47ba9e0d77b0737bbdf9b34f013758e4bf3f7d29eaddf87c193a6fa70a1c27f873e91d39ca163f')

prepare() {
  cd "$pkgname"

  # ensure proprietary code is removed
  # https://github.com/stalwartlabs/stalwart/issues/783
  # https://github.com/stalwartlabs/stalwart/issues/768
  python "$srcdir/stalwart-${_stalwart_ver}-ossify.py" src

  # stable toolchain
  export RUSTUP_TOOLCHAIN=stable

  # add wasm target
  rustup target add wasm32-unknown-unknown

  # install dev dependencies
  npm install --include=dev
}

build() {
  cd "$pkgname"

  # creates fully OSS blob
  # https://github.com/stalwartlabs/webadmin/commit/f037d0e70cf049d74138552485bf22f7788d31ac
  trunk build --release --no-default-features

  bsdtar --directory dist --auto-compress --create --file webadmin.zip .
}

package() {
  cd "$pkgname"

  install -vDm644 -t "$pkgdir/usr/share/$pkgname" webadmin.zip
}
