# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-webadmin
_pkgname=stalwart-webui
pkgver=1.0.3
pkgrel=1
pkgdesc='Web UI for Stalwart'
arch=(any)
url='https://github.com/stalwartlabs/webui'
license=(AGPL-3.0-only)
makedepends=(git npm)
source=("$_pkgname::git+$url#tag=v$pkgver")
sha512sums=('c79f7871487043892e65dbb3c0a8cdf8597f6269d2e7d65645e92301dbba89c92a7c44db613d2fa30500f8d6dd00bf3dfba6c03d94859c1b476717c9366331ab')
b2sums=('16c48107575ecd1218bbbb0e96eab645a8cf10a27e7c6a512b1525222425c88a3adcded81f4d3ae18f242b1e1be68591939fb5867107876f6bd971a3d4eb5f1d')

prepare() {
  cd "$_pkgname"

  # install dev dependencies
  npm install --include=dev
}

build() {
  cd "$_pkgname"

  npm run build

  bsdtar --directory dist --auto-compress --create --file webui.zip .
}

package() {
  cd "$_pkgname"

  install -vDm644 -t "$pkgdir/usr/share/stalwart" webui.zip
}
