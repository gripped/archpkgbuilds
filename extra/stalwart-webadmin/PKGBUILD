# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-webadmin
_pkgname=stalwart-webui
pkgver=2.0.0
pkgrel=1
pkgdesc='Web UI for Stalwart'
arch=(any)
url='https://github.com/stalwartlabs/webui'
license=(AGPL-3.0-only)
makedepends=(git npm zip)
source=("$_pkgname::git+$url#tag=v$pkgver")
sha512sums=('ff4cc5a993d716bd06f019be00274e6a3eb3134be30c7c8b20c5b581292c2180b7d8a3ab1bed3fc8e2596fb10b79a00fbca51b884b5d363eea4285e7f5150cb7')
b2sums=('c9cbaa53e2552a4ebdc9336a202894c90afbd4ea2ec02cc01c7a9baf0b8c65cb32554d7ed3f64f0351515df3fc15ecd9f00b4d6814545904225b67b5089b3f8f')

prepare() {
  cd "$_pkgname"

  # install dev dependencies
  npm install --include=dev
}

build() {
  cd "$_pkgname"

  npm run build

  cd dist
  zip -r ../webui.zip .
}

package() {
  cd "$_pkgname"

  install -vDm644 -t "$pkgdir/usr/share/stalwart" webui.zip
}
