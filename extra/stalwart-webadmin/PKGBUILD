pkgname=stalwart-webadmin
_pkgname=stalwart-webui
pkgver=1.0.5
pkgrel=1
pkgdesc='Web UI for Stalwart'
arch=(any)
url='https://github.com/stalwartlabs/webui'
license=(AGPL-3.0-only)
makedepends=(git npm zip)
source=("$_pkgname::git+$url#tag=v$pkgver")
sha512sums=('0ad2d90996937a785506675e8ffcc068b09232b919f0ff9c86e72e22e48d05baff18f7b2cce073195f99f4047df95fa136e43d35001df0116b774dddf0586c18')
b2sums=('a8aadf65a18f636ca18586dd2d90b4a9b3d8c3494684aad9cc6efaadd59160677e8faa041873493d6bb5036381864a61a99e0fd81004f9b4a16dc0bfea9ad73f')

prepare() {
  cd "$_pkgname"

  # install dev dependencies
  npm install --include=dev
}

build() {
  cd "$_pkgname"

  npm run build

  cd dist
  zip -r ../webui.zip .
}

package() {
  cd "$_pkgname"

  install -vDm644 -t "$pkgdir/usr/share/stalwart" webui.zip
}
