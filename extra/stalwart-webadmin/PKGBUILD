# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-webadmin
_pkgname=stalwart-webui
pkgver=2.1.1
pkgrel=1
pkgdesc='Web UI for Stalwart'
arch=(any)
url='https://github.com/stalwartlabs/webui'
license=(AGPL-3.0-only)
makedepends=(git npm zip)
source=("$_pkgname::git+$url#tag=v$pkgver")
sha512sums=('e274a16edbe6b4305508c0a6cf70acacc71eb29a06e46a0f278e4c0752749d8266efb011fda51b1e29914b71c3b81d3d123f853b321e2fac9fd489a4589504ae')
b2sums=('05d9536857c3e56d82979ba3413dead1505803bf32f6fe718ea8cfe9b088ee7b67a47b154ae94063041a8c6e7702d67bfaf903247e17a0b8b4ff5aad729aeab5')

prepare() {
  cd "$_pkgname"

  # install dev dependencies
  npm install --include=dev
}

build() {
  cd "$_pkgname"

  npm run build

  cd dist
  zip -r ../webui.zip .
}

package() {
  cd "$_pkgname"

  install -vDm644 -t "$pkgdir/usr/share/stalwart" webui.zip
}
