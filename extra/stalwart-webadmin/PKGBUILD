# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-webadmin
_pkgname=stalwart-webui
pkgver=1.0.6
pkgrel=1
pkgdesc='Web UI for Stalwart'
arch=(any)
url='https://github.com/stalwartlabs/webui'
license=(AGPL-3.0-only)
makedepends=(git npm zip)
source=("$_pkgname::git+$url#tag=v$pkgver")
sha512sums=('ad05bfff84b4e244abc5df7fe9d25d4ad7dcb056a62bbe9e36b89b131bc079809170c59c923a6dbad3d851931bedda3b314188dd9472d5645f7a7d862e0626ab')
b2sums=('7fe81ee2c570a89b9f467644b6fce0b144804f5310f250809c00d55118e66d59f652b3fa95246f1517f0dade1b353da80886c1765afc21b2c61f4431b13dccc5')

prepare() {
  cd "$_pkgname"

  # install dev dependencies
  npm install --include=dev
}

build() {
  cd "$_pkgname"

  npm run build

  cd dist
  zip -r ../webui.zip .
}

package() {
  cd "$_pkgname"

  install -vDm644 -t "$pkgdir/usr/share/stalwart" webui.zip
}
