# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=klevernotes
pkgver=1.3.0
pkgrel=1
pkgdesc='Note-taking and management application using markdown'
arch=(x86_64)
url='https://apps.kde.org/klevernotes/'
license=(GPL-3.0-or-later)
depends=(
  glibc
  hicolor-icon-theme
  kcolorscheme
  kconfig
  kcoreaddons
  ki18n
  kiconthemes
  kio
  kirigami
  kirigami-addons
  kitemmodels
  libstdc++
  qqc2-desktop-style
  qt6-base
  qt6-declarative
  qt6-webchannel
  qt6-webengine
)
makedepends=(
  cmake
  extra-cmake-modules
  git
  ninja
)
source=("git+https://invent.kde.org/office/klevernotes.git?signed#tag=v$pkgver")
b2sums=(7ab7d52da46b397783ce9b0e41622373d8c7b5c6378b6937d4f9ad6a2ecc592cdacfe3bd12a9741900bfc8d12de177c6a86d0b20abd3b9a9f9c70c8a10b0c075)
validpgpkeys=(311DA4D94B93A7AEA0496DAF5F812C367AC0A802) # Louis Schul <schul9louis@gmail.com>

build() {
  cmake -S $pkgname -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_BUILD_TYPE=None
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  rm -r "$pkgdir"/usr/include/md4qt \
        "$pkgdir"/usr/lib/cmake/md4qt \
        "$pkgdir"/usr/lib/libmd4qt.a
}
