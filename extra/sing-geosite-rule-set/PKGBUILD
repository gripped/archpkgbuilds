# Maintainer: DeepChirp <deepchirp@archlinux.org>
# Contributor: everyx <lunt.luo#gmail.com>

pkgname=sing-geosite-rule-set
_pkgname=sing-geosite
pkgver=20260929143633
pkgrel=1
pkgdesc="Geosite Rule Sets for sing-box"
arch=('any')
url="https://github.com/SagerNet/${_pkgname}"
license=('GPL-3.0-or-later')
makedepends=('go')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz"
        "dlc-${pkgver}.dat::https://github.com/v2fly/domain-list-community/releases/download/${pkgver}/dlc.dat"
        "0001-build-support-local-dlc.dat-input.patch")
sha256sums=('0517b42ecf8f4555fc4825eaa62698a0cc975033b8046b7b88109c15e2e00831'
            '3dec90fda8a5c1f987c438e0d415066204bc5dd57cf32e02cb7d520f782f5348'
            '2e87be2a85577d5b83417e02876fb69588bbe47c7de6e89c7617bff9ffd478f1')

prepare() {
    cd "${srcdir}/${_pkgname}-${pkgver}"
    patch -Np1 -i "${srcdir}/0001-build-support-local-dlc.dat-input.patch"
    export GOPATH="${srcdir}"
    go mod download -modcacherw
}

build() {
    cd "${srcdir}/${_pkgname}-${pkgver}"
    export GOPATH="${srcdir}"
    go run -v . -dlc "${srcdir}/dlc-${pkgver}.dat"
}

package() {
    cd "${srcdir}/${_pkgname}-${pkgver}"
    install -Dm644 ./rule-set/*.srs -t "${pkgdir}/usr/share/sing-box/rule-set"
}
