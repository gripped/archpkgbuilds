# Maintainer: Dan Johansen <strit@archlinux.org>
# Contributor: Jelle van der Waa <jelle@archlinux.org>

pkgname=libgmobile
pkgver=0.7.0
pkgrel=1
pkgdesc='Functions useful in mobile related, glib based projects'
arch=(x86_64)
url='https://gitlab.gnome.org/World/Phosh/gmobile'
license=('LGPL-2.1-or-later AND GPL-3.0-or-later')
depends=(
  libgcc
  glib2
  glibc
  json-glib
)
makedepends=(
  gi-docgen
  git
  gobject-introspection
  meson
  python-docutils
  vala
)
source=("git+https://gitlab.gnome.org/World/Phosh/gmobile.git?signed#tag=v$pkgver")
b2sums=('312ba5bcfe22625637ade4943c5316c7905091de588ab1cbf6a46729592e47748b9db2cf69093d1c6e88b731cd7a6c4d8f2af54692763d09b62c15cac12c0fee')
validpgpkeys=(0DB3932762F78E592F6522AFBB5A2C77584122D3) # Guido Günther <guido@xcpu.ch>

build() {
  arch-meson gmobile build \
    -D gtk_doc=true \
    -D man=true
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
