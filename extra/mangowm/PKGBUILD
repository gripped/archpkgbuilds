# Maintainer: Robin Candau <antiz@archlinux.org>
# Contributor: Matt Quintanilla <matt @ matt quintanilla .xyz>
pkgname=mangowm
_pkgname=mango
pkgver=0.17.4
pkgrel=2
pkgdesc="Lightweight, feature rich modern wayland compositor"
url="https://mangowm.github.io"
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('glibc' 'wayland-protocols' 'pango' 'wayland' 'libinput' 'libdrm' 'cairo'
         'pixman' 'libdisplay-info' 'libliftoff' 'seatd' 'xorg-xwayland' 'glib2'
         'libxcb' 'libxkbcommon' 'pcre2' 'wlroots0.20' 'scenefx' 'cjson' 'xcb-util-wm')
makedepends=('meson')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/mangowm/mango/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('0891dc5650cf4b7daf0298ce9c188f7ff81792d872c1396febba022635d68c8e')

build() {
	arch-meson "${_pkgname}-${pkgver}" build
	meson compile -C build
}

check() {
	meson test -C build --print-errorlogs
}

package() {
	meson install -C build --destdir "${pkgdir}"
}
