# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-mcp
pkgver=1.30.0
pkgrel=1
pkgdesc='Model Context Protocol SDK'
arch=(any)
url='https://github.com/modelcontextprotocol/python-sdk'
license=(MIT)
depends=(
  python
  python-anyio
  python-dotenv
  python-httpx
  python-httpx-sse
  python-jsonschema
  python-pydantic
  python-pydantic-settings
  python-pyjwt
  python-python-multipart
  python-sse-starlette
  python-starlette
  python-typer
  python-typing-inspection
  python-typing_extensions
  uvicorn
)
makedepends=(
  git
  python-build
  python-hatchling
  python-installer
  python-uv-dynamic-versioning
)
checkdepends=(
  python-dirty-equals
  python-inline-snapshot
  python-pytest
  python-pytest-examples
  python-pytest-xdist
  python-requests
  python-websockets
  ruff
  uv
)
optdepends=(
  'python-rich: rich logging support'
  'python-websockets: deprecated websocket transport support'
)
source=("git+https://github.com/modelcontextprotocol/python-sdk.git#tag=v$pkgver")
b2sums=('f6cc562ac57eab4a4a1748d7c52a9d659432b019303ecf92e95b671af301245861d10488293ce6935df4bb946115b38f0d76e4ae8833528332d29750d2a1429d')

prepare() {
  cd python-sdk
  # uv may take longer than the hardcoded subprocess timeout while creating its
  # transient environment in a clean build.
  sed -i 's/, timeout=20//' tests/client/test_config.py
}

build() {
  cd python-sdk
  python -m build --wheel --no-isolation
}

check() {
  cd python-sdk
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd python-sdk
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
