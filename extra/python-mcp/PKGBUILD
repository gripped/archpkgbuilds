# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgbase=python-mcp
pkgname=(python-mcp python-mcp-types)
pkgver=2.3.0
pkgrel=2
arch=(any)
url='https://github.com/modelcontextprotocol/python-sdk'
license=(MIT)
depends=(
  python
  python-anyio
  python-cryptography
  python-dotenv
  python-httpx2
  python-jsonschema
  python-opentelemetry-api
  python-pydantic
  python-pyjwt
  python-python-multipart
  python-sse-starlette
  python-starlette
  python-typer
  python-typing-inspection
  python-typing_extensions
  uvicorn
)
makedepends=(
  git
  python-build
  python-hatchling
  python-installer
  python-uv-dynamic-versioning
)
checkdepends=(
  python-blockbuster
  python-coverage
  python-dirty-equals
  python-griffelib
  python-inline-snapshot
  python-logfire-sdk
  python-opentelemetry-sdk
  python-pytest
  python-pytest-examples
  python-pytest-xdist
  python-trio
  python-yaml
  ruff
)
source=("git+https://github.com/modelcontextprotocol/python-sdk.git#tag=v$pkgver")
b2sums=('13a48f64e4347a2def79cb2e7bfd834da2ac8418db5deb625d9c572ed7d55dcc7ae255b14d0123fb59bd39408f32b2fa8a06b46dd5ef6bd8dad5dbc676a25bbe')

build() {
  cd python-sdk
  python -m build --wheel --no-isolation
  cd src/mcp-types
  python -m build --wheel --no-isolation
}

check() {
  cd python-sdk
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl src/mcp-types/dist/*.whl
  # Translation-tool tests require the unpackaged Zensical module.
  PYTHONPATH="$PWD/examples" test-env/bin/python -m pytest \
    --ignore tests/docs/test_translations.py
}

package_python-mcp() {
  pkgdesc='Model Context Protocol SDK'
  depends+=(python-mcp-types)
  optdepends=('python-rich: rich logging support')

  cd python-sdk
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_python-mcp-types() {
  pkgdesc='Model Context Protocol wire types'
  depends=(
    python
    python-pydantic
    python-typing_extensions
  )

  cd python-sdk/src/mcp-types
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 ../../LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
