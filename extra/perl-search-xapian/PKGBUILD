_pkg="Search-Xapian"
pkgname='perl-search-xapian'
pkgver=1.2.25.6
pkgrel=1
pkgdesc="Perl XS frontend to the Xapian C++ search library."
arch=('x86_64')
url='https://metacpan.org/release/Search-Xapian'
license=('Artistic-1.0-Perl' 'GPL-1.0-or-later')
options=('!emptydirs')
depends=('perl' 'perl-devel-leak' 'xapian-core')
source=("https://search.cpan.org/CPAN/authors/id/O/OL/OLLY/Search-Xapian-$pkgver.tar.gz")
sha512sums=('875e16692ce58c231e236a50c873bd296420981b0b3c56efc5470d28e7ea3ea917b3211adb0a74977cb93dcfad59f22b980e9cb7bf70d699a8339afb2f2eb8bd')

build() {
  cd "$_pkg-${pkgver}"
  export PERL_MM_USE_DEFAULT=1 PERL_AUTOINSTALL=--skipdeps
  perl Makefile.PL
  make
}

check() {
  cd "$_pkg-${pkgver}"
  export PERL_MM_USE_DEFAULT=1 PERL5LIB=""
  make test
}

package() {
  cd "$_pkg-${pkgver}"
  make INSTALLDIRS=vendor DESTDIR="$pkgdir" install
}
