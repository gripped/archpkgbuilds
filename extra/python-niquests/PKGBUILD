# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-niquests
pkgver=3.21.3
pkgrel=1
pkgdesc="HTTP client with synchronous and asynchronous APIs"
arch=('any')
url="https://github.com/jawah/niquests"
license=('Apache-2.0' 'MIT')
depends=('python' 'python-charset-normalizer' 'python-urllib3-future' 'python-wassima')
makedepends=('git' 'python-build' 'python-hatchling' 'python-installer')
checkdepends=(
  'python-aiofiles'
  'python-brotli'
  'python-coverage'
  'python-cryptography'
  'python-fastapi'
  'python-flask'
  'python-pytest'
  'python-pytest-asyncio'
  'python-pytest-httpbin'
  'python-python-socks'
  'python-trustme'
  'python-websockets'
  'python-wsproto'
)
optdepends=('python-orjson: faster JSON decoding')
source=("git+https://github.com/jawah/niquests.git#tag=v$pkgver")
sha256sums=('ae4be9321d46f1d062a677732fe86ade38fb4d77709125ef18117da087b3e7c4')

prepare() {
  cd niquests
  # Avoid Werkzeug rejecting the redirect: https://github.com/psf/requests/pull/6700
  sed -i 's|http://localhost:-1|http://:1|' tests/test_requests.py
}

build() {
  cd niquests
  python -m build --wheel --no-isolation
}

check() {
  cd niquests
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  # An unset asyncio fixture loop scope triggers a fatal deprecation warning.
  # The Unix socket tests require a running Docker daemon at /var/run/docker.sock.
  test-env/bin/python -m pytest -o asyncio_default_fixture_loop_scope=function \
    --ignore=tests/test_unixsocket.py
}

package() {
  cd niquests
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 src/niquests/_vendor/kiss_headers/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.kiss_headers"
}
