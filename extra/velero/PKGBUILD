# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>

pkgname=velero
pkgver=1.18.0
pkgrel=2
pkgdesc="Backup and migrate Kubernetes applications and their persistent volumes"
arch=(x86_64)
url="https://velero.io"
license=(Apache-2.0)
depends=(
  glibc
  kubectl
)
makedepends=(
  git
  go
)
# we cannot use LTO as otherwise we do not get reproducible package with full RELRO
options=('!lto')
source=("git+https://github.com/vmware-tanzu/velero#tag=v$pkgver")
b2sums=('dc77de3f4c9aa5b6c57774948fba2ac2ce27ff6bf660efaaff21b50ee2836f15948e6e265980bcdd95dccd79883b587a5fd7698ea06486c3dc789e5b8c1c79ee')

prepare() {
  cd $pkgname

  # create folder for build output
  mkdir build

  # download dependencies
  GOPATH="$srcdir" go mod download -modcacherw
}

build() {
  cd $pkgname

  # set flags for cgo
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"

  # set GOPATH so makepkg puts source files into the debug package
  export GOPATH="$srcdir"

  # set project flags
  local _pkg=github.com/vmware-tanzu/velero
  local _ldflags=""
  _ldflags+=" -X $_pkg/pkg/buildinfo.Version=v$pkgver"
  _ldflags+=" -X $_pkg/pkg/buildinfo.ImageRegistry=velero"
  _ldflags+=" -X $_pkg/pkg/buildinfo.GitSHA=$(git rev-parse HEAD)"
  _ldflags+=" -X $_pkg/pkg/buildinfo.GitTreeState=clean"

  go build -v \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-compressdwarf=false -linkmode external $_ldflags" \
    -o build ./cmd/velero
}

package() {
  cd $pkgname

  # binary
  install -vDm 755 build/$pkgname -t "$pkgdir"/usr/bin

  # generate shell completions
  build/$pkgname completion bash | install -vDm 644 /dev/stdin "$pkgdir"/usr/share/bash-completion/completions/$pkgname.bash
  build/$pkgname completion fish | install -vDm 644 /dev/stdin "$pkgdir"/usr/share/fish/vendor_completions.d/$pkgname.fish
  build/$pkgname completion zsh  | install -vDm 644 /dev/stdin "$pkgdir"/usr/share/zsh/site-functions/_$pkgname

  # documentation
  install -vDm 644 README.md -t "$pkgdir"/usr/share/doc/$pkgname/
  cp -arv examples "$pkgdir"/usr/share/doc/$pkgname/
}
