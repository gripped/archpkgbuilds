prepare() {
  cd "$pkgbase"

  # ftbfs: non-existent file introduced in
  # 5a0a63b2f4d1a5d148b9f9ed562656857dec0ee4
  patch -p1 -i "$srcdir/ftbfs-non-existent-file.patch"

  # prepare git submodule(s)
  git submodule init
  git config submodule.libs/JUCE.url "$srcdir/github.com-juce-framework-JUCE"
  git config submodule.libs/clap-juce-extensions.url "$srcdir/github.com-free-audio-clap-juce-extensions"
  git -c protocol.file.allow=always submodule update --init

  pushd libs/clap-juce-extensions
  git submodule init
  git config submodule.clap-libs/clap.url "$srcdir/github.com-free-audio-clap"
  git config submodule.clap-libs/clap-helpers.url "$srcdir/github.com-free-audio-clap-helpers"
  git -c protocol.file.allow=always submodule update --init
  popd
}

build() {
  local cmake_options=(
    -B build
    -S "$pkgbase"
    -G Ninja
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX=/usr
    -W no-dev
    -D KR106_COPY_AFTER_BUILD=OFF
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

package_ultramaster-kr106-vst3() {
  pkgdesc+=' - VST3 plugin'
  groups+=(vst3-plugins)
  depends=(
    "${_common_depends[@]}"
    vst3-host
  )

  install -vd "$pkgdir/usr/lib/vst3"
  cp -vr build/KR106_artefacts/Release/VST3/Ultramaster\ KR-106.vst3 "$pkgdir/usr/lib/vst3"
}

package_ultramaster-kr106-lv2() {
  pkgdesc+=' - LV2 plugin'
  groups+=(lv2-plugins)
  depends=(
    "${_common_depends[@]}"
    lv2-host
  )

  install -vd "$pkgdir/usr/lib/lv2"
  cp -vr build/KR106_artefacts/Release/LV2/* "$pkgdir/usr/lib/lv2"
}

package_ultramaster-kr106-clap() {
  pkgdesc+=' - CLAP plugin'
  groups+=(clap-plugins)
  depends=(
    "${_common_depends[@]}"
    clap-host
  )

  install -vDm644 -t "$pkgdir/usr/lib/clap" build/KR106_artefacts/Release/CLAP/*.clap
}
