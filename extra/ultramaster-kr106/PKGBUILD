# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgbase=ultramaster-kr106
pkgname=(
  ultramaster-kr106-vst3
  ultramaster-kr106-lv2
)
pkgver=2.1.7
pkgrel=1
pkgdesc='A virtual analog synthesizer inspired by the classic Roland Juno polysynths'
arch=(x86_64)
url='https://kayrock.org/kr106/'
license=(GPL-3.0-only)
groups=(pro-audio)
_common_depends=(
  glibc
  libgcc
  libstdc++
  alsa-lib
  fontconfig
  freetype2
)
makedepends=(
  "${_common_depends[@]}"
  git
  cmake
  ninja
  libx11
  libxrandr
  libxinerama
  libxcursor
  jack
)
source=(
  "$pkgbase::git+https://github.com/kayrockscreenprinting/ultramaster_kr106#tag=v$pkgver"
  'github.com-juce-framework-JUCE::git+https://github.com/juce-framework/JUCE'
  no-copy-plugin.patch
)
sha512sums=('f0e09926f7052b5d1fabb4e852150ae91d4c98dcfe27e17366f1153d1f68d16ae9e52ad961d2685e263b47cffd150966e1bf44139b7e850e0b4e01948f5e4d6d'
            'SKIP'
            '9bdaeaebb3a1a53c1614efb6c11b73992339f529add1784caf3ff88288c41e90774117b094927aac935b150135278294102a883428dd558a424d62cedc55a16c')
b2sums=('85e0139f632ade0cf2079c887e1c4157eeb69793c2c30c4af7b558a926956dc42d5cfc5add406ebadf4cd66c92ea9c0719a9e4e64f1901c531faa76eebc2d488'
        'SKIP'
        '59225cca8ed887eec616f0ddb2880b17582fb5b6c2bd0909513c3ca8ef36c53debf8bfb42cd78dd6564f2873a917c77a422e43908c6bf64e7f47c2ff37910a40')

prepare() {
  cd "$pkgbase"

  # prepare git submodule(s)
  git submodule init
  git config submodule.libs/JUCE.url "$srcdir/github.com-juce-framework-JUCE"
  git -c protocol.file.allow=always submodule update --init

  # don't copy plugin after build
  patch -p1 -i "$srcdir/no-copy-plugin.patch"
}

build() {
  local cmake_options=(
    -B build
    -S "$pkgbase"
    -G Ninja
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX=/usr
    -W no-dev
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

package_ultramaster-kr106-vst3() {
  pkgdesc+=' - VST3 plugin'
  groups+=(vst3-plugins)
  depends=(
    "${_common_depends[@]}"
    vst3-host
  )

  install -vd "$pkgdir/usr/lib/vst3"
  cp -vr build/KR106_artefacts/Release/VST3/Ultramaster\ KR-106.vst3 "$pkgdir/usr/lib/vst3"
}

package_ultramaster-kr106-lv2() {
  pkgdesc+=' - LV2 plugin'
  groups+=(lv2-plugins)
  depends=(
    "${_common_depends[@]}"
    lv2-host
  )

  install -vd "$pkgdir/usr/lib/lv2"
  cp -vr build/KR106_artefacts/Release/LV2/* "$pkgdir/usr/lib/lv2"
}
