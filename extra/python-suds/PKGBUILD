# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Jonathan Liu <net147@gmail.com>

pkgname=python-suds
pkgver=1.4.4.1
pkgrel=1
pkgdesc="A lightweight SOAP python client"
arch=('any')
url="https://github.com/cackharot/suds-py3"
license=('LGPL-3.0-or-later')
depends=('python')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("git+https://github.com/cackharot/suds-py3.git#tag=v$pkgver")
sha512sums=('9d8ee96027658f52e9043ef567222908a7ffca711a9156d6b89d18283dc52ca120da28f33066f34f262b33f5cb9bb2c21cd86c4a4c58dbd54cbb2d01f42bb2a8')

build() {
  cd suds-py3
  python -m build --wheel --no-isolation
}

check() {
  cd suds-py3
  ./run_tests.sh
}

package() {
  cd suds-py3
  python -m installer --destdir="$pkgdir" dist/*.whl
}

