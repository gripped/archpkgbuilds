# Maintainer: Frederik Schwan <freswa at archlinux dot org>
# Contributor: Dario Ostuni <dario.ostuni@gmail.com>

pkgname=wasmtime
pkgver=49.0.2
pkgrel=1
pkgdesc='Standalone JIT-style runtime for WebAssembly, using Cranelift'
arch=('x86_64')
url='https://github.com/bytecodealliance/wasmtime'
license=('Apache-2.0')
depends=('glibc' 'libgcc')
makedepends=('cargo' 'cmake' 'git')
options=('!lto')
source=(
  "git+https://github.com/bytecodealliance/wasmtime#commit=v${pkgver}"
  git+https://github.com/WebAssembly/testsuite
  git+https://github.com/WebAssembly/component-model
  git+https://github.com/WebAssembly/wasi-testsuite
)
b2sums=('9a40faf41fe2779108795a7506fd902051d78a66a4322a897f7f553068f25f0c88d358d4d2732de69d1cb5cc6be2240f89983db8883e238d1bd3725ef80f07d8'
        'SKIP'
        'SKIP'
        'SKIP')

# Use debug
export CARGO_PROFILE_RELEASE_DEBUG=2 CARGO_PROFILE_RELEASE_STRIP=false

# Use LTO
export CARGO_PROFILE_RELEASE_LTO=true CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1

prepare() {
  cd ${pkgname}
  git submodule init
  git submodule set-url tests/spec_testsuite "${srcdir}"/testsuite
  git submodule set-url tests/wasi-testsuite "${srcdir}"/wasi-testsuite
  git submodule set-url tests/component-model "${srcdir}"/component-model
  git -c protocol.file.allow=always -c protocol.allow=never submodule update
  cargo fetch --locked --target host-tuple
}

build() {
  cd ${pkgname}
  cargo build --release --frozen
}

package() {
  cd ${pkgname}
  install -Dm755 target/release/${pkgname} "${pkgdir}"/usr/bin/$pkgname
}
