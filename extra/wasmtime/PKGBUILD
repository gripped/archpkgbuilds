# Maintainer: Frederik Schwan <freswa at archlinux dot org>
# Contributor: Dario Ostuni <dario.ostuni@gmail.com>

pkgname=wasmtime
pkgver=45.0.2
pkgrel=2
pkgdesc='Standalone JIT-style runtime for WebAssembly, using Cranelift'
arch=('x86_64')
url='https://github.com/bytecodealliance/wasmtime'
license=('Apache-2.0')
depends=('glibc' 'libgcc')
makedepends=('cargo' 'cmake' 'git')
options=('!lto')
source=("git+https://github.com/bytecodealliance/wasmtime#commit=v${pkgver}"
        wasm-component-model::git+https://github.com/WebAssembly/component-model
        wasm-testsuite::git+https://github.com/WebAssembly/testsuite
        git+https://github.com/WebAssembly/wasi-testsuite
        git+https://github.com/WebAssembly/wasi-threads)
b2sums=('c1651f32e6e157533fd3bc7a0a449da8c621fa442bdd116af79d3bb0c23cc711648de34617c82437ea6647c7eaa97e39600a35f2b369d7fff4568b7ccb3338a9'
        'SKIP'
        'SKIP'
        'SKIP'
        'SKIP')

# Use debug
export CARGO_PROFILE_RELEASE_DEBUG=2 CARGO_PROFILE_RELEASE_STRIP=false

# Use LTO
export CARGO_PROFILE_RELEASE_LTO=true CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1

prepare() {
  cd ${pkgname}
  git submodule init
  git submodule set-url tests/component-model "${srcdir}"/wasm-component-model
  git submodule set-url tests/spec_testsuite "${srcdir}"/wasm-testsuite
  git submodule set-url tests/wasi_testsuite/wasi-common "${srcdir}"/wasi-testsuite
  git submodule set-url tests/wasi_testsuite/wasi-threads "${srcdir}"/wasi-threads
  git -c protocol.file.allow=always -c protocol.allow=never submodule update
  cargo fetch --locked --target host-tuple
}

build() {
  cd ${pkgname}
  cargo build --release --frozen
}

package() {
  cd ${pkgname}
  install -Dm755 target/release/${pkgname} "${pkgdir}"/usr/bin/$pkgname
}
