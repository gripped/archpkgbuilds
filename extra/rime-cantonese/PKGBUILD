# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=rime-cantonese
pkgver=0.0.0.20250901
pkgrel=1
pkgdesc="Cantonese input for rime"
arch=('x86_64')
url="https://github.com/rime/rime-cantonese"
license=('CC-BY-4.0' 'ODbL-1.0')
# dependency for reverse lookup
depends=('rime-cangjie' 'rime-emoji' 'rime-loengfan' 'rime-luna-pinyin' 'rime-stroke')
makedepends=('git' 'librime' 'rime-prelude' 'rime-essay')
source=("git+https://github.com/rime/rime-cantonese.git#commit=fc9da7968403d5514f74d78faf523ef177dc1b6a")
sha512sums=('7c6b1b9e61a9effb144213aaca4bb0fe62c8beef4e52ed945f6f89dfe9bb4f5955da3ebc3a9903dbd34e582abcb0fea52614b4fe170ecae9f6d2f55405ca1e6b')

prepare() {
  cd $pkgname
  # Remove the license-incompatible dictionary: https://github.com/rime/rime-cantonese/pull/212
  git cherry-pick -n fa0db4d2014abdbf0e1b8eab2131cb89715c1aa9

  # Link essentials
  for _f in $(pacman -Qql rime-prelude rime-essay | grep -v "/$"); do ln -sf $_f; done
}

build(){
  cd $pkgname
  for _s in $(ls *.schema.yaml); do rime_deployer --compile $_s; done
}

package() {
  cd $pkgname
  find . -type l -delete
  rm build/*.txt
  install -Dm644 *.txt *.yaml -t "$pkgdir"/usr/share/rime-data/
  install -Dm644 build/* -t "$pkgdir"/usr/share/rime-data/build/
  install -Dm644 opencc/* -t "$pkgdir"/usr/share/rime-data/opencc/
}
