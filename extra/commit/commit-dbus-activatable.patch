index 1f7edbd..e1507d3 100644
--- a/src/welcome.js
+++ b/src/welcome.js
@@ -21,8 +21,14 @@ export default function Welcome({ application }) {
 
   const objects = { spin_hint, spin_wrap, switch_capitalize_title };
