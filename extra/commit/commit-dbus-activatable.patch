 data/re.sonny.Commit.desktop |  1 +
 data/re.sonny.Commit.service |  3 +++
 src/CommitEditor.js          |  8 +++++++-
 src/application.js           | 17 +++++++++++++----
 src/editor.js                | 12 ++++++------
 src/welcome.js               |  8 +++++++-
 src/window.blp               |  2 +-
 src/window.js                | 25 ++++++++++++++++++++-----
 9 files changed, 68 insertions(+), 18 deletions(-)
 create mode 100644 data/re.sonny.Commit.service

