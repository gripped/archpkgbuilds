# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=xdg-desktop-portal-dde
pkgver=1.0.14
pkgrel=1
pkgdesc='A backend implementation for xdg-desktop-portal on Deepin desktop environment'
arch=('x86_64')
url="https://github.com/linuxdeepin/xdg-desktop-portal-dde"
license=('LGPL-3.0-or-later')
depends=('dtk6core' 'dtk6declarative' 'dtk6widget' 'qt6-base' 'qt6-declarative' 'wayland'
         'glibc' 'libgcc' 'libstdc++' 'libdrm' 'libpipewire' 'mesa' 'xdg-desktop-portal')
makedepends=('git' 'cmake' 'ninja' 'python' 'libdrm' 'libpipewire' 'mesa' 'qt6-declarative' 'qt6-tools'
             'treeland-protocols' 'wayland-protocols' 'wlr-protocols' 'dtk6declarative')
provides=(xdg-desktop-portal-impl)
groups=('deepin')
source=("git+https://github.com/linuxdeepin/xdg-desktop-portal-dde.git#tag=$pkgver")
sha512sums=('aa62015ca78ec94a1f391201ef587f330ed4c4dd928884b2fe31c6ef82572d55d442ff8dac63d2f7b3da09bdab537983bced3301ccc2e016c0b1fa7ab932b387')

prepare() {
  cd xdg-desktop-portal-dde
  sed -i 's|lrelease|/usr/lib/qt6/bin/lrelease|' misc/translations/translate_generation.sh
  sed -i 's/find_package(Qt6 COMPONENTS REQUIRED Core DBus WaylandClient WaylandScannerTools Quick)/find_package(Qt6 COMPONENTS REQUIRED Core DBus GuiPrivate Quick WaylandClient WaylandClientPrivate WaylandScannerTools)/' src/wayland/CMakeLists.txt
}

build() {
  cd xdg-desktop-portal-dde
  cmake . -GNinja -DCMAKE_INSTALL_LIBEXECDIR=lib
  ninja
}

package() {
  cd xdg-desktop-portal-dde
  DESTDIR="$pkgdir" ninja install
}
