# Maintainer: Maxime Gauduin <alucryd@archlinux.org>
# Contributor: Gustavo Alvarez <sl1pkn07@gmail.com>

pkgname=vapoursynth-plugin-mvtools
pkgver=26
pkgrel=1
pkgdesc='MVTools plugin for VapourSynth'
arch=(x86_64)
url=https://github.com/dubhater/vapoursynth-mvtools
license=(GPL2)
depends=(
  fftw
  vapoursynth
)
makedepends=(
  git
  meson-python
  nasm
  python-build
  python-installer
)
_tag=c8d83aa3a385c1d60accf9e1cc2b1e7940b865b6
source=(git+https://github.com/dubhater/vapoursynth-mvtools.git#tag=${_tag})
sha256sums=('00a0d5d60c7214ddc98710824041cf617940695ca720448ebd5bd284639a2b35')

prepare() {
  cd vapoursynth-mvtools
  sed 's|vapoursynth/include|/usr/include/vapoursynth|g' -i meson.build
  sed 's/VSHelper.h/VSHelper4.h/g; s/vs_bitblt/vsh::bitblt/g' -i src/MVFrame.cpp -i src/SimpleResize.cpp
}

pkgver() {
  cd vapoursynth-mvtools
  git describe --tags | sed 's/^v//'
}

build() {
  cd vapoursynth-mvtools
  python -m build --wheel --no-isolation
}

package(){
  python -m installer --destdir="$pkgdir" vapoursynth-mvtools/dist/*.whl
}

