Subject: [PATCH] rsa: guard engine support when unavailable in OpenSSL

OpenSSL 4 removes the ENGINE API symbols, so compiling the engine paths
unconditionally leaves the image tools with unresolved references. Keep
PEM key signing available and reject explicit engine requests with ENOTSUP
when the linked OpenSSL does not support engines.

Adapted from Quentin Schulz's engine guards and error handling in the
openssl-providers development branch, without the provider API migration:
https://git.u-boot-project.org/u-boot/custodians/u-boot-rockchip/-/commit/e22f1de551e8577904cd97866b2d08e047d603d5
https://git.u-boot-project.org/u-boot/custodians/u-boot-rockchip/-/commit/56134e354d071f837f4ed914b3e00f6aa9f92a52

Upstream discussion:
https://patchwork.ozlabs.org/comment/3707210/

diff --git a/lib/rsa/rsa-sign.c b/lib/rsa/rsa-sign.c
index 0e38c9e802f..083c597a96d 100644
--- a/lib/rsa/rsa-sign.c
+++ b/lib/rsa/rsa-sign.c
@@ -19,7 +19,11 @@
 #include <openssl/err.h>
 #include <openssl/ssl.h>
 #include <openssl/evp.h>
+#if OPENSSL_VERSION_NUMBER < 0x40000000L && \
+    !defined(OPENSSL_NO_ENGINE) && !defined(OPENSSL_NO_DEPRECATED_3_0)
+#define OSSL_ENGINE_SUPPORTED
 #include <openssl/engine.h>
+#endif
 
 static int rsa_err(const char *msg)
 {
@@ -101,6 +105,7 @@ err_cert:
 static int rsa_engine_get_pub_key(const char *keydir, const char *name,
 				  ENGINE *engine, EVP_PKEY **evpp)
 {
+#ifdef OSSL_ENGINE_SUPPORTED
 	const char *engine_id;
 	char key_id[1024];
 	EVP_PKEY *key = NULL;
@@ -156,6 +161,10 @@ static int rsa_engine_get_pub_key(const char *keydir, const char *name,
 	*evpp = key;
 
 	return 0;
+#else
+	fprintf(stderr, "rsa-sign compiled without engine support\n");
+	return -ENOTSUP;
+#endif
 }
 
 /**
@@ -230,6 +239,7 @@ static int rsa_engine_get_priv_key(const char *keydir, const char *name,
 				   const char *keyfile,
 				   ENGINE *engine, EVP_PKEY **evpp)
 {
+#ifdef OSSL_ENGINE_SUPPORTED
 	const char *engine_id;
 	char key_id[1024];
 	EVP_PKEY *key = NULL;
@@ -292,6 +302,10 @@ static int rsa_engine_get_priv_key(const char *keydir, const char *name,
 	*evpp = key;
 
 	return 0;
+#else
+	fprintf(stderr, "rsa-sign compiled without engine support\n");
+	return -ENOTSUP;
+#endif
 }
 
 /**
@@ -327,6 +341,7 @@ static int rsa_init(void)
 
 static int rsa_engine_init(const char *engine_id, ENGINE **pe)
 {
+#ifdef OSSL_ENGINE_SUPPORTED
 	const char *key_pass;
 	ENGINE *e;
 	int ret;
@@ -371,14 +386,20 @@ err_set_rsa:
 err_engine_init:
 	ENGINE_free(e);
 	return ret;
+#else
+	fprintf(stderr, "rsa-sign compiled without engine support\n");
+	return -ENOTSUP;
+#endif
 }
 
 static void rsa_engine_remove(ENGINE *e)
 {
+#ifdef OSSL_ENGINE_SUPPORTED
 	if (e) {
 		ENGINE_finish(e);
 		ENGINE_free(e);
 	}
+#endif
 }
 
 static int rsa_sign_with_key(EVP_PKEY *pkey, struct padding_algo *padding_algo,
