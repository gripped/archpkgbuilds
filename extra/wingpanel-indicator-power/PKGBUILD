# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=wingpanel-indicator-power
pkgver=8.0.2
pkgrel=3
pkgdesc='Wingpanel Power Indicator'
arch=(x86_64)
url=https://github.com/elementary/wingpanel-indicator-power
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  dconf
  glib2
  glibc
  granite7
  gtk4
  libgee
  libnotify
  systemd-libs
  wingpanel
)
makedepends=(
  git
  libgtop
  meson
  vala
)
source=(git+https://github.com/elementary/wingpanel-indicator-power.git#tag=${pkgver})
b2sums=('ff919d21c82ebe36570b4bf4950686f08be8e86768925c72779bbb67c2386326e24f21f731216a1cac5f55c4688a25c1bd2a5cfa2f0243a24a310dbbd403e385')

prepare() {
  cd wingpanel-indicator-power

  # Update for GTK4 port
  git cherry-pick -n 8.0.2..65e97001da8b7e1bce42c66868c3ebb8594b564d

  # Update RDNN to io.elementary.panel.power
  # https://github.com/elementary/panel-power/pull/302
  git cherry-pick -n d59ea9c3da2be7f2235b8e67140a39bc60950c16
}

build() {
  arch-meson wingpanel-indicator-power build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}
