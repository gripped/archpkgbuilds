# Maintainer: Jonathan Grotelüschen <tippfehlr@archlinux.org>
# Contributor: A. Klitzing <aklitzing@gmail.com>

pkgname=ausweisapp
pkgver=2.6.0
pkgrel=2
pkgdesc="official client for using the German electronic ID card (eID)"
arch=('x86_64')
license=('EUPL-1.2')
url="https://www.ausweisapp.bund.de/"
depends=(
	'qt6-declarative' 'qt6-svg' 'qt6-websockets' 'qt6-scxml' 'pcsclite' 'llhttp'
	'hicolor-icon-theme' 'openssl' 'libstdc++' 'glibc' 'systemd-libs' 'qt6-base'
)
makedepends=('cmake' 'qt6-tools' 'ninja' 'pkgconf')
optdepends=(
	'ccid: driver for generic smart card readers'
	'acsccid: driver for ACS card readers'
	'pcsc-cyberjack: driver for CyberJack card readers'
)
source=(
	"https://github.com/Governikus/AusweisApp2/releases/download/${pkgver}/AusweisApp-${pkgver}.tar.gz"{,.asc}
	"2.6.0-disable-beta-testing-img.patch"
)
validpgpkeys=('699BF3055B0A49224EFDE7C72D7479A531451088')
sha256sums=('a82f2094621a4ab53db04adf63ac67c3109802963b8eff8a87f3bbb356f365ea'
            'SKIP'
            '89f8c59a707a9da648da32a9c40379043aff3b2ea2774561340799347345e218')

prepare() {
	cd "AusweisApp-$pkgver"

	# Disable beta-testing background (accidentally included in 2.6.0 release)
	# https://github.com/flathub/de.bund.ausweisapp.ausweisapp2/commit/0ffa6d3b966df4cd225b01ac92eedd776424867a
	patch -Np1 -i ../2.6.0-disable-beta-testing-img.patch
}

build() {
	local cmake_options=(
		-B build
		-S AusweisApp-$pkgver
		-G Ninja
		-DCMAKE_BUILD_TYPE=MinSizeRel # "None" is not supported
		-DCMAKE_INSTALL_PREFIX=/usr
	)
	cmake "${cmake_options[@]}"
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 AusweisApp-${pkgver}/LICENSE.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
