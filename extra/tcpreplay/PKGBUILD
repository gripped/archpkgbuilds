pkgname=tcpreplay
pkgver=4.6.2
pkgrel=1
pkgdesc='Gives the ability to replay previously captured traffic in a libpcap format'
url='https://tcpreplay.appneta.com'
arch=('x86_64')
license=('GPL-3.0-only')
depends=(
  'glibc'
  'libdnet'
  'libpcap'
)
makedepends=('tcpdump')
optdepends=('tcpdump: decoding of packets support')
options=('!emptydirs')
source=(https://github.com/appneta/tcpreplay/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz{,.asc})
sha512sums=('a195a716da5ac2137b6e9a12e98352dbd52e3eea66fa312d8faf1adad6c148782e511b3ae6ba12e55ad0d64acd96da4091b755ef38db0cc3c65444a511c29599'
            'SKIP')
b2sums=('fc8483a9d8381049939ae1e62ccf16c9e48fe6e17b5ba0c1dd83acaeabca632a232c72dd345c99072c063f1dd30679bb7b3875b8ee619759c703bd1113ccc59f'
        'SKIP')
validpgpkeys=('84E4FA215C934A7D97DC76D5E9E2149793BDE17E') # Fred Klassen <tcpreplay@appneta.com>

prepare() {
  cd ${pkgname}-${pkgver}
  autoreconf -fiv
}

build() {
  cd ${pkgname}-${pkgver}
  export CFLAGS="$CFLAGS -std=gnu99"
  ./configure \
    --prefix=/usr \
    --disable-local-libopts \
    --enable-dynamic-link \
    --enable-shared \
    --with-libdnet \
    --with-tcpdump=/usr/bin/tcpdump \
    ac_cv_header_net_bpf_h=n
  make
}

check() {
  cd ${pkgname}-${pkgver}
  make -j1 -C test tcpprep
}

package() {
  cd ${pkgname}-${pkgver}
  make DESTDIR="${pkgdir}" install
}

