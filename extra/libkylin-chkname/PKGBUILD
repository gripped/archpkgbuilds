# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=libkylin-chkname
pkgver=1.0.10
pkgrel=1
pkgdesc="Library for validating user names"
arch=('x86_64')
license=('MulanPSL-2.0')
url="https://gitee.com/openkylin/libkylin-chkname"
depends=('glibc')
makedepends=('git')
source=("git+https://gitee.com/openkylin/libkylin-chkname.git#tag=debian/$pkgver-1")
sha512sums=('7d663ffdf371b1218cc9abc3e668d3c3547b247f0d414be9f3f9d411624d6da40dfb0d9443c58c0be281a6f4c7d02df72ed5d7d1d701994f788c5f3ff860bdee')

prepare() {
  cd libkylin-chkname
  autoreconf -fi
}

build() {
  cd libkylin-chkname
  ./configure --prefix=/usr --disable-static
  make
}

package() {
  cd libkylin-chkname
  make DESTDIR="$pkgdir" install
  install -Dm644 reserved-names -t "$pkgdir/usr/share/kylin-chkname"
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
