# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: taotieren <admin@taotieren.com>

pkgname=linyaps-box
pkgver=2.3.2
pkgrel=1
pkgdesc='A simple OCI runtime mainly used by linyaps (linglong)'
arch=(x86_64)
url='https://github.com/OpenAtom-Linyaps/linyaps-box'
license=('LGPL-3.0-or-later')
provides=(
  linglong-box
)
depends=(
  fmt
  glibc
  libcap
  libseccomp
  libgcc
  libstdc++
  systemd-libs
)
makedepends=(
  cli11
  cmake
  git
  gtest
  ninja
  nlohmann-json
  pkgconf
)
source=("git+https://github.com/OpenAtom-Linyaps/linyaps-box.git#tag=$pkgver")
sha256sums=('7d30f08e2243fdb1d62d3ef4d981aa2a5706052a5cb3bd054d3e7535e33cc2a1')

build() {
  cd linyaps-box

  cmake -Dlinyaps-box_ENABLE_SECCOMP=ON \
    -Dlinyaps-box_OFFLINE_BUILD=ON \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev \
    -B build \
    -G Ninja
  ninja -C build
}

check() {
  ninja -C linyaps-box/build test
}

package() {
  cd linyaps-box
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
