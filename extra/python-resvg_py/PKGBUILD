# Maintainer: Giovanni Harting <anonfunc@archlinux.org>

pkgname=python-resvg_py
_name=resvg-py
pkgver=0.5.0
pkgrel=1
pkgdesc='Python bindings for the resvg SVG rendering library'
arch=(x86_64)
url='https://github.com/baseplate-admin/resvg-py'
license=(MIT)
depends=(
  glibc
  libgcc
  python
)
makedepends=(
  cargo
  python-build
  python-installer
  python-maturin
)
checkdepends=(python-pytest)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
b2sums=('bb6830f2d9a6506f9f142803fca27472b12f09d8897cf9b8c1dd1ddade3bfc545204f7b256f2a309c8e5e7a2c4bf7344dbaca39dc19d926d684280ae903e6189')

prepare() {
  cd $_name-$pkgver
  # no --target: maturin runs an unfiltered cargo metadata, which needs every platform's crates
  cargo fetch --locked
}

build() {
  cd $_name-$pkgver
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  # upstream's release profile strips the extension, which would leave the -debug package empty
  export CARGO_PROFILE_RELEASE_STRIP=false
  export MATURIN_PEP517_ARGS=--frozen
  python -m build --wheel --no-isolation
}

check() {
  cd $_name-$pkgver
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest tests
}

package() {
  cd $_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

# vim:set ts=2 sw=2 et:
