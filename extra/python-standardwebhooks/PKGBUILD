# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-standardwebhooks
pkgver=1.3.0
pkgrel=1
pkgdesc="Python library for verifying and signing Standard Webhooks"
arch=('any')
url="https://github.com/standard-webhooks/standard-webhooks"
license=('MIT')
depends=('python')
makedepends=('git' 'python-build' 'python-hatchling' 'python-installer')
checkdepends=('python-pytest')
source=("git+https://github.com/standard-webhooks/standard-webhooks.git#tag=v$pkgver")
b2sums=('ac44fc404754aaeaf8917bfe7c44377d4a32dce7a599f237ca8a1599554c600d8e8e24e20f00b8191244377e0a889249844e34d3b40cdd51cbc9e297598daf3c')

build() {
  cd standard-webhooks/libraries/python
  python -m build --wheel --no-isolation
}

check() {
  cd standard-webhooks/libraries/python
  python -m pytest
}

package() {
  cd standard-webhooks/libraries/python
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
