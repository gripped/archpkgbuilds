# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-wsgidav
pkgver=4.4.1
pkgrel=1
pkgdesc='Generic WebDAV server based on WSGI'
arch=(any)
url='https://github.com/mar10/wsgidav'
license=(MIT)
depends=(
  python
  python-defusedxml
  python-json5
  python-jinja
  python-passlib
  python-pyyaml
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-pytest
  python-cheroot
  python-requests
  python-webtest
)
optdepends=(
  'python-paste: WSGI server'
  'gunicorn: WSGI server'
  'python-cheroot: WSGI server'
  'python-gevent: WSGI server'
  'uvicorn: WSGI server'
  'mercurial: Mercurial WebDAV provider'
  'python-pymongo: MongoDB WebDAV provider'
  'python-mysqlclient: MySQL WebDAV provider'
  'python-pam: pam-login authentication'
  'python-lxml: performance improvements for PROPPATCH requests'
)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('cb6a30d5d44565b47cf170842fe4243a154a9366093b5948a4d5f8eb9070c753d258157ade4718eb0746b831c76abe2d08a9fea9611c992eadc0efb543d63219')
b2sums=('876f459f7e481db8caf47b4d103e22313911a0f9b1774bffc5974306680d3cf287cb8e67c0b2bcaa4327b1ea4c39bf9ab7ab907318933bf33232af35dc153477')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  # temporary install
  python -m installer --destdir="$(pwd)/tmp" dist/*.whl
  local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  export PYTHONPATH="$(pwd)/tmp/$site_packages"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md sample_wsgidav.yaml

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
