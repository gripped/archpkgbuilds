# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-indexed-zstd
pkgver=1.7.1
pkgrel=2
pkgdesc='Fast random access to zstd-compressed files'
arch=(x86_64)
url='https://github.com/martinellimarco/indexed_zstd'
license=('MIT OR GPL-3.0-only')
depends=(python zstd)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
  cython
)
checkdepends=(python-pytest)
source=(
  "$pkgname::git+$url#tag=v$pkgver"
  'github.com-martinellimarco-libzstd-seek::git+https://github.com/martinellimarco/libzstd-seek'
)
sha512sums=('fc76802b77454fe231cdb145c8a1962aa3f351becc0807d10c8069dede34ac222f5f040e8f2f4c89b3ae95453dd03377add4582ed080cc5ef1da977409bfd443'
            'SKIP')
b2sums=('515e115abba99670fb85787b8e77e55acdac3d313281b1d7c9d5546200a2633750da09599e5450dbf26a2339ee104b5e69d2ee9d9f1ea4690b208a6d7b6285a8'
        'SKIP')

prepare() {
  cd "$pkgname"

  # prepare git submodule(s)
  git submodule init
  git config submodule.indexed_zstd/libzstd-seek.url "$srcdir/github.com-martinellimarco-libzstd-seek"
  git -c protocol.file.allow=always submodule update --init
}

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

