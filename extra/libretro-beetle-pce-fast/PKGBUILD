pkgname=libretro-beetle-pce-fast
pkgver=20260828.151513.g2f623abd0332
pkgrel=1
pkgdesc='NEC PC Engine/CD core'
arch=(x86_64)
url=https://github.com/libretro/beetle-pce-fast-libretro
license=(GPL-2.0-only)
groups=(libretro)
depends=(
  glibc
  libgcc
  libretro-core-info
  libstdc++
  zlib
)
makedepends=(git)
source=(libretro-beetle-pce-fast::git+https://github.com/libretro/beetle-pce-fast-libretro.git#commit=${pkgver##*.g})
b2sums=('6ed3fe9ff6ec1101757c778e30c526e601860483ff5c6d63555a88a0134a57a5bfff23af33aa259b274b9034273ee164dbfd4617cce55cb86e45a47b1026f59a')

build() {
  make \
    SYSTEM_LIBCHDR=0 \
    SYSTEM_ZLIB=1 \
    -C libretro-beetle-pce-fast
}

package() {
  install -Dm 644 libretro-beetle-pce-fast/mednafen_pce_fast_libretro.so -t "${pkgdir}"/usr/lib/libretro/
}

