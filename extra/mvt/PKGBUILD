pkgname=mvt
pkgver=2026.9.21
pkgrel=1
pkgdesc="Mobile Verification Toolkit, a forensics tool looking for signs of device compromise"
arch=(any)
url="https://github.com/mvt-project/mvt"
license=(MVT-1.1)
depends=(
  'androidqf'
  'libusb'
  'python'
  'python-adb-shell'
  'python-appdirs'
  'python-betterproto2'
  'python-click'
  'python-cryptography'
  'python-dateutil'
  'python-fastpbkdf2'
  'python-iphone-backup-decrypt'
  'python-libusb1'
  'python-packaging'
  'python-pyahocorasick'
  'python-pycryptodome'
  'python-pydantic'
  'python-pydantic-settings'
  'python-requests'
  'python-rich'
  'python-simplejson'
  'python-tld'
  'python-tqdm'
  'python-yaml'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-setuptools-scm'
  'python-wheel'
)
source=("mvt-${pkgver}.tar.gz::https://github.com/mvt-project/mvt/archive/refs/tags/v${pkgver}.tar.gz")
sha512sums=('7ac4cf66247adcaa7c07725afe5c8571246e846e6f614ff9174befc71b9b6a286c174d3797603a6ab050fa9505db8c35575601a1c8a0fbfe1608bbdb0c03b879')
b2sums=('8f85df7e609aef48f62262862fddf0214328eae0420bcd0ab684c7335328a2f1cbe972fe25feac25b4ab4fab4bee572c536fb412e26a20a7cc88acfebdd427dc')

build() {
  cd "mvt-${pkgver}"
  export SETUPTOOLS_SCM_PRETEND_VERSION_FOR_MVT="${pkgver}"
  python -m build -wn

  # setup test environment here, because we also need it to generate shell completions
  local _site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  python -m installer --destdir=test_dir dist/*.whl

  # generate shell completions
  for shell in bash zsh fish; do
    PATH="test_dir/usr/bin:$PATH" PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH" mvt completion "${shell}" > "mvt-complete.${shell}"
  done
}

check() {
  cd "mvt-${pkgver}"

  # test_dir/ is already setup in build()
  local _site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  PATH="test_dir/usr/bin:$PATH" PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH" mvt --help
  PATH="test_dir/usr/bin:$PATH" PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH" mvt-android --help
  PATH="test_dir/usr/bin:$PATH" PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH" mvt-ios --help
}

package() {
  cd "mvt-${pkgver}"
  python -m installer -d "${pkgdir}" dist/*.whl

  local _py3_ver=$(python --version | cut -d " " -f2)
  rm -rf "${pkgdir}/usr/lib/python${_py3_ver%.*}/site-packages/tests"

  # shell completions
  install -vDm644 "mvt-complete.bash" "${pkgdir}/usr/share/bash-completion/completions/mvt"
  install -vDm644 "mvt-complete.zsh" "${pkgdir}/usr/share/zsh/site-functions/_mvt"
  install -vDm644 "mvt-complete.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/mvt.fish"

  # license and docs
  install -vDm644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
  install -vDm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

