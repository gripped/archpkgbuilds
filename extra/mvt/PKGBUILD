pkgname=mvt
pkgver=2026.7.29
pkgrel=1
pkgdesc="Mobile Verification Toolkit, a forensics tool looking for signs of device compromise"
arch=(any)
url="https://github.com/mvt-project/mvt"
license=(MVT-1.1)
depends=(
  'androidqf'
  'libusb'
  'python'
  'python-adb-shell'
  'python-appdirs'
  'python-betterproto2'
  'python-click'
  'python-cryptography'
  'python-dateutil'
  'python-iosbackup'
  'python-libusb1'
  'python-packaging'
  'python-pyahocorasick'
  'python-pydantic'
  'python-pydantic-settings'
  'python-requests'
  'python-rich'
  'python-simplejson'
  'python-tld'
  'python-tqdm'
  'python-yaml'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
source=("mvt-${pkgver}.tar.gz::https://github.com/mvt-project/mvt/archive/refs/tags/v${pkgver}.tar.gz")
sha512sums=('3592ab27e3fd311bc2480124b2e6bebe919419b23c4f598c45888702cd26386d99577d8df28b2a2058ad67bdb374df1e8b271cc402b699fe4f8297f09cb39ef0')
b2sums=('98f51c2a7108c512443d2ec278f21882f995b8844fb7fb87c1b9d3e8f3338723f00faf23f76f2c726dc353327f2d885cd27a0da0fbd7c1d850023da34614948d')

build() {
  cd "mvt-${pkgver}"
  python -m build -wn

  # setup test environment here, because we also need it to generate shell completions
  local _site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  python -m installer --destdir=test_dir dist/*.whl

  # generate shell completions
  for prog in mvt-android mvt-ios; do
    for shell in bash zsh fish; do
      PATH="test_dir/usr/bin:$PATH" PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH" "${prog}" completion "${shell}" > "${prog}-complete.${shell}"
    done
  done
}

check() {
  cd "mvt-${pkgver}"

  # test_dir/ is already setup in build()
  local _site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  PATH="test_dir/usr/bin:$PATH" PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH" mvt-android --help
  PATH="test_dir/usr/bin:$PATH" PYTHONPATH="test_dir/$_site_packages:$PYTHONPATH" mvt-ios --help
}

package() {
  cd "mvt-${pkgver}"
  python -m installer -d "${pkgdir}" dist/*.whl

  local _py3_ver=$(python --version | cut -d " " -f2)
  rm -rf "${pkgdir}/usr/lib/python${_py3_ver%.*}/site-packages/tests"

  # shell completions
  for prog in mvt-android mvt-ios; do
    install -vDm644 "${prog}-complete.bash" "${pkgdir}/usr/share/bash-completion/completions/${prog}"
    install -vDm644 "${prog}-complete.zsh" "${pkgdir}/usr/share/zsh/site-functions/_${prog}"
    install -vDm644 "${prog}-complete.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/${prog}.fish"
  done

  # license and docs
  install -vDm644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
  install -vDm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

