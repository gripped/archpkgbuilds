# Maintainer: Maxime Gauduin <alucryd@archlinux.org>
# Contributor: witchymary

pkgname=vapoursynth-plugin-bestsource
pkgver=R21
pkgrel=1
epoch=1
pkgdesc='BestSource plugin for VapourSynth'
arch=(x86_64)
url=https://github.com/vapoursynth/bestsource
license=(MIT)
depends=(
  libgcc
  libstdc++
  ffmpeg
  glibc
  vapoursynth
  xxhash
)
makedepends=(
  git
  meson-python
  python-build
  python-installer
)
source=(
  git+https://github.com/vapoursynth/bestsource.git#tag=${pkgver}
  #git+https://github.com/AviSynth/AviSynthPlus.git
  #git+https://github.com/sekrit-twc/libp2p.git
)
b2sums=('4ccad6308be78e194091d50af38aa64e08d79d2bed5614ff8a1ec6a4b8ac6ac7d4985cf4d70ea0ab911ae796a6dfca943604872d99c4b179f4d9ab91cd17ba57')

prepare() {
  cd bestsource
  meson subprojects download
  sed 's|vapoursynth/include|/usr/include/vapoursynth|g' -i meson.build
}

build() {
  cd bestsource
  python -m build --wheel --no-isolation -Csetup-args="--wrap-mode=nodownload"
}

package(){
  python -m installer --destdir="$pkgdir" bestsource/dist/*.whl
  install -Dm 644 bestsource/LICENSE -t "${pkgdir}"/usr/share/licenses/vapoursynth-plugin-bestsource/
}
