# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=dmtcp
pkgver=3.2.0
pkgrel=1
pkgdesc='Distributed MultiThreaded CheckPointing'
url='https://dmtcp.sourceforge.io'
arch=('x86_64')
license=('LGPL-3.0-or-later')
depends=('bash' 'glibc' 'libgcc' 'libstdc++')
makedepends=('git' 'dash' 'emacs' 'gdb' 'java-environment' 'openmpi' 'procps-ng'
'python' 'screen' 'strace' 'tcsh' 'vim' 'zsh')
source=("git+https://github.com/dmtcp/dmtcp.git#tag=$pkgver")
sha256sums=('7bd8cf94d1f8454e09a84f2aac52614d4ab6ed2c3d769237f7120129dddda771')
b2sums=('497232332d9b57002fa26c148a301aba3b154de2eb7697534eaadd9d9891386bf417a8211c4454ffe2e71e4aa9ca09731f81c9ad7a75abf0bbad82de151f7338')

build() {
  cd $pkgname
  CFLAGS="$CFLAGS -std=gnu17" ./configure \
    --prefix=/usr \
    --sysconfdir=/etc
  make
}

package() {
  make DESTDIR="$pkgdir" install -C $pkgname
}
