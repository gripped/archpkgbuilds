# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=dmtcp
pkgver=3.1.1
pkgrel=1
pkgdesc='Distributed MultiThreaded CheckPointing'
url='https://dmtcp.sourceforge.io'
arch=('x86_64')
license=('LGPL-3.0-or-later')
depends=('bash' 'glibc' 'libgcc' 'libstdc++')
makedepends=('git' 'dash' 'emacs' 'gdb' 'java-environment' 'openmpi' 'procps-ng'
'python' 'screen' 'strace' 'tcsh' 'vim' 'zsh')
source=("git+https://github.com/dmtcp/dmtcp.git#tag=v$pkgver")
sha256sums=('bb3279566db766c4abca50c9430dd729a0cbca4573b165bd9c482b010ebe7eec')
b2sums=('6e5e9b22d66e420fb761ab002ab613608e0a61f79e4e51aa793932171429baf8d11484ea4c3b865ccb163800024e1f8d480ad9033ce452af26e6fa10e379acc6')

build() {
  cd $pkgname
  CFLAGS="$CFLAGS -std=gnu17" ./configure \
    --prefix=/usr \
    --sysconfdir=/etc
  make
}

package() {
  make DESTDIR="$pkgdir" install -C $pkgname
}
