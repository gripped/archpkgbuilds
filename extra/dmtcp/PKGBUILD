# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=dmtcp
pkgver=3.0.0
pkgrel=1
pkgdesc='Distributed MultiThreaded CheckPointing'
url='http://dmtcp.sourceforge.net'
arch=('x86_64')
license=('LGPL-3.0-or-later')
depends=('bash' 'gcc-libs' 'glibc')
makedepends=('git' 'dash' 'emacs' 'gdb' 'java-environment' 'openmpi' 'procps-ng'
'python' 'screen' 'strace' 'tcsh' 'vim' 'zsh')
source=("git+https://github.com/dmtcp/dmtcp.git#tag=$pkgver")
sha256sums=('bcd0673e3312ead4d73a27a5e7765c93db5a4be529c6cd82f32f4c406adb3bf7')
b2sums=('f071ac850dd28d8cf43ff0425d6a57ce34acdf1d1fdf370a3e4f03b73f3eb7fa43a6d48a68fd0b75f38525d2aa976fb808bf2e45707ae5315564ad202ede1efc')

build() {
  cd $pkgname
  CFLAGS="$CFLAGS -std=gnu17" ./configure \
    --prefix=/usr \
    --sysconfdir=/etc
  make
}

package() {
  make DESTDIR="$pkgdir" install -C $pkgname
}
