# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=dmtcp
pkgver=3.1.0
pkgrel=1
pkgdesc='Distributed MultiThreaded CheckPointing'
url='https://dmtcp.sourceforge.io'
arch=('x86_64')
license=('LGPL-3.0-or-later')
depends=('bash' 'glibc' 'libgcc' 'libstdc++')
makedepends=('git' 'dash' 'emacs' 'gdb' 'java-environment' 'openmpi' 'procps-ng'
'python' 'screen' 'strace' 'tcsh' 'vim' 'zsh')
source=("git+https://github.com/dmtcp/dmtcp.git#tag=$pkgver")
sha256sums=('3f1abc15de15431a29530ee83edca96d06aa53c311e0501625c87779ca67bca5')
b2sums=('dd71358abf6b92e5c1ea9c7da2b0fb1c51e4c95b4ed35f1e99dfff052187fc176cf65dd5ef65aae002b3066e5fe3d290a51b260524a4499718a8b3d294aa9354')

build() {
  cd $pkgname
  CFLAGS="$CFLAGS -std=gnu17" ./configure \
    --prefix=/usr \
    --sysconfdir=/etc
  make
}

package() {
  make DESTDIR="$pkgdir" install -C $pkgname
}
