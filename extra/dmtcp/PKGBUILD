# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=dmtcp
pkgver=3.1.2
pkgrel=1
pkgdesc='Distributed MultiThreaded CheckPointing'
url='https://dmtcp.sourceforge.io'
arch=('x86_64')
license=('LGPL-3.0-or-later')
depends=('bash' 'glibc' 'libgcc' 'libstdc++')
makedepends=('git' 'dash' 'emacs' 'gdb' 'java-environment' 'openmpi' 'procps-ng'
'python' 'screen' 'strace' 'tcsh' 'vim' 'zsh')
source=("git+https://github.com/dmtcp/dmtcp.git#tag=v$pkgver")
sha256sums=('bd970f6e3910d56e970c513b0a9769c3b2163ab0e3791c814db7de57f9dc41fe')
b2sums=('76832e0d40dc62bd7cb638a3c1c4effecf75550af16f9da312c5bc990a3554f6db8edb6f16e097ded043a0be3929586520b6b705e48c47464d4bfc344cedc352')

build() {
  cd $pkgname
  CFLAGS="$CFLAGS -std=gnu17" ./configure \
    --prefix=/usr \
    --sysconfdir=/etc
  make
}

package() {
  make DESTDIR="$pkgdir" install -C $pkgname
}
