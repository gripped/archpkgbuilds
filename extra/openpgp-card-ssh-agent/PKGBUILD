# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=openpgp-card-ssh-agent
_name="${pkgname#openpgp-card-}"
pkgver=0.3.6
pkgrel=1
pkgdesc="A simple ssh-agent backed by OpenPGP card authentication keys"
arch=(x86_64)
url="https://codeberg.org/openpgp-card/ssh-agent/"
license=('Apache-2.0 OR MIT')
depends=(
  glibc
  libgcc
  org.freedesktop.secrets
)
makedepends=(
  dbus
  pcsclite
  rust
)
source=($pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz)
sha512sums=('d793ad194ec0386ae0d82cc719eecc410446f3fbd3d49c2c18a527acdd6ed197e03eeca3f5e3f114694ff544970cfd29851ac38b1026a67207ffbd0f0fea6127')
b2sums=('73666b38e7f6a524323769da3f3b3e745c57e0fec3f46bdf537c32b5dcc8a45d6f002f0f281bd86235f45e3deb06f3ead9f27edbc3262b5b1481d464037fc5d1')

prepare() {
  cd $_name
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $_name
  cargo build --frozen --release --all-features
}

check() {
  cd $_name
  cargo test --frozen --all-features
}

package() {
  depends+=(
    dbus libdbus-1.so
    pcsclite libpcsclite.so
  )

  cd $_name
  install -vDm 755 -t "$pkgdir/usr/bin/" "target/release/$pkgname"
  install -vDm 644 contrib/*.{service,socket} -t "$pkgdir/usr/lib/systemd/user/"
  install -vDm 644 LICENSES/*.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
