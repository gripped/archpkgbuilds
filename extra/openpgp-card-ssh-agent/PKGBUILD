# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=openpgp-card-ssh-agent
_name="${pkgname#openpgp-card-}"
pkgver=0.3.9
pkgrel=1
pkgdesc="A simple ssh-agent backed by OpenPGP card authentication keys"
arch=(x86_64)
url="https://codeberg.org/openpgp-card/ssh-agent/"
license=('Apache-2.0 OR MIT')
depends=(
  glibc
  libgcc
  org.freedesktop.secrets
)
makedepends=(
  dbus
  pcsclite
  rust
)
source=($pkgname-$pkgver.tar.gz::${url}archive/v${pkgver}.tar.gz)
sha512sums=('a54d6a70ce040dcb85a41323f3e3455ff794a929ccd0d650c834ac94db0e32538c50059bdb6b4902f7a53a76285c6b3cbe92e00f85d9fe7d7e88fd151bf4dc5f')
b2sums=('88837be775f18dfd7af0cb0ccdc4dc46ec2f99a71f6688a3defd1add1e61de70aff211b4af2c0f0abcf72709ad2abeef6e22f93ae8e40f21a451776c4cab4388')

prepare() {
  cd $_name
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $_name
  cargo build --frozen --release --all-features
}

check() {
  cd $_name
  cargo test --frozen --all-features
}

package() {
  depends+=(
    dbus libdbus-1.so
    pcsclite libpcsclite.so
  )

  cd $_name
  install -vDm 755 -t "$pkgdir/usr/bin/" "target/release/$pkgname"
  install -vDm 644 contrib/*.{service,socket} -t "$pkgdir/usr/lib/systemd/user/"
  install -vDm 644 LICENSES/*.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
