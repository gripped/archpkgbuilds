# Maintainer: Giovanni Harting <anonfunc@archlinux.org>

pkgname=cloud-sql-proxy
pkgver=2.28.1
pkgrel=1
pkgdesc='Proxy that authorizes and encrypts connections to Google Cloud SQL instances'
arch=(x86_64)
url='https://github.com/GoogleCloudPlatform/cloud-sql-proxy'
license=(Apache-2.0)
depends=(glibc)
makedepends=(git go)
# --fuse is refused unless fusermount is found, and fuse3 only ships fusermount3
checkdepends=(fuse2)
optdepends=('fuse2: mount a directory of instance sockets with --fuse')
source=("git+$url.git#tag=v$pkgver")
b2sums=('a05684c408288521a47f716d686dcd6b8afff81f4a5d91fc8b847343111afd162191a5406b2aedc1ff769139ec27f5821de07e6f1e701f26fe5b06cc7f3417ae')

prepare() {
  cd $pkgname
  export GOPATH="$srcdir"
  go mod download -modcacherw
}

build() {
  cd $pkgname

  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOPATH="$srcdir"
  go build \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-compressdwarf=false -linkmode external -buildid=''" \
    -o $pkgname
}

check() {
  cd $pkgname
  go test -short ./...
}

package() {
  cd $pkgname
  install -Dm755 $pkgname -t "$pkgdir"/usr/bin

  install -d "$pkgdir"/usr/share/{bash-completion/completions,zsh/site-functions,fish/vendor_completions.d}
  ./$pkgname completion bash > "$pkgdir"/usr/share/bash-completion/completions/$pkgname
  ./$pkgname completion zsh > "$pkgdir"/usr/share/zsh/site-functions/_$pkgname
  ./$pkgname completion fish > "$pkgdir"/usr/share/fish/vendor_completions.d/$pkgname.fish
}

# vim:set ts=2 sw=2 et:
