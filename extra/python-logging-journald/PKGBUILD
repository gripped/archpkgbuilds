# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-logging-journald
pkgver=0.6.12
pkgrel=1
pkgdesc="Pure Python logging handler for journald using the native protocol"
arch=('any')
url="https://github.com/mosquito/logging-journald"
license=('MIT')
depends=('python')
makedepends=('git' 'python-build' 'python-hatchling' 'python-installer')
checkdepends=('python-pytest')
source=("git+https://github.com/mosquito/logging-journald.git#tag=$pkgver")
b2sums=('197a7359247b1c243cb0136565d219958c843b538a72406f7c15cda9b5a954a98dda3803c6015b05d16443386eee0f5aa0ac1bee1641a7e2561361a7a24aa448')

prepare() {
  cd logging-journald
  # Upstream sets the release version during publishing, leaving the tag's metadata stale.
  # https://github.com/mosquito/logging-journald/blob/0.6.12/.github/workflows/publish.yml
  sed -i "s/^version = .*/version = \"$pkgver\"/" pyproject.toml
}

build() {
  cd logging-journald
  python -m build --wheel --no-isolation
}

check() {
  cd logging-journald
  python -m pytest
}

package() {
  cd logging-journald
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
