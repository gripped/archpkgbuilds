pkgname=hcxdumptool
pkgver=8.0.0
pkgrel=1
pkgdesc='Small tool to capture packets from wlan devices'
url='https://github.com/ZerBea/hcxdumptool'
arch=('x86_64')
license=('MIT')
depends=('glibc' 'libpcap')
source=(https://github.com/ZerBea/hcxdumptool/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz
        https://github.com/ZerBea/hcxdumptool/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.gz.asc)
sha512sums=('f1b9d03a4fa0f48e0ee305fd716a2a7df411e84d1e00a6bbfdfe9420ad077a8d51d33e9bd898635274ee7a9a94b395b09abcb29b7950f47577794951e0b9172b'
            'SKIP')
b2sums=('1d7c11dd4ad2064b4b717bebbbcc800b5a0f234706d3f54b476259286aec76623eb8044e7a464fd8dfcfa20c02943a23f0cd52d109c6f473fc3194f41b76d27e'
