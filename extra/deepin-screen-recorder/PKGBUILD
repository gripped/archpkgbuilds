pkgname=deepin-screen-recorder
pkgver=6.5.12
pkgrel=1
pkgdesc='Deepin Screen Recorder'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-screen-recorder"
license=('GPL-3.0-or-later')
depends=('deepin-qt6integration' 'deepin-qt-dbus-factory' 'deepin-tray-loader' 'dtk6core' 'dtk6gui' 'dtk6widget'
         'qt6-base' 'qt6-multimedia' 'qt6-svg' 'qt6-wayland' 'deepin-turbo' 'ffmpeg4.4' 'libxtst' 'opencv'
         'dconf' 'libprocps' 'libxext' 'libx11' 'libxfixes' 'libxinerama' 'portaudio' 'deepin-image-editor'
         'glibc' 'libgcc' 'libstdc++' 'wayland' 'hicolor-icon-theme')
makedepends=('git' 'deepin-tray-loader' 'qt6-tools')
optdepends=('deepin-shortcut-viewer: for shortcut display')
provides=('deepin-screenshot')
conflicts=('deepin-screenshot')
groups=('deepin-extra')
source=("git+https://github.com/linuxdeepin/deepin-screen-recorder.git#tag=$pkgver"
         libv4l-1.30.patch)
sha512sums=('35038a547e19ca76144b4226d5fb536070f0e6e5f6150abff2ca77fc0dfe5ce9747b3cec4f0eb296d418410c97a797f5b8d290f0670f8eb3f9614f213f52f38f'
            'b8527bbf18b78b530507ed7725218db88f3ae4ed6abb700f6430903421e188456d7f0695f680461376d403c9227bc0234578d909f29399a4072a13a042d524cb')

prepare() {
  cd deepin-screen-recorder
  # Revert opencv -> opencv-mobile change, because opencv-mobile is not available in Arch
  sed -i 's|opencv_mobile|opencv5|;s|-lopencv_small|-lopencv_core -lopencv_imgproc|' src/src.pro
  # OpenCV 5 removed these old C API compatibility aliases/helpers.
  sed -i -e '/opencv2\/imgproc\/types_c.h/d' \
         -e 's|CV_BGR2GRAY|cv::COLOR_BGR2GRAY|g' \
         -e 's|CV_TM_CCOEFF_NORMED|cv::TM_CCOEFF_NORMED|g' \
         -e 's|CV_THRESH_TOZERO|cv::THRESH_TOZERO|g' \
         -e 's|cvSize(|cv::Size(|g' \
         src/utils/pixmergethread.cpp

  # Arch intentionally ships only deepin-image-editor's Qt6 visual result library.
  sed -i 's|libimagevisualresult/visualresult.h|libimagevisualresult6/visualresult.h|;s|-limagevisualresult\>|-limagevisualresult6|' src/camera/majorimageprocessingthread.cpp src/src.pro

  # https://github.com/linuxdeepin/developer-center/issues/3035
  sed -i "s|/etc/os-version|/etc/uos-version|" src/src.pro

  # Remove non-existent resources.qrc reference
  sed -i '/..\/resources.qrc/d' src/src.pro

  patch -p1 -i ../libv4l-1.30.patch
}

build(){
  cd deepin-screen-recorder
  export PKG_CONFIG_PATH='/usr/lib/ffmpeg4.4/pkgconfig'
  qmake6 PREFIX=/usr
  CFLAGS+=" -Wno-implicit-function-declaration -I/usr/include/ffmpeg4.4/" \
  make
}

package() {
  cd deepin-screen-recorder
  make INSTALL_ROOT="$pkgdir" install
}
