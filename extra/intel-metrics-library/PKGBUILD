# Maintainer: Torsten Keßler <tpkessler@archlinux.org>

pkgname=intel-metrics-library
pkgver=1.0.218
pkgrel=1
pkgdesc="User mode library providing access to Intel GPU performance data (MDAPI)"
arch=('x86_64')
url="https://github.com/intel/metrics-library"
license=('MIT')
depends=(
	glibc
	libgcc
	libstdc++
	libdrm
)
makedepends=(
	cmake
	ninja
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('a01c0732056d355c8d176c4d9d2d0c55b6970ab478aa65286f51eb4eebaf556e')

prepare() {
	cd metrics-library-${pkgver}
	# Remove constraint on CMAKE_BUILD_TYPE
	sed -i '/Release|Release-Internal|ReleaseInternal|Debug/d' ml_cmake_adapter.cmake
}

build() {
	local cmake_args=(
		-Wno-dev
		-G Ninja
		-B build
		-S metrics-library-${pkgver}
		-D CMAKE_INSTALL_PREFIX=/usr
		-D CMAKE_BUILD_TYPE=None
	)
	cmake "${cmake_args[@]}"
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 metrics-library-${pkgver}/LICENSE.md -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}
