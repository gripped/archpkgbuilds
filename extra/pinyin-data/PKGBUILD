pkgname=pinyin-data
pkgver=0.16.0
pkgrel=1
pkgdesc="Pinyin Data for Hanzi"
arch=('any')
license=('MIT')
url="https://github.com/mozillazg/pinyin-data"
depends=()
makedepends=('git')
source=("git+https://github.com/mozillazg/pinyin-data.git#tag=v$pkgver")
sha512sums=('abec8f9d470000cf2ad9f4ef78570e1f469c84c6fadb20b9867fcd5bcf23a7d48d73e8f56188e0ba68270c61870b8f9eb00cf3c6b72254141dcd7b9ffccb3bad')

package() {
  cd $pkgname
  install -Dm644 pinyin.txt -t "$pkgdir"/usr/share/$pkgname/
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
