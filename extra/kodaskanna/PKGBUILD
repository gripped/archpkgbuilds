pkgname=kodaskanna
pkgver=0.2.3
pkgrel=2
pkgdesc='A multi-format 1D/2D code scanner'
arch=(x86_64)
url='https://apps.kde.org/kodaskanna/'
license=(LGPL-2.1-or-later)
depends=(
  glibc
  hicolor-icon-theme
  kconfigwidgets
  kcoreaddons
  kcrash
  ki18n
  kio
  kservice
  kwidgetsaddons
  kxmlgui
  libgcc
  libstdc++
  purpose
  qt6-base
  zxing-cpp
)
makedepends=(
  cmake
  extra-cmake-modules
  git
  ninja
  qt6-multimedia
)
source=(
  "git+https://invent.kde.org/graphics/kodaskanna.git?signed#tag=v$pkgver"
  kodaskanna-fix-stdin-handle.patch
)
b2sums=(
  50cd33911aebc5a2c2f60dc235d3bc063bde07f53e360702c2f1d053c199052d9252feeac558c51d010281b7e87bca4683aac05b29ac4fcc0f5724e86ac879d6
  62ed82505dd84e42ccc752f07d017c9715d8bc0f537eb57d157c23da7ed0edfbed63c81d79b0ba6ba25ddbf5faedcddd8eaddf3cb5be843c530d27ab15ae9e9b
)
validpgpkeys=(E6EBD6EB0518FE5BCCA5F6A76AACDD263C2CEFD4) # Friedrich W. H. Kossebau <kossebau@kde.org>

prepare() {
  cd $pkgname

  # Fix stdin handling when launched from desktop
  # https://invent.kde.org/graphics/kodaskanna/-/merge_requests/16
  git apply -3 ../kodaskanna-fix-stdin-handle.patch
}

build() {
  cmake -S $pkgname -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_BUILD_TYPE=None
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
