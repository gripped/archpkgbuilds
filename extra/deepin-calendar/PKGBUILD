pkgname=deepin-calendar
pkgver=6.5.41
pkgrel=1
pkgdesc='Calendar for Deepin Desktop Environment'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-calendar"
license=('GPL-3.0-or-later' 'LGPL-2.0-or-later' 'LGPL-3.0-or-later' 'CC-BY-4.0' 'CC0-1.0')
depends=('dtkcore' 'dtkgui' 'dtkwidget' 'glibc' 'libgcc' 'libstdc++' 'libical' 'qt5-base' 'qt5-svg')
makedepends=('git' 'cmake' 'ninja' 'qt5-tools')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/dde-calendar.git#tag=$pkgver"
         libical-4.patch
         qt5-qdbusinterface-noncopyable.patch)
sha512sums=('3d25f3c8f6e1a4678f2f9fcc1d0c7d91d6cd1c15f91801a69e23898dc4e57faeb081d92725da1030e9c8ac9a282621e032fdf83f6023108cc2f92498ca2c967e'
            'd7f494f1ddbbe3afb733790de115fab8fb9c14fd36fc836d06e7c538e134cbb28ea3e61b33500234f05e00f8d02cf5b7c4c4007f2a6cb70d9052945b09f2c89b'
            'ad3875964d2470abe5599d288e9331ee8b3d65665ebe0e691d371bf110e3374eed4d5786e909b226ddd6dec770873a2f0c554f5f6b134550ab27d7c7050ad443')

# Tests available in tests/ but disabled upstream (not maintained)
prepare() {
  patch -d dde-calendar -p1 < libical-4.patch # Port to libical 4
  patch -d dde-calendar -p1 < qt5-qdbusinterface-noncopyable.patch # Qt 5 QDBusInterface is non-copyable
}

build() {
  cd dde-calendar
  cmake -GNinja . \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DVERSION=$pkgver
  ninja
}

package() {
  cd dde-calendar
  DESTDIR="$pkgdir" ninja install
}
