# Maintainer: David Runge <dvzrv@archlinux.org>
# Contributor: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=cargo-release
pkgver=1.1.6
pkgrel=1
pkgdesc='Cargo subcommand "release": everything about releasing a rust crate'
url='https://github.com/crate-ci/cargo-release'
arch=(x86_64)
license=(
  Apache-2.0
  MIT
)
depends=(
  cargo
  glibc
  libgcc
  libgit2
)
makedepends=(rust)
options=(!lto)
source=($url/archive/v$pkgver/$pkgname-$pkgver.tar.gz)
sha512sums=('9c6aee931b37ec5d39c86e506737af635f4a47b14e3f3f0b648cb50285c12e2de9d706b733f560505e636e9546c0259d59ad2e2ba8705ac57b418eff4b627d6e')
b2sums=('62ac6b2ae247cf33c7e642fa14bd7768c3189c715f73a2f2b390e70140a61c196a587326a62de450ee66ab9d611a23a9b12bc1aae4c3ee4de36d4d87dcdd3f1d')

prepare() {
  cd $pkgname-$pkgver
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $pkgname-$pkgver
  cargo build --frozen --release --no-default-features
}

package() {
  cd $pkgname-$pkgver
  install -Dm 755 target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -Dm 644 LICENSE-MIT -t "$pkgdir/usr/share/licenses/$pkgname/"
}

