# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgbase=deepin-qtplatform-plugins
pkgname=(deepin-qt5platform-plugins deepin-qt6platform-plugins)
pkgver=6.7.51
pkgrel=3
pkgdesc='Qt platform plugins for DDE'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-qtplatform-plugins"
license=('LGPL-3.0-or-later')
groups=('deepin')
makedepends=('git' 'cmake' 'ninja' 'qt5-tools' 'qt6-tools' 'qt5-xcb-private-headers' 'qt6-xcb-private-headers'
             'libglvnd' 'gtest' 'extra-cmake-modules' 'dtkcommon' 'cairo'
             'qt5-base' 'qt5-x11extras' 'qt6-base')
source=("git+https://github.com/linuxdeepin/dde-qtplatform-plugins.git#tag=$pkgver")
sha512sums=('dcdd94a729df35d7a786de4a3a3234f147bd013f34227d827b566ca88577568fe1c5ec92ea943e8c1a93be0232f88178f7bc4d7257bb30af2e97689fae02f3f6')

prepare() {
  cd dde-qtplatform-plugins

  # Use Arch's matching private Qt headers instead of the bundled copies.
  rm -r xcb/libqt5xcbqpa-dev xcb/libqt6xcbqpa-dev wayland/qtwayland-dev

  cd ..
  # Use separate source directories for Qt5 and Qt6 builds
  mkdir -p build-qt5 build-qt6
  cp -r dde-qtplatform-plugins build-qt5/dde-qtplatform-plugins
  cp -r dde-qtplatform-plugins build-qt6/dde-qtplatform-plugins

  # Fix Qt5 install path for Arch convention (qt/plugins instead of qt5/plugins)
  sed -i 's|qt${QT_VERSION_MAJOR}/plugins|qt/plugins|' build-qt5/dde-qtplatform-plugins/xcb/CMakeLists.txt

  # The Qt5 Wayland backend floods the journal under Plasma.
  # https://github.com/linuxdeepin/developer-center/issues/7217
  sed -i '/wayland/d' build-qt5/dde-qtplatform-plugins/CMakeLists.txt
}

build() {
  # Build Qt5 variant
  cd build-qt5/dde-qtplatform-plugins
  cmake . -GNinja \
    -DDTK5=ON \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DQT_XCB_PRIVATE_HEADERS=/usr/include/qtxcb-private
  ninja

  cd "$srcdir"
  # Build Qt6 variant
  cd build-qt6/dde-qtplatform-plugins
  cmake . -GNinja \
    -DDTK5=OFF \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DQT_XCB_PRIVATE_HEADERS=/usr/include/qt6xcb-private
  ninja
}

package_deepin-qt5platform-plugins() {
  pkgdesc='Qt 5 platform plugins for DDE'
  depends=('qt5-base' 'qt5-x11extras' 'libx11' 'libxi' 'libxcb' 'xcb-util-wm' 'glibc' 'libgcc' 'libstdc++')

  cd build-qt5/dde-qtplatform-plugins
  DESTDIR="$pkgdir" ninja install
}

package_deepin-qt6platform-plugins() {
  pkgdesc='Qt 6 platform plugins for DDE'
  depends=('qt6-base' 'libx11' 'libxi' 'libxcb' 'xcb-util-wm' 'xcb-util-cursor' 'glibc' 'libgcc' 'libstdc++')

  cd build-qt6/dde-qtplatform-plugins
  DESTDIR="$pkgdir" ninja install
}
