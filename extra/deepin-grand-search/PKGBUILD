# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-grand-search
pkgver=5.5.0
pkgrel=1
pkgdesc='System-wide desktop search for DDE'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-grand-search"
license=('GPL-3.0-or-later')
# deepin-application-manager: org.deepin.dde.Application1.Manager :/
depends=(deepin-anything deepin-application-manager taglib ffmpeg icu deepin-pdfium ffmpegthumbnailer lucene++
         deepin-qt-dbus-factory dtkgui dtkwidget)
makedepends=(git cmake deepin-tray-loader ninja qt5-tools boost)
groups=(deepin-extra)
source=("git+https://github.com/linuxdeepin/dde-grand-search.git#tag=$pkgver"
         taglib-2.patch)
sha512sums=('c95ccc2f827db05859ff8d500bbee16781afc7ca6726b7babe832e9b099b0ba65cafb1985e5474a5a57d6b3c26d666e6cbc23d5f5d778a71fccc8ff928961615'
            '8364cd5aa0350a7d109be7ce10035c6c4e3fd6686205bc880017b1fc93a10cff6e78a8f66daeb25427c416a6dc075482136146c9d8278aee6de71653673d59a0')

prepare() {
  cd dde-grand-search

  # Fix dock plugin build with current dde-dock headers after 5.4.8 dropped the V2 compatibility layer
  git cherry-pick -n 08c06e1

  # ICU 77 headers require C++17, but 5.4.8 still forces C++14 in all subprojects
  sed -i 's/set(CMAKE_CXX_STANDARD 14)/set(CMAKE_CXX_STANDARD 17)/' src/*/CMakeLists.txt src/preview-plugin/CMakeLists.txt

  # https://github.com/linuxdeepin/dde-grand-search/pull/65
  sed -i 's/-fPIE -pie//g' src/*/CMakeLists.txt

  patch -p1 -i ../taglib-2.patch
}

build() {
  cd dde-grand-search
  cmake -GNinja .
  ninja
}

package() {
  cd dde-grand-search
  DESTDIR="$pkgdir" ninja install
}
