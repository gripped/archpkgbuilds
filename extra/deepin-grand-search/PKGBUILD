# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-grand-search
pkgver=6.0.7
pkgrel=1
pkgdesc='System-wide desktop search for DDE'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-grand-search"
license=('GPL-3.0-or-later')
# deepin-application-manager: org.deepin.dde.Application1.Manager :/
depends=(deepin-anything deepin-application-manager deepin-service-manager taglib ffmpeg icu deepin-pdfium ffmpegthumbnailer lucene++
         deepin-qt-dbus-factory dtk6core dtk6gui dtk6widget qt6-base qt6-5compat)
makedepends=(git cmake deepin-tray-loader ninja qt6-tools boost)
groups=(deepin-extra)
source=("git+https://github.com/linuxdeepin/dde-grand-search.git#tag=$pkgver"
         taglib-2.patch)
sha512sums=('b2266244c5c19d76b38c130ceee46ddaf96b7ee7dea657ef68fe6302eb8f902f4918a092de667c59872b08cb81758f3cf9be7eab34141da2c6d58e29747e2563'
            '8364cd5aa0350a7d109be7ce10035c6c4e3fd6686205bc880017b1fc93a10cff6e78a8f66daeb25427c416a6dc075482136146c9d8278aee6de71653673d59a0')

prepare() {
  cd dde-grand-search

  # https://github.com/linuxdeepin/dde-grand-search/pull/65
  sed -i 's/-fPIE -pie//g' src/*/CMakeLists.txt

  if [[ ! -d 3rdparty/antlr4 ]]; then
    bsdtar -xf 3rdparty/antlr4.tar.gz -C 3rdparty
  fi
  sed -i 's/^cmake_minimum_required (VERSION 2\.8)$/cmake_minimum_required (VERSION 3.5)/' \
    3rdparty/antlr4/antlr4-runtime/CMakeLists.txt
  sed -i '/CMAKE_POLICY(SET CMP0054 OLD)/d; /CMAKE_POLICY(SET CMP0045 OLD)/d; /CMAKE_POLICY(SET CMP0042 OLD)/d; /CMAKE_POLICY(SET CMP0059 OLD)/d' \
    3rdparty/antlr4/antlr4-runtime/CMakeLists.txt
  sed -i '/^if(EXISTS LICENSE.txt)$/,/^endif()$/d' 3rdparty/antlr4/antlr4-runtime/CMakeLists.txt

  patch -p1 -i ../taglib-2.patch

  # Fix new EventLogUtil header's incomplete Qt type declarations.
  sed -i 's|#include <QVariantMap>|#include <QObject>\n#include <QJsonObject>\n#include <QThread>\n#include <QVariantMap>|' \
    src/grand-search/utils/report/eventlogutil.h
}

build() {
  cd dde-grand-search
  cmake -GNinja . -DCMAKE_INSTALL_PREFIX=/usr -DVERSION=$pkgver
  ninja
}

package() {
  cd dde-grand-search
  DESTDIR="$pkgdir" ninja install
}
