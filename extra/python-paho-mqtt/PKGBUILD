# Contributor: Daichi Shinozaki <dsdseg@gmail.com>
# Contributor: Christopher Arndt <aur -at- chrisarndt -dot- de>

pkgname=python-paho-mqtt
pkgver=2.2.0
pkgrel=1
url="https://www.eclipse.org/paho/clients/python"
pkgdesc="Python client library for MQTT v5.0, v3.1.1 and v3.1"
depends=('python')
optdepends=('python-pysocks: SOCKS and HTTP proxy support'
            'python-dnspython: DNS SRV lookup with connect_srv()')
checkdepends=('python-pytest')
makedepends=('python-build' 'python-installer' 'python-hatchling')
license=('EPL-2.0 OR BSD-3-Clause')
arch=('any')
source=($pkgname-$pkgver.tar.gz::https://github.com/eclipse-paho/paho.mqtt.python/archive/v${pkgver}.tar.gz)
sha256sums=('2e45676494172611c9ed55dd015577f02beb6c013798d93ea93907683edaf51b')

build() {
  cd paho.mqtt.python-${pkgver}
  python -m build --wheel --no-isolation
}

check() {
  cd paho.mqtt.python-${pkgver}
  # the test client subprocesses import the tests package from the source root
  PYTHONPATH="$PWD/src:$PWD" pytest tests
}

package_python-paho-mqtt() {
  cd paho.mqtt.python-${pkgver}
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.txt edl-v10 epl-v20 -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
