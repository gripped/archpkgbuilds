# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=pantheon-default-settings
pkgver=8.1.1
pkgrel=5
pkgdesc='Default settings for Pantheon'
arch=(any)
url=https://github.com/elementary/default-settings.git
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  accountsservice
  dconf
  polkit
)
makedepends=(
  git
  meson
)
source=(pantheon-default-settings::git+https://github.com/elementary/default-settings.git#tag=${pkgver})
b2sums=('8253a7b2135bc4f5f3ee6b6b253e2374c23ffed6ae31d599bfca1391d528b3065c6bf3512d30e8177ec68725a76da86c2d945776bb802d08705fd28d68cb3ec9')

prepare() {
  cd pantheon-default-settings

  # Remove unavailable setting
  sed -i '/^terminal=/d' overrides/default-settings.gschema.override.in
}

build() {
  arch-meson pantheon-default-settings build \
    -Dapparmor-profiles=false \
    -Dappcenter-flatpak=false \
    -Dgeoclue=false
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install

  # Remove settings that are specific for elementary OS
  rm -r "${pkgdir}"/etc
  rm -r "${pkgdir}"/usr/share/applications
  rm -r "${pkgdir}"/usr/share/cups

  # Rename GSettings override file to be unique
  mv "${pkgdir}"/usr/share/glib-2.0/schemas/{default-settings,00_io.elementary.pantheon}.gschema.override
}

