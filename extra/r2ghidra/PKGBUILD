# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=r2ghidra
pkgver=6.1.4
pkgrel=1
pkgdesc='Deep ghidra decompiler integration for radare2 and iaito'
arch=(x86_64)
url='https://github.com/radareorg/r2ghidra'
license=(LGPL-3.0-only)
depends=(
  glibc
  libgcc
  libstdc++
  radare2
  zlib
)
makedepends=(
  git
  meson
)
provides=(radare2-r2ghidra)
replaces=(r2ghidra-dec)
_ghidra_native_ver=0.6.4
_pugixml_ver=v1.15
source=(
  "git+https://github.com/radareorg/r2ghidra#tag=$pkgver"
  "git+https://github.com/radareorg/ghidra-native.git#tag=$_ghidra_native_ver"
  "git+https://github.com/zeux/pugixml.git#tag=$_pugixml_ver"
)
b2sums=('eda382907099814804bd3ed7003e33a46a73942a5ae5af5ccecde7b52b293ffea60a4625f39d977eea6f290ae1f84a77553326ffe8b5cb146d7cc9d4a29ef977'
        '664a80d82f041dff08c303a17edf65d6f675d472098254e356c62d09f9175a68bb6ab4624545cb63301a5dafae53d52ff0e59132a4cfc81e8b385d9c40b3774f'
        'f57c537eb028ce25f81bff48f0001cf134fbed14bd836277f11907f1429c43f8a243e084b92d84bf5529c0fcb18d65e79afd256edb85561591871f62c65cf65b')

prepare() {
  cd $pkgname
  for subproject in ghidra-native pugixml; do
    local ver_var=_${subproject//-/_}_ver
    local expected_ver=${!ver_var}
    grep -q "revision = $expected_ver" subprojects/$subproject.wrap \
      || { echo "Version mismatch in subproject $subproject"; exit 1; }
  done
}

build() {
  cd $pkgname
  export MESON_PACKAGE_CACHE_DIR="$srcdir"
  arch-meson build
  meson compile -C build
}

package() {
  cd $pkgname
  meson install -C build --destdir "$pkgdir"
  local r2version=$(r2 -v|grep radare2|sed -E 's/radare2 ([0-9\.]+) .*/\1/')
  ln -vs "/usr/lib/radare2/$r2version" "$pkgdir/usr/lib/radare2/last"
}
