# Maintainer: Alexander F. Rødseth <xyproto@archlinux.org>

pkgbase=ols
pkgname=(odinfmt ols)
pkgver=dev_2026_08
pkgrel=2
pkgdesc='Language server and source code formatter for Odin'
arch=(x86_64)
url='https://github.com/DanielGavin/ols'
license=(MIT)
depends=(glibc)
makedepends=(git odin)
source=("git+$url#commit=d8188f0e4747a551a171170f918058f9d5d7038d") # dev-2026-08 + patches
#source=("git+$url#tag=${pkgver//_/-}")
b2sums=('6a513e94081284dc174f507d4ab45f58f9ca831f91f4581354a543543532b25fa5292f14c5df7cf89b17839a5febeb9d56e03dccdb16ca06f93472fa402313ed')

prepare() {
  sed -i '/\.Haiku/d' ols/src/server/build.odin

  # Thanks @jfch
  sed -i 's/microarch:native/microarch:generic/g' ols/build.sh
}

build() {
  cd ols
  ./build.sh
  ./odinfmt.sh
}

package_odinfmt() {
  pkgdesc='Source code formatter for Odin'

  install -Dm755 ols/$pkgname "$pkgdir/usr/bin/$pkgname"
  install -Dm644 ols/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_ols() {
  pkgdesc='Language server for Odin'

  install -Dm755 ols/$pkgname "$pkgdir/usr/bin/$pkgname"
  install -Dm644 ols/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
