# Maintainer: Alexander F. Rødseth <xyproto@archlinux.org>

pkgbase=ols
pkgname=(odinfmt ols)
pkgver=dev_2026_06
pkgrel=1
pkgdesc='Language server and source code formatter for Odin'
arch=(x86_64)
url='https://github.com/DanielGavin/ols'
license=(MIT)
depends=(glibc)
makedepends=(git odin)
source=("git+$url#tag=${pkgver//_/-}")
b2sums=('1a564a0ff67f64b22e19181ae8d4f6790db2219b493cef9e29d913d94f17d27bd2502d21f4cf20bc824637edbab7419d7a7a7ee24385327fdbfc0b54b026e7eb')

prepare() {
  sed -i '/\.Haiku/d' ols/src/server/build.odin

  # Thanks @jfch
  sed -i 's/microarch:native/microarch:x86-64/g' ols/build.sh
}

build() {
  cd ols
  ./build.sh
  ./odinfmt.sh
}

package_odinfmt() {
  pkgdesc='Source code formatter for Odin'

  install -Dm755 ols/$pkgname "$pkgdir/usr/bin/$pkgname"
  install -Dm644 ols/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_ols() {
  pkgdesc='Language server for Odin'

  install -Dm755 ols/$pkgname "$pkgdir/usr/bin/$pkgname"
  install -Dm644 ols/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
