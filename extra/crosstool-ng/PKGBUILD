pkgname=crosstool-ng
pkgver=1.29.0
pkgrel=1
pkgdesc='A versatile (cross-)toolchain generator'
arch=(x86_64)
url=https://crosstool-ng.github.io/
license=(
  CC-BY-SA-2.5
  GPL-2.0-only
  LGPL-2.1-only
)
depends=(
  git
  gperf
  help2man
  lzip
  meson
  ncurses
  python
  rsync
  unzip
)
source=(git+https://github.com/crosstool-ng/crosstool-ng.git#tag=crosstool-ng-${pkgver})
b2sums=('90152c82a0b3f3b848f92b576ae6bef2517d9953c11b7f42df9b527567f65850bc3d4d96d5369bbb14fb49cc2581ba588c6089518a1eb4f18e2f3c94d8442ed2')

prepare() {
  cd crosstool-ng
  ./bootstrap
}

build() {
  cd crosstool-ng
  ./configure \
    --prefix=/usr \
    --libexecdir=/usr/lib \
    --with-bash-completion \
    --with-ncurses
  make
}

package() {
  cd crosstool-ng
  make DESTDIR="${pkgdir}" install
}
