# Maintainer: Balló György <ballogyor+arch at gmail dot com>
# Contributor: Jan Magnus Brevik <janmbrevik@gmail.com>

pkgname=gpodder
pkgver=3.11.5
pkgrel=5
pkgdesc='Podcast client written in Python using GTK'
arch=(any)
url='https://gpodder.github.io/'
license=(GPL-3.0-or-later)
depends=(
  gdk-pixbuf2
  glib2
  gtk3
  hicolor-icon-theme
  pango
  python
  python-cairo
  python-dbus
  python-gobject
  python-mygpoclient
  python-podcastparser
  python-requests
  python-urllib3
  xdg-utils
)
makedepends=(
  git
  intltool
  python-build
  python-installer
  python-setuptools
  python-wheel
)
optdepends=(
  'libappindicator: App Indicator extension'
  'libnotify: Desktop Notifications extension'
  'python-html5lib: Clickable links in show notes'
  'python-mutagen: Tag downloaded files, Remove cover art from OGG files extensions'
  'python-pysocks: SOCKS proxy support'
  'webkit2gtk-4.1: HTML show notes'
  'yt-dlp: Youtube-dl extension'
)
source=("git+https://github.com/gpodder/gpodder.git#tag=$pkgver")
b2sums=(632ab0b95f7602cdf1e8bf054221edefc0ba6ce331a2b0c5c64d168889b507d4eea2b274f92571bbe0ff9bf26f560d6f00985903dc888b4f0770fc4882eabd9f)

prepare() {
  cd $pkgname

  # Support webkit2gtk-4.1
  # https://github.com/gpodder/gpodder/pull/1747
  git cherry-pick -n 9910aeed49b286287534cdafcab7f9e7e2b04d51
  git cherry-pick -n 7c1d67ef2f942bf8b00bbc3ec76bf0b1a82fa489

  # Fix launchable ID in metainfo file
  sed -i 's/org.gpodder.gpodder.desktop/gpodder.desktop/' share/metainfo/org.gpodder.gpodder.appdata.xml
}

build() {
  cd $pkgname
  make build
  python -m build --wheel --no-isolation
}

package() {
  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
}
