# Contributor: Tommaso Sardelli <lacapannadelloziotom at gmail dot com>

pkgname=bpftrace
pkgver=0.26.0
pkgrel=1
pkgdesc='High-level tracing language for Linux eBPF'
arch=('x86_64')
url='https://github.com/iovisor/bpftrace'
license=('Apache-2.0')
depends=(
  'bcc'
  'clang'
  'glibc'
  'libelf'
  'libgcc'
  'libpcap'
  'libstdc++'
  'llvm-libs'
  'systemd-libs'
  'zip'
  'zlib'
  'zstd'
)
makedepends=(
  'asciidoctor'
  'binutils'
  'bpf'
  'cereal'
  'cmake'
  'git'
  'gtest'
  'linux-headers'
  'llvm'
  'xxd'
)
options=(
  '!debug'
  '!strip'
)
source=(
  "git+$url.git#tag=v$pkgver"
  "$pkgname-libbpf::git+https://github.com/libbpf/libbpf.git"
)
b2sums=('45869967db62817aba4b7cdb1d04e101738889ce8e05d5b51a5d48c27a2e2f6ee4bb338091b2a4e33cd65904272e6d3c053d255415a91827e8ff7f8ae5842b37'
        'SKIP')

prepare() {
  cd $pkgname
  git submodule init
  git config submodule.libbpf.url ../$pkgname-libbpf
  git -c protocol.file.allow=always submodule update libbpf
}

build() {
  cmake -S $pkgname -B build \
    -D CMAKE_BUILD_TYPE=None \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -W no-dev \
    -D ENABLE_SYSTEMD=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  depends+=(
    'binutils' 'libsframe.so'
  )

  DESTDIR="$pkgdir" cmake --install build
}
