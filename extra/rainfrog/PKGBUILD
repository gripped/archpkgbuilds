# Maintainer: Orhun Parmaksız <orhun@archlinux.org>

pkgname=rainfrog
pkgver=0.4.1
pkgrel=1
pkgdesc="A database management TUI for Postgres"
arch=('x86_64')
url="https://github.com/achristmascarl/rainfrog"
license=('MIT')
depends=('duckdb' 'libgcc' 'sqlite')
makedepends=('cargo' 'clang')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha512sums=('0efc65958377d1a8b0543cf89288d0fb981c6a2c9e7e01009c58cecbee198dc69e659441129665b87cdbec8338187687bb4cd45f98f2aa6cf8df25a924e2045a')
options=('!lto')

prepare() {
  cd "$pkgname-$pkgver"
  sed -i '/^duckdb =/s/"bundled"/"buildtime_bindgen"/' Cargo.toml
  cargo fetch --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  LIBSQLITE3_SYS_USE_PKG_CONFIG=1 cargo build --release --frozen
}

check() {
  cd "$pkgname-$pkgver"
  LIBSQLITE3_SYS_USE_PKG_CONFIG=1 cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm 755 "target/release/$pkgname" -t "$pkgdir/usr/bin"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}

# vim:set ts=2 sw=2 et:
