# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=nemo-qml-plugin-notifications
pkgver=1.2.32
pkgrel=1
pkgdesc="Notifications plugin for Nemo Mobile"
arch=('x86_64')
url="https://github.com/sailfishos/nemo-qml-plugin-notifications"
license=('BSD-3-Clause')
depends=('qt5-declarative')
makedepends=('git')
source=("git+https://github.com/sailfishos/nemo-qml-plugin-notifications.git#tag=$pkgver")
sha512sums=('afc5a6d986076067cd04794e980cde3d8d718c8adcf262b04f42d8c458b599be7d22f4d3d7fa96d213689bc22b19511370cd95cfaa446433d2ca4ceb9db36f29')

prepare() {
  cd nemo-qml-plugin-notifications
  # Arch does not package generated qdoc output; avoid Sailfish-only qmake feature.
  sed -i 's/ doc$//' notifications.pro
}

build() {
  cd nemo-qml-plugin-notifications
  qmake-qt5
  make
}

package() {
  cd nemo-qml-plugin-notifications
  make INSTALL_ROOT="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
