# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=perl-dbi
pkgver=1.654
pkgrel=1
pkgdesc="Database independent interface for Perl"
arch=('x86_64')
url="https://metacpan.org/release/DBI"
license=('GPL-1.0-or-later' 'Artistic-1.0-Perl')
depends=('perl')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/H/HM/HMBRAND/DBI-$pkgver.tgz")
sha512sums=('bfacc66e4aa41702161ecdf8e171af6807abcce29d6fe5ce7ac82b5d25b8642393d1f735613f48ff32a095a5b9354a4aa0e30d0fcfac086e3a79ff27c56470c2')

build() {
  cd DBI-$pkgver
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd DBI-$pkgver
  make test
}

package() {
  cd DBI-$pkgver
  make DESTDIR="$pkgdir" install
}
