# Maintainer: Robin Candau <antiz@archlinux.org>

pkgname=incrust
pkgver=1.0.0
pkgrel=1
pkgdesc="A minimal incremental / idle terminal game about compiling stuff"
url="https://github.com/Antiz96/incrust"
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('glibc' 'libgcc')
makedepends=('cargo' 'scdoc' 'git')
optdepends=("genact: for compilation animations")
source=("git+${url}.git#tag=v${pkgver}?signed")
sha256sums=('77a5817a9ce857e24c9ae6ed34809c2ac41968da65e5f4b0901ed6ba21d04fc7')
validpgpkeys=(A67CCEEBF9613C17FDE96E4ED33FAA16B937F3B2) # Robin Candau <robincandau@mailbox.org>

prepare() {
	cd "${pkgname}"
	cargo fetch --locked --target host-tuple
}

build() {
	cd "${pkgname}"
	cargo build --frozen --release --all-features

	scdoc < "doc/man/${pkgname}.1.scd" > "doc/man/${pkgname}.1"
}

check() {
	cd "${pkgname}"
	cargo test --frozen --all-features
}

package() {
	cd "${pkgname}"
	install -Dm 755 "target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"

	install -Dm 644 "res/completions/${pkgname}.bash" "${pkgdir}/usr/share/bash-completion/completions/${pkgname}"
	install -Dm 644 "res/completions/${pkgname}.zsh" "${pkgdir}/usr/share/zsh/site-functions/_${pkgname}"
	install -Dm 644 "res/completions/${pkgname}.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/${pkgname}.fish"

	install -Dm 644 "doc/man/${pkgname}.1" "${pkgdir}/usr/share/man/man1/${pkgname}.1"

	install -Dm 644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
