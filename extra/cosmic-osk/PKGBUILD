# Maintainer: Peter Jung <ptr1337@archlinux.org>

pkgname=cosmic-osk
pkgver=1.12.0
pkgrel=1
pkgdesc='On-screen keyboard for the COSMIC desktop environment'
arch=(x86_64)
url=https://github.com/pop-os/cosmic-osk
license=(GPL-3.0-only)
groups=(cosmic)
depends=(
  libgcc
  glibc
  libxkbcommon
  systemd-libs
  wayland
)
makedepends=(
  cargo
  clang
  git
  just
  lld
)
source=(
  git+https://github.com/pop-os/cosmic-osk.git#tag=epoch-${pkgver}
)
b2sums=('2fa849cb9c8fe34e37f689d9bb4f1ee6c41b18ca9aa0155ebbfa335c67604dfe2a29e4938341c4b56eddfeb6da935bfb305de8d464c7896ceb1ad3f02199bbc3')

prepare() {
  cd cosmic-osk
  cargo fetch --locked
}

build() {
  cd cosmic-osk
  RUSTFLAGS+=" -C link-arg=-fuse-ld=lld"
  just build-release --frozen
}

package() {
  cd cosmic-osk
  just rootdir="${pkgdir}" install
}

