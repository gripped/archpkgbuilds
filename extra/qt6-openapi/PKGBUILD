# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=qt6-openapi
_pkgver=6.11.1
pkgver=${_pkgver/-/}
pkgrel=2
arch=(x86_64)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='OpenAPI Generator for the cpp-qt6-client library'
depends=(glibc
         java-runtime
         libstdc++
         qt6-base
         openapi-generator
         zlib)
makedepends=(cmake
             git
             maven
             ninja)
groups=(qt6)
_pkgfn=${pkgname/6-/}
source=(git+https://code.qt.io/qt/$_pkgfn#tag=v$_pkgver
        openapi-generator-jar-path.patch)
sha256sums=('7f99ec0d6b69aba419031af9f9f2d2491b5ae8089d4ddaa808dec14bf018461c'
            'aebff149fa25d8d5db7f7d8191d7efd1d18abad2d2fb757972802cfb9940343d')

prepare() {
# https://qt-project.atlassian.net/browse/QTBUG-148153
  patch -d $_pkgfn -p1 < openapi-generator-jar-path.patch
}

build() {
  cmake -B build -S $_pkgfn -G Ninja \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
    -DJava_JAR_PATHS=/usr/share/java/openapi-generator
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-base "$pkgdir"/usr/share/licenses/$pkgname
}
