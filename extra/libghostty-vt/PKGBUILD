# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=libghostty-vt
pkgver=1.0.2
pkgrel=1
pkgdesc='A C-compatible library for embedding a fast, feature-rich terminal emulator in any 3rd party project'
arch=(x86_64)
url='https://github.com/ghostty-org/ghostty'
license=(MIT)
depends=(
  glibc
  highway
  simdutf
)
makedepends=(
  zig
)
source=(
  https://release.files.ghostty.org/$pkgname/$pkgver/$pkgname-$pkgver.tar.gz
  https://release.files.ghostty.org/$pkgname/$pkgver/$pkgname-$pkgver-deps.tar.gz
)
sha256sums=('1dcafa8a3357f3a6bbf4f2696e61de611400c5469518716793dfffd35f008b3e'
            'c56156dbea82fdf71f13bf0d704cdf4393b6a04208d7f9691e0d7f60c7f9ca4d')

build() {
  cd $pkgname-$pkgver
  DESTDIR=build zig build \
    --summary all \
    --prefix /usr \
    --system ../$pkgname-$pkgver-deps \
    -fsys=highway \
    -fsys=simdutf \
    -Doptimize=ReleaseFast \
    -Dcpu=baseline \
    -Dversion-string="$pkgver"
}

package() {
  cd $pkgname-$pkgver
  cp -r build/usr "$pkgdir"
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
