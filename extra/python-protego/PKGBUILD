# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-protego
pkgver=0.4.0
pkgrel=1
pkgdesc="A pure-Python robots.txt parser with support for modern conventions"
url="https://github.com/scrapy/protego"
license=('BSD-3-Clause')
arch=('any')
depends=('python')
makedepends=('git' 'python-setuptools' 'python-build' 'python-installer' 'python-wheel')
checkdepends=('python-pytest')
source=("git+https://github.com/scrapy/protego.git#tag=$pkgver")
sha512sums=('bfa33f6a363c03c7249adb03546d107cc49406305bab5070cd4964e18f51fd43d0a1e68e72736f12fd13ca22132b5cbb928ff0417c6247683d2e464fccf3621d')

build() {
  cd protego
  python -m build --wheel --no-isolation
}

check() {
  cd protego
  PYTHONPATH="$PWD"/src pytest
}

package() {
  cd protego
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
