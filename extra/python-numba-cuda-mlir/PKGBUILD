prepare() {
  # make a worktree for LLVM 7 tag
  git -C llvm-project worktree add $_name-llvm7 $_llvm7_tag

  # Fix build with nanobind 3.0 (pinned to 2.9 in LLVM)
  sed -i 's|nanobind 2.9|nanobind|' llvm-project/mlir/cmake/modules/MLIRDetectPythonEnv.cmake

  # Backport nanobind 3.0 compatibility from upstream LLVM
  # https://github.com/llvm/llvm-project/commit/0d3f7ae1e926261d532e0cfc92799673ed49489b
  git -C llvm-project cherry-pick -n 0d3f7ae1e926261d532e0cfc92799673ed49489b

  # nanobind 3.0 fixes not yet upstream: link MLIR's domain-isolated runtime
  # library directly in add_mlir_python_extension, and initialize the backend
  # state in the non-module MLIRPythonSupport library via nb::register_module()
  patch -d llvm-project -p1 < llvm-nanobind-3.0.patch

  cd $_name-$pkgver
  # drop cmake and ninja dependencies from pyproject.toml
  patch -p1 < ../pyproject.patch

  # Fix out-of-bounds read in extract_cuda_args for flattened tuple args
  # https://github.com/NVIDIA/numba-cuda-mlir/pull/242
  patch -p1 < ../fix-extract-cuda-args-oob.patch
}

build() {
  cd $_name-$pkgver

  # Based on https://github.com/NVIDIA/numba-cuda-mlir/blob/main/INSTALL.md
  # Build modern LLVM + MLIR (uses ci/llvm-version.env for the commit)
  LLVM_MODERN_SRC="$srcdir"/llvm-project ci/build-llvm-modern.sh  # produces llvm-modern-install/

  # Build LLVM 7 shared library
  LLVM7_SRC="$srcdir"/$_name-llvm7 ci/build-llvm7.sh  # produces llvm7-install/

  # Build numba-cuda-mlir
  MLIR_DIR="$PWD"/llvm-modern-install/lib/cmake/mlir \
  LIBLLVM7="$PWD"/llvm7-install/lib/libLLVM-7.so \
  python -m build --wheel --no-isolation
}

package() {
  cd $_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
}
