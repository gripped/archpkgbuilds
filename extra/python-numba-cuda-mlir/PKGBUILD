# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>

_name=numba-cuda-mlir
pkgname=python-$_name
pkgver=0.4.1
pkgrel=1
pkgdesc="Evolution of Numba-CUDA that improves upon its technical foundation and performance"
url="https://github.com/NVIDIA/numba-cuda-mlir"
arch=(x86_64)
license=(Apache-2.0)
depends=(
  glibc
  libstdc++
  python
  python-cuda-bindings
  python-cuda-core
  python-cuda-pathfinder
  python-numpy
  python-yaml
)
makedepends=(
  cmake
  git
  ninja
  python-build
  python-installer
  python-setuptools
  python-wheel
)
optdepends=(
  'python-colorama: colors in error messages'
  'python-pygments: syntax highlighting in code dumps'
)
source=(
  $pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz
  pyproject.patch
)
b2sums=('5ae13f285f3b54e3a52cf212ebe50d41b5e3e70a24db05f604b04d324fd89ecc52ff2d3f106ecbe302fe7d1837c7a38c04f95eca72d3f2a33c759d13d1f1926d'
        'c06f7b34dcf5e8400320f3fd249a5c32135111d5695b68db5c327453d7081e4ae18d5458d35bdf6900c08f86d63817403df2cea2310138a4d2babfe783a0ad8b')

prepare() {
  cd $_name-$pkgver
  # drop cmake and ninja dependencies from pyproject.toml
  patch -p1 < ../pyproject.patch
}

build() {
  cd $_name-$pkgver
  python -m build --wheel --no-isolation
}

package() {
  cd $_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  # Remove tests
  rm -rv "$pkgdir"$(python -c "import site; print(site.getsitepackages()[0])")/numba_cuda_mlir/{testing/,numba_cuda/tests/,numba_cuda/testing.py}
}
