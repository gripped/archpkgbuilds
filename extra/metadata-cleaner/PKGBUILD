# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=metadata-cleaner
pkgver=4.0.0
pkgrel=1
pkgdesc='Python GTK application to view and clean metadata in files, using mat2'
arch=(any)
url='https://gitlab.com/metadatacleaner/metadatacleaner'
license=(GPL-3.0-or-later)
depends=(
  dconf
  glib2
  gtk4
  hicolor-icon-theme
  libadwaita
  mat2
  pango
  python
  python-gobject
)
makedepends=(
  appstream
  git
  meson
)
source=(
  "git+https://gitlab.com/metadatacleaner/metadatacleaner.git#tag=v$pkgver"
  metadata-cleaner-new-window.patch
)
b2sums=(
  b90899604dc0e762c7bb140491963b137938248cd77c574c27260e85d15ec336f6dac9ce042d90d1d4ff5cf0cf9a3106057acd54801072f68671769f3b010c80
  cc3201282d6ec374ffe937df278f87dd754a31638a483b88f2db69f47710da72a9108136a9b40558482918e3b8970145dcf03492873462bb1b3f157034a0218d
)

prepare() {
  cd metadatacleaner

  # Add "new-window" command-line option
  # https://gitlab.com/metadatacleaner/metadatacleaner/-/merge_requests/42
  git apply -3 ../metadata-cleaner-new-window.patch
}

build() {
  arch-meson metadatacleaner build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  python -m compileall -d /usr/share "$pkgdir/usr/share"
  python -O -m compileall -d /usr/share "$pkgdir/usr/share"
}
