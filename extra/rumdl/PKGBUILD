# Maintainer: Orhun Parmaksız <orhun@archlinux.org>
# Contributor: Julien Virey <julien.virey@gmail.com>

pkgname=rumdl
pkgver=0.2.60
pkgrel=1
pkgdesc='Markdown Linter and Formatter written in Rust'
arch=('x86_64')
url=https://github.com/rvben/rumdl
license=('MIT')
depends=(glibc jemalloc libgcc)
makedepends=(cargo)

source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz)
sha256sums=('7fe31dd1795a929f1f3bbdbb2d95504d63ceed5df62eaac844f850f6921ec26d')

prepare() {
  cd $pkgname-$pkgver
  export JEMALLOC_OVERRIDE=/usr/lib/libjemalloc.so
  export CARGO_FEATURE_UNPREFIXED_MALLOC_ON_SUPPORTED_PLATFORMS=1
  [[ $CARCH == aarch64 ]] && export CFLAGS+=" -ffat-lto-objects" CXXFLAGS+=" -ffat-lto-objects"
  cargo fetch --locked --target $(rustc --print host-tuple)
}

build() {
  cd $pkgname-$pkgver
  export JEMALLOC_OVERRIDE=/usr/lib/libjemalloc.so
  export CARGO_FEATURE_UNPREFIXED_MALLOC_ON_SUPPORTED_PLATFORMS=1
  [[ $CARCH == aarch64 ]] && export CFLAGS+=" -ffat-lto-objects" CXXFLAGS+=" -ffat-lto-objects"
  cargo build --frozen --release --bin rumdl
}

package() {
  cd $pkgname-$pkgver
  install -Dm0755 -t "$pkgdir/usr/bin/" "target/release/$pkgname"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

# vim: ts=2 sw=2 et:
