# Maintainer: Caleb Maclennan <caleb@alerque.com>

pkgname=lite-xl-plugin-manager
pkgver=1.4.7
pkgrel=1
pkgdesc='Lite XL Plugin Manager'
arch=(x86_64 aarch64)
url='https://github.com/lite-xl/lite-xl-plugin-manager'
license=(custom:LPM)
depends=(freetype2
         glibc # libc.so
         libgit2 libgit2.so
         libzip libzip.so
         lite-xl
         lua # liblua.so
         mbedtls libmbedcrypto.so libmbedtls.so libmbedx509.so
         xz liblzma.so
         zlib libz.so)
makedepends=(meson)
_archive="$pkgname-$pkgver"
source=("$url/archive/v$pkgver/$_archive.tar.gz")
sha256sums=('0df5649c703c7e4ed675f58c16ab13a3f52b5530c0e5388dc8d2cf7e37fd1b7f')

build() {
	local meson_opts=(
		install_plugin=true
		static=true
	)
	arch-meson "$_archive" build ${meson_opts[@]/#/-D }
	meson compile -C build
}

package() {
	meson install -C build --destdir "$pkgdir" --skip-subprojects
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$_archive/LICENSE"
}
