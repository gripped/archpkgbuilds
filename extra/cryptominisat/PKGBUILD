# Contributor: Kyle Keen <keenerd@gmail.com>

pkgname=cryptominisat
pkgver=5.14.7
pkgrel=1
_cadiback=35f027383abf3b4b52bbc8af789c8f1aa3d84ad2
_cadical=ade472d3dba145fd53c19d486f5916b6259449c6
pkgdesc='A modern, multi-threaded, feature-rich, simplifying SAT solver'
arch=(x86_64)
url='https://github.com/msoos/cryptominisat/'
license=(MIT)
depends=(glibc
         gmp
         libgcc
         libstdc++
         zlib)
makedepends=(cmake
             git
             help2man
             python-build
             python-installer
             python-scikit-build-core
             vim)
optdepends=('python: python module')
source=(git+https://github.com/msoos/cryptominisat#tag=release/v$pkgver
        git+https://github.com/meelgroup/cadiback#commit=$_cadiback
        git+https://github.com/meelgroup/cadical#commit=$_cadical
        python-build-cmake.patch)
sha256sums=('da5a43e1524ff8f22048833d5a6038d459fe79cd950c5f5c87781e81aebaec15'
            'b9baf02d07f1e302e2bf67212041c14b8e43d6c2edf480f982f47dd8a7ea4bd4'
            '2005f05dd48ca5616a22dda2945c41b613ecf808a98fd6ea503df13b5a400119'
            'aeedc706439cdeb162bedac5dbe90d1a639fa3d378ee833cb59565bc2b97d418')
options=(!lto)

prepare() {
  cd $pkgname
  patch -p1 -i ../python-build-cmake.patch # Link python extension to shared library
}

build() {
  cmake -B build-cadical -S cadical \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build-cadical
  DESTDIR="$PWD/install-cadical" cmake --install build-cadical

  cmake -B build-cadiback -S cadiback \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Dcadical_DIR="$PWD/install-cadical/usr"
  cmake --build build-cadiback
  DESTDIR="$PWD/install-cadiback" cmake --install build-cadiback

  cmake -B build -S $pkgname \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Dcadical_DIR="$PWD/install-cadical/usr" \
    -Dcadiback_DIR="$PWD/install-cadiback/usr"
  cmake --build build

  cd $pkgname
  python -m build --wheel --no-isolation
}

check() {
  cd $pkgname
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  LD_LIBRARY_PATH="$PWD"/../build/lib \
  test-env/bin/python python/tests/test_pycryptosat.py
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 $pkgname/LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
}
