# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-voice-note
pkgver=6.5.64
pkgrel=1
pkgdesc='A lightweight memo tool to make text notes and voice recordings'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-voice-note"
license=('BSD-3-Clause' 'CC0-1.0' 'GPL-3.0-or-later' 'LGPL-3.0-or-later' 'MIT')
replaces=('deepin-voice-recorder')
depends=('dtk6core' 'dtk6gui' 'dtk6widget' 'qt6-base' 'qt6-multimedia' 'qt6-declarative'
         'qt6-webchannel' 'qt6-webengine' 'dtk6declarative' 'gstreamer' 'glib2' 'glibc' 'hicolor-icon-theme'
         'libgcc' 'libstdc++' 'deepin-movie')
makedepends=('git' 'cmake' 'gmock' 'gtest' 'ninja' 'qt6-tools' 'vlc')
groups=('deepin-extra')
source=("git+https://github.com/linuxdeepin/deepin-voice-note.git#tag=$pkgver")
sha512sums=('f269908974f14bd30d6410e1c40e77f5acc5bb0c340af467befecb95efcd7856707a9d43525df7f90599b7873b59f9de69337a24a209164b3e575c486b36b42d')

prepare() {
  cd deepin-voice-note

  # Fix missing QJsonDocument include needed by vnotea2tmanager.cpp:
  # https://github.com/linuxdeepin/deepin-voice-note/commit/246d0f7167f04ee16f2163e7c140b6a1a4b80dd8
  git cherry-pick -n 246d0f7167f04ee16f2163e7c140b6a1a4b80dd8
}

build() {
  cd deepin-voice-note
  cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DVERSION=$pkgver .
  ninja
}

check() {
  cd deepin-voice-note
  ninja test || :
}

package() {
  cd deepin-voice-note
  DESTDIR="$pkgdir" ninja install
}
