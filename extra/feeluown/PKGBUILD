pkgver=5.0
pkgrel=1
pkgdesc="A robust, user-friendly and hackable music player"
arch=('any')
url="https://github.com/feeluown/FeelUOwn"
license=('GPL-3.0-or-later')
depends=('python' 'python-qasync' 'python-pyqt6' 'mpv' 'python-janus'
         'python-requests' 'python-tomlkit' 'python-packaging' 'python-pydantic'
         'python-mutagen' 'qt6-svg' 'xdg-user-dirs')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-langchain' 'python-langchain-openai' 'python-langgraph'
              'python-pytest' 'python-pytest-asyncio' 'python-pytest-benchmark'
              'python-pytest-cov' 'python-pytest-mock' 'python-pytest-qt'
              'python-json-rpc' 'xorg-server-xvfb' 'yt-dlp')
optdepends=('yt-dlp: browser cookie extraction support'
            'dbus-python: mpris2 server support'
            'python-langchain: AI copilot support'
            'python-langchain-openai: OpenAI-compatible models for AI copilot support'
            'python-langgraph: AI copilot support'
            'python-pyqt6-webengine: web login support'
            'python-sanic: webserver support'
            'python-json-rpc: webserver support'
            'python-websockets: webserver support'
            'feeluown-netease' 'feeluown-qqmusic' 'feeluown-ytmusic' 'feeluown-bilibili')
conflicts=('feeluown-local')
provides=('feeluown-local')
replaces=('feeluown-local')
groups=('feeluown-full')
source=(
  "$pkgname::git+https://github.com/feeluown/FeelUOwn.git#tag=v$pkgver"
  "FeelUOwn.desktop"
)
sha512sums=('2287d104242b309149b975b3a5ffc8b00d56fcc1c50a7c640abd2eeba51127ee594cc465f0f6250b9ddad29c4659804aba3a36e7fce4f388e4943a6d1e12af2f'
            '48882f7469c22e5db332663bc1aa8b398b0a10a0c929d4d7e3d7b8b91205d7d3070c5fa295cb9a14f8c352bff57978bfaad167343e0ddc51c92417eda07c8087')

prepare() {
  cd $pkgname

  # Match upstream PR #996: TableMetaWidget expects a parent in this test.
  sed -i \
    -e '/^import pytest/a from PyQt6.QtWidgets import QWidget' \
    -e 's/widget = TableMetaWidget(app_mock)/p_widget = QWidget()\n    widget = TableMetaWidget(app_mock, p_widget)/' \
    -e 's/qtbot.addWidget(widget)/qtbot.addWidget(p_widget)/' \
    tests/gui/widgets/test_meta.py
  # Backport cfe565b's Python 3.14 task-callback wait for this test.
  sed -i '/await task_spec\._task  # this is a little bit tricky/a\
    # On Python 3.14, done-callback execution can lag behind the awaited\
    # executor future, so poll briefly for side effects from _on_songs_fetched.\
    for _ in range(20):\
        if mock_fm_add.called:\
            break\
        await asyncio.sleep(0.01)' tests/player/test_fm.py
  # TODO: figure out how to use virtual audio output
  sed -i 's/cannot_play_audio = is_travis_env/cannot_play_audio = os.environ.get("CANNOT_PLAY_AUDIO") == "1"/' tests/helpers.py
}

build() {
  cd $pkgname
  python -m build --wheel --no-isolation
}

check() {
  cd $pkgname
  CANNOT_PLAY_AUDIO=1 xvfb-run pytest --deselect=tests/test_bench.py
}

package() {
  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 feeluown/gui/assets/icons/feeluown.png -t "$pkgdir"/usr/share/icons/hicolor/512x512/apps/
  install -Dm644 "$srcdir"/FeelUOwn.desktop -t "$pkgdir"/usr/share/applications/
}
