# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=2.2.1
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('793912e5331ca0058cc0d9ba414f2ce88fd6ea6cc00895e2a2c7d1d1f5fbf59d8f8bbd80766f020031b1a2fec3866f8d9b65e6ca1bb7d1c2c22feff4815b5851')
b2sums=('aa33927128e457d8136ce74cdbb22693bb81a28f8b869ce540b57b0ed8b0163c751476f83c9e26799034b52eadbd53d59dceccedc14e0c0a14b383e7afcf72dc')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

