# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=2.5.0
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('45f0c2ed4224a2ea1af44871fd61f34fc3189df5e2cd1316fde104692952fde10f8728c3a7a01ad47d3d430e74246eeff35d4caec06d6fe2da28b67879daa1e6')
b2sums=('7cf7c731212bceca65590cfc83d39b062a744672c22e311aeca6b87e109f626b00531820cd19e8ae8fad5615f7643b2e72594f1dc0206abf4ba6bf4fa05c5987')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

