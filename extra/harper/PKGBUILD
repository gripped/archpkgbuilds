# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=2.12.0
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('ebe2fa10404ee93467bace6b0497837162d3fab167b8e09c1c636aa7c60da60cdb38212895fa89d7ea69b18e9761b9f3ad61d98444eeeac399c2fed80928b5d5')
b2sums=('b4f6222a3abc7a7445ea3d460e232259a31d9ab1f629c931e215d8cd405c1a8cfae229f44c2d31787d6060db016dcabc84358bef87210fafb0dd46e12ca5e0fc')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

