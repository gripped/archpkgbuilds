# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=3.1.0
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('771bebf40347c99968e44e79617bf3b300c88d774fa32e5bf125d0ec63f589ce8b2915ca244a1c198ccc82ab99e22fd81c13d0becbe9120f13738a684f690bf9')
b2sums=('d67ab112832ef90a36ae08e41a8d18d3dc38c6a1e8cb340f0d014d89a52dd17645b6687a29afe66636963b787c39d626e196084879e0207b609a6eac8438b468')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

