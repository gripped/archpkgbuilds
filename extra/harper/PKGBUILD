# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=2.9.1
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('ba26383faeeb5e57a7c482a5485bdb2ecfd984fee0e8d9a8bba45a5cf5d7a50fca554ba0d16782a1b635ad9c8adcdba495d976c365fbd55df7c5918b9060599c')
b2sums=('7bef90a03e7cee9856ae0560f80495171cd30311ae1933c441f2ae8c86d19fedbd03e5a8d53d42de87eb769c480f0a645e87a3fa017a6fc8e0e07a046756aa12')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

