# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=2.2.0
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('0334979b728829275090f1a037eb951c6866b18b74a77f41100bf6cb546388f7707b1233b04e8ecfafc162f960ba000e64f9e19f35c18d12699dadc751effa38')
b2sums=('d5a0aec558de32adb0b22154cf9b494cf940a2f04470421107c74b069c3843348cac10f12dde5ff023f3e706e07e30233b3addc9c370f0cf50d9670c817e3548')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

