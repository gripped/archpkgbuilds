# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=3.3.0
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('b52fa8867bba202223a6dd09715ddd0de5e509429be2b03309e8ef645616806dc4d10a46bf9a5f0001788be2bccec0c37cd76341d508afbdc9e65e74038b074a')
b2sums=('68aa5556ebd13b4f23b6eff503e10816d75931c89181edcad7c75896e540c46f75239af344223b628c0f305201d052d40d5c8011a9ad44dc2db7af54720e0dbe')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

