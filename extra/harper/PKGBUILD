# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=2.4.0
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('62e9f321ce8bc16e8df5df51d830a71ba7ff5b825f6b499434a7367e2a5a0ea6364d57d1fd25fc4e73e5c837a6219dc9cc6b6761fb4f485eb939d43db69668ac')
b2sums=('81dfc8ee513b606f236b580182b083da1b46bcb33b5568b65205bdf2863af2544663fecdb81267a718f1e5c8c6304db827fdb8a01e71c0a60537ab50ef47e72d')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

