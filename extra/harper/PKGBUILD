# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=2.3.1
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('74447e5f4aae23bd28db13b49e024bb696d9b7e55e6790607d1c2a3eb2ea662a1c62b251119c276c2ecdec2446ab28f34948a67da3a2a8c49b1c5d8c758add7e')
b2sums=('07bd5ae6193205d891ccc1ad58cb4ffc89b8be9c8560e05506079c748a3bb6b6d28d0e7cf11f6fc7f584fe83f4464f4dd5d4d1d950de74e8e710ec42b95e026d')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

