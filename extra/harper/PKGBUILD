# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=2.8.0
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('fbe372f65a4b5bd3ce243191bb34b2843115df5baa36f22712248903acd9b0451896b9c37b3defaa78511d4cb18179fd9af15a9aa56b4e3ecc76fc8cd4206185')
b2sums=('d54bde0620928bd3c437062db9f4b47b3eac393b016383fcb29931dedd265cc5c546b17d1f83a858d91c4ec627a28d79375b1ca61e2b8636d997b65019cddf6c')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

