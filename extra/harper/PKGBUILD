# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=2.6.0
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('43ced4bc024cf1cf8aeaa3c96a019f681ec6bab877d787ecd575a895ea0ae3aed5ccc93fac1dd8820023de81d239a39e2872ef2814f040598d9fdb4f59fbc059')
b2sums=('1beb9cccb55c6cfcd6adeb3c3c13bec3e16cb03a2f4b877ca82a58a16f34708df401e1c659f8df2ec1f48d3a4031e2d5467e2618007d6584401a8259c9d71071')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

