# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=3.0.0
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('e4b4a710fa8776e0bde90199351625c590c9a755fe2feb4d4b96ba494a2c066d3ef65f27f784258a31a97c5002a6d727fdfcfbbe84ac08c40a0880a7b3264304')
b2sums=('aa6296fe04098eae0dbac830569320e516c9db5dbc913e8830452a733bdbbe7658a91d094b9a3d7dd37e1b1a22affb1074ab01e9190c9affe91c542940ae390e')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

