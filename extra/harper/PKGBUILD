# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=2.11.0
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('f9ba53446d0dfd163d8cbecdcb83c18585944957128425b1d7be24d1d01148cb2fdb76d5021c478d81b89c800904a37c2adcabf085d0dcb35f359862de9431c8')
b2sums=('df818784b79cc39c8ac54f2b3b79bfb40144622bf7cf0afedf6e5c696beb934951a31b4c425e6c9e075b69ef2c2de07bf9a5ac3cd2805c94f67f46994127af01')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

