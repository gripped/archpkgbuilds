# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=2.10.0
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('3e7c0e5111a37a8b4a6a11dfbfa797b644789134c0a835518a68b19b717915944594ee13881712b71219e4459ada99312d88271e0fa8afb027f0506de9d4a629')
b2sums=('5691cb83d5cb2fa99ce4804e22a7d71a91b31a576076594bb318814213197d77c24224b826cdd38f7e67bb2ff3b30f7cd28a6dc2be649e289941e9e73e19744a')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

