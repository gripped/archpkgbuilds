# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=harper
pkgver=2.7.0
pkgrel=1
pkgdesc='The Grammar Checker for Developers'
arch=(x86_64)
url='https://github.com/Automattic/harper'
license=(Apache-2.0)
depends=(
  glibc
  libgcc
)
makedepends=(
  git
  rust
  gtk3
  webkit2gtk-4.1
)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('4f249329bbe754c5c0421c657acfb43ce3f05b948d106d310bfc77263436c4ccf58d843fea3db57b2c621c5ccf32771f66deb50d33e93bde4966bc3e11c487a2')
b2sums=('f5c273e14a8edde4907e91f92a4577097ec3e2e34944daed1d573d305a0755b21c2a877ceb416d4f91c938871020125ddfb85a43cf783a48c6d534db81d39831')

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  install -Dm 755 -t "$pkgdir/usr/bin" \
    target/release/harper-cli \
    target/release/harper-ls
}

