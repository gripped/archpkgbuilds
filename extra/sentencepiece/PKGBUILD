# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgbase=sentencepiece
pkgname=('sentencepiece' 'python-sentencepiece')
pkgver=0.2.3
pkgrel=1
pkgdesc="Unsupervised text tokenizer and detokenizer"
arch=('x86_64')
url="https://github.com/google/sentencepiece"
license=('Apache-2.0')
depends=('abseil-cpp' 'glibc' 'libgcc' 'libstdc++' 'protobuf')
makedepends=('cmake' 'git' 'ninja' 'pybind11' 'python-build' 'python-installer'
             'python-setuptools' 'python-wheel')
checkdepends=('python-numpy' 'python-protobuf' 'python-pytest')
source=("git+https://github.com/google/sentencepiece.git#tag=v$pkgver"
        'python-shared-libraries.patch'
        'dont-include-data-files-in-python-pkg.patch')
sha512sums=('8957519afecb564e1f12f5cf90c806ba4a8b4fac6429b4780d079cd8f482bcd01167ca2b14a7e99b86c5f84ccd12ac171bebc1c5079968152dd4ddc25fa7f714'
            '6e06b066a720e64dddbb1f37bcddbb6ed3e598721654bf715954cfb0765ad56b93dabee1d4058e587b6991f8ee92e6f0101dd221c920b17cb439737b5fdd4e72'
            '6fd675cf0187c2ddc0919e7c1aeb47768d4e3a0d7d8613215896678d489fb815de8473f6e6d6b611b4c269f135f7feca5c70b69c9e331123026caa3cd1afd871')

prepare() {
  cd sentencepiece
  # Allow system pybind11 despite upstream's reported batch decode/piece_to_id slowdown.
  # https://github.com/google/sentencepiece/commit/eafd99cf3b8bfa5101c2c5f42aab2cc39947938d
  git revert -n eafd99cf3b8bfa5101c2c5f42aab2cc39947938d
  # Link the Python extension to shared SentencePiece libraries.
  patch -p1 -i "$srcdir/python-shared-libraries.patch"
  # `sentencepiece` has data files, don't include them in `python-sentencepiece`
  patch -p1 -i "$srcdir/dont-include-data-files-in-python-pkg.patch"
}

build() {
  cd sentencepiece
  # Preserve Protobuf's transitive Abseil dependencies and legacy generation helpers.
  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_FIND_PACKAGE_PREFER_CONFIG=ON \
    -Dprotobuf_MODULE_COMPATIBLE=ON \
    -DSPM_ABSL_PROVIDER=package \
    -DSPM_PROTOBUF_PROVIDER=package \
    -DSPM_ENABLE_TCMALLOC=OFF \
    -DSPM_BUILD_TEST=ON
  cmake --build build

  cd python
  python -m build --wheel --no-isolation
}

check() {
  cd sentencepiece
  ctest --test-dir build --output-on-failure

  cd python
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  LD_LIBRARY_PATH="$srcdir/sentencepiece/build/src" test-env/bin/python -m pytest
}

package_sentencepiece() {
  cd sentencepiece
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_python-sentencepiece() {
  pkgdesc="Python bindings for SentencePiece"
  depends+=('python' 'sentencepiece')
  optdepends=('python-numpy: NumPy array support'
              'python-protobuf: model and token protocol buffers')

  cd sentencepiece
  python -m installer --destdir="$pkgdir" python/dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
