# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgbase=sentencepiece
pkgname=('sentencepiece' 'python-sentencepiece')
pkgver=0.2.2
pkgrel=1
pkgdesc="Unsupervised text tokenizer and detokenizer"
arch=('x86_64')
url="https://github.com/google/sentencepiece"
license=('Apache-2.0')
depends=('abseil-cpp' 'glibc' 'libgcc' 'libstdc++' 'protobuf')
makedepends=('cmake' 'git' 'ninja' 'pybind11' 'python-build' 'python-installer'
             'python-setuptools' 'python-wheel')
checkdepends=('python-numpy' 'python-protobuf' 'python-pytest')
source=("git+https://github.com/google/sentencepiece.git#tag=v$pkgver"
        'python-shared-libraries.patch')
sha512sums=('8a1b21e382b7e4649e406ed6d9cc2121df12c4c8b3e35524eaedc794539d1031afbd06e826aa25463ceb71ed556b2a4cd804253c4eb012b6ceca9ba79e644f42'
            '2c24b446ca3639d608034b2711dbbfe86ca3175148256cf34fa070e6f77421c24a40915796f103a6b94ae11f3907f5b18df5b1d85300e4ee3133b1d26aa5584c')

prepare() {
  cd sentencepiece
  # Link the Python extension to shared SentencePiece, Abseil and Protobuf libraries.
  patch -p1 -i "$srcdir/python-shared-libraries.patch"
}

build() {
  cd sentencepiece
  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DSPM_ABSL_PROVIDER=package \
    -DSPM_PROTOBUF_PROVIDER=package \
    -DSPM_ENABLE_TCMALLOC=OFF \
    -DSPM_BUILD_TEST=ON
  cmake --build build

  cd python
  python -m build --wheel --no-isolation
}

check() {
  cd sentencepiece
  ctest --test-dir build --output-on-failure

  cd python
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  LD_LIBRARY_PATH="$srcdir/sentencepiece/build/src" test-env/bin/python -m pytest
}

package_sentencepiece() {
  cd sentencepiece
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_python-sentencepiece() {
  pkgdesc="Python bindings for SentencePiece"
  depends+=('python' 'sentencepiece')
  optdepends=('python-numpy: NumPy array support'
              'python-protobuf: model and token protocol buffers')

  cd sentencepiece
  python -m installer --destdir="$pkgdir" python/dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
