package_python-opentelemetry-exporter-http-transport() {
  pkgdesc="OpenTelemetry Exporters HTTP transport"
  depends+=('python-opentelemetry-api')
  optdepends=(
    'python-requests: requests HTTP transport'
    'python-urllib3: urllib3 HTTP transport'
  )

  cd opentelemetry-python/exporter/opentelemetry-exporter-http-transport
  python -m installer --destdir="$pkgdir" dist/*.whl
}

