# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-langgraph
pkgver=1.2.22
pkgrel=1
pkgdesc="Building stateful, multi-actor applications with LLMs"
arch=('any')
url="https://github.com/langchain-ai/langgraph/tree/main/libs/langgraph"
license=('MIT')
depends=(
  'python'
  'python-langchain-core'
  'python-langgraph-checkpoint'
  'python-langgraph-prebuilt'
  'python-langgraph-sdk'
  'python-pydantic'
  'python-typing_extensions'
  'python-xxhash'
)
makedepends=(
  'git'
  'python-build'
  'python-hatchling'
  'python-installer'
  'python-wheel'
)
checkdepends=(
  'pifpaf'
  'python-anyio'
  'python-httpx'
  'python-langgraph-checkpoint-postgres'
  'python-langgraph-checkpoint-sqlite'
  'python-pycryptodome'
  'python-pytest'
  'python-pytest-mock'
  'python-pytest-xdist'
  'python-redis'
  'python-syrupy'
  'valkey'
)
source=("git+https://github.com/langchain-ai/langgraph.git#tag=$pkgver")
sha512sums=('af27304b33cbe42498f594ac1a651680361f2941b1badd99bad8e6922bafbfc8edfbaaf16f697680aebf5841b90454f6aff03d4e05db293e1c3c7ce2b5d2727e')

prepare() {
  cd langgraph

  # Keep Redis cache tests enabled with local Valkey in upstream's no-Docker mode.
  sed -i \
    's/params=\["sqlite", "memory"\] if NO_DOCKER else \["sqlite", "memory", "redis"\]/params=["sqlite", "memory", "redis"]/' \
    libs/langgraph/tests/conftest.py
}

build() {
  cd langgraph/libs/langgraph
  python -m build --wheel --no-isolation
}

check() {
  cd langgraph/libs/langgraph
  NO_DOCKER=true pifpaf run redis --port 6379 -- python -m pytest
}

package() {
  cd langgraph/libs/langgraph
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
