pkgname=pantheon-bluetooth-daemon
pkgver=1.1.0
pkgrel=1
pkgdesc='Send and receive files via Bluetooth for Pantheon'
arch=(x86_64)
url=https://github.com/elementary/bluetooth-daemon
license=(GPL-3.0-or-later)
groups=(pantheon)
depends=(
  dconf
  glib2
  glibc
  granite
  gtk3
  libgee
  hicolor-icon-theme
)
makedepends=(
  git
  meson
  vala
)
source=(pantheon-bluetooth-daemon::git+https://github.com/elementary/bluetooth-daemon.git#tag=${pkgver})
b2sums=('251172bd0a8788a9211e7d236df558978224da4168ddab4399c629715979921101ae8cfb0390256baa9555bb3370bb000458c3f3393be14a69f0718dc345e4fc')

build() {
  arch-meson pantheon-bluetooth-daemon build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
