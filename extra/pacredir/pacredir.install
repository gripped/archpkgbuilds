#!/bin/sh

post_install() {
  cat <<-EOM
	 > For instructions see section 'Usage' in:
	 >  /usr/share/doc/pacredir/README.md
	 > ... or visit:
	 >  https://github.com/eworm-de/pacredir#usage
	EOM
}

post_upgrade() {
  # return if old package version greater 0.7.13...
  (( $(vercmp $2 '0.7.13') > 0 )) && return

  # update pacredir.conf
  sed -i '/^\[general\]$/s|^|# Removed with version 0.7.13!\n#|' /etc/pacredir.conf
}
