prepare() {
  cd logfire
  # Close async SQLite connections before test teardown.
  patch -p1 -i "$srcdir/sqlalchemy-tests.patch"
  # Update usage.speed snapshots and beta cassette URLs for current Anthropic.
  # Beta URL change: https://github.com/anthropics/anthropic-sdk-python/pull/1076
  patch -p1 -i "$srcdir/anthropic-tests.patch"
}

build() {
  cd logfire
  python -m build --wheel --no-isolation logfire-sdk
  python -m build --wheel --no-isolation logfire
  python -m build --wheel --no-isolation logfire-api
}

check() {
  cd logfire
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer logfire-sdk/dist/*.whl
  test-env/bin/python -m installer logfire/dist/*.whl
  test-env/bin/python -m installer logfire-api/dist/*.whl

  # Skip integrations with unpackaged dependencies.
  # The editable-install test requires a source install.
  PATH="$PWD/test-env/bin:$PATH" test-env/bin/python -m pytest \
    --ignore=tests/otel_integrations/test_celery.py \
    --ignore=tests/otel_integrations/test_claude_agent_sdk.py \
    --ignore=tests/otel_integrations/test_dspy.py \
    --ignore=tests/otel_integrations/test_google_genai.py \
    --ignore=tests/otel_integrations/test_litellm.py \
    --ignore=tests/otel_integrations/test_litestar.py \
    --ignore=tests/otel_integrations/test_monty.py \
    --ignore=tests/otel_integrations/test_mysql.py \
    --ignore=tests/otel_integrations/test_openai_agents.py \
    --ignore=tests/otel_integrations/test_openai_agents_mcp.py \
    --ignore=tests/otel_integrations/test_pydantic_ai.py \
    --ignore=tests/otel_integrations/test_pydantic_ai_mcp.py \
    --ignore=tests/otel_integrations/test_redis.py \
    --ignore=tests/otel_integrations/test_snowflake.py \
    --ignore=tests/otel_integrations/test_surrealdb.py \
    --ignore=tests/test_agent_sandboxes.py \
    --deselect=tests/test_distribution_metadata.py::test_editable_sdk_uses_the_source_tree \
    --deselect=tests/test_docs.py::test_runnable \
    --deselect=tests/test_logfire_api.py::test_runtime
}

package_python-logfire() {
  pkgdesc='Pydantic Logfire command-line interface'
  depends=('python' 'python-logfire-sdk')

  cd logfire
  python -m installer --destdir="$pkgdir" logfire/dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

package_python-logfire-api() {
  pkgdesc='Pydantic Logfire API shim'
  depends=('python')
  optdepends=('python-logfire-sdk: Logfire SDK integration')

  cd logfire
  python -m installer --destdir="$pkgdir" logfire-api/dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

package_python-logfire-sdk() {
  pkgdesc='Pydantic Logfire Python SDK'
  optdepends=(
    'python-anthropic: Anthropic instrumentation'
    'python-genai-prices: LLM usage cost calculation'
    'python-httpx: query clients and gateway support'
    'python-loguru: Loguru logging integration'
    'python-mcp: MCP 1 instrumentation'
    'python-openai: OpenAI instrumentation'
    'python-opentelemetry-instrumentation-aiohttp-client: aiohttp client instrumentation'
    'python-opentelemetry-instrumentation-aiohttp-server: aiohttp server instrumentation'
    'python-opentelemetry-instrumentation-asgi: ASGI instrumentation'
    'python-opentelemetry-instrumentation-asyncpg: asyncpg instrumentation'
    'python-opentelemetry-instrumentation-aws-lambda: AWS Lambda instrumentation'
    'python-opentelemetry-instrumentation-django: Django instrumentation'
    'python-opentelemetry-instrumentation-fastapi: FastAPI instrumentation'
    'python-opentelemetry-instrumentation-flask: Flask instrumentation'
    'python-opentelemetry-instrumentation-httpx: HTTPX instrumentation'
    'python-opentelemetry-instrumentation-psycopg: Psycopg 3 instrumentation'
    'python-opentelemetry-instrumentation-psycopg2: Psycopg 2 instrumentation'
    'python-opentelemetry-instrumentation-pymongo: PyMongo instrumentation'
    'python-opentelemetry-instrumentation-requests: Requests instrumentation'
    'python-opentelemetry-instrumentation-sqlalchemy: SQLAlchemy instrumentation'
    'python-opentelemetry-instrumentation-sqlite3: SQLite3 instrumentation'
    'python-opentelemetry-instrumentation-starlette: Starlette instrumentation'
    'python-opentelemetry-instrumentation-system-metrics: system metrics'
    'python-opentelemetry-instrumentation-wsgi: WSGI instrumentation'
    'python-pyarrow: Arrow query results'
    'python-pydantic: Pydantic validation instrumentation'
    'python-pydantic-handlebars: managed variables and templates'
    'python-pytest: pytest fixtures and instrumentation'
    'python-starlette: gateway and ASGI forwarding support'
    'python-structlog: structlog logging integration'
    'uvicorn: gateway server'
  )

  cd logfire
  python -m installer --destdir="$pkgdir" logfire-sdk/dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
