# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-image-viewer
pkgver=6.0.36
pkgrel=1
pkgdesc='An image viewing tool with fashion interface and smooth performance'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-image-viewer"
license=('GPL-3.0-or-later')
depends=('deepin-qt6integration' 'qt6-base' 'qt6-declarative' 'qt6-5compat'
         'qt6-imageformats' 'qt6-svg' 'dtk6core' 'dtk6gui' 'dtk6widget'
         'dtk6declarative' 'glibc' 'libgcc' 'libstdc++'
         'libgl' 'libraw' 'hicolor-icon-theme')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools')
optdepends=('deepin-manual: for help manual'
            'deepin-shortcut-viewer: for shortcut display'
            'kimageformats: support for additional image formats')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/deepin-image-viewer.git#tag=$pkgver"
        "$pkgname-6.0.1-fix-missing-qt-includes.patch"
        "$pkgname-6.0.0-disable-ocr-plugin-manager.patch")
sha512sums=('49d34cde9eba4ded4ba9b6835bf2335d5dd7c84e27ae548c624dcd61fda03d9c2c06813212216a17b234b0f347e4978849c7d3837e2f919e07e08477cb8c0bc4'
            'b327d66c0324be7f69d433e5a294f85917553a325161a1d19763b9e2c19af62b0c5c92d18d4d7982198fc33b1654a82e5e35a856660f8b11f9567af8b7208224'
            'defc3c5651fa622aaf3f34255bf78109c40a2a5791b471d1c8c88cc485f27bf1db3eecec0c8d05c137b093c4bb3a588a56563ed317875f3e40d8cc5cd2552de0')

prepare() {
  cd deepin-image-viewer
  # Fix missing Qt includes for QMimeData and QJson classes.
  git apply ../$pkgname-6.0.1-fix-missing-qt-includes.patch
  # GCC 16 requires the QStandardPaths declaration to be included directly.
  sed -i '/#include <QMimeData>/a #include <QStandardPaths>' src/src/filecontrol.cpp
  # deepin-ocr-plugin-manager is not packaged, so disable OCR integration and UI.
  git apply ../$pkgname-6.0.0-disable-ocr-plugin-manager.patch
}

build() {
  cmake -B build -S deepin-image-viewer -GNinja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
