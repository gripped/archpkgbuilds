# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=libretro-beetle-pce
pkgver=20260411.153115.gae99235c2139
pkgrel=1
pkgdesc='NEC PC Engine/SuperGrafx/CD core'
arch=(x86_64)
url=https://github.com/libretro/beetle-pce-libretro
license=(GPL-2.0-only)
groups=(libretro)
depends=(
  glibc
  libgcc
  libretro-core-info
  libstdc++
  zlib
)
makedepends=(git)
source=(libretro-beetle-pce::git+https://github.com/libretro/beetle-pce-libretro.git#commit=${pkgver##*.g})
b2sums=('f9137ccaebd140318ba71f274082a86345302f0096f7b217a9ea7f557d7d4d98ec810fe24e1a507e67c59f9f7764f7206f977d738df21b3f315fe4c83f2a01c1')

build() {
  make \
    SYSTEM_LIBCHDR=0 \
    SYSTEM_ZLIB=1 \
    -C libretro-beetle-pce
}

package() {
  install -Dm 644 libretro-beetle-pce/mednafen_pce_libretro.so -t "${pkgdir}"/usr/lib/libretro/
}

