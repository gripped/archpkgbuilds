pkgname=libretro-beetle-pce
pkgver=20260904.122703.g6d6a35eb802e
pkgrel=1
pkgdesc='NEC PC Engine/SuperGrafx/CD core'
arch=(x86_64)
url=https://github.com/libretro/beetle-pce-libretro
license=(GPL-2.0-only)
groups=(libretro)
depends=(
  glibc
  libgcc
  libretro-core-info
  libstdc++
  zlib
)
makedepends=(git)
source=(libretro-beetle-pce::git+https://github.com/libretro/beetle-pce-libretro.git#commit=${pkgver##*.g})
b2sums=('1fe6359d93c0d818d32b71caf600f5f086783e63a5695129f9f9ccc5222df2c1ec256607c6fe700f6cfdc66bfdad449d5fa386a4e19a124f6d8dca8d4e7ec5d5')

build() {
  make \
    SYSTEM_LIBCHDR=0 \
    SYSTEM_ZLIB=1 \
    -C libretro-beetle-pce
}

package() {
  install -Dm 644 libretro-beetle-pce/mednafen_pce_libretro.so -t "${pkgdir}"/usr/lib/libretro/
}

