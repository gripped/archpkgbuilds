# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=pika-backup
pkgver=0.8.2
pkgrel=1
pkgdesc='Easy to use backup tool to keep your data safe'
arch=(x86_64)
url='https://apps.gnome.org/PikaBackup/'
license=(GPL-3.0-only)
groups=(gnome-circle)
depends=(
  borg
  glib2
  glibc
  gtk4
  gvfs
  hicolor-icon-theme
  libadwaita
  libgcc
  openssh
  openssl
  pango
  python-pyfuse3
)
makedepends=(
  appstream
  git
  itstool
  meson
  rust
)
checkdepends=(xorg-server-xvfb)
source=("git+https://gitlab.gnome.org/World/pika-backup.git#tag=$pkgver")
b2sums=(df3b70e8592995293478642261ff338d94b6722827e29bca80e85fc750787b0a77b2c94e072aa03fe53097eb0e1237118e19e99fa9200ab5fd0dc6ef7f2004e6)

prepare() {
  cd $pkgname

  CARGO_HOME="$srcdir/build/cargo" \
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  arch-meson $pkgname build

  CARGO_PROFILE_RELEASE_LTO=true \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
    CARGO_PROFILE_RELEASE_DEBUG=2 \
    CARGO_PROFILE_RELEASE_STRIP=false \
    meson compile -C build
}

check() {
  dbus-run-session xvfb-run \
    -s '-screen 0 1920x1080x24 -nolisten local' \
    meson test -C build --print-errorlogs --no-rebuild
}

package() {
  meson install -C build --destdir "$pkgdir" --no-rebuild
}
