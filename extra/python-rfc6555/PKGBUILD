# Maintainer: Jaroslav Lichtblau <svetlemodry@archlinux.org>

pkgname=python-rfc6555
pkgver=0.1.0
pkgrel=7
arch=('any')
url="https://pypi.org/project/rfc6555/"
license=('Apache-2.0')
pkgdesc="Python implementation of the Happy Eyeballs Algorithm described in RFC 6555."
depends=('python')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
source=("https://github.com/sethmlarson/rfc6555/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('8a15da0f619227c6938be27c64e844668701bca65205002eda789a4fd883b23f')

build() {
  cd rfc6555-${pkgver}
  python -m build --wheel --no-isolation
}

check() {
  cd rfc6555-${pkgver}
  pytest
}

package() {
  cd rfc6555-${pkgver}
  python -m installer --destdir="${pkgdir}" dist/*.whl
}
