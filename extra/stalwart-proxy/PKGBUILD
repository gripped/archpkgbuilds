prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  # unbundle sqlite
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1

  cargo build --frozen --release --all-features
}

package() {
  # systemd integration
  install -vDm644 systemd.service "$pkgdir/usr/lib/systemd/system/$pkgname.service"
  install -vDm644 sysusers.conf "$pkgdir/usr/lib/sysusers.d/$pkgname.conf"
  install -vDm644 tmpfiles.conf "$pkgdir/usr/lib/tmpfiles.d/$pkgname.conf"

  cd "$pkgname"

  # binary
  install -vDm755 target/release/proxy "$pkgdir/usr/bin/stalwart-proxy"

  # configuration
  install -vDm640 resources/config.sample.toml "$pkgdir/etc/stalwart/proxy/config.toml"
  install -vDm640 "$srcdir/config.env" -t "$pkgdir/etc/stalwart/proxy"
  install -vDm640 "$srcdir/mappings.tsv" -t "$pkgdir/etc/stalwart/proxy"

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
  cp -vr img resources "$pkgdir/usr/share/doc/$pkgname"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSES/*
}
