# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-proxy
pkgver=1.0.0
pkgrel=1
pkgdesc='Multi-protocol e-mail migration proxy for Stalwart'
arch=(x86_64)
url='https://stalw.art/docs/migration/proxy'
license=('AGPL-3.0-only AND LicenseRef-SELv1')
depends=(glibc libgcc sqlite)
makedepends=(git rust)
backup=(
  etc/stalwart/proxy/config.toml
  etc/stalwart/proxy/config.env
  etc/stalwart/proxy/mappings.tsv
)
options=(!lto)
install=package.install
source=(
  "$pkgname::git+https://github.com/stalwartlabs/proxy#tag=v$pkgver"
  systemd.service
  sysusers.conf
  tmpfiles.conf
  config.env
  mappings.tsv
)
