pkgname=adguardhome
_name=AdGuardHome
pkgver=1.0.0
pkgrel=2
epoch=1
pkgdesc='Network-wide ads and trackers blocking DNS server'
arch=(x86_64)
url='https://github.com/AdguardTeam/AdGuardHome'
license=(GPL-3.0-only)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
        $pkgname.service
        $pkgname.sysusers)
makedepends=(go nodejs npm git)
depends=(glibc)
b2sums=('1600c4ca653868a62294775841817d1df5e3e2492f29ff7ab6ba2ee16a5ce8849ac627e36ce32c1ebbd011884a5165bdfafade7c198814ae52cc0b7854390984'
        '5c1612f7aad38a0a7833200ad314581717b8f44bc72182a6829f3f0613d66a5954cbf9b8aa90be4c7902b1df624d0e17603821b3ae8a02472f9d36a89ce98d27'
        '39c0caacf9261d1be4668086701b4b207ec63f40f575dd322bdb37b1e6796ab89d7bbc56806867ddf11a0c71bcac5f62629518a3065cbcb2eea340ab8272abb4')

prepare() {
  cd $_name-$pkgver
  npm --prefix client_v2 ci
  export GOPATH="$srcdir"
  go mod download -modcacherw
}

build() {
  cd $_name-$pkgver
  npm --prefix client_v2 run build-prod

  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOPATH="$srcdir"
  go build \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-compressdwarf=false -linkmode external -X 'github.com/AdguardTeam/AdGuardHome/internal/version.version=v$pkgver' -X 'github.com/AdguardTeam/AdGuardHome/internal/version.channel=release' -buildid=''" \
    -o $pkgname
}

package() {
  install -Dm755 $_name-$pkgver/$pkgname "$pkgdir"/usr/bin/$pkgname
  install -Dm644 $pkgname.service "$pkgdir"/usr/lib/systemd/system/$pkgname.service
  install -Dm644 $pkgname.sysusers "$pkgdir"/usr/lib/sysusers.d/$pkgname.conf
  install -dm755 "$pkgdir"/etc
  ln -s /var/lib/$pkgname/$_name.yaml "$pkgdir"/etc/$pkgname.yaml
}

