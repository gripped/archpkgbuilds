pkgname=qwen-code
pkgver=0.23.3
pkgrel=1
pkgdesc='Open-source AI agent for the terminal, optimized for Qwen-Coder'
url='https://github.com/QwenLM/qwen-code'
arch=(x86_64)
license=(Apache-2.0)
depends=(
  libgcc
  libstdc++
  glibc
  nodejs
  procps-ng
  ripgrep
)
makedepends=(
  git
  jq
  npm
)
optdepends=(
  'alsa-utils: voice dictation recording via arecord'
  'npm: optional computer-use tools via npx'
  'sox: voice dictation recording'
)
source=("git+https://github.com/QwenLM/qwen-code.git#tag=v${pkgver}"
        'feishu-media-test.patch')
sha256sums=('45a4a8c982a5ecd581ab6d5ce97a1b88d10690d53e2f3cbb21cffe8e1bf91b75'
            '85935ee339eb53afac83eba367a97d4032905a1dc77a1ac25ea4fb186ef186a8')
b2sums=('ba2cee9365c4ca0b133c6fbf08e1c05907298e7df2aa19a1363abede9ce1c6cde2d4c99cc09bce61ba617c16580b21ab401d3b2638a3110a4923d56b2a5279c9'
        '770fec0cfdc4a0abacd8543edc395ccac7884fa45075e18298abfacab77ded2944fc4407105ef5f2f861b859bdf8d2ec87356340b74680badc3747ed6df77121')

prepare() {
  cd $pkgname
  # Mock Feishu APIs so the media test cannot leak requests into later tests.
  # https://github.com/QwenLM/qwen-code/pull/13170
  patch -p1 -i "$srcdir/feishu-media-test.patch"
  # npm 12 returns pack metadata keyed by package name instead of an array.
  # https://github.com/npm/cli/pull/9247
  sed -i 's/const packs = JSON\.parse(stdout)/const packs = Object.values(JSON.parse(stdout))/' \
    integrations/external-context/src/provider-extension-local.test.ts
  # Node 26.8 fixes ANSI stripping, preserving printable 'b' in this fixture.
  # https://github.com/nodejs/node/pull/64319
  # https://nodejs.org/en/blog/release/v26.8.0
  sed -i "/stripVTControlCharacters matches/,+2d; s/toBe('a[.]md')/toBe('ab.md')/" \
    packages/core/src/memory/memoryDiscovery.test.ts
  # Expect Node 26's Proxy(...) wrappers in the REPL serialization fixture.
  # https://github.com/nodejs/node/pull/61029
  sed -i \
    -e "s/'\[Function (anonymous)\]'/'Proxy([Function (anonymous)])'/" \
    -e "s/'{}'/'Proxy({})'/" \
    packages/node-repl/src/kernel-manager.test.ts
  # Finish the interrupted journal clear so its test releases the directory handle.
  sed -i '/rejects journal directory replacement while clearing phases/,/^  });/ {
    /openMock.mockImplementation(originalOpen);/a\
      await fs.rmdir(journalDirectory);\
      await fs.rename(originalDirectory, journalDirectory);\
      await journal.clear(SESSION_ID, root);
  }' packages/cli/src/serve/conversations/standalone-deletion-journal.test.ts
  # Use DNS SNI for TLS fixtures while preserving their IP Host/Origin assertions.
  # https://github.com/nodejs/node/pull/58533
  sed -i \
    -e 's/{ createServer as createHttpsServer }/{ Agent, createServer as createHttpsServer }/' \
    -e "/describe('remote same-origin over TLS'/,\$s/\.post('\/probe')/&.agent(new Agent({ servername: 'localhost' }))/" \
    packages/cli/src/serve/server/self-origin.test.ts
  # Upstream's ranged override currently resolves newer than package-lock.json.
  npm pkg set 'overrides.@types/react=19.2.10'
  npm clean-install \
    --registry=https://registry.npmjs.org \
    --replace-registry-host=always \
    --include=optional \
    --ignore-scripts
  # Upstream postinstall applies dependency patches; install scripts are disabled above.
  ./node_modules/.bin/patch-package
}

build() {
  cd $pkgname
  npm run build
  npm run bundle
  local bundled=$(jq '.dependencies + .optionalDependencies | keys' package.json)
  npm pkg set --json bundledDependencies="$bundled"
  # npm refuses to pack bundled modules while overrides target bundled deps.
  npm pkg delete overrides
  npm pack --ignore-scripts
  # fakeroot 2.1.4 deadlocks on Btrfs directory removal; stage npm outside fakeroot.
  # https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1153064
  npm install --global --offline --ignore-scripts --prefix "$srcdir/npm/usr" \
    $pkgname-$pkgname-$pkgver.tgz
}

check() {
  cd $pkgname
  # Node 26 exposes Web Storage only when localStorage has a backing file.
  export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--localstorage-file=$PWD/.node-localstorage"
  # Skip remaining clean-chroot failures; no narrow upstream fixes are available.
  # Keep one glob because sdk-typescript's Vitest rejects repeated --exclude.
  local test_exclude='**/{qwenConnectionHandler,useAtCompletion,'
  test_exclude+='serve/acp-http/transport,i18n/index,ui/auth/AuthDialog,'
  test_exclude+='ui/utils/clipboardUtils,'
  # mock-fs fails at import time on Node 26.8+:
  # https://github.com/tschaub/mock-fs/issues/447
  test_exclude+='services/FileCommandLoader,services/FileCommandLoader-extension,'
  test_exclude+='lsp/LspConfigLoader,utils/pathReader}.test.*'
  # yargs 17.7.3 fixes c8's require('yargs/yargs') on Node 26.
  # https://github.com/yargs/yargs/pull/2514
  cp node_modules/yargs/yargs node_modules/yargs/yargs.cjs
  jq '.exports["./yargs"][0].require = "./yargs.cjs" |
      .exports["./yargs"][1] = "./yargs.cjs"' \
    node_modules/yargs/package.json > yargs-package.json
  mv yargs-package.json node_modules/yargs/package.json
  # mobilewright's older Playwright CLI cannot run the newer @playwright/test.
  # https://github.com/QwenLM/qwen-code/pull/11371
  npm pkg set 'scripts.test=c8 node ../../node_modules/@playwright/test/cli.js test' --workspace=@qwen-code/mobile-mcp
  npm run test --workspace=@qwen-code/mobile-mcp
  # mobile-mcp uses Playwright; run it above without passing Vitest-only flags.
  npm pkg set 'workspaces[]=!packages/mobile-mcp'
  # NODE_OPTIONS gives Node's Web Storage one shared backing file; keep Vitest
  # files serial so another jsdom test cannot clear draft storage mid-test.
  npm run test --workspaces --if-present -- --testTimeout=30000 --no-file-parallelism --exclude="$test_exclude"
}

package() {
  cd $pkgname
  cp -a "$srcdir/npm/usr" "$pkgdir/"
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
