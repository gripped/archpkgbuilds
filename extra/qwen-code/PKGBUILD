pkgname=qwen-code
pkgver=0.24.7
pkgrel=1
pkgdesc='Open-source AI agent for the terminal, optimized for Qwen-Coder'
url='https://github.com/QwenLM/qwen-code'
arch=(x86_64)
license=(Apache-2.0)
depends=(
  libgcc
  libstdc++
  glibc
  nodejs-lts-krypton
  procps-ng
  ripgrep
)
makedepends=(
  corepack
  git
  jq
  npm
  pnpm
)
optdepends=(
  'alsa-utils: voice dictation recording via arecord'
  'npm: optional computer-use tools via npx'
  'sox: voice dictation recording'
)
source=("git+https://github.com/QwenLM/qwen-code.git#tag=v${pkgver}"
        'feishu-media-test.patch')
sha256sums=('e0dfad19f5abc36e312377dc77de4624e71e105ecaf82ee6e8e70a36d5212b80'
            '3af81e8d4e27c7b7d10ea5615cd1c469df730aaf1e2f6b5dae5ad2fbf6d0280d')
b2sums=('2cb51b10cb43e974a0654393ab2a2a80abe6d16f94369245a25b1f8233ffaf7c208796335347fc8253b9f2baea350aa47c563b792ee6968916e4ec3be32d47d4'
        '76344e9fd770a54ee0578bc0c66b51dde50aa5dfee0374dcad9860c86608d08c5969785eaf1a04ff371f89aa45e4020027ca8b04f5b318977a4a29c92e360ef8')

prepare() {
  cd $pkgname
  # Mock Feishu APIs so the media test cannot leak requests into later tests.
  # https://github.com/QwenLM/qwen-code/pull/13170
  patch -p1 -i "$srcdir/feishu-media-test.patch"
  # npm 12 returns pack metadata keyed by package name instead of an array.
  # https://github.com/npm/cli/pull/9247
  sed -i 's/const packs = JSON\.parse(stdout)/const packs = Object.values(JSON.parse(stdout))/' \
    integrations/external-context/src/provider-extension-local.test.ts
  # The cumulative-deadline test races its own abort on loaded builders.
  # https://github.com/QwenLM/qwen-code/pull/17342
  git cherry-pick -n 468fa3cade0a26e25f3cfa7eab2c044a66a071dc
  # Mounted replay fixtures leak setImmediate updates into later tests.
  # https://github.com/QwenLM/qwen-code/pull/14293
  git cherry-pick -n 3066a0e12aa112d428e48f8d925c2b4e49fdbfe1
  # Wait for the branch picker's autofocus timer before checking focus.
  # https://github.com/QwenLM/qwen-code/pull/14842
  git cherry-pick -n 9f96954843e1151aa88a5a19df8bf0e4c95bcd6c
  # Arch's npm pins globalconfig to /etc/npmrc, so this prefix-relocation test
  # cannot exercise the redaction fallback.
  sed -i "/resolves it with real npm when npm refuses to print the path/ s/^  it(/  it.skip(/" \
    packages/cli/src/utils/managed-npm-update.test.ts
  # Synchronous CLI tests can starve Vitest's worker RPC replies.
  # https://github.com/QwenLM/qwen-code/pull/14293
  sed -i "/^import '.\/src\/test-utils\/customMatchers.js';$/i\\
import { beforeEach } from 'vitest';" packages/cli/test-setup.ts
  sed -i "/^import '.\/src\/test-utils\/customMatchers.js';$/a\\
\\
// Capture the real timer so sync-heavy suites can drain worker RPC replies.\\
const realSetTimeout = setTimeout;\\
beforeEach(() => new Promise<void>((resolve) => realSetTimeout(resolve, 0)));" \
    packages/cli/test-setup.ts
  # Node 24 preserves printable text adjacent to this ANSI/BEL fixture.
  # https://github.com/nodejs/node/pull/64319
  sed -i "/stripVTControlCharacters matches/,+2d; s/toBe('a[.]md')/toBe('ab.md')/" \
    packages/core/src/memory/memoryDiscovery.test.ts
  # Finish the interrupted journal clear so its test releases the directory handle.
  sed -i '/rejects journal directory replacement while clearing phases/,/^  });/ {
    /openMock.mockImplementation(originalOpen);/a\
      await fs.rmdir(journalDirectory);\
      await fs.rename(originalDirectory, journalDirectory);\
      await journal.clear(SESSION_ID, root);
  }' packages/cli/src/serve/conversations/standalone-deletion-journal.test.ts
  # Node 24's Writable.toWeb() settles writes before native callback errors.
  # https://github.com/nodejs/node/issues/64549
  sed -i "s/it('retains the original write error/it.skip('retains the original write error/" \
    packages/cli/src/acp-integration/acp-output.test.ts
  pnpm install --frozen-lockfile --ignore-scripts
  # Upstream postinstall applies dependency patches; install scripts are disabled above.
  ./node_modules/.bin/patch-package
}

build() {
  cd $pkgname
  npm run build
  npm run bundle
  local bundled=$(jq '.dependencies + .optionalDependencies | keys' package.json)
  npm pkg set --json bundledDependencies="$bundled"
  # npm refuses to pack bundled modules while overrides target bundled deps.
  npm pkg delete overrides
  npm pack --ignore-scripts
  # fakeroot 2.1.4 deadlocks on Btrfs directory removal; stage npm outside fakeroot.
  # https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1153064
  npm install --global --offline --ignore-scripts --prefix "$srcdir/npm/usr" \
    $pkgname-$pkgname-$pkgver.tgz
}

check() {
  cd $pkgname
  # Skip remaining clean-chroot failures; no narrow upstream fixes are available.
  # Keep one glob because sdk-typescript's Vitest rejects repeated --exclude.
  local test_exclude='**/{qwenConnectionHandler,useAtCompletion,'
  test_exclude+='serve/acp-http/transport,i18n/index,ui/auth/AuthDialog,'
  test_exclude+='ui/utils/clipboardUtils}.test.*'
  # mobilewright's older Playwright CLI cannot run the newer @playwright/test.
  # https://github.com/QwenLM/qwen-code/pull/11371
  npm pkg set 'scripts.test=c8 node ../../node_modules/@playwright/test/cli.js test' --workspace=@qwen-code/mobile-mcp
  # pnpm hoists mobilecli to the workspace root, while the source test only checks the package-local path.
  MOBILECLI_PATH="$PWD/node_modules/mobilecli/bin/mobilecli-linux-amd64" \
    npm run test --workspace=@qwen-code/mobile-mcp
  # mobile-mcp uses Playwright; run it above without passing Vitest-only flags.
  npm pkg set 'workspaces[]=!packages/mobile-mcp'
  # Coverage instrumentation distorts the suite's wall-clock latency gates.
  # Parallel files also exhaust worker deadlines on shared builders.
  # Retry timing-sensitive tests as upstream release lanes do.
  # https://github.com/QwenLM/qwen-code/pull/10842
  npm run test --workspaces --if-present -- --testTimeout=30000 \
    --coverage.enabled=false --no-file-parallelism --retry=2 \
    --exclude="$test_exclude"
}

package() {
  cd $pkgname
  cp -a "$srcdir/npm/usr" "$pkgdir/"
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
