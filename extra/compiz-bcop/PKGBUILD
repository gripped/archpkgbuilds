# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=compiz-bcop
pkgver=0.8.18
pkgrel=1
pkgdesc='Compiz option code generator'
arch=(any)
url='https://gitlab.com/compiz/compiz-bcop'
license=(GPL-2.0-or-later)
depends=(
  bash
  libxslt
)
makedepends=(git)
source=("git+https://gitlab.com/compiz/compiz-bcop.git#tag=v$pkgver")
b2sums=(d048e697088be0b7932234e744612b1f082f81458d2285168fafe1c4d78491bde92cd70b21038b9a4ac6f646b4ae59db992d1d10e7318e843eebb2d3b1257bfb)

prepare() {
  cd $pkgname
  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
