# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-opentelemetry-proto
pkgver=1.40.0
pkgrel=1
pkgdesc="OpenTelemetry Python Proto"
arch=('any')
url="https://github.com/open-telemetry/opentelemetry-python/tree/main/opentelemetry-proto"
license=('Apache-2.0')
depends=(
  'python'
  'python-protobuf'
)
makedepends=(
  'git'
  'python-build'
  'python-hatchling'
  'python-installer'
)
checkdepends=('python-pytest')
source=("git+https://github.com/open-telemetry/opentelemetry-python.git#tag=v${pkgver}")
sha256sums=('3d9018006e564108a40520eb9350c7d3c170c96fc3324e865b9aeee7dada1b05')

build() {
  cd opentelemetry-python/opentelemetry-proto
  python -m build --wheel --no-isolation
}

check() {
  cd opentelemetry-python/opentelemetry-proto
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd opentelemetry-python/opentelemetry-proto
  python -m installer --destdir="$pkgdir" dist/*.whl
}
