pkgname=scrapy
pkgver=2.20.0
pkgrel=1
pkgdesc='A fast high-level scraping and web crawling framework'
arch=(any)
license=(BSD-3-Clause)
url='https://scrapy.org'
depends=(
  python
  python-aiodns
  python-aioftp
  python-aiohttp
  python-brotli
  python-cryptography
  python-cssselect
  python-defusedxml
  python-formerly
  python-frostwork
  python-itemadapter
  python-itemloaders
  python-lxml
  python-packaging
  python-parsel
  python-platformdirs
  python-protego
  python-pydispatcher
  python-pyopenssl
  python-queuelib
  python-service-identity
  python-tldextract
  python-twisted
  python-w3lib
  python-zope-interface
)
makedepends=(
  git
  python-build
  python-hatchling
  python-installer
  python-wheel
)
checkdepends=(
  bpython
  ipython
  mitmproxy
  python-anyio
  python-attrs
  python-botocore
  python-colorlog
  python-h2
  python-httpx2
  python-markupsafe
  python-psutil
  python-pyftpdlib
  python-pytest
  python-pytest-rerunfailures
  python-pytest-timeout
  python-pytest-twisted
  python-sybil
  python-uvloop
)
optdepends=(
  'bpython: for ncurses support in cmdline'
  'ipython: for enhanced support of the interactive scraping shell'
  'python-anyio: for HTTPX download handler asyncio support'
  'python-botocore: for various utils'
  'python-colorlog: for colored logging'
  'python-h2: for HTTP2 support'
  'python-hpack: for HTTP2 streaming support'
  'python-httpx2: for HTTPX download handler support'
)
source=("$pkgname::git+https://github.com/scrapy/scrapy#tag=$pkgver")
sha512sums=('f937baba5c5bebab367b123644488751c0758f04eda749715bdf9d06d22cb188689038d1660d7578e28e4975d4b53544868494dbad62b6fbfea3b2efc82803aa')
b2sums=('79a81677f07da86677e6a5c38417d018a575a6567088aebe958f3a539579adf75b2586330eae9fb97722a04fa6a7dc003576b24255b30344195db48390df97de')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation

  python -m scrapy complete bash > scrapy.bash
  python -m scrapy complete fish > scrapy.fish
  python -m scrapy complete zsh > scrapy.zsh
}

check() {
  cd "$pkgname"

  # temporary install
  python -m installer --destdir="$(pwd)/tmp" dist/*.whl
  local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  export PYTHONPATH="$(pwd)/tmp/$site_packages"

  local pytest_options=(
    -vv
    # Fails with AssertionError under Python 3.14, not sure why
    --deselect tests/test_pipeline_files.py::TestFilesPipeline::test_file_path
    --deselect tests/test_command_check.py
    --deselect tests/test_feedexport.py
    --deselect tests/test_squeues.py
    --reactor default
    # ModuleNotFoundError: No module named 'tests'
    --deselect tests/test_crawler_subprocess.py::TestCrawlerRunnerSubprocess::test_response_ip_address
    # assert 'Ignoring response <402' not in "scrapy.middleware"
    --deselect tests/test_spidermiddleware_httperror.py::TestHttpErrorMiddlewareIntegrational::test_logging_level
    # Timeout
    --deselect tests/test_command_shell.py::TestInteractiveShell::test_shell_default_shells
  )

  pytest "${pytest_options[@]}" tests
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # License and documentation
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
  install -Dm644 README.rst -t "$pkgdir"/usr/share/doc/$pkgname/
  install -Dm644 docs/intro/install.rst -t "$pkgdir"/usr/share/doc/$pkgname/

  # Shell completions
  install -Dm644 scrapy.bash \
    "$pkgdir"/usr/share/bash-completion/completions/scrapy
  install -Dm644 scrapy.fish \
    "$pkgdir"/usr/share/fish/vendor_completions.d/scrapy.fish
  install -Dm644 scrapy.zsh \
    "$pkgdir"/usr/share/zsh/site-functions/_scrapy
}
