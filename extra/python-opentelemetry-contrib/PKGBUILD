prepare() {
  cd opentelemetry-python-contrib
  # Update tests for Starlette's routing API and metric attributes.
  patch -p1 -i "$srcdir/starlette-tests.patch"
  # Disable native FastAPI telemetry in tests of the contrib instrumentor.
  patch -p1 -i "$srcdir/fastapi-tests.patch"
  # Handle current aiohttp errors: https://github.com/open-telemetry/opentelemetry-python-contrib/issues/2917
  patch -p1 -i "$srcdir/aiohttp-client-tests.patch"
  # Follow the HTTP session's new location: https://github.com/open-telemetry/opentelemetry-python/pull/5389
  sed -i 's/http_exporter\._session/http_exporter._client._transport._session/' \
    exporter/opentelemetry-exporter-credential-provider-gcp/tests/test_credential_provider.py
  # Wait for ASGI user-agent subtests to finish: https://github.com/open-telemetry/opentelemetry-python-contrib/pull/5018
  sed -i '/^                await self.send_default_request()$/a\                await self.communicator.wait()' \
    instrumentation/opentelemetry-instrumentation-asgi/tests/test_asgi_middleware.py
  # Mock a parsed SQS response for current botocore: https://github.com/open-telemetry/opentelemetry-python-contrib/pull/5214
  sed -i 's/_mocked_endpoint(None)/_mocked_endpoint({})/' \
    instrumentation/opentelemetry-instrumentation-boto3sqs/tests/test_boto3sqs_instrumentation.py
  # Fix DynamoDB inputs and EC2 response/header assertions for current moto/botocore.
  patch -p1 -i "$srcdir/botocore-tests.patch"
}

build() {
  local component
  for component in "${_components[@]}"; do
    cd "$srcdir/opentelemetry-python-contrib/$component"
    python -m build --wheel --no-isolation
  done
}

check() {
  local component dependency
  cd "$srcdir/opentelemetry-python-contrib/instrumentation/opentelemetry-instrumentation-grpc/tests/protobuf"
  # Regenerate test messages for current protobuf: https://github.com/open-telemetry/opentelemetry-python-contrib/pull/1109
  protoc --python_out=. test_server.proto

  for component in "${_components[@]}"; do
    cd "$srcdir/opentelemetry-python-contrib/$component"
    # Auto-instrumentation tests expect only this component's entry points.
    python -m venv --system-site-packages --without-pip test-env
    for dependency in opentelemetry-instrumentation util/opentelemetry-util-http \
      propagator/opentelemetry-propagator-aws-xray \
      instrumentation/opentelemetry-instrumentation-{asgi,wsgi,dbapi}; do
      [[ $dependency == "$component" ]] && continue
      test-env/bin/python -m installer "$srcdir/opentelemetry-python-contrib/$dependency"/dist/*.whl
    done
    test-env/bin/python -m installer dist/*.whl

    # HTTP test dependencies already import email.generator.
    PATH="$PWD/test-env/bin:$PATH" test-env/bin/python -m pytest \
      --deselect=opentelemetry-instrumentation/tests/test_utils.py::UnwrapTestCase::test_noop_if_module_not_imported
  done
}

package_python-opentelemetry-instrumentation() {
  pkgdesc="Instrumentation tools and auto instrumentation for OpenTelemetry Python"
  depends+=(
    'python-opentelemetry-api'
    'python-opentelemetry-semantic-conventions'
    'python-packaging'
    'python-wrapt'
  )
  optdepends=('python-pip: install instrumentors with opentelemetry-bootstrap')

  cd opentelemetry-python-contrib/opentelemetry-instrumentation
  python -m installer --destdir="$pkgdir" dist/*.whl
}

