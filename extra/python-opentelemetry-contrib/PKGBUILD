# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgbase=python-opentelemetry-contrib
pkgname=(
  'python-opentelemetry-instrumentation'
  'python-opentelemetry-distro'
  'python-opentelemetry-util-http'
)
pkgver=0.66b1
pkgrel=1
pkgdesc="OpenTelemetry Python instrumentation and utilities"
arch=('any')
url="https://github.com/open-telemetry/opentelemetry-python-contrib"
license=('Apache-2.0')
depends=('python')
makedepends=(
  'git'
  'python-build'
  'python-hatchling'
  'python-installer'
)
checkdepends=(
  'python-gevent'
  'python-opentelemetry-api'
  'python-opentelemetry-exporter-otlp-proto-grpc'
  'python-opentelemetry-sdk'
  'python-opentelemetry-semantic-conventions'
  'python-opentelemetry-test-utils'
  'python-packaging'
  'python-pytest'
  'python-wrapt'
)
source=("git+https://github.com/open-telemetry/opentelemetry-python-contrib.git#tag=v$pkgver")
sha256sums=('ed8caaa8a7134a1c7d2ddcaa133e31223eacebe99f740e6f24253fd8420931d6')

_components=(
  opentelemetry-instrumentation
  opentelemetry-distro
  util/opentelemetry-util-http
)

build() {
  local component
  for component in "${_components[@]}"; do
    cd "$srcdir/opentelemetry-python-contrib/$component"
    python -m build --wheel --no-isolation
  done
}

check() {
  local component
  cd "$srcdir"
  python -m venv --system-site-packages --without-pip test-env

  for component in "${_components[@]}"; do
    test-env/bin/python -m installer "opentelemetry-python-contrib/$component"/dist/*.whl
  done

  for component in "${_components[@]}"; do
    cd "$srcdir/opentelemetry-python-contrib/$component"
    PATH="$srcdir/test-env/bin:$PATH" "$srcdir/test-env/bin/python" -m pytest
  done
}

package_python-opentelemetry-instrumentation() {
  pkgdesc="Instrumentation tools and auto instrumentation for OpenTelemetry Python"
  depends+=(
    'python-opentelemetry-api'
    'python-opentelemetry-semantic-conventions'
    'python-packaging'
    'python-wrapt'
  )
  optdepends=('python-pip: install instrumentors with opentelemetry-bootstrap')

  cd opentelemetry-python-contrib/opentelemetry-instrumentation
  python -m installer --destdir="$pkgdir" dist/*.whl
}

package_python-opentelemetry-distro() {
  pkgdesc="OpenTelemetry Python Distro"
  depends+=(
    'python-opentelemetry-api'
    'python-opentelemetry-instrumentation'
    'python-opentelemetry-sdk'
  )
  optdepends=('python-opentelemetry-exporter-otlp: OTLP export support')

  cd opentelemetry-python-contrib/opentelemetry-distro
  python -m installer --destdir="$pkgdir" dist/*.whl
}

package_python-opentelemetry-util-http() {
  pkgdesc="Web utilities for OpenTelemetry"
  depends+=(
    'python-opentelemetry-api'
    'python-opentelemetry-instrumentation'
    'python-opentelemetry-semantic-conventions'
    'python-wrapt'
  )

  cd opentelemetry-python-contrib/util/opentelemetry-util-http
  python -m installer --destdir="$pkgdir" dist/*.whl
}
