# Contributor: Felix Richter <judge@felixrichter.tech>

pkgname=hipsparselt
pkgver=10.1
pkgrel=1
pkgdesc='SPARSE marshalling library with AMD GPU backend'
arch=('x86_64')
url='https://rocm.docs.amd.com/projects/hipSPARSELt/en/latest/'
license=('MIT')
depends=(
  'glibc'
  'hip-runtime-amd'
  'hipsparse'
  'libgcc'
  'libstdc++'
  'rocm-core'
  'rocm-openmp'
  'roctracer'
  'zlib'
)
makedepends=(
  'cmake'
  'git'
  'msgpack-cxx'
  'ninja'
  'python'
  'python-joblib'
  'python-msgpack'
  'python-orjson'
  'python-packaging'
  'python-pyaml'
  'python-pyyaml'
  'python-setuptools'
  'python-simplejson'
  'python-ujson'
  'robin-map'
  'rocm-cmake'
  'rocm-toolchain'
  'rocm-llvm'
)
_git='https://github.com/ROCm/rocm-libraries'
# Version that tensilelite/rocisa/CMakeLists.txt pins for FetchContent
_nanobind_ver=2.6.1
# The build adds projects/hipblaslt, shared/origami and shared/stinkytofu,
# which the hipsparselt release tarball lacks
source=("rocm-libraries::git+$_git.git#tag=therock-$pkgver"
        "nanobind-$_nanobind_ver.tar.gz::https://github.com/wjakob/nanobind/archive/v$_nanobind_ver.tar.gz")
sha256sums=('2fe2463c0b4344e30f563eb3ee4a94d9426c54d8747d76df15a4ae8018abd6f2'
            '519c6dd56581ad6db9aab814105c2666a0491096487cb384dd20216f80d1a291')
options=(!lto)
_dirname="rocm-libraries/projects/$pkgname"

prepare() {
  cd rocm-libraries
  # Keep stinkytofu assertions for CMAKE_BUILD_TYPE=None, as for Release
  sed -i 's/^    CMAKE_CXX_FLAGS_RELEASE$/&\n    CMAKE_CXX_FLAGS_NONE/' \
    shared/stinkytofu/CMakeLists.txt
}

build() {
  export PATH="/opt/rocm/bin:$PATH"

  # -g also emits DWARF for every GPU target into .hip_fatbin, which strip
  # does not remove. Keep host debug info only.
  CXXFLAGS+=" -Xarch_device -g0"
  # Host-only sources ignore -Xarch_device, and stinkytofu uses -Werror
  CXXFLAGS+=" -Wno-error=unused-command-line-argument"
  # -fcf-protection is not supported by HIP, see
  # https://rocm.docs.amd.com/projects/llvm-project/en/latest/reference/rocmcc.html#support-status-of-other-clang-options
  CXXFLAGS+=" -fcf-protection=none"
  local cmake_args=(
    -Wno-dev
    -G Ninja
    -B build
    -S "$_dirname"
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_C_COMPILER=amdclang
    -D CMAKE_CXX_COMPILER=amdclang++
    # rocisa asserts on macro body items that Release builds skip
    -D CMAKE_CXX_FLAGS_NONE=-DNDEBUG
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    -D HIPSPARSELT_ENABLE_CLIENT=OFF
    -D HIPSPARSELT_BUILD_TESTING=OFF
    # Use the nanobind source and the system robin-map, fail on other downloads
    -D FETCHCONTENT_SOURCE_DIR_NANOBIND="$srcdir/nanobind-$_nanobind_ver"
    -D NB_USE_SUBMODULE_DEPS=OFF
    -D FETCHCONTENT_FULLY_DISCONNECTED=ON
    # The default GPU_TARGETS=all selects every target with Tensile logic:
    # gfx942, gfx950 and gfx1250
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$_dirname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
