# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-langgraph-checkpoint-sqlite
pkgver=3.1.3
pkgrel=1
pkgdesc="Library with a SQLite implementation of LangGraph checkpoint saver"
arch=('any')
url="https://github.com/langchain-ai/langgraph/tree/main/libs/checkpoint-sqlite"
license=('MIT')
depends=(
  'python'
  'python-aiosqlite'
  'python-langgraph-checkpoint'
  'python-orjson'
)
optdepends=('python-sqlite-vec: vector search in SQLite stores')
makedepends=(
  'git'
  'python-build'
  'python-hatchling'
  'python-installer'
  'python-wheel'
)
checkdepends=(
  'python-anyio'
  'python-langgraph'
  'python-langgraph-checkpoint-conformance'
  'python-pytest'
  'python-pytest-asyncio'
  'python-pytest-mock'
  'python-pytest-retry'
)
source=("git+https://github.com/langchain-ai/langgraph.git"
        optional-sqlite-vec.patch)
sha256sums=('SKIP'
            'b331371c5c7460a636ff81b86ee1eb79fa61b86235a53f14e861b1439a91c6cf')

prepare() {
  cd langgraph

  # makepkg's git fragment parser treats "=" inside tag values as separators.
  git checkout -q "checkpointsqlite==$pkgver"

  # Keep sqlite-vec optional while python-sqlite-vec is being unarchived.
  git apply "$srcdir/optional-sqlite-vec.patch"
}

build() {
  cd langgraph/libs/checkpoint-sqlite
  python -m build --wheel --no-isolation
}

check() {
  cd langgraph/libs/checkpoint-sqlite
  python -m pytest
}

package() {
  cd langgraph/libs/checkpoint-sqlite
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
