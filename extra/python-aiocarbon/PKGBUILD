# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-aiocarbon
pkgver=0.15.3
pkgrel=1
pkgdesc="Asynchronous client for Carbon"
arch=('any')
url="https://github.com/mosquito/aiocarbon"
license=('Apache-2.0')
depends=('python' 'python-immutables')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest' 'python-pytest-asyncio')
# The untagged release matches this commit except for its version field.
# Use Git to include the tests omitted from the PyPI archive.
# https://github.com/mosquito/aiocarbon/issues/13
source=("git+https://github.com/mosquito/aiocarbon.git#commit=149771d99d4417cc704bbf6bed29022c89d7d960"
        'python-asyncio.patch')
sha512sums=('25f1993026a140b3589559064284b5d469a3ba1aa6bdf86e18e2be6da32e939fc52703ec976db59ff4870ed37c745c3762aff7029ec5dc9441186ce9957ddbe5'
            'e3afcbd28c7702c9696e44ffeb2dcf132c2ee4c324e14ef91ec9aa5991924514ef4c7145d6e78981b36a750d8af99a19b3b741b8becff15de60add288c6333b3')

prepare() {
  cd aiocarbon
  # Upstream updates the release version outside the Git repository.
  sed -i "s/^version_info = .*/version_info = (${pkgver//./, })/" aiocarbon/version.py

  # Remove obsolete asyncio loop arguments and use pytest-asyncio's running loop.
  patch -Np1 -i "$srcdir/python-asyncio.patch"
}

build() {
  cd aiocarbon
  python -m build --wheel --no-isolation
}

check() {
  cd aiocarbon
  python -m pytest
}

package() {
  cd aiocarbon
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENCE.md -t "$pkgdir/usr/share/licenses/$pkgname/"
}
