# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-aiocarbon
pkgver=0.17.0
pkgrel=1
pkgdesc="Asynchronous client for Carbon"
arch=('any')
url="https://github.com/mosquito/aiocarbon"
license=('Apache-2.0')
depends=('python')
makedepends=('git' 'python-build' 'python-hatchling' 'python-installer')
checkdepends=('python-pytest' 'python-pytest-asyncio' 'python-pytest-cov')
source=("git+https://github.com/mosquito/aiocarbon.git#tag=$pkgver")
sha512sums=('7fcb6ff62fda8884a1ff84e7f55697f1957fb4269632f6b4c5ae32f72796d52fc7b9d3a90189ad84c34c82e5d3f044c56410a6686e6badae3e2bbd7c44170863')

prepare() {
  cd aiocarbon
  # Upstream sets the release version only in its publishing workflow.
  sed -i "s/^version = .*/version = \"$pkgver\"/" pyproject.toml
}

build() {
  cd aiocarbon
  python -m build --wheel --no-isolation
}

check() {
  cd aiocarbon
  python -m pytest
}

package() {
  cd aiocarbon
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENCE.md -t "$pkgdir/usr/share/licenses/$pkgname/"
}
