# Maintainer: Orhun Parmaksız <orhun@archlinux.org>

pkgname=bootvine
pkgver=0.1.3
pkgrel=1
pkgdesc="Live dependency tree of systemd jobs on the boot console"
arch=('x86_64')
url="https://codeberg.org/wvhulle/bootvine"
license=('GPL-3.0-or-later')
depends=('dbus' 'gcc-libs' 'systemd-libs')
makedepends=('cargo' 'pkgconf' 'systemd')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('89d53d937f818ec80b54c9f9d8c501f7254f8b776e549543bb39a87da264ca0b')
options=('!lto')

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname"
  cargo build --frozen --release -p bootvine
}

check() {
  cd "$pkgname"
  cargo test --frozen -p bootvine
}

package() {
  cd "$pkgname"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"

  install -Dm 755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  "$pkgdir/usr/bin/$pkgname" install --destdir "$pkgdir" --initrd mkinitcpio --no-enable
}

# vim: ts=2 sw=2 et:
