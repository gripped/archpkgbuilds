pkgname=gsimplecal
pkgver=2.5.3
pkgrel=1
pkgdesc="Simple and lightweight GTK calendar"
url="https://dmedvinsky.github.io/gsimplecal/"
arch=('x86_64')
license=('BSD-3-Clause')
depends=('glibc' 'glib2' 'gtk3' 'libgcc' 'libstdc++')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/dmedvinsky/${pkgname}/archive/v${pkgver}.tar.gz")
sha256sums=('39c3a14b507d0ca0a167d864f9bd662485bb77e2bb089a5252dd4c6c1ffc2036')

build() {
	cd "${pkgname}-${pkgver}"
	./autogen.sh
	./configure --prefix=/usr
	make
}

package() {
	cd "${pkgname}-${pkgver}"
	make DESTDIR="${pkgdir}" install
	install -Dm 644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
