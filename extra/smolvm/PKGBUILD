# Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>
# Contributor: Anas Elgarhy <anas.elgarhy.dev@gmail.com>
pkgname=smolvm
pkgver=1.7.4
pkgrel=1
pkgdesc='Tool to build & run portable, lightweight, self-contained virtual machines'
arch=('x86_64')
url='https://github.com/smol-machines/smolvm'
license=('Apache-2.0')
depends=('seatd' 'crun' 'jq' 'e2fsprogs' 'util-linux' 'libcap' 'gzip' 'tar' 'libgcc' 'zlib' 'oniguruma' 'sqlite' 'zstd')
makedepends=('git' 'rust' 'rust-musl' 'cargo-make' 'bc' 'python-pyelftools' 'libepoxy' 'virglrenderer'
             'clang')
provides=('smolvm')
source=("git+https://github.com/smol-machines/smolvm#tag=v${pkgver}"
        "git+https://github.com/smol-machines/libkrun"
        "git+https://github.com/smol-machines/libkrunfw"
        "git+https://github.com/smol-machines/smolvm-sdk"
        'smolvm-fix-agent-build.patch')
sha256sums=('a13744b614c912a56f6e9349f268354355a6141ea1bb52be0c00d74c83a8ff98'
            'SKIP'
            'SKIP'
            'SKIP'
            'bffa13bb64fd6783f97baae45431b0296b316cdee128cdd201614fe7567e7d5a')

prepare() {
  cd "$pkgname"

  # We're using their libkrun fork because supposedly it adds features that
  # they need and we can't use the Arch packages.
  git submodule init
  git config submodule.libkrun.url "${srcdir}/libkrun"
  git config submodule.libkrunfw.url "${srcdir}/libkrunfw"
  git config submodule.smolvm-sdk.url "${srcdir}/smolvm-sdk"
  git -c protocol.file.allow=always submodule update

  patch -p1 < ../smolvm-fix-agent-build.patch
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"
  export CFLAGS+=' -ffat-lto-objects'
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
  export ZSTD_SYS_USE_PKG_CONFIG=1

  cargo make build-libkrunfw
  cargo make build-libkrun
  cargo make build-agent
  cargo make agent-rootfs
  cargo make build
}

package() {
  cd "$pkgname"

  # Point the wrapper at the packaged locations instead of script-relative ones
  sed -i \
      -e 's|^SMOLVM_BIN=.*|SMOLVM_BIN=/usr/lib/smolvm/smolvm-bin|' \
      -e 's|^SMOLVM_LIB=.*|SMOLVM_LIB=/usr/lib/smolvm/lib|' \
      -e 's|^SMOLVM_BUNDLED_ROOTFS=.*|SMOLVM_BUNDLED_ROOTFS=/usr/lib/smolvm/agent-rootfs|' \
      scripts/smolvm-wrapper.sh

  install -Dm755 target/release/smolvm "$pkgdir/usr/lib/smolvm/smolvm-bin"
  install -Dm755 scripts/smolvm-wrapper.sh "$pkgdir/usr/bin/smolvm"
  install -d "$pkgdir/usr/lib/smolvm/"
  cp -a target/agent-rootfs/ "$pkgdir/usr/lib/smolvm/agent-rootfs"
  cp -a lib/linux-$CARCH/ "$pkgdir/usr/lib/smolvm/lib"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

