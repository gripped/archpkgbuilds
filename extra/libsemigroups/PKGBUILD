# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=libsemigroups
pkgver=3.5.2
pkgrel=1
pkgdesc='C++ library for semigroups and monoids'
url='https://libsemigroups.github.io'
arch=(x86_64)
license=(GPL-3.0-or-later)
depends=(fmt
         glibc
         libgcc
         libstdc++)
makedepends=(eigen
             git)
source=(git+https://github.com/libsemigroups/libsemigroups#tag=v$pkgver)
sha256sums=('423e63eda02a0f1283e6b93dcce38dd23f6fe58d0450d1f53c197e9432df81a2')

prepare() {
  cd $pkgname
  autoreconf -vif
}

build() {
  cd $pkgname
  ./configure --prefix=/usr \
              --disable-hpcombi \
              --enable-fmt \
              --with-external-fmt \
              --with-external-eigen
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
