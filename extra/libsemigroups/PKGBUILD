# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=libsemigroups
pkgver=3.5.4
pkgrel=1
pkgdesc='C++ library for semigroups and monoids'
url='https://libsemigroups.github.io'
arch=(x86_64)
license=(GPL-3.0-or-later)
depends=(fmt
         glibc
         libgcc
         libstdc++)
makedepends=(eigen
             git)
source=(git+https://github.com/libsemigroups/libsemigroups#tag=v$pkgver)
sha256sums=('c0b843ad3bb2d2aeabcc5ee81722b8ab6680e1591e75190fd57681ecb44adaef')

prepare() {
  cd $pkgname
  autoreconf -vif
}

build() {
  cd $pkgname
  ./configure --prefix=/usr \
              --disable-hpcombi \
              --enable-fmt \
              --with-external-fmt \
              --with-external-eigen
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
