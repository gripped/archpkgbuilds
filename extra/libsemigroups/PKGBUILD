# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=libsemigroups
pkgver=3.6.0
pkgrel=1
pkgdesc='C++ library for semigroups and monoids'
url='https://libsemigroups.github.io'
arch=(x86_64)
license=(GPL-3.0-or-later)
depends=(fmt
         glibc
         libgcc
         libstdc++)
makedepends=(eigen
             git)
source=(git+https://github.com/libsemigroups/libsemigroups#tag=v$pkgver)
sha256sums=('19cf769a431a95d1e023cbe552d92990bf346ac060fc3792614570c02b760b78')

prepare() {
  cd $pkgname
  autoreconf -vif
}

build() {
  cd $pkgname
  ./configure --prefix=/usr \
              --disable-hpcombi \
              --enable-fmt \
              --with-external-fmt \
              --with-external-eigen
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
