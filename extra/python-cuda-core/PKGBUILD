# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>

# NOTE: python-cuda-core shares the git repository with python-cuda,
# but it has different versioning scheme and release frequency
pkgname=python-cuda-core
epoch=1
pkgver=1.3.1
pkgrel=1
pkgdesc="Pythonic access to CUDA core functionality"
arch=(x86_64)
url="https://nvidia.github.io/cuda-python/cuda-core/latest/index.html"
license=(Apache-2.0)
depends=(
  glibc
  libgcc
  libstdc++
  python
  python-cuda-bindings
  python-numpy
)
makedepends=(
  cuda
  cython
  git
  python-wheel
  python-build
  python-installer
  python-setuptools-scm
)
checkdepends=(
  python-pytest
)
source=(
  python-cuda::git+https://github.com/NVIDIA/cuda-python#tag=cuda-core-v$pkgver
  pyproject.patch
  system-cccl.patch
)
b2sums=('b04e137f9e90bb8ec1fcc4de12fb83e432c431036133c6571d352779bb7633c23cc4e4b196f32e29847b28dcb6f717b290c113d366f3d3f8908e14869b6110da'
        '03ac12de54ddf24634a4830b6af327743166603b114bc1d99e806fe74c77988bfd97c49d8c1395a02cac3672eeac89ed16c5b2af1612ce6412037d229b5610e4'
        '0ea59ad48a8b555477a88e5fb9ce7aadbf7431b521c43529d872d9e380d4c7aa5990104557c6871a29d65d1b2ed7aa87d9ffc193656703d88d2f97b10ba76a74')

prepare() {
  cd python-cuda
  # drop upper bound on cython version
  patch -p1 < ../pyproject.patch
  # use the system CCCL headers instead of the missing git submodule
  patch -p1 < ../system-cccl.patch
}

build() {
  cd python-cuda/cuda_core

  # enable parallel build
  export CUDA_PYTHON_PARALLEL_LEVEL=$(nproc)

  python -m build --wheel --no-isolation
}

check() {
  cd python-cuda
  # cannot run tests in chroot
  #python -m venv --system-site-packages test-env
  #test-env/bin/python -m installer cuda_core/dist/*.whl
  #test-env/bin/python -m pytest cuda_core/tests
}

package() {
  cd python-cuda/cuda_core
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
