# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-oscpy
pkgver=0.6.0
pkgrel=7
pkgdesc="A modern and efficient OSC Client/Server implementation"
url="https://github.com/kivy/oscpy"
license=('MIT')
arch=('any')
depends=('python')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest' 'python-pytest-rerunfailures')
source=("git+https://github.com/kivy/oscpy.git#tag=v$pkgver")
sha512sums=('a89417fc5017f40fb95325f69165e427e302b0820f122200faacc811e75c7121153f3c6f60940efe787c48d2597f5c34c7411e4fcf7b4c84a9e7fd1308c94233')

build() {
  cd oscpy
  python -m build --wheel --no-isolation
}

check() {
  cd oscpy
  python -m pytest --reruns=5
}

package() {
  cd oscpy
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname/
}
