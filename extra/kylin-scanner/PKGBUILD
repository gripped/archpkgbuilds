# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=kylin-scanner
pkgver=1.0.1
pkgrel=1
pkgdesc="SANE scanning utility with image processing and OCR for UKUI"
arch=('x86_64')
license=('GPL-3.0-or-later')
url="https://gitee.com/openkylin/kylin-scanner"
groups=('ukui')
depends=('glib2' 'glibc' 'hicolor-icon-theme' 'leptonica' 'libgcc' 'libstdc++' 'opencv'
         'qt6-base' 'qt6-svg' 'sane' 'tesseract' 'tesseract-data-chi_sim')
makedepends=('git' 'qt6-tools')
source=("git+https://gitee.com/openkylin/kylin-scanner.git#tag=debian/$pkgver-1"
        'qt6.patch'
        'remove-software-center.patch')
sha512sums=('27eb7f56fc6aaf725f7be06a2ab193d2c17f5bc53e15186d6dc7e8f63d07314f8cb2cc7e6ade70e71c2b21992e16541092bd1362a40d9b60c756bc7509d4e0b2'
            '4c4d9a986cf459274ce749a289a7249f88f7549268a54504af1514515dbe01f136210eae600cc87b926927774100e16f5adffc09b33596d89ebe1de394ebdf79'
            'c5dc48a8af61d3383a87dbe20d6cc78c6c502bac750eca4e396fc6e81db696f60c27a7faeac17604dc238bfd8dae7bc4231c2342e7c4cb7277875f6bce25fd0c')

prepare() {
  cd kylin-scanner
  # Replace Qt 5 APIs removed or namespaced in Qt 6.
  patch -Np1 -i ../qt6.patch
  # The Ubuntu Kylin software center is unavailable on Arch.
  patch -Np1 -i ../remove-software-center.patch

  # Use standard library paths and an application-specific icon name.
  sed -i -e 's|-L\$\$PWD/../../../usr/lib/x86_64-linux-gnu/ ||' \
         -e '/^\(INCLUDEPATH\|DEPENDPATH\).*x86_64-linux-gnu/d' \
         -e 's|data/scanner.png|data/kylin-scanner.png|' \
         -e 's|/usr/share/pixmaps/|/usr/share/icons/hicolor/256x256/apps/|' src/src.pro
  mv src/data/{scanner,kylin-scanner}.png
  sed -i -e 's|^Icon=.*|Icon=kylin-scanner|' \
         -e 's|Categories=Application;|Categories=|' \
         -e 's|^Keywords=scannerfrontend$|Keywords=scannerfrontend;|' src/data/kylin-scanner.desktop
}

build() {
  cd kylin-scanner
  lrelease6 src/translations/kylin-scanner.zh_CN.ts
  lrelease6 src/translations/kylin-scanner_tr.ts -qm src/translations/kylin-scanner.tr_TR.qm
  qmake6 CONFIG+=c++17 \
    QMAKE_CFLAGS_RELEASE="$CPPFLAGS $CFLAGS" \
    QMAKE_CXXFLAGS_RELEASE="$CPPFLAGS $CXXFLAGS" \
    QMAKE_LFLAGS_RELEASE="$LDFLAGS"
  make
}

package() {
  cd kylin-scanner
  make INSTALL_ROOT="$pkgdir" install
  install -Dm644 man/kylin-scanner.1 -t "$pkgdir/usr/share/man/man1"
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
