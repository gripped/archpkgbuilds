# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>

_name=fast-simplification
pkgname=python-$_name
pkgver=0.1.13
pkgrel=1
pkgdesc="Fast quadric mesh simplification"
arch=(x86_64)
url="https://github.com/pyvista/fast-simplification"
license=(MIT)
depends=(
  glibc
  libgcc
  libstdc++
  python
  python-numpy
)
makedepends=(
  cython
  python-build
  python-installer
  python-setuptools
)
checkdepends=(
  python-pytest
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz)
b2sums=('8ebabd7496384e1770a15744fb90e7ca7229fe0aa0bbe684aed3cf4d67b429b644400a8e148311d90b095dff3279d8e733510f1ab7dab5dc23bc2df2cb646a00')

build() {
  cd $_name-$pkgver
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
    -W ignore::DeprecationWarning
  )

  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer $_name-$pkgver/dist/*.whl
  test-env/bin/python -m pytest "${pytest_options[@]}" $_name-$pkgver/tests
}

package() {
  cd $_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
