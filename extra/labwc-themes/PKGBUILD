# Maintainer: Peter Jung <ptr1337@archlinux.org>

pkgname=labwc-themes
pkgver=0.1.0
pkgrel=1
pkgdesc='Collection of server-side decoration themes for labwc'
url="https://github.com/labwc/labwc-themes"
arch=('any')
license=('CC-BY-SA-4.0')
makedepends=(
  git
  meson
)
optdepends=(
  'labwc: compositor the themes are made for'
)
source=("git+https://github.com/labwc/labwc-themes#tag=${pkgver}")
b2sums=('4d4211b2c1c7202158ac2f9e9ed49c9f869cbf707a9bbf6d1fec0ed720e87fdfe0d53374f1e9b14fd6e72338f3bea57dd9c91ac878130b9a40b0281d6fdfb6c6')

build() {
  arch-meson "$pkgname" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$pkgname/LICENSE"
}
