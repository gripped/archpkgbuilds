# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=perl-crypt-sysrandom
pkgver=0.008
pkgrel=1
pkgdesc='Perl interface to system randomness'
arch=('any')
url='https://metacpan.org/release/Crypt-SysRandom'
license=('Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=('perl')
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/L/LE/LEONT/Crypt-SysRandom-$pkgver.tar.gz")
sha256sums=('ab6ac0b737e83a45a13c4ba502c9286c73622609e09f1a21d63eddb1d6597726')

build() {
  cd Crypt-SysRandom-$pkgver
  perl Makefile.PL INSTALLDIRS=vendor
  make
}

check() {
  cd Crypt-SysRandom-$pkgver
  make test
}

package() {
  cd Crypt-SysRandom-$pkgver
  make DESTDIR="$pkgdir" install
}
