# Maintainer: Balló György <ballogyor+arch at gmail dot com>
# Contributor: Dimitris Kiziridis <ragouel at outlook dot com>

pkgname=minder
pkgver=3.0.0
pkgrel=1
pkgdesc='Mind-mapping application to create, develop and visualize your ideas'
arch=(x86_64)
url='https://github.com/phase1geo/Minder'
license=(GPL-3.0-or-later)
depends=(
  cairo
  dconf
  gdk-pixbuf2
  glib2
  glibc
  granite7
  graphene
  gtk4
  gtksourceview5
  hicolor-icon-theme
  json-glib
  lasem
  libarchive
  libgee
  librsvg
  libwebp
  libxml2
  pango
  webkitgtk-6.0
)
makedepends=(
  discount
  git
  meson
  vala
)
source=("git+https://github.com/phase1geo/Minder.git#tag=$pkgver")
b2sums=(2c6d7a510d04e88726134f245eb563c54560ae60eaac3256e2e559d374d6411aae7509b6e87d9e5d960eec4d4c49ca6a54b430d33bea33d01136f0eb5ddc7801)

prepare() {
  cd Minder
}

build() {
  arch-meson Minder build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  ln -s io.github.phase1geo.minder "$pkgdir/usr/bin/$pkgname"

  # Remove bundled fonts
  rm -r "$pkgdir/usr/share/fonts/"
}
