# Maintainer: Balló György <ballogyor+arch at gmail dot com>
# Contributor: Josip Ponjavic <josipponjavic at gmail dot com>

pkgname=photoflare
pkgver=1.7.1
pkgrel=1
pkgdesc='Quick, simple but powerful Qt-based image editor inspired by PhotoFiltre'
arch=(x86_64)
url='https://photoflare.io/'
license=(GPL-3.0-or-later)
depends=(
  glibc
  graphicsmagick
  hicolor-icon-theme
  libgcc
  libgomp
  libstdc++
  qt6-base
  qt6-imageformats
)
makedepends=(
  git
  qt6-tools
)
source=("git+https://github.com/PhotoFlare/photoflare.git#tag=v$pkgver")
b2sums=(16d05d807ebe9bd32bdc7734d8a8c80b05e9a5790fa1e012df15e712995c3742de5f7bb8eacdf2098069990e2dde4ecb9751ac8d9ccd29979a60da7a95e12109)

prepare() {
  cd $pkgname
  sed -i '/pixmaps \\/d' Photoflare.pro
}

build() {
  cd $pkgname
  qmake6 Photoflare.pro PREFIX=/usr
  make
}

package() {
  cd $pkgname
  make INSTALL_ROOT="$pkgdir" install
}
