# Maintainer: Balló György <ballogyor+arch at gmail dot com>
# Contributor: Josip Ponjavic <josipponjavic at gmail dot com>

pkgname=photoflare
pkgver=1.6.13
pkgrel=2
pkgdesc='Quick, simple but powerful Qt-based image editor inspired by PhotoFiltre'
arch=(x86_64)
url='https://photoflare.io/'
license=(GPL-3.0-or-later)
depends=(
  glibc
  graphicsmagick
  hicolor-icon-theme
  libgcc
  libgomp
  libstdc++
  qt6-base
  qt6-imageformats
)
makedepends=(
  git
  qt6-tools
)
source=("git+https://github.com/PhotoFlare/photoflare.git#tag=v$pkgver")
b2sums=(bbfe16571c10e425ea6fea65f8d36366d2f157c95c75f226c0d6ef05c407fb57dc3d48025fedb39d46b88bfd0d59e08c7e2b09f2243117f97e1755855e70ad59)

prepare() {
  cd $pkgname

  # Port to Qt6
  # https://github.com/PhotoFlare/photoflare/pull/490
  git cherry-pick -n -m 1 v1.6.13..11de5e05fe3bdcc9b914808d70e3c71242931661
  git cherry-pick -n -m 1 f88dc1ba29d139637723e9e1fd2cb367d8f27646
  git revert -n 24ebbb899e66c3ec0098e7ab620444ffd8d49471
  sed -i "s/1.6.12/$pkgver/" src/main.cpp

  sed -i '/pixmaps \\/d' Photoflare.pro
}

build() {
  cd $pkgname
  qmake6 Photoflare.pro PREFIX=/usr
  make
}

package() {
  cd $pkgname
  make INSTALL_ROOT="$pkgdir" install
}
