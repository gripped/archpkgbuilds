# Maintainer: Robin Candau <antiz@archlinux.org>
# Contributor: Jovan Lanik <jox969@gmail.com>

pkgname=gtklock-userinfo-module
pkgver=5.0.0
pkgrel=2
pkgdesc="gtklock module adding user info to the lockscreen"
url="https://github.com/jovanlanik/gtklock-userinfo-module"
arch=('x86_64')
license=('GPL-3.0-only')
depends=('gtk3' 'accountsservice' 'gtklock')
makedepends=('meson')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        "fix_version_mismatch.patch")
sha256sums=('e75bab44ae8dbe828afc24608341b8593b68aeb7f7fba4e739d142fd602bb800'
            'fc0c4b3b6f8f99d3191860d3d3ed1d6d0a837485465ff6e204b70101be0f975e')

prepare() {
	cd "${pkgname}-${pkgver}"
	# Fix version mismatch by backporting the version bump commit that was omitted in the last release
	# See https://github.com/jovanlanik/gtklock-playerctl-module/commit/5a51d8d93c4be9fd13786bb9f0fe48f8ef95f424
	patch -Np1 -i "${srcdir}/fix_version_mismatch.patch"
}

build() {
        arch-meson "${pkgname}-${pkgver}" build
        meson compile -C build
}

package() {
        meson install -C build --destdir "${pkgdir}"
}
