# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgbase=highs
pkgname=(highs
         python-highspy)
pkgver=1.16.0
pkgrel=1
pkgdesc='Linear optimization software'
arch=(x86_64)
url='https://highs.dev/'
license=(MIT)
depends=(glibc
         libgcc
         libstdc++)
makedepends=(cmake
             git
             pybind11
             python-build
             python-installer
             python-numpy
             python-scikit-build-core)
source=(git+https://github.com/ERGO-Code/HiGHS#tag=v$pkgver)
sha256sums=('a5640d45ce3fa681d3c96c37ae35d138cba410978a9bb1090140a7578b2ca940')

build() {
  cmake -B build -S HiGHS \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build

  cd HiGHS
  python -m build --wheel --no-isolation
}

package_highs() {
  depends+=(zlib)

  DESTDIR="$pkgdir" cmake --install build
  install -d "$pkgdir"/usr/share/licenses/$pkgname
}

package_python-highspy() {
  depends+=(highs
            python
            python-numpy)

  cd HiGHS
  python -m installer --destdir "$pkgdir" dist/*.whl
  install -Dm644 LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname
}
