# Maintainer: Bert Peters <bertptrs@archlinux.org>
# Contributor: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=cxxbridge
pkgver=1.0.198
pkgrel=1
pkgdesc='Safe interop between Rust and C++'
url='https://github.com/dtolnay/cxx'
arch=('x86_64')
license=('Apache-2.0' 'MIT')
depends=(
  'glibc'
  'libgcc'
)
makedepends=('cargo')
options=(!lto)
source=(https://github.com/dtolnay/cxx/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz
        Cargo.lock)
sha256sums=('e8c54f11e12b00f80a7da8cc2eac55db5c4688cb2bc483f5e923261fa3a285bf'
            '9ecd9320797e2bd4441a0111eb767231cd84d196a84a128cc3bd37376326d350')
b2sums=('30d37a770f6adaf86a78027d47bff9557c4cfeeaf9843d2c2e8e3f310075f54018b20536526512c6c35fde4c3fdea48f5d26e486145a37cace3b08d96d46b347'
        '75bf7725126966fc25db0d68de2c35e9dda4bf649533a613fa832b004e38dfc6c152f2eaf0253ff8330f66057d075326fd94f3eda044f716b49a81aca353fa83')

prepare() {
  cd "cxx-${pkgver}"
  cp ../Cargo.lock .
  cargo fetch --locked --target host-tuple
}

updlockfiles() {
  cd "cxx-${pkgver}"
  rm -f Cargo.lock
  cargo update
  cp Cargo.lock "${outdir}/"
}

build() {
  cd "cxx-${pkgver}"
  cargo build --frozen --release --package cxxbridge-cmd
}

check() {
  cd "cxx-${pkgver}"
  cargo test --frozen --release --package cxxbridge-cmd
}

package() {
  cd "cxx-${pkgver}"
  install -Dm 755 target/release/${pkgname} "${pkgdir}/usr/bin/${pkgname}"
  install -Dm 755 include/cxx.h -t "${pkgdir}/usr/share/${pkgname}/"

  install -Dm 644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
  install -Dm 644 LICENSE-* -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

