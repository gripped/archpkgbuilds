# Maintainer: Bert Peters <bertptrs@archlinux.org>
# Contributor: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=cxxbridge
pkgver=1.0.200
pkgrel=1
pkgdesc='Safe interop between Rust and C++'
url='https://github.com/dtolnay/cxx'
arch=('x86_64')
license=('Apache-2.0' 'MIT')
depends=(
  'glibc'
  'libgcc'
)
makedepends=('cargo')
options=(!lto)
source=(https://github.com/dtolnay/cxx/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz
        Cargo.lock)
sha256sums=('09a937d339b1712ca154fb25473a84e5624eb53cece90b5d035bc4b1098fcf06'
            '75b19fc6c784ee80ebb072e27c18bb91b805702522c4f25df4782b6b18e11e30')
b2sums=('97dfc118ab077cb3fa3d26eb085f9adad3f7424251330d43298f036b31a7c41dbff63979730f2a3e15f309c1b6a39a795f7046026b07489c74abbe711b1ba2fd'
        '0c9b47c311d643b943e8ebd4e1b08e18329119dda8cc60e5ab1d3f5d9f447e44b702dcc02fd99f0a3bc937be66e26ed1b274cc402887227a6058c1a2247e39cc')

prepare() {
  cd "cxx-${pkgver}"
  cp ../Cargo.lock .
  cargo fetch --locked --target host-tuple
}

updlockfiles() {
  cd "cxx-${pkgver}"
  rm -f Cargo.lock
  cargo update
  cp Cargo.lock "${outdir}/"
}

build() {
  cd "cxx-${pkgver}"
  cargo build --frozen --release --package cxxbridge-cmd
}

check() {
  cd "cxx-${pkgver}"
  cargo test --frozen --release --package cxxbridge-cmd
}

package() {
  cd "cxx-${pkgver}"
  install -Dm 755 target/release/${pkgname} "${pkgdir}/usr/bin/${pkgname}"
  install -Dm 755 include/cxx.h -t "${pkgdir}/usr/share/${pkgname}/"

  install -Dm 644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
  install -Dm 644 LICENSE-* -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

