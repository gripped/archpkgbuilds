# Contributor: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=cxxbridge
pkgver=1.0.202
pkgrel=1
pkgdesc='Safe interop between Rust and C++'
url='https://github.com/dtolnay/cxx'
arch=('x86_64')
license=('Apache-2.0' 'MIT')
depends=(
  'glibc'
  'libgcc'
)
makedepends=('cargo')
options=(!lto)
source=(https://github.com/dtolnay/cxx/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz
        Cargo.lock)
sha256sums=('a234049326b9ebd8569906a582c8c44764452d036b73dc3f790adb7d3dc04c65'
            'b2e3fc9f38a0985dfad869363d57107597734322193ef88608819d5c91e7008b')
b2sums=('bd0c3fd26ba376cb52d9340537b08d8e760d4970e6be06b608d95d4923c76f9cf997b290499c924c82e7fe1a00b608884815406c6905d4c472a93a96a916d3e7'
        'cbe0ecf448abdda1e9e42dc3e8e80637b95a7938c12beaea9bf2c0274a6bf388406abf70a06ab08472d3cbe0101fe71aa335060bc7b0d30a90a4cece0b5797f8')

prepare() {
  cd "cxx-${pkgver}"
  cp ../Cargo.lock .
  cargo fetch --locked --target host-tuple
}

updlockfiles() {
  cd "cxx-${pkgver}"
  rm -f Cargo.lock
  cargo update
  cp Cargo.lock "${outdir}/"
}

build() {
  cd "cxx-${pkgver}"
  cargo build --frozen --release --package cxxbridge-cmd
}

check() {
  cd "cxx-${pkgver}"
  cargo test --frozen --release --package cxxbridge-cmd
}

package() {
  cd "cxx-${pkgver}"
  install -Dm 755 target/release/${pkgname} "${pkgdir}/usr/bin/${pkgname}"
  install -Dm 755 include/cxx.h -t "${pkgdir}/usr/share/${pkgname}/"

  install -Dm 644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
  install -Dm 644 LICENSE-* -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

