# Maintainer: Bert Peters <bertptrs@archlinux.org>
# Contributor: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=cxxbridge
pkgver=1.0.199
pkgrel=1
pkgdesc='Safe interop between Rust and C++'
url='https://github.com/dtolnay/cxx'
arch=('x86_64')
license=('Apache-2.0' 'MIT')
depends=(
  'glibc'
  'libgcc'
)
makedepends=('cargo')
options=(!lto)
source=(https://github.com/dtolnay/cxx/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz
        Cargo.lock)
sha256sums=('e4c86e54d42827a99661e19639911e9e88339b742f88e519e8f2ffabc7bff7bf'
            '0fb09fac4b7f44e873a78d8207d0349fa8387b81055d100103c78167f5b1bd31')
b2sums=('a23e4eebac18b50f8fd44afcd2c87da338f0c3248523c1e42e3837bcffaf5673f2eefc4aaba6ca5044a62f987256eb3250e622e1ede365ff6e1cf4dc37e1870b'
        'a186e851b37a47e4bb423124888e935482ae44d0c418bb77754976fe74c17a4d61148a412e84dc2eddb1e4f815afef9ca8cc98987108bd61d362a1de9fbc9cbf')

prepare() {
  cd "cxx-${pkgver}"
  cp ../Cargo.lock .
  cargo fetch --locked --target host-tuple
}

updlockfiles() {
  cd "cxx-${pkgver}"
  rm -f Cargo.lock
  cargo update
  cp Cargo.lock "${outdir}/"
}

build() {
  cd "cxx-${pkgver}"
  cargo build --frozen --release --package cxxbridge-cmd
}

check() {
  cd "cxx-${pkgver}"
  cargo test --frozen --release --package cxxbridge-cmd
}

package() {
  cd "cxx-${pkgver}"
  install -Dm 755 target/release/${pkgname} "${pkgdir}/usr/bin/${pkgname}"
  install -Dm 755 include/cxx.h -t "${pkgdir}/usr/share/${pkgname}/"

  install -Dm 644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
  install -Dm 644 LICENSE-* -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

