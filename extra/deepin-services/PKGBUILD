# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-services
pkgver=1.0.21
pkgrel=1
pkgdesc='Manage DBus service on Deepin'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-services"
license=('LGPL-3.0-or-later')
depends=(glibc libgcc libstdc++ systemd-libs qt6-base dtk6core dtk6gui glib2 libx11 libxcb
         deepin-service-manager)
makedepends=(git cmake ninja)
groups=(deepin)
source=(git+https://github.com/linuxdeepin/dde-services.git#tag=$pkgver)
sha512sums=('dbf5eafff2dd88f8417751fec4068379d14371ea9a4a2570cf5584c67c801d46e7a595a4671c3174dedc9c683340ceb472521b5308cb89ee907c5c7adcf76c1e')

build() {
  cd dde-services
  cmake -GNinja . -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DENABLE_PLUGIN_IPWATCHD=OFF
  ninja
}

package() {
  cd dde-services
  DESTDIR="$pkgdir" ninja install
}
