# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-services
pkgver=1.0.49
pkgrel=1
pkgdesc='Manage DBus service on Deepin'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-services"
license=('LGPL-3.0-or-later' 'GPL-3.0-or-later' 'CC0-1.0')
depends=(glibc libgcc libstdc++ systemd-libs qt6-base qt6-wayland dtk6core dtk6gui glib2
         libx11 libxcb libxext libxss libxtst polkit-qt6 python wayland xcb-util-keysyms
         deepin-service-manager deepin-power-control)
makedepends=(git cmake ninja qt6-tools treeland-protocols wayland-protocols wlr-protocols)
checkdepends=(dbus qt6-imageformats xorg-server-xvfb xorg-xauth)
optdepends=('deepin-daemon: for power-event sound effects'
            'deepin-screensaver: for idle screensaver support')
groups=(deepin)
source=(git+https://github.com/linuxdeepin/dde-services.git#tag=$pkgver)
sha512sums=('04dd8cb48b8082d050d5aacd27493b89839ecd255b0b2cd77ba5cb364640b214eb077a580dea2d5623b8cf7284caee42489e9d77f56b7a4670965d2c2ac9f9a2')

build() {
  cd dde-services
  cmake -GNinja . -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DENABLE_PLUGIN_IPWATCHD=OFF \
    -DENABLE_COVERAGE=OFF \
    -DBUILD_SHORTCUT_DEBUG_BINARY=OFF
  ninja

  # The wallpaper regression suite is a separate CMake project.
  cmake -GNinja -S src/plugin-qt/wallpapercache/tests -B build-wallpapercache
  ninja -C build-wallpapercache
}

check() {
  cd dde-services
  dbus-run-session xvfb-run -a ctest --output-on-failure
  ctest --test-dir build-wallpapercache --output-on-failure
}

package() {
  cd dde-services
  DESTDIR="$pkgdir" ninja install
}
