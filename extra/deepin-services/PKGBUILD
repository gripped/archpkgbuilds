# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-services
pkgver=1.0.38
pkgrel=1
pkgdesc='Manage DBus service on Deepin'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-services"
license=('LGPL-3.0-or-later' 'GPL-3.0-or-later' 'CC0-1.0')
depends=(glibc libgcc libstdc++ systemd-libs qt6-base qt6-wayland dtk6core dtk6gui glib2
         libx11 libxcb libxtst python wayland xcb-util-keysyms
         deepin-service-manager)
makedepends=(git cmake ninja qt6-tools treeland-protocols wayland-protocols wlr-protocols)
groups=(deepin)
source=(git+https://github.com/linuxdeepin/dde-services.git#tag=$pkgver)
sha512sums=('8db8b5a01e6b3ef280660b84430cf00032e464951bf56053734648085617eaac28be72814248010fbde1e3b5bc123220c3fb6a1f7a442acb881250a67685d65e')

build() {
  cd dde-services
  cmake -GNinja . -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DENABLE_PLUGIN_IPWATCHD=OFF \
    -DBUILD_SHORTCUT_DEBUG_BINARY=OFF
  ninja
}

package() {
  cd dde-services
  DESTDIR="$pkgdir" ninja install
}
