# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: zccrs <zhangjide@deepin.org>

pkgname=ddm
pkgver=0.3.7
pkgrel=1
pkgdesc='New Display Manager for DDE'
arch=('x86_64')
url="https://github.com/linuxdeepin/ddm"
license=('GPL-2.0-or-later')
groups=('deepin')
depends=(bash
         glibc
         libgcc
         libstdc++
         libxau
         pam
         qt6-base
         systemd-libs
         treeland
         ttf-font
         wayland
         xorg-server
         xorg-xauth)
makedepends=(git
             extra-cmake-modules
             python-docutils
             treeland-protocols
             ninja)
source=("git+https://github.com/linuxdeepin/ddm.git#tag=$pkgver"
        "0001-fix-pam-fork-atexit-deadlock.patch")
sha512sums=('36b374347dd8f956b929c6f839fce048188b12c6f3b42777b34f1c60e971ef98b7d3050bc92490d69a9900ed9a40fa634971373ccc0e975c0c4dbfaee1fc9caa'
            '188bad970a86ce480e11c39987af16f38e8cd4434d644e2d7f6b6200e306fdd12addca3d39fb84a232837bc334da7c7b8a056ac87d49e9baf676706c9150c158')

prepare() {
  cd ddm
  patch -Np1 < "${srcdir}/0001-fix-pam-fork-atexit-deadlock.patch"
}

build() {
  cd ddm
  cmake . -GNinja \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_LIBEXECDIR=lib \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DDBUS_CONFIG_DIR=/usr/share/dbus-1/system.d

  cmake --build .
}

package() {
  cd ddm
  DESTDIR="$pkgdir" ninja install

  # Provided by lightdm and other display managers implementing the interface
  rm "$pkgdir/usr/share/dbus-1/system.d/org.freedesktop.DisplayManager.conf"
}
