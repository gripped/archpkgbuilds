# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: zccrs <zhangjide@deepin.org>

pkgname=ddm
pkgver=0.5.0
pkgrel=1
pkgdesc='New Display Manager for DDE'
arch=('x86_64')
url="https://github.com/linuxdeepin/ddm"
license=('GPL-2.0-or-later')
groups=('deepin')
depends=(bash
         deepin-app-services
         deepin-seatd
         dtk6core
         glibc
         libgcc
         libstdc++
         libxau
         pam
         qt6-base
         systemd-libs
         treeland
         ttf-font
         wayland
         xorg-server
         xorg-xauth)
makedepends=(git
             extra-cmake-modules
             python-docutils
             treeland-protocols
             ninja)
source=("git+https://github.com/linuxdeepin/ddm.git#tag=$pkgver")
sha512sums=('899cd86b8ed3ea6a80bad55f54f1ce16c4e82a222227af2d67c7228eac23ed81f4d0d6801a9f6d254a0f6f10ba82558864c323e77ade0c00c6604656b8ab7414')

prepare() {
  cd ddm
  # Use Arch PAM stack names for the non-Debian autologin service.
  sed -i \
    -e 's|@include common-account|account     include     system-login|' \
    -e 's|@include common-session|session     include     system-login|' \
    services/ddm-autologin.pam
}

build() {
  cd ddm
  cmake . -GNinja \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_LIBEXECDIR=lib \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DDBUS_CONFIG_DIR=/usr/share/dbus-1/system.d

  cmake --build .
}

package() {
  cd ddm
  DESTDIR="$pkgdir" ninja install

  # Provided by lightdm and other display managers implementing the interface
  rm "$pkgdir/usr/share/dbus-1/system.d/org.freedesktop.DisplayManager.conf"
}
