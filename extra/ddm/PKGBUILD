# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: zccrs <zhangjide@deepin.org>

pkgname=ddm
pkgver=0.3.4
pkgrel=1
pkgdesc='New Display Manager for DDE'
arch=('x86_64')
url="https://github.com/linuxdeepin/ddm"
license=('GPL-2.0-or-later')
groups=('deepin')
depends=(bash
         glibc
         libgcc
         libstdc++
         libxau
         pam
         qt6-base
         systemd-libs
         treeland
         ttf-font
         wayland
         xorg-server
         xorg-xauth)
makedepends=(git
             extra-cmake-modules
             python-docutils
             treeland-protocols
             ninja)
source=("git+https://github.com/linuxdeepin/ddm.git#tag=$pkgver"
        "0001-fix-pam-fork-atexit-deadlock.patch")
sha512sums=('dad842e07b55f9935512f5bab145cea61671c2a98013fcfaecd6db25d777859635e8afe4408490c946d6d6b3ae0a0e7f0673447cd4a7112883f7e0cb68af3c38'
            '5998b86342f3619a5591bdc87da59fab104ce1d56e4668fe0ff5d285f6680bc25f5c41b0bc9a8b1576a3bb52a93eff3bd89622984cde46c4f7cd4fed49f59eca')

prepare() {
  cd ddm
  patch -Np1 < "${srcdir}/0001-fix-pam-fork-atexit-deadlock.patch"
}

build() {
  cd ddm
  cmake . -GNinja \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DCMAKE_INSTALL_LIBEXECDIR=lib \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DDBUS_CONFIG_DIR=/usr/share/dbus-1/system.d

  cmake --build .
}

package() {
  cd ddm
  DESTDIR="$pkgdir" ninja install

  # Provided by lightdm and other display managers implementing the interface
  rm "$pkgdir/usr/share/dbus-1/system.d/org.freedesktop.DisplayManager.conf"
}
