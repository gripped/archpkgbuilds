# Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>
# Contributor: Archisman Panigrahi <apandada1ATgmail.com>
# Contributor: MareDevi <maredevi at foxmail dot com>
pkgname=readest
_Packagename=Readest
pkgver=0.12.26
pkgrel=1
pkgdesc="Modern, feature-rich ebook reader"
arch=('x86_64')
url='https://github.com/readest/readest'
license=('AGPL-3.0-or-later')
depends=('alsa-lib' 'cairo' 'libgcc' 'fontconfig' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk3' 'hicolor-icon-theme' 'pango')
makedepends=('clang' 'git' 'librsvg' 'pnpm' 'npm' 'nodejs' 'rust')
source=("git+https://github.com/readest/readest.git#tag=v$pkgver"
        readest.sh)
sha256sums=('e3c6b5406b631545aaf4f092b3fe0357ab4d4275762a113fb7b00b21c3de0851'
            '4be824107dbbe6c3d18d1f3ef4c93de5101ba8ae060061f29df82bc1e1b9a590')
options=(!lto)  # Disable Link Time Optimization. Otherwise build fails with some 'cc' linking error.

prepare() {
  cd $pkgname
  git submodule update --init --recursive
  pnpm install
  pnpm --filter @readest/readest-app setup-vendors
  # Disable updater artifacts in tauri.conf.json
  # Otherwise it will try to sign the built package with developer's GPG key which is unnecessary,
  # and then it causes build failure because the GPG key is not available in the build environment.
  # Also the updater artifacts are not needed for the AUR package.
  # For more details, see https://github.com/tauri-apps/tauri/issues/13259
  sed -i 's/"createUpdaterArtifacts": true/"createUpdaterArtifacts": false/' \
    apps/$pkgname-app/src-tauri/tauri.conf.json
}

build() {
  cd $pkgname
  pnpm tauri build -b deb
}

package() {
  cd $pkgname
  cp -a target/release/bundle/deb/$_Packagename_*/data/* "${pkgdir}"
  mv "$pkgdir"/usr/share/applications/{$_Packagename,com.bilingify.readest}.desktop
  # Replace the /usr/bin symlink with a launcher working around a CEF crash
  rm "$pkgdir"/usr/bin/readest
  install -Dm755 "$srcdir"/readest.sh "$pkgdir"/usr/bin/readest
  install -Dm644 data/metainfo/appdata.xml "$pkgdir"/usr/share/metainfo/com.bilingify.readest.appdata.xml
}
