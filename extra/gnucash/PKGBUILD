pkgbase=gnucash
pkgname=(
  gnucash
  gnucash-docs
)
pkgver=5.16
pkgrel=2
pkgdesc='Personal and small-business financial-accounting application'
arch=(x86_64)
url='https://code.gnucash.org/website/'
license=(GPL-2.0-or-later)
makedepends=(
  aqbanking
  boost
  boost-libs
  cairo
  cmake
  dconf
  gdk-pixbuf2
  git
  glib2
  glibc
  gtest
  gtk3
  guile
  gwenhywfar
  gwenhywfar-gtk
  hicolor-icon-theme
  icu
  libdbi
  libdbi-drivers
  libgcc
  libofx
  libsecret
  libstdc++
  libxml2
  libxslt
  mariadb-libs
  pango
  postgresql-libs
  python
  swig
  webkit2gtk-4.1
  yelp
  zlib
)
source=(
  "git+https://github.com/Gnucash/gnucash.git#tag=$pkgver"
  "git+https://github.com/Gnucash/gnucash-docs.git#tag=$pkgver"
  "$pkgbase-fix-odr-violation-test-engine.patch"
)
b2sums=('50d70487c808703bfc53b7276d0ed53e92613c05e6c116b20aae6329e4af84ed916e48e365dc0882501702f4418a0ba11a7c6c49095eaa377b127efae1d939fa'
        '41fb452ebfb813e86c20134c5795da0f274bcce1e46fe9849b80e82c3a5ac011d2daec3e4280d755820899edf42008770f8a1c9e24bec5b87afa5c1c43d4bbe0'
        '9193e773bb4ef1f2cb74dbdd23f4e651be480ebdbf465459a63426a9cdef7de7963a1865146a1b8e3e20599a80db198b080b7086731947cfb47e8e2679803d0a')

prepare() {
  cd $pkgbase
  sed -e 's/-Werror//g' -i CMakeLists.txt
  git cherry-pick -n 17bb7f9e3f8fd8f69dd5a989bbdd6e352bd673da # Fix build with swig 4.5
  patch -Np1 < ../$pkgbase-fix-odr-violation-test-engine.patch
}

build() {
  export BUILDING_FROM_VCS=no
  cmake -B build -S $pkgbase \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev \
    -DWITH_PYTHON=ON \
    -DCOMPILE_GSCHEMAS=OFF \
    -DGNUCASH_BUILD_ID="$pkgver-$(git -C $pkgbase rev-parse HEAD)"
  cmake --build build

  cmake -B build-docs -S $pkgbase-docs \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build-docs

  # ChangeLog not built when setting BUILDING_FROM_VCS=no but is a hard
  # requirement for installing.
  cd $pkgbase
  git log --format="%ad %aN %n%n%x09* %s%d%n" --date=short --since=2024-01-01 > ChangeLog
}

check() {
  cmake --build build --target testbuild sqlite3test
  local skip_tests=(
    test-qof
    test-gnc-numeric
  )
  local skip_tests_pattern="${skip_tests[0]}$(printf '|%s' "${skip_tests[@]:1}")"
  ctest --test-dir=build --output-on-failure -E "$skip_tests_pattern"
}

package_gnucash() {
  depends=(
    aqbanking
    boost-libs
    cairo
    dconf
    gdk-pixbuf2
    glib2
    glibc
    gtk3
    guile
    gwenhywfar
    gwenhywfar-gtk
    hicolor-icon-theme
    icu
    libdbi
    libgcc
    libofx
    libsecret
    libstdc++
    libxml2
    pango
    webkit2gtk-4.1
    zlib
  )
  optdepends=(
    'libdbi-drivers: open and save data into SQL database'
    'perl-date-manip: stock information lookups'
    'perl-finance-quote: stock information lookups'
    'python-gobject: Python scripting and console'
  )

  DESTDIR="$pkgdir" cmake --install build
  # Delete the gnucash-valgrind executable because the source files are not
  # included with the package and the executable is hardlinked to the location
  # that it was built at.
  rm -v "$pkgdir/usr/bin/gnucash-valgrind"
}

package_gnucash-docs() {
  pkgdesc+=' (Documentation)'
  license=(GFDL-1.1-only)
  depends=(yelp)

  DESTDIR="$pkgdir" cmake --install build-docs
}
