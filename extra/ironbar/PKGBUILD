# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=ironbar
pkgver=0.19.0
pkgrel=2
pkgdesc="Customisable Wayland GTK4 bar written in Rust"
arch=(x86_64)
url="https://github.com/JakeStanger/ironbar"
license=(MIT)
depends=(
  cairo
  dbus
  gdk-pixbuf2
  glib2
  glibc
  gtk4
  gtk4-layer-shell
  libevdev
  libgcc
  libinput
  libpulse
  luajit
  lua51-lgi
  pango
  systemd-libs
)
makedepends=(rust)
optdepends=(
  'networkmanager: for network_manager module'
  'swaync: for notifications module'
  'ttf-font-nerd: for displaying text-based icons'
)
options=(!lto)
source=(
  $pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz
)
sha512sums=('7bd0c81470acbf5987df260ca587b9aee45de4d95853a2244c673f9a00679de0d2b6597c24f7cb5b355c57b7cba4cb9322d81aa5109a41bc6368b3dbfdcf3d52')
b2sums=('a3091ca4f50a581bedac0cd7136aabb09410a5f36f39f05597b8dae37bcb84195c8be7a291c24f8dcb5f83dfbd3c8f0b61873040c46ca5b0df7b44e120c62523')

prepare() {
  cd $pkgname-$pkgver
  cargo fetch --locked --target host-tuple
}

build() {
  cd $pkgname-$pkgver

  cargo build --frozen --release

  local _shell
  for _shell in bash fish zsh; do
    ./target/release/$pkgname --print-completions "$_shell" > $pkgname.$_shell
  done
}

check() {
  cd $pkgname-$pkgver
  cargo test --frozen
}

package() {
  cd $pkgname-$pkgver
  install -vDm 755 target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 {README,CHANGELOG}.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -vDm 644 $pkgname.bash "$pkgdir/usr/share/bash-completion/completions/$pkgname"
  install -vDm 644 $pkgname.fish -t "$pkgdir/usr/share/fish/vendor_completions.d/"
  install -vDm 644 $pkgname.zsh "$pkgdir/usr/share/zsh/site-functions/_$pkgname"
  install -vDm 644 $pkgname.service -t "$pkgdir/usr/lib/systemd/user/"
  cp -rv examples "$pkgdir/usr/share/doc/$pkgname/"
}
