# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=hypnotix
pkgver=5.10
pkgrel=1
pkgdesc='IPTV streaming application with support for live TV, movies and series'
arch=(any)
url='https://github.com/linuxmint/hypnotix'
license=(GPL-3.0-or-later)
groups=(x-apps)
depends=(
  bash
  dconf
  gdk-pixbuf2
  glib2
  gtk3
  hicolor-icon-theme
  mpv
  pango
  python
  python-gobject
  python-pillow
  python-requests
  python-setproctitle
  python-unidecode
  xapp
  yt-dlp
)
makedepends=(git)
source=("git+https://github.com/linuxmint/hypnotix.git#tag=$pkgver")
b2sums=(ebc9c8f90e8904f7f40d873ec60a52d72ff78552bfc8eb90883a46bd4177419e333c0979e85c3d191b6d3ccf8baf0eb36d0223488127836f5725ea0d4b62656a)

prepare() {
  cd $pkgname

  # Set version number
  sed -i "s/__DEB_VERSION__/$pkgver/" usr/lib/hypnotix/hypnotix.py
}

build() {
  cd $pkgname
  make
}

package() {
  cd $pkgname
  cp -r usr "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
