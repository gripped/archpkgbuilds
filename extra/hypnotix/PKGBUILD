# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=hypnotix
pkgver=5.7
pkgrel=2
pkgdesc='IPTV streaming application with support for live TV, movies and series'
arch=(any)
url='https://github.com/linuxmint/hypnotix'
license=(GPL-3.0-or-later)
groups=(x-apps)
depends=(
  bash
  dconf
  gdk-pixbuf2
  glib2
  gtk3
  hicolor-icon-theme
  mpv
  pango
  python
  python-gobject
  python-pillow
  python-requests
  python-setproctitle
  python-unidecode
  xapp
  yt-dlp
)
makedepends=(git)
source=("git+https://github.com/linuxmint/hypnotix.git#tag=$pkgver")
b2sums=(5132204c88d769810fdf0ba4557570c89a7634ff00ffa9f397b70daa6dc51052af3c4371d7812350e73f099df2712d7d0c0ee0721b3faef26b89c62da436cbfd)

prepare() {
  cd $pkgname

  # Disable SDL video output
  git cherry-pick -n 5d1932c4db337eb9c0cf98af3bbfea756abdaece

  # Use GDK_BACKEND environment variable to select x11 backend
  # https://github.com/linuxmint/hypnotix/pull/418
  git cherry-pick -n b0398151a48d6bbac1ce8ee134ca47196f448af2

  # Fix missing conversion of label values to string
  # https://github.com/linuxmint/hypnotix/pull/432
  git cherry-pick -n 060fffd0661e095c31839e3795c3393dd1d22196

  # Set version number
  sed -i "s/__DEB_VERSION__/$pkgver/" usr/lib/hypnotix/hypnotix.py
}

build() {
  cd $pkgname
  make
}

package() {
  cd $pkgname
  cp -r usr "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
