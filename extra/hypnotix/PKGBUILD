# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=hypnotix
pkgver=5.6
pkgrel=2
pkgdesc='IPTV streaming application with support for live TV, movies and series'
arch=(any)
url='https://github.com/linuxmint/hypnotix'
license=(GPL-3.0-or-later)
groups=(x-apps)
depends=(
  bash
  dconf
  gdk-pixbuf2
  glib2
  gtk3
  hicolor-icon-theme
  mpv
  pango
  python
  python-gobject
  python-pillow
  python-requests
  python-setproctitle
  python-unidecode
  xapp
  yt-dlp
)
makedepends=(git)
source=("git+https://github.com/linuxmint/hypnotix.git#tag=$pkgver")
b2sums=(fa02d80d39a8a83feda02a77c70cd63163940a38b066d9810be61ea1ab646b57ce719f87137eaf7e82d698a7ba684513b6e5753e6fe36a15cabcf7de85fab288)

prepare() {
  cd $pkgname

  # Set mpv video output to 'x11' by default
  # https://github.com/linuxmint/hypnotix/pull/405
  sed -i '/options = {}/a\        options["vo"] = "x11"' usr/lib/hypnotix/hypnotix.py

  # Set version number
  sed -i "s/__DEB_VERSION__/$pkgver/" usr/lib/hypnotix/hypnotix.py
}

build() {
  cd $pkgname
  make
}

package() {
  cd $pkgname
  cp -r usr "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
