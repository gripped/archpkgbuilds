# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=simple-ccsm
pkgver=0.8.18
pkgrel=1
pkgdesc='Simple configuration manager for Compiz'
arch=(any)
url='https://gitlab.com/compiz/simple-ccsm'
license=(GPL-2.0-or-later)
depends=(
  ccsm
  compiz-core
  glib2
  gtk3
  hicolor-icon-theme
  python
  python-cairo
  python-compizconfig
  python-gobject
)
makedepends=(
  git
  intltool
  python-build
  python-installer
  python-setuptools
  python-wheel
)
source=(
  "git+https://gitlab.com/compiz/simple-ccsm.git#tag=v$pkgver"
  simple-ccsm-fix-missing-parameter.patch
  simple-ccsm-fix-zoom-toggle.patch
  simple-ccsm-fix-reflection-toggle.patch
  simple-ccsm-fix-shift-mode.patch
  simple-ccsm-extra-animations.patch
  simple-ccsm-pep-517.patch
)
