prepare() {
  cd $pkgname

  # Fix conflict constructor calls
  # https://gitlab.com/compiz/simple-ccsm/-/merge_requests/8
  git apply -3 ../simple-ccsm-fix-missing-parameter.patch

  # Fix zoom plugin handling
  # https://gitlab.com/compiz/simple-ccsm/-/merge_requests/9
  git apply -3 ../simple-ccsm-fix-zoom-toggle.patch

  # Disable reflection toggle when plugin is unavailable
  # https://gitlab.com/compiz/simple-ccsm/-/merge_requests/10
  git apply -3 ../simple-ccsm-fix-reflection-toggle.patch

  # Fix shift switcher mode selection
  # https://gitlab.com/compiz/simple-ccsm/-/merge_requests/11
  git apply -3 ../simple-ccsm-fix-shift-mode.patch

  # Fix extra animations checkbox sensitivity
  # https://gitlab.com/compiz/simple-ccsm/-/merge_requests/12
  git apply -3 ../simple-ccsm-extra-animations.patch

  # Fix build with PEP 517
  git apply -3 ../simple-ccsm-pep-517.patch
}

build() {
  cd $pkgname
  PREFIX=/usr python -m build --wheel --no-isolation
}

package() {
  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
}
