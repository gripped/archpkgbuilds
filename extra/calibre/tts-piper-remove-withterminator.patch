From ad470db8d04c7c36d8fdbde91507dc368e979f5c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonathan=20Grotel=C3=BCschen?= <tippfehlr@tippfehlr.eu>
Date: Sat, 8 Aug 2026 11:20:46 +0200
Subject: [PATCH] espeak-ng headers do not provide
 espeak_TextToPhonemesWithTerminator

---
 src/calibre/utils/tts/piper.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/calibre/utils/tts/piper.cpp b/src/calibre/utils/tts/piper.cpp
index 3986b4cec5..613835810b 100644
--- a/src/calibre/utils/tts/piper.cpp
+++ b/src/calibre/utils/tts/piper.cpp
@@ -412,7 +412,7 @@ phonemize(PyObject *self, PyObject *args) {
         int terminator = 0;
         const char *phonemes;
         Py_BEGIN_ALLOW_THREADS;
-        phonemes = espeak_TextToPhonemesWithTerminator((const void **)&text, espeakCHARS_UTF8, phoneme_mode, &terminator);
+        phonemes = espeak_TextToPhonemes((const void **)&text, espeakCHARS_UTF8, phoneme_mode);
         Py_END_ALLOW_THREADS;
         // Categorize terminator
         const char *terminator_str = categorize_terminator(terminator);
@@ -564,7 +564,7 @@ start(PyObject *self, PyObject *args) {
     const void *text_ptr = text;
     while (text_ptr != nullptr) {
         int terminator = 0;
-        const char *phonemes = espeak_TextToPhonemesWithTerminator(&text_ptr, espeakCHARS_UTF8, espeakPHONEMES_IPA, &terminator);
+        const char *phonemes = espeak_TextToPhonemes(&text_ptr, espeakCHARS_UTF8, espeakPHONEMES_IPA);
         if (phonemes) sentence_phonemes[current_idx] += phonemes;
         const char *terminator_str = categorize_terminator(terminator);
         sentence_phonemes[current_idx] += terminator_str;
-- 
