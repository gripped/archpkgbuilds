# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-caio
pkgver=0.12.10
pkgrel=1
pkgdesc="Asynchronous file I/O for Linux, macOS and Windows"
arch=('x86_64')
url="https://github.com/mosquito/caio"
license=('Apache-2.0' 'BSD-2-Clause')
depends=('glibc' 'python')
makedepends=(
  'git'
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
checkdepends=(
  'python-aiomisc'
  'python-pytest'
  'python-pytest-asyncio'
  'python-pytest-rerunfailures'
)
source=("git+https://github.com/mosquito/caio.git#tag=$pkgver")
sha512sums=('ff48972b08a50070b5a4acbdb236bd3652ce69cf2aebc94b67b1bf203880a133b6ab4ab7f9018ac856076da299602305c0f8bb6111c4e02167b192c284158d1e')

prepare() {
  cd caio
  # Upstream stamps the release version after checking out the tag.
  # https://github.com/mosquito/caio/blob/0.12.10/.github/workflows/publish.yml
  sed -i "s/^version = .*/version = \"$pkgver\"/" pyproject.toml
}

build() {
  cd caio
  python -m build --wheel --no-isolation
}

check() {
  cd caio
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl

  # Run outside the source package so tests import the installed native extensions.
  cd tests
  ../test-env/bin/python -m pytest --asyncio-mode=auto
}

package() {
  cd caio
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
  install -Dm644 caio/src/threadpool/LICENSE "$pkgdir"/usr/share/licenses/$pkgname/threadpool-LICENSE
}
