# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-aiothreads
pkgver=1.1.4
pkgrel=1
pkgdesc="Glue between async and thread worlds"
arch=('any')
url="https://github.com/mosquito/aiothreads"
license=('Apache-2.0')
depends=('python')
makedepends=(
  'git'
  'python-build'
  'python-hatchling'
  'python-installer'
  'python-wheel'
)
checkdepends=(
  'mypy'
  'python-async-timeout'
  'python-markdown-pytest'
  'python-pytest'
  'python-pytest-asyncio'
  'python-pytest-cov'
  'python-pytest-mypy-plugins'
)
source=("git+https://github.com/mosquito/aiothreads.git#tag=$pkgver")
sha512sums=('054a40b56d2b9d247164186252e9cba5c5fadecd026473ea666df5a379e9842357183db0c35c2d015c0a89d2bc23babb8139d9c76ae0511a9accf10040bc537c')

prepare() {
  cd aiothreads
  # Upstream stamps the release version after checking out the tag.
  # https://github.com/mosquito/aiothreads/blob/1.1.4/.github/workflows/publish.yml
  sed -i "s/^version = .*/version = \"$pkgver\"/" pyproject.toml

  # Mypy no longer includes the builtins prefix in revealed types.
  # https://github.com/python/mypy/pull/20929
  sed -i 's/builtins\\\.//g' tests/test_type_checking.yml
}

build() {
  cd aiothreads
  python -m build --wheel --no-isolation
}

check() {
  cd aiothreads
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd aiothreads
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
