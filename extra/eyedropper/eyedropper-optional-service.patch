 data/resources/ui/preferences.blp             |  9 +++
 data/resources/ui/window.blp                  |  1 -
 src/application.rs                            | 69 +++++++++++++++++--
 src/widgets/preferences/preferences_window.rs |  7 ++
 src/window.rs                                 |  4 ++
 6 files changed, 88 insertions(+), 7 deletions(-)

