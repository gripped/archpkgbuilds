From bb4616a8dab02d30200b3e0206d987504aab46f7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ball=C3=B3=20Gy=C3=B6rgy?= <ballogyor@gmail.com>
Date: Thu, 26 Nov 2026 13:21:04 +0100
Subject: [PATCH] Add a setting to control background operation

Add a preference to enable or disable background operation.

When enabled, the application requests background access, registers
global shortcuts, and hides the window instead of closing it.

When disabled, background access and global shortcuts are not
configured, and closing the window exits the application.

Also keep the application running in service mode only when
background operation is enabled.
---
 ...ithub.finefindus.eyedropper.gschema.xml.in |  5 +++++
 data/resources/ui/preferences.blp             |  9 +++++++++
 data/resources/ui/window.blp                  |  1 -
 src/application.rs                            | 19 ++++++++++++++-----
 src/widgets/preferences/preferences_window.rs |  7 +++++++
 src/window.rs                                 |  2 ++
 6 files changed, 37 insertions(+), 6 deletions(-)

diff --git a/data/com.github.finefindus.eyedropper.gschema.xml.in b/data/com.github.finefindus.eyedropper.gschema.xml.in
index f16bfeac..8501b02c 100644
--- a/data/com.github.finefindus.eyedropper.gschema.xml.in
+++ b/data/com.github.finefindus.eyedropper.gschema.xml.in
@@ -1,6 +1,11 @@
 <?xml version="1.0" encoding="utf-8"?>
 <schemalist>
   <schema path="/com/github/finefindus/eyedropper/" id="@app-id@" gettext-domain="@gettext-package@">
+    <key name="run-in-background" type="b">
+      <default>true</default>
+      <summary>Run in the Background</summary>
+      <description>Keep the application running after closing its window and enable global keyboard shortcuts.</description>
+    </key>
     <key name="visible-formats" type="as">
       <default>[ 'name', 'hex', 'rgb', 'hsl', 'hsv', 'cmyk' ]</default>
       <summary>Visible formats</summary>
