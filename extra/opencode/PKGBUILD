package_opencode() {
  depends=(
    'curl'
    'glibc'
    'icu'
    'ripgrep'
    'tar'
  )
  optdepends=(
    'wl-clipboard: clipboard support on Wayland'
    'xclip: clipboard support on X11'
  )

  cd $pkgbase
  case $CARCH in
    aarch64) target=linux-arm64 ;;
    x86_64) target=linux-x64-baseline ;;
  esac
  install -vDm755 -t "$pkgdir/usr/bin" "packages/cli/dist/cli-$target/bin/opencode"

  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE

  "$pkgdir/usr/bin/opencode" --completions bash \
    | install -vDm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/opencode"
  "$pkgdir/usr/bin/opencode" --completions fish \
    | install -vDm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/opencode.fish"
  "$pkgdir/usr/bin/opencode" --completions zsh \
    | install -vDm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_opencode"
}

package_opencode-desktop() {
  pkgdesc+=' (desktop app)'
  depends=(
    'electron44'
    'gcc-libs'
    'glibc'
    "opencode=$pkgver"
    'sh'
  )

  cd $pkgbase/packages/desktop

  local resources=dist/linux-unpacked/resources
  install -vDm644 -t "$pkgdir/usr/lib/$pkgname" $resources/app.asar $resources/opencode-cli.version
  cp -vr --no-preserve=ownership $resources/app.asar.unpacked "$pkgdir/usr/lib/$pkgname/"
  install -vDm644 -t "$pkgdir/usr/lib/$pkgname/icons" resources/icons/icon.png
  ln -vs /usr/bin/opencode "$pkgdir/usr/lib/$pkgname/opencode-cli"

  install -vDm755 "$srcdir/opencode-desktop.sh" "$pkgdir/usr/bin/opencode-desktop"
  # upstream's .desktop file is a hidden legacy entry, the real one is only
  # generated for the deb/rpm/AppImage targets
  install -vDm644 -t "$pkgdir/usr/share/applications" "$srcdir/ai.opencode.desktop.desktop"
  install -vDm644 -t "$pkgdir/usr/share/metainfo" resources/ai.opencode.desktop.metainfo.xml

  local size
  for size in 32 64 128; do
    install -vDm644 icons/prod/${size}x${size}.png \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/ai.opencode.desktop.png"
  done
  install -vDm644 icons/prod/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/ai.opencode.desktop.png"
  install -vDm644 icons/prod/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/ai.opencode.desktop.png"

  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" ../../LICENSE
}
