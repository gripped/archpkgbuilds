[Unit]
Description=PeerBanHelper Service
After=network.target

[Service]
User=peerbanhelper
LogsDirectory=peerbanhelper
StateDirectory=peerbanhelper
WorkingDirectory=/usr/share/java/peerbanhelper
ExecStart=/usr/bin/peerbanhelper
SuccessExitStatus=143
CapabilityBoundingSet=
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
