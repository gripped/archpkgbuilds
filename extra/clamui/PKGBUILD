# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=clamui
pkgver=0.5.1
pkgrel=1
pkgdesc='Modern GUI for ClamAV antivirus'
arch=(x86_64)
url='https://clamui.com/'
license=(MIT)
depends=(
  cairo
  clamav
  dbus
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  hicolor-icon-theme
  libgcc
  libsoup3
  sqlite
  wayland
  webkit2gtk-4.1
)
makedepends=(
  bun
  git
  rust
)
options=(!lto)
source=(
  "git+https://github.com/linx-systems/clamui.git#tag=v$pkgver"
  clamui-privileged-status.patch
)
b2sums=(
  40a43280500f44209b2ac09c5297d1f358a405f06b03833161e4c59e9f319c6817be2085ead8f9011104a0be0bf5aae8c17509c15f771c7b4a41b34136552007
  b09140f4492c62202f0e3e6c78591c467a1ede8e9f71eedf2453e09c011345c464f67033a5329c4ba9a70806119f12307055eca7215ca5d3009ba27b6c761916
)

prepare() {
  cd $pkgname
  bun install --cwd desktop --frozen-lockfile

  CARGO_HOME="$srcdir/cargo-home" \
    cargo fetch --locked --target "$(rustc --print host-tuple)"

  # The helper binary is shipped with this package, no need to check
  git apply -3 ../clamui-privileged-status.patch
}

build() {
  cd $pkgname

  bun run --cwd desktop build

  LIBSQLITE3_SYS_USE_PKG_CONFIG=1 \
    CARGO_HOME="$srcdir/cargo-home" \
    CARGO_PROFILE_RELEASE_LTO=true \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
    CARGO_PROFILE_RELEASE_DEBUG=2 \
    CARGO_PROFILE_RELEASE_STRIP=false \
    cargo build --frozen --release --all-features

  for po in po/*.po; do
    msgfmt "$po" -o "${po%.po}.mo"
  done
}

package() {
  cd $pkgname
  install -Dm755 -t "$pkgdir/usr/bin/" target/release/{clamui,clamui-apply-preferences,clamui-cli,clamui-scheduled-scan}
  install -Dm644 -t "$pkgdir/usr/share/polkit-1/actions/" data/io.github.linx_systems.ClamUI.policy
  install -Dm644 -t "$pkgdir/usr/share/applications/" data/io.github.linx_systems.ClamUI.desktop
  install -Dm644 -t "$pkgdir/usr/share/metainfo/" data/io.github.linx_systems.ClamUI.metainfo.xml
  install -Dm644 -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/" icons/io.github.linx_systems.ClamUI.svg
  install -Dm644 -t "$pkgdir/usr/share/icons/hicolor/128x128/apps/" icons/io.github.linx_systems.ClamUI.png
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE

  for mo in po/*.mo; do
    lang="${mo##*/}"
    lang="${lang%.mo}"
    install -Dm644 "$mo" "$pkgdir/usr/share/locale/$lang/LC_MESSAGES/clamui.mo"
  done
}
