pkgname=capnet-assist
pkgver=9.0.0
pkgrel=1
pkgdesc='Captive Portal Assistant'
arch=(x86_64)
url=https://github.com/elementary/capnet-assist
license=(GPL-3.0-or-later)
groups=(pantheon)
depends=(
  dconf
  gcr-4
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  libadwaita-1.so
  libgranite-7.so
  networkmanager
  webkitgtk-6.0
)
makedepends=(
  git
  meson
  vala
)
source=(git+https://github.com/elementary/capnet-assist.git#tag=${pkgver})
b2sums=('76286936b075fec68cd9f866e13f132cd751b019f023d40eb6926346cf205ef58ffd3a8c03441ccc495f9b93593a474a679cd33de1cdf1a40c2d3b67231ff8b0')

build() {
  arch-meson capnet-assist build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" meson install -C build
}

