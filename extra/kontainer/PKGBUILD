# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=kontainer
pkgver=1.6.2
pkgrel=2
pkgdesc='KDE application for Distrobox container management'
arch=(x86_64)
url='https://github.com/DenysMb/Kontainer'
license=(GPL-3.0-or-later)
depends=(
  distrobox
  glibc
  hicolor-icon-theme
  kconfig
  kcoreaddons
  ki18n
  kiconthemes
  kio
  kirigami
  kirigami-addons
  kservice
  libstdc++
  qqc2-desktop-style
  qt6-base
  qt6-declarative
)
makedepends=(
  cmake
  extra-cmake-modules
  git
  ninja
)
source=(
  "git+https://github.com/DenysMb/Kontainer.git#tag=$pkgver"
  kontainer-fix-appid.patch
)
b2sums=(
  bd3494b92042f3379fd3a7affd0e8f34fc6ad7e5e218643211d69960494d2f95608b28d4c6b4db89dce73ceeff858fca5fdb977e81bba1b07ce4e2cdd6c03b1e
  994f32ac9078ed4cf4864d4629b8a7d2eaa38c8a02526e668a6709aa0f3ece27320baf288a6a84d1f7088e4afc43256cbf8ebf066dcef96a295202d61bb19dbc
)

prepare() {
  cd Kontainer
  git apply -3 ../kontainer-fix-appid.patch
}

build() {
  cmake -S Kontainer -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_BUILD_TYPE=None
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
