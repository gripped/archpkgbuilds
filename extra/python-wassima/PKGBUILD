# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-wassima
pkgver=2.1.5
pkgrel=1
pkgdesc="Access operating system root certificates"
arch=('any')
url="https://github.com/jawah/wassima"
license=('MIT' 'CDLA-Permissive-2.0')
depends=('ca-certificates' 'python')
makedepends=('git' 'python-build' 'python-hatchling' 'python-installer')
checkdepends=('python-pytest' 'python-urllib3-future')
source=("git+https://github.com/jawah/wassima.git#tag=$pkgver")
sha256sums=('85a2b7c2d779845139e77bbf97a25144674eb394917e1c1742146c978154824f')

build() {
  cd wassima
  python -m build --wheel --no-isolation
}

check() {
  cd wassima
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd wassima
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE NOTICE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
