# Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>
# Contributor: Julius Michaelis <gitter@liftm.de>

pkgname=wasmer
pkgver=7.4.0
pkgrel=1
pkgdesc="Universal Binaries Powered by WebAssembly"
arch=('x86_64')
url="https://github.com/wasmerio/wasmer"
license=('MIT')
depends=('libgcc' 'libstdc++' 'zlib' 'ncurses' 'libffi' 'libxkbcommon' 'llvm' 'glibc')
makedepends=('clang' 'git' 'rustup' 'cmake')
source=("git+https://github.com/wasmerio/wasmer#tag=v${pkgver}"
        "${pkgname}-napi::git+https://github.com/wasmerio/napi"
        "${pkgname}-testsuite::git+https://github.com/WebAssembly/testsuite.git")

sha512sums=('a000c4743b0bd60eb3a23f75ae7430d391ff055a138c8afd0b0572c167dd6ebca3e0d73985b07f9177cf1eed6e41a6112f6efe4ac82258273289351ff1168374'
            'SKIP'
            'SKIP')
options=('staticlibs' '!lto')

prepare() {
  cd "$pkgname"
  git submodule init

  git config submodule."lib/napi".url "${srcdir}/${pkgname}"-napi
  git config submodule."tests/wast/spec".url "${srcdir}/${pkgname}"-testsuite

  git -c protocol.file.allow=always submodule update
}

build() {
  cd "$pkgname"
  make ENABLE_CRANELIFT=1 ENABLE_LLVM=1 WASMER_REPRODUCIBLE_BUILD=1 WASMER_INSTALL_PREFIX=/usr
}

check() {
  cd "$pkgname"
  make test-examples
}

package() {
  cd "$pkgname"
  make DESTDIR="$pkgdir"/usr install
}

