# Maintainer: Giovanni Harting <anonfunc@archlinux.org>

pkgname=python-rich-click
_name=${pkgname#python-}
pkgver=1.9.9
pkgrel=1
pkgdesc='Format click help output nicely with rich.'
arch=(any)
url='https://github.com/ewels/rich-click'
depends=(python python-click python-rich)
makedepends=(python-build python-installer python-wheel python-setuptools git)
# python-inline-snapshot 0.36.0 imports typing_extensions but doesn't depend on it
checkdepends=(python-pytest python-typing_extensions python-typer python-inline-snapshot ruff)
license=(MIT)
source=(git+$url.git#tag=v$pkgver)
b2sums=('8ddb6506286b8f3ceecda72450fe307b181c94526aa5eab8cd359a68c4b8bc6470c7a4de647588a045e1a5296e9591539585f0fde67aac9a60f0948481287d02')

build() {
  cd $_name
  python -m build --wheel --no-isolation
}

check() {
  cd $_name
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  # upstream addopts enable pytest-cov; rich ignores the configured width when TERM=dumb
  # typer_help: patching typer>=0.26 fails upstream, https://github.com/ewels/rich-click/issues/330
  TERM=xterm-256color test-env/bin/python -P -m pytest -o addopts="-s -rP -v --showlocals" \
    --ignore=tests/typer_help \
    -k "not test_markdown_help_rich_12 and not test_markdown_help_text_markup_field_rich_12"
}

package() {
  cd $_name
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

