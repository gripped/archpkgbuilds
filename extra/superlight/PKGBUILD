# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=superlight
pkgver=1.0.4
pkgrel=1
pkgdesc='System monitor for Linux desktops'
arch=(any)
url='https://github.com/xapp-project/superlight'
license=(GPL-3.0-or-later)
groups=(x-apps)
depends=(
  dconf
  glib2
  gtk3
  hicolor-icon-theme
  pango
  python
  python-cairo
  python-gobject
  python-setproctitle
  python-xapp
  upower
  xapp
)
makedepends=(
  git
  meson
)
optdepends=('flatpak: List installed Flatpaks')
source=("git+https://github.com/xapp-project/superlight.git#tag=$pkgver")
b2sums=(b1c7ff9117b2d81cb752c60eaf136c2c695a0f79354a5b6f1dd1dcd06bf4b69b793cc3f9a5efa01110ae3d6ab6a66ed70dabf25218186a2b13cb0e658a4f1072)

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
