# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=polyphone
pkgver=2.6.0
pkgrel=2
pkgdesc="A soundfont editor for quickly designing musical instruments"
arch=(x86_64)
url="https://polyphone-soundfonts.com/en/"
_url=https://github.com/davy7125/polyphone
license=(GPL-3.0-or-later)
groups=(pro-audio)
depends=(
  alsa-lib
  glibc
  hicolor-icon-theme
  libgcc
  libstdc++
  openssl
  qt6-base
  qt6-svg
  zlib
)
makedepends=(
  jack
  libogg
  libvorbis
  libsndfile
  rtaudio
  rtmidi
  qt6-tools
  stk
)
source=(
  $pkgname-$pkgver.tar.gz::https://github.com/davy7125/$pkgname/archive/$pkgver.tar.gz
)
sha512sums=('71d640f65d23f3c6fb91bffa59c123705318637cd65fb58e143e3996491c278c528bcd2ca6cb4b80c9ebfeac2e0e6dc529d0bb2aa053602219f130ee8077e793')
b2sums=('b84d409da49382639e07243cbc196081f08d3690c5dc0a0464d093fdfa771cdc13baf78412ce015fe1eb6af98bf6ecc8783829bc8dd9ca4df9c5f9f64a3428e4')

build() {
  cd $pkgname-$pkgver/sources
  qmake6 $pkgname.pro PREFIX=/usr
  make
}

package() {
  depends+=(
    jack libjack.so
    libogg libogg.so
    libsndfile libsndfile.so
    libvorbis libvorbis.so libvorbisenc.so libvorbisfile.so
    stk libstk-5.0.0.so
  )

  cd $pkgname-$pkgver
  # doesn't have an install target: https://github.com/davy7125/polyphone/issues/62
  install -vDm 755 sources/bin/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 packaging/$pkgname.png -t "$pkgdir/usr/share/icons/hicolor/512x512/apps"
  install -vDm 644 packaging/man/fr/man1/$pkgname.*1 -t "$pkgdir/usr/share/man/fr/man1/"
  install -vDm 644 packaging/man/man1/$pkgname.*1 -t "$pkgdir/usr/share/man/man1/"
  install -vDm 644 packaging/*.desktop -t "$pkgdir/usr/share/applications/"
  install -vDm 644 packaging/*.xml -t "$pkgdir/usr/share/metainfo/"
  install -vDm 644 packaging/$pkgname.xml -t "$pkgdir/usr/share/mime/packages/"
  install -vDm 644 README.md sources/changelog -t "$pkgdir/usr/share/doc/$pkgname/"
}
