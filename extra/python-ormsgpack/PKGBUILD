# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-ormsgpack
pkgver=1.12.2
pkgrel=1
pkgdesc="Fast, correct Python msgpack library supporting dataclasses, datetimes, and numpy"
arch=('x86_64')
url="https://github.com/ormsgpack/ormsgpack"
license=('Apache-2.0 OR MIT')
depends=(
  'glibc'
  'libgcc'
  'python'
)
makedepends=(
  'cargo'
  'git'
  'python-build'
  'python-installer'
  'python-maturin'
  'python-wheel'
)
checkdepends=(
  'python-dateutil'
  'python-msgpack'
  'python-numpy'
  'python-pendulum'
  'python-pydantic'
  'python-pytest'
  'python-pytz'
)
source=("git+https://github.com/ormsgpack/ormsgpack.git#tag=$pkgver")
sha512sums=('05df32c835f71c2c339d1ae079a63f3e589c1207db62e967df1055baf6cafa9e60f9289c030122bc74d4d584d066ba312def24145d1b8d303a3e6feafaf317f4')

prepare() {
  cd ormsgpack
  cargo fetch --locked
}

build() {
  cd ormsgpack
  CARGO_NET_OFFLINE=true python -m build --wheel --no-isolation
}

check() {
  cd ormsgpack
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd ormsgpack
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE-APACHE LICENSE-MIT -t "$pkgdir"/usr/share/licenses/$pkgname/
}
