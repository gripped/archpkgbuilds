# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-ormsgpack
pkgver=1.13.1
pkgrel=1
pkgdesc="Fast, correct Python msgpack library supporting dataclasses, datetimes, and numpy"
arch=('x86_64')
url="https://github.com/ormsgpack/ormsgpack"
license=('Apache-2.0' 'MIT')
depends=(
  'glibc'
  'libgcc'
  'python'
)
makedepends=(
  'cargo'
  'git'
  'python-build'
  'python-installer'
  'python-maturin'
  'python-wheel'
)
checkdepends=(
  'python-dateutil'
  'python-msgpack'
  'python-numpy'
  'python-pendulum'
  'python-pydantic'
  'python-pytest'
  'python-pytz'
)
source=("git+https://github.com/ormsgpack/ormsgpack.git#tag=$pkgver")
sha512sums=('cd7d002d60f78381000835c19974819349187d705f463a352479765c2250e97c600991ad8ebb74f3d71b06f0d7154161539b604ff3fd9f8f30e7436a5d9cd220')

prepare() {
  cd ormsgpack
  cargo fetch --locked
}

build() {
  cd ormsgpack
  CARGO_NET_OFFLINE=true python -m build --wheel --no-isolation
}

check() {
  cd ormsgpack
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd ormsgpack
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE-APACHE LICENSE-MIT -t "$pkgdir"/usr/share/licenses/$pkgname/
}
