pkgname=deepin-shell
pkgver=6.2.1
pkgrel=2
pkgdesc='New DDE shell'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-shell"
license=('CC-BY-4.0' 'CC0-1.0' 'GPL-3.0-or-later' 'LGPL-2.0-or-later' 'LGPL-3.0-or-later' 'MIT')
depends=('deepin-application-manager' 'deepin-tray-loader' 'dtk6core' 'dtk6gui' 'dtk6widget'
         'dtk6declarative' 'glibc' 'icu' 'libgcc' 'libstdc++' 'libx11' 'libxcb' 'libxtst' 'qt6-5compat'
         'qt6-base' 'qt6-declarative' 'qt6-wayland' 'xcb-util-wm' 'wayland' 'yaml-cpp')
makedepends=('git' 'extra-cmake-modules' 'cmake' 'ninja' 'qt6-tools' 'wayland-protocols'
             'treeland-protocols' 'gtest')
groups=('deepin')
replaces=('deepin-dock')
conflicts=('deepin-dock')
source=("git+https://github.com/linuxdeepin/dde-shell.git#tag=$pkgver")
sha512sums=('cade0aa47d5cc96ab3e07f6d8883a1379ca69d98ead587e4edd90bb1f88263a60b760a51442c2e5a9b9b39c8a8959e6e064a8dbb6086570a83e6505bed73544a')

prepare() {
  cd dde-shell
  # The dock consumes the frame library and must not define its export macro.
  sed -i '/^[[:space:]]*DS_LIB$/d' panels/dock/frame/CMakeLists.txt
}

build() {
  cd dde-shell
  # Coverage defaults to -O0, which conflicts with Arch's _FORTIFY_SOURCE under upstream -Werror.
  # https://github.com/linuxdeepin/dde-shell/pull/1730
  cmake . -GNinja \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DFRAME_BUILD_COVERAGE=OFF \
    -DAPPLETS_BUILD_COVERAGE=OFF \
    -DDOCK_BUILD_COVERAGE=OFF
  cmake --build .
}

check() {
  ctest --test-dir dde-shell --output-on-failure
}

package() {
  cd dde-shell
  DESTDIR="$pkgdir" ninja install
}
