pkgname='radcli'
pkgver=1.5.3
pkgrel=1
pkgdesc='Client library for writing Radius clients in C or C++'
arch=('x86_64')
url='https://radcli.github.io/radcli/'
license=('BSD')
depends=('nettle' 'gnutls')
makedepends=('meson')
source=("https://github.com/${pkgname}/${pkgname}/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.xz"{,.sig}
         nettle-4.patch)
sha512sums=('12f44dacf81d8d6f28fbbb93f7d6bc67ed36f63bbce293800c82bc3dc556336ebd3b4e18d8e37687ca128b0c806d5cb1bef647b06453a750f9290f24f14838d5'
            'SKIP'
            '1d963ea7a96754f06a8998ce96206e9a6e16915142b18ac883b646e8573be46fb63901a22f698de00c062cf5049ea8f9e8741e78a5d1007e32d507069ee918b0')
validpgpkeys=('1F42418905D8206AA754CCDC29EE58B996865171'  # Nikos Mavrogiannopoulos <nmav@gnutls.org>
              '59FBB55CA7F3A8AB0C503773D81C4887F1679A65'  # Nikos Mavrogiannopoulos <n.mavrogiannopoulos@gmail.com>
              '56EE7FA9E8173B19FE86268D763712747F343FA7') # Nikos Mavrogiannopoulos <nmav@redhat.com>

prepare() {
  cd $pkgname-$pkgver
#  patch -p1 -i ../nettle-4.patch
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  arch-meson build . -Ddocs=disabled
  meson compile -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  meson install -C build --destdir "$pkgdir"
  install -Dm644 COPYRIGHT "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
