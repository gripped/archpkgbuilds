pkgbase = copyparty
	pkgdesc = File server with accelerated resumable uploads, dedup, WebDAV, SFTP, FTP, FTPS, zeroconf, media indexer, thumbnails++
	pkgver = 1.20.24
	pkgrel = 1
	url = https://github.com/9001/copyparty
	install = copyparty.install
	arch = any
	license = MIT
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-setuptools
	makedepends = python-wheel
	makedepends = pigz
	depends = bash
	depends = python
	depends = lsof
	depends = python-jinja
	optdepends = ffmpeg: thumbnails for videos, images (slower) and audio, music tags
	optdepends = cfssl: generate TLS certificates on startup
	optdepends = python-mutagen: music tags (fast/inaccurate)
	optdepends = python-pillow: thumbnails for images
	optdepends = python-pyvips: thumbnails for images (very RAM-expensive)
	optdepends = python-paramiko: sftp server
	optdepends = python-pyftpdlib: ftp server
	optdepends = python-pyopenssl: ftps server (needs pyftpdlib too)
	optdepends = libkeyfinder: detection of musical keys
	optdepends = python-pyzmq: send zeromq messages from event-hooks
	optdepends = python-argon2-cffi: hashed passwords in config
