# Maintainer: Filipe Laíns (FFY00) <lains@archlinux.org>

pkgname=soapyaudio
pkgver=0.2.0
_pkgname=SoapyAudio
_gitver=soapy-audio-$pkgver
pkgrel=1
pkgdesc='Soapy SDR plugin for Audio devices'
arch=('x86_64')
url='https://github.com/pothosware/SoapyAudio'
license=('MIT')
depends=('libstdc++' 'glibc' 'hamlib' 'libgcc' 'rtaudio' 'soapysdr')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_gitver.tar.gz")
sha512sums=('f09da3c68dd87c1630e54519f2ab2871f013cad7e336620e0066be52d948849d446b2522f071033c195364e51b3f997c09b2774486fbd542d01bf0fc8e60c0c4')

build() {
  local cmake_options=(
    -B build
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_BUILD_TYPE=None
    -S $_pkgname-$_gitver
    -W no-dev
  )

  cmake "${cmake_options[@]}"
  cmake --build build --verbose
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -vDm 644 $_pkgname-$_gitver/LICENSE.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}

