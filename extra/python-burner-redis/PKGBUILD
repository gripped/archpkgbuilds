# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-burner-redis
pkgver=0.1.7
pkgrel=2
pkgdesc='Embedded, in-process Redis-compatible database'
arch=('x86_64')
url='https://github.com/prefectlabs/burner-redis'
license=('MIT')
depends=('glibc' 'libgcc' 'lua54' 'python')
makedepends=('cargo' 'git' 'pkgconf' 'python-build' 'python-installer' 'python-maturin')
checkdepends=('python-pydocket' 'python-pytest' 'python-pytest-asyncio' 'python-redis')
optdepends=('python-redis: redis-py compatible exceptions')
source=("git+https://github.com/prefectlabs/burner-redis.git#tag=v$pkgver")
sha512sums=('894efed326c26c83d8c6db2e0c782cda395b15fb727e4638cf067381dc9512430410f3d8ad01685fdd61108ad51171d1f45fdc408cb1102a09767660b8af1cfe')

prepare() {
  cd burner-redis
  cargo fetch --locked
}

build() {
  cd burner-redis
  python -m build --wheel --no-isolation \
    -C build-args="--frozen --no-default-features --compatibility linux"
}

check() {
  cd burner-redis
  cargo test --release --frozen --no-default-features
  python -m venv --system-site-packages --without-pip "$srcdir/test-env"
  "$srcdir/test-env/bin/python" -m installer dist/*.whl
  "$srcdir/test-env/bin/python" -m pytest -o addopts=
}

package() {
  cd burner-redis
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE THIRDPARTY.yml -t "$pkgdir/usr/share/licenses/$pkgname/"
}
