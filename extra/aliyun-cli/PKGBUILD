# Maintainer: Orhun Parmaksız <orhun@archlinux.org>
# Contributor: Andreas 'Segaja' Schleifer <archlinux at segaja dot de>

pkgname=aliyun-cli
pkgver=3.3.23
pkgrel=1
pkgdesc='Alibaba Cloud CLI'
url='https://github.com/aliyun/aliyun-cli'
arch=(x86_64)
license=(
  Apache-2.0
)
depends=(
  glibc
)
makedepends=(
  git
  go
)
source=(
  "git+${url}#tag=v${pkgver}"
  git+https://github.com/aliyun/aliyun-openapi-meta
)
sha512sums=('ec52fb41cf39253d6735ed8328643faea975efbbd6150cd00388fae43dd372646fc181985c1923787eb5d78d62bd6edccc28b1436bf60a9307504e1403bc0f81'
            'SKIP')
b2sums=('4f5da62767f2d95a86201ebb0d676642d701278993c53414598ab78445096e1f5e2b2cb74ab56862a0d2869aaa2bfa58f8ea4baa2b97715cd8b6eeee9c18c746'
        'SKIP')

prepare() {
  cd ${pkgname}
  git submodule init
  git config submodule."aliyun-openapi-meta".url "${srcdir}/aliyun-openapi-meta"
  git -c protocol.file.allow=always submodule update --init --recursive
}

build() {
  cd ${pkgname}
  export CGO_LDFLAGS="${LDFLAGS}"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw -ldflags=-linkmode=external"

  go build \
    -ldflags "-linkmode=external -extldflags '${LDFLAGS}' -X 'github.com/aliyun/aliyun-cli/cli.Version=${pkgver}'" \
    -o ./out/aliyun ./main/main.go
}

check() {
  cd ${pkgname}

  # Horrible but needed for the ./cli/ tests
  touch "${HOME}/.bashrc"

  # for now can't test the `./oss/...` folder, because it needs an env file that is not so easy to have in dev
  go test \
    ./cli/... ./config/... ./i18n/... ./main/... ./openapi/...
}

package() {
  cd ${pkgname}
  install -Dm 755 out/aliyun "${pkgdir}/usr/bin/aliyun"
  install -Dm 644 README*.md CHANGELOG.md -t "${pkgdir}/usr/share/doc/${pkgname}"
  install -Dm 644 bin/README.md -t "${pkgdir}/usr/share/doc/${pkgname}/bin"
}

