# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-sse-starlette
pkgver=3.5.1
pkgrel=1
pkgdesc="SSE plugin for Starlette"
arch=(any)
url="https://github.com/sysid/sse-starlette"
license=(BSD-3-Clause)
depends=(
  python
  python-anyio
  python-starlette
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-asgi-lifespan
  python-httpx
  python-httpx2
  python-portend
  python-psutil
  python-pytest
  python-pytest-asyncio
  python-tenacity
  uvicorn
)
source=("git+https://github.com/sysid/sse-starlette.git#tag=v$pkgver")
b2sums=('6632d7c53f1b85bb74fc6c14bccaec7c8b1c8edd717ba1df617b5d4e77fa1d11a8f1f192ca4a9fee58ff06f44351f0e4bdf53fcc303939373da0c8f0eea59af2')

build() {
  cd sse-starlette
  python -m build --wheel --no-isolation
}

check() {
  cd sse-starlette
  # Integration tests need Docker/testcontainers.
  python -m pytest \
    --ignore tests/integration
}

package() {
  cd sse-starlette
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
