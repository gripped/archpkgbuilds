# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-sse-starlette
pkgver=3.7.1
pkgrel=1
pkgdesc="SSE plugin for Starlette"
arch=(any)
url="https://github.com/sysid/sse-starlette"
license=(BSD-3-Clause)
depends=(
  python
  python-anyio
  python-starlette
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-asgi-lifespan
  python-httpx
  python-httpx2
  python-portend
  python-psutil
  python-pytest
  python-pytest-asyncio
  python-tenacity
  uvicorn
)
source=("git+https://github.com/sysid/sse-starlette.git#tag=v$pkgver")
b2sums=('74c7321fd3e193c276100fea3d8c1e49ad69f5819f2e00bbb31f0d46081ae6fc68350b373278ae205d2694013ef2cf2192e1642f33d5655f254b7938470b6d71')

build() {
  cd sse-starlette
  python -m build --wheel --no-isolation
}

check() {
  cd sse-starlette
  # Integration tests need Docker/testcontainers.
  python -m pytest \
    --ignore tests/integration
}

package() {
  cd sse-starlette
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
