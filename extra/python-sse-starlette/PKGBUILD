# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-sse-starlette
pkgver=3.4.8
pkgrel=1
pkgdesc="SSE plugin for Starlette"
arch=(any)
url="https://github.com/sysid/sse-starlette"
license=(BSD-3-Clause)
depends=(
  python
  python-anyio
  python-starlette
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-asgi-lifespan
  python-httpx
  python-portend
  python-psutil
  python-pytest
  python-pytest-asyncio
  python-tenacity
  uvicorn
)
source=("git+https://github.com/sysid/sse-starlette.git#tag=v$pkgver")
b2sums=('4dff2b7dca0db4bdc89a449770fe88eb2f9ed7502be3774e8f1159c15988f943f384f09a52fc963762be51604b66b724b5d63b650a8887ed1c5957618387936d')

build() {
  cd sse-starlette
  python -m build --wheel --no-isolation
}

check() {
  cd sse-starlette
  # Integration tests need Docker/testcontainers.
  python -m pytest \
    --ignore tests/integration
}

package() {
  cd sse-starlette
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
