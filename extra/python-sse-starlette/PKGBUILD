# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-sse-starlette
pkgver=3.4.7
pkgrel=1
pkgdesc="SSE plugin for Starlette"
arch=(any)
url="https://github.com/sysid/sse-starlette"
license=(BSD-3-Clause)
depends=(
  python
  python-anyio
  python-starlette
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-asgi-lifespan
  python-httpx
  python-portend
  python-psutil
  python-pytest
  python-pytest-asyncio
  python-tenacity
  uvicorn
)
source=("git+https://github.com/sysid/sse-starlette.git#tag=v$pkgver")
b2sums=('7eb4d7df44b80c17f4c2d33ee21a0e562d4b09e93b71697aa2c255b02f809e9339d9337e110c6eb188b202c1250707da12a311afc202cb8cc58e41618a143a04')

build() {
  cd sse-starlette
  python -m build --wheel --no-isolation
}

check() {
  cd sse-starlette
  # Integration tests need Docker/testcontainers.
  python -m pytest \
    --ignore tests/integration
}

package() {
  cd sse-starlette
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
