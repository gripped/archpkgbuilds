# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>
# Contributor: razvandimescu <razvan@dimescu.com>

pkgname=numa
pkgver=0.21.0
pkgrel=1
pkgdesc="Portable DNS resolver with ODoH support"
url='https://github.com/razvandimescu/numa'
arch=('x86_64')
license=('MIT')
depends=(
  'glibc'
  'libgcc'
)
makedepends=(
  'cargo'
)
backup=('etc/numa.toml')
source=(https://github.com/razvandimescu/${pkgname}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz)
sha256sums=('3eedd3cc3fa8642d636ecc3c0faeca9686d87392c20984b71e8b7c7e7ef23a6b')
b2sums=('7b6b378a38e147af9bcb6a14b26169e41b21837a13730768b518a906af5fe73ab87c0e2900c9a03569957eb6562270a5f627c4cf5bafc85018d593cc99c22fde')

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target host-tuple
}

build() {
  cd "${pkgname}-${pkgver}"
  CFLAGS+=' -ffat-lto-objects'
  cargo build --frozen --release
}

check() {
  cd "${pkgname}-${pkgver}"
  cargo test --frozen -- \
    --skip failover_skips_bad_srtt_primary_when_fallback_exists
  target/release/numa --help
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm 755 -t "${pkgdir}/usr/bin" \
    target/release/numa

  sed 's|{{exe_path}}|/usr/bin/numa /etc/numa.toml|g' numa.service > numa.service.patched
  install -Dm 644 numa.service.patched "${pkgdir}/usr/lib/systemd/system/numa.service"

  install -Dm 644 numa.toml -t "${pkgdir}/etc"
  install -Dm 644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

# vim: ts=2 sw=2 et:
