pkgname=navidrome
pkgver=0.61.2
pkgrel=1
pkgdesc='A web-based music collection server and streamer'
arch=(x86_64)
url='https://www.navidrome.org'
license=(GPL-3.0-only)
depends=(
  glibc
  libgcc
  libstdc++
  zlib
  ffmpeg
  taglib
)
makedepends=(
  git
  go
  npm
  nodejs
)
backup=(etc/navidrome/navidrome.toml)
options=(!lto)
source=(
  "$pkgname::git+https://github.com/navidrome/navidrome#tag=v$pkgver"
  systemd.service
  sysusers.conf
  tmpfiles.conf
  config.toml
)
