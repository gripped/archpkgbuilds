# Maintainer: Carl Smedstad <carsme@archlinux.org>
# Contributor: Alexander Rødseth <rodseth@gmail.com>

pkgname=nzbget
pkgver=26.2
pkgrel=1
pkgdesc="Efficient usenet downloader"
arch=('x86_64')
url="https://nzbget.com"
license=('GPL-2.0-or-later')
depends=(
  'boost-libs'
  'glibc'
  'libgcc'
  'libstdc++'
  'libxml2'
  'ncurses'
  'openssl'
  'zlib'
)
makedepends=(
  'boost'
  'cmake'
  'git'
)
optdepends=(
  'python: to run included scripts'
  'unrar: unpacking archives'
  '7zip: unpacking archives'
)
source=(
  "https://github.com/nzbgetcom/nzbget/archive/v$pkgver/$pkgname-$pkgver.tar.gz"
  "git+https://github.com/nzbgetcom/par2cmdline-turbo.git"
  "$pkgname-use-par2cmdline-turbo-from-sources.patch"
)
b2sums=('1ba26e8af1eb3cc57a895f49603bd11ad0376e340af3a45222296650c6bc541907f4ca0174aceb8abfa63e8501d26d078adb3f25c7093a7595a4e5b624ce5afc'
        'SKIP'
        'c437ab1db60bd1080316566bed2dd15a2034493624a6f3d357c7286bca87b6088dc59f3f1bf2a06026205b9c6fe969d539b32bdb1fa328be009119110f3c4955')

prepare() {
  cd $pkgname-$pkgver
  patch -Np1 < ../$pkgname-use-par2cmdline-turbo-from-sources.patch
}

build() {
  cmake -S $pkgname-$pkgver -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev \
    -DENABLE_TESTS=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  cd $pkgname-$pkgver
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" ./*.md
  install -vDm644 -t "$pkgdir/usr/lib/systemd/system" linux/pkg/$pkgname.service
}
