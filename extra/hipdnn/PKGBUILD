# Maintainer: Torsten Keßler <tpkessler at archlinux dot org>

pkgname=hipdnn
pkgver=10.1
pkgrel=1
pkgdesc='Graph-based deep learning library for AMD GPUs'
arch=('x86_64')
url='https://github.com/ROCm/rocm-libraries/tree/develop/projects/hipdnn'
license=('MIT')
depends=(
  'rocm-core'
  'hip-runtime-amd'
  'glibc'
  'libgcc'
  'libstdc++'
  'flatbuffers'
  'nlohmann-json'
)
makedepends=(
  'cmake'
  'ninja'
  'rocm-cmake'
  'rocm-llvm'
  'rocm-toolchain'
  'spdlog'
)
_git='https://github.com/ROCm/rocm-libraries'
source=("$pkgname-$pkgver.tar.gz::$_git/releases/download/therock-$pkgver/$pkgname.tar.gz")
sha256sums=('345d893e12da5535bdb5bfe326119b118d34dda533e70f35bc4fa02f65443c26')

prepare() {
  cd "$pkgname"
  sed -i '/-Werror # Treat all warnings as errors/d' CMakeLists.txt

  # The flatbuffers package provides the shared library target only
  sed -i 's/flatbuffers::flatbuffers\b/flatbuffers::flatbuffers_shared/g' \
    flatbuffers_sdk/CMakeLists.txt \
    flatbuffers_sdk/cmake/hipdnn_flatbuffers_sdkConfig.cmake.in

  # hipDNN requires the exact flatbuffers version, in cmake and in the
  # scripts that run flatc. Pin the version of the flatbuffers package.
  pacman -Q flatbuffers | cut -d' ' -f2 | cut -d- -f1 > cmake/default_flatc_version.txt
}

build() {
  local cmake_args=(
    -Wno-dev
    -S "$pkgname"
    -G Ninja
    -B build
    -D CMAKE_BUILD_TYPE=None
    # The toolchain file uses the compilers in $ROCM_PATH/lib/llvm/bin
    -D ROCM_PATH=/opt/rocm
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    # Fail instead of downloading a dependency that is not found
    -D FETCHCONTENT_FULLY_DISCONNECTED=ON
    -D HIPDNN_SKIP_TESTS=ON
    -D ENABLE_CLANG_TIDY=OFF
    -D ENABLE_CLANG_FORMAT=OFF
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$pkgname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
