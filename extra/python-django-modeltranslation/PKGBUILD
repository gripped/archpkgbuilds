# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=python-django-modeltranslation
pkgver=0.20.3
pkgrel=1
pkgdesc='Translates Django models using a registration approach'
arch=(any)
url=https://github.com/deschler/django-modeltranslation
license=(BSD-3-Clause)
depends=(python-django python-typing_extensions)
makedepends=(
  git
  python-build
  python-hatchling
  python-hatch-vcs
  python-installer
  python-wheel
)
source=(
  ${pkgname#python-}::git+https://github.com/deschler/django-modeltranslation.git#tag=v${pkgver}
)
b2sums=('3f989e9a6fc9f976d1a28d18fdf751e9d9e9dc95807ecfecb6f0ec81f75dd0decf95a3c108dbf7d6bdb2a14e3077bd8c690d4650cd3569b3a1b4a20cf86bff77')

build() {
  cd django-modeltranslation
  python -m build --wheel --no-isolation
}

package() {
  python -m installer --destdir="${pkgdir}" django-modeltranslation/dist/*.whl
  install -Dm 644 django-modeltranslation/LICENSE.txt -t "${pkgdir}"/usr/share/licenses/python-django-modeltranslation/
}

