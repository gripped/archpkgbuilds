pkgname=(bcachefs-tools bcachefs-dkms)
epoch=3
pkgver=1.39.4
pkgrel=3
pkgdesc='BCacheFS filesystem utilities'
arch=('x86_64')
url='https://bcachefs.org/'
license=('GPL-2.0-only')
_tools_depends=(
    fuse3
    glibc
    keyutils libkeyutils.so
    libaio libaio.so
    libgcc
    libsodium libsodium.so
    libunwind libunwind.so
    liburcu
    lz4
    systemd-libs libudev.so
    udev
    util-linux-libs libblkid.so libuuid.so
    zlib libz.so
    zstd libzstd.so
)
makedepends=(
  ${_tools_depends[@]}
  rust
  rust-bindgen
  rust-src
  clang
  git
  jq
  llvm
  pkgconf
  valgrind
)
options=(!lto)
source=(
