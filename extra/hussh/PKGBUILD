# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=hussh
pkgver=0.2.1
pkgrel=1
pkgdesc='Memory-safe SSH daemon for restricted TCP forwarding'
url='https://github.com/kpcyrd/hussh'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=(
  'glibc'
  'libgcc' 'libgcc_s.so'
)
makedepends=(
  'cargo'
  'scdoc'
)
backup=('etc/hussh.conf')
source=(https://github.com/kpcyrd/${pkgname}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz)
sha256sums=('a521b1030de94fc8848e7f0c72946807f192bd06b344246273a8d4ed48fd6a93')
b2sums=('15b48cccb253adc7f915f322ae69c6887013a44bf29672dea74c32877499a2c2cb4d242df63d1cf474f3dfb438eb809709a78cfcf89631acdb709871224a7c26')

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target host-tuple
}

build() {
  cd "${pkgname}-${pkgver}"
  CFLAGS+=' -ffat-lto-objects'
  cargo build --frozen --release
  make docs
}

check() {
  cd "${pkgname}-${pkgver}"
  cargo test --frozen
}

package() {
  cd "${pkgname}-${pkgver}"
  install -vDm 755 -t "${pkgdir}/usr/bin" \
    target/release/hussh

  # install configs
  install -vDm 644 contrib/hussh.conf -t "${pkgdir}/etc"

  # install systemd configs
  install -vDm 644 -t "${pkgdir}/usr/lib/systemd/system" \
    contrib/hussh.service

  # install docs
  install -vDm 644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
  install -vDm 644 -t "${pkgdir}/usr/share/man/man1" \
    contrib/hussh.1
}

# vim: ts=2 sw=2 et:
