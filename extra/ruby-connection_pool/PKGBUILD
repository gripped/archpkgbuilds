# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=ruby-connection_pool
pkgver=2.5.1
pkgrel=1
pkgdesc='Generic connection pool for Ruby'
arch=(any)
url='https://github.com/mperham/connection_pool'
license=(MIT)
depends=(
  ruby
)
makedepends=(
  git
  ruby-minitest
  ruby-rake
)
checkdepends=(
  ruby-bundler
)
options=(!emptydirs)
source=("git+https://github.com/mperham/connection_pool.git#tag=v$pkgver")
sha256sums=('aa2f70f366a9e143bac432d7d046d831dc34c4c02caceac1a05659e2057f985a')

prepare() {
  cd connection_pool
  # Avoid loading the upstream formatter when running the test suite.
  sed '/standard/d' -i Rakefile
}

build() {
  local _gemdir="$(gem env gemdir)"
  cd connection_pool
  gem build connection_pool.gemspec
  gem install \
    --local \
    --verbose \
    --ignore-dependencies \
    --no-user-install \
    --install-dir "tmp_install/$_gemdir" \
    --bindir "tmp_install/usr/bin" \
    connection_pool-$pkgver.gem
  find "tmp_install/$_gemdir/gems/" \
    -type f \
    \( \
        -iname "*.o" -o \
        -iname "*.c" -o \
        -iname "*.so" -o \
        -iname "*.time" -o \
        -iname "gem.build_complete" -o \
        -iname "Makefile" \
    \) \
    -delete
  rm -r tmp_install/$_gemdir/cache
}

check() {
  local _gemdir="$(gem env gemdir)"
  cd connection_pool
  GEM_HOME="tmp_install/$_gemdir" rake test
}

package() {
  cd connection_pool
  cp -a tmp_install/* "$pkgdir"/
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
