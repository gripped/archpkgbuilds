# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=btfs
pkgver=3.2
pkgrel=1
pkgdesc="A bittorrent filesystem based on FUSE"
arch=('x86_64')
url="https://github.com/johang/btfs"
license=('GPL-3.0-or-later')
depends=('fuse3' 'libtorrent-rasterbar' 'curl')
makedepends=('boost' 'git')
optdepends=('python: for btplay')
source=("git+https://github.com/johang/btfs.git#tag=v$pkgver")
sha512sums=('a523eed339b06b51c660bc18d501649fc95fbb72ecb87325445af8782d99b65597c807cbe839feaeab0e8ece2e57481909ac944745f7a5727f73152ce56cbbf3')

prepare() {
  cd $pkgname
  autoreconf -i
}

build() {
  cd $pkgname
  ./configure --prefix=/usr
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
