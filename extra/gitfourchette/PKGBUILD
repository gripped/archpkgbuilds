# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=gitfourchette
pkgver=1.9.1
pkgrel=1
pkgdesc='The comfortable Git UI'
arch=(any)
url='https://gitfourchette.org'
license=(GPL-3.0-only)
depends=(
  python
  python-pygit2
  python-pyqt6
  python-pygments
  hicolor-icon-theme
)
makedepends=(
  git
  libicns
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
	python-pytest
	python-pytest-qt
	python-pytest-cov
	python-pytest-xdist
	python-ruff
)
optdepends=(
  'python-psutil: memory indicator'
  'python-mfusepy: mount git tree as fuse filesystem'
)
source=(
  "$pkgname::git+https://github.com/jorio/gitfourchette#tag=v$pkgver"
  reproducible-metadata.patch
)
sha512sums=('abfba3d2129662893c1ce9ed24a0a92caac53baed3da9071967280595dee91987f91a52be2d9e10a44b3a81d07de8154225ba7cb88624bf3e5b245c170bb3d24'
            'aea53889ebae7c9c94ded86667c3ef805c3208f1165d2de49e24addd8364f894b46d0ae0759ab3b01b159eaa15ac2a69a7ef52435074236a6463866740fd6d77')
b2sums=('d8844a1f57a96f4c67aa39f02cbfff6fa878dfb04021bc16a3610db30d4460d6345662639b2c9d87e763f923cc4f694a8a65bb616f836faa9441b51ca19b3692'
        'c7ac9219921120a876029fd77024f6e3d9d2b83ad6ab6e3c4837dabcca2850f4f9016d755fdea3cae0a94a4b89604eab951aa48477abe2994807ab75949c1451')

prepare() {
  cd "$pkgname"

  # prefer reproducible metadata
  patch -p1 -i "$srcdir/reproducible-metadata.patch"

  # update metadata
  python update_resources.py --freeze pyqt6

  # extract hires icon (gitfourchette_512x512x32.png)
  icns2png -x pkg/pyinstaller/gitfourchette.icns
  mv gitfourchette_512x512x32.png org.gitfourchette.gitfourchette.png
}

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # appdata
  install -vDm644 -t "$pkgdir/usr/share/applications" pkg/flatpak/*.desktop
  install -vDm644 -t "$pkgdir/usr/share/icons/hicolor/256x256/apps" pkg/flatpak/*.png
  install -vDm644 -t "$pkgdir/usr/share/icons/hicolor/512x512/apps" org.gitfourchette.gitfourchette.png
  install -vDm644 -t "$pkgdir/usr/share/metainfo" pkg/flatpak/*.metainfo.xml
}
