# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=treesheets
pkgver=2.3.6
pkgrel=1
pkgdesc='A free-form hierarchical data organizer'
arch=(x86_64 aarch64)
url='https://strlen.com/treesheets/'
license=(Zlib)
depends=(
  glibc
  libstdc++
  libgcc
  hicolor-icon-theme
  libx11
  libxkbcommon
  libjpeg-turbo
  libtiff
  libpng
  gspell
  fontconfig
  cairo
  pango
  wayland
  libwebp
  pcre2
  glib2
  expat
  gtk3
  zlib
  gdk-pixbuf2
)
makedepends=(
  git
  cmake
  ninja
  libnotify
  sdl2-compat
)
_wxwidgets_version=3.3.2 # CMakeLists.txt
