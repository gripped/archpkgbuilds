pkgname=rdkit
pkgver=2026.03.5
pkgrel=2
pkgdesc="Open-source toolkit for cheminformatics"
arch=(x86_64)
url="https://github.com/rdkit/rdkit"
license=(BSD-3-Clause)
depends=(
  boost-libs
  cairo
  coordgen
  freetype2
  glibc
  inchi
  libgcc
  libstdc++
  maeparser
  python
  python-numpy
  python-pillow
)
makedepends=(
  boost
  catch2
  cmake
  eigen
  git
  ninja
)
source=(
  $pkgname-$pkgver.tar.gz::$url/archive/refs/tags/Release_${pkgver//./_}.tar.gz
  rdkit-boost-1.92.0-build-failure.patch
)
b2sums=('2936ff1430ee9ff9a77d48a6dc45737c9f4d2c43abba4275b44097b8942e7e18366dd9306839c3196d84278f58d21a88f901ce0558fd04d8ab49f5252fa9e6b5'
        '44e5812d015fba064588ca19f27eb0e1ced6a344353ea6331d25fd4179e5dbadf8b5e39eb7c3a5f1be753ab00867296a20804ca56a852fd8c1d37ff42f949806')

prepare() {
  # Fix finding Eigen3 https://github.com/rdkit/rdkit/issues/8896
  rm $pkgname-Release_${pkgver//./_}/Code/cmake/Modules/FindEigen3.cmake
  sed -i 's|if(NOT EIGEN3_FOUND)|if(NOT TARGET Eigen3::Eigen)|' $pkgname-Release_${pkgver//./_}/CMakeLists.txt

  # Fix build failure with boost 1.92
  patch -Np1 -d $pkgname-Release_${pkgver//./_} -i "$srcdir/rdkit-boost-1.92.0-build-failure.patch"
}

build() {
  local cmake_options=(
    -B build
    -S $pkgname-Release_${pkgver//./_}
    -G Ninja
    -W no-dev
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_INSTALL_PREFIX=/usr
    -DRDK_BUILD_CAIRO_SUPPORT=ON
    -DRDK_BUILD_INCHI_SUPPORT=ON
    -DRDK_INSTALL_INTREE=OFF
    -DRDK_INSTALL_STATIC_LIBS=OFF
    # TODO: the test suite has too many failures, even due to bad input files
    -DRDK_BUILD_CPP_TESTS=OFF
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

