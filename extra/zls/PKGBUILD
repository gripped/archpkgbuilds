pkgname=zls
pkgver=0.17.0
pkgrel=1
pkgdesc="A language server for Zig"
arch=('x86_64')
url="https://github.com/zigtools/zls"
license=('MIT')
depends=('zig')
_zig_deps=(
  # From build.zig.zon
  "known-folders-6da0d0c41b78b9ed2d34fa364fcb81b5ebece6c4.tar.gz::https://github.com/ziglibs/known-folders/archive/6da0d0c41b78b9ed2d34fa364fcb81b5ebece6c4.tar.gz"
  "diffz-aac8aa99c436ab8277b0711922aad062c0167b12.tar.gz::https://github.com/ziglibs/diffz/archive/aac8aa99c436ab8277b0711922aad062c0167b12.tar.gz"
  "lsp_kit-3e1058db66079911fdde82f833fdce6856e0a706.tar.gz::https://github.com/zigtools/lsp-kit/archive/3e1058db66079911fdde82f833fdce6856e0a706.tar.gz"
)
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/zigtools/zls/archive/refs/tags/${pkgver}.tar.gz"

  "${_zig_deps[@]}"
)
noextract=("${_zig_deps[@]%%::*}")
sha256sums=('f77940720768daf67c01802ea3cf3029dfd8a74afd7b68b39676c4f814dd992e'
            '194aaa7566f3d9b4e893e3e53ef46ce880d4fc3631535ccea05405f558070f39'
            '33036e596176426449617975113eeddf513c991f42e10df855ccfb0e6f103fae'
            '06dab48dad0dd5770bdcaa64fe13b386e479a67dc81899005d04f48897ec2003')

prepare() {
  local ZIG_GLOBAL_CACHE_DIR="./zig-global-cache"

  # Copy packages into global cache
  mkdir -p "$ZIG_GLOBAL_CACHE_DIR/p/"
  cp "${_zig_deps[@]%%::*}" "$ZIG_GLOBAL_CACHE_DIR/p/"
}

build() {
  cd "${pkgname}-${pkgver}"

  export ZIG_GLOBAL_CACHE_DIR=../zig-global-cache
  DESTDIR="build" zig build \
    --summary all \
    --prefix /usr \
    --release=safe \
    --build-id=sha1 \
    -Dtarget=native-linux.6.12-gnu.2.42 \
    -Dcpu=baseline \
    -Dpie=true
}

package() {
  cd "${pkgname}-${pkgver}"
  cp -a build/* "$pkgdir"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}

