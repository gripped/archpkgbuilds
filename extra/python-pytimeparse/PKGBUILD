pkgname=python-pytimeparse
_pyname=${pkgname#python-}
pkgver=1.1.9
pkgrel=1
pkgdesc='A small library to parse various kinds of time expressions'
arch=(any)
url="https://github.com/wroberts/$_pyname"
license=(MIT)
depends=(python)
makedepends=(python-{build,installer,wheel}
             python-setuptools)
_archive="$_pyname-$pkgver"
source=("https://files.pythonhosted.org/packages/source/${_pyname::1}/$_pyname/$_archive.tar.gz")
sha256sums=('1f1c0bedcfbe481b78f7cb11dba7d81039455af8ba014eafc6df060c9c0ab156')

build() {
	cd "$_archive"
	python -m build -wn
}

check() {
	cd "$_archive"
	python -m unittest discover -vs .
}

package() {
	cd "$_archive"
	python -m installer -d "$pkgdir" dist/*.whl
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE.rst
}
