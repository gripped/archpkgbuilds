pkgname=python-werkzeug
pkgver=3.1.7
pkgrel=1
pkgdesc='Swiss Army knife of Python web development'
url='https://werkzeug.palletsprojects.com/'
arch=('any')
license=('BSD-3-Clause')
depends=(
  'python'
  'python-markupsafe'
)
makedepends=(
  'git'
  'python-build'
  'python-flit-core'
  'python-installer'
)
checkdepends=(
  'python-cryptography'
  'python-ephemeral-port-reserve'
  'python-greenlet'
  'python-pytest'
  'python-pytest-timeout'
  'python-pytest-xprocess'
  'python-requests'
  'python-watchdog'
)
optdepends=('python-watchdog: faster and more advanced reloader')
source=("git+https://github.com/pallets/werkzeug.git#tag=${pkgver}")
sha512sums=('dacbad447ef035ebbe04807779ff76c26837e329f2848c0599ab668ba7fe4144972620e006d885acd6f7a17821762429fb066932871041fc55028fac9f12ec25')

build() {
  cd werkzeug
  python -m build --wheel --no-isolation
}

check() {
  cd werkzeug
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd werkzeug
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm 644 LICENSE.txt -t "$pkgdir/usr/share/licenses/$pkgname"
}

