diff --git a/tests/service-session-exit-test.cpp b/tests/service-session-exit-test.cpp
new file mode 100644
index 00000000..48b01536
--- /dev/null
+++ b/tests/service-session-exit-test.cpp
@@ -0,0 +1,76 @@
+// SPDX-FileCopyrightText: 2026 Arch Linux contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <QDBusConnection>
+#include <QDBusConnectionInterface>
+#include <QDBusReply>
+#include <QDir>
+#include <QFile>
+#include <QProcess>
+#include <QProcessEnvironment>
+#include <QTemporaryDir>
+#include <QtTest>
+
+class ServiceSessionExitTest : public QObject
+{
+    Q_OBJECT
+
+private slots:
+    void servicesExitWhenBusDisconnects()
+    {
+        QTemporaryDir state;
+        QVERIFY(state.isValid());
+        const QString runtime = state.path() + QStringLiteral("/runtime");
+        QVERIFY(QDir().mkpath(runtime));
+        QVERIFY(QFile::setPermissions(runtime, QFile::ReadOwner | QFile::WriteOwner | QFile::ExeOwner));
+
+        QProcess busDaemon;
+        busDaemon.start(QStringLiteral("dbus-daemon"),
+                        {QStringLiteral("--session"), QStringLiteral("--nofork"),
+                         QStringLiteral("--print-address=1")});
+        QVERIFY(busDaemon.waitForStarted());
+        QTRY_VERIFY_WITH_TIMEOUT(busDaemon.canReadLine(), 5000);
+        const QString address = QString::fromUtf8(busDaemon.readLine()).trimmed();
+        QVERIFY(!address.isEmpty());
+
+        QProcessEnvironment environment = QProcessEnvironment::systemEnvironment();
+        environment.insert(QStringLiteral("DBUS_SESSION_BUS_ADDRESS"), address);
+        environment.insert(QStringLiteral("HOME"), state.path());
+        environment.insert(QStringLiteral("XDG_CONFIG_HOME"), state.path() + QStringLiteral("/config"));
+        environment.insert(QStringLiteral("XDG_CACHE_HOME"), state.path() + QStringLiteral("/cache"));
+        environment.insert(QStringLiteral("XDG_DATA_HOME"), state.path() + QStringLiteral("/data"));
+        environment.insert(QStringLiteral("XDG_RUNTIME_DIR"), runtime);
+
+        const QString connectionName = QStringLiteral("service-session-exit-test");
+        const QDBusConnection bus = QDBusConnection::connectToBus(address, connectionName);
+        QVERIFY(bus.isConnected());
+
+        // Start the built services explicitly so activation cannot select installed copies.
+        QProcess dirManager;
+        dirManager.setProcessEnvironment(environment);
+        dirManager.start(QStringLiteral(DIR_MANAGER_SERVICE), QStringList());
+        QVERIFY(dirManager.waitForStarted());
+        QTRY_VERIFY_WITH_TIMEOUT(bus.interface()->isServiceRegistered(
+                                     QStringLiteral("com.ukui.search.fileindex.service")).value(), 15000);
+
+        QProcess appDb;
+        appDb.setProcessEnvironment(environment);
+        appDb.start(QStringLiteral(APP_DB_SERVICE), QStringList());
+        QVERIFY(appDb.waitForStarted());
+        QTRY_VERIFY_WITH_TIMEOUT(bus.interface()->isServiceRegistered(
+                                     QStringLiteral("com.ukui.search.appdb.service")).value(), 15000);
+
+        busDaemon.terminate();
+        QVERIFY(busDaemon.waitForFinished());
+        QTRY_COMPARE_WITH_TIMEOUT(dirManager.state(), QProcess::NotRunning, 10000);
+        QTRY_COMPARE_WITH_TIMEOUT(appDb.state(), QProcess::NotRunning, 10000);
+        QCOMPARE(dirManager.exitStatus(), QProcess::NormalExit);
+        QCOMPARE(dirManager.exitCode(), 0);
+        QCOMPARE(appDb.exitStatus(), QProcess::NormalExit);
+        QCOMPARE(appDb.exitCode(), 0);
+        QDBusConnection::disconnectFromBus(connectionName);
+    }
+};
+
+QTEST_GUILESS_MAIN(ServiceSessionExitTest)
+#include "service-session-exit-test.moc"
