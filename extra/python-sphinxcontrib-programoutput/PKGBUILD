# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=python-sphinxcontrib-programoutput
_name="${pkgname#python-}"
pkgver=0.19
pkgrel=1
pkgdesc="Sphinx extension for capturing program output"
arch=(any)
url="https://github.com/OpenNTI/sphinxcontrib-programoutput/"
license=(BSD-3-Clause)
depends=(
  python
  python-docutils  # undeclared runtime dependency: https://github.com/OpenNTI/sphinxcontrib-programoutput/issues/79
  python-sphinx
)
makedepends=(
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-pytest
  python-erbsland-sphinx-ansi
)
optdepends=(
  'python-erbsland-sphinx-ansi: for rendering ANSI output'  # undeclared optional dependency: https://github.com/OpenNTI/sphinxcontrib-programoutput/issues/78
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
sha512sums=('74d183f292f685c02b3145e2fdca9c1c2f55eb0fbea207f627e7db2b1d47f3c1612ee357d84b9802329efd1acc34f1f448405398bc0bd855616e0ffbd6e97fde')
b2sums=('b957e3104b2745c945250d7bcc6dc4b1e12b9bf3ea93cb98b0da336f3b7920142407f7690521eb75759558c8d9576537cab0b22c6608529153ab3fd4e3a3cfe8')

build() {
  cd $_name-$pkgver
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
  )

  cd $_name-$pkgver
  PYTHONPATH=src pytest "${pytest_options[@]}" src/sphinxcontrib/programoutput
}

package() {
  cd $_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 {CHANGES,README}.rst -t "$pkgdir/usr/share/doc/$pkgname/"
}
