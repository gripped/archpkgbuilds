pkgname=verilator
pkgver=5.054
pkgrel=1
pkgdesc='The fastest free Verilog HDL simulator'
url='https://www.veripool.org/verilator/'
arch=('x86_64')
license=('LGPL-3.0-only' 'Artistic-2.0')
depends=('perl' 'python' 'lz4' 'zlib')
optdepends=('systemc')
makedepends=('git' 'help2man' 'systemc')
checkdepends=('python-distro')
source=("git+https://github.com/verilator/verilator.git#tag=v$pkgver")
sha512sums=('ad2908ed329081d25e40061d8644c881cbfbe52f26777a2ea83bd289372213b11a1b1e7c436eb3dd6c9f698aaf407675431dff6e58be042b07ddac75024c9cbb')

prepare() {
  cd verilator
  autoconf
}

build() {
  cd verilator
  ./configure --prefix=/usr
  make
}

check() {
  cd verilator
  make test
}

package() {
  cd verilator
  make install DESTDIR="$pkgdir"
}
