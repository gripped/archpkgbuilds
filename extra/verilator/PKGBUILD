pkgname=verilator
pkgver=5.048
pkgrel=1
pkgdesc='The fastest free Verilog HDL simulator'
url='https://www.veripool.org/verilator/'
arch=('x86_64')
license=('LGPL-3.0-only' 'Artistic-2.0')
depends=('perl' 'python')
optdepends=('systemc')
makedepends=('git' 'help2man' 'systemc')
checkdepends=('python-distro')
source=("git+https://github.com/verilator/verilator.git#tag=v$pkgver")
sha512sums=('80be8e9bbac921d4a8e04cd10299af19852da8e6ec4b46009deba071a010d5561a86552fb1bb06d02037255ab5f1d11a4ac6e108b37cd8504c142e852e26d271')

prepare() {
  cd verilator
  autoconf
}

build() {
  cd verilator
  ./configure --prefix=/usr
  make
}

check() {
  cd verilator
  make test
}

package() {
  cd verilator
  make install DESTDIR="$pkgdir"
}
