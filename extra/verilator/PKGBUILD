pkgname=verilator
pkgver=5.050
pkgrel=1
pkgdesc='The fastest free Verilog HDL simulator'
url='https://www.veripool.org/verilator/'
arch=('x86_64')
license=('LGPL-3.0-only' 'Artistic-2.0')
depends=('perl' 'python' 'lz4' 'zlib')
optdepends=('systemc')
makedepends=('git' 'help2man' 'systemc')
checkdepends=('python-distro')
source=("git+https://github.com/verilator/verilator.git#tag=v$pkgver")
sha512sums=('714a09997697938221f7e0bbaef058b28b43224412c18991d8cca7507f86004a6ac1a3ec3bfac750f30c5c636fe78bdfaa17b298246ab2d539db0dde77f4bcc1')

prepare() {
  cd verilator
  autoconf
}

build() {
  cd verilator
  ./configure --prefix=/usr
  make
}

check() {
  cd verilator
  make test
}

package() {
  cd verilator
  make install DESTDIR="$pkgdir"
}
