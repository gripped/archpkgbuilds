pkgname=msgpack-c
pkgver=7.0.0
pkgrel=1
pkgdesc='An efficient object serialization library'
arch=("x86_64")
url='https://msgpack.org/'
license=('BSL-1.0')
depends=('glibc')
makedepends=(
  'cmake'
  'doxygen'
  'graphviz'
)
checkdepends=('gtest')
provides=(libmsgpack-c.so)
source=("$pkgname-$pkgver.tar.gz::https://github.com/msgpack/msgpack-c/archive/c-$pkgver.tar.gz")
b2sums=('a3024575c417ea45cb81dd176ea29fc0a73ee3ac41eb5028be673ed906d5696d5862dbdecc9034cfb5e20fb33ad35e2a5f0325874a301280e8ef36b4cadf0102')

build() {
  cd $pkgname-c-$pkgver
  cmake -S . -B build \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=None \
    -Wno-dev \
    -DBUILD_SHARED_LIBS=ON \
    -DMSGPACK_ENABLE_STATIC=OFF \
    -DMSGPACK_BUILD_EXAMPLES=OFF \
    -DMSGPACK_BUILD_TESTS=ON
  cmake --build build
}

check() {
  cd $pkgname-c-$pkgver
  cmake --build build --target test
}

package() {
  cd $pkgname-c-$pkgver
  DESTDIR="$pkgdir" cmake --install build
}
