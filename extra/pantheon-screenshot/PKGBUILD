# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=pantheon-screenshot
pkgver=9.0.0
pkgrel=1
pkgdesc='The Pantheon Screenshot Tool'
arch=(x86_64)
url=https://github.com/elementary/screenshot
license=(LGPL-3.0-or-later)
groups=(pantheon)
depends=(
  dconf
  gdk-pixbuf2
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  libcanberra
  libgranite-7.so
  libportal
  pango
)
makedepends=(
  cmake
  git
  intltool
  meson
  vala
)
source=(pantheon-screenshot::git+https://github.com/elementary/screenshot.git#tag=${pkgver})
b2sums=('8296310473807c7f6d6be167d6ef94dce171f586b29ad5316825f2a4699b239f985977c2ee79962b584f8f2d42220b1d0c67b6ba04a52f4effa45d16173e011f')

build() {
  arch-meson pantheon-screenshot build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}

