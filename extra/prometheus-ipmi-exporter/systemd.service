[Unit]
Description=Prometheus exporter for IPMI metrics
Documentation=https://github.com/prometheus-community/ipmi_exporter
After=network.target network-online.target nss-lookup.target basic.target
Wants=network-online.target nss-lookup.target
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Restart=on-failure
RestartSec=30
EnvironmentFile=-/etc/prometheus/ipmi-exporter.env
ExecStart=/usr/bin/prometheus-ipmi-exporter --config.file=/etc/prometheus/ipmi-exporter.yml $IPMI_EXPORTER_ARGS
User=prometheus-ipmi-exporter
Group=prometheus-ipmi-exporter
ExecReload=/bin/kill -HUP $MAINPID
ProtectHome=true
ProtectSystem=full
ProtectHostname=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
DeviceAllow=/dev/ipmi0 rw
DeviceAllow=/dev/bmc rw
DeviceAllow=/dev/dcmi rw
PrivateTmp=true
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
