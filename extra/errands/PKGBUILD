pkgname=errands
pkgver=51.0.3
pkgrel=1
pkgdesc='Todo application for those who prefer simplicity'
arch=(x86_64)
url='https://apps.gnome.org/List/'
license=(MIT)
groups=(gnome-circle)
depends=(
  cairo
  evolution-data-server
  glib2
  glibc
  gtk4
  gtksourceview5
  hicolor-icon-theme
  json-glib
  libadwaita
  libgcc
  libgoa
  libical
  libportal
  libsecret
  libsoup3
)
makedepends=(
  blueprint-compiler
  git
  libportal-gtk4
)
source=("git+https://github.com/mrvladus/Errands.git#tag=$pkgver")
b2sums=(e513958080f326addf4d59226c9d0fb86eea3d0e37e0e8c4001c8b48f623751815a05b3e824b3e08fd728d206a8d5eab93a4dc566e9dcac4cee7af9cf185379f)

build() {
  cd Errands
  make
}

package() {
  cd Errands
  make DESTDIR="$pkgdir" prefix=/usr install
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
