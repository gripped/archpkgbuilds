# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=errands
pkgver=51.0.2
pkgrel=1
pkgdesc='Todo application for those who prefer simplicity'
arch=(x86_64)
url='https://apps.gnome.org/List/'
license=(MIT)
groups=(gnome-circle)
depends=(
  cairo
  evolution-data-server
  glib2
  glibc
  gtk4
  gtksourceview5
  hicolor-icon-theme
  json-glib
  libadwaita
  libgcc
  libgoa
  libical
  libportal
  libsecret
  libsoup3
)
makedepends=(
  blueprint-compiler
  git
  libportal-gtk4
)
source=("git+https://github.com/mrvladus/Errands.git#tag=$pkgver")
b2sums=(b31719a33f5a86b6013438c012590d9ca3969d0ed797c57ebdfe153f96820dc28d6f2dca9e214bd1149b7df71551e7371f8d676a01715b66a18961b0330d9eb8)

build() {
  cd Errands
  make
}

package() {
  cd Errands
  make DESTDIR="$pkgdir" prefix=/usr install
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
