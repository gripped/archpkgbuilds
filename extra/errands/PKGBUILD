pkgname=errands
pkgver=51.1
pkgrel=1
pkgdesc='Todo application for those who prefer simplicity'
arch=(x86_64)
url='https://apps.gnome.org/List/'
license=(MIT)
groups=(gnome-circle)
depends=(
  cairo
  evolution-data-server
  glib2
  glibc
  gtk4
  gtksourceview5
  hicolor-icon-theme
  json-glib
  libadwaita
  libgcc
  libgoa
  libical
  libportal
  libsecret
  libsoup3
)
makedepends=(
  blueprint-compiler
  git
  libportal-gtk4
)
source=("git+https://github.com/mrvladus/Errands.git#tag=$pkgver")
b2sums=(e6003510909ce0fad23a5985993237a0e2ac916320acbd3ad31f23d0a93c3b119a473c549eb6f37b8da0d2b41e5f937e03dbf19127802c8f267a29e47a51d254)

build() {
  cd Errands
  make
}

package() {
  cd Errands
  make DESTDIR="$pkgdir" prefix=/usr install
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
