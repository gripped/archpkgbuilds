pkgname=errands
pkgver=51.2.6
pkgrel=1
pkgdesc='Todo application for those who prefer simplicity'
arch=(x86_64)
url='https://apps.gnome.org/List/'
license=(MIT)
groups=(gnome-circle)
depends=(
  cairo
  evolution-data-server
  glib2
  glibc
  gtk4
  gtksourceview5
  hicolor-icon-theme
  json-glib
  libadwaita
  libgcc
  libgoa
  libical
  libportal
  libsecret
  libsoup3
)
makedepends=(
  blueprint-compiler
  git
  libportal-gtk4
)
source=("git+https://github.com/mrvladus/Errands.git#tag=$pkgver")
b2sums=(6a1b40481c799dd9a91f6f6ea5d6839c727aef859c1b9d5a7d291832c5134647737fa631fd1e6a76b72c48ee119e10473d25cd7a249bae1498b82a96de37b7ef)

build() {
  cd Errands
  make
}

package() {
  cd Errands
  make DESTDIR="$pkgdir" prefix=/usr install
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
