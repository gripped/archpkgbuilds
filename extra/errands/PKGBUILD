pkgname=errands
pkgver=51.0.4
pkgrel=1
pkgdesc='Todo application for those who prefer simplicity'
arch=(x86_64)
url='https://apps.gnome.org/List/'
license=(MIT)
groups=(gnome-circle)
depends=(
  cairo
  evolution-data-server
  glib2
  glibc
  gtk4
  gtksourceview5
  hicolor-icon-theme
  json-glib
  libadwaita
  libgcc
  libgoa
  libical
  libportal
  libsecret
  libsoup3
)
makedepends=(
  blueprint-compiler
  git
  libportal-gtk4
)
source=("git+https://github.com/mrvladus/Errands.git#tag=$pkgver")
b2sums=(5f42f940bc9dd736008b0fd64e4166c458ed73e2539312b9895e84a062c8ab7416733f41259a1841866b31bd104ee227a636e51bfc03d709f14684c0b1c5607f)

build() {
  cd Errands
  make
}

package() {
  cd Errands
  make DESTDIR="$pkgdir" prefix=/usr install
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
