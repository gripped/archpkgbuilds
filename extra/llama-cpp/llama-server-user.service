[Unit]
Description=LLaMA.cpp HTTP Server
Documentation=https://github.com/ggml-org/llama.cpp/tree/%PKGVER%/tools/server

[Service]
Type=simple
ExecStart=/usr/bin/llama-server
# Security
NoNewPrivileges=yes
# Sandboxing
ProtectSystem=strict
ProtectHome=tmpfs
RuntimeDirectory=llama/server
ConfigurationDirectory=llama/server
CacheDirectory=huggingface/hub
CacheDirectory=mesa_shader_cache
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/dri/* rw
DeviceAllow=/dev/kfd rw
DeviceAllow=/dev/nvidia* rw
PrivateIPC=yes
PrivateUsers=self
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
PrivateBPF=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
PrivateMounts=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallArchitectures=native
EnvironmentFile=-%E/llama/server/environment.conf

[Install]
WantedBy=default.target
