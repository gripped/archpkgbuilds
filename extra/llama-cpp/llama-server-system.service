[Unit]
Description=LLaMA.cpp HTTP Server
Documentation=https://github.com/ggml-org/llama.cpp/tree/%PKGVER%/tools/server

[Service]
User=llama
Group=llama
DynamicUser=yes
Type=simple
ExecStart=/usr/bin/llama-server --models-dir "%D/llama/models"
WorkingDirectory=%S/llama/server
# Security
NoNewPrivileges=yes
# Sandboxing
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=yes
StateDirectory=llama/server
CacheDirectory=llama/server
LogsDirectory=llama/server
RuntimeDirectory=llama/server
ConfigurationDirectory=llama/server
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/dri/* rw
DeviceAllow=/dev/kfd rw
DeviceAllow=/dev/nvidia* rw
PrivateIPC=yes
PrivateUsers=self
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
PrivateBPF=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
PrivateMounts=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallArchitectures=native
## Workaround for Vulkan cache with NVIDIA GPU
Environment=HOME=%S/llama/server
Environment=LLAMA_CACHE=%C/llama/server
EnvironmentFile=-%E/llama/server/environment.conf

[Install]
WantedBy=multi-user.target
