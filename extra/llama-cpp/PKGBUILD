# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=llama-cpp
pkgver=b10485
pkgrel=1
pkgdesc='LLM inference in C/C++'
arch=(x86_64)
url=https://github.com/ggml-org/llama.cpp
license=(MIT)
depends=(
  ggml
  glibc
  libgcc
  libstdc++
  openssl
)
conflicts=(llama-cpp)
provides=(llama-cpp)
replaces=(
  llama-cpp-rocm
  llama-cpp-vulkan
)
makedepends=(
  cmake
  git
  ninja
  npm
)
source=(git+https://github.com/ggml-org/llama.cpp.git#tag=${pkgver}
        llama-server-system.service
        llama-server-user.service)
b2sums=('cb90f1e622068deb462fb5974a88458a2a90641fc2429d87415d1aec3e505ced05592600a73054db5fbc3963e17aa2fbb8722961a2da3e3682e9cd32ce345206'
        '192893e9886bae2befb140ffdf4f2d752492e20822febc1b4f1bd4581ab87a0babbd50b2c32f98f7f10c1e0e2d88f2422582d56962eecd83729061718785c6e1'
        '2571b9e27537c11620524341c52503617d9c494474c62f72ca0250b965106711b650da2ed6557aa479010132046416bdf79e689e66dd0714d1d1bb96d4f3d995')

build() {
  pushd "./llama.cpp/tools/ui"
  npm ci --ignore-scripts
  npm run build
  popd

  cmake -S llama.cpp -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=None \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DLLAMA_BUILD_APP=OFF \
      -DLLAMA_BUILD_EXAMPLES=ON \
      -DLLAMA_BUILD_SERVER=ON \
      -DLLAMA_BUILD_TESTS=OFF \
      -DLLAMA_BUILD_TOOLS=ON \
      -DLLAMA_BUILD_UI=ON \
      -DLLAMA_USE_SYSTEM_GGML=ON
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm 644 llama.cpp/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}
  install -Dm 644 llama-server-system.service "${pkgdir}"/usr/lib/systemd/system/llama-server.service
  install -Dm 644 llama-server-user.service "${pkgdir}"/usr/lib/systemd/user/llama-server.service
  sed -i "s/%PKGVER%/$pkgver/g" "${pkgdir}"/usr/lib/systemd/*/llama-server.service
  mkdir -p "${pkgdir}"/usr/share/llama/models
}
