 from .ssa import AsyncSocket
 from .ssa._timeout import timeout as timeout_
 
 
+class SyncProxy(Proxy):
+    def connect(
+        self,
+        dest_host: str,
+        dest_port: int,
+        timeout: float | None = None,
+        *,
+        _socket: socket.socket,
+    ) -> socket.socket:
+        # python-socks 3 no longer accepts an already connected socket.
+        # Keep urllib3's resolver, source address, options, and timeout intact.
+        stream = SyncSocketStream(_socket)
+        try:
+            connector = create_sync_connector(
+                proxy_type=self._proxy_type,
+                username=self._username,
+                password=self._password,
+                rdns=self._rdns,
+                resolver=self._resolver,
+            )
+            connector.connect(stream=stream, host=dest_host, port=dest_port)
+            return _socket
+        except socket.timeout as e:
+            stream.close()
+            raise ProxyTimeoutError(f"Proxy connection timed out: {timeout}") from e
+        except ReplyError as e:
+            stream.close()
+            raise ProxyError(e, error_code=e.error_code) from e
+        except IncompleteReadError as e:
+            stream.close()
+            raise ProxyError(e) from e
+        except Exception:
+            stream.close()
+            raise
+
+
+class AsyncSocketStream(abc.AsyncSocketStream):
+    def __init__(self, sock: AsyncSocket) -> None:
+        self._socket = sock
+
+    async def write(self, data: bytes) -> None:
+        await self._socket.sendall(data)
+
+    async def read(self, max_bytes: int = 65536) -> bytes:
+        return typing.cast(bytes, await self._socket.recv(max_bytes))
+
+    async def read_exactly(self, n: int) -> bytes:
+        # SOCKS replies may span multiple TCP reads, even for fixed-size fields.
+        data = bytearray()
+        while len(data) < n:
+            chunk = await self.read(n - len(data))
+            if not chunk:
+                raise ProxyError("Connection closed unexpectedly")
+            data.extend(chunk)
+        return bytes(data)
+
+    async def close(self) -> None:
+        self._socket.close()
+
