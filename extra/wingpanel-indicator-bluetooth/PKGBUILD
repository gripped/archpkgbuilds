# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=wingpanel-indicator-bluetooth
pkgver=8.0.0
pkgrel=3
pkgdesc='Wingpanel Bluetooth Indicator'
arch=(x86_64)
url=https://github.com/elementary/wingpanel-indicator-bluetooth
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  bluez
  glib2
  glibc
  granite7
  gtk4
  libgee
  pantheon-bluetooth-daemon
  wingpanel
)
makedepends=(
  git
  meson
  vala
)
source=(git+https://github.com/elementary/wingpanel-indicator-bluetooth.git#tag=${pkgver})
b2sums=('87f748901f5d3db033af7d33bbde1486398fc9d62218bfa4c094eb479f65a562382c63f9c78c6a591155fc0e18bf560a2b24d2fa9600397a0feae22f0a995db2')

prepare() {
  cd wingpanel-indicator-bluetooth

  # Update for GTK4 port
  git cherry-pick -n 8.0.0..cccfecd0ebc24b1d1ed4e9f8ee2aa85765de5910
}

build() {
  arch-meson wingpanel-indicator-bluetooth build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}
