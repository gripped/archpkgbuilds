pkgname=libclastfm
pkgver=0.5
pkgrel=9
pkgdesc='Unofficial C-API for the Last.fm web service'
arch=(x86_64)
url='http://liblastfm.sourceforge.net/'
license=(GPL-3.0-or-later)
depends=(
  curl
  glibc
)
source=("https://downloads.sourceforge.net/liblastfm/$pkgname-$pkgver.tar.gz")
b2sums=(e6151fe40cd350639db461edbdf5918f9799043fcd32561744319e9115788125d72efc14a5a45367badd5d0a3ac32777cd91373fd87d665d0e05ad34f7bf09c2)

prepare() {
  cd $pkgname-$pkgver
  autoreconf -fiv
}

build() {
  cd $pkgname-$pkgver
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd $pkgname-$pkgver
  make DESTDIR="$pkgdir" install
}
