pkgname=gnome-shell-extension-desktop-icons-ng
_pkgname=desktop-icons-ng
pkgver=51.2.0
pkgrel=1
pkgdesc='Desktop icons extension for GNOME Shell'
arch=(any)
url='https://www.rastersoft.com/programas/ding.html'
license=(GPL-3.0-only)
depends=(
  dconf
  gdk-pixbuf2
  gjs
  glib2
  gnome-autoar
  gnome-desktop-4
  gnome-shell
  graphene
  gtk4
  libadwaita
  nautilus
  pango
)
makedepends=(
  git
  meson
)
source=("git+https://gitlab.com/rastersoft/$_pkgname.git#tag=$pkgver")
b2sums=(9bd468da549990572a8b10ba555c2c67859bf7d6ad5e32fe293d7962a5780a65a5640a97c975a0cbc468a23da01f3fb2026ec9a50bdcda7e0317c64944f55fa6)

prepare() {
  cd $_pkgname
  rm app/icons/hicolor/icon-theme.cache
}

build() {
  gtk-update-icon-cache $_pkgname/app/icons/hicolor/
  arch-meson $_pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
}
