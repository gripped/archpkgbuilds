pkgname=gnome-shell-extension-desktop-icons-ng
_pkgname=desktop-icons-ng
pkgver=51.4.0
pkgrel=1
pkgdesc='Desktop icons extension for GNOME Shell'
arch=(any)
url='https://www.rastersoft.com/programas/ding.html'
license=(GPL-3.0-only)
depends=(
  dconf
  gdk-pixbuf2
  gjs
  glib2
  gnome-autoar
  gnome-desktop-4
  gnome-shell
  graphene
  gtk4
  libadwaita
  nautilus
  pango
)
makedepends=(
  git
  meson
)
source=("git+https://gitlab.com/rastersoft/$_pkgname.git#tag=$pkgver")
b2sums=(1b725453aff1524f7746350740ea77ee9c0b2637969b1d5c9f7253ea233512d47039eb797e59066c4d1d79a890fbd24354b0aff767bfdb92dded6972fd11629c)

prepare() {
  cd $_pkgname
  rm app/icons/hicolor/icon-theme.cache
}

build() {
  gtk-update-icon-cache $_pkgname/app/icons/hicolor/
  arch-meson $_pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
}
