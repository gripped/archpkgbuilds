pkgname=gnome-shell-extension-desktop-icons-ng
_pkgname=desktop-icons-ng
pkgver=51.0.1
pkgrel=1
pkgdesc='Desktop icons extension for GNOME Shell'
arch=(any)
url='https://www.rastersoft.com/programas/ding.html'
license=(GPL-3.0-only)
depends=(
  dconf
  gdk-pixbuf2
  gjs
  glib2
  gnome-autoar
  gnome-desktop-4
  gnome-shell
  graphene
  gtk4
  libadwaita
  nautilus
  pango
)
makedepends=(
  git
  meson
)
source=("git+https://gitlab.com/rastersoft/$_pkgname.git#tag=$pkgver")
b2sums=(977209a50c1f37d2b666025e67eefa437239e3a9554c3d2502c92b274a50f0503ffa8a7e211bb002254ac8930eb8d38c2f972aa82ee47f341592e9115f44ad57)

prepare() {
  cd $_pkgname
}

build() {
  arch-meson $_pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
}
