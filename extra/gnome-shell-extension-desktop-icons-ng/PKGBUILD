pkgname=gnome-shell-extension-desktop-icons-ng
_pkgname=desktop-icons-ng
pkgver=51.0.3
pkgrel=1
pkgdesc='Desktop icons extension for GNOME Shell'
arch=(any)
url='https://www.rastersoft.com/programas/ding.html'
license=(GPL-3.0-only)
depends=(
  dconf
  gdk-pixbuf2
  gjs
  glib2
  gnome-autoar
  gnome-desktop-4
  gnome-shell
  graphene
  gtk4
  libadwaita
  nautilus
  pango
)
makedepends=(
  git
  meson
)
source=("git+https://gitlab.com/rastersoft/$_pkgname.git#tag=$pkgver")
b2sums=(818fc924b2d19b7f324b487dea0a93a588c46a771c4ec36762fe2b636ec14004c185b8dcb68adcb4f4a43318495c3b362849a18eda0cf189b0d2ad632eac8f22)

prepare() {
  cd $_pkgname
}

build() {
  arch-meson $_pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
}
