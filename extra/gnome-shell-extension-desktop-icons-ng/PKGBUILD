pkgname=gnome-shell-extension-desktop-icons-ng
_pkgname=desktop-icons-ng
pkgver=51.0.6
pkgrel=1
pkgdesc='Desktop icons extension for GNOME Shell'
arch=(any)
url='https://www.rastersoft.com/programas/ding.html'
license=(GPL-3.0-only)
depends=(
  dconf
  gdk-pixbuf2
  gjs
  glib2
  gnome-autoar
  gnome-desktop-4
  gnome-shell
  graphene
  gtk4
  libadwaita
  nautilus
  pango
)
makedepends=(
  git
  meson
)
source=("git+https://gitlab.com/rastersoft/$_pkgname.git#tag=$pkgver")
b2sums=(f6c4eeafa5665498860b3f40e30c5f2c167832c66dcbd3cfac2774588f5f1ccb754d0425da8df4223e4c9b21d2f936cedcf0fb0e642dda02b89f5d52584c29a2)

prepare() {
  cd $_pkgname
}

build() {
  arch-meson $_pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
}
