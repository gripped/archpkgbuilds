pkgname=gnome-shell-extension-desktop-icons-ng
_pkgname=desktop-icons-ng
pkgver=51.1.1
pkgrel=1
pkgdesc='Desktop icons extension for GNOME Shell'
arch=(any)
url='https://www.rastersoft.com/programas/ding.html'
license=(GPL-3.0-only)
depends=(
  dconf
  gdk-pixbuf2
  gjs
  glib2
  gnome-autoar
  gnome-desktop-4
  gnome-shell
  graphene
  gtk4
  libadwaita
  nautilus
  pango
)
makedepends=(
  git
  meson
)
source=("git+https://gitlab.com/rastersoft/$_pkgname.git#tag=$pkgver")
b2sums=(21aa79e06aaff989588388f8d3ba541c958415442f66e0ac4e32e046947a3ca08e7b9c671795e37e93e96c41e1066cc03acaddfa42afad963f68a94356bda8ec)

prepare() {
  cd $_pkgname
  rm app/icons/hicolor/icon-theme.cache
}

build() {
  gtk-update-icon-cache $_pkgname/app/icons/hicolor/
  arch-meson $_pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
}
