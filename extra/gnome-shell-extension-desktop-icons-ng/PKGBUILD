pkgname=gnome-shell-extension-desktop-icons-ng
_pkgname=desktop-icons-ng
pkgver=51.0.8
pkgrel=1
pkgdesc='Desktop icons extension for GNOME Shell'
arch=(any)
url='https://www.rastersoft.com/programas/ding.html'
license=(GPL-3.0-only)
depends=(
  dconf
  gdk-pixbuf2
  gjs
  glib2
  gnome-autoar
  gnome-desktop-4
  gnome-shell
  graphene
  gtk4
  libadwaita
  nautilus
  pango
)
makedepends=(
  git
  meson
)
source=("git+https://gitlab.com/rastersoft/$_pkgname.git#tag=$pkgver")
b2sums=(90c4aa54470dbf6a002a6884dfd69e1e97d3ff8cbe2e29c1504af3fd6625670de88f6768e6c39fa3898510577387e220a737fc97e505bbc9392045126e1892ac)

prepare() {
  cd $_pkgname
  git cherry-pick -n e28ca26c29c57ce3c6be74ecbb5f06e9272e15eb # Don't rename schemas file
}

build() {
  arch-meson $_pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
}
