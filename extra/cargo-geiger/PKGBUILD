# Maintainer: Orhun Parmaksız <orhun@archlinux.org>
# Contributor: Bert Peters <bert@bertptrs.nl>

pkgname=cargo-geiger
pkgver=0.14.0
pkgrel=1
pkgdesc="Detects usage of unsafe Rust in a Rust crate and its dependencies"
arch=('x86_64')
url="https://github.com/geiger-rs/cargo-geiger"
license=('MIT' 'Apache-2.0')
depends=('cargo' 'openssl' 'curl' 'libgit2' 'libssh2' 'sqlite')
source=("$pkgname-$pkgver.tar.gz::$url/archive/geiger-$pkgver.tar.gz")
sha256sums=('60bc6aa6e0169aa9be755188fd42f496b92cf8fb3b6c9e9c1c10be48fe2ea82c')

prepare() {
  mv "$pkgname-geiger-$pkgver" "$pkgname-$pkgver"
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname-$pkgver/$pkgname"
  export LIBGIT2_NO_VENDOR=1
  export LIBSSH2_SYS_USE_PKG_CONFIG=1
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
  cargo build --release --frozen
}

check() {
  cd "$pkgname-$pkgver"
  export LIBGIT2_NO_VENDOR=1
  export LIBSSH2_SYS_USE_PKG_CONFIG=1
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver/$pkgname"
  install -Dm755 "../target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE-MIT -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
}

