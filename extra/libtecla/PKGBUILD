# Contributor: Stefan Husmann <stefan-husmann@t-online.de

pkgname=libtecla
pkgver=1.6.3
pkgrel=3
pkgdesc="Interactive command line editing facilities"
arch=('x86_64')
url='https://www.astro.caltech.edu/~mcs/tecla/'
license=('ICU')
depends=('ncurses')
source=("${url}$pkgname-$pkgver.tar.gz"
        "libtecla-1.6.3-linking-rules.patch")
sha256sums=('f2757cc55040859fcf8f59a0b7b26e0184a22bece44ed9568a4534a478c1ee1a'
            '8393d65a5a0986b51dd2b2ed8b1c114bd8c377f7c46771d11d62c8b82b529c5d')

prepare() {
  cd "$srcdir/$pkgname"
  patch -Np1 -i ../libtecla-1.6.3-linking-rules.patch
  autoreconf -fiv
}

build() {
  cd "$srcdir/$pkgname"
  ./configure --prefix=/usr
  make 
}

package() {
  cd "$srcdir/$pkgname"
  make -j1 prefix="$pkgdir/usr" MANDIR="$pkgdir/usr/share/man" install
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  install -m 444 LICENSE.TERMS "$pkgdir/usr/share/licenses/$pkgname"
}
