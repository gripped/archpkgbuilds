# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=muse
pkgver=4.2.1
pkgrel=8
pkgdesc="A digital audio workstation with support for both Audio and MIDI"
arch=(x86_64)
url="https://github.com/muse-sequencer/muse"
license=(GPL-2.0-or-later)
groups=(pro-audio)
depends=(
  glibc
  hicolor-icon-theme
  libgcc
  libstdc++
  python
  python-pyqt5
  python-pyro
  qt5-base
  qt5-svg
)
makedepends=(
  alsa-lib
  cmake
  dssi
  extra-cmake-modules
  fluidsynth
  glib2
  jack
  ladspa
  liblo
  liblrdf
  libsamplerate
  libsndfile
  lilv
  lv2
  qt5-tools
  rtaudio
  rubberband
  serd
)
provides=(
  dssi-host
  ladspa-host
  lv2-host
  vst-host
)
source=(
  $url/archive/$pkgver/$pkgname-$pkgver.tar.gz
  $pkgname-4.2.1-remove-python-six.patch
  $pkgname-4.2.1-port-to-pyro5.patch
)
