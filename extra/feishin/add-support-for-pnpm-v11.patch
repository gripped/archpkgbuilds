From a03758a7c9e742c5ecc2406d556c885059f87ae9 Mon Sep 17 00:00:00 2001
From: oHaoDaio <pb199486@gmail.com>
Date: Sun, 24 May 2026 01:14:34 +0800
Subject: [PATCH 1/3] chore: Support pnpm v11

---
 Dockerfile          | 2 +-
 pnpm-workspace.yaml | 5 +++++
 2 files changed, 6 insertions(+), 1 deletion(-)
 create mode 100644 pnpm-workspace.yaml

diff --git a/Dockerfile b/Dockerfile
index d2ab73524b..0a6191fc91 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -3,7 +3,7 @@ FROM node:23-alpine AS builder
 WORKDIR /app
 
 # Copy package.json first to cache node_modules
-COPY package.json pnpm-lock.yaml .
+COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .
 
 RUN npm install -g pnpm
 
diff --git a/pnpm-workspace.yaml b/pnpm-workspace.yaml
new file mode 100644
index 0000000000..93c21ea947
--- /dev/null
+++ b/pnpm-workspace.yaml
@@ -0,0 +1,5 @@
+allowBuilds:
+  abstract-socket: true
+  electron: true
+  electron-winstaller: true
+  esbuild: true

