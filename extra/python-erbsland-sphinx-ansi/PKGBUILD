# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=python-erbsland-sphinx-ansi
_name=${pkgname#python-}
pkgver=1.1.6
pkgrel=1
pkgdesc="A Sphinx extension to format ANSI colored/formated terminal output"
arch=(any)
url="https://github.com/erbsland-dev/erbsland-sphinx-ansi"
license=(Apache-2.0)
depends=(
  python
  python-docutils  # undeclared runtime dependency: https://github.com/erbsland-dev/erbsland-sphinx-ansi/issues/3
  python-sphinx  # undeclared implicit runtime dependency: https://github.com/erbsland-dev/erbsland-sphinx-ansi/issues/4
)
makedepends=(
  python-build
  python-hatchling
  python-hatch-vcs
  python-installer
)
checkdepends=(
  python-pytest
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha512sums=('b0725a644fa45a83913281d5f1623cba3d10b7e80a9e6e39b6173c072efbf5ae5375315f428b3b65a82dd1fe925fc99af0e68031d69cd2b5d8c2a50c4354e997')
b2sums=('187ffb9ab5bd05ab291cb2c0889d80ebd5455898f8efd81ef9b302201936a2e5c63575cfa4f7f0c47ece786e9436c7ccd59113da790ab9a8b85df0ae2115d1c4')

build() {
  cd $_name-$pkgver
  SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver python -m build --wheel --no-isolation
}

check() {
  cd $_name-$pkgver
  pytest -vvv
}

package() {
  cd $_name-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
}
