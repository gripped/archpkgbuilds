# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=pantheon-camera
pkgver=9.0.0
pkgrel=1
pkgdesc='The Pantheon Camera Application'
arch=(x86_64)
url=https://github.com/elementary/camera
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  dconf
  glib2
  glibc
  gstreamer
  gst-plugins-base-libs
  gst-plugins-good
  gtk4
  hicolor-icon-theme
  libcanberra.so
  libgranite-7.so
)
makedepends=(
  appstream
  git
  intltool
  meson
  vala
)
source=(pantheon-camera::git+https://github.com/elementary/camera.git#tag=${pkgver})
b2sums=('13a2395e172396b22f074f3161668ed785a8bf81d9d424c0dadc863103897e78bcc8dd8fa621f974459fde771bfc4b756e7cc949fdbda2f625129ab9ed586e81')

build() {
  arch-meson pantheon-camera build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}

