# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=webfont-kit-generator
pkgver=1.3.0
pkgrel=3
pkgdesc='Utility to generate WOFF, WOFF2 and the necessary CSS boilerplate from non-web font formats (OTF & TTF)'
arch=(any)
url='https://apps.gnome.org/WebfontKitGenerator/'
license=(GPL-3.0-or-later)
groups=(gnome-circle)
depends=(
  dconf
  glib2
  gtk4
  gtksourceview5
  hicolor-icon-theme
  libadwaita
  libsoup3
  python
  python-brotli
  python-fonttools
  python-gobject
)
makedepends=(
  appstream
  blueprint-compiler
  git
  meson
)
source=(
  "git+https://github.com/rafaelmardojai/webfont-kit-generator.git#tag=$pkgver"
  webfont-kit-generator-clear-temp-files.patch
)
b2sums=(
  7e01fbfbe62e6424324d87d4f945c6e1239a8bfe2af4b54c0fc2a3c1f7f576da7e57c822b7f0b4500c0bf5e32f5bcbb522990f3c76b317a5b4316de65bd7a65d
  c3eaa4db00d5a57f5e3394fea55db60992c0da6087424eb14799727e83bb01a91a7967937b736ca2aa6eaa11ebbd03d8d39b865554422e4af3288b6303023938
)

prepare() {
  cd $pkgname

  # Clean up temporary Google Fonts files
  # https://github.com/rafaelmardojai/webfont-kit-generator/pull/62
  git apply -3 ../webfont-kit-generator-clear-temp-files.patch
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  python -m compileall -d /usr/share "$pkgdir/usr/share"
  python -O -m compileall -d /usr/share "$pkgdir/usr/share"
}
