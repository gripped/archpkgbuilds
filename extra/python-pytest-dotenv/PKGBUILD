# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-pytest-dotenv
pkgver=0.5.2
pkgrel=1
pkgdesc="Pytest plugin for loading environment variables from dotenv files"
arch=('any')
url="https://github.com/quiqua/pytest-dotenv"
license=('MIT')
depends=('python' 'python-dotenv' 'python-pytest')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("git+https://github.com/quiqua/pytest-dotenv.git#tag=$pkgver")
sha512sums=('b0ecc8275b391635c96a73493bd42a90f209ea0ab847f2ba8bffbd2c500c5b25ade375537a27feeb9f5aa130186579b86d9677e27013607255f421287dcc72fa')

build() {
  cd pytest-dotenv
  python -m build --wheel --no-isolation
}

check() {
  cd pytest-dotenv
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd pytest-dotenv
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
