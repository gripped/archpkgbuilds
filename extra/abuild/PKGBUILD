# Contributor: Dominic Meiser [git at msrd0 dot de]
# Contributor: Clar Fon <them@lightdark.xyz>

pkgname=abuild
pkgver=3.18.0
pkgrel=2
pkgdesc="Alpine build tools"
url="https://gitlab.alpinelinux.org/alpine/abuild"
arch=('x86_64')
license=('GPL-2.0-or-later')
depends=('alpine-keyring' 'busybox' 'glibc' 'pax-utils' 'openssl' 'apk-tools'
         'attr' 'tar' 'pkgconf' 'lzip' 'curl' 'bubblewrap' 'gettext' 'git' 'fakeroot')
makedepends=('zlib' 'scdoc')
optdepends=('perl: for cpan resolver'
            'perl-libwww: for cpan resolver'
            'perl-json: for cpan resolver'
            'perl-module-build-tiny: for cpan resolver'
            'perl-lwp-protocol-https: for cpan resolver'
            'ruby: for gem resolver'
            'ruby-augeas: for gem resolver')
backup=("etc/${pkgname}.conf")
install="${pkgname}.install"
source=("${url}/-/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha512sums=('7c2919874659ce94d98431db9149a59ea4373eb7dc6001c45fa235779a304a817c2c9e5be283cb57b9d3e5d03f7dae6ba0f581bc369536bc1f6f726d18c65fd2')

prepare() {
	cd "${pkgname}-${pkgver}"
	find -type f | while read file; do
		sed -E -i "${file}" \
			-e '1s|#!/usr/bin/env ash$|#!/bin/busybox ash|' \
			-e '1s|#!/bin/ash$|#!/bin/busybox ash|' \
			-e '1s|#!/bin/ash\s+(.*)$|#!/bin/busybox ash\nset \1|'
	done
}

build() {
	cd "${pkgname}-${pkgver}"
	make VERSION="${pkgver}"
}

package() {
	cd "${pkgname}-${pkgver}"
	make install VERSION="${pkgver}" DESTDIR="${pkgdir}"
	install -Dm 644 "${pkgname}.conf" "${pkgdir}/etc/${pkgname}.conf"

	# The `rootbld` subcommand and its default cache location do not
	# require `abuild-sudo` (and the abuild group) anymore, so we can safely get rid of it.
	# See https://gitlab.alpinelinux.org/alpine/abuild/-/commit/4c4c11131f4e5bc9c5877373cc266308648b1671
	rm -fv "${pkgdir}/usr/bin/abuild-sudo"

	# These are symlinks pointing to `abuild-sudo` (which we get rid of in the above command),
	# but `abuild` now fallbacks to `$SUDO` / `doas` / `sudo` if they are not found, so we can safely get rid of these as well.
	# See https://gitlab.alpinelinux.org/sertonix/abuild/-/commit/dff6fc6251a0060373e9e0097d8dda97cb0d8371
	rm -fv "${pkgdir}/usr/bin/abuild-"{apk,adduser,addgroup}
}
