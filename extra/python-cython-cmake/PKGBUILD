# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=python-cython-cmake
_pyname=cython-cmake
pkgver=0.3.0
pkgrel=1
arch=(any)
pkgdesc='CMake helpers for building Cython modules'
url='https://github.com/scikit-build/cython-cmake'
depends=(
  python
)
makedepends=(
  git
  python-build
  python-hatch-vcs
  python-hatchling
  python-installer
)
checkdepends=(
  cython
  python-pytest
  python-scikit-build-core
)
license=(Apache-2.0)
source=(
  git+https://github.com/scikit-build/cython-cmake#tag=v$pkgver
)
sha256sums=('15450d87a79c76d1ad9561760e2d4e7dfdee09be47b4013b655e66e8e712c66e')

build() {
  cd $_pyname
  python -m build --wheel --no-isolation
}

check() {
  cd $_pyname
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest -v
}

package() {
  cd $_pyname
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
