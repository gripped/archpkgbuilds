# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=gnome-online-accounts-gtk
pkgver=3.50.13
pkgrel=1
pkgdesc='GTK frontend for GNOME Online Accounts'
arch=(x86_64)
url='https://github.com/linuxmint/gnome-online-accounts-gtk'
license=(GPL-3.0-or-later)
groups=(x-apps)
depends=(
  glib2
  glibc
  gnome-online-accounts
  gtk4
  hicolor-icon-theme
  libadwaita
  libgoa
  xapp-symbolic-icons
)
makedepends=(
  git
  meson
)
source=("git+https://github.com/linuxmint/gnome-online-accounts-gtk.git#tag=$pkgver")
b2sums=(947723679bd9faad2c270871cb629b04070a42acd9da3171275bd73020e1c2eaebca1a430e01fd04e5cbb951f194a14f54adc5449014c520d0efae3c557ef088)

prepare() {
  cd $pkgname
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
