# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=gnome-online-accounts-gtk
pkgver=3.50.10
pkgrel=1
pkgdesc='GTK frontend for GNOME Online Accounts'
arch=(x86_64)
url='https://github.com/linuxmint/gnome-online-accounts-gtk'
license=(GPL-3.0-or-later)
groups=(x-apps)
depends=(
  glib2
  glibc
  gnome-online-accounts
  gtk4
  hicolor-icon-theme
  libadwaita
  libgoa
  xapp-symbolic-icons
)
makedepends=(
  git
  meson
)
source=("git+https://github.com/linuxmint/gnome-online-accounts-gtk.git#tag=$pkgver")
b2sums=(0df0e95c5cc5b5125ac7da0d6c5eb31a7e768627ecfd9da01b7eb48a2019127d0fe30fb936542ee20a4acc8f1651a89d6a70f0ef1a26d1b7ea975d938f6a7443)

prepare() {
  cd $pkgname

  # Mark the title as translatable
  # https://github.com/xapp-project/gnome-online-accounts-gtk/pull/24
  sed -i 's/ name="title"/ name="title" translatable="1"/' src/online-accounts.ui
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
