# Maintainer: Filipe Laíns (FFY00) <lains@archlinux.org>
# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=hamlib
pkgver=4.7.0
pkgrel=1
pkgdesc='Ham radio equipment control libraries'
arch=('x86_64')
url='https://hamlib.github.io'
license=(
  'GPL-2.0-or-later'
  'LGPL-2.0-or-later'
)
depends=(
  'glibc'
  'libgcc'
  'libindi'
  'libstdc++'
  'libusb'
  'readline'
)
makedepends=(
  'git'
  'lua54'
  'python'
  'swig'
  'tcl'
)
optdepends=(
  'lua54: Lua bindings'
  'perl: Perl bindings'
  'python: Python bindings'
  'tcl: Tcl bindings'
)
provides=(
  'libhamlib++.so'
  'libhamlib.so'
)
source=("$pkgname::git+https://github.com/Hamlib/Hamlib.git#tag=$pkgver")
b2sums=('07bce7b54859aebbf440100eab037a3b8382023c4c18fc444f695a25a0daa225756ff63ef8bd743520a5eb4203bb6795e87ae8b2c5c67c75a42a3f770a88869b')
validpgpkeys=('82D64F6B0E67CD41F689BBA6FB2C5130D55A8819') # Nate Bargmann <n0nb@n0nb.us>

prepare() {
  cd $pkgname
  sed -i 's/Hamlib-pl.mk install_site/Hamlib-pl.mk install/g' bindings/Makefile.am
  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --with-perl-binding \
    --with-python-binding \
    --with-tcl-binding \
    --with-lua-binding \
    --with-xml-support \
    --with-indi \
    --with-readline \
    --disable-static
  make
}

check() {
  cd $pkgname
  make check
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" INSTALLDIRS=vendor install
  rm -rv "$pkgdir"/usr/lib/perl5/*/core_perl
}
