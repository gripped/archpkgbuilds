# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-jh2
pkgver=5.0.15
pkgrel=1
pkgdesc="HTTP/2 protocol state machine"
arch=('x86_64')
url="https://github.com/jawah/h2"
license=('MIT')
depends=('glibc' 'libgcc' 'python')
makedepends=('cargo' 'git' 'python-build' 'python-installer' 'python-maturin')
checkdepends=('python-hypothesis' 'python-pytest')
source=("jh2::git+https://github.com/jawah/h2.git#tag=v$pkgver")
sha256sums=('9313eae010dff1d81dc1ae2b13032f8ae524be2330a89b5e14bc4ac9b2b5a5fd')

prepare() {
  cd jh2
  # The Maturin cap only preserves Python 3.13t wheel support.
  # https://github.com/jawah/h2/commit/50c7a717de17cde059269d5b12b90f7a0b66c855
  sed -i 's/maturin>=1.2,<1.14/maturin>=1.2,<2/' pyproject.toml
  cargo fetch --locked
}

build() {
  cd jh2
  python -m build --wheel --no-isolation -C build-args='--frozen --compatibility linux'
}

check() {
  cd jh2
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -P -m pytest
}

package() {
  cd jh2
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
