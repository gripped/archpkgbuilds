pkgbase = nomad
	pkgdesc = A simple and flexible workload orchestrator
	pkgver = 2.0.0
	pkgrel = 1
	url = https://www.nomadproject.io
	arch = x86_64
	license = BUSL-1.1
	makedepends = git
	makedepends = go
	depends = glibc
	depends = libgcc
	depends = iptables
	optdepends = docker: for docker driver
	optdepends = java-runtime: for java driver
	optdepends = java-runtime-headless: for java driver - headless
	optdepends = qemu: for qemu driver
	optdepends = nomad-driver-nspawn: for systemd-nspawn driver
	optdepends = nomad-driver-podman: for podman driver
	optdepends = nomad-driver-lxc: for lxc driver
	optdepends = nomad-driver-containerd: for containerd driver
	options = !lto
	backup = etc/nomad.d/defaults.hcl
	source = nomad::git+https://github.com/hashicorp/nomad.git#tag=v2.0.0
	source = systemd.service
	source = tmpfiles.conf
