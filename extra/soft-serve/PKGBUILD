pkgname=soft-serve
pkgver=0.12.1
pkgrel=1
pkgdesc='A self-hosted Git server for the command line'
arch=(x86_64)
url='https://github.com/charmbracelet/soft-serve'
license=(MIT)
depends=(glibc git)
makedepends=(go)
backup=(etc/soft-serve.env)
options=(!lto)
source=(
  "git+$url.git#tag=v$pkgver"
  tweak-systemd-config.patch
)
sha512sums=('a93958425222785dff4649677159146f0616d161fc8f3c4fffd98b256065cc178fa6326b67138e88efa65d3ab0ffa791e2b14b78c8cc87945889b6ead725f47a'
            'a4c68041c06c5d5a028aca7bbbaf393a003cfe9a551dd0fab86eb3909b8392926a04961af93580a2eb9b61ce190663e774af4953d0544b62be6b2d06a41f7978')
b2sums=('c25271c5dd6b6774de87d799aaa514e55ac079dfd9f9b3362742f0904ef35b9a0535b3d9c2b4368fefced5b73809470af66267c79761d682ffa62abfaeb4bf0a'
        '3ed99196467f1ef781a109fbdf9aef88f0b5c15a8eea5b5ad707af340bad7dcb59f4b876d623751b16544844fa7227464f955ab068c5e98de6eaf9830969e1f7')

prepare() {
  cd "$pkgname"

  # create directory for build output
  mkdir build

  # download dependencies
  export GOPATH="${srcdir}"
  go mod download

  # tweak systemd configuration
  patch -p1 -i "$srcdir/tweak-systemd-config.patch"
}

build() {
  cd "$pkgname"

  # set Go flags
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export GOPATH="${srcdir}"

  go build -v \
    -buildmode=pie \
    -mod=readonly \
    -modcacherw \
    -ldflags "-compressdwarf=false \
    -linkmode external \
    -extldflags '${LDFLAGS}' \
    -X main.Version=$pkgver \
    -X main.CommitSHA=$(git rev-parse HEAD)" \
    -o build \
    ./cmd/...

  # generate man page
  ./build/soft man > build/soft.1

  # generate shell completion
  for shell in bash fish zsh; do
    ./build/soft completion "$shell" > "build/$shell.completion"
  done
}

package() {
  # systemd integration

  cd "$pkgname"

  # systemd integration
  pushd .nfpm
  install -vDm644 soft-serve.service -t "$pkgdir/usr/lib/systemd/system"
  install -vDm644 sysusers.conf "$pkgdir/usr/lib/sysusers.d/$pkgname.conf"
  install -vDm644 tmpfiles.conf "$pkgdir/usr/lib/tmpfiles.d/$pkgname.conf"
  install -vDm644 soft-serve.conf "$pkgdir/etc/soft-serve.env"
  popd

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" build/soft

  # shell completion
  install -vDm644 build/bash.completion "$pkgdir/usr/share/bash-completion/completions/soft"
  install -vDm644 build/fish.completion "$pkgdir/usr/share/fish/vendor_completions.d/soft.fish"
  install -vDm644 build/zsh.completion "$pkgdir/usr/share/zsh/site-functions/_soft"

  # man page
  install -vDm644 -t "$pkgdir/usr/share/man/man1" build/soft.1

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}

