# Maintainer: Orhun Parmaksız <orhun@archlinux.org>

pkgname=ratty
pkgver=0.4.1
pkgrel=1
pkgdesc="A GPU-rendered terminal emulator with inline 3D graphics"
arch=('x86_64')
url="https://github.com/orhun/ratty"
license=('MIT')
depends=(
  fontconfig
  gcc-libs
  glibc
  libx11
  libxcb
  libxkbcommon
  libxkbcommon-x11
  systemd-libs
  wayland
  zlib
)
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha512sums=('0a74b4133ad391bd8ded258d84bf14844d45021f13542d7012f644ced8493b1bc39a10fe05b62058aafdd9f6e27df933ae56df9470f0003923e954fe9f5d7f99')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm 755 "target/release/$pkgname" -t "$pkgdir/usr/bin"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 config/ratty.toml "$pkgdir/usr/share/doc/$pkgname/ratty.toml"
  install -Dm644 protocols/graphics.md "$pkgdir/usr/share/doc/$pkgname/graphics.md"
}

# vim: ts=2 sw=2 et:
