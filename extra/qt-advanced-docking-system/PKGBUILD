# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=qt-advanced-docking-system
pkgver=5.0.0
pkgrel=1
pkgdesc='Advanced Docking System for Qt'
arch=(x86_64)
url='https://github.com/githubuser0xFFFF/Qt-Advanced-Docking-System/'
license=(LGPL-2.1-or-later)
depends=(glibc
         libgcc
         libstdc++
         libxcb
         qt6-base)
makedepends=(cmake
             git
             qt6-declarative)
source=(git+https://github.com/githubuser0xFFFF/Qt-Advanced-Docking-System#tag=$pkgver)
sha256sums=('f41c65947f54ecfc2f82808e99c6078f07d3df99247ca1379ea6030b58288eb1')

build() {
  cmake -B build -S Qt-Advanced-Docking-System \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
