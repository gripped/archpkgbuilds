# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=ocicl
pkgver=2.16.13
pkgrel=1
pkgdesc='An OCI-based ASDF system distribution and management tool for Common Lisp'
arch=(x86_64)
url='https://github.com/ocicl/ocicl'
license=(MIT)
depends=(glibc zstd sbcl)
makedepends=(git libfixposix)
options=(!debug !strip)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('1e8cb77a39c07003325a7701c336edb2b45272c18274c017861d861a5f66ee39fae567447caef3d45218e30a1ebf906efc7c0d9cc27bd24afd0e4aec405002d1')
b2sums=('f32c85f7cc71ff93ad32177f5511c45ccf8797c6c1434095933cd1356c26178bb0994eda643cf4a3e311faa60538bfa8e845f56251604d7e8335c8bb84228018')

build() {
  cd "$pkgname"

  sbcl --load setup.lisp --eval "(sb-ext:quit)"

  # generate licenses for vendored libraries
  ./ocicl collect-licenses > VENDORED-LICENSES.txt

  # generate SBOMs
  ./ocicl create-sbom cyclonedx ocicl-sbom.json
  ./ocicl create-sbom spdx ocicl-sbom.spdx.json
}

package() {
  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" ocicl

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md

  # sboms
  install -vDm644 ocicl-sbom.json "$pkgdir/usr/share/sbom/$pkgname-$pkgver.json"
  install -vDm644 ocicl-sbom.spdx.json "$pkgdir/usr/share/sbom/$pkgname-$pkgver.spdx.json"

  # licenses
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    LICENSE \
    VENDORED-LICENSES.txt
}
