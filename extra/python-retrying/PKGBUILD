# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Arvedui <arvedui@posteo.de>

pkgname=python-retrying
pkgver=1.3.6
pkgrel=1
pkgdesc="A general-purpose retrying library"
arch=('any')
url="https://github.com/groodt/retrying"
license=('Apache-2.0')
depends=('python')
makedepends=('python-setuptools' 'python-build' 'python-installer' 'python-wheel')
source=("https://github.com/groodt/retrying/archive/v$pkgver/$pkgname-$pkgver.tar.gz")
sha512sums=('6980d0a1955092401fe890761ad151e6acfd17fabcac82d8846945877f6b23d2bf795a07c7aadef93bbfe22f3c856da1492f92b00ef1848720ba923814212660')

build() {
  cd retrying-$pkgver
  python -m build --wheel --no-isolation
}

check() {
  cd retrying-$pkgver
  python -m unittest -v
}

package() {
  cd retrying-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
}

