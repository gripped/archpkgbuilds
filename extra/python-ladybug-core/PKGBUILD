# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.48
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('66ee412060b066ccf7bfbc23f394af9843037ae016f3fedd97f81c098fabef27a5aa09bd983b20db966b72eb61918b2e07074b603e60239a1ebc86355f434875')
b2sums=('ca427ecc0d3081c99b974d436f5e516f6afaf69233f069f3af0adbd83dc935cc739ca3f56daf65d908b37317e426255dae0ceb0962949d29e503c7495f83e622')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
