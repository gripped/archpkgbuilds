# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.43
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('55805dfe828ddb8b84d82bebcbac4c88d0b8e7192793dca8ec759c6fe54f9c754af2cfb024ae790753b8a006306cd992cf2ce9ac8893ff2d739e08ab1eb8b6ba')
b2sums=('0ce80ec3dd5a0f296581493320e72f37399dafcc431c1337062d774c6fad9a86efbfd43d2a6af3ce3989e6edb525849a73c8a83e7279971abb379a18cd2e6562')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
