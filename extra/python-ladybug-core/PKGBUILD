# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.58
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('90e2d7e76ba1564e63a34d7e2fa068f6831af3c1ff28e2e4c449e94aa4bf58f39026eb5617a5b40131ecc6f0a2d8e59836abe624fe2452819d42fae03bc1e58e')
b2sums=('cc81c88bc00ba2a410e83ea5244d57e2a6962411a6d1e53a786a6842590e31f3f6cf2756e18383565ab101f1a9049637e88b874e7e38cf97d1d80e53cbeb978a')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
