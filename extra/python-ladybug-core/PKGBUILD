# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.46
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('07ffd80450b56bab3da4dce27ef790d1b56448f2afc1de8b3b17cfa2dbe7610033a688110ef0a235ac3529933a7dfb0f4b6e69fc3eff9dc290e8e8a2dbf5f169')
b2sums=('240d8f15d131b2e9e2454c47f7ed521eec9fe24ef8835fc90a4fe2ff041917c877eef73cd26d24f464709267c0702c3ad8c40be8471eddc408a31a76c994bcf2')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
