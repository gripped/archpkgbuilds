# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.57
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('f6b54933552890c69fc32c8ad7fb52b6469c6a030db6a6709b11545a8112c20c80f377d8b54e6a91cabc414a681a9a468b894eb9c4ead5308d1779cb97db7544')
b2sums=('7e41bf667245ac1c4c651fba306dd8a82226a8317e418738ce250ff3b6d5230343b1452cf60bf326ac9b0089f7cdb060fe56f3995a4ba88df3011e33903e63a6')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
