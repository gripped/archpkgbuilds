# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.60
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('bd780335458c04975d218484ef615fab18c9f0f46f2c87dcd886eb9178f3dd406953b7946a0e6104f1b8d6467cd00b1b4e13c85fd01b57d7b6c5a872e969e275')
b2sums=('e1cc57f302ac03d07527a28b64a9567497762c34c261b02d19ad2591eea1dfc65b7b064d35bc4052f84a22c84c8f85a0ad58c70ac098e3abcdaf5729afad5e23')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
