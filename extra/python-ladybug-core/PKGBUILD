# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.63
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('ee7004b6ffc16fb06100d4113d437f45893798e81244b8c645d875f911cf1db4a54d13613c5c2df785e13df1f7c86dda0881d67dece921862b9648e60d01fdf9')
b2sums=('c63775a21809e7a67312e5c18c6e7197dda16cfdd28f5c7650d7793a0b9aac08fef4882d7ba6ee84da41a0a310bce5583d9ce4864efa0b34d5f3182e9021a5fa')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
