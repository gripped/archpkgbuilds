# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.61
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('8c23a2dfc6654e6a43f8422cbe6d2a44e09608976e59ba5b582db7df66d39b2d67de33bd9fde5e41a716faad9729757150810f91dc27aa562025f1020019d56d')
b2sums=('ed3ad0c595e1423cd7cda4250efba03ff883c91f8a0ca0e305f0f300ec2ada6a8b090d6abec6ca0500fe7d7424fd10c613acd9c9d4357b71c2afe5224292cd67')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
