# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.49
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('a9ae03387a13577fdb1d8fab1f948bd00be09dc61a78c46a2b9bd7d1dfe691d5c90996c050796d1270b06e2134345b5381958562b548716e2640eb7888bd2f1e')
b2sums=('c02fc0d9110d46d9a3c96d88c006fdebd693fcfa32940c0dc94a137055cd4f0648657157c6a88b230065a82fe597368e9fae7a26df98c16e79327457139f376b')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
