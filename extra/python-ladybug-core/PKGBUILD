# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.53
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('ad643aab2dab728b3e0748a557f7febb1153e5a3ee779514368ef7a4c2032b43938b2f398d571e23c6aa5f59b5329c9830cf0850569262934189d27afda0ca0a')
b2sums=('0918f3abf1e7e9fa299c45999f2c6f80a3084c41187d6a5b5241e07dbd43a5e5f723edfa4cf71b801ba4f48f87f47298a0ae2457e3a84ff73644617517c3afc1')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
