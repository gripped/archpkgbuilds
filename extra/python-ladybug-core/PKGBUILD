# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.56
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('a32dfae182eac2e958473f23478b15b84e6d6636da2c83354bb05b24ff387429bcfdcba8c43816d9c09d2d9916cad159f131ed1805273e631043d4f7a0d0c655')
b2sums=('59ed3e19d6f4e4f2bd9a403221556c1a870761c9e5f08dd65bd603cdbcd16bd582b391ab234cf8a0904e234ff8be221b52c8f5cc5b11d2ec61dc5c80162e48fb')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
