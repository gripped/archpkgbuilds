# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.52
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('2b0d87f73a09d1a6d324048e92f31c2b265e217df80e413cdc3e923a046a2dc0193130859a6498bf5da605b1f6184aebf558714632f1d52226462a06ca8bb47c')
b2sums=('07829a6e17805b2d6bccd6441c26b0c1dc9d53d10c23a7786a817e17d665c112756de6bb68d81a8c3808019d0bb581af2d36dc84d6b278ff63ad24d51749164a')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
