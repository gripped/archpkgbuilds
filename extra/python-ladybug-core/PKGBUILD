# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.45.4
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('91e0988cdb8f3c7f9e933d3431d4b0856159b0d997f5840a8d27ae859197e99cd49aa42f56199b6d0f7d18cbc474edfd7954cee0d03af48999062a6e812b05fc')
b2sums=('e9ce96b075549b9802a12e6e88d64ad7857810e5bfbfd162ed4f9671a234b3c3d9641c51175a15f052aac41185c71ca8250fbd6b9afc06d8df7620eaa2396595')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
