# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.42
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('1a6da4f4ecc0141813e72eaf3423fd4832826655f8c1cf1af61941493e97fa31eef525532db0f3a71e560afa685e41ddfc33db23b1c519b492cc69004e79da57')
b2sums=('a5e39f67695e10a5a02660cc8204929540c4f583bba7025463dc2c4bcfba55ad7d4e5f2509e4280eeee5dbd93e339f575b37b8ecac05698504aa59a2b6cea1f8')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
