# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.59
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('b9c75addcc7e5744b590724962b612efcc7a2bbecaab704795045112a36d0b1347c47ff5a6106e8d02e9e9623c784fd15c564c49927a1c45aed8f1e2aa60702a')
b2sums=('9bdb20f86a0ee0c2c21dafed5960f09abcb55070e206c97c3e6b8eebede3a065252176ca9f54f9aeda1c045aacf3f03de1d76816b17e4475276156bbac54832b')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
