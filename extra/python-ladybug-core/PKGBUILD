# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.39
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('7df30f38dc7fe3fbaefbbec119032b29d0634738db6ede10a7638d3af9fab52adeb3e0c8e7dcc1507d761e2e77b7153b9fd0a3ac4a739b66aed7cfc2dc657f9c')
b2sums=('9d9e61b0d69829bd2a46dfb3894c00893e2fedff6bda220f8f6d1f8ee5f0f95343e5ae2989ae7bcea402b15ce5a1e78c60ad99cbc320d4d7f1e84d0a4bff8dd1')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
