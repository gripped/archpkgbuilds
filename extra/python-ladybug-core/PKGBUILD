# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-core
pkgver=0.44.54
pkgrel=1
pkgdesc='Python library to load, analyze and modify EnergyPlus Weather files (epw)'
arch=(any)
url='https://github.com/ladybug-tools/ladybug'
license=(AGPL-3.0-only)
depends=(
  python
  python-ladybug-geometry
  python-click
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('7cfc30aece7ddf0cdfcc5481b662c45cf323e5ad49e9796dfc668ea243c2c6bc246b449991bf57282dc1343f7a858421710e897963e427b7ceec881c82b6e31d')
b2sums=('ff5f4440536711e13ae5e4a908e2d6552d494250829b23f7bef05d1fb848406a5c03c9bec982f6f94be531ef2920ad7d0c985aebb0e9e8ee832af94fb0954c4b')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
