#!/usr/bin/env python3
import re
import sys
from playwright.sync_api import sync_playwright

TARGET_URL = "https://www.intel.com/content/www/us/en/developer/tools/oneapi/base-toolkit-download.html"
PKGBUILD_PATH = "PKGBUILD"


def main():
    print("Launching headless browser...")

    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        context = browser.new_context(
            viewport={"width": 1920, "height": 1080},
            user_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        )
        page = context.new_page()

        try:
            print("Loading Intel download page...")
            page.goto(TARGET_URL, wait_until="domcontentloaded", timeout=60000)

            try:
                print("Checking for cookie banner...")
                cookie_btn = (
                    page.locator(
                        "button:has-text('Deactivate Cookies'), button:has-text('Activate Cookies')"
                    )
                    .filter(visible=True)
                    .first
                )
                cookie_btn.wait_for(state="visible", timeout=5000)
                cookie_btn.click()
                print("Cookie banner dismissed.")
            except Exception:
                print("No cookie banner detected, continuing...")

            print("Clicking 'Linux*' button...")
            linux_btn = page.get_by_text("Linux*").filter(visible=True).first
            linux_btn.click(force=True)
            page.wait_for_timeout(1000)

            print("Clicking 'Offline Installer' button...")
            offline_btn = (
                page.get_by_text("Offline Installer")
                .filter(visible=True)
                .first
            )
            offline_btn.click(force=True)
            page.wait_for_timeout(1000)

            print("Expanding the 'Offline GUI Installer' accordion...")
            accordion = (
                page.get_by_text("Install with an Offline GUI Installer")
                .filter(visible=True)
                .first
            )
            accordion.click(force=True)
            page.wait_for_timeout(1500)

            print("Hunting for the download link...")
            content = page.content()

        except Exception as e:
            print(
                f"\nError interacting with page. Taking a diagnostic screenshot..."
            )
            page.screenshot(path="debug_error.png")
            print(f"Screenshot saved to 'debug_error.png'.")
            print(f"Technical error: {e}")
            sys.exit(1)
        finally:
            browser.close()

    match = re.search(
        r"IRC_NAS/([a-zA-Z0-9-]+)/intel-oneapi-toolkit-([0-9.]+)_offline",
        content,
    )

    if not match:
        print("\nRegex failed to find the download link in the rendered HTML.")
        print(
            "Intel may have changed the filename format, or the elements failed to render."
        )
        sys.exit(1)

    raw_hash = match.group(1)
    version = match.group(2)

    href = f"https://registrationcenter-download.intel.com/akdlm/IRC_NAS/{raw_hash}/intel-oneapi-toolkit-{version}_offline.sh"
    print(f"\nFound target URL:\n{href}\n")

    safe_hash = raw_hash.replace("-", "_")
    new_pkgver = f"{version}+{safe_hash}"

    print(f"Generated Arch-safe pkgver: {new_pkgver}")

    try:
        with open(PKGBUILD_PATH, "r") as f:
            pkgbuild_content = f.read()

        new_pkgbuild_content, count = re.subn(
            r"^pkgver=.*",
            f"pkgver={new_pkgver}",
            pkgbuild_content,
            flags=re.MULTILINE,
        )

        if count == 0:
            print(
                "\nWarning: Could not find a 'pkgver=' line to update in PKGBUILD."
            )
        else:
            with open(PKGBUILD_PATH, "w") as f:
                f.write(new_pkgbuild_content)
            print("\nSuccess! PKGBUILD has been updated.")

    except FileNotFoundError:
        print(f"\nError: {PKGBUILD_PATH} not found in the current directory.")


if __name__ == "__main__":
    main()
