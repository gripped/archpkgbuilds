# Maintainer: Carl Smedstad <carsme@archlinux.org>
# Contributor: Keinv Yue <yuezk001@gmail.com>

pkgname=globalprotect-openconnect
pkgver=3.0.5
pkgrel=2
pkgdesc="A GlobalProtect VPN GUI client based on Openconnect, supports SAML auth mode"
arch=(x86_64)
url="https://github.com/yuezk/GlobalProtect-openconnect"
license=(GPL-3.0-only)
depends=(
  cairo
  gdk-pixbuf2
  glib2
  glibc
  gmp
  gnutls
  gtk3
  hicolor-icon-theme
  libgcc
  libp11-kit
  libsoup3
  libxml2
  lz4
  nettle
  openconnect
  openssl
  webkit2gtk-4.1
  xz
  zlib
)
makedepends=(
  cargo
  git
)
optdepends=('libappindicator: for system tray icon')
provides=(
  gpclient
  gpservice
)
options=(!lto)
source=(
  "$pkgname::git+$url.git#tag=v$pkgver"
  "openconnect-globalprotect::git+https://github.com/yuezk/openconnect.git"
  "git+https://gitlab.gnome.org/GNOME/libxml2.git"
)
b2sums=('3b0a13b1445600d5d88bc73ae9891ff4a27f8187ca30d6a0a6f7917c43a6b986dfc243289ac70ca0c3f668c160546ef850819e4a2fd03ccd3b12cf125db779bb'
        'SKIP'
        'SKIP')

prepare() {
  cd $pkgname
  git submodule init
  git config submodule.crates/openconnect/deps/openconnect.url ../openconnect-globalprotect
  git config submodule.crates/openconnect/deps/libxml2.url ../libxml2
  git -c protocol.file.allow=always submodule update \
    crates/openconnect/deps/openconnect \
    crates/openconnect/deps/libxml2

  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $pkgname
  cargo build --release --frozen
}

check() {
  cd $pkgname
  # Racy: executes a freshly written script while other tests fork, which can
  # fail with ETXTBSY and make the probe fall through to the next candidate.
  cargo test --frozen -- \
    --skip process::gui_launcher::tests::cancellation_stops_a_hung_version_probe_before_other_candidates
}

package() {
  cd $pkgname
  DESTDIR="$pkgdir" make install
}
