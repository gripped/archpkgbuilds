# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-cassetter
pkgver=0.17.0
pkgrel=1
pkgdesc='HTTP cassette recorder for Python tests, powered by Rust'
arch=('x86_64')
url='https://github.com/Kludex/cassetter'
license=('MIT')
depends=('glibc' 'libgcc' 'python' 'zstd')
makedepends=('cargo' 'git' 'python-build' 'python-installer' 'python-maturin')
checkdepends=(
  'python-aiohttp'
  'python-anyio'
  'python-grpcio'
  'python-httpx'
  'python-httpx2'
  'python-primp'
  'python-protobuf'
  'python-pyreqwest'
  'python-pytest'
  'python-pytest-codspeed'
  'python-pytest-xdist'
  'python-requests'
  'python-trio'
  'python-typing_extensions'
  'python-urllib3'
  'python-websockets'
  'python-yaml'
)
optdepends=(
  'python-aiohttp: record and replay aiohttp requests'
  'python-grpcio: record and replay gRPC calls'
  'python-httpx: record and replay HTTPX requests'
  'python-httpx2: record and replay HTTPX2 requests'
  'python-primp: record and replay primp requests'
  'python-pyreqwest: record and replay pyreqwest requests'
  'python-pytest: pytest plugin'
  'python-requests: record and replay Requests requests'
  'python-urllib3: record and replay urllib3 requests'
  'python-websockets: record and replay WebSocket connections'
)
source=("git+https://github.com/Kludex/cassetter.git#tag=v$pkgver")
sha512sums=('afd8e52ada590036a355a4569bced1b2954fde303b486fb5990a62fceb0198ca6c5fc343aff8cf173de65f38139c14563642b4a20ef31585e9d33ce8e5be6b3a')

prepare() {
  cd cassetter
  # Upstream sets the release version when publishing wheels.
  sed -i "s/0\.0\.0/$pkgver/g" Cargo.toml Cargo.lock
  cargo fetch --locked
}

build() {
  cd cassetter
  ZSTD_SYS_USE_PKG_CONFIG=1 python -m build --wheel --no-isolation \
    -C build-args='--frozen --compatibility linux'
}

check() {
  cd cassetter
  ZSTD_SYS_USE_PKG_CONFIG=1 cargo test --workspace --frozen
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd cassetter
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
