pkgbase = dnssec-tools
	pkgdesc = libval & dnssec management tools
	pkgver = 2.2.3
	pkgrel = 17
	url = http://www.dnssec-tools.org
	install = dnssec-tools.install
	arch = x86_64
	license = BSD
	depends = dnsutils
	depends = perl
	depends = perl-timedate
	depends = perl-net-dns
	depends = perl-net-dns-sec
	depends = perl-mailtools
	depends = bind
	depends = openssl
	depends = glibc
	depends = perl-html-parser
	depends = perl-cgi
	optdepends = perl-tk: for GUI components
	optdepends = perl-graphviz: for GUI components
	conflicts = libval
	conflicts = libval_shim
	conflicts = libsres
	options = !emptydirs
	backup = etc/dnssec-tools/dnssec-tools.conf
	backup = etc/dnssec-tools/resolv.conf
	backup = etc/dnssec-tools/root.hints
	backup = etc/dnssec-tools/dnsval.conf
