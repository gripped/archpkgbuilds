pkgname=wordpress
pkgver=7.1.2
pkgrel=1
pkgdesc='Blog tool and publishing platform'
arch=(any)
url='https://wordpress.org/'
license=(GPL-2.0-or-later)
depends=(php-interpreter)
optdepends=('apache: Web server'
            'mariadb: Database server'
            'nginx: Web server')
options=(!debug emptydirs)
install=$pkgname.install
source=("https://wordpress.org/$pkgname-${pkgver%.0}.tar.gz")
sha256sums=('c0c666689d66b870d8825500bb8e402ed04de52602c61a6f516c6236b8c9ac67')
b2sums=('cd261f4e66a225163f5e2a69da04651d15d4fc9f6f2a567f8bd0e41c7b212505e39c0964b8e05f42b206a7133b2da0b7abef2756e696f509fe93ae4577313e26')

package() {
  install -d "$pkgdir/usr/share/webapps"
  cp -r $pkgname "$pkgdir/usr/share/webapps"
}
