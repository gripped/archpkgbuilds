pkgname=wordpress
pkgver=7.1.5
pkgrel=1
pkgdesc='Blog tool and publishing platform'
arch=(any)
url='https://wordpress.org/'
license=(GPL-2.0-or-later)
depends=(php-interpreter)
optdepends=('apache: Web server'
            'mariadb: Database server'
            'nginx: Web server')
options=(!debug emptydirs)
install=$pkgname.install
source=("https://wordpress.org/$pkgname-${pkgver%.0}.tar.gz")
sha256sums=('053857d980eaee8702c617c685948becb9be2523ba0dcbc98e4dbb2300367c79')
b2sums=('cc92f02d7c8c111d6ce765412cc7b58f855434b5cd400f28c66f53b82c8d4f8477b2499c135ffeef22db8e8c4a1b70a8c3ac50716982055270916bef6674c7bc')

package() {
  install -d "$pkgdir/usr/share/webapps"
  cp -r $pkgname "$pkgdir/usr/share/webapps"
}
