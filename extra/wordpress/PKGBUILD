pkgname=wordpress
pkgver=7.0.4
pkgrel=1
pkgdesc='Blog tool and publishing platform'
arch=(any)
url='https://wordpress.org/'
license=(GPL-2.0-or-later)
depends=(php-interpreter)
optdepends=('apache: Web server'
            'mariadb: Database server'
            'nginx: Web server')
options=(!debug emptydirs)
install=$pkgname.install
source=("https://wordpress.org/$pkgname-$pkgver.tar.gz")
sha256sums=('26b99abfc65427fbab52b24315539b944dcef1467899a5256b6c1de2c4ae7e46')
b2sums=('2a96a4e0ea58e463ec4deca2f1e55f27287c339b930289d969525733f5fdbaaaf5059ae6406d902ed31f0bce9db13f1279b0440d14f4f1eeadeeb4de496bb1fa')

package() {
  install -d "$pkgdir/usr/share/webapps"
  cp -r $pkgname "$pkgdir/usr/share/webapps"
}
