pkgname=wordpress
pkgver=7.1.4
pkgrel=1
pkgdesc='Blog tool and publishing platform'
arch=(any)
url='https://wordpress.org/'
license=(GPL-2.0-or-later)
depends=(php-interpreter)
optdepends=('apache: Web server'
            'mariadb: Database server'
            'nginx: Web server')
options=(!debug emptydirs)
install=$pkgname.install
source=("https://wordpress.org/$pkgname-${pkgver%.0}.tar.gz")
sha256sums=('881e53a4681ff2cd911651b11cccdede5ae477ddf0765af5d6a1a8b219a1d835')
b2sums=('ec9fe376c944db5505ed73b528c6d725b53ed471f8b1d535c6ed1e4db41faeea8f72d26cdcb87928b18ce3a666767978f38859d601caea33ad3fe2eec119aed7')

package() {
  install -d "$pkgdir/usr/share/webapps"
  cp -r $pkgname "$pkgdir/usr/share/webapps"
}
