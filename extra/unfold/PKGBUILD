# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=unfold
pkgver=1.0.5
pkgrel=1
pkgdesc='Archive manager for Linux desktops'
arch=(any)
url='https://github.com/xapp-project/unfold'
license=(GPL-3.0-or-later)
groups=(x-apps)
depends=(
  7zip
  gdk-pixbuf2
  glib2
  gtk3
  hicolor-icon-theme
  pango
  python
  python-gobject
  python-setproctitle
  python-xapp
)
makedepends=(
  git
  meson
)
source=("git+https://github.com/xapp-project/unfold.git#tag=$pkgver")
b2sums=(4e3af01b46c3db4f06b5e5b2a9868cf9303c0efa3f491fc3d958451e8150144e480d997b67ee03259d93ddc4e5a34029e3de28cf91b7aab39803a90b8cadb15c)

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
