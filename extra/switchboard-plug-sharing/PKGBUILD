# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=switchboard-plug-sharing
pkgver=8.0.3
pkgrel=3
pkgdesc='Switchboard Sharing Plug'
arch=(x86_64)
url=https://github.com/elementary/switchboard-plug-sharing
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  glib2
  glibc
  gnome-settings-daemon
  gtk4
  libadwaita
  libgee
  libgranite-7.so
  libswitchboard-3.so
  pantheon-bluetooth-daemon
  rygel
)
makedepends=(
  git
  meson
  vala
)
source=(git+https://github.com/elementary/switchboard-plug-sharing.git#tag=${pkgver})
b2sums=('34824f57d4dbc9fe68502374c85fa3ecad2b09c567fa4c5427b9d7cd1c4b2ed92fbd87a400167755098321804fedf5f67d98c4e351b725e06331f00212953199')

build() {
  arch-meson switchboard-plug-sharing build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}

