# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=cargo-psp
pkgver=0.2.9
pkgrel=1
pkgdesc='cargo build wrapper for creating Sony PSP executables'
url='https://github.com/overdrivenpotato/rust-psp'
arch=('x86_64')
license=('MIT')
depends=(
  'cargo'
  'glibc'
  'libgcc'
)
source=("${pkgname}-${pkgver}.tar.gz::https://static.crates.io/crates/${pkgname}/${pkgver}/download")
sha256sums=('acf9360909360d639034fc22f1c1957b3e2a507d8a04804c20508c8024d4a1ae')

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target host-tuple
}

build() {
  cd "${pkgname}-${pkgver}"
  CFLAGS+=' -ffat-lto-objects'
  cargo build --frozen --release
}

check() {
  cd "${pkgname}-${pkgver}"
  cargo test --frozen
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm 755 -t "${pkgdir}/usr/bin" \
    target/release/{cargo-psp,mksfo,pack-pbp,prxgen,prxmin}
}

# vim: ts=2 sw=2 et:
