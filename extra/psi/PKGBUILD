# Maintainer: Sergej Pupykin <arch+pub@sergej.pp.ru>

pkgname='psi'
pkgver=1.6_b1
pkgrel=2
pkgdesc="Powerful XMPP (Jabber) client (Qt, C++) designed for power users"
url="https://psi-im.org"
license=('GPL-2.0-only')
arch=('x86_64')
depends=('zlib' 'openssl' 'hunspell' 'minizip'
	 'libomemo-c' 'libusrsctp' 'libx11' 'libxss'
	 'qt6-multimedia' 'qt6-webengine' 'qca-qt6' 'qt6-svg' 'qtkeychain-qt6')
makedepends=('cmake' 'git')
provides=("psi-nowebengine=$pkgver")
conflicts=('psi-nowebengine')
replaces=('psi-nowebengine')
source=("git+https://github.com/psi-im/psi.git#tag=$pkgver")
sha256sums=('eb25695f5e1d30b36f97bdcb6f6facc07358e0fadcc4649c1ddebdd8a54cccd7')

prepare() {
  cd psi
  git submodule update --init
}

build() {
  mkdir -p build

  cmake -B build -S psi \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DQT_DEFAULT_MAJOR_VERSION=6 \
    -DCHAT_TYPE=WEBENGINE
  cmake --build build -j1
}

package_psi() {
  DESTDIR="$pkgdir" cmake --install build
  install -dm755 "$pkgdir/usr/include/psi/plugins"
  install -m644 psi/plugins/include/*.h "$pkgdir/usr/include/psi/plugins"
  install -Dm644 psi/linux/psi.appdata.xml "$pkgdir/usr/share/metainfo/$pkgname.appdata.xml"
}
