pkgname=wingpanel-indicator-sound
pkgver=8.0.3
pkgrel=1
pkgdesc='Wingpanel Sound Indicator'
arch=(x86_64)
url=https://github.com/elementary/wingpanel-indicator-sound
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  cairo
  dconf
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  libcanberra
  libgee
  libgranite.so
  libnotify
  libpulse
  libwingpanel.so
)
makedepends=(
  git
  gobject-introspection
  intltool
  meson
  vala
)
_tag=8114866d425043e7e77ffc942edfb76493550c15
source=(wingpanel-indicator-sound::git+https://github.com/elementary/wingpanel-indicator-sound.git#tag=${_tag})
b2sums=('215edcea9b0edbb0b0879b2baa78c12828e985c3dfe7fa372af4cbf33dade1c3b0595787fa10b0003ed0b410f16f3a708c6a4c1e541745f5228130c88734cafb')

pkgver() {
  cd wingpanel-indicator-sound
  git describe --tags
}

build() {
  arch-meson wingpanel-indicator-sound build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}

