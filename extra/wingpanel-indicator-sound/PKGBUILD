# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=wingpanel-indicator-sound
pkgver=8.0.3
pkgrel=3
pkgdesc='Wingpanel Sound Indicator'
arch=(x86_64)
url=https://github.com/elementary/wingpanel-indicator-sound
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  dconf
  gdk-pixbuf2
  glib2
  glibc
  gnome-settings-daemon
  granite7
  gtk4
  libcanberra
  libgee
  libnotify
  libpulse
  wingpanel
)
makedepends=(
  git
  meson
  vala
)
source=(git+https://github.com/elementary/wingpanel-indicator-sound.git#tag=${pkgver})
b2sums=('215edcea9b0edbb0b0879b2baa78c12828e985c3dfe7fa372af4cbf33dade1c3b0595787fa10b0003ed0b410f16f3a708c6a4c1e541745f5228130c88734cafb')

prepare() {
  cd wingpanel-indicator-sound

  # Update for GTK4 port
  git cherry-pick -n 8.0.3..73168adb7556eee7cf82ba4c45f35fcb9ac9b909
}

build() {
  arch-meson wingpanel-indicator-sound build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}
