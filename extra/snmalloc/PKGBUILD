# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=snmalloc
pkgver=0.7.5
pkgrel=1
pkgdesc="Message passing based allocator"
arch=(x86_64)
url="https://github.com/microsoft/snmalloc/"
license=(MIT)
depends=(
  glibc
  libgcc
)
makedepends=(cmake)
source=("$pkgname-$pkgver.tar.gz::${url}archive/refs/tags/$pkgver.tar.gz")
sha512sums=('5852cdafdae484b7af71af1c44a8451f80c59294ca2ac582e3c22b4727d2241cb344d4361a08573c39c730725835e37f79095355e2a859f17b558e39a2f7e322')
b2sums=('5de110bad96e50f720daee20be4983639f23961bff7267bce0e59de1a186b8b4043dfbeca82b99e49c2e948d5d627efe480c4b67829c4011df69601c588c7d90')

build() {
  local cmake_options=(
    -B build
    -S "$pkgname-$pkgver"
    -W no-dev
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
  )
  cmake "${cmake_options[@]}"
  cmake --build build --verbose
}

check() {
  local excluded_tests=""
  local ctest_flags=(
    --test-dir build
    # show the stdout and stderr when the test fails
    --output-on-failure
    # execute tests in parallel
    --parallel "$(nproc)"
    # exclude problematic tests
    --exclude-regex "$excluded_tests"
  )
  ctest "${ctest_flags[@]}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -vDm 644 $pkgname-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
