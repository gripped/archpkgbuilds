# Maintainer: Giovanni Harting <anonfunc@archlinux.org>

pkgname=python-smpclient
_name=${pkgname#python-}
pkgver=7.3.0
pkgrel=1
pkgdesc='Simple Management Protocol (SMP) client for remotely managing MCU firmware'
arch=(any)
url='https://github.com/intercreate/smpclient'
license=(Apache-2.0)
depends=(
  python
  python-intelhex
  python-pydantic
  python-pydantic-core
  python-smp
  python-typing_extensions
)
makedepends=(
  git
  python-build
  python-hatch-vcs
  python-hatchling
  python-installer
)
checkdepends=(
  python-bleak
  python-pyserial
  python-pytest
  python-pytest-asyncio
)
optdepends=(
  'python-bleak: Bluetooth LE transport'
  'python-pyserial: serial transport'
)
source=("git+$url.git#tag=$pkgver")
b2sums=('7cd51250be9dcf1987ea9d64258903fbc7c94ea834a30f237087ffdaa51f779f29f64829904bdbc961a03f3d3ceec4ac09aaa90b183f39179d596c502b4579ae')

build() {
  cd $_name
  python -m build --wheel --no-isolation
}

check() {
  cd $_name
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  # the bumble transport needs python-bumble, which is not packaged
  test-env/bin/python -m pytest --ignore=tests/test_smp_bumble_transport.py
}

package() {
  cd $_name
  python -m installer --destdir="$pkgdir" dist/*.whl
  # entry point for the bumble transport, see check()
  rm "$pkgdir"/usr/bin/smpbumble
}

# vim:set ts=2 sw=2 et:
