            'SKIP'
            '7b382b38fb72e037932343c52dae7a1bd6f416e7af3972301ec40827cc151183152e658f071fd83a6092e3c783c0b0c277e0527e2e4ed7b389f159f66abd92bc')
sha512sums_x86_64=('759c7f37d121cc7dbc4e691be83aa2341ee5c65080388bf8149c93e362d2e9801194c690e29283822d8d68b85bad613266c6a9343e85bfa571e4cb6f72e21d06')
b2sums=('a1d10f1b4422f55c9c87fec0d319fd3dfaf8992f40f9c3d6da1d74e6e78ef220c24cdcd5b689070fb4a287070d1cb3659dc9ea79e5500027854f32c1326c67f7'
        'SKIP'
