# Contributor: Benoît Allard <benoit dot allard at gmx dot de>
# Contributor: killruana <killruana@gmail.com>

pkgname=yosys
pkgver=0.59
pkgrel=1
pkgdesc='A framework for RTL synthesis'
arch=('x86_64')
url='https://yosyshq.net/yosys/'
license=('ISC')
depends=('abc' 'bash' 'glibc' 'libffi' 'libgcc' 'python' 'protobuf' 'readline' 'tcl' 'zlib' 'libstdc++')
makedepends=('boost' 'git' 'pybind11' 'python-cxxheaderparser')
checkdepends=('iverilog' 'gtkwave')
optdepends=('graphviz: Schematics display support'
            'xdot: Display netlists'
            'yices: default solver for yosys-smtbmc'
            'cvc4: alternative solver for yosys-smtbmc'
            'z3: alternative solver for yosys-smtbmc')
options=('!lto') # getting SIGSEGV when running the tests with LTO
source=(git+https://github.com/YosysHQ/yosys#tag=v$pkgver
        git+https://github.com/jarro2783/cxxopts)
sha512sums=('18cf623ea061786c93b0981a28bd4a2100e78afc610ee78c2476ec2a8019a70e10d14de276fcd194aa8a7048e2aab03b7fdd814593f15bafba0c5d526c2de0f8'
            'SKIP')

prepare() {
  cd yosys
  git submodule init
  git submodule set-url libs/cxxopts "$srcdir"/cxxopts
  git -c protocol.file.allow=always submodule update libs/cxxopts

  # Fix pyosys wrapper generation with nested SigSpec::Chunks on 0.59.
  git cherry-pick -n e29328ec99e6b8a3cc5bd60c169ebed47f1b279c

  sed -e '/cp yosys-abc/d' -i Makefile # Fix Makefile trying to install yosys-abc even if using system one
}

_make() {
    make \
        PREFIX="/usr" \
        CONFIG=gcc \
        LINKFLAGS="$LDFLAGS -rdynamic" \
        ENABLE_TCL=1 \
        ENABLE_ABC=1 \
        ENABLE_GLOB=1 \
        ENABLE_PLUGINS=1 \
        ENABLE_LIBYOSYS=1 \
        ENABLE_PROTOBUF=1 \
        ENABLE_ZLIB=1 \
        ENABLE_PYOSYS=1 \
        ABCEXTERNAL=/usr/bin/abc \
        PYOSYS_USE_UV=0 $@
}

build() {
    cd $pkgname
    _make
}

check() {
    cd $pkgname
    _make test
}

package() {
    cd $pkgname
    _make DESTDIR="$pkgdir" PYTHON_PREFIX="$pkgdir/usr" install

    install -Dm644 COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}
