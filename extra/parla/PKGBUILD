# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=parla
pkgver=0.3.0
pkgrel=1
pkgdesc="Native Gnome DeltaChat client"
arch=(x86_64)
url="https://github.com/trufae/parla"
license=(GPL-3.0-or-later)
depends=(
  deltachat-rpc-server
  gdk-pixbuf2
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  json-glib
  libadwaita
  pango
)
makedepends=(
  meson
  vala
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
sha512sums=('e968111ed3557f48bbec03d6ce177b536686118fee1916c1687f79d96ee6b02d8f08ea8223f82f94564ac8cb0766fc3b290cc5cdae84725f0f81ea47e4141642')
b2sums=('0fbc1038459fcc0c3fc92edbc42509a7532bacfa611dee1fada63d507d73cd92e36ba0ef79e78c6b031fec33303ce94f8daba53679bef52a4e841229d82b4456')

build() {
  arch-meson build $pkgname-$pkgver
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgname-$pkgver/README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
