# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=parla
pkgver=0.9.8
pkgrel=1
pkgdesc="Native Gnome DeltaChat client"
arch=(x86_64)
url="https://github.com/trufae/parla"
license=(GPL-3.0-or-later)
depends=(
  deltachat-rpc-server
  gdk-pixbuf2
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  json-glib
  libgcc
  libadwaita
  libsoup3
  pango
  webkitgtk-6.0
)
makedepends=(
  meson
  vala
)
optdepends=(
  'python-openai-whisper: for voice message transcribing'
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
sha512sums=('e3eef3a2e9dfd403686e102d5987e3bf7042cc79d9f733fa63a9e3182193522c838db2ec585937e892da0e8d5b9e200daf0607d9ae6904e0dfef0e416dc6125c')
b2sums=('1ea9bba15889464928e823e91d04f64b49aecc48c96156334cd7bf1a046991ddebd8917ab86f726772342c821e8f34073587aa9b2adf197ad3f1ccfb3fe7678f')

build() {
  arch-meson build -D webxdc=true $pkgname-$pkgver
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgname-$pkgver/README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
