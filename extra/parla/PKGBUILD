# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=parla
pkgver=0.8.0
pkgrel=1
pkgdesc="Native Gnome DeltaChat client"
arch=(x86_64)
url="https://github.com/trufae/parla"
license=(GPL-3.0-or-later)
depends=(
  deltachat-rpc-server
  gdk-pixbuf2
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  json-glib
  libadwaita
  libsoup3
  pango
  webkitgtk-6.0
)
makedepends=(
  meson
  vala
)
optdepends=(
  'python-openai-whisper: for voice message transcribing'
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
sha512sums=('58b7506b13bf559ac6ce494e458d0bbf8993dca6dae57ccf1d2d059e43289913997f0dda9361519f5e7867f49f64506a3ba7f67b71a6b2bc65f92e5228dbd52e')
b2sums=('65bc0804bb40d4f56a561fd4204823874a3292e63d689d2991849bfdcdc9641dd5e7504fab4d8079ed2fdff259ba81b9936084c3db993261730ec74102a01ce6')

build() {
  arch-meson build -D webxdc=true $pkgname-$pkgver
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgname-$pkgver/README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
