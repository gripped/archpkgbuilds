# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=parla
pkgver=0.7.8
pkgrel=1
pkgdesc="Native Gnome DeltaChat client"
arch=(x86_64)
url="https://github.com/trufae/parla"
license=(GPL-3.0-or-later)
depends=(
  deltachat-rpc-server
  gdk-pixbuf2
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  json-glib
  libadwaita
  libsoup3
  pango
  webkitgtk-6.0
)
makedepends=(
  meson
  vala
)
optdepends=(
  'python-openai-whisper: for voice message transcribing'
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
sha512sums=('277e6d2dec94efa1dafc73ae946cf62951a6a9fda848f7e696cfb7ff83061b316dacaf26f3841fea1d9596790b4eacb9a3c17c630da0135d7f486d27d7ea0501')
b2sums=('dee68b0e49566ee3063fe42e153ca2caafffa73cbc64ddbe1c6292a572b8ec228cc0f49ca657bd91440c51e3acb3793e66dc76a2893583da64bf78228b00374a')

build() {
  arch-meson build -D webxdc=true $pkgname-$pkgver
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgname-$pkgver/README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
