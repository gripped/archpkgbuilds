# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=parla
pkgver=0.6.4
pkgrel=1
pkgdesc="Native Gnome DeltaChat client"
arch=(x86_64)
url="https://github.com/trufae/parla"
license=(GPL-3.0-or-later)
depends=(
  deltachat-rpc-server
  gdk-pixbuf2
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  json-glib
  libadwaita
  pango
)
makedepends=(
  meson
  vala
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
sha512sums=('18c6a7f78d803bfe207a541a70ae30e194af086a0b9d29cac8f0fa6bd869ec3c185daa02211bfa2a2fad82c988f64138b02013a30da04c8b738496d84fab5746')
b2sums=('22e39ccca048ba1c0506cf874b0935f32842d8e8c280e58128fd712ff0e6ebcf5d2a6cc8c6db9194e0a5ba675a6390452aa2e93cdc65bd74e7dc71ddd7c042dd')

build() {
  arch-meson build $pkgname-$pkgver
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgname-$pkgver/README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
