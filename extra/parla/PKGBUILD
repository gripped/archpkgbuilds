# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=parla
pkgver=0.7.2
pkgrel=2
pkgdesc="Native Gnome DeltaChat client"
arch=(x86_64)
url="https://github.com/trufae/parla"
license=(GPL-3.0-or-later)
depends=(
  deltachat-rpc-server
  gdk-pixbuf2
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  json-glib
  libadwaita
  pango
)
makedepends=(
  meson
  vala
)
optdepends=(
  'python-openai-whisper: for voice message transcribing'
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
sha512sums=('f7ee53731e01b69f29a2edeb217c13b687b16f5cc3f6f24962e640de2c7d521a00c5a5625a349c4e3dfe7dd087f12549aa72d4db32e021f0541cc6a44fd8250c')
b2sums=('6b22bfcd58931c0f273dfd8629c517453bdebe27d0d8c06928cbbf942ad2daa5a0b1c5056109e88be91f0c6eef140dfb7f6978f7c272555e26d3965ef4fcd5cc')

build() {
  arch-meson build $pkgname-$pkgver
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgname-$pkgver/README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
