# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=parla
pkgver=0.8.2
pkgrel=1
pkgdesc="Native Gnome DeltaChat client"
arch=(x86_64)
url="https://github.com/trufae/parla"
license=(GPL-3.0-or-later)
depends=(
  deltachat-rpc-server
  gdk-pixbuf2
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  json-glib
  libgcc
  libadwaita
  libsoup3
  pango
  webkitgtk-6.0
)
makedepends=(
  meson
  vala
)
optdepends=(
  'python-openai-whisper: for voice message transcribing'
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
sha512sums=('1bd9cf783ace70575edab72f13e5e4c07be5a814c7862b926a1af9272eabf80a04316c93326c4202bac9a7e484f87ef737c8fd13e26c0eccaba1d6e6458c11be')
b2sums=('a4a6a1c7fd9da614834e95650e4f3101750718f22abfb2642e83054534c2191c9358362ee9c4958275d84238db0583980b3cd66bcbfedbf5c5d021ec044894ec')

build() {
  arch-meson build -D webxdc=true $pkgname-$pkgver
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgname-$pkgver/README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
