pkgname=python-requests-cache
pkgver=1.3.2
pkgrel=1
pkgdesc='Persistent HTTP cache for python requests'
arch=(any)
url='https://github.com/requests-cache/requests-cache'
license=(BSD-2-Clause)
depends=(
  python
  python-requests
  python-urllib3
  python-attrs
  python-cattrs
  python-platformdirs
  python-url-normalize
)
makedepends=(
  git
  python-build
  python-installer
  python-hatchling
)
checkdepends=(
  python-pytest
  python-requests-mock
  python-rich
  python-pymongo
  python-responses
  python-redis
  python-tenacity
)
optdepends=(
  'python-boto3: DynamoDB support'
  'python-botocore: DynamoDB support'
  'python-pymongo: MongoDB support'
  'python-redis: Redis support'
)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('671603bb6a4648e91a442a463c552d7a95e0d532a0c8f6b60c4af974693523e8182c971a62987d2dd9a053c368481f0787a4673d7e4532414cc4ede2ee32cf47')
b2sums=('92b03cf765026e143cb008ef6333955bc7ce41ffd723a61368a0215aa88a0d83b3e75fd03bb43cd815e6f6483ecfde47fa4e03a0492f8f865749fc67193d82bd')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

#check() {
#  cd "$pkgname"
#
#  pytest -v
#}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
