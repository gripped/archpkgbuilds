# Maintainer: Anatol Pomozov <anatol.pomozov@gmail.com>
# Contributor: Jonne Haß <me@jhass.eu>

pkgbase='crystal'
pkgname=(
  'crystal'
  'crystal-docs'
)
pkgver=1.20.2
pkgrel=1
pkgdesc='The Crystal Programming Language'
arch=(x86_64)
url='https://crystal-lang.org'
license=(Apache-2.0)
depends=(
  'gc'
  'pcre2'
  'libevent'
  'llvm-libs'
)
makedepends=(
  'libxml2'
  'llvm'
  'crystal'  # to compile version N we need crystal compiler of N-1 version
)
checkdepends=(
  'libyaml'
  'libxml2'
  'gmp'
  'inetutils'
  'git'
)
optdepends=(
  'shards: crystal language package manager'
  'libyaml: For YAML support'
  'gmp: For BigInt support'
  'libxml2: For XML support'
)
source=(
  "crystal-${pkgver}.tar.gz::https://github.com/crystal-lang/crystal/archive/${pkgver}.tar.gz"
)
sha256sums=('68b69b844bf3bf9990cb7befb06520fc477bb6c3f42de833c6b6a80dd5d0b17c')

prepare() {
  cd "${pkgbase}-${pkgver}"
}

build() {
  cd "${pkgbase}-${pkgver}"

  make release=1 interpreter=1 progress=1 \
       FLAGS="--release --no-debug -Dpreview_mt" \
       CRYSTAL_CONFIG_PATH="lib:/usr/lib/crystal" \
       CRYSTAL_CACHE_DIR="/tmp/crystal"

  make docs CRYSTAL_CACHE_DIR="/tmp/crystal"
}

check() {
  cd "${pkgbase}-${pkgver}"

  return  # tests require too much RAM, disable it temporary

  make spec CRYSTAL_CACHE_DIR="/tmp/crystal"
}


# /usr/bin/crystal                compiled executable
# /usr/lib/crystal/               compiler src & core libs
# /usr/share/doc/crystal/api      api docs
# /usr/share/doc/crystal/samples/ samples

package_crystal() {
  cd "${pkgbase}-${pkgver}"

  install -Dm755 ".build/crystal" "${pkgdir}/usr/bin/crystal"

  install -dm755 "${pkgdir}/usr/lib" "${pkgdir}/usr/share/man/man1"
  cp -r src "${pkgdir}/usr/lib/crystal"

  install -Dm644 man/crystal.1 "${pkgdir}/usr/share/man/man1/"

  install -Dm644 etc/completion.bash "${pkgdir}/usr/share/bash-completion/completions/crystal"
  install -Dm644 etc/completion.zsh "${pkgdir}/usr/share/zsh/site-functions/_crystal"
  install -Dm644 etc/completion.fish "${pkgdir}/usr/share/fish/vendor_completions.d/crystal.fish"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

package_crystal-docs() {
  pkgdesc+=' (documentation)'
  depends=()
  optdepends=()

  cd "${pkgbase}-${pkgver}"

  install -dm755 "${pkgdir}/usr/share/doc/crystal"
  cp -r docs "${pkgdir}/usr/share/doc/crystal/api"
  cp -r samples "${pkgdir}/usr/share/doc/crystal/"
}
