# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-http-snapshot
pkgver=0.1.9
pkgrel=1
pkgdesc="Pytest plugin for snapshotting requests made with Python HTTP clients"
arch=('any')
url="https://github.com/karpetrosyan/http-snapshot"
license=('MIT')
depends=('python' 'python-inline-snapshot' 'python-pytest')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-anyio' 'python-httpx' 'python-requests')
optdepends=(
  'python-httpx: HTTPX integration'
  'python-requests: Requests integration'
)
source=("git+https://github.com/karpetrosyan/http-snapshot.git#tag=$pkgver")
sha256sums=('f08930a4b56bacde1fd71b6f4cebe9cddc57c1c9681aa50c69c4b0da3fe0ba2b')

build() {
  cd http-snapshot
  python -m build --wheel --no-isolation
}

check() {
  cd http-snapshot
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd http-snapshot
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
