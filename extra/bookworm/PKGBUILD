pkgname=bookworm
pkgver=1.1.2
_commit=91755a5cdd14d334f403cb4118e9e89285c126a3
pkgrel=9
pkgdesc='A simple user centric eBook reader which displays multiple eBooks formats uniformly'
url='https://babluboy.github.io/bookworm'
arch=(x86_64)
license=(GPL-3.0-or-later)
depends=(
  bash
  dconf
  gdk-pixbuf2
  glib2
  glibc
  granite
  gtk3
  hicolor-icon-theme
  libgee
  libxml2
  pango
  poppler-glib
  python
  python-html2text
  sqlite
  webkit2gtk-4.1
)
makedepends=(
  git
  meson
  ninja
  vala
)
optdepends=('dictd: Dictionary lookup')
source=(
  "git+https://github.com/babluboy/bookworm.git#commit=$_commit"
  bookworm-html2text.patch
  bookworm-dict.patch
)
b2sums=('3da9bf30290a430378658f00a31a36f211d2ed9400285d7262bc2f2a966a9e1afff5b5fe63929c2d6608a63e8874207c897ef70391dfbe643f4a78c2ac7dd9e7'
        '50b0f462fbef05d53143236ed0533a2cc9e407d8dab5a0d714ea82c7cdc551ca293399b0860882ae3771bf9fc5006aff55c5b71a413e85566bd8d2e9116c9e43'
        'cb176650c14f5e2c0a65d18659849902cdf56db8cf0bb9f18e957a297dcc0efb7e4641a78b31f6ea39a658dcd105686fd8a858849cecc3f7160d2e7f43240248')

prepare() {
  cd bookworm

  # Remove generated python bytecode files
  rm data/scripts/mobi_lib/*.pyc

  # python-html2text has no -utf8 parameter
  git apply -3 ../bookworm-html2text.patch

  # Use dict for dictionary lookup
  git apply -3 ../bookworm-dict.patch
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  ln -s com.github.babluboy.bookworm "$pkgdir/usr/bin/$pkgname"

  python -m compileall -d /usr/share "$pkgdir/usr/share"
  python -O -m compileall -d /usr/share "$pkgdir/usr/share"
}
