prepare() {
  cd bookworm

  # Remove generated python bytecode files
  rm data/scripts/mobi_lib/*.pyc

  # Fix print statements for Python 3 compatibility
  # https://github.com/babluboy/bookworm/pull/368
  git apply -3 ../bookworm-python3.patch

  # Switch from webkit2gtk 4.0 to 4.1
  # https://github.com/babluboy/bookworm/pull/391
  git apply -3 ../bookworm-webkitgtk4.1.patch

  # Fix book loading and library tracking
  # https://github.com/babluboy/bookworm/pull/409
  git apply -3 ../bookworm-fix-arguments.patch

  # Handle invalid UTF-8 in book content
  # https://github.com/babluboy/bookworm/pull/410
  git apply -3 ../bookworm-fix-unicode.patch

  # Fix EPUB cover image detection
  # https://github.com/babluboy/bookworm/pull/411
  git apply -3 ../bookworm-fix-epub-cover.patch

  # Fix JavaScript result retrieval
  # https://github.com/babluboy/bookworm/pull/412
  git apply -3 ../bookworm-fix-webview-scroll.patch

  # Replace deprecated imghdr module
  # https://github.com/babluboy/bookworm/pull/414
  git apply -3 ../bookworm-no-imghdr.patch

  # python-html2text has no -utf8 parameter
  git apply -3 ../bookworm-html2text.patch

  # Use dict for dictionary lookup
  git apply -3 ../bookworm-dict.patch

  # Use bsdtar to extract CBR and CBZ archives
  git apply -3 ../bookworm-bsdtar.patch
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  ln -s com.github.babluboy.bookworm "$pkgdir/usr/bin/$pkgname"

  python -m compileall -d /usr/share "$pkgdir/usr/share"
  python -O -m compileall -d /usr/share "$pkgdir/usr/share"
}
