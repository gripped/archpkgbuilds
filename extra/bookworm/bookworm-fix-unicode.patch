From 4d5ccb353640fbb384a1ae1a5a6dbaeaf6816a78 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ball=C3=B3=20Gy=C3=B6rgy?= <ballogyor@gmail.com>
Date: Thu, 5 Nov 2026 15:50:23 +0100
Subject: [PATCH] Handle invalid UTF-8 in book content

Ensure that loaded book content contains valid UTF-8 before
processing HTML elements and their attributes.

This prevents regular expression operations from failing
when the source content contains invalid UTF-8 sequences.
---
 src/contentHandler.vala | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/contentHandler.vala b/src/contentHandler.vala
index 74f35ce8..afe66342 100644
--- a/src/contentHandler.vala
+++ b/src/contentHandler.vala
@@ -80,6 +80,8 @@ public class BookwormApp.contentHandler {
                 }
                 //fetch content from extracted book
                 contents.assign (BookwormApp.Utils.fileOperations ("READ_FILE", bookLocationToRead, "", ""));
+                //ensure the HTML content contains valid UTF-8
+                contents.assign (contents.str.make_valid ());
                 //find list of relative urls with src, href, etc and convert them to absolute ones
                 foreach (string tagname in BookwormApp.Constants.TAG_NAME_WITH_PATHS) {
                     string[] srcList = BookwormApp.Utils.multiExtractBetweenTwoStrings (contents.str, tagname, "\"");
