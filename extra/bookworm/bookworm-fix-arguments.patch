From e0d575b2989967dbfeeed25042721b5654546b65 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ball=C3=B3=20Gy=C3=B6rgy?= <ballogyor@gmail.com>
Date: Thu, 5 Nov 2026 15:45:42 +0100
Subject: [PATCH] Fix book loading and library tracking

Fix command-line book argument handling by excluding the
application executable from the list of book paths.

Preserve loaded book paths when updating the paginated
library view to prevent already loaded books from being
added again.
---
 src/bookworm.vala | 3 +--
 src/library.vala  | 6 ++----
 2 files changed, 3 insertions(+), 6 deletions(-)

diff --git a/src/bookworm.vala b/src/bookworm.vala
index d752d94b..f74ba0a1 100644
--- a/src/bookworm.vala
+++ b/src/bookworm.vala
@@ -257,8 +257,7 @@ public class BookwormApp.Bookworm : Granite.Application {
             info ("Book (s) to be added/opened based on command line parameters. Size of command line attributes:" + 
                 commandLineArgs.length.to_string ()
             );
-            pathsOfBooksToBeAdded = new string[commandLineArgs.length];
-            pathsOfBooksToBeAdded = commandLineArgs;
+            pathsOfBooksToBeAdded = commandLineArgs[1:commandLineArgs.length];
             //Display the progress bar
             BookwormApp.AppWindow.bookAdditionBar.show ();
             isBookBeingAddedToLibrary = true;
diff --git a/src/library.vala b/src/library.vala
index b4f3297a..523c4160 100644
--- a/src/library.vala
+++ b/src/library.vala
@@ -533,7 +533,7 @@ public class BookwormApp.Library {
             //If only one book is being added, complete parsing and adding the book, 
             //so that it will be added to the BookwormApp.Bookworm.libraryViewMap and opened on the
             //BookwormApp.contentHandler.performStartUpActions method
-            if (BookwormApp.Bookworm.pathsOfBooksToBeAdded.length > 2) {
+            if (BookwormApp.Bookworm.pathsOfBooksToBeAdded.length > 1) {
                 Idle.add (addBooksToLibrary.callback);
             }
             BookwormApp.Bookworm.noOfBooksAddedFromCommand++;
@@ -548,7 +548,7 @@ public class BookwormApp.Library {
             //If only one book is being added, complete parsing and adding the book, 
             //so that it will be added to the BookwormApp.Bookworm.libraryViewMap and opened on the
             //BookwormApp.contentHandler.performStartUpActions method
-            if (BookwormApp.Bookworm.pathsOfBooksToBeAdded.length > 2) {
+            if (BookwormApp.Bookworm.pathsOfBooksToBeAdded.length > 1) {
                 yield;
             }
             //ignore the first command which is the application name
@@ -673,8 +673,6 @@ public class BookwormApp.Library {
                     BookwormApp.AppWindow.library_table_liststore.remove (iterToBeRemoved);
                 #endif
             }
-            //Clear the paths of the loaded books
-            BookwormApp.Bookworm.pathsOfBooksInLibraryOnLoadStr.erase (0, -1);
             //Update the library view
             BookwormApp.Library.updateLibraryViewFromDB ();
         }
