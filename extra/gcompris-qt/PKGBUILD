pkgname=gcompris-qt
pkgver=26.1
pkgrel=1
pkgdesc='Educational software suite comprising of numerous activities for children aged 2 to 10'
arch=(x86_64)
url='https://gcompris.net/'
license=(AGPL-3.0-only)
depends=(
  glibc
  hicolor-icon-theme
  libgcc
  libstdc++
  qml-box2d
  qt6-base
  qt6-charts
  qt6-declarative
  qt6-graphs
  qt6-imageformats
  qt6-multimedia
  qt6-sensors
  qt6-svg
)
makedepends=(
  cmake
  extra-cmake-modules
  git
  kdoctools
  ninja
  qt6-tools
)
source=("git+https://invent.kde.org/education/gcompris.git#tag=V$pkgver")
b2sums=(7374056bbf14ee10a4afeaf153b716c345656d26b49c51c03b8917ac8558de48044e9b47844a1d89177c70dba04157abae3e9d7a333d5347bb04a694a8bafc1d)
validpgpkeys=(D2FAAB621F618D42685B427B63D7264C05687D7E) # Timothée Giet <animtim@gmail.com>

prepare() {
  cd gcompris
}

build() {
  cmake -S gcompris -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D COMPILE_DOC=ON \
    -D QML_BOX2D_LIBRARY=/usr/lib/qt6/qml/Box2D
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
