# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-qh3
pkgver=2.1.0
pkgrel=1
pkgdesc="QUIC and HTTP/3 implementation"
arch=('x86_64')
url="https://github.com/jawah/qh3"
license=('BSD-3-Clause')
depends=('glibc' 'libgcc' 'python')
makedepends=('cargo' 'clang' 'cmake' 'git' 'python-build' 'python-installer' 'python-maturin')
checkdepends=('python-brotli' 'python-cryptography' 'python-dnspython' 'python-pyarrow' 'python-pytest' 'python-pytest-asyncio' 'python-pytest-mock')
# GCC LTO objects lose AWS-LC symbols when linked by Rust.
# https://github.com/rust-lang/rust/issues/138681
options=('!lto')
source=("git+https://github.com/jawah/qh3.git#tag=v$pkgver")
sha256sums=('1b2169b77dc3c2cd29fa737643ffc71017f32d6e50c7a1cd3adddc99afb81088')

prepare() {
  cd qh3
  # The Maturin cap only preserves Python 3.13t wheel support.
  # https://github.com/jawah/qh3/commit/a241a5f91cd447333f2a2c14367e8fa835d9bced
  sed -i 's/maturin>=1.2,<1.14/maturin>=1.2,<2/' pyproject.toml
  cargo fetch --locked
}

build() {
  cd qh3
  python -m build --wheel --no-isolation -C build-args='--frozen --compatibility linux'
}

check() {
  cd qh3
  cargo test --frozen --no-default-features
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  # Keep the installed wheel ahead of the source tree during test imports.
  # pytest-asyncio treats the unset upstream default as an error.
  test-env/bin/python -P -m pytest --import-mode=append \
    -o asyncio_default_fixture_loop_scope=function
}

package() {
  cd qh3
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
