+DataManagementStatus data_management_parse_query_conditions(DataManagementSession* session, const char* request,
+                                                      char** result) {
+    auto* dataManagementSession = reinterpret_cast<datamanagement::_DataManagementSession*>(session);
+    if (!dataManagementSession) {
+        return STATUS_SESSION_ERROR;
+    }
+
+    if (!request || !result) {
+        return STATUS_PARAM_ERROR;
+    }
+
+    std::string entitiesResult;
+    DataManagementStatus status = dataManagementSession->parseQueryConditions(request, entitiesResult);
+    if (!status.success) {
+        return status;
+    }
+
+    size_t length = entitiesResult.size() + 1;
+    *result = new char[length];
+    std::strcpy(*result, entitiesResult.c_str());
+    return status;
+}
+
+DataManagementStatus data_management_natural_language_search(DataManagementSession* session, const char* request,
+                                                             char** result) {
+    auto* dataManagementSession = reinterpret_cast<datamanagement::_DataManagementSession*>(session);
+    if (!dataManagementSession) {
+        return STATUS_SESSION_ERROR;
+    }
+
+    if (!request || !result) {
+        return STATUS_PARAM_ERROR;
+    }
+
+    std::string searchResult;
+    DataManagementStatus status = dataManagementSession->naturalLanguageSearch(request, searchResult);
+    if (!status.success) {
+        return status;
+    }
+
+    size_t length = searchResult.size() + 1;
+    *result = new char[length];
+    std::strcpy(*result, searchResult.c_str());
+    return status;
+}
+
+DataManagementStatus data_management_search_by_query_conditions(DataManagementSession* session, const char* request, char** result) {
+    auto* dataManagementSession = reinterpret_cast<datamanagement::_DataManagementSession*>(session);
+    if (!dataManagementSession) {
+        return STATUS_SESSION_ERROR;
+    }
