# Contributor: Jens John <dev@2ion.de>

pkgname=python-pylxd
_pkgname=${pkgname#python-}
pkgver=2.4.1
pkgrel=1
pkgdesc="A library for interacting with the LXD REST API"
url="https://pylxd.readthedocs.io/en/latest"
arch=('any')
license=('Apache-2.0')
depends=('python' 'python-cryptography' 'python-dateutil' 'python-requests' 'python-requests-toolbelt' 'python-ws4py')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest' 'python-pytest-cov' 'python-ddt' 'python-requests-mock')
optdepends=('lxd: to use a local LXD server')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/canonical/pylxd/archive/refs/tags/${pkgver}.tar.gz")
sha512sums=('e75aa3916cc28080e48d460d621681a3e3f735d5f6518c3dce10c172829f62e39d056da783b350c5d4e999e4976df57b2106e7f27ec1ea27aa76efd1bfe79ae3')

build() {
	cd "${_pkgname}-${pkgver}"
	python -m build --wheel --no-isolation
}

check() {
	cd "${_pkgname}-${pkgver}"
	pytest --doctest-modules pylxd
}

package() {
	cd "${_pkgname}-${pkgver}"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
