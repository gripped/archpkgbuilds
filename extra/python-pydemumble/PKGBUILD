# Maintainer: giver <giverc139@gmail.com>

_pyname=pydemumble
pkgname=python-${_pyname}
pkgver=0.1.3
pkgrel=1
pkgdesc='Library for demumble, a tool to demangle C++, Rust, and Swift symbol names'
url='https://github.com/angr/pydemumble'
license=(BSD-2-Clause)
arch=(x86_64)
depends=(
  glibc
  libgcc
  libstdc++
  python
)
makedepends=(
  nanobind
  python-build
  python-installer
  python-scikit-build-core
)
checkdepends=(
  python-pytest
)
source=(
  "$url/archive/v$pkgver/$_pyname-$pkgver.tar.gz"
)
sha512sums=('c635e5bf2801688477699ec987d539ffc55334601ee188e20c2ae10b50b4548e911d1bd678fd280983dc4c1e5b7715b4f9a69f528754611895f8e695949eaed7')
b2sums=('c73863384fe6b5f9650479b0ef8899efadcfc2116c73c6dacd318b26a5b02173151663d0f26465a1c1788ff248c392da2b153aeb2c65301f42f64157be55c0ea')

prepare() {
  cd "${_pyname}-${pkgver}"
  # use system nanobind
  sed -i 's|add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/src/nanobind)|find_package(nanobind CONFIG REQUIRED)|' CMakeLists.txt
}

build() {
  cd "${_pyname}-${pkgver}"
  python -m build --wheel --no-isolation
}

check() {
  cd "${_pyname}-${pkgver}"
  python -m venv --clear --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -Pm pytest tests
}

package() {
  cd "${_pyname}-${pkgver}"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm 644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

