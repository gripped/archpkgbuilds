# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-rich-rst
pkgver=2.2.0
pkgrel=1
pkgdesc="reStructuredText renderer for Rich"
arch=('any')
url="https://github.com/wasi-master/rich-rst"
license=('MIT' 'BSD-2-Clause' 'BSD-3-Clause' 'LicenseRef-Public-Domain')
depends=('python' 'python-pygments' 'python-rich')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools')
checkdepends=('python-pytest')
source=("git+https://github.com/wasi-master/rich-rst.git#tag=v$pkgver")
sha512sums=('b35987c74f2f715498c3b5ea7db452d6eb1ec8b3d4dcce4e278731d3612a972a507fdff36602f55ace3a876bd34b119426cfd006af0bd5729d17ef8f446e716b')

build() {
  cd rich-rst
  python -m build --wheel --no-isolation
}

check() {
  cd rich-rst
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd rich-rst
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE rich_rst/_vendor/LICENSES.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
