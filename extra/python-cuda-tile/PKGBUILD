# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>

pkgname=python-cuda-tile
pkgver=1.7.0
pkgrel=1
pkgdesc="A Python-based DSL and parallel programming model for NVIDIA GPUs"
arch=(x86_64)
url="https://docs.nvidia.com/cuda/cutile-python/"
license=(Apache-2.0)
depends=(
  cuda
  glibc
  libstdc++
  python
  python-numpy
  python-typing_extensions
)
makedepends=(
  cmake
  dlpack
  python-build
  python-installer
  python-setuptools
  python-wheel
)
source=(
  $pkgname-$pkgver.tar.gz::https://github.com/NVIDIA/cutile-python/archive/refs/tags/v$pkgver.tar.gz
)
b2sums=('46ce616ad9a5be04a322079b80187b6bf074948c42f96504c181f067fe5f405fea75ad7477dfbbf833d7a2cdcd302facbef6fa794906b5c688695cb905c3ed68')

prepare() {
  cd cutile-python-$pkgver
  # remove custom FindCUDAToolkit module to fix finding CUDA
  # https://github.com/NVIDIA/cutile-python/issues/58
  rm -v cmake/FindCUDAToolkit.cmake

  # CMake's builtin FindCUDAToolkit does not set CUDAToolkit_NVVM_INCLUDE_DIR,
  # which is needed since 1.6.0 to find nvvm.h for cext/pynvvm.cpp
  sed -i 's|set(NVVM_INCLUDE_DIR ${CUDAToolkit_NVVM_INCLUDE_DIR})|set(NVVM_INCLUDE_DIR "/opt/cuda/nvvm/include")|' cext/CMakeLists.txt

  # -nostdlib and -fstack-clash-protection do not work together (undefined reference to `__stack_chk_fail')
  # https://github.com/NVIDIA/cutile-python/issues/60
  sed -i 's|-nostdlib||' cext/CMakeLists.txt

  # fix version https://github.com/NVIDIA/cutile-python/issues/59
  echo $pkgver > src/cuda/tile/VERSION

  # unping setuptools version
  sed -i 's|setuptools==84.0.0|setuptools|' pyproject.toml
  sed -i 's|dry_run=self.dry_run||' setup.py

  # allow compiler warnings as a workaround for https://gitlab.archlinux.org/archlinux/packaging/packages/python/-/merge_requests/8
  sed -i 's|add_compile_options(-Wall -Werror)||' CMakeLists.txt
}

build() {
  cd cutile-python-$pkgver
  CUDA_PATH=/opt/cuda CUDA_TILE_CMAKE_DLPACK_PATH=/usr \
  python -m build --wheel --no-isolation
}

package() {
  cd cutile-python-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
}
