# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-cyclopts
pkgver=5.4.0
pkgrel=1
pkgdesc="Command-line interfaces based on type hints"
arch=('any')
url="https://github.com/BrianPugh/cyclopts"
license=('Apache-2.0')
depends=('python' 'python-attrs' 'python-docstring-parser' 'python-rich' 'python-rich-rst')
makedepends=('git' 'python-build' 'python-hatch-vcs' 'python-hatchling' 'python-installer')
# pwsh is not packaged
checkdepends=(
  'fish'
  'mkdocs'
  'python-docutils'
  'python-pexpect'
  'python-pydantic'
  'python-pytest'
  'python-pytest-mock'
  'python-pytest-timeout'
  'python-sniffio'
  'python-sphinx'
  'python-syrupy'
  'python-trio'
  'python-yaml'
  'zsh'
)
optdepends=(
  'mkdocs: MkDocs documentation plugin'
  'python-pydantic: Pydantic model arguments'
  'python-pymdown-extensions: extended formatting for MkDocs documentation'
  'python-sphinx: Sphinx documentation extension'
  'python-trio: Trio async commands'
  'python-yaml: YAML configuration files'
)
source=("git+https://github.com/BrianPugh/cyclopts.git#tag=v$pkgver")
sha512sums=('18c567eb0e09cec16b36bad8cd6861883f3ffed13f4a4ade194a9a458444f047e7965c5c1c988a3e41e8252bd9fc33ac21e03d6636d384ba8f585b7a619902bd')

build() {
  cd cyclopts
  python -m build --wheel --no-isolation
}

check() {
  cd cyclopts
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest
}

package() {
  cd cyclopts
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
