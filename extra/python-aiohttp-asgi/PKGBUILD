# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-aiohttp-asgi
pkgver=0.7.0
pkgrel=1
pkgdesc="Adapter for running ASGI applications on aiohttp"
arch=('any')
url="https://github.com/mosquito/aiohttp-asgi"
license=('Apache-2.0')
depends=('python' 'python-aiohttp')
makedepends=('git' 'python-build' 'python-installer' 'python-poetry-core')
checkdepends=('python-fastapi' 'python-pytest' 'python-pytest-asyncio')
source=("git+https://github.com/mosquito/aiohttp-asgi.git#tag=$pkgver")
sha512sums=('089056d4e608423f7f94413d482415e9aeb912c0418756fa99952098dc23bb91226f50f0f15d9c9cbe835daa8b2d8f343980420afadd68262c636baeeadfba0e')

build() {
  cd aiohttp-asgi
  python -m build --wheel --no-isolation
}

check() {
  cd aiohttp-asgi
  python -m pytest
}

package() {
  cd aiohttp-asgi
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.md -t "$pkgdir/usr/share/licenses/$pkgname/"
}
