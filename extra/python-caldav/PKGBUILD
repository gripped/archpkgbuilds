pkgname=python-caldav
pkgver=3.7.0
pkgrel=1
pkgdesc='CalDAV (RFC4791) client library for Python'
arch=(any)
url='https://github.com/python-caldav/caldav'
license=('Apache-2.0 OR GPL-3.0-or-later')
depends=(
  python
  python-dateutil
  python-dnspython
  python-icalendar
  python-icalendar-searcher
  python-lxml
  python-recurring-ical-events
  python-requests
  python-vobject
  python-yaml
)
makedepends=(
  git
  python-build
  python-hatch-vcs
  python-hatchling
  python-installer
  python-wheel
)
source=("git+https://github.com/python-caldav/caldav.git?signed#tag=v$pkgver")
b2sums=(7e1d86d80665945ebc624f5a14bad6c6b5e96a94267d1c79544a519de47d3b5d98cdee6b6f5c7dae97075c66551f4a95a1747ada8564174aed94961363f199d1)
validpgpkeys=(CC67B0D4A21A344811DD5B54A8591F23C40DEF4E) # Tobias Brox <tobias@redpill-linpro.com>

build() {
  cd caldav
  python -m build --wheel --no-isolation
}

package() {
  cd caldav
  python -m installer --destdir="$pkgdir" dist/*.whl
}
