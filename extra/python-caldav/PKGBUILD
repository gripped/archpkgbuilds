pkgname=python-caldav
pkgver=3.4.0
pkgrel=1
pkgdesc='CalDAV (RFC4791) client library for Python'
arch=(any)
url='https://github.com/python-caldav/caldav'
license=('Apache-2.0 OR GPL-3.0-or-later')
depends=(
  python
  python-dateutil
  python-dnspython
  python-icalendar
  python-icalendar-searcher
  python-lxml
  python-recurring-ical-events
  python-requests
  python-vobject
  python-yaml
)
makedepends=(
  git
  python-build
  python-hatch-vcs
  python-hatchling
  python-installer
  python-wheel
)
source=("git+https://github.com/python-caldav/caldav.git?signed#tag=v$pkgver")
b2sums=(759649375b2c9fe8018702a696978997ff390f60b4bed19870bf2c199328449b5dcc647e1647f7d881f091326e5d4a43d2d38ae818d897ae8bd2f0a9e8d23575)
validpgpkeys=(CC67B0D4A21A344811DD5B54A8591F23C40DEF4E) # Tobias Brox <tobias@redpill-linpro.com>

build() {
  cd caldav
  python -m build --wheel --no-isolation
}

package() {
  cd caldav
  python -m installer --destdir="$pkgdir" dist/*.whl
}
