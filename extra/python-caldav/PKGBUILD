pkgname=python-caldav
pkgver=3.3.1
pkgrel=1
pkgdesc='CalDAV (RFC4791) client library for Python'
arch=(any)
url='https://github.com/python-caldav/caldav'
license=('Apache-2.0 OR GPL-3.0-or-later')
depends=(
  python
  python-dateutil
  python-dnspython
  python-icalendar
  python-icalendar-searcher
  python-lxml
  python-recurring-ical-events
  python-requests
  python-vobject
  python-yaml
)
makedepends=(
  git
  python-build
  python-hatch-vcs
  python-hatchling
  python-installer
  python-wheel
)
source=("git+https://github.com/python-caldav/caldav.git?signed#tag=v$pkgver")
b2sums=(4f4dce549bfe6178c863f06e3766a7be74f3249936c6b61b33be9305e4c519aa9d9cf81e0de03329ad0c8e28e916021d82065871ed89edc1e0d381a09aa04b5c)
validpgpkeys=(CC67B0D4A21A344811DD5B54A8591F23C40DEF4E) # Tobias Brox <tobias@redpill-linpro.com>

build() {
  cd caldav
  python -m build --wheel --no-isolation
}

package() {
  cd caldav
  python -m installer --destdir="$pkgdir" dist/*.whl
}
