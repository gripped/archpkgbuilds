# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=kfr
pkgver=7.1.0
pkgrel=1
pkgdesc="Fast, modern C++ DSP framework, FFT, Sample Rate Conversion, FIR/IIR/Biquad Filters"
arch=(x86_64)
url="https://github.com/kfrlib/kfr/"
license=(GPL-2.0-or-later)
depends=(
  glibc
)
makedepends=(
  boost
  clang
  cmake
)
source=("$pkgname-$pkgver.tar.gz::${url}archive/refs/tags/$pkgver.tar.gz")
sha512sums=('109a38f849b64ce3a96ab9995583dd89cbb1d91fa179f9a74eec0784b3926b17bfaaf3033af935efb2a747eec39f726f7e00bdd00f6dc104bb69696b7206a7d1')
b2sums=('8f6d972d955e0f53f44430ee918890bc54f1699c3450423d92433c4b572ed4f907be40a34c4526c2b925a917a604f6dc9f6cb788ff4814ba1ff918c17b063cd9')

build() {
  local cmake_options=(
    -B build
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_CXX_COMPILER=clang++
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_POSITION_INDEPENDENT_CODE=ON
    -D KFR_ENABLE_CAPI_BUILD=ON
    -D KFR_ENABLE_DFT=ON
    -D KFR_ENABLE_MULTIARCH=ON
    -D KFR_USE_BOOST=ON
    -S "$pkgname-$pkgver"
    -W no-dev
  )

  CFLAGS+=" -ffat-lto-objects"
  cmake "${cmake_options[@]}"
  cmake --build build --verbose
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # remove files that are in the wrong location: https://github.com/kfrlib/kfr/issues/277
  rm --verbose "$pkgdir/usr/"{LICENSE.txt,README.md}
  install -vDm 644 "$pkgname-$pkgver/LICENSE.txt" -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 "$pkgname-$pkgver/"{CHANGELOG,README}.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
