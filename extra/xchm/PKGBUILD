# Maintainer: Balló György <ballogyor+arch at gmail dot com>
# Contributor: Giovanni Scafora <giovanni@archlinux.org>

pkgname=xchm
pkgver=1.39
pkgrel=2
pkgdesc='Viewer for CHM files (GUI front-end to chmlib)'
arch=(x86_64)
url='https://github.com/rzvncj/xCHM'
license=(GPL-2.0-or-later)
depends=(
  chmlib
  glibc
  hicolor-icon-theme
  libgcc
  libstdc++
  wxwidgets-common
  wxwidgets-gtk3
)
makedepends=(git)
source=("git+https://github.com/rzvncj/xCHM.git#tag=$pkgver")
b2sums=(05d7775a9bd2f64d3e21657250c5223587182c6e9663540f4595e2283a4a215cb9daa307b4cbf12fe9b6099ea109f60cf5dfcbd8bb6651418575f498ce751554)

prepare() {
  cd xCHM
  autoreconf -fiv
}

build() {
  cd xCHM
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd xCHM
  make DESTDIR="$pkgdir" install
}
