# Maintainer: Balló György <ballogyor+arch at gmail dot com>
# Contributor: Giovanni Scafora <giovanni@archlinux.org>

pkgname=xchm
pkgver=1.39
pkgrel=1
pkgdesc='Viewer for CHM files (GUI front-end to chmlib)'
arch=('x86_64')
url='https://github.com/rzvncj/xCHM'
license=('GPL-2.0-only')
depends=('chmlib' 'wxwidgets-gtk3')
source=("https://github.com/rzvncj/xCHM/releases/download/$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('43e5ae640e1c33b95439b99e1a3d1e14aaef851b668cf2643fb8ba3363a5e795')

prepare() {
  cd $pkgname-$pkgver
  autoreconf -fi
}

build() {
  cd $pkgname-$pkgver
  ./configure --prefix=/usr
  make
}

package() {
  cd $pkgname-$pkgver
  make DESTDIR="$pkgdir" install
}
