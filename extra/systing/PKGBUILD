# Maintainer: Christian Heusel <gromit@archlinux.org>

pkgname=systing
pkgver=1.19.0
pkgrel=1
pkgdesc="A libbpf based tracer to help figure out what an application is doing"
arch=(x86_64)
url="https://github.com/josefbacik/systing"
depends=(
  bpf
  fmt
  glibc
  libbpf
  libcap
  libelf
  libgcc
  re2
  zlib
)
makedepends=(
  clang
  git
  rust
  linux
  jq
)
license=(MIT)
source=(
  "${pkgname}::git+https://github.com/josefbacik/systing.git#tag=v$pkgver"
)
sha512sums=('abc85cf007c9b0cdc29896d6579af46020c76706e6fff22c9756ad65b9152c34a60d49a444224295a0b25fad2d0ada9172fcf599e58f8f72191ca8dd43dd75de')
b2sums=('b9dac3fc96b2898bcdace5ad8bb1ab5a74db8f24a0ed786ed5776627cab1b2254e383975c6938c835c7ea1de747ecbda1e609fe87fda268928d59c2a5b262e6c')

# needed to workaround linking error with BPF lib
options=(!lto)

prepare() {
  cd $pkgname

  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $pkgname
  # TODO: drop once the ICF issue is fixed in devtools
  export RUSTFLAGS="-C force-frame-pointers=yes"

  for binary in systing{,-util,-analyze}; do
      cargo build --release --bin $binary
  done
}

check() {
  cd $pkgname

  cargo test -p $pkgname --frozen
}

package() {
  cd $pkgname
  for binary in systing{,-util,-analyze}; do
      install -vDm 0755 "target/release/$binary" -t "$pkgdir/usr/bin/"
  done
  install -vDm 0644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
