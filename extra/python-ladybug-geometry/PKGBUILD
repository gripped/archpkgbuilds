# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-geometry
pkgver=1.35.3
pkgrel=1
pkgdesc='Python library housing basic geometry objects and computation methods'
arch=(any)
url='https://github.com/ladybug-tools/ladybug-geometry'
license=(AGPL-3.0-only)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('58ecba0111ead17b3275a82db9dd341c5cdddc64acc71d47f332d9730f64ec565e3e5004e52b8953ae46d2c89090da9c0ef7d1a552501ce6266766647115c7af')
b2sums=('483658ff1dab014796f459f4c69684fc8cffb8406914435c046db4a0c10b59b6a19f914805ae3a3e5f48ee77b405506791fcc69c34bf25589e2b1c6e7fadc09d')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
