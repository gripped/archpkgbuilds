# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-geometry
pkgver=1.35.10
pkgrel=1
pkgdesc='Python library housing basic geometry objects and computation methods'
arch=(any)
url='https://github.com/ladybug-tools/ladybug-geometry'
license=(AGPL-3.0-only)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('e255ced6ff7e84676fc5736ce5daec54f81afa40abdb10a6aaf7c384c9a9c6568245f2ef201617f0611effdd799a5fdb244a31169101968b0387ce17e8875e4e')
b2sums=('09aa1db9757e5991cd78e7c9e766da5cb00e891d6cf5cbda18e3c39f48842e67d8748b151ca949ec20f0a7213ae96ee2a3d6a221aacfdb589e54b751585fedd6')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
