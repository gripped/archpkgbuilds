# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-geometry
pkgver=1.34.23
pkgrel=1
pkgdesc='Python library housing basic geometry objects and computation methods'
arch=(any)
url='https://github.com/ladybug-tools/ladybug-geometry'
license=(AGPL-3.0-only)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('ba2647911ec538fbc5913e4a1ae27aaf192703917ffa744e862c4d31fcc1484cf12e44ad72b42a762a70bb4035b8855f21b9c129c2cb155cfba899afd0e77c7c')
b2sums=('2d039f6d1f5c3543c45ecf7932b6cf947df6873205245ea09e548f7729f7128a637efcf9e2893b9c99bda046069335c028dc4fa6f4e58f9adf3b5f8bc5fde961')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
