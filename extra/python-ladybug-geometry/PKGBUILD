# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-geometry
pkgver=1.35.1
pkgrel=1
pkgdesc='Python library housing basic geometry objects and computation methods'
arch=(any)
url='https://github.com/ladybug-tools/ladybug-geometry'
license=(AGPL-3.0-only)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('a64a91c0bf09ae530cefe298dd2f14c3816a17b49fffc6ac9b73848077ffbc3a137d9ff619dba7d475677d46258f68c08821031f1ee2dd9e307144eb699ec4aa')
b2sums=('de4ba5657a0e3af957db1bd9fa694ab8f060781417d68078f6fd39deec8b118403eb956f3537bdf22b79064f43300317a8e8dd4427d77e4d06666a0a76fb82ff')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
