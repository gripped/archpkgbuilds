# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-geometry
pkgver=1.35.7
pkgrel=1
pkgdesc='Python library housing basic geometry objects and computation methods'
arch=(any)
url='https://github.com/ladybug-tools/ladybug-geometry'
license=(AGPL-3.0-only)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('3bd6ec8c8d2444b4edca625cb0cb78193014d115a352f7f49929a93b33e7a0b005e48c790ba674ade96a6b1f02645f8e88cf9f3fef3b8b19ea857a899802fef1')
b2sums=('e02d89f6ca96f53809833f531e39ec7138927d30ae78ee911873fa5988d102853f5e514b2c07142088dfcf03178d57a6a64a8e76fecc4827f40ca7c93a42f42e')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
