# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-geometry
pkgver=1.35.5
pkgrel=1
pkgdesc='Python library housing basic geometry objects and computation methods'
arch=(any)
url='https://github.com/ladybug-tools/ladybug-geometry'
license=(AGPL-3.0-only)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('b1d548b7e35a371bbfbae6ecc73ee67c5363730024e2b67f28e8ff07880f2100a669f61b9e32a8b17e17bfb6b6d890ff81aab0882f8053cd817a2572804aac80')
b2sums=('800c1024fc6d1e1a7cf975883ed45c5b22b0f9797e6bbf21b93febb7fd30d1ad5ce7516124dc22dfee34659cd6d2a35ef70c30bcc8a5c6131c3f6d012c6ac519')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
