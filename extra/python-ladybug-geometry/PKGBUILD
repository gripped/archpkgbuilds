# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-geometry
pkgver=1.35.4
pkgrel=1
pkgdesc='Python library housing basic geometry objects and computation methods'
arch=(any)
url='https://github.com/ladybug-tools/ladybug-geometry'
license=(AGPL-3.0-only)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('e927b126af7100cce025503fa0ab188669efc862baa61dd1d2c67c5725ee24df955ea121fcee4816c9332c86eee6398ae91823feacc423ee7f50d00f0be32187')
b2sums=('e1b7db55189110c3d18d405a6b0e5646ae738c0d9ef571c6ff11b7cc68afb1b5e2349f63e91391f1fbd5b1cb2e94748ffc7636eb5abc5b728e521d94864ad30c')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
