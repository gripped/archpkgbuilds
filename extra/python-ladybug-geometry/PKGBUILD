# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-geometry
pkgver=1.35.2
pkgrel=1
pkgdesc='Python library housing basic geometry objects and computation methods'
arch=(any)
url='https://github.com/ladybug-tools/ladybug-geometry'
license=(AGPL-3.0-only)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('b9c62187eddd68fb8f3547874c2238b95eb95c7131120eb7ec2ff7d98de5c12aedf7bcd651e875a897f3b522b93964ba803d78f0275eeb7b31fd86f2fc445c64')
b2sums=('651a60551d37308d1670c1e51d2e880ce2a813a4e3e042a764dc7194239bfdfb655293bef1dcd4f6ab3405bc2b499636b610c5edbc983b8829e8a26bbd489b82')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
