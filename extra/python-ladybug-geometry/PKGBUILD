# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-geometry
pkgver=1.34.22
pkgrel=1
pkgdesc='Python library housing basic geometry objects and computation methods'
arch=(any)
url='https://github.com/ladybug-tools/ladybug-geometry'
license=(AGPL-3.0-only)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('b89cb11a867cc1fa2f3bc451e61ea9e0522a2c5ce5a330269277703b7843e560a207d83b2e3efae65bafdd5fbc6af6d7479c034e02b2ff3a78f81c5b8f7aa8e3')
b2sums=('57be1eb0062106ea4a44499372e5038984938ca825b01483f6866f776b3597d52c555673e2083a1fe01d2eb4937bb87a52076eceeface3192a7046d65a2991d8')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
