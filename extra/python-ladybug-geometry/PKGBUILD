# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-geometry
pkgver=1.34.26
pkgrel=1
pkgdesc='Python library housing basic geometry objects and computation methods'
arch=(any)
url='https://github.com/ladybug-tools/ladybug-geometry'
license=(AGPL-3.0-only)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('37143f1e024fe5eda3cdd565621f9a3d35ecb7e26914c4ea6dbd6990953fb7d08ebee8cdf192169d881d3a511dbf944310aea6cd51a1d95af1e0609a6c27f024')
b2sums=('023cb20d2551aa54cf029f1b2f574e35f6040dc1bdfd42b67a3a0b9c3bccdbfa2bdda9e63575220ba84b5c9d30ed7813efe053d536c37eb00c703f371d047c1b')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
