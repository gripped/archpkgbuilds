# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-geometry
pkgver=1.34.27
pkgrel=1
pkgdesc='Python library housing basic geometry objects and computation methods'
arch=(any)
url='https://github.com/ladybug-tools/ladybug-geometry'
license=(AGPL-3.0-only)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('5493ffd5054bc963967922b1bac07b6272ca08e23b78715b576c2bd3cfcbb7f5bb86401f623ca615924d4e5e77aac6020a6b19cc4183a66ca502cbb9c8afb56d')
b2sums=('d00e31114fb45eb9e9988d11d1e33423320eaefc40937780393aa5789e29f1f46e25ce8fd32ef2164a308fc30341b17b0020924e1c06525c742d161f2d1df3fd')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
