# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-ladybug-geometry
pkgver=1.34.24
pkgrel=1
pkgdesc='Python library housing basic geometry objects and computation methods'
arch=(any)
url='https://github.com/ladybug-tools/ladybug-geometry'
license=(AGPL-3.0-only)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools-scm
  python-setuptools
  python-wheel
)
checkdepends=(python-pytest)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('716eb9d6f86f3155d5d319f951506c6de8645907c441154dc91141a8dd6783282b25411801bc28fa4813413a85428e982e3df5a4788b670aa1afb7ef64f46456')
b2sums=('fcf132007518afb88116658df5c3f6ad4220736a0450bc0cd4a6d166e552d99f363ccf3975400dc47902d2857465e91517e376cc229970e53765344186f9328d')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl
}
