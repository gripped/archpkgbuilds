# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=pantheon-iconbrowser
pkgver=8.1.0
pkgrel=1
pkgdesc='Browse and search system icons'
arch=(x86_64)
url=https://github.com/elementary/iconbrowser
license=(GPL-3.0-or-later)
groups=(pantheon)
depends=(
  dconf
  elementary-icon-theme
  glib2
  glibc
  granite7
  gtk-theme-elementary
  gtk4
  gtksourceview5
  hicolor-icon-theme
)
makedepends=(
  git
  meson
  vala
)
source=(pantheon-iconbrowser::git+https://github.com/elementary/iconbrowser.git#tag=${pkgver})
b2sums=('ab4c224a1d0a5822ac560c16a712d5e94d736f5813b52a952c647aa8a3d2b35ac86ab23d4a44749bac1cf1faeca0e8dee2e6c25600faf56281d06a2a601be6df')

build() {
  arch-meson pantheon-iconbrowser build
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}
