pkgname=tauon-music-box
_pkgname=tauonmb
_gitname=Tauon
pkgver=13.1.0
pkgrel=1
pkgdesc="A modern music player"
arch=("x86_64") # "aarch64"
url="https://tauonmusicbox.rocks"
license=("GPL-3.0-or-later")
depends=(
	"python-pillow"
	"python-pylast"
	"python-pysdl3"
	"python-rapidfuzz"
	"python-send2trash"
	"python-musicbrainzngs"
	"python-mutagen"
	"python-unidecode"
	"python-setproctitle"
	"python-gobject"
	"python-cairo"
	"python-beautifulsoup4"
	"python-requests"
	"python-dbus"
	"python-natsort"
	"python-opengl"
	"python-websocket-client"
	"chromaprint"
	"kissfft"
	"libnotify"
	"ffmpeg"
	"flac"
	"noto-fonts-extra"
	"noto-fonts"
	"xdg-utils"
	"mpg123"
	"opusfile"
	"wavpack"
	"libvorbis"
	"libappindicator"
	"libopenmpt"
	"libprojectm"
	"libsamplerate"
	"opencc"
	"libgme"
	"libpipewire"
	"sdl3_image"
)

makedepends=(
	"cargo"
	"miniaudio"
	"pkgconf"
	"python-build"
	"python-installer")

optdepends=(
	"noto-fonts-cjk: Matching font for CJK characters"
	"p7zip: 7z archive extraction support"
	"unrar: RAR archive extraction support"
	"python-plexapi: Plex streaming support"
	"python-pypresence: Discord status support"
	"python-pychromecast: Chromecast stream support"
	"python-jxlpy: JPEG XL image support"
	"python-tidalapi: Tidal feature support"
)

source=("${_gitname}-${pkgver}.tar.gz::https://github.com/Taiko2k/Tauon/archive/v${pkgver}.tar.gz")
sha256sums=('9b3c994e9eaddec12f26d20e1020db189a34f406f9fb978f7163bcb7b78e4187')

prepare() {
	# Use system kissfft instead of the expected cloned repository
	cd "${_gitname}-${pkgver}"
	sed -i \
		-e '/src\/phazor\/kissfft\/kiss_fft[r]*\.c/d' \
		-e 's/set(TAUON_PHAZOR_PACKAGES /set(TAUON_PHAZOR_PACKAGES kissfft-float /' \
		CMakeLists.txt
	sed -i 's|com.github.taiko2k.tauonmb.desktop|tauonmb.desktop|' extra/com.github.taiko2k.tauonmb.metainfo.xml

	cd src/lrclib-solver
	export RUSTUP_TOOLCHAIN=stable
	cargo fetch --locked --target host-tuple
}

build() {
	cd "${_gitname}-${pkgver}"
	python -m build --wheel

	# Tiny Rust binary that calculates LRCLIB challenges
	cd src/lrclib-solver
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	# LTO disabled due to https://github.com/briansmith/ring/issues/1444
	CFLAGS="$CFLAGS -fno-lto" cargo build --frozen --release --all-features
}

package() {
	cd "${_gitname}-${pkgver}"
	python -m installer --destdir="${pkgdir}" dist/*.whl

	install -Dm644 "extra/${_pkgname}.desktop" -t "${pkgdir}/usr/share/applications"
	install -Dm644 "extra/com.github.taiko2k.tauonmb.metainfo.xml" -t "${pkgdir}/usr/share/metainfo"
	install -Dm644 "extra/${_pkgname}-symbolic.svg" -t "${pkgdir}/usr/share/icons/hicolor/symbolic/apps"
	install -Dm644 "extra/${_pkgname}.svg" -t "${pkgdir}/usr/share/icons/hicolor/scalable/apps"

	local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
	install -Dm755 "src/lrclib-solver/target/release/lrclib-solver" "${pkgdir}${site_packages}/tauon/lrclib-solver"
}
