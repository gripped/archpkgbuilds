pkgname=rocprofiler
pkgver=10.1
pkgrel=1
pkgdesc="ROC profiler library. Profiling with perf-counters and derived metrics."
arch=('x86_64')
url='https://rocm.docs.amd.com/projects/rocprofiler/en/latest/index.html'
license=('MIT')
depends=(
  'bash'
  'comgr'
  'fmt'
  'glibc'
  'hip-runtime-amd'
  'hsa-amd-aqlprofile'
  'hsa-rocr'
  'libelf'
  'libgcc'
  'libpciaccess'
  'libstdc++'
  'numactl'
  'python'
  'python-lxml'
  'python-numpy'
  'rocm-core'
)
makedepends=(
  'cmake'
  'git'
  'gtest'
  'python-barectf'
  'python-cppheaderparser'
  'python-pandas'
  'python-yaml'
  'rocm-dbgapi'
  'rocm-llvm'
  'rocm-llvm-static'
  'rocm-smi-lib'
  # prof_protocol.h
  'roctracer'
)
_git='https://github.com/ROCm/rocm-systems'
source=("rocm-systems::git+$_git#tag=therock-$pkgver"
        # Submodule of the perfetto plugin
        "$pkgname-perfetto::git+https://github.com/google/perfetto")
sha256sums=('SKIP'
            'SKIP')
options=(!lto)
_dirname="rocm-systems/projects/$pkgname"

prepare() {
  cd rocm-systems

  # Check out only the submodule of rocprofiler, not the whole monorepo
  git submodule init projects/rocprofiler/plugin/perfetto/perfetto
  git config submodule."projects/rocprofiler/perfetto".url "$srcdir/$pkgname-perfetto"
  git -c protocol.file.allow=always submodule update
}

build() {
  local cmake_args=(
    -Wno-dev
    -B build
    -S "$_dirname"
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    # Selects only the test kernels, which are not packaged. The tests
    # always build, and an empty list fails in CMake.
    -D GPU_TARGETS=gfx1100
    # Both default to the /opt/rocm/llvm layout
    -D Clang_DIR=/opt/rocm/lib/llvm/lib/cmake/clang
    -D HIP_CLANG_PATH=/opt/rocm/lib/llvm/bin
    # rocprofv2 fetches fmt from git master, use the system package instead
    -D FETCHCONTENT_TRY_FIND_PACKAGE_MODE=ALWAYS
    -D FETCHCONTENT_FULLY_DISCONNECTED=ON
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  rm -r "$pkgdir"/opt/rocm/share/rocprofiler/{tests,tests-v1}
  install -Dm644 "$_dirname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
