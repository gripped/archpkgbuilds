pkgname=workrave
pkgver=1.11.1
pkgrel=1
pkgdesc='Assist in the recovery and prevention of Repetitive Strain Injury (RSI)'
arch=(x86_64)
url='https://workrave.org/'
license=(GPL-3.0-or-later)
