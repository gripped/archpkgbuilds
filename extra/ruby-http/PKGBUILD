# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=ruby-http
pkgver=6.0.1
pkgrel=1
pkgdesc='A fast Ruby HTTP client with a chainable API, streaming support, and timeouts'
arch=(any)
url='https://github.com/httprb/http'
license=(MIT)
depends=(
  ruby
  ruby-http-cookie
  ruby-llhttp
)
optdepends=('ruby-addressable: non-ASCII URL and internationalized hostname support')
makedepends=(
  git
  ruby-rdoc
)
checkdepends=(
  ruby-addressable
  ruby-minitest
  ruby-minitest-memory
  ruby-minitest-mock
  ruby-minitest-strict
  ruby-simplecov
)
options=(!emptydirs)
source=(
  "git+https://github.com/httprb/http.git#tag=v$pkgver"
)
sha256sums=('8f422f207b1e154b026fbf88feaf0f51ff3c5db44e63a355aaee8dfa14c3f7ea')

prepare() {
  cd http

  # Allow newer packaged dependency releases.
  sed -i 's|~>|>=|' http.gemspec
}

build() {
  local _gemdir="$(gem env gemdir)"
  cd http
  gem build http.gemspec
  gem install \
    --local \
    --verbose \
    --ignore-dependencies \
    --no-user-install \
    --install-dir "tmp_install/$_gemdir" \
    --bindir "tmp_install/usr/bin" \
    http-$pkgver.gem
  find "tmp_install/$_gemdir/gems/" \
    -type f \
    \( \
        -iname "*.o" -o \
        -iname "*.c" -o \
        -iname "*.so" -o \
        -iname "*.time" -o \
        -iname "gem.build_complete" -o \
        -iname "Makefile" \
    \) \
    -delete
  rm -r tmp_install/$_gemdir/cache
}

check() {
  local _gemdir="$(gem env gemdir)"
  cd http
  GEM_HOME="tmp_install/$_gemdir" ruby -Ilib:test -e 'Dir["test/**/*_test.rb"].sort.each { |test| load test }'
}

package() {
  cd http
  cp -a tmp_install/* "$pkgdir"/
  install -Dm644 LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname/
}
