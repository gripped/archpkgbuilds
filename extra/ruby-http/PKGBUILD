# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=ruby-http
pkgver=5.3.1
pkgrel=1
pkgdesc='A fast Ruby HTTP client with a chainable API, streaming support, and timeouts'
arch=(any)
url='https://github.com/httprb/http'
license=(MIT)
depends=(
  ruby
  ruby-addressable
  ruby-http-cookie
  ruby-http-form_data
  ruby-llhttp-ffi
)
makedepends=(
  git
  ruby-rdoc
)
checkdepends=(
  ruby-certificate_authority
  ruby-rake
  ruby-rspec
  ruby-rspec-its
  ruby-rspec-memory
  ruby-simplecov
  ruby-webrick
)
options=(!emptydirs)
source=(
  "git+https://github.com/httprb/http.git#tag=v$pkgver"
  "${pkgname}_fix_tests.patch"
)
sha256sums=('e82e5d890359c22a4ed22826a57bb1e03e3ade7c70262415a7a9985c386f77c1'
            '9ef63cd4e498e3c92b7a622739cbf0d80079569c53d598c1aaa9e4ccc6180c7c')

prepare() {
  cd http

  # Match Hash#inspect formatting across Ruby versions.
  # HTTPBin now returns percent-encoded URLs instead of decoded Unicode URLs.
  patch --verbose --strip=1 --input="../${pkgname}_fix_tests.patch"

  sed -i 's|~>|>=|' http.gemspec
  sed -i '/fuubar/d' spec/spec_helper.rb
}

build() {
  local _gemdir="$(gem env gemdir)"
  cd http
  gem build http.gemspec
  gem install \
    --local \
    --verbose \
    --ignore-dependencies \
    --no-user-install \
    --install-dir "tmp_install/$_gemdir" \
    --bindir "tmp_install/usr/bin" \
    http-$pkgver.gem
  find "tmp_install/$_gemdir/gems/" \
    -type f \
    \( \
        -iname "*.o" -o \
        -iname "*.c" -o \
        -iname "*.so" -o \
        -iname "*.time" -o \
        -iname "gem.build_complete" -o \
        -iname "Makefile" \
    \) \
    -delete
  rm -r tmp_install/$_gemdir/cache
}

check() {
  local _gemdir="$(gem env gemdir)"
  cd http
  GEM_HOME="tmp_install/$_gemdir" rspec
}

package() {
  cd http
  cp -a tmp_install/* "$pkgdir"/
  install -Dm644 LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname/
}
