# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=pantheon-music
pkgver=9.0.0
pkgrel=3
pkgdesc='The Pantheon Music Player'
arch=(x86_64)
url=https://github.com/elementary/music
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  dconf
  elementary-icon-theme
  gdk-pixbuf2
  glib2
  glibc
  gst-plugins-base-libs
  gstreamer
  gtk-theme-elementary
  gtk4
  hicolor-icon-theme
  libadwaita-1.so
  libgranite-7.so
)
makedepends=(
  git
  gobject-introspection
  intltool
  meson
  vala
)
optdepends=(
  'gst-plugins-base: "Base" plugin libraries'
  'gst-plugins-good: "Good" plugin libraries'
  'gst-plugins-bad: "Bad" plugin libraries'
  'gst-plugins-ugly: "Ugly" plugin libraries'
)
source=(pantheon-music::git+https://github.com/elementary/music.git#tag=${pkgver})
b2sums=('5218ba7d669c34651374f5ed4a8992eba70771b3abd952e3158a7d29ef1600f9efc3b50bdd737e3cfc1b314586d68cc748c54d25299c5ea44f37c55382a3fad4')

prepare() {
  cd pantheon-music

  # Fix cover image size
  # https://github.com/elementary/music/pull/856
  git cherry-pick -n 903b7336fb5be7ac2cf8e3021a0b215207765da2
}

build() {
  arch-meson pantheon-music build
  meson compile -C build
}

package() {
  DESTDIR="${pkgdir}" meson install -C build
}

