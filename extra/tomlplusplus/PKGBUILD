# Maintainer: David Runge <dvzrv@archlinux.org>
# Maintainer: Caleb Maclennan <caleb@alerque.com>

pkgname=tomlplusplus
pkgver=3.5.1
pkgrel=1
pkgdesc="TOML config file parser and serializer for C++17"
arch=(x86_64)
url="https://marzer.github.io/tomlplusplus/"
license=(MIT)
depends=(glibc # libc.so libm.so
         libgcc
         libstdc++)
makedepends=(cmake
             meson)
provides=(libtomlplusplus.so)
source=($pkgname-$pkgver.tar.gz::https://github.com/marzer/$pkgname/archive/refs/tags/v$pkgver.tar.gz)
sha512sums=('a06b9c28559e34baf75d58457ef7b65ef092aee2240374b5abfe9c30ee64f5801ec3eeb4ab72238f7850b3ad981c9843a9c79b3b921cf816a2404d1cc3e7ee44')
b2sums=('4bd6e314ab24d941e0a3d731d9118a52eb80bea119a8cf05109ff85ee67b9e14f8627fd3e2bc2ff79e8b51e09439a4dc53612ff50c52a4a5aeb22b72de1ed58d')

build() {
  arch-meson $pkgname-$pkgver build -Dbuild_lib=true
  ninja -C build
}

package() {
  depends+=(libgcc_s.so
            libstdc++.so)
  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgname-$pkgver/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
