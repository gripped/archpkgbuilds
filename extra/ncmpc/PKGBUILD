pkgname=ncmpc
pkgver=0.53
pkgrel=1
pkgdesc="Fully featured MPD client which runs in a terminal"
arch=(x86_64)
url=https://www.musicpd.org/clients/ncmpc/
_url=https://github.com/MusicPlayerDaemon/ncmpc
license=(GPL-2.0-or-later)
depends=(
  glibc
  libgcc
  libstdc++
  lirc
)
makedepends=(
  boost
  fmt
  git
  libmpdclient
  meson
  ncurses
  pcre2
  python-sphinx
)
optdepends=(
  'python-beautifulsoup4: for lyrics scripts'
  'python-requests: for lyrics scripts'
)
source=(git+$_url.git?signed#tag=v$pkgver)
sha512sums=('b3e1954ceaeee2ffd96f20e8d7dc91c691481c391484ad48a893dc0a4f3a77d798a2f0cd08e8c2526bde83b132b8247329e995580c44b6657eba7b527eaeeb7f')
b2sums=('50b420a3d99d86593022973f8fa7a80cacbac6d284283d7b54a1dc1e35fba5526d796a8ad395ff279e5847063c5bf4b53b833ecf45d4db5b72bc0971ee1d499d')
validpgpkeys=('0392335A78083894A4301C43236E8A58C6DB4512') # Max Kellermann <max@blarg.de>

build() {
  arch-meson -D lyrics_screen=true -D chat_screen=true build $pkgname
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  depends+=(
    fmt libfmt.so
    libmpdclient libmpdclient.so
    ncurses libncursesw.so
    pcre2 libpcre2-8.so
  )

  meson install -C build --destdir "$pkgdir"
}
