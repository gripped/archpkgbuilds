# Contributor: Lars Hagström <lars@foldspace.nu>

pkgname=s-tui
pkgver=1.4.0
pkgrel=1
pkgdesc="Terminal UI stress test and monitoring tool "
arch=(any)
url="https://github.com/amanusk/s-tui"
license=(GPL-2.0-only)
depends=(
  python
  python-psutil
  python-urwid
  stress
)
makedepends=(
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-pytest
  python-pytest-mock
)
optdepends=(
  'python-numpy: for built-in stress tool'
)
source=($pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz)
sha512sums=('9b46e2e51695f22cb0c4c3f1948dd9f0f65a9acd5815ae8786b8a4df31c96ed31ab6cd22222c2d3fd55a11b7c08add4b9bc91387ff3ad82a7bcaf2e652b9cbe7')

build() {
  cd $pkgname-$pkgver
  python -m build --wheel --no-isolation
}

check() {
  cd $pkgname-$pkgver
  pytest
}

package() {
  cd $pkgname-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
}
