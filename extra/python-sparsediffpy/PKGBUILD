# Maintainer: Antonio Rojas <arojas@archlinux.org>

_pyname=SparseDiffPy
pkgname=python-${_pyname,,}
pkgver=0.7.0
pkgrel=1
pkgdesc='Python bindings for SparseDiffEngine'
url='https://github.com/SparseDifferentiation/SparseDiffPy'
license=(Apache-2.0)
arch=(x86_64)
depends=(cblas
         glibc
         python
         python-numpy)
makedepends=(git
             python-build
             python-installer
             python-scikit-build-core)
source=(git+https://github.com/SparseDifferentiation/SparseDiffPy#tag=v$pkgver
        git+https://github.com/SparseDifferentiation/SparseDiffEngine)
sha256sums=('40bdc368e62c31ba0d07c93044b9365f6749acdae293569b54c38cbf6dfe9895'
            'SKIP')

prepare() {
  cd $_pyname
  git submodule init
  git submodule set-url SparseDiffEngine "$srcdir"/SparseDiffEngine
  git -c protocol.file.allow=always submodule update SparseDiffEngine
}

build() {
  cd $_pyname
  python -m build --wheel --no-isolation \
    -C cmake.define.BLAS_LIBRARIES=-lcblas
}

package() {
  cd $_pyname
  python -m installer --destdir="$pkgdir" dist/*.whl
}
