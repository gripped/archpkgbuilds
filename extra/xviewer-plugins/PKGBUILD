# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=xviewer-plugins
pkgver=3.4.5
pkgrel=1
pkgdesc='Plugins for Xviewer'
arch=(x86_64)
url='https://github.com/linuxmint/xviewer-plugins'
license=(GPL-2.0-or-later)
depends=(
  cairo
  dconf
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  libexif
  libpeas
  osm-gps-map
  pango
  python
  python-gobject
  xviewer
)
makedepends=(
  git
  meson
)
source=("git+https://github.com/linuxmint/xviewer-plugins.git#tag=$pkgver")
b2sums=(8e0a91ef0bc7303ae0961adf3bd22991677ab05ec6a579fcca10f4d50ceee4ef805efc94f5d85e0d32f6ef2928201d5f68478a6b7a83a34ffd254846c58bbb8d)

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
