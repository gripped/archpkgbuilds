# Maintainer: Campbell Jones <serebit at archlinux dot org>
# Maintainer: Robin Candau <antiz at archlinux dot org>

pkgname=vulkan-profiles
pkgver=1.4.357.0
pkgrel=1
pkgdesc="Vulkan profiles tools"
arch=('x86_64')
url="https://github.com/KhronosGroup/Vulkan-Profiles"
license=('Apache-2.0 AND CC-BY-4.0 AND BSL-1.0')
groups=(vulkan-devel)
depends=(
	glibc
	libgcc
	libstdc++
	jsoncpp
	python
	python-jsonschema
	vulkan-headers
)
makedepends=(
	cmake
	git
	ninja
	valijson
	vulkan-utility-libraries
)
checkdepends=()
conflicts=()
replaces=()
source=("git+https://github.com/KhronosGroup/Vulkan-Profiles#tag=vulkan-sdk-$pkgver"
        "fix-jsoncpp-detection.patch")
b2sums=('9294699c6b0a7bc925a993bcedc646c4fa7f7d1ae65ffc6a70288d95de4a85e9f808fe2c49e73d969018e44f632f2c412b785b2cf30acd328ddf2819d06ab9ea'
        'e91049b3ec81e996a6694bc269c43aee29274059dbf001711063f67712d5317b577e8317ed005346b219ea550b3537b8be72110fb2e1ccc6cdf0fdf95b89d001')

prepare() {
	cd "Vulkan-Profiles"

	git apply -3 ../fix-jsoncpp-detection.patch
}

build() {
	local cmake_options=(
		-D CMAKE_BUILD_TYPE=Release
		-D CMAKE_INSTALL_PREFIX=/usr
		-D CMAKE_INSTALL_DATADIR=/usr/share
		-D CMAKE_INSTALL_SYSCONFDIR=/etc
		-D CMAKE_SKIP_INSTALL_RPATH=ON
	)

	cmake -S Vulkan-Profiles -B build -G Ninja "${cmake_options[@]}"
	cmake --build build
}

check() {
	ctest --test-dir build --output-on-failure --stop-on-failure
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
