# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=kylin-burner
pkgver=3.0.11
pkgrel=1
pkgdesc="CD and DVD burning application for UKUI"
arch=('x86_64')
license=('GPL-2.0-or-later' 'GPL-3.0-or-later' 'LGPL-2.0-or-later' 'LGPL-3.0-or-later'
         'GFDL-1.1-no-invariants-or-later')
url="https://gitee.com/openkylin/kylin-burner"
groups=('ukui')
depends=('cairo' 'cdrtools' 'dconf' 'dvd+rw-tools' 'gdk-pixbuf2' 'glib2' 'glibc'
         'gst-plugins-base' 'gst-plugins-base-libs' 'gst-plugins-good' 'gstreamer' 'gtk3'
         'gvfs' 'hicolor-icon-theme' 'libburn' 'libcanberra' 'libice' 'libisofs' 'libnotify'
         'libsm' 'libxml2' 'pango' 'tinysparql' 'totem-pl-parser')
makedepends=('git' 'glib2-devel' 'gobject-introspection' 'gtk-doc' 'intltool' 'yelp-tools')
optdepends=('cdrdao: Alternative backend for copying and burning CDs'
            'dvdauthor: Video DVD creation'
            'libdvdcss: Reading encrypted video DVDs'
            'localsearch: Indexed file search'
            'vcdimager: Video CD creation')
provides=('libburner-burn3.so' 'libburner-media3.so')
source=("git+https://salsa.debian.org/kylin-team/kylin-burner.git#tag=debian/$pkgver-3")
sha512sums=('5c99afd3090e28c56a707459f5617b94eebb851ab80cb561fc976ee4ac4cca196a29d57aaa6b7199ca9c29a84575d36868cf5a4e09057185e2375ef4154e4b57')

prepare() {
  cd kylin-burner
  # Debian's fixes remove obsolete build macros and fix marshal generation.
  local patch
  while read -r patch; do
    patch -Np1 -i "debian/patches/$patch"
  done < debian/patches/series
  autoreconf -fiv
}

build() {
  cd kylin-burner
  ./configure --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --disable-static \
    --disable-caches \
    --disable-cdrkit \
    --disable-nautilus \
    --enable-cdrtools \
    --enable-libburnia \
    --enable-search \
    --enable-introspection \
    --enable-gtk-doc
  make
}

package() {
  cd kylin-burner
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
