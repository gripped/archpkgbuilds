# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-compressor
pkgver=6.5.38
pkgrel=1
pkgdesc='A fast and lightweight application for creating and extracting archives'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-compressor"
license=('GPL-3.0-or-later')
depends=('dtk6core' 'dtk6gui' 'dtk6widget' 'glibc' 'libgcc' 'libstdc++' 'qt6-base' 'qt6-svg' 'qt6-5compat' 'glib2'
         'karchive' 'kcodecs' 'libarchive' 'libzip' 'minizip' 'util-linux-libs' 'hicolor-icon-theme' 'deepin-picker' '7zip'
         'deepin-shortcut-viewer')
makedepends=('git' 'cmake' 'ninja' 'qt6-declarative' 'qt6-tools')
groups=('deepin-extra')
source=("git+https://github.com/linuxdeepin/deepin-compressor.git#tag=$pkgver")
sha512sums=('9efc77aec1d35d7afc878b775327b4ecd8b628f2dda7837e51a0c83e662dda201b97822b2aa543cff0de1ac6f34f3bb7f4e5ec164319bdc731a8ebe75f76f3c7')

build() {
  cd deepin-compressor
  cmake . -GNinja -DCMAKE_INSTALL_LIBDIR=/usr/lib -DVERSION=$pkgver
  ninja
}

package() {
  cd deepin-compressor
  DESTDIR="$pkgdir" ninja install
}
