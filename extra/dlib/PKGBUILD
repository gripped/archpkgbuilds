# Contributor: perlawk

pkgbase=dlib
pkgname=(dlib dlib-cuda)
pkgver=20.0
pkgrel=3
pkgdesc='Machine learning library and toolkit'
arch=(x86_64)
url='http://dlib.net'
license=(BSL-1.0)
depends=(blas cblas ffmpeg giflib lapack libjpeg-turbo libjxl libpng libwebp libx11 sqlite)
makedepends=(cmake cuda cudnn git)
options=(!debug !emptydirs !lto)
source=("git+https://github.com/davisking/dlib#tag=v$pkgver")
b2sums=('b41813d34b76793dd137ef7194081e71dc3110c5aef8d896705e7586a2a519a211b472faf34b14f2d3fcc7d68f3ff24c39d44eb88e433ab322fdeec670925d3c')

prepare() {
  # use Turing as the minimum for CUDA 13+
  sed -i 's/-arch=sm_50/-arch=sm_75/' \
    $pkgbase/dlib/cmake_utils/test_for_cuda/CMakeLists.txt
}

build() {
  cmake \
    -B build \
    -D BUILD_SHARED_LIBS=ON \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_INSTALL_LIBDIR=/usr/lib \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D DLIB_USE_CUDA=OFF \
    -D USE_AVX_INSTRUCTIONS=OFF \
    -D USE_SSE2_INSTRUCTIONS=ON \
    -S $pkgname
  make -C build

  cmake \
    -B build-cuda \
    -D BUILD_SHARED_LIBS=ON \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_INSTALL_LIBDIR=/usr/lib \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D DLIB_USE_CUDA=ON \
    -D DLIB_USE_CUDA_COMPUTE_CAPABILITIES="75,80,86,89,90" \
    -D USE_AVX_INSTRUCTIONS=OFF \
    -D USE_SSE2_INSTRUCTIONS=ON \
    -S $pkgname
  make -C build-cuda
}

package_dlib() {
  make -C build DESTDIR="$pkgdir" install
  install -Dm644 $pkgbase/LICENSE.txt \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # remove redundant external libraries
  rm -r "$pkgdir/usr/include/dlib/external"
}

package_dlib-cuda() {
  pkgdesc='Machine learning library and toolkit (CUDA)'
  depends+=(cuda cudnn)
  conflicts=(dlib)
  replaces=(dlib)

  make -C build-cuda DESTDIR="$pkgdir" install
  install -Dm644 $pkgbase/LICENSE.txt \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # remove redundant external libraries
  rm -r "$pkgdir/usr/include/dlib/external"
}
