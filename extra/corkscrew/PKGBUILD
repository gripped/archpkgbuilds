# Maintainer: Jaroslav Lichtblau <svetlemodry@archlinux.org>
# Contributor: gothmog.todi <t.haider@vcnc.org>

pkgname=corkscrew
pkgver=3.1
pkgrel=1
pkgdesc="A tool for tunneling SSH through HTTP proxies"
arch=('x86_64')
url="https://github.com/patpadgett/corkscrew"
license=('MIT')
source=($pkgname-$pkgver.tar.gz::https://github.com/patpadgett/$pkgname/releases/download/$pkgver/$pkgname-$pkgver.tar.gz)
sha256sums=('dcff7110521d5a3d672ba3c32db95b597a3396eb657deefc64ad47453fa29d6d')

prepare() {
  cd "${srcdir}"/$pkgname-$pkgver

  autoreconf -fi
}

build() {
  cd "${srcdir}"/$pkgname-$pkgver

  ./configure --prefix=/usr
  make
}

check() {
  cd "${srcdir}"/$pkgname-$pkgver

  make check
}

package() {
  cd "${srcdir}"/$pkgname-$pkgver

  make DESTDIR="${pkgdir}" install
  install -Dm 644 LICENSE -t "${pkgdir}"/usr/share/licenses/corkscrew
}
