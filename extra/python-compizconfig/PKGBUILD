# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=python-compizconfig
_pkgname=compizconfig-python
pkgver=0.8.18
pkgrel=1
pkgdesc='Python bindings for compizconfig'
arch=(x86_64)
url='https://gitlab.com/compiz/compizconfig-python'
license=(GPL-2.0-or-later)
depends=(
  glib2
  glibc
  libcompizconfig
)
makedepends=(
  compiz-core
  cython
  git
)
source=("git+https://gitlab.com/compiz/compizconfig-python.git#tag=v$pkgver")
b2sums=(e14374b7243ef04aeb45d24e4901e598cf2cf50bbf24f51e0a5db87318a1709ad4a18cfc0346d6d8d19e1a925a06f4ab3ea99efe4edcd0f7dbab87e9362e6dbb)

prepare() {
  cd $_pkgname
  autoreconf -fiv
}

build() {
  cd $_pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd $_pkgname
  make DESTDIR="$pkgdir" install
}
