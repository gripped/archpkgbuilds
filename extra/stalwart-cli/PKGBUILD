# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-cli
pkgver=1.0.10
pkgrel=1
pkgdesc='A schema-driven command line tool for administering Stalwart'
arch=(x86_64)
url='https://github.com/stalwartlabs/cli'
license=(AGPL-3.0-only)
depends=(
  glibc
  libgcc_s.so
)
makedepends=(
  git
  rust
)
options=(!lto) # aws_lc crates cause linking errors
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('35add7fc8b7734d0116d363e38d05fbc4570e007c00bfe041799b40b47227cf93e33ad93d92dfa1c4c10d2cc1e35ed1cd78b3d9388d0a82c1a79492c95b9a01d')
b2sums=('7d915787bace8f4afdb4005f2a2b0557bbf4ef7e8af59f0b9ccc7a65029b669247ca2a092c4b4f15a4cacf78b13457e0a5d67294d54b4bef42be498edc606a8a')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release --all-features
}

package() {
  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" "target/release/$pkgname"
}
