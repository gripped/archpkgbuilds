# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-cli
pkgver=1.0.6
pkgrel=1
pkgdesc='A schema-driven command line tool for administering Stalwart'
arch=(x86_64)
url='https://github.com/stalwartlabs/cli'
license=(AGPL-3.0-only)
depends=(
  glibc
  libgcc_s.so
)
makedepends=(
  git
  rust
)
options=(!lto) # aws_lc crates cause linking errors
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('1390be59140b39b675e8c4da90747890752d61bc158930a577c008cce3941d60c9d2a06c0940536685940b8ae43d94bbbb01a54c9f255bff94dcede62a538347')
b2sums=('48da9b56cdc004af6bcd558175b5078be89aea32797892cc2c66de60358c529bf3edfa1e7ba21ccece52e6435658333dd7fb5ae69de8bb825a8fcd2fe4a42d8a')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release --all-features
}

package() {
  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" "target/release/$pkgname"
}
