# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-cli
pkgver=1.0.7
pkgrel=1
pkgdesc='A schema-driven command line tool for administering Stalwart'
arch=(x86_64)
url='https://github.com/stalwartlabs/cli'
license=(AGPL-3.0-only)
depends=(
  glibc
  libgcc_s.so
)
makedepends=(
  git
  rust
)
options=(!lto) # aws_lc crates cause linking errors
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('ba3fe315a800a39cd80ec3c10cd7b6c2c204e394bdbef82924ffa776f74b4ff8ea1617900086d74e6b1ac8249499a408d7e2498ad4707faa52b86845b71cc6e0')
b2sums=('256899cb16d86f96865cae219fbef9c7327059cc5d05ec962b17511ba8234d4629a92ddee10eeba050347c06c3a96a75ac18c9fc91544bdec3ec7570b05cd838')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release --all-features
}

package() {
  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" "target/release/$pkgname"
}
