# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-cli
pkgver=1.0.11
pkgrel=1
pkgdesc='A schema-driven command line tool for administering Stalwart'
arch=(x86_64)
url='https://github.com/stalwartlabs/cli'
license=(AGPL-3.0-only)
depends=(
  glibc
  libgcc_s.so
)
makedepends=(
  git
  rust
)
options=(!lto) # aws_lc crates cause linking errors
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('d78966152f62261cc8916bc52572e25df1bd1899444fdcba5229b128792540ddc971bf83550930b28e50012a6b7904b506cba7340b00910c8e5228dea86580b2')
b2sums=('1d496edba8f5ae8dadc545c42726c69457fea71ce017312e65621d853baeddce8489933e5a1446ea75b8bd7013cdc8ab3ce6b36fb864a5fe046e8227549e9225')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release --all-features
}

package() {
  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" "target/release/$pkgname"
}
