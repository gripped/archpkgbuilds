# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-cli
pkgver=1.0.14
pkgrel=1
pkgdesc='A schema-driven command line tool for administering Stalwart'
arch=(x86_64)
url='https://github.com/stalwartlabs/cli'
license=(AGPL-3.0-only)
depends=(
  glibc
  libgcc_s.so
)
makedepends=(
  git
  rust
)
options=(!lto) # aws_lc crates cause linking errors
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('9e14801b4787afc3b8ce89bdf921076a0741718e9cacfe53aa42a8e061883681f13c4eb2bdae82047d66ec9bb15331887279591a529a4dbb9a41de0f85e1a2eb')
b2sums=('cd813a7c29ae8a4b0e78fcdef9d1f2b4075dc5484483a5a99d9f576d150a4ced1db54c5bcbbbc092f5ad59d960914c0a118844f6a313df950d9c980a12a6048f')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release --all-features
}

package() {
  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" "target/release/$pkgname"
}
