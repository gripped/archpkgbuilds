# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-cli
pkgver=1.0.12
pkgrel=1
pkgdesc='A schema-driven command line tool for administering Stalwart'
arch=(x86_64)
url='https://github.com/stalwartlabs/cli'
license=(AGPL-3.0-only)
depends=(
  glibc
  libgcc_s.so
)
makedepends=(
  git
  rust
)
options=(!lto) # aws_lc crates cause linking errors
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('e1f0621e4a8fb7b38f82dd17e5b14ec7574789e6242808bbf17c90009d7ac255bbb7e374461ecced9e1122a7d0685467f3b442a8de7dd571b7882d7a399389c0')
b2sums=('6208d3da318e036644a47397c286f686712501020c0c4177a00bca9d207bbed0fdc9a7abe4fea574381075818adf68dfb138a4cd3999c22082d13dcddb993e7e')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release --all-features
}

package() {
  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" "target/release/$pkgname"
}
