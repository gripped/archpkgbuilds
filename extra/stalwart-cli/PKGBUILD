# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-cli
pkgver=1.0.8
pkgrel=1
pkgdesc='A schema-driven command line tool for administering Stalwart'
arch=(x86_64)
url='https://github.com/stalwartlabs/cli'
license=(AGPL-3.0-only)
depends=(
  glibc
  libgcc_s.so
)
makedepends=(
  git
  rust
)
options=(!lto) # aws_lc crates cause linking errors
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('e7e517132924c5ce21f874e3520746f2d0ef5442ffb7c9a374c306feccdb51f5db37d155ba1bf15e8d042f5dfd3c9037a09e342cc2d5d7ec4b5a5be085c8e762')
b2sums=('5bcf816b0f7f83d70b67e6d6f76300c7e9e797adc079697b899354d24f00b286f26ee0f2c9930de20cc90379b139ffbbb84bfeae8655dcd0d513f95c5ff56ede')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release --all-features
}

package() {
  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" "target/release/$pkgname"
}
