# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=stalwart-cli
pkgver=2.0.0
pkgrel=1
pkgdesc='A schema-driven command line tool for administering Stalwart'
arch=(x86_64)
url='https://github.com/stalwartlabs/cli'
license=(AGPL-3.0-only)
depends=(
  glibc
  libgcc_s.so
)
makedepends=(
  git
  rust
)
options=(!lto) # aws_lc crates cause linking errors
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('41125ec36b2163c0cd422d2156e6346050a3f292e53b6ec77ac81584b739e248baf9cd8e434de097857bf14902ed35760dfd6a72b20e9a318e2a958a6bc5c0b8')
b2sums=('c4bb81d449606d7bce03930d96c99a3bbdc3873b26dcf3ff326b9339096c9b026d5529de9ee9f6b60e37ed3eaeab9ad09d4754233da94e277006eafb7890acd0')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  cargo build --frozen --release --all-features
}

package() {
  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" "target/release/$pkgname"
}
