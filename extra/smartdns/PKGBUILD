# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: zlowly <zlowly@gmail.com>

pkgname=smartdns
pkgver=48.5
pkgrel=1
pkgdesc="A local DNS server to obtain the fastest website IP for the best Internet experience"
arch=('x86_64')
license=('GPL-3.0-or-later')
url="https://github.com/pymumu/smartdns"
backup=("etc/smartdns/smartdns.conf" "etc/default/smartdns")
depends=('glibc' 'libgcc' 'openssl' 'zlib')
makedepends=('git' 'systemd')  # systemd.pc
checkdepends=('gtest' 'bind')
source=("git+https://github.com/pymumu/smartdns.git#tag=Release$pkgver")
sha512sums=('bc29fe6527c1aad1c8bb04835fab31f461754adaf0981874959c86993fe2e7f3f52ba09b0bf0008d7428a84fd25a018f0f091106f35fcb4adae9f6097e96eb9e')

prepare() {
  # Unfortunately upstream does not provide a way to reuse .o files
  cp -a smartdns smartdns-test
  # The 40 ms limit is too tight for shared build workers.
  sed -i 's/EXPECT_LT(client.GetQueryTime(), 40)/EXPECT_LT(client.GetQueryTime(), 200)/' \
    smartdns-test/test/cases/test-speed-check.cc
}

build() {
  cd smartdns
  make RUNSTATEDIR=/run SBINDIR=/usr/bin
}

check() {
  cd smartdns-test
  make -C test test
}

package() {
  cd smartdns
  make RUNSTATEDIR=/run SBINDIR=/usr/bin DESTDIR="$pkgdir" install

  rm -r "$pkgdir"/etc/init.d
}
