+#endif
 
     int curr_index;             // Indice dell'immagine che si sta processando dalla lista iAList
 
@@ -167,9 +173,11 @@ private slots:
 
     void openPaypalLink();
 
+#ifndef DISABLE_CHECK_UPDATES
