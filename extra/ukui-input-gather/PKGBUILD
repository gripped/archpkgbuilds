# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=ukui-input-gather
pkgver=4.0.0.0
pkgrel=1
pkgdesc="Input event distribution service and client library for UKUI"
arch=('x86_64')
license=('GPL-3.0-or-later')
url="https://gitee.com/openkylin/ukui-input-gather"
groups=('ukui')
depends=('glibc' 'libevdev' 'libgcc' 'libinput' 'libstdc++' 'libx11' 'libxi'
         'qt6-base' 'systemd-libs')
makedepends=('git')
provides=('libukuiinputgatherclient.so')
source=("git+https://gitee.com/openkylin/ukui-input-gather.git#tag=debian/$pkgver-1")
sha512sums=('9fa85b47a40a7f5a2d6dc1cf6d1907fbdd6f904aa841455c43a73d5329b06837c214525898b00b927a4dd27bb1b0237d5989bf4bae64a1988f37dc958d5d7924')

prepare() {
  cd ukui-input-gather
  # Use the system library search path instead of Debian's multiarch directory.
  sed -i 's|-L/usr/lib/x86_64-linux-gnu/ ||' ukui-input-gather/ukui-input-gather.pro
}

# The upstream integration test requires the system service and physical input devices.
build() {
  cd ukui-input-gather
  qmake6 \
    QMAKE_CFLAGS_RELEASE="$CPPFLAGS $CFLAGS" \
    QMAKE_CXXFLAGS_RELEASE="$CPPFLAGS $CXXFLAGS" \
    QMAKE_LFLAGS_RELEASE="$LDFLAGS"
  make
}

package() {
  cd ukui-input-gather
  make INSTALL_ROOT="$pkgdir" install
  install -Dm644 */man/*.1 -t "$pkgdir/usr/share/man/man1"
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
