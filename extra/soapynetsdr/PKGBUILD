# Maintainer: Filipe Laíns (FFY00) <lains@archlinux.org>

pkgname=soapynetsdr
pkgver=0.2.1
_pkgname=SoapyNetSDR
_gitver=soapy-netsdr-$pkgver
pkgrel=2
pkgdesc='Soapy SDR plugin for the NetSDR protocol'
arch=('x86_64')
url='https://github.com/pothosware/SoapyNetSDR'
license=('MIT AND BSL-1.0')
depends=('glibc' 'libstdc++' 'libgcc' 'soapysdr')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_gitver.tar.gz")
sha512sums=('3afee8065c4cf5284ce94801ca45e47c6d87edd641f04f8802fb2017b5f8d9a958c3a8225af86e08cb06c4f5c3d29b1f92deb7c0c0b32ce9dc1a12f109ed20ca')

build() {
  mkdir -p $_pkgname-$_gitver/build
  cd $_pkgname-$_gitver/build

  cmake .. \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release

  make
}

package() {
  cd $_pkgname-$_gitver/build

  make DESTDIR="$pkgdir" install
  install -Dm644 ../License.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

