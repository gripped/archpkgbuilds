pkgname=soapyplutosdr
pkgver=0.2.4
pkgrel=1
pkgdesc='Soapy SDR plugin for PlutoSDR'
arch=('x86_64')
url='https://github.com/pothosware/SoapyPlutoSDR'
license=('LGPL-2.1-only')
depends=(
  'glibc'
  'libad9361'
  'libgcc'
  'libiio.so'
  'libstdc++'
  'libusb'
  'soapysdr'
)
makedepends=(
  'cmake'
  'git'
)
source=("$pkgname::git+$url.git#tag=soapy-plutosdr-$pkgver")
b2sums=('28e8f7ae231386e5b9208af2624ccbefc1c4b61c0f90c58ca09e2c67869943a02fee6575189f9a325aafaf957de0950c6b6d792a4d0e97e43f360ccc08620184')

build() {
  cmake -S $pkgname -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
