# Maintainer: Giovanni Harting <anonfunc@archlinux.org>
# Contributor: sgar < swhaat at github >

pkgname=python-aioesphomeapi
_name=${pkgname#python-}
pkgver=45.7.0
pkgrel=1
pkgdesc='Python Client for ESPHome native API'
arch=(x86_64)
url='https://github.com/esphome/aioesphomeapi'
depends=(
  glibc
  python
  python-aiohappyeyeballs
  python-async_interrupt
  python-protobuf
  python-zeroconf
  python-chacha20poly1305-reuseable
  python-cryptography
  python-noiseprotocol
  python-tzdata
  python-tzlocal
)
makedepends=(python-build python-installer python-wheel python-setuptools git cython)
license=(MIT)
source=(git+$url.git#tag=v$pkgver)
b2sums=('5e5d8209e759d9da80b31c5059e87f7fe395abee927b3d5cc884f45fc7940849253a13e9b9d6f2ad7c436d4628ec89fc4704894460997ab89cc5cdfd63e230ba')

prepare() {
  cd $_name
  sed -i -E 's/[<>=!~;].*//' requirements/base.txt
}

build() {
  cd $_name
  python -m build --wheel --no-isolation
}

package() {
  cd $_name
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

