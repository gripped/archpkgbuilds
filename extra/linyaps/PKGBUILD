# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: taotieren <admin@taotieren.com>

pkgname=linyaps
pkgver=1.13.0
pkgrel=1
pkgdesc='Next-Gen Universal Package Manager for Linux (linglong)'
arch=(x86_64)
url='https://github.com/OpenAtom-Linyaps/linyaps'
license=('LGPL-3.0-or-later')
provides=(
  linglong
)
conflicts=(
  linglong
)
depends=(
  bash
  curl
  erofs-utils
  erofsfuse
  fmt
  glib2
  glibc
  hicolor-icon-theme
  libcap
  libelf
  libgcc
  libseccomp
  libstdc++
  linyaps-box
  qt6-base
  systemd-libs
  ostree
  util-linux-libs
  yaml-cpp
)
makedepends=(
  cli11
  cmake
  git
  gtest
  qt6-tools
  ninja
  nlohmann-json
  openssl
  tl-expected
  util-linux
  vulkan-headers
)
source=(
  git+https://github.com/OpenAtom-Linyaps/linyaps.git#tag=$pkgver
)
sha256sums=('c80f57aa46ad1d527c4ce8a6cc3c06b1a64ae83585effa65f371f5de32ea01c4')

prepare() {
  cd linyaps
  # Fix tests without /etc/localtime: https://github.com/OpenAtom-Linyaps/linyaps/pull/1680
  git cherry-pick -n 2177b06d9097179f5102374bdf88b5b9383f5583
}

build() {
  cd linyaps
  cmake \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DENABLE_CPM=OFF \
    -DLINGLONG_VERSION="$pkgver" \
    -Wno-dev \
    -B build \
    -G Ninja

  ninja -C build
}

check() {
  ninja -C linyaps/build test
}

package() {
  DESTDIR="$pkgdir" ninja -C linyaps/build install
}
