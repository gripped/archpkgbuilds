# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: taotieren <admin@taotieren.com>

pkgname=linyaps
pkgver=1.12.3
pkgrel=1
pkgdesc='Next-Gen Universal Package Manager for Linux (linglong)'
arch=(x86_64)
url='https://github.com/OpenAtom-Linyaps/linyaps'
license=('LGPL-3.0-or-later')
provides=(
  linglong
)
conflicts=(
  linglong
)
depends=(
  bash
  curl
  erofs-utils
  erofsfuse
  fmt
  glib2
  glibc
  hicolor-icon-theme
  libcap
  libelf
  libgcc
  libseccomp
  libstdc++
  linyaps-box
  qt6-base
  systemd-libs
  ostree
  util-linux-libs
  yaml-cpp
)
makedepends=(
  cli11
  cmake
  git
  gtest
  libcap
  qt6-tools
  ninja
  nlohmann-json
  openssl
  tl-expected
  util-linux
  vulkan-headers
)
source=(
  git+https://github.com/OpenAtom-Linyaps/linyaps.git#tag=$pkgver
)
sha256sums=('c689e7fd14bcf3f3298585996109489a402b1edf0126dae2979eaf8d0b468c18')

build() {
  cd linyaps
  cmake \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DENABLE_CPM=OFF \
    -DLINGLONG_VERSION="$pkgver" \
    -Wno-dev \
    -B build \
    -G Ninja

  ninja -C build
}

check() {
  ninja -C linyaps/build test
}

package() {
  DESTDIR="$pkgdir" ninja -C linyaps/build install
}
