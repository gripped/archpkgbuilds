pkgname=miopen-hip
pkgver=10.1
pkgrel=1
# pin frugally-deep version as workaround workaround for https://github.com/ROCm/MIOpen/issues/3588
_fdeep_ver=0.15.31
pkgdesc="AMD's Machine Intelligence Library (HIP backend)"
arch=('x86_64')
url="https://rocm.docs.amd.com/projects/MIOpen/en/latest/index.html"
license=('MIT')
depends=(
  'bzip2'
  'comgr'
  'composable-kernel'
  'glibc'
  'hip-runtime-amd'
  'hipblas'
  'hipblaslt'
  'libgcc'
  'rocblas'
  'rocm-core'
  'rocrand'
  'roctracer'
  'sqlite'
)
makedepends=(
  'cmake'
  'eigen'
  'functional-plus'
  'git'
  'lbzip2'
  'ninja'
  'nlohmann-json'
  'rocm-cmake'
  'rocm-toolchain'
  'rocm-llvm'
)
provides=('miopen')
conflicts=('miopen')
_git='https://github.com/ROCm/rocm-libraries'
source=(
  "$pkgname-$pkgver.tar.gz::$_git/releases/download/therock-$pkgver/miopen.tar.gz"
  "${pkgname}-half-$pkgver.tar.gz::https://github.com/ROCm/half/archive/therock-$pkgver.tar.gz"
  "${pkgname}-frugally-deep::git+https://github.com/Dobiasd/frugally-deep#tag=v$_fdeep_ver"
)
sha256sums=('1134726a9ffad9da77db3716031241fbe48f792a268bc83daf01cc6e33fe29d8'
            '6881b646760d4964e1753fd44635aeadd4936a60d2949196c123da4387fb8abe'
            'd1e1d55945eded7219c50f59f55967327118d6792df5a283c01131b18a3f061f')
options=(!lto)
_dirname=miopen

prepare() {
  cd "$_dirname"

  # Disable tests as they require an AMD GPU at build time
  sed -i '/add_subdirectory(test)/d' CMakeLists.txt

  # MIOpen includes half/half.hpp
  install -Dm644 "$srcdir/half-therock-$pkgver/include/half.hpp" "$srcdir/half/half/half.hpp"
}

build() {
  local fdeep_args=(
    -S $pkgname-frugally-deep
        -B build-frugally-deep
        -Wno-dev
        -DCMAKE_BUILD_TYPE=None
        -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
  )
  cmake "${fdeep_args[@]}"
  cmake --build build-frugally-deep
  DESTDIR="$srcdir/deps" cmake --install build-frugally-deep

  # Only the CK plugins MIOpenCKGroupedConv_<gfx>.so use GPU_TARGETS. Use the
  # plugin targets of src/ck_impl/CMakeLists.txt that composable-kernel has.
  # gfx9-generic does not cover gfx908 and gfx90a.
  local _gpu_targets="$(rocm-supported-gfx -e gfx9-generic,gfx1010,gfx1012,gfx1030,gfx1031,gfx1035,gfx1036,gfx1103,gfx1170,gfx1250);gfx908;gfx90a"

  # -g also emits DWARF for every GPU target into .hip_fatbin, which strip
  # does not remove. Keep host debug info only.
  # define NDEBUG to silence internal logging (mimics cmake release build)
  # https://rocmsoftwareplatform.github.io/MIOpen/doc/html/DebugAndLogging.html
  local _flags="${CXXFLAGS} -Xarch_device -g0 -fcf-protection=none -DNDEBUG"
  local cmake_args=(
    -Wno-dev
    -G Ninja
    -B build
    -S "$_dirname"
    -D CMAKE_CXX_FLAGS="$_flags"
    # The vendored hipconv uses the HIP language. Its gfx950 kernels need
    # optimization and more constexpr steps for their static_asserts.
    -D CMAKE_HIP_FLAGS="$_flags -fconstexpr-steps=2097152"
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_CXX_COMPILER=amdclang++
    # The standalone build fetches missing dependencies from the internet
    -D MIOPEN_STANDALONE_BUILD=OFF
    -D MIOPEN_BACKEND=HIP
    -D HALF_INCLUDE_DIR="$srcdir/half"
    -D CMAKE_PREFIX_PATH="$srcdir/deps/usr/lib/cmake"
    -D CMAKE_POLICY_VERSION_MINIMUM=3.5
    # The assembler path is compiled into libMIOpen
    -D MIOPEN_AMDGCN_ASSEMBLER_PATH=/opt/rocm/lib/llvm
    # Link each MIOpenCKGroupedConv_<gfx>.so only against the CK code of its
    # target, not against all targets in libdevice_conv_operations.a
    -D MIOPEN_CK_UNBUNDLE_PER_ARCH=ON
    -D MIOPEN_OFFLOAD_BUNDLER=/opt/rocm/lib/llvm/bin/clang-offload-bundler
    -D MIOPEN_LLVM_OBJCOPY=/opt/rocm/lib/llvm/bin/llvm-objcopy
    -D GPU_TARGETS="$_gpu_targets"
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$_dirname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
