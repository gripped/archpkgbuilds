# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=eclib
pkgver=20261021
pkgrel=1
pkgdesc='Includes mwrank (for 2-descent on elliptic curves over Q) and modular symbol code used to create the elliptic curve database'
arch=(x86_64)
url='https://github.com/JohnCremona/eclib/'
license=(GPL-2.0-or-later)
depends=(boost-libs
         flint
         glibc
         libgcc
         libstdc++
         ntl
         pari)
makedepends=(boost
             git)
source=(git+https://github.com/JohnCremona/eclib#tag=v$pkgver
        boost-1.89.patch)
sha256sums=('02649727f1349d02686d0ac082461b64ff145ebbeeb03333430fdfb42772b291'
            'c45a79f7a74b47a3150438a5d1dacba44f14681a2e9534cb25d2dfffa2cfd073')

prepare() {
  cd $pkgname
  patch -p1 -i ../boost-1.89.patch
  autoreconf -vif
}

build() {
  cd $pkgname
  ./configure --prefix=/usr --with-flint=/usr --with-boost
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool # Fix overlinking
  make
}

check() {
  cd $pkgname
  make check
}

package() {
  cd $pkgname
  make install DESTDIR="$pkgdir"
}
