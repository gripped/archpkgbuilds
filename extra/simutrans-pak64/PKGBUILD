pkgname=simutrans-pak64
pkgver=124.4
pkgrel=1
pkgdesc='Low resolution graphics set for Simutrans'
arch=(any)
url='https://www.simutrans.com/'
license=(Artistic-1.0)
provides=(simutrans-pak)
options=(
  !strip
  !debug
)
source=(
  "https://downloads.sourceforge.net/simutrans/simupak64-${pkgver//./-}.zip"
  licence.txt::https://sourceforge.net/p/simutrans/code/2223/tree/pak64/licence.txt?format=raw
)
b2sums=(
  fa3e05109260e6ad99844e9b3daf0c0a74dac8d840d91eab69cf92483e2a5a9ed8770afa6541ea6a94c1c1a726a4cccd1dee781327ef3634360b09676e62adda
  4ef95f3f8fd1d0a5b27bf27ea6c349e2ad640eeb601b469c9b97129351d291bc56b9f39cb344c9d0462d7afc72984cafd245a266361161e341d066c20db40c7e
)

package() {
  chmod -R 644 simutrans

  #data
  mkdir -p "$pkgdir/usr/share/games/simutrans"
  cp -r simutrans/pak "$pkgdir/usr/share/games/simutrans"

  find "$pkgdir" -type f -exec chmod 644 {} \;
  find "$pkgdir" -type d -exec chmod 755 {} \;

  #license
  install -Dm644 -t "$pkgdir/usr/share/licenses/simutrans-pak64/" licence.txt
}
