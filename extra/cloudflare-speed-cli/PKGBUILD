# Maintainer: Orhun Parmaksız <orhun@archlinux.org>

pkgname=cloudflare-speed-cli
pkgver=1.0.1
pkgrel=1
pkgdesc="CLI for internet speed test via Cloudflare "
url="https://github.com/kavehtehrani/cloudflare-speed-cli"
depends=('glibc' 'libgcc')
makedepends=('cargo')
arch=('x86_64')
license=('GPL-3.0-only')
source=("${pkgname}-${pkgver}.tar.gz::$url/archive/v$pkgver.tar.gz")
sha512sums=('fa7ff9450d6b8cec0598aa9b636df68c63aca91bc714f2231d7c4db4e09942bcaed6fe2d5e430741fccbec9b6be483002c76dbc211ff6490fc92c5297369e25b')
options=('!lto')

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "${pkgname}-${pkgver}"
  cargo build --release --frozen
}

check() {
  cd "${pkgname}-${pkgver}"
  cargo test --frozen
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm 755 "target/release/$pkgname" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm 644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
}

# vim:set ts=2 sw=2 et:
