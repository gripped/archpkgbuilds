# Maintainer: Torsten Keßler <tpkessler at archlinux dot org>
# Maintainer: Christian Heusel <gromit@archlinux.org>

pkgname=rocdecode
pkgver=10.1
pkgrel=1
pkgdesc='High performance video decode SDK for AMD hardware'
arch=('x86_64')
url='https://rocm.docs.amd.com/projects/rocDecode/en/latest/'
license=('MIT')
depends=(
  'ffmpeg'
  'glibc'
  'hip-runtime-amd'
  'libdrm'
  'libgcc'
  'libva'
  'mesa'
  'rocm-core'
  'rocprofiler-register'
)
makedepends=(
  'cmake'
  'rocm-cmake'
  'rocm-llvm'
)
_git='https://github.com/ROCm/rocm-systems'
source=("$pkgname-$pkgver.tar.gz::$_git/releases/download/therock-$pkgver/$pkgname.tar.gz")
sha256sums=('415b36e00e5789eed203eb36eb48087df62b364b90e6e3ca11031847635020f2')

build() {
  # -fcf-protection is not supported by HIP, see
  # https://rocm.docs.amd.com/projects/llvm-project/en/latest/reference/rocmcc.html#support-status-of-other-clang-options
  local cmake_args=(
    -Wno-dev
    -S "$pkgname"
    -B build
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_C_COMPILER=amdclang
    -D CMAKE_CXX_COMPILER=amdclang++
    -D CMAKE_CXX_FLAGS="${CXXFLAGS} -fcf-protection=none"
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    # The find modules search only in TheRock's $ROCM_PATH/lib/rocm_sysdeps
    -D LIBVA_LIBRARY=/usr/lib/libva.so
    -D LIBVA_DRM_LIBRARY=/usr/lib/libva-drm.so
    -D LIBVA_INCLUDE_DIR=/usr/include
    -D LIBDRM_AMDGPU_LIBRARY=/usr/lib/libdrm_amdgpu.so
    -D LIBDRM_AMDGPU_INCLUDE_DIR=/usr/include
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
