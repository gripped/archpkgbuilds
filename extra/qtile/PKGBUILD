b2sums=('a00ae552f1b64d5896e1fd849e4f9fedae3fbf477007e8e06b8735c36fb35e66138947b7d93408cfface57772c5d687e17701e9fdb93989be0976a92c21ca933'
        '870ed53a8354e2774f76881aa1b4092b7ae9918bf207d19096ea95d558a5d8b1ec1bd03dc581d98d54300dceba3fb25d26bf9828000af772d4de354b38f08fed')
validpgpkeys=(
  '3CCAB226289DE0160C61BDB418D18F1BC464DCA3' # Tycho Andersen <tycho@tycho.pizza>
  '35D92E7CC7357A81173EA1C974F9FDD20984FBEC' # Matt Colligan <mcol@posteo.net>
