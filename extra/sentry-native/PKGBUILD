# Maintainer: Carl Smedstad <carsme@archlinux.org>
# Maintainer: Robin Candau <antiz@archlinux.org>

pkgname=sentry-native
pkgver=0.14.0
pkgrel=2
pkgdesc="Sentry SDK for C, C++ and native applications"
arch=(x86_64)
url="https://github.com/getsentry/sentry-native"
license=(MIT)
depends=(
  curl
  glibc
  libgcc
  libstdc++
  zlib
)
makedepends=(
  cmake
  git
)
checkdepends=(
  dotnet-sdk
  python-flaky
  python-msgpack
  python-psutil
  python-pytest
  python-pytest-httpserver
  python-requests
)
provides=(libsentry.so)
source=(
  "git+$url.git#tag=$pkgver"
  "$pkgname-libunwindstack-ndk::git+https://github.com/getsentry/libunwindstack-ndk.git"
  "$pkgname-breakpad::git+https://github.com/getsentry/breakpad.git"
  "$pkgname-chromium-linux-syscall-support::git+https://github.com/getsentry/chromium-linux-syscall-support.git"
  "$pkgname-crashpad::git+https://github.com/getsentry/crashpad.git"
  "$pkgname-mini_chromium::git+https://github.com/getsentry/mini_chromium.git"
  "$pkgname-chromium-zlib::git+https://github.com/getsentry/chromium-zlib.git"
)
b2sums=('593df287e2d7ff0412d2a18ab7c4b4fc8479c68db04764db453dff0f120480af360c2ef5b92da9d4d9cc48ecdc68fe31cac044a7943fcc63d7dbb4f216929bc1'
        'SKIP'
        'SKIP'
        'SKIP'
        'SKIP'
        'SKIP'
        'SKIP')

prepare() {
  cd $pkgname
  git submodule init
  git config submodule.external/libunwindstack-ndk.url "$srcdir/$pkgname-libunwindstack-ndk"
  git config submodule.external/breakpad.url "$srcdir/$pkgname-breakpad"
  git config submodule.external/third_party/lss.url "$srcdir/$pkgname-chromium-linux-syscall-support"
  git config submodule.external/crashpad.url "$srcdir/$pkgname-crashpad"
  git -c protocol.file.allow=always submodule update

  cd external/crashpad
  git submodule init
  git config submodule.third_party/mini_chromium/mini_chromium.url "$srcdir/$pkgname-mini_chromium"
  git config submodule.third_party/zlib/zlib.url "$srcdir/$pkgname-chromium-zlib"
  git config submodule.third_party/lss/lss.url "$srcdir/$pkgname-chromium-linux-syscall-support"
  git -c protocol.file.allow=always submodule update
}

build() {
  cd $pkgname
  cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

check() {
  cd $pkgname
  # Ignore Windows tests & deselect test requiring .NET 8.0.
  pytest \
    --deselect tests/test_dotnet_signals.py::test_dotnet_signals_inproc \
    --deselect tests/test_dotnet_signals.py::test_aot_signals_inproc \
    --ignore external/crashpad/snapshot/win \
    --ignore external/crashpad/test/win
}

package() {
  cd $pkgname
  DESTDIR="$pkgdir" cmake --install build
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
