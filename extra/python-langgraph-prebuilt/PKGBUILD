# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-langgraph-prebuilt
pkgver=1.1.3
pkgrel=1
pkgdesc="Library with high-level APIs for creating and executing LangGraph agents and tools"
arch=('any')
url="https://github.com/langchain-ai/langgraph/tree/main/libs/prebuilt"
license=('MIT')
depends=(
  'python'
  'python-langchain-core'
  'python-langgraph-checkpoint'
  'python-pydantic'
  'python-typing_extensions'
)
makedepends=(
  'git'
  'python-build'
  'python-hatchling'
  'python-installer'
  'python-wheel'
)
checkdepends=(
  'pifpaf'
  'postgresql'
  'python-anyio'
  'python-langgraph-checkpoint-postgres'
  'python-langgraph-checkpoint-sqlite'
  'python-langgraph-sdk'
  'python-pytest'
  'python-pytest-asyncio'
  'python-pytest-mock'
  'python-syrupy'
  'python-xxhash'
)
source=("git+https://github.com/langchain-ai/langgraph.git")
sha512sums=('SKIP')

prepare() {
  cd langgraph

  # makepkg's git fragment parser treats "=" inside tag values as separators.
  git checkout -q "prebuilt==$pkgver"
}

build() {
  cd langgraph/libs/prebuilt
  python -m build --wheel --no-isolation
}

check() {
  cd langgraph/libs/prebuilt
  LANGGRAPH_TEST_FAST=0 PYTHONPATH="$srcdir"/langgraph/libs/langgraph \
    pifpaf run postgresql --port 5442 --host 127.0.0.1 -- \
    bash -c 'createuser --superuser postgres && python -m pytest'
}

package() {
  cd langgraph/libs/prebuilt
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
