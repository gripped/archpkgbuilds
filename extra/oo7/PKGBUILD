# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=oo7
pkgver=0.6.0
pkgrel=3
pkgdesc='A Secret Service provider'
arch=(x86_64)
url='https://linux-credentials.github.io/oo7/oo7/'
license=(MIT)
depends=(glibc
         libgcc)
makedepends=(git
             meson
             rust)
conflicts=(gnome-keyring)
provides=(org.freedesktop.secrets)
source=(git+https://github.com/linux-credentials/oo7#tag=$pkgver)
sha256sums=('83ba6e03392471f1381d756a10af20915ecab99cea8533bbd42aac995c5fc118')

prepare() {
  cd oo7
  export CARGO_HOME="$srcdir"/cargo-home
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd oo7
  export CARGO_HOME="$srcdir"/cargo-home
  cargo build --release --locked

  meson build-server server --prefix=/usr --libexecdir=lib
  meson compile -C build-server

  meson build-portal portal --prefix=/usr --libexecdir=lib
  meson compile -C build-portal

  meson build-pam pam --prefix=/usr --libexecdir=lib
  meson compile -C build-pam
}

package() {
  cd oo7
  export CARGO_HOME="$srcdir"/cargo-home
  for _dir in cargo-credential cli; do
    cargo install --frozen --root "$pkgdir/usr" --path $_dir
  done

  meson install -C build-server --destdir="$pkgdir"
  meson install -C build-portal --destdir="$pkgdir"
  meson install -C build-pam --destdir="$pkgdir"

  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
  rm "$pkgdir"/usr/.crates*
}
