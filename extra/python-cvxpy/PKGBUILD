# Maintainer: Antonio Rojas <arojas@archlinux.org>

_pyname=cvxpy
pkgname=python-$_pyname
pkgver=1.8.2
pkgrel=1
pkgdesc='A Python-embedded modeling language for convex optimization problems'
url='https://www.cvxpy.org/'
license=(Apache-2.0)
arch=(x86_64)
depends=(gcc-libs
         glibc
         python
         python-clarabel
         python-highspy
         python-numpy
         python-osqp
         python-scipy
         python-scs)
makedepends=(git
             pybind11
             python-build
             python-installer
             python-setuptools
             python-wheel)
optdepends=('python-cvxopt: GLPK solver'
            'python-cylp: CBC solver'
            'python-ecos: ECOS solver'
            'python-pyscipopt: SCIP solver')
checkdepends=(python-cvxopt
              python-cylp
              python-hypothesis
              python-pyscipopt
              python-pytest)
source=(git+https://github.com/cvxpy/cvxpy#tag=v$pkgver)
sha256sums=('e622e9b2a72087272be360b24b871e53438e298634f0fe7996ca2b09b00d125b')

prepare() {
  sed -e '/oldest-supported-numpy/d' -i $_pyname/pyproject.toml # Drop version constraints
}

build() {
  cd $_pyname
# https://github.com/cvxpy/cvxpy/issues/1690
  CXXFLAGS="$CFLAGS -DNDEBUG" \
  python -m build --wheel --no-isolation
}

check() {
  cd $_pyname
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest -v \
    --deselect cvxpy/tests/test_cone2cone.py::TestOpRelConeQuad::test_oprelcone_2 \
    --deselect cvxpy/tests/test_cone2cone.py::TestOpRelConeQuad::test_oprelcone_1_m1_k3_complex \
    --deselect cvxpy/tests/test_cone2cone.py::TestOpRelConeQuad::test_oprelcone_1_m3_k1_complex
}

package() {
  cd $_pyname
  python -m installer --destdir="$pkgdir" dist/*.whl
}
