# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=qt6-quickcontrols-nemo
pkgver=6.4.3
pkgrel=1
pkgdesc="Qt 6 QML components for Nemomobile"
arch=('x86_64')
url="https://github.com/nemomobile-ux/qtquickcontrols-nemo"
license=('LGPL-2.1-or-later' 'BSD-3-Clause' 'Apache-2.0')
depends=('mlite' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'ttf-opensans')
makedepends=('cmake' 'git')
checkdepends=('nemo-theme-glacier' 'xorg-server-xvfb')
source=("git+https://github.com/nemomobile-ux/qtquickcontrols-nemo.git#tag=$pkgver")
sha512sums=('1dc048fd56de7632589995626716914f83617f28ca18b5eb3dbc39681543d679ba0e99675e1ae1afb7f7215c226e6ebb57a6fcce08268563702e63f8828cc898')

build() {
  cd qtquickcontrols-nemo
  cmake . -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTS=ON
  make
}

check() {
  cd qtquickcontrols-nemo
  xvfb-run -a ctest --output-on-failure
}

package() {
  cd qtquickcontrols-nemo
  make DESTDIR="$pkgdir" install
}
