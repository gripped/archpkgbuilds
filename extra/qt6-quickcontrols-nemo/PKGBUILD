# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=qt6-quickcontrols-nemo
pkgver=6.4.0
pkgrel=1
pkgdesc="Qt 6 QML components for Nemomobile"
arch=('x86_64')
url="https://github.com/nemomobile-ux/qtquickcontrols-nemo"
license=('LGPL-2.1-or-later' 'BSD-3-Clause' 'Apache-2.0')
depends=('mlite' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'ttf-opensans')
makedepends=('cmake' 'git' 'qt6-shadertools')
checkdepends=('nemo-theme-glacier' 'xorg-server-xvfb')
source=("git+https://github.com/nemomobile-ux/qtquickcontrols-nemo.git#tag=$pkgver")
sha512sums=('40d35bafe1d60b6215a041258757d95f7b0324264e960cd17f58c28a8325411dce6185d0fcb188deb2ad6ae07e1a96c5140e8b0c7c75a426b40208f1b965b66d')

prepare() {
  cd qtquickcontrols-nemo

  # Restore absolute image URLs to avoid QML load warnings.
  # https://github.com/nemomobile-ux/qtquickcontrols-nemo/commit/e474aaf701c9170ea05ef100fdbc99e7df81ff25
  git cherry-pick -n e474aaf701c9170ea05ef100fdbc99e7df81ff25
  # Use correctly formed qrc URLs for bundled control images.
  # https://github.com/nemomobile-ux/qtquickcontrols-nemo/commit/d27c9f0e5a4ea4c603e967bd049637652427b46c
  git cherry-pick -n d27c9f0e5a4ea4c603e967bd049637652427b46c

  # Use Arch's Open Sans directory for the fallback and installed default theme.
  # https://github.com/nemomobile-ux/qtquickcontrols-nemo/pull/41
  sed -i 's|/usr/share/fonts/google-opensans/|/usr/share/fonts/TTF/|' \
    src/core/theme.cpp src/core/nemo.json
}

build() {
  cd qtquickcontrols-nemo
  cmake . -DCMAKE_INSTALL_PREFIX=/usr
  make
}

check() {
  cd qtquickcontrols-nemo
  xvfb-run -a ctest --output-on-failure
}

package() {
  cd qtquickcontrols-nemo
  make DESTDIR="$pkgdir" install
}
