# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=qt6-quickcontrols-nemo
pkgver=6.2.2
pkgrel=1
pkgdesc="Qt 6 QML components for Nemomobile"
arch=('x86_64')
url="https://github.com/nemomobile-ux/qtquickcontrols-nemo"
license=('LGPL-2.1-or-later' 'BSD-3-Clause' 'Apache-2.0')
depends=('mlite' 'qt6-base' 'qt6-declarative' 'ttf-opensans')
makedepends=('cmake' 'git' 'qt6-shadertools')
source=("git+https://github.com/nemomobile-ux/qtquickcontrols-nemo.git#tag=$pkgver")
sha512sums=('632fe1584f19aa6f8e476c7c1fd91876da18f181bc07b98c53b60a1f18f8117131048ea79eb98332f3738313ff5f635e90588b2b01f660cb6f5c29c5b13fe6ea')

prepare() {
  cd qtquickcontrols-nemo
  sed -i 's|/usr/share/fonts/google-opensans/|/usr/share/fonts/TTF/|' src/core/theme.cpp
}

build() {
  cd qtquickcontrols-nemo
  cmake . -DCMAKE_INSTALL_PREFIX=/usr
  make
}

package() {
  cd qtquickcontrols-nemo
  make DESTDIR="$pkgdir" install
}
