# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=qt6-quickcontrols-nemo
pkgver=6.5.1
pkgrel=1
pkgdesc="Qt 6 QML components for Nemomobile"
arch=('x86_64')
url="https://github.com/nemomobile-ux/qtquickcontrols-nemo"
license=('LGPL-2.1-or-later' 'BSD-3-Clause' 'Apache-2.0')
depends=('mlite' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'ttf-opensans')
makedepends=('cmake' 'git' 'qt6-shadertools' 'qt6-tools')
checkdepends=('nemo-theme-glacier' 'xorg-server-xvfb')
source=("git+https://github.com/nemomobile-ux/qtquickcontrols-nemo.git#tag=$pkgver")
sha512sums=('6b062711fdd1f1bdd602bcfe59ee0e44b13cac0b62a2e7338c8df745caec5d46fb62fd4f6922b314a32a7309433a32e97dad33c5b8a7b0c7e5b9787c9dd99c55')

prepare() {
  cd qtquickcontrols-nemo
  # Load the controls module so GlacierRoller can resolve InverseMouseArea.
  sed -i '/^import Nemo$/a import Nemo.Controls' src/controls/qml/GlacierRoller.qml
  # Register HeaderToolsIndicator as part of the QML module.
  sed -i '/qml\/HeaderToolsLayout.qml/i\    qml/HeaderToolsIndicator.qml' src/controls/CMakeLists.txt
  # Use the absolute resource path for the bundled fallback icon.
  sed -i 's|"images/listview-icon-template-s.svg"|"qrc:///images/listview-icon-template-s.svg"|' src/controls/qml/ListViewItemWithActions.qml
  # Avoid assigning undefined children when no tools layout is active.
  sed -i '/^[[:space:]]*children: if (toolBarLayout) {$/,/^[[:space:]]*}$/c\            children: toolBarLayout ? toolBarLayout.drawerLevels : []' src/controls/qml/Header.qml
  # Keep the indicator usable before a StackView is assigned.
  sed -i 's/target: stackView$/target: stackView || null/' src/controls/qml/HeaderToolsIndicator.qml
}

build() {
  cd qtquickcontrols-nemo
  cmake . -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTS=ON
  make
}

check() {
  cd qtquickcontrols-nemo
  # ut_coretheme expects a missing font path to be retained.
  # ut_qmlerrorstackpage needs applicationWindow and pageStack context.
  xvfb-run -a ctest --output-on-failure -E 'ut_coretheme|ut_qmlerrorstackpage'
}

package() {
  cd qtquickcontrols-nemo
  make DESTDIR="$pkgdir" install
}
