# Maintainer: Robin Candau <antiz@archlinux.org>
# Contributor: Max Gautier <mg@max.gautier.name>

pkgname=xdg-terminal-exec
pkgver=0.14.4
pkgrel=1
pkgdesc="Proposal for XDG Default Terminal Execution Specification and shell-based reference implementation"
url="https://github.com/Vladimir-csp/xdg-terminal-exec"
arch=('any')
license=('GPL-3.0-or-later')
depends=('bash')
makedepends=('scdoc')
checkdepends=('bats')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('10e079032396a386dabcec5627893db17dc3c76c12318b3719d78f3b70aa7ef4')

prepare() {
	cd "${pkgname}-${pkgver}"
	make clean
}

build() {
	cd "${pkgname}-${pkgver}"
	make
}

check() {
	cd "${pkgname}-${pkgver}"
	make test
}

package() {
	cd "${pkgname}-${pkgver}"
	make prefix=/usr DESTDIR="${pkgdir}" install
}
