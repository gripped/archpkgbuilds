# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=scip
pkgver=10.0.3
pkgrel=1
pkgdesc='Solving Constraint Integer Programs'
arch=(x86_64)
url='https://www.scipopt.org/'
license=(Apache-2.0)
depends=(bliss
         glibc
         gmp
         libgcc
         libstdc++
         mpfr
         onetbb
         readline
         soplex
         zlib)
makedepends=(boost
             cmake
             git
             papilo)
source=(git+https://github.com/scipopt/scip#tag=v$pkgver)
sha256sums=('67828d8e73ebe8d87443c2f8f8ad6206f338d422b636dd7f923facd463d6a97d')

prepare() {
  cd $pkgname
  git cherry-pick -n cc917e074cd23a1630cb0eb4b7f3ec6ba2777d80 # Fix build with glibc 2.43
}

build() {
  cmake -B build -S $pkgname \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DAUTOBUILD=ON \
    -DSYM=bliss \
    -DLTO=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
