From 7b64a6c25b6e83f793f93691bc36518fb7f7517a Mon Sep 17 00:00:00 2001
From: DeepChirp <DeepChirp@outlook.com>
Date: Fri, 20 Nov 2026 23:08:00 +0800
Subject: [PATCH] Fix uninitialized C header allocation triggering Go GC write
 barrier

C.bidirectional_stream_header contains pointer fields (key and value).
When cHeadersPtr is allocated with C.malloc and cast to a Go slice via
unsafe.Slice, assigning to cHeaders[index].key and cHeaders[index].value
triggers Go's hybrid write barrier (gcWriteBarrier), which reads the
pre-existing uninitialized bytes at the destination slot and records
them in the write barrier buffer (wbBuf) as old pointers to shade.

If the recycled C heap chunk happens to contain stale 8-byte values
resembling Go heap addresses (such as Go slice buffer pointers previously
passed to C++ Cronet during Read/Write), wbBufFlush1 either panics with
"found bad pointer in Go heap" or marks an unrelated free slot in an
active Go span, later crashing sweep with "found pointer to free object".

Use C.calloc so that the pointer fields are zero-initialized before
assignment.
---
 bidirectional_stream_cgo.go | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bidirectional_stream_cgo.go b/bidirectional_stream_cgo.go
index 82b1072..d4256e5 100644
--- a/bidirectional_stream_cgo.go
+++ b/bidirectional_stream_cgo.go
@@ -79,7 +79,7 @@ func (c BidirectionalStream) Start(method string, url string, headers map[string
 	var headerArray C.bidirectional_stream_header_array
 	headerLen := len(headers)
 	if headerLen > 0 {
-		cHeadersPtr := C.malloc(C.size_t(int(C.sizeof_struct_bidirectional_stream_header) * headerLen))
+		cHeadersPtr := C.calloc(C.size_t(headerLen), C.size_t(C.sizeof_struct_bidirectional_stream_header))
 		defer C.free(cHeadersPtr)
 		cType := (*C.bidirectional_stream_header)(cHeadersPtr)
 		cHeaders := unsafe.Slice(cType, headerLen)
-- 
