# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Contributor: Lukas Spies <lukas (at) photoqt _dot_ org>

pkgname=python-symengine
_pkgname=symengine.py
pkgver=0.15.0
pkgrel=1
arch=(x86_64)
pkgdesc='Python wrappers for SymEngine'
url='https://github.com/symengine/symengine.py'
depends=(flint
         glibc
         gmp
         libgcc
         libmpc
         libstdc++
         mpfr
         python
         symengine)
makedepends=(boost
             cereal
             cmake
             cython
             git
             llvm
             python-build
             python-cython-cmake
             python-installer
             python-scikit-build-core
             python-setuptools-scm)
checkdepends=(python-pytest)
license=(MIT)
source=(git+https://github.com/symengine/symengine.py#tag=v$pkgver
        no-tcmalloc.patch)
sha256sums=('bb935b9a1f0ee286bb4e08f4150688ed2d7274c14ad3bf5eadf960a03b2e4e2b'
            '4f733b108ec21897b55b69476961d178f3bb02cc54c8b86e440b16ef7370927a')

prepare() {
  cd $_pkgname
# https://github.com/symengine/symengine.py/issues/475
  patch -p1 -i ../no-tcmalloc.patch
}

build() {
  cd $_pkgname
  python -m build --wheel --no-isolation
}

check() {
  cd $_pkgname
  mv symengine{,.save}
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -m pytest -v --pyargs symengine.tests
}

package() {
  cd $_pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
