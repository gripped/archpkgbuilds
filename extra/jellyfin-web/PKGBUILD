# Maintainer: Giovanni Harting <anonfunc@archlinux.org>

pkgname=jellyfin-web
pkgver=12.4
pkgrel=1
pkgdesc='Web client for Jellyfin'
arch=(any)
url='https://jellyfin.org'
license=(GPL-2.0-or-later)
makedepends=(
  git
  nodejs
  npm
)
source=("$pkgname::git+https://github.com/jellyfin/jellyfin-web#tag=v$pkgver")
sha512sums=('3598feade815e80b6820894e2322ad96195eec9e41450e17bf4e3c5cd086552d2ddd11e62845e5b62d0a1d6221b226890a44fa20611f5d277e7e762ed1ec77fd')
b2sums=('ad4f99cc51ff2b447cd6adbc907605dcc316c6421b2a869d6be992f94cd2a4edb6233e60b76b718ae4af91d085fb06ba5eb54d0a0005de63ea6f3cbe1af4a65c')

prepare() {
  cd "$pkgname"

  # download dependencies
  npm ci --no-audit --no-fund --no-update-notifier
}

build() {
  cd "$pkgname"

  npm run build:production
}

package() {
  cd "$pkgname"

  install -vd "$pkgdir/usr/share/jellyfin/web"
  cp -vr dist/* "$pkgdir/usr/share/jellyfin/web"
}

