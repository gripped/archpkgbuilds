# Maintainer: George Rawlinson <grawlinson@archlinux.org>
# Maintainer: Giovanni Harting <anonfunc@archlinux.org>

pkgname=jellyfin-web
pkgver=12.1
pkgrel=1
pkgdesc='Web client for Jellyfin'
arch=(any)
url='https://jellyfin.org'
license=(GPL-2.0-or-later)
makedepends=(
  git
  nodejs
  npm
)
source=("$pkgname::git+https://github.com/jellyfin/jellyfin-web#tag=v$pkgver")
sha512sums=('f641876dc6c4cbcff4b12729cb1897d184657979831fa55101964ab8d161eba1c23a712a3930757b66bbd477ae188cb773c416f516546d6fcb31905070f42b7b')
b2sums=('2ce963e7ed861df10e6d2866b1f29b1a69356ea37f04f3ff45f35c757b36f2d38c193651c05ff2760ffe72a3412cc24e756f4d1153a083ad7087963e60abdc66')

prepare() {
  cd "$pkgname"

  # download dependencies
  npm ci --no-audit --no-fund --no-update-notifier
}

build() {
  cd "$pkgname"

  npm run build:production
}

package() {
  cd "$pkgname"

  install -vd "$pkgdir/usr/share/jellyfin/web"
  cp -vr dist/* "$pkgdir/usr/share/jellyfin/web"
}

