# Maintainer: George Rawlinson <grawlinson@archlinux.org>
# Maintainer: Giovanni Harting <anonfunc@archlinux.org>

pkgname=jellyfin-web
pkgver=12.0
pkgrel=1
pkgdesc='Web client for Jellyfin'
arch=(any)
url='https://jellyfin.org'
license=(GPL-2.0-or-later)
makedepends=(
  git
  nodejs
  npm
)
source=("$pkgname::git+https://github.com/jellyfin/jellyfin-web#tag=v$pkgver")
sha512sums=('2344ccd8884777474df019d1200812aa0ed18dfb851e731e1cef9417abe9dc686a0d48e3112ac2e86fb1db205a1f690884bc30f31e8c5da52bd5a824a740e00a')
b2sums=('19b222b5189c6913d18fc83037e2aa3d75b0fb70d5f5d928ba075f0969e678feddb7c1333dfab7ab4088d9809dcce69bb9ca8af99b38c9e62ba7de1c1e859150')

prepare() {
  cd "$pkgname"

  # download dependencies
  npm ci --no-audit --no-fund --no-update-notifier
}

build() {
  cd "$pkgname"

  npm run build:production
}

package() {
  cd "$pkgname"

  install -vd "$pkgdir/usr/share/jellyfin/web"
  cp -vr dist/* "$pkgdir/usr/share/jellyfin/web"
}

