# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-network-core
pkgver=2.0.57
pkgrel=1
pkgdesc='DDE network library and plugins'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-network-core"
license=('GPL-3.0-or-later' 'LGPL-3.0-or-later')
depends=(deepin-control-center glibc libgcc libstdc++ dtk6core dtk6declarative dtk6log dtk6widget qt6-base qt6-declarative networkmanager-qt systemd-libs)
makedepends=(git cmake deepin-session-shell gtest ninja qt6-tools)
groups=(deepin)
source=(git+https://github.com/linuxdeepin/dde-network-core.git#tag=$pkgver)
sha512sums=('fa68e367013a22ec8392476fa33e48184188f886120a105921bb567df62db7f2ae2a4f9862547d08196453a392e0f86d395f850c0da5bc20db73adc7680e40d5')

prepare() {
  cd dde-network-core
  # tests are still Qt5-only upstream; only build them for debug builds
  sed -Ei 's@^add_subdirectory\("tests"\)$@if (CMAKE_BUILD_TYPE STREQUAL "Debug")\n    add_subdirectory("tests")\nendif()@' CMakeLists.txt
  # several legacy subdirs still require unavailable Qt5/KF5 components on Arch
  sed -Ei '/src-old|dcc-network-plugin|example|dock-network-plugin|network-service-plugin|dss-network-plugin|dss_example/d' CMakeLists.txt
}

build() {
  cd dde-network-core
  cmake -GNinja .
  ninja
}

package() {
  cd dde-network-core
  DESTDIR="$pkgdir" ninja install
}
