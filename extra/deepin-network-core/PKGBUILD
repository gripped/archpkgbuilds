# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-network-core
pkgver=2.0.73
pkgrel=1
pkgdesc='DDE network library and plugins'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-network-core"
license=('CC-BY-4.0' 'CC0-1.0' 'GPL-3.0-or-later' 'LGPL-3.0-or-later')
depends=(deepin-control-center glibc libgcc libstdc++ dtk6core dtk6declarative dtk6log dtk6widget qt6-base qt6-declarative networkmanager-qt systemd-libs)
makedepends=(git cmake gtest ninja qt6-tools)
groups=(deepin)
source=(git+https://github.com/linuxdeepin/dde-network-core.git#tag=$pkgver)
sha512sums=('cff35027c6dca188ea517748768494e31b1cc5507ef6b3a4456f3ea4d16d1ba0c3b42637a6de85115fc3accc05160615c17476e857c4abdfc23250784d4f7eb5')

prepare() {
  cd dde-network-core
  # Only ship the core library and control-center module in this package.
  sed -Ei '/add_subdirectory\("(dock-network-plugin|dss-network-plugin|network-service-plugin)"\)/d' CMakeLists.txt
}

build() {
  cd dde-network-core
  cmake -GNinja . \
    -DVERSION=$pkgver
  ninja
}

package() {
  cd dde-network-core
  DESTDIR="$pkgdir" ninja install
}
