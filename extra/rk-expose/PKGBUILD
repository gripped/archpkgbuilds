# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=rk-expose
pkgver=0.3.3
pkgrel=1
pkgdesc="Expose Linux rootkits"
url='https://codeberg.org/hillu/rk-expose'
arch=('x86_64')
license=('GPL-3.0-or-later')
makedepends=(
  'cargo'
  'git'
  'musl'
  'rust-musl'
)
source=("git+https://codeberg.org/hillu/${pkgname}#tag=v${pkgver}")
sha256sums=('630ecf1975662b1101647a13abd9175a99df69c466047c239a286170fb2008bb')
b2sums=('89c98bac1a28f8b58480420867944154c84b14058ac751359a0f49b459c9738e6db44e8df5fd6a226bb5b2cdef2065024513141a03fd96031be4831c93cf425f')

prepare() {
  cd "${pkgname}"
  git cherry-pick bbb702bfc2689b02a75cb19d0855a1c5f440428c
  cargo fetch --locked --target host-tuple
}

_cargo_target() {
  rustc --print host-tuple | sed s/gnu/musl/
}

build() {
  cd "${pkgname}"
  export CARGO_BUILD_TARGET="$(_cargo_target)"
  cargo build --frozen --release
}

check() {
  cd "${pkgname}"
  export CARGO_BUILD_TARGET="$(_cargo_target)"
  cargo test --frozen -- \
    --skip find_existing_procs
  "target/$CARGO_BUILD_TARGET/release/rk-expose" --help
}

package() {
  cd "${pkgname}"
  export CARGO_BUILD_TARGET="$(_cargo_target)"
  install -Dm 755 -t "${pkgdir}/usr/bin" \
    "target/$CARGO_BUILD_TARGET/release/rk-expose"
}

# vim: ts=2 sw=2 et:
