pkgname=speedcrunch
pkgver=1.0.0
pkgrel=1
pkgdesc="Simple but powerful calculator using Qt"
arch=(x86_64)
url='https://speedcrunch.org/'
license=(GPL-2.0-only)
depends=(glibc
         libgcc
         libstdc++
         qt6-base
         qt6-tools)
makedepends=(cmake
             git)
source=(git+https://github.com/heldercorreia/speedcrunch#tag=v$pkgver)
sha256sums=('06c246cef12fcfc9bf2cb9f3a44936dad080179f12417d8ebe7313163130685c')

build() {
  cmake -B build -S $pkgname/src \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
