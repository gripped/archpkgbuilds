pkgname=libglacierapp
pkgver=0.9.2
pkgrel=1
pkgdesc="Glacier Application library"
arch=('x86_64')
url="https://github.com/nemomobile-ux/libglacierapp"
license=('LGPL-2.0-or-later')
depends=('mlite' 'qt5-declarative')
makedepends=('git' 'cmake')
source=("git+https://github.com/nemomobile-ux/libglacierapp.git#tag=$pkgver")
sha512sums=('7de77a662ab55a57d4a18d86603452fae2d2a6f3418515c260f0f66fb4b369c8a4d9fe1d274c8734f3a76b84061c38ccb90a5c0bced4d44a7228a37e3a452065')

build(){
  cd $pkgname

  cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=/usr/lib .
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
