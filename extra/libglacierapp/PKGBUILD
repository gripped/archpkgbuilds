pkgname=libglacierapp
pkgver=1.1
pkgrel=1
pkgdesc="Glacier Application library"
arch=('x86_64')
url="https://github.com/nemomobile-ux/libglacierapp"
license=('LGPL-2.0-or-later')
depends=('glibc' 'libgcc' 'libstdc++' 'qt6-base' 'qt6-declarative')
makedepends=('git' 'cmake')
source=("git+https://github.com/nemomobile-ux/libglacierapp.git#tag=$pkgver")
sha512sums=('a4edf74bfd2dbc8de71619a4577b8e65ad7b1fec0e2041419d7a77a3c7ed182dfdbc6ac2c653ad3888bb5a65ba817da7a4acd49700a352e038f94775460cd580')

build(){
  cd $pkgname

  cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=/usr/lib -DUSE_QT6=ON .
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
