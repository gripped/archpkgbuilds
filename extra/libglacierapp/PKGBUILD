# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=libglacierapp
pkgver=1.2.4
pkgrel=1
pkgdesc="Glacier Application library"
arch=('x86_64')
url="https://github.com/nemomobile-ux/libglacierapp"
license=('LGPL-2.0-or-later')
depends=('glibc' 'libgcc' 'libstdc++' 'qt6-base' 'qt6-declarative')
makedepends=('git' 'cmake')
source=("git+https://github.com/nemomobile-ux/libglacierapp.git#tag=$pkgver")
sha512sums=('eedb5e5ccba8f8ebffa7bf73bd8173f5143fc30190493930d2542d5941a4109e6257e9d529102fc1d1e8cd07e50d4a49c576107be76ca1e719db6108baea19a1')

prepare(){
  cd $pkgname

  # Add missing Qt DBus CMake wiring for QDBusConnection usage.
  sed -i 's/Core Gui Qml Quick REQUIRED/Core Gui Qml Quick DBus REQUIRED/g' CMakeLists.txt src/CMakeLists.txt
  sed -i '/Qt6::Quick/a \    Qt6::DBus' src/CMakeLists.txt
}

build(){
  cd $pkgname

  cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=/usr/lib -DPROJECT_VERSION=$pkgver .
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
