# Maintainer: Torsten Keßler <tpkessler at archlinux dot org>
# Maintainer: Christian Heusel <gromit@archlinux.org>

pkgname=hipthreads
pkgver=10.1
pkgrel=1
pkgdesc='C++ std::thread-like API to launch and manage GPU threads with HIP'
arch=('x86_64')
url='https://github.com/ROCm/rocm-libraries/tree/develop/projects/hipthreads'
license=('Apache-2.0 WITH LLVM-exception')
depends=('rocm-core' 'hip-runtime-amd' 'libhipcxx')
makedepends=('cmake' 'rocm-cmake' 'rocm-toolchain' 'rocm-llvm')
_git='https://github.com/ROCm/rocm-libraries'
source=("$pkgname-$pkgver.tar.gz::$_git/releases/download/therock-$pkgver/$pkgname.tar.gz")
sha256sums=('0ed525ec84da4db6bc24c8d7f6c54a7cf8db6d7eef5622313196ed84e26c9fcc')
options=(!lto)

build() {
  # -fcf-protection is not supported by HIP, see
  # https://rocm.docs.amd.com/projects/llvm-project/en/latest/reference/rocmcc.html#support-status-of-other-clang-options
  export HIPFLAGS="${CXXFLAGS} -fcf-protection=none"
  local cmake_args=(
    -Wno-dev
    -S "$pkgname"
    -B build
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_CXX_COMPILER=/opt/rocm/lib/llvm/bin/amdclang++
    -D CMAKE_HIP_COMPILER=/opt/rocm/lib/llvm/bin/amdclang++
    -D CMAKE_HIP_ARCHITECTURES="$(rocm-supported-gfx)"
    -D DISABLE_WERROR=ON
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$pkgname/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
