# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=worker-build
pkgver=0.8.5
pkgrel=1
pkgdesc="Custom build command for a Cloudflare Workers project"
url='https://github.com/cloudflare/workers-rs/tree/main/worker-build'
arch=('x86_64')
license=('Apache-2.0')
depends=(
  'esbuild'
  'glibc'
  'libgcc' 'libgcc_s.so'
  'openssl' 'libcrypto.so' 'libssl.so'
  'wasm-bindgen'
  'wasm-pack'
)
makedepends=('cargo')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::https://crates.io/api/v1/crates/${pkgname}/${pkgver}/download")
sha256sums=('06c489585a93ce94210df365a879c8a5ceab27f4d2c380484c26642469e78a36')
b2sums=('d75d10d59468f79a7b28887d31ffe31a100ebd6daed35c07cec4b1c024398228a3a0a99da08ee25464f803b771c6f13d64015560e7aa4fc63e7260e30b575aa0')

prepare() {
  cd ${pkgname}-${pkgver}
  cargo fetch --locked --target host-tuple
}

build() {
  cd ${pkgname}-${pkgver}
  cargo build --frozen --release
}

check() {
  cd ${pkgname}-${pkgver}
  cargo test --frozen
}

package() {
  cd ${pkgname}-${pkgver}
  install -Dm 755 -t "${pkgdir}/usr/bin" target/release/worker-build
}

