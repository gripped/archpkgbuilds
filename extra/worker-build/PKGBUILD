# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=worker-build
pkgver=0.9.0
pkgrel=1
pkgdesc="Custom build command for a Cloudflare Workers project"
url='https://github.com/cloudflare/workers-rs/tree/main/worker-build'
arch=('x86_64')
license=('Apache-2.0')
depends=(
  'esbuild'
  'glibc'
  'libgcc' 'libgcc_s.so'
  'openssl' 'libcrypto.so' 'libssl.so'
  'wasm-bindgen'
  'wasm-pack'
)
makedepends=('cargo')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::https://static.crates.io/crates/${pkgname}/${pkgname}-${pkgver}.crate")
sha256sums=('bdcd75703783317d833b09c6724d5e4f642ad23804d8d14e3ac362e990c7cab7')
b2sums=('2489601b83d52ec1fcc05cd9d4ff347ce8a7602caaaf53c145bed2e5301089fd1222b93d743f3e1bd70034672f41ac0963706d482121ff3636d94449dcb1a55b')

prepare() {
  cd ${pkgname}-${pkgver}
  cargo fetch --locked --target host-tuple
}

build() {
  cd ${pkgname}-${pkgver}
  cargo build --frozen --release
}

check() {
  cd ${pkgname}-${pkgver}
  cargo test --frozen
}

package() {
  cd ${pkgname}-${pkgver}
  install -Dm 755 -t "${pkgdir}/usr/bin" target/release/worker-build
}

