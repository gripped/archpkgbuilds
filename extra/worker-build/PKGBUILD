# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>

pkgname=worker-build
pkgver=0.8.0
pkgrel=1
pkgdesc="Custom build command for a Cloudflare Workers project"
url='https://github.com/cloudflare/workers-rs/tree/main/worker-build'
arch=('x86_64')
license=('Apache-2.0')
depends=(
  'esbuild'
  'glibc'
  'libgcc' 'libgcc_s.so'
  'openssl' 'libcrypto.so' 'libssl.so'
  'wasm-bindgen'
  'wasm-pack'
)
makedepends=('cargo')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::https://crates.io/api/v1/crates/${pkgname}/${pkgver}/download")
sha256sums=('ed89601e4980ec75f4edbfd94787552652fed09e3b4b1bc693cf127ce6642de3')
b2sums=('6ce30e81ff7293ad415f0e9d82ff72edeefb387440cb8dcaa7d85262bc423133aa2058d6d5e940c91956923426e97bd69f2123ac7ce1049029c277bb19b16f83')

prepare() {
  cd ${pkgname}-${pkgver}
  cargo fetch --locked --target host-tuple
}

build() {
  cd ${pkgname}-${pkgver}
  cargo build --frozen --release
}

check() {
  cd ${pkgname}-${pkgver}
  cargo test --frozen
}

package() {
  cd ${pkgname}-${pkgver}
  install -Dm 755 -t "${pkgdir}/usr/bin" target/release/worker-build
}

