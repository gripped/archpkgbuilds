# Maintainer: Peter Jung <ptr1337@archlinux.org>
# Contributor: Tejun Heo <tj@kernel.org>
# Contributor: Piotr Górski <lucjan.lucjanov@gmail.com>

pkgname=scx-scheds
_gitname=scx
pkgver=1.1.5
pkgrel=1
pkgdesc='sched_ext schedulers and tools'
url='https://github.com/sched-ext/scx'
arch=('x86_64')
backup=('etc/default/scx')
license=('GPL-2.0-only')
depends=(
  bash
  bpf
  libgcc
  glibc
  jq
  libbpf
  libelf
  protobuf
  zlib
)
makedepends=(
  clang
  git
  llvm
  llvm-libs
  python
  rust
)
optdepends=('polkit: run scxcli and scxtui actions as a non-root user')
options=(!lto)
source=("git+https://github.com/sched-ext/scx#tag=v${pkgver}")
sha256sums=('dfcf40ab62bb9a5513dafad218a4d0710e135b2933af5672c7ca46f09a4ddf4f')

prepare() {
  cd $_gitname

  cargo fetch --locked --target "$(rustc --print host-tuple)"
}
build() {
  cd $_gitname
  cargo build \
     --release \
     --frozen \
     --workspace \
     --exclude scx_mitosis \
     --exclude scx_rburst \
     --exclude scx_reevdf \
     --exclude scx_rlocal \
     --exclude scx_rvtime \
     --exclude scx_characterize \
     --exclude xtask \
     --exclude vmlinux_docify \
     --exclude scx_arena_selftests \
     --exclude scx_arena_libarena_selftests
}

package() {
  cd $_gitname

  # Install all built executables (skip .so and .d files)
  find target/release \
    -maxdepth 1 -type f -executable ! -name '*.so' \
    -exec install -Dm755 -t "$pkgdir/usr/bin/" {} +

  # Data files scxcli and scxtui need (same set as 'xtask install')
  install -Dm644 services/scx.service -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 services/scx "$pkgdir/etc/default/scx"
  install -Dm644 services/catalog.json -t "$pkgdir/usr/share/scx/"
  install -Dm644 tools/scxcli/org.sched_ext.scxcli.policy \
    -t "$pkgdir/usr/share/polkit-1/actions/"
}
