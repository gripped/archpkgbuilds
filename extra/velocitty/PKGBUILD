# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=velocitty
pkgver=1.1.1
pkgrel=1
pkgdesc='Terminal emulator for Linux desktops'
arch=(any)
url='https://github.com/xapp-project/velocitty'
license=(GPL-3.0-or-later)
groups=(x-apps)
depends=(
  dconf
  glib2
  graphene
  gtk4
  hicolor-icon-theme
  libadwaita
  pango
  python
  python-gobject
  python-setproctitle
  python-xapp
  vte4
  xapp-symbolic-icons
)
makedepends=(
  git
  meson
)
source=("git+https://github.com/xapp-project/velocitty.git#tag=$pkgver")
b2sums=(045a6a64ac1809bfaf9b23867f6ebc4c05d0b74a1c6535f134d28fb0553384cf686ac45a310d383b314b3e64a75b7ff954a57b5bf818b77d5a1c027208dea772)

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
