pkgname=headsetcontrol
pkgver=4.0.0
pkgrel=1
pkgdesc='Sidetone control and battery readout for gaming headsets'
arch=(x86_64)
url='https://github.com/Sapd/HeadsetControl'
license=(GPL-3.0-only)
depends=(glibc hidapi)
makedepends=(cmake)
source=("$url/releases/download/$pkgver/headsetcontrol-$pkgver.tar.gz"
  "$pkgname-$pkgver.tar.gz.asc::$url/releases/download/$pkgver/headsetcontrol-$pkgver.tar.gz.asc")
b2sums=('388aa3465437a04a7a1e7a0512ab75bf3b8f7793b384a52433760b0a90ee4f7ef3229660b32f6ebd364975501b40f3a118de36df7415225a1ffe23a1753ec767'
  'SKIP')
validpgpkeys=('77BEB7E232CF1E5154777D4DD5866C58940197BF') # Denis Arnst <git@sapd.eu>

build() {
  # set version
  sed "s/@GIT_VERSION@/$pkgver/g" $pkgname-$pkgver/lib/version.h.in >$pkgname-$pkgver/lib/version.h

  local cmake_options=(
    -B build
    -S $pkgname-$pkgver
    -W no-author
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 $pkgname-$pkgver/README.md -t "$pkgdir"/usr/share/doc/$pkgname
}

