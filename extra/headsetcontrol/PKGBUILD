pkgname=headsetcontrol
pkgver=4.3.0
pkgrel=1
pkgdesc='Sidetone control and battery readout for gaming headsets'
arch=(x86_64)
url='https://github.com/Sapd/HeadsetControl'
license=(GPL-3.0-only)
depends=(libgcc glibc libstdc++ hidapi)
makedepends=(cmake)
source=("$url/releases/download/$pkgver/headsetcontrol-$pkgver.tar.gz"
  "$pkgname-$pkgver.tar.gz.asc::$url/releases/download/$pkgver/headsetcontrol-$pkgver.tar.gz.asc")
b2sums=('e7b8279a92c0fb137ebb133f5b4790278e5063b2482c36f031ae14a06a95f06b8b29ae51487dcdfd30b0200236d263815c9e7c134da29c64af1f33bce5641fc8'
  'SKIP')
validpgpkeys=('77BEB7E232CF1E5154777D4DD5866C58940197BF') # Denis Arnst <git@sapd.eu>

build() {
  local cmake_options=(
    -B build
    -S $pkgname-$pkgver
    -W no-author
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D HEADSETCONTROL_VERSION=$pkgver
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 $pkgname-$pkgver/README.md -t "$pkgdir"/usr/share/doc/$pkgname
}

