# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-pytest-recording
pkgver=0.13.4
pkgrel=1
pkgdesc="A pytest plugin powered by VCR.py to record and replay HTTP traffic"
arch=('any')
url="https://github.com/kiwicom/pytest-recording"
license=('MIT')
depends=(
  'python'
  'python-pytest'
  'python-vcrpy'
)
makedepends=(
  'git'
  'python-build'
  'python-hatchling'
  'python-installer'
  'python-wheel'
)
checkdepends=(
  'python-pytest-httpbin'
  'python-pytest-mock'
  'python-requests'
  'python-werkzeug'
)
source=("git+https://github.com/kiwicom/pytest-recording.git#tag=v$pkgver")
sha512sums=('9a5fedf58b9b028746c89b40951742ffab3e3652e7383543e35da1a73502bb842b83255f9fba95f120fb1b36335b16cbcf75d32ae785e0a8cbd95745f63422ab')

build() {
  cd pytest-recording
  python -m build --wheel --no-isolation
}

check() {
  cd pytest-recording
  python -m venv tmpenv --system-site-packages
  tmpenv/bin/python -m installer dist/*.whl
  tmpenv/bin/python -m pytest
}

package() {
  cd pytest-recording
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
