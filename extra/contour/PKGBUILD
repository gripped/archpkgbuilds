# Maintainer: Peter Jung <ptr1337@archlinux.org>
# Contributor: Vladislav Nepogodin <nepogodin.vlad@gmail.com>

pkgname=contour
pkgver=0.6.2.8008
pkgrel=4
pkgdesc="Modern C++ Terminal Emulator"
arch=(x86_64)
url="https://github.com/contour-terminal/contour"
license=('Apache-2.0')
depends=(
  fontconfig
  freetype2
  glibc
  harfbuzz
  libgcc
  libssh2
  libstdc++
  libunicode
  libutempter
  libxcb
  qt6-5compat
  qt6-base
  qt6-declarative
  qt6-multimedia
  qt6-shadertools
  wayland
  yaml-cpp
)
makedepends=(
  boxed-cpp
  catch2
  cmake
  extra-cmake-modules
  git
  libxml2
  microsoft-gsl
  ninja
  python
  range-v3
  reflection-cpp
)
optdepends=('ncurses: for contour terminfo database')
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha512sums=('f82c136f7ebc78e68d272d1b338fbb1863744d3a95330a5899e002bfd801062adbaaa9d15e14df863ee4dc89145a8d0b135cac6eb3fb8f45893bad50727f2f22')

prepare() {
  cd $pkgname
  # libunicode v0.8.0
  git cherry-pick -n -Xtheirs 0793b4315004dbd71da90e215ae7bfd7b4b38a56
}

build() {
  cmake -S $pkgname -Bbuild \
    -GNinja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCONTOUR_QT_VERSION=6 \
    -DCONTOUR_TESTING=ON
  cmake --build build
}

check() {
  # for running tests, it is (currently) expected to be executed
  # from within the source code's project root directory, in order to
  # access some test files.
  cd $pkgname
  ../build/src/contour/contour version
  ../build/src/crispy/crispy_test
  ../build/src/vtparser/vtparser_test
  ../build/src/vtbackend/vtbackend_test
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  # provided by ncurses now
  rm -rf "${pkgdir}/usr/share/terminfo"

  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" $pkgname/LICENSE.txt
}

# vim:set sw=2 sts=2 et:
