# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=ukui-interface
pkgver=4.10.0.0
pkgrel=1
pkgdesc="UKUI interface for system configuration and related libraries"
arch=('x86_64')
license=('Apache-2.0' 'GPL-3.0-or-later')
url="https://gitee.com/openkylin/ukui-interface"
groups=('ukui')
depends=('dconf' 'glib2' 'glibc' 'gsettings-qt6' 'iniparser' 'libgcc' 'libstdc++' 'qt6-base' 'systemd')
makedepends=('git')
source=("git+https://gitee.com/openkylin/ukui-interface.git#tag=debian/$pkgver-1")
sha512sums=('1091c1eadad7b8045b0f28d31cf58370529d149844456e1f1652c0fd93664357a8efe3c53e33d9da5322489ba6a64fcc888925e0c922a788265299bfc734b723')

prepare() {
  cd ukui-interface

  ./autogen.sh
}

build() {
  cd ukui-interface
  ./configure --prefix=/usr --includedir=/usr/include/ukuisdk --disable-static
  make

  cd src/log4qt
  qmake6 PREFIX=/usr \
    QMAKE_CFLAGS_RELEASE="$CPPFLAGS $CFLAGS" \
    QMAKE_CXXFLAGS_RELEASE="$CPPFLAGS $CXXFLAGS" \
    QMAKE_LFLAGS_RELEASE="$LDFLAGS"
  make
}

package() {
  cd ukui-interface
  make DESTDIR="$pkgdir" install

  cd src/log4qt
  make INSTALL_ROOT="$pkgdir" install
}
