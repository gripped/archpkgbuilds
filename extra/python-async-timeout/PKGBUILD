pkgname=python-async-timeout
pkgver=5.0.1
pkgrel=1
pkgdesc='Asyncio-compatible timeout class'
url='https://github.com/aio-libs/async-timeout'
arch=('any')
license=('Apache-2.0')
depends=('python')
makedepends=('git' 'python-setuptools' 'python-build' 'python-installer' 'python-wheel')
checkdepends=('python-pytest' 'python-pytest-asyncio' 'python-pytest-cov')
source=("git+https://github.com/aio-libs/async-timeout.git#tag=v$pkgver")
sha256sums=('94ae5e7d6fb71a9ad3082a3bb43676abd44aa949ee27f408b52645dbc79b543b')
sha512sums=('6b69e81f810a2a91ffe6aeaf7c4e5581d8dc398e10ef2ae21c28214bfc376db3411ad971cd2e240010769cdc60d48b5c86cfff8092c54694c8f942110f219bbb')

build() {
  cd async-timeout
  python -m build --wheel --no-isolation
}

check() {
  cd async-timeout
  python -m pytest
}

package() {
  cd async-timeout
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

