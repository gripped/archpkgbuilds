pkgname=freebasic
pkgver=1.10.3
pkgrel=1
pkgdesc="A free BASIC compiler"
arch=('x86_64')
url="https://www.freebasic.net/"
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later')
options=('!lto')
depends=('ncurses')
makedepends=('freebasic' 'git' 'libxpm' 'gpm' 'libxrandr' 'mesa')
source=("$pkgname::git+https://git.code.sf.net/p/fbc/code#tag=$pkgver")
sha512sums=('9f32e734afaa096bd8f87bcf14b122beeb25c07c850e77ae7ada4dd212ded168862336fc92b585bba62edc211391b8611757ba507dc1dcf70b1539d12e33c0e2')

build() {
  cd $pkgname
  make CFLAGS="$CFLAGS"
}

package() {
  cd $pkgname
  # PATH="$PWD/bin:$PATH" make install prefix="$pkgdir/usr" FBCFLAGS="-i inc"
  make install prefix="$pkgdir/usr"
}
