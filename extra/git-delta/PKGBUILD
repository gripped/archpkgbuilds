# Maintainer: Caleb Maclennan <caleb@alerque.com>
# Contributor: Kr1ss $(echo \<kr1ss+x-yandex+com\>|sed s/\+/./g\;s/\-/@/)
# Contributor: ccorn

pkgname=git-delta
pkgver=0.19.0
pkgrel=1
pkgdesc='Syntax-highlighting pager for git and diff output'
arch=(x86_64)
url='https://dandavison.github.io/delta/'
license=(MIT)
depends=(
  glibc
  libgcc
  libgit2
  oniguruma
  zlib
)
makedepends=(
  git
  rust
)
source=("$pkgname::git+https://github.com/dandavison/delta#tag=$pkgver")
sha512sums=('a552005edf1131075ebc0b08a3c325b1edcfc424fdbc797780f0443734d8366d149c3621ca974539e3843f35920a4e7c58ce30bbf910b86e355738c5c8d7e7dd')
b2sums=('5de92cb80d54cc05654d2ceff61460f3eef619a8be33bb9547fbfde3431fd42d719cfd8d1ba839193b9e897fee8b74678ac48c0b87d254676ac5904ffe6cb97f')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  # https://archlinux.org/todo/lto-fat-objects/
  CFLAGS+=' -ffat-lto-objects'

  export RUSTONIG_DYNAMIC_LIBONIG=1

  # binary
  cargo build --frozen --release --all-features

  # generate shell completions
  for shell in bash elvish fish zsh; do
    target/release/delta --generate-completion="$shell" > "${shell}-completion"
  done
}

check() {
  cd "$pkgname"
  # some tests hang for 60+ seconds, find out why
  # took my machine ~ 470 seconds
  cargo test --frozen --all-features
}

package() {
  cd "$pkgname"

  # binary
  local _bin=target/release/delta
  install -vDm755 -t "$pkgdir/usr/bin/" $_bin

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE

  # shell completions
  install -vDm644 bash-completion \
    "$pkgdir/usr/share/bash-completion/completions/delta"
  install -vDm644 elvish-completion \
    "$pkgdir/usr/share/elvish/lib/delta.elv"
  install -vDm644 fish-completion \
    "$pkgdir/usr/share/fish/vendor_completions.d/delta.fish"
  install -vDm644 zsh-completion \
    "$pkgdir/usr/share/zsh/site-functions/_delta"

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
}
