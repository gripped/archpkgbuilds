pkgname=komikku
pkgver=50.14.0
pkgrel=1
pkgdesc='Manga and comics reader for GNOME'
arch=(any)
url='https://apps.gnome.org/Komikku/'
license=(GPL-3.0-or-later)
groups=(gnome-circle)
depends=(
  dconf
  gdk-pixbuf2
  glib2
  graphene
  gtk4
  gtksourceview5
  hicolor-icon-theme
  libadwaita
  libsoup3
  pango
  python
  python-beautifulsoup4
  python-brotli
  python-cairo
  python-colorthief
  python-cryptography
  python-dateparser
  python-ebooklib
  python-emoji
  python-gobject
  python-jxlpy
  python-keyring
  python-lxml
  python-magic
  python-natsort
  python-piexif
  python-pillow
  python-pyjwt
  python-pypdf
  python-pytz
  python-rarfile
  python-requests
  python-tzlocal
  python-unidecode
  python-urllib3
  webkitgtk-6.0
)
makedepends=(
  appstream
  blueprint-compiler
  git
  meson
  python-curl_cffi
  python-pytesseract
)
optdepends=(
  'python-curl_cffi: for impersonating browser requests'
  'python-pytesseract: OCR translator'
)
source=("git+https://codeberg.org/valos/Komikku.git#tag=v$pkgver")
b2sums=(957e50a7203afebe95eb939973244528a1990c145404feda0259328ce7f4aaebe21350a4362a1221ffdc57254ebad5107f571e6132d2722664d2561e1e4cb86a)

prepare() {
  cd Komikku
}

build() {
  arch-meson Komikku build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
