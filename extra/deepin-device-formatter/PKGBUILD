# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-device-formatter
pkgver=1.5.5
pkgrel=1
pkgdesc='A simple graphical interface for creating file system in a block device'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-device-formatter"
license=('GPL-3.0-or-later')
depends=('deepin-qt6platform-plugins' 'deepin-qt6integration' 'dtk6core' 'dtk6gui' 'dtk6widget' 'qt6-base'
         'glibc' 'libgcc' 'libstdc++' 'libx11' 'udisks2-qt6')
optdepends=('btrfs-progs: btrfs support'
            'dosfstools: FAT support'
            'e2fsprogs: ext2/3/4 support'
            'exfatprogs: exFAT support'
            'f2fs-tools: f2fs support'
            'jfsutils: JFS support'
            'nilfs-utils: nilfs2 support'
            'ntfs-3g: NTFS support'
            'xfsprogs: XFS support')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools')
groups=('deepin-extra')
source=("git+https://github.com/linuxdeepin/dde-device-formatter.git#tag=$pkgver")
sha512sums=('85f8ec46c9e1d284d74ccd73bcd4e8759828b65a0f0c7f0354f2d40be0bb5f7f6b87551746a20e137b2553cac92104d9f73e309b5a8ade6ae72f0e4204f96336')

prepare() {
  cd dde-device-formatter
  sed -i '/find_package(Qt6 COMPONENTS Core Gui Widgets Concurrent Network DBus LinguistTools REQUIRED)/a find_package(Qt6GuiPrivate REQUIRED CONFIG)' CMakeLists.txt
}

build(){
  cd dde-device-formatter
  cmake -GNinja . -DCMAKE_INSTALL_PREFIX=/usr
  ninja
}

package() {
  cd dde-device-formatter
  DESTDIR="$pkgdir" ninja install
}
