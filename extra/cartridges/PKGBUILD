# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=cartridges
pkgver=2.13.1
pkgrel=1
pkgdesc='Simple game launcher written in Python using GTK4 and Libadwaita'
arch=(any)
url='https://apps.gnome.org/Cartridges/'
license=(GPL-3.0-or-later)
groups=(gnome-circle)
depends=(
  dconf
  gdk-pixbuf2
  glib2
  gtk4
  hicolor-icon-theme
  libadwaita
  pango
  python
  python-gobject
  python-pillow
  python-requests
  python-urllib3
  python-yaml
)
makedepends=(
  appstream
  blueprint-compiler
  git
  meson
)
source=(
  "git+https://codeberg.org/kramo/cartridges.git#tag=v$pkgver"
  cartridges-save-cover.patch
)
b2sums=('bcf1452524d58755503fe48d18906f7f6d44235006c8bddafd718b0dfdaf37ea043e0d3090429908b5ce847ed027aa62fb651a95f5ed9eb4fc243e0f63edcdc2'
        'c5e201f051b5257d6332537a04fd15fbf7699a5740d643b48031a9c0dc4ca3ee3081e511aa93514beff55fab2dab210e84ae24e23eb630cbcfeb7d0fb0c84b68')

prepare() {
  cd $pkgname

  # https://codeberg.org/kramo/cartridges/pulls/306
  git apply -3 ../cartridges-save-cover.patch
}

build() {
  arch-meson $pkgname build \
    -D tiff_compression=jpeg
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
