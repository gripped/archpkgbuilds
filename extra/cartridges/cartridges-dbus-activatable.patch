From 6d0b70fd949501695d7b003c19bfd381daff49e7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ball=C3=B3=20Gy=C3=B6rgy?= <ballogyor@gmail.com>
Date: Fri, 18 Sep 2026 01:40:12 +0200
Subject: [PATCH] Add D-Bus service file

And mark the application as D-Bus activatable. This allows application
launchers to activate it via D-Bus.
---
 data/meson.build                      | 7 +++++++
 data/page.kramo.Cartridges.desktop.in | 1 +
 data/page.kramo.Cartridges.service.in | 3 +++
 meson.build                           | 2 ++
 4 files changed, 13 insertions(+)
 create mode 100644 data/page.kramo.Cartridges.service.in

diff --git a/data/meson.build b/data/meson.build
index 5c5b782..2370430 100644
--- a/data/meson.build
+++ b/data/meson.build
@@ -112,4 +112,11 @@ if compile_schemas.found()
   )
 endif
 
+configure_file(
+          input: 'page.kramo.Cartridges.service.in',
+         output: app_id + '.service',
+  configuration: conf,
+    install_dir: join_paths(get_option('datadir') / 'dbus-1' / 'services')
+)
+
 subdir('icons')
diff --git a/data/page.kramo.Cartridges.desktop.in b/data/page.kramo.Cartridges.desktop.in
index e7b8e85..003dd0c 100644
--- a/data/page.kramo.Cartridges.desktop.in
+++ b/data/page.kramo.Cartridges.desktop.in
@@ -10,3 +10,4 @@ Categories=GNOME;GTK;Game;PackageManager;
 # Translators: Leave "cartridges" untranslated here.
 Keywords=gaming;games;play;cartridges;launch;launcher;steam;lutris;heroic;epic;bottles;itch;legendary;retroarch;
 StartupNotify=true
+DBusActivatable=true
diff --git a/data/page.kramo.Cartridges.service.in b/data/page.kramo.Cartridges.service.in
new file mode 100644
index 0000000..f74c558
--- /dev/null
+++ b/data/page.kramo.Cartridges.service.in
@@ -0,0 +1,3 @@
+[D-BUS Service]
+Name=@APP_ID@
+Exec=@bindir@/cartridges --gapplication-service
diff --git a/meson.build b/meson.build
index 1ec18a5..62b9c78 100644
--- a/meson.build
+++ b/meson.build
@@ -25,6 +25,7 @@ py_installation = python.find_installation('python3')
 python_dir = join_paths(get_option('prefix'), py_installation.get_install_dir())
 pkgdatadir = join_paths(get_option('prefix'), get_option('datadir'), meson.project_name())
 libexecdir = join_paths(get_option('prefix'), get_option('libexecdir'))
+bindir = join_paths(get_option('prefix'), get_option('bindir'))
 
 profile = get_option('profile')
 if profile == 'development'
@@ -46,6 +47,7 @@ conf.set('TIFF_COMPRESSION', get_option('tiff_compression'))
 conf.set('localedir', join_paths(get_option('prefix'), get_option('localedir')))
 conf.set('pkgdatadir', pkgdatadir)
 conf.set('libexecdir', libexecdir)
+conf.set('bindir', bindir)
 
 subdir('data')
 subdir('cartridges')
-- 
2.55.0

