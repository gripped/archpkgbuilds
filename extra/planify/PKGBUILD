# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=planify
pkgver=4.19.5
pkgrel=1
pkgdesc='Task manager with Todoist, Nextcloud and CalDAV support designed for GNOME'
arch=(x86_64)
url='https://useplanify.com/'
license=(GPL-3.0-or-later)
depends=(
  cairo
  chrono
  dconf
  evolution-data-server
  glib2
  glibc
  gtk4
  gtksourceview5
  gxml
  hicolor-icon-theme
  icu
  json-glib
  libadwaita
  libgee
  libical
  libportal
  libportal-gtk4
  libsecret
  libsoup3
  libspelling
  pango
  sqlite
)
makedepends=(
  git
  meson
  vala
)
source=("git+https://github.com/alainm23/planify.git#tag=v$pkgver")
b2sums=(748444d15f401191b620922769d1685a24705617f1fdf7da660758a5b298b9d600a400e35d4d6bbfc8318750f950524fb27a2d49e3bbe7a4fe2e67e93bb9a660)

prepare() {
  cd $pkgname

  # Show proper quick add command
  # https://github.com/alainm23/planify/pull/2637
  sed -i '/string quick_add_command =/{N;s|.*|string quick_add_command = "io.github.alainm23.planify.quick-add";|}' src/Dialogs/Preferences/Pages/QuickAdd.vala
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  ln -s io.github.alainm23.planify "$pkgdir/usr/bin/planify"
  ln -s io.github.alainm23.planify.cli "$pkgdir/usr/bin/planify-cli"
  ln -s io.github.alainm23.planify.quick-add "$pkgdir/usr/bin/planify-quick-add"
}
