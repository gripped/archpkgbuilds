# Maintainer: Bert Peters <bertptrs@archlinux.org>

pkgname=ruby-cucumber
pkgver=12.0.0
pkgrel=1
pkgdesc="Behaviour Driven Development with elegance and joy"
arch=(any)
url='https://github.com/cucumber/cucumber-ruby'
license=(MIT)
depends=(
  ruby
  ruby-base64
  ruby-builder
  ruby-cucumber-ci-environment
  ruby-cucumber-core
  ruby-cucumber-cucumber-expressions
  ruby-cucumber-gherkin
  ruby-cucumber-html-formatter
  ruby-cucumber-messages
  ruby-cucumber-query
  ruby-diff-lcs
  ruby-logger
  ruby-mime-types
  ruby-mini_mime
  ruby-multi_test
  ruby-sys-uname
  ruby-rake
)
makedepends=(
  git
  ruby-rdoc
)
checkdepends=(
  ruby-bundler
  ruby-nokogiri
  ruby-rspec
  ruby-webrick
)
options=(!emptydirs)
source=(
  "git+https://github.com/cucumber/cucumber-ruby.git#tag=v$pkgver"
)
sha512sums=('ba088c2a84c1b53fc516a63f2986d48590f14fd82afffe5fde02e848038e66bc2d3e20f8c917905ce08a1e71d813500a7a3f7223aa427764cf16dcb9bd94626f')
b2sums=('b68309833cffee5232d503ad4bfa18611c1ace80d9e647d0d06eab7e8c55e7e21256af506dda9d87417bd2126500c97d6add400ffee7484790fcb7edd00669e6')

prepare() {
  cd cucumber-ruby

  sed -i \
    -e 's|~>|>=|' \
    -e "s/, '< [0-9]\+'//" \
    cucumber.gemspec
  sed -i '/[rR]ubo[cC]op/d' Rakefile

  rm Gemfile

  sed -i -e 's/bundle exec //' gem_tasks/cck.rake compatibility/cck_spec.rb
}

build() {
  local _gemdir="$(gem env gemdir)"
  cd cucumber-ruby
  gem build cucumber.gemspec
  gem install \
    --local \
    --verbose \
    --ignore-dependencies \
    --no-user-install \
    --install-dir "tmp_install/$_gemdir" \
    --bindir "tmp_install/usr/bin" \
    cucumber-$pkgver.gem
  find "tmp_install/$_gemdir/gems/" \
    -type f \
    \( \
        -iname "*.o" -o \
        -iname "*.c" -o \
        -iname "*.so" -o \
        -iname "*.time" -o \
        -iname "gem.build_complete" -o \
        -iname "Makefile" \
    \) \
    -delete
  rm -r tmp_install/$_gemdir/cache
}

check() {
  local _gemdir="$(gem env gemdir)"
  cd cucumber-ruby
  # cck disabled: "ci" is not supported in latest cucumber-messages
  PATH="$PWD/tmp_install/usr/bin:$PATH" GEM_HOME="tmp_install/$_gemdir" rake spec cucumber
}

package() {
  cd cucumber-ruby
  cp -a tmp_install/* "$pkgdir"/
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
