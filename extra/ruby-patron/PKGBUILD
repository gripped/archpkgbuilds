# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=ruby-patron
pkgver=0.14.0
pkgrel=1
pkgdesc='Ruby HTTP client library based on libcurl'
arch=(x86_64)
url='https://github.com/toland/patron'
license=(MIT)
depends=(
  curl
  ruby
)
makedepends=(
  git
  ruby-bundler
  ruby-rake-compiler
  ruby-rdoc
  ruby-rspec
  ruby-yard
)
checkdepends=(
  ruby-base64
  ruby-rack
  ruby-puma
  ruby-webrick
)
options=(!emptydirs)
source=(git+https://github.com/toland/patron#tag=v$pkgver)
sha256sums=('2558a859cc6b932e81c6243255ddfa998b4ed8bfeb3ab49829f6d4439aa03ad5')

prepare() {
  cd patron
  # Rack 3 removed Rack::File: https://github.com/toland/patron/pull/208
  sed -i 's/Rack::File\b/Rack::Files/g' spec/support/config.ru
  # Allow COPY in Puma's test server: https://github.com/toland/patron/pull/208
  sed -i 's/:Host => host)/:Host => host, :supported_http_methods => Puma::Const::SUPPORTED_HTTP_METHODS + ["COPY"])/' spec/support/test_server.rb
  # Puma 7 lowercases response headers: https://github.com/puma/puma/pull/3704
  sed -i -E "s/(response\.headers)\['([^']+)'\]/\1.transform_keys(\&:downcase)['\L\2']/g" spec/{response,session}_spec.rb
}

build() {
  local _gemdir="$(gem env gemdir)"
  cd patron
  rake build
  gem install \
    --local \
    --verbose \
    --ignore-dependencies \
    --no-user-install \
    --install-dir "tmp_install/$_gemdir" \
    --bindir "tmp_install/usr/bin" \
    pkg/patron-$pkgver.gem

  # remove unreproducible files
  rm --force --recursive --verbose \
    "tmp_install${_gemdir}/cache/" \
    "tmp_install${_gemdir}/gems/${_gemname}-${pkgver}/vendor/" \
    "tmp_install${_gemdir}/doc/${_gemname}-${pkgver}/ri/ext/"

  find "tmp_install${_gemdir}/gems/" \
    -type f \
    \( \
      -iname "*.o" -o \
      -iname "*.c" -o \
      -iname "*.so" -o \
      -iname "*.time" -o \
      -iname "gem.build_complete" -o \
      -iname "Makefile" \
    \) \
    -delete

  find "tmp_install${_gemdir}/extensions/" \
    -type f \
    \( \
      -iname "mkmf.log" -o \
      -iname "gem_make.out" \
    \) \
    -delete
}

check() {
  local _gemdir="$(gem env gemdir)"
  cd patron
  GEM_HOME="tmp_install/$_gemdir" rake spec
}

package() {
  cd patron
  cp -a tmp_install/* "$pkgdir"/

  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
