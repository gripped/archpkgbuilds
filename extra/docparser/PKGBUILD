# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=docparser
pkgver=1.0.12
pkgrel=1
pkgdesc='A document parser library ported from document2html'
arch=('x86_64')
url="https://github.com/linuxdeepin/docparser"
license=('LGPL-3.0-or-later')
depends=('poppler' 'libzip' 'pugixml' 'freetype2' 'libxml2' 'util-linux-libs' 'tinyxml2')
makedepends=('git' 'qt5-tools')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/docparser.git#tag=$pkgver")
b2sums=('8bd06c3089705c0ab37e0806cac23db08c0e34a6fa7625c192a9bfc0a73505201c91fe4b4b8961ee01bd2b8023d6bdd536bc21a8e219ffde397dc7c461921ee9')

build() {
  cd docparser
  qmake-qt5 PREFIX=/usr
  make
}

package() {
  cd docparser
  make INSTALL_ROOT="$pkgdir" install
}
