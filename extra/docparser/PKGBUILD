# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=docparser
pkgver=1.0.13
pkgrel=1
pkgdesc='A document parser library ported from document2html'
arch=('x86_64')
url="https://github.com/linuxdeepin/docparser"
license=('LGPL-3.0-or-later')
depends=('poppler' 'libzip' 'pugixml' 'freetype2' 'libxml2' 'util-linux-libs' 'tinyxml2')
makedepends=('git' 'cmake')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/docparser.git#tag=$pkgver")
b2sums=('c45ce7b93a8a4d4be23675bab3246c2f7006a0cdd8e9b5fd5c981b41ac7d0ff39ddeaa441a59606bd0bcf506bde2af2600f21be51022652ddde8d57fc14a4eb0')

prepare() {
  cd docparser
  sed -i 's/add_link_options(-z noexecstack -pie -fPIC)/add_link_options(-z noexecstack)/' CMakeLists.txt
}

build() {
  cd docparser
  cmake -B build -S . \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib
  cmake --build build
}

package() {
  cd docparser
  DESTDIR="$pkgdir" cmake --install build
}
