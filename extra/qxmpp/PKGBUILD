pkgname=qxmpp
pkgver=1.16.1
pkgrel=1
pkgdesc='Cross-platform C++ XMPP client and server library'
arch=(x86_64)
url='https://invent.kde.org/libraries/qxmpp'
license=(LGPL-2.1-or-later)
depends=(glib2
         glibc
         gstreamer
         libgcc
         libstdc++
         openssl
         qt6-base)
makedepends=(cmake
             extra-cmake-modules
             git
             libomemo-c
             qt6-tools)
optdepends=('libomemo-c: OMEMO support')
conflicts=(qxmpp-qt6)
provides=(qxmpp-qt6)
replaces=(qxmpp-qt6)
source=(git+https://invent.kde.org/libraries/qxmpp#tag=v$pkgver)
sha256sums=('3abd6e8d5287bc5a34ea28edfddf7699f2018551cb0e0ecce85632556d8f2cd9')

build() {
  cmake -B build -S $pkgbase \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_TESTS=OFF \
    -DWITH_GSTREAMER=ON \
    -DBUILD_OMEMO=ON \
    -DQT_VERSION_MAJOR=6
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
