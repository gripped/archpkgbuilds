pkgbase=ettercap
pkgname=(
  ettercap
  ettercap-gtk
)
pkgver=0.8.4
pkgrel=1
pkgdesc='Network sniffer/interceptor/logger for ethernet LANs'
arch=('x86_64')
url='https://www.ettercap-project.org/'
license=('GPL-2.0-or-later')
depends=(
  'curl' 'libcurl.so'
  'ethtool'
  'glibc'
  'libmaxminddb'
  'libnet'
  'libpcap'
  'ncurses' 'libncursesw.so' 'libpanelw.so' 'libformw.so' 'libmenuw.so'
  'openssl'
  'pcre2'
  'zlib'
)
makedepends=(
  'check'
  'cmake'
  'ghostscript'
  'gtk3'
  'harfbuzz'
)
options=('!emptydirs')
backup=(etc/ettercap/etter.{conf,dns,mdns,nbns})
source=(
  "https://github.com/Ettercap/ettercap/archive/v${pkgver}/${pkgbase}-${pkgver}.tar.gz"
  cmake-harfbuzz.patch
)
sha512sums=('ba96d1cda6302e754c7b180ac4e74f4e96cbf40edef04a5f14e287225b0fe3f7a71247f4fea5600fd1e20dc8b6950730e6a629e6015d4afeb887662d2e859e47'
            '56e75ae2fe6b3761a121d7062133c53d9b15894662c9ce341dd67eb4913983e926975f4a0901e2f2bf1c85933eb45e1842500e1c6a9af4738c761b328b3b8745')
b2sums=('2ba8e911fd94783b211d68ad868e5e056ffdbdc1905af48826ca76a0ea9b2c14ae863a8e32c33ca28263917f4007b414b67343799410e58d876a8f17f2ef14ab'
        'da9a1306637e28b5c00b4e2615b999a92d3365f8fad7ba956c10e16e09c1fb8dbe3e529fb70758fc891d8741975026aa167f957316deb814def76014750cc50f')

prepare() {
  cd ${pkgbase}-${pkgver}
  patch -Np1 < "${srcdir}/cmake-harfbuzz.patch"
}

build() {
  cmake -B build -S ${pkgbase}-${pkgver} \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -W no-dev \
    -D ENABLE_GTK=OFF \
    -D ENABLE_TESTS=ON \
    -D ENABLE_IPV6=ON
  cmake --build build

  cmake -B build-gtk -S ${pkgbase}-${pkgver} \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -W no-dev \
    -D ENABLE_GTK=ON \
    -D ENABLE_TESTS=ON \
    -D ENABLE_IPV6=ON
  cmake --build build-gtk
}

check() {
  ctest --test-dir build --output-on-failure
  ctest --test-dir build-gtk --output-on-failure
}

package_ettercap() {
  pkgdesc+=" - console"
  provides=('libettercap.so')

  DESTDIR="${pkgdir}" cmake --install build
  cd ${pkgbase}-${pkgver}
  install -vDm 644 -t "${pkgdir}/usr/share/doc/${pkgname}" CHANGELOG README*
}

package_ettercap-gtk() {
  pkgdesc+=" - GTK frontend"
  depends+=(
    'gdk-pixbuf2'
    'glib2'
    'gtk3'
    'harfbuzz'
    'hicolor-icon-theme'
  )
  optdepends=('polkit: run ettercap directly from menu')
  provides=(
    'ettercap'
    'libettercap.so'
  )
  conflicts=('ettercap')

  DESTDIR="${pkgdir}" cmake --install build-gtk
  cd ${pkgbase}-${pkgver}
  install -vDm 644 -t "${pkgdir}/usr/share/doc/${pkgname}" CHANGELOG README*
}
