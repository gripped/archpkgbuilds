From f463593a76ad65be1d8bcbb349e397893543406b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ball=C3=B3=20Gy=C3=B6rgy?= <ballogyor@gmail.com>
Date: Mon, 26 Oct 2026 17:53:37 +0100
Subject: [PATCH] base-window: Fix use-after-free when disconnecting signals

The loop deleted the current list link but then accessed its
next pointer in the loop increment expression. Save the next
link before deleting the current one to avoid accessing freed
memory.

This fixes a segmentation fault when closing the configuration
tool.
---
 src/cact/base-window.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/cact/base-window.c b/src/cact/base-window.c
index 27f5c58b..bdcd3ddc 100644
--- a/src/cact/base-window.c
+++ b/src/cact/base-window.c
@@ -1294,14 +1294,17 @@ base_window_signal_disconnect( BaseWindow *window, gulong handler_id )
 
 	if( !window->private->dispose_has_run ){
 
-		for( it = window->private->signals ; it ; it = it->next ){
+		for( it = window->private->signals ; it ; ){
 			RecordedSignal *str = ( RecordedSignal * ) it->data;
+			GList *next = it->next;
 
 			if( str->handler_id == handler_id ){
 				g_signal_handler_disconnect( str->instance, str->handler_id );
 				window->private->signals = g_list_delete_link( window->private->signals, it );
 				g_free( str );
 			}
+
+			it = next;
 		}
 	}
 }
