# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-pydocket
pkgver=0.32.1
pkgrel=1
pkgdesc='Distributed background task system for Python functions'
arch=('any')
url='https://github.com/chrisguidry/docket'
license=('MIT')
depends=(
  'python'
  'python-burner-redis'
  'python-cachetools'
  'python-cloudpickle'
  'python-cronsim'
  'python-json-logger'
  'python-opentelemetry-api'
  'python-prometheus_client'
  'python-py-key-value-aio'
  'python-redis'
  'python-rich'
  'python-typer'
  'python-typing_extensions'
  'python-uncalled-for'
)
makedepends=(
  'git'
  'python-build'
  'python-hatch-vcs'
  'python-hatchling'
  'python-installer'
)
checkdepends=(
  'python-docker'
  'python-opentelemetry-sdk'
  'python-packaging'
  'python-psutil'
  'python-pytest'
  'python-pytest-asyncio'
  'python-pytest-cov'
  'python-pytest-timeout'
  'python-pytest-xdist'
  'valkey'
)
optdepends=('python-opentelemetry-sdk: metrics export')
source=("git+https://github.com/chrisguidry/docket.git#tag=python/v$pkgver"
        'local-valkey-tests.patch')
sha512sums=('3ba5cbdbca9ed1010eb75db7217893ae2478fe323c8e2caf34a3434e9261d0c3be7683a9c6472b8fb66f6bab83538b90561260ab2e49f6a7c0b9e3b50b151b70'
            '6db4d0809af5eee1840bdfcb0c36bacb8e7a05c8a4f38afbc07a46d3553d3a78c19f7c919b4182e0119abd68618a816fa675dda8f1e9f603e15f8c390ef92876')

prepare() {
  cd docket
  # Use local Valkey processes because the build chroot has no Docker daemon.
  git apply "$srcdir/local-valkey-tests.patch"
  # Keep packaging changes out of the version derived from the release tag.
  sed -i 's/git describe --dirty/git describe/' python/pyproject.toml
  # Omit the deselected invariant's file from the test-source coverage gate.
  sed -i '/^    tests\/sitecustomize.py$/a\    tests/worker/test_invariants.py' python/.coveragerc-core
  # Cloudpickle rebuilds this local test class as <dynamic-code>, so coverage
  # cannot attribute its __eq__ method to the source file.
  sed -i '/return isinstance(other, CustomObject)/s/$/  # pragma: no cover/' \
    python/tests/test_results_storage.py
}

build() {
  cd docket/python
  python -m build --wheel --no-isolation
}

check() {
  cd docket/python
  python -m venv --system-site-packages --without-pip "$srcdir/test-env"
  "$srcdir/test-env/bin/python" -m installer dist/*.whl
  # Use source paths for coverage, the installed wheel for package metadata, and
  # the core exclusions for both pytest and its CLI subprocesses.
  # Test assumes ContextVar was unset, but reset restores any prior value.
  COVERAGE_PROCESS_START=.coveragerc-core PYTHONPATH=src \
    "$srcdir/test-env/bin/python" -m pytest \
    --cov-config=.coveragerc-core \
    --deselect tests/worker/test_invariants.py::test_invariant_shared_context_reset_after_worker_exit
}

package() {
  cd docket/python
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
