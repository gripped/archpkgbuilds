pkgname=bun
pkgver=1.4.3
# From https://github.com/oven-sh/bun/blob/main/scripts/build/deps/webkit.ts#L6
_webkitver=0c06faadf65bf8e8c8ad3a5a8aca83e1e9ed653f
pkgrel=1
pkgdesc="Incredibly fast JavaScript runtime, bundler, test runner, and package manager – all in one"
arch=(x86_64 aarch64)
url="https://github.com/oven-sh/bun"
license=('MIT')
depends=(
  glibc
  icu
)
makedepends=(
  # Packaging requirements
  git
  unzip
  # bun make dependencies
  clang
  cmake
  lld
  llvm
  nasm
  ninja
  rustup
  # WebKit make dependencies
  python
  ruby
  ruby-erb
  ruby-getoptlong
)
options=('!lto')
source=(
  "git+$url.git#tag=bun-v$pkgver"
  "$pkgname-WebKit::git+https://github.com/oven-sh/WebKit.git#commit=$_webkitver"
  "$pkgname-webkit-typed-array-int32-conversion.patch"
)
source_x86_64=(
  "$pkgname-bootstrap-x64-$pkgver.zip::https://github.com/oven-sh/bun/releases/download/bun-v$pkgver/bun-linux-x64.zip"
)
source_aarch64=(
  "$pkgname-bootstrap-aarch64-$pkgver.zip::https://github.com/oven-sh/bun/releases/download/bun-v$pkgver/bun-linux-aarch64.zip"
)
b2sums=('f249e340de247e0244f5a3977370827085531582eec6e6cc90036aae597a82d4dda52a795ff1f837e53a5ea3f7a32d2bc1e6cd245b1c28a987ad909ab58a3fca'
        'a0398a42f34d5f5b96c7a875fba91f1e5f522dcdd3e7753f21df945b79400a7f9823e95e65fdd6453563ced36548cd4a4616acfd447bf4967d7f0caf1fb0e24b'
        'f7b41bee31d26968154501ad62d8fdc157cac9e0f895035ba9a1ddd30caa2beb83b5cf80f6a0e52dcc1acac874fb07ef7974761764929e6e782866f1aacf35c2')
b2sums_x86_64=('d13429f71a7fddef2e5f1aadb1b1971a2410ab107082942bf32106bf12024daa0230417ddfd8abb5d253155c935cffc59e42070095f47c0f7bdef90600f05547')
b2sums_aarch64=('b55e1d69a216fbb47473560b771ee9221e4613a66452e00654a593eefe72471cbdd03809b4f4bbdb3e3bea55ffedad9684b0cd51a991fddcce88df6f5637a524')

prepare() {
  # Fix UB in JSC typed array int32 conversion that causes wrong values
  # to be stored for numbers > INT32_MAX (https://github.com/oven-sh/bun/issues/28607)
  patch -Np1 -d $pkgname-WebKit < $pkgname-webkit-typed-array-int32-conversion.patch

  cd $pkgname

  grep -q "WEBKIT_VERSION = \"$_webkitver\"" scripts/build/deps/webkit.ts \
    || (echo "WebKit version mismatch"; exit 1)

  # Fix compatibility with older CPUs; see
  # https://gitlab.archlinux.org/archlinux/packaging/packages/bun/-/merge_requests/4.
  sed -i 's/-march=nehalem/-march=x86-64/' scripts/build/flags.ts

  # libspng unconditionally compiles its SSE4.1 defilter paths, which fails to
  # build against the x86-64 baseline set above. Drop down to the SSE2 paths.
  sed -i 's/SPNG_SSE: 4/SPNG_SSE: 1/' scripts/build/deps/libspng.ts

  # Place the WebKit checkout where bun's build system expects local WebKit sources
  # See also https://bun.sh/docs/project/contributing#building-webkit-locally-+-debug-mode-of-jsc
  mkdir -p vendor
  cp -r "$srcdir/$pkgname-WebKit" vendor/WebKit
}

build() {
  cd $pkgname

  export PATH="/usr/lib/llvm21/bin:$PATH"
  case "$CARCH" in
    x86_64)  _bundir="bun-linux-x64" ;;
    aarch64) _bundir="bun-linux-aarch64" ;;
  esac
  export PATH="$srcdir/$_bundir:$PATH"

  local bun_options=(
    --profile=release-local
    --canary=0
    --build-dir=build/release
    --cache-dir="$srcdir/build-cache"
  )

  if [[ ${CARCH} == x86_64* ]]; then
    bun_options+=(--baseline=on)
  fi

  bun scripts/build.ts "${bun_options[@]}"
}

check() {
  cd $pkgname

  ./build/release/bun --version
  echo 'console.log("ok")' | ./build/release/bun run -
}

package() {
  cd $pkgname

  install -vDm755 build/release/bun "$pkgdir/usr/bin/bun"
  ln -vs /usr/bin/bun "$pkgdir/usr/bin/bunx"
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE.md

  install -vDm644 completions/bun.bash "$pkgdir/usr/share/bash-completion/completions/bun"
  install -vDm644 completions/bun.fish "$pkgdir/usr/share/fish/vendor_completions.d/bun.fish"
  install -vDm644 completions/bun.zsh "$pkgdir/usr/share/zsh/site-functions/_bun"
}
