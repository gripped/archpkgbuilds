  "$pkgname-WebKit::git+https://github.com/oven-sh/WebKit.git#commit=$_webkitver"
  "$pkgname-webkit-typed-array-int32-conversion.patch"
)
source_x86_64=(
  "$pkgname-bootstrap-$pkgver.zip::https://github.com/oven-sh/bun/releases/download/bun-v$pkgver/bun-linux-x64.zip"
  "$pkgname-zig-$_zigver-x86_64.zip::https://github.com/oven-sh/zig/releases/download/autobuild-$_zigver/bootstrap-x86_64-linux-musl.zip"
)
