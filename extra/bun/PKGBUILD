pkgver=1.3.13
# From https://github.com/oven-sh/bun/blob/main/scripts/build/deps/webkit.ts#L6
_webkitver=4d5e75ebd84a14edbc7ae264245dcd77fe597c10
# From https://github.com/oven-sh/bun/blob/main/scripts/build/zig.ts#L36
