pkgname=deepin-polkit-agent
pkgver=6.0.25
pkgrel=1
pkgdesc='Deepin Polkit Agent'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-polkit-agent"
license=('GPL-3.0-or-later')
depends=('deepin-shell' 'deepin-session-shell' 'dtk6core' 'dtk6gui' 'dtk6widget' 'polkit-qt6' 'qt6-base' 'glibc' 'libgcc' 'libstdc++')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/dde-polkit-agent.git#tag=$pkgver")
sha512sums=('7cc020b1c739a3bc4d549ada26617e239b992210eb72a478dd87c9bef65a89705eb750ed3abbfc9c2699c25516f87aac4de0ce6b4d9a9403fb033e9c377e8751')

build() {
  cd dde-polkit-agent
  cmake . -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DUSE_DEEPIN_POLKIT=OFF
  ninja
}

package() {
  cd dde-polkit-agent
  DESTDIR="$pkgdir" ninja install
}
