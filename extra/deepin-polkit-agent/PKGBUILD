pkgname=deepin-polkit-agent
pkgver=6.0.22
pkgrel=1
pkgdesc='Deepin Polkit Agent'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-polkit-agent"
license=('GPL-3.0-or-later')
depends=('deepin-shell' 'dtk6core' 'dtk6gui' 'dtk6widget' 'polkit-qt6' 'qt6-base' 'glibc' 'libgcc' 'libstdc++')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/dde-polkit-agent.git#tag=$pkgver")
sha512sums=('0f03ec0e4b4504565098483f0331e3febc871ed8ae2376b717550662aa3fb0d4999df32f5bb81f208c72bb9b66bb7a412addedfbe065f17b23f3036b6cbc39b8')

build() {
  cd dde-polkit-agent
  cmake . -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DUSE_DEEPIN_POLKIT=OFF
  ninja
}

package() {
  cd dde-polkit-agent
  DESTDIR="$pkgdir" ninja install
}
