# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-aiofile
pkgver=3.12.3
pkgrel=1
pkgdesc="Asynchronous file operations with asyncio support"
arch=('any')
url="https://github.com/mosquito/aiofile"
license=('Apache-2.0')
depends=('python' 'python-caio')
makedepends=('git' 'python-build' 'python-hatchling' 'python-installer')
checkdepends=('python-aiomisc-pytest' 'python-markdown-pytest' 'python-pytest')
source=("git+https://github.com/mosquito/aiofile.git#tag=$pkgver")
sha512sums=('01c75ac0a0bc12b169b7cef43ef9bd2b50f534d8e3f402bfbae7031a650d248778ee8877cdd501e05f9408cc4c3355f23d7f657384c210c7c06d2020d40cc8fb')

prepare() {
  cd aiofile
  # Upstream sets the release version in its publishing workflow.
  sed -i "s/^version = .*/version = \"$pkgver\"/" pyproject.toml
}

build() {
  cd aiofile
  python -m build --wheel --no-isolation
}

check() {
  cd aiofile
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  # Match upstream CI, including executable README examples.
  test-env/bin/python -m pytest tests README.md
}

package() {
  cd aiofile
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENCE.md -t "$pkgdir/usr/share/licenses/$pkgname/"
}
