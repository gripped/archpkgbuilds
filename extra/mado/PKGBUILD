# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=mado
pkgver=0.3.1
pkgrel=1
pkgdesc="A fast Markdown linter written in Rust"
arch=(x86_64)
url="https://github.com/akiomik/mado"
license=(Apache-2.0)
depends=(
  libgcc
  glibc
)
makedepends=(rust)
options=(!lto)
source=(
  $pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz
)
sha512sums=('74ad751dffbb9cfa570adadd7a1ecb4045ed128338b71ef982cbf1ccc98d7146da003ca531aeaf0b0041f1f37508719a3501dd8520194c26af7c57688a755823')
b2sums=('d57fce4951912daf98ec3e65591f5caaf595b29df3c1228b14dcb1c6ba0feb32ed650fd2d0776fb3e0f7f7004c9dfd7da33370caffc7df423a675db31817c555')

prepare() {
  cd $pkgname-$pkgver
  cargo fetch --locked --target host-tuple
}

build() {
  cd $pkgname-$pkgver
  cargo build --frozen --release --all-features
}

check() {
  cd $pkgname-$pkgver
  cargo test --frozen --all-features
}

package() {
  cd $pkgname-$pkgver
  install -vDm 755 target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 {{CHANGELOG,README}.md,$pkgname.toml} -t "$pkgdir/usr/share/doc/$pkgname/"
}
