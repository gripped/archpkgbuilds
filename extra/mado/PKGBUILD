# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=mado
pkgver=0.4.0
pkgrel=1
pkgdesc="A fast Markdown linter written in Rust"
arch=(x86_64)
url="https://github.com/akiomik/mado"
license=(Apache-2.0)
depends=(
  glibc
  jemalloc
  libgcc
)
makedepends=(rust)
options=(!lto)
source=(
  $pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz
)
sha512sums=('4d3000b2bcbe7be472aa7e1c8831c14724a6593332df2d1a4a1849f6b1219f4cccd89c8c0ad0be2e79a63d87042751942401a242a0e85a90e0a5ba2ecb965deb')
b2sums=('6cb7c40f59d963e04718ce765b92475f2a9ed1ce55045f65dbe0b6fcbc120c6267e89ffb3f5503dcdca9b01bab954ba29348faa23d8185211c1f391088a4dbc4')

prepare() {
  cd $pkgname-$pkgver
  # Specifically add the tikv-jemalloc-sys dependency with a feature that unsets the prefix (as jemalloc is built without symbol prefix).
  cargo add tikv-jemalloc-sys --features unprefixed_malloc_on_supported_platforms
  cargo fetch --locked --target host-tuple
}

build() {
  cd $pkgname-$pkgver
  # Enforce the use of system-provided jemalloc
  export JEMALLOC_OVERRIDE=/usr/lib/libjemalloc.so
  cargo build --frozen --release
}

check() {
  cd $pkgname-$pkgver
  cargo test --frozen
}

package() {
  cd $pkgname-$pkgver
  install -vDm 755 target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 {{CHANGELOG,README}.md,$pkgname.toml} -t "$pkgdir/usr/share/doc/$pkgname/"
}
