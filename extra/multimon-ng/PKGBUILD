pkgname=multimon-ng
pkgver=1.6.0
pkgrel=1
pkgdesc="An SDR decoder that supports POCSAG, UFSK, CLIPFSK, AFSK, HAPN, FSK, DTMF, ZVEI"
url="https://github.com/EliasOenal/multimon-ng"
arch=('x86_64')
license=("GPL-2.0-only")
depends=(
  'glibc'
  'libpulse'
)
makedepends=('cmake')
optdepends=('sox: wav conversion')
source=("$url/archive/$pkgver/$pkgname-$pkgver.tar.gz")
sha512sums=('2b68f49ec07d4e96f720c19d46709b5fa4f9bf11700bad0ed6d3b7b9a0487e5da97f97b4462eb711200cd5ef9e265dbe92a52d72178f7eef9a1ddab00bfac0ea')

build() {
  export CMAKE_POLICY_VERSION_MINIMUM=3.5
  cmake -S $pkgname-$pkgver -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
