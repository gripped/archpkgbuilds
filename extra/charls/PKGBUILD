# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>

pkgname=charls
pkgver=2.4.4
pkgrel=1
pkgdesc="A C++ JPEG-LS library implementation"
arch=(x86_64)
url="https://github.com/team-charls/charls"
license=(BSD-3-Clause)
depends=(
  glibc
  libgcc
  libstdc++
)
makedepends=(
  cmake
  ninja
)
provides=(
  libcharls.so
)
source=($pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz)
b2sums=('e8ac2db2fada81c2fca975784ee7f79776439e632291184a5455276e523eb69778d6cb0d66b5543897e90978d7d98b7476b4c6ca73790b6ce208387339895a15')

build() {
  local cmake_options=(
    -B build
    -S $pkgname-$pkgver
    -G Ninja
    -W no-dev
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_INSTALL_PREFIX=/usr
    -DBUILD_SHARED_LIBS=ON
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -vDm 644 $pkgname-$pkgver/LICENSE.md -t "$pkgdir"/usr/share/licenses/$pkgname/
}
