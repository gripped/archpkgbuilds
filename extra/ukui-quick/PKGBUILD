# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=ukui-quick
pkgver=4.22.0.1
pkgrel=2
pkgdesc="Qt Quick framework and components for UKUI"
arch=('x86_64')
license=('GPL-3.0-or-later' 'GPL-2.0-or-later' 'LGPL-2.0-or-later'
         'LGPL-2.1-only OR LGPL-3.0-only' 'LGPL-3.0-or-later' 'MIT' 'MulanPSL-2.0')
url="https://gitee.com/openkylin/ukui-quick"
depends=('glibc' 'gsettings-qt6' 'kwayland' 'kwindowsystem' 'libgcc' 'libglvnd'
         'libkywc' 'libqtxdg' 'libstdc++' 'libx11' 'libxcb' 'qt6-5compat'
         'qt6-base' 'qt6-declarative' 'qt6-wayland' 'wayland')
makedepends=('clang' 'cmake' 'extra-cmake-modules' 'git' 'libdrm' 'libpipewire' 'ninja'
             'plasma-wayland-protocols' 'qt6-shadertools' 'qt6-tools' 'wayland-protocols')
optdepends=('qt6-ukui-platformtheme: UKUI Qt style and theme settings')
source=("git+https://gitee.com/openkylin/ukui-quick.git#tag=debian/$pkgver-1")
sha512sums=('2c837d864d18908d0cd70bdfe0054d2e8478383c4f7cb3310e2af91fd375b11cae0c6027c6107c2cfb794789c9db07e8bcae6f55208bdea6f89e2d0ad9182d1b')

prepare() {
  cd ukui-quick
  # Add the search host type required by ukui-search.
  # https://gitee.com/openkylin/ukui-quick/pulls/342
  git cherry-pick -n 08e04346389e42ed290354a15e5112d062438e6f
  # Provide the widget feature interfaces and QML bridge used by search plugins.
  # https://gitee.com/openkylin/ukui-quick/pulls/342
  git cherry-pick -n db9bf0d9ee5980e3fec9a848750b4f9bb6468273
  # Let the search window follow its root item's size.
  # https://gitee.com/openkylin/ukui-quick/pulls/350
  git cherry-pick -n 89ec40628ae12748fc15a5d4a938908d7b28caab

  # Use Arch's flat library and Qt header layout.
  sed -i 's|/\${CMAKE_LIBRARY_ARCHITECTURE}||g' \
    */CMakeLists.txt modules/*/CMakeLists.txt
  # Match the library version used by the CMake package metadata.
  sed -i -e 's|/@CMAKE_LIBRARY_ARCHITECTURE@||g' \
    -e 's|@VERSION@|@UKUI_QUICK_VERSION@|g' \
    core/ukui-quick-core.pc.in platform/ukui-quick-platform.pc.in \
    framework/ukui-quick-framework.pc.in
}

build() {
  # Tests require deferred ukui-control-center schemas and UKUI session services.
  cmake -S ukui-quick -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DBUILD_TEST=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 ukui-quick/COPYING ukui-quick/debian/copyright \
    -t "$pkgdir/usr/share/licenses/$pkgname"
}
