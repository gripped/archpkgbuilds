# Maintainer: Morten Linderud <foxboron@archlinux.org>

pkgname=govulncheck
pkgver=1.6.0
pkgrel=2
pkgdesc='Database client and tools for the Go vulnerability database'
arch=(x86_64)
url='https://github.com/golang/vuln'
license=(BSD-3-Clause)
depends=(glibc)
makedepends=(git go)
source=(go-vuln::git+https://go.googlesource.com/vuln#tag=v$pkgver)
sha256sums=('bdbdc5b2fcb86641466980848c1f723f0600d2d1ee55eeaa860c9d50e61280b1')

prepare() {
  cd "go-vuln"
  mkdir -p bin/

  export GOPATH="${srcdir}"
  go mod download -modcacherw
}

build() {
  cd "go-vuln"
  # export CGO_CPPFLAGS="${CPPFLAGS}"
  # export CGO_CFLAGS="${CFLAGS}"
  # export CGO_CXXFLAGS="${CXXFLAGS}"
  # export CGO_LDFLAGS="${LDFLAGS}"
  export CGO_ENABLED=1
  export GOFLAGS="-buildmode=pie -mod=readonly -modcacherw"
  go build -o bin/ ./cmd/...
}

check() {
  cd "go-vuln"
  # TODO: The tests doesn't actually run because of a rather complicate setup
  # go test ./...
}

package() {
  cd "go-vuln"
  install -Dm755 bin/govulncheck "$pkgdir/usr/bin/govulncheck"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
