# Maintainer: Nebulosa <nebulosa2007-at-yandex-dot-ru>

pkgname=chawan
pkgver=0.5.1
pkgrel=1
pkgdesc='A text-mode web browser and pager for Unix-like systems'
arch=(x86_64)
url='https://chawan.net/'
license=(Unlicense)
depends=(
  glibc
  brotli
  libssh2
  openssl
  sh
)
makedepends=(git 'nim>=2.0.0')
source=("$pkgname::git+https://git.sr.ht/~bptato/chawan#tag=v$pkgver")
sha512sums=('37338857d4f723503b890973dda36625fc40544aa2ef87d2b68fa04f67216d2cced413ef9493609c30caf793cbbc54c9628f320ee50ea45c35149e3b4dbeb322')
b2sums=('46347a571fab3e832455bb2a0518152503f35b57b676e91b6fd99c53a38df4eca70a3c7939e016dca1ab4bd06de400d71c52b8df1b4a906cf042ee160bacdb74')

build() {
  cd "$pkgname"

  export CFLAGS+=" -ffile-prefix-map=$srcdir/="

  make LIBEXECDIR=/usr/lib/chawan
}

package() {
  cd "$pkgname"

  make DESTDIR="$pkgdir" PREFIX='/usr' LIBEXECDIR="$pkgdir/usr/lib/chawan" install
}
