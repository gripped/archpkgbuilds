# Maintainer: Nebulosa <nebulosa2007-at-yandex-dot-ru>

pkgname=chawan
pkgver=0.5.3
pkgrel=1
pkgdesc='A text-mode web browser and pager for Unix-like systems'
arch=(x86_64)
url='https://chawan.net/'
license=(Unlicense)
depends=(
  glibc
  brotli
  libssh2
  openssl
  sh
)
makedepends=(git 'nim>=2.0.0')
source=("$pkgname::git+https://git.sr.ht/~bptato/chawan#tag=v$pkgver")
sha512sums=('ab8bd4209b233580910c4483df41b7554f2a300df3caff1b337239c350715eecfb2e9516169cff375f4d700ebdc905011d6de9eea363e180449585200c01b076')
b2sums=('9dbabbf3af8361f441887f2a195b7051b4efde9e820cfc2a76f46463f09b2ded91de5e5c80985b8e5ddefef8ddabb95c9c5aca581d5c3c7f8b8046388bba1a0b')

build() {
  cd "$pkgname"

  export CFLAGS+=" -ffile-prefix-map=$srcdir/="

  make LIBEXECDIR=/usr/lib/chawan
}

package() {
  cd "$pkgname"

  make DESTDIR="$pkgdir" PREFIX='/usr' LIBEXECDIR="$pkgdir/usr/lib/chawan" install
}
