# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=mbuffer
pkgver=20260929
pkgrel=1
pkgdesc="A tool for buffering data streams"
arch=(x86_64)
url="https://www.maier-komor.de/mbuffer.html"
license=(GPL-3.0-or-later)
depends=(
  glibc
  libgcc
)
makedepends=(openssl)
source=(
  https://www.maier-komor.de/software/$pkgname/$pkgname-$pkgver.tgz
)
sha512sums=('0d39da63a808a7671a4d5b684d5c989fc51b241ecf84d0f5f15ed07eb03bd8071961d4f28b4c38937ebc8e4e84c27ca13321461f39e0ce5a7a0a81166cfa0092')
b2sums=('7b9f57045339af9a02a4db09e6f02020265f478798fe7f78c34a92139fd271faab1749f257a7dd29bdfa3e1c8b1c8444a98b375047ed308b01067cad36c9f9a5')

prepare() {
  cd $pkgname-$pkgver
  autoreconf -fiv
}

build() {
  cd $pkgname-$pkgver
  ./configure --prefix=/usr --sysconfdir=/etc
  make
}

check() {
  make -k check -C $pkgname-$pkgver
}

package() {
  depends+=(
    openssl libcrypto.so
  )

  make DESTDIR="$pkgdir/" install -C $pkgname-$pkgver
}
