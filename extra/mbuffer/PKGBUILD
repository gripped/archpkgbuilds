# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=mbuffer
pkgver=20260301
pkgrel=1
pkgdesc="A tool for buffering data streams"
arch=(x86_64)
url="https://www.maier-komor.de/mbuffer.html"
license=(GPL-3.0-or-later)
depends=(
  glibc
  libgcc
)
makedepends=(openssl)
source=(
  https://www.maier-komor.de/software/$pkgname/$pkgname-$pkgver.tgz
)
sha512sums=('755368fc3d614258e8be00da37fa53801dd680b86dc39107bf706685d9630dba25706a87a83f05cd72cc1b146bce27af9e9ca4ddee5bc4e21a669306f6fb66a5')
b2sums=('5e566218038a9f20514a480be5f6181f02d32401fd81484d886c694bccb45ff6dd8fd08060d9c870dac6cc62925033ab6bd876f8260686210b20666504b77d05')

prepare() {
  cd $pkgname-$pkgver
  autoreconf -fiv
}

build() {
  cd $pkgname-$pkgver
  ./configure --prefix=/usr --sysconfdir=/etc
  make
}

check() {
  make -k check -C $pkgname-$pkgver
}

package() {
  depends+=(
    openssl libcrypto.so
  )

  make DESTDIR="$pkgdir/" install -C $pkgname-$pkgver
}
