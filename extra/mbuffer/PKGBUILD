# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=mbuffer
pkgver=20260926
pkgrel=1
pkgdesc="A tool for buffering data streams"
arch=(x86_64)
url="https://www.maier-komor.de/mbuffer.html"
license=(GPL-3.0-or-later)
depends=(
  glibc
  libgcc
)
makedepends=(openssl)
source=(
  https://www.maier-komor.de/software/$pkgname/$pkgname-$pkgver.tgz
)
sha512sums=('ad704dbf6c2d45ced3312a0ae83dc1159c15ef7470075e76bd00435fb61081cecc73067e6d889624aeca9124ce1c17334b4126d7d7935e7eadb4899637168998')
b2sums=('84afaed900f1862018518a3b55d4db6b93aacbf627576f9426b426b6ffbdbaaa1614d7e231f38be772a2c0ded929636f6988741038fc94d4b420a65bb2d9da60')

prepare() {
  cd $pkgname-$pkgver
  autoreconf -fiv
}

build() {
  cd $pkgname-$pkgver
  ./configure --prefix=/usr --sysconfdir=/etc
  make
}

check() {
  make -k check -C $pkgname-$pkgver
}

package() {
  depends+=(
    openssl libcrypto.so
  )

  make DESTDIR="$pkgdir/" install -C $pkgname-$pkgver
}
