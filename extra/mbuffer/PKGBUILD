# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=mbuffer
pkgver=20260511
pkgrel=1
pkgdesc="A tool for buffering data streams"
arch=(x86_64)
url="https://www.maier-komor.de/mbuffer.html"
license=(GPL-3.0-or-later)
depends=(
  glibc
  libgcc
)
makedepends=(openssl)
source=(
  https://www.maier-komor.de/software/$pkgname/$pkgname-$pkgver.tgz
)
sha512sums=('5b18e55db47aed2766b0b6b893c2523cff2d45f6a19235012f4197aa54a72df91d621d91c7577a027479a971fe4c0193df5c725c19f7688dfd01b2cc52b5e5dc')
b2sums=('35befc46db8d5f1e3d073c7ffa41afa57d7b55a0ca38b7f2922186427e0c4b2add824d6460dd5e7bf8d3f9120d4795bd2c290cd9f926b3c3ae4712379b4cf2b6')

prepare() {
  cd $pkgname-$pkgver
  autoreconf -fiv
}

build() {
  cd $pkgname-$pkgver
  ./configure --prefix=/usr --sysconfdir=/etc
  make
}

check() {
  make -k check -C $pkgname-$pkgver
}

package() {
  depends+=(
    openssl libcrypto.so
  )

  make DESTDIR="$pkgdir/" install -C $pkgname-$pkgver
}
