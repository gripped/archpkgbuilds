# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=mbuffer
pkgver=20261024
pkgrel=2
pkgdesc="A tool for buffering data streams"
arch=(x86_64)
url="https://www.maier-komor.de/mbuffer.html"
license=(GPL-3.0-or-later)
depends=(
  glibc
  libgcc
)
makedepends=(openssl)
source=(
  https://www.maier-komor.de/software/$pkgname/$pkgname-$pkgver.tgz
)
sha512sums=('76f3672f26a62c48947322b24cebd0c30f0699d0878664b7d9dbef0820e3cd309a22bf73988fc0eb83bf2b2464c3c5834d34b8fff5d080b8caba7fa536f6a0a5')
b2sums=('17ade9024c085514139499f75adf2db929b0bf8698ca9c9d3ca8c4f63763926b4ecd149b8a32b234820a31da8cde810c30c2d221791236d7346d370505a57dd1')

prepare() {
  cd $pkgname-$pkgver
  autoreconf -fiv
}

build() {
  cd $pkgname-$pkgver
  ./configure --prefix=/usr --sysconfdir=/etc
  make
}

check() {
  make -k check -C $pkgname-$pkgver
}

package() {
  depends+=(
    openssl libcrypto.so
  )

  make DESTDIR="$pkgdir/" install -C $pkgname-$pkgver
}
