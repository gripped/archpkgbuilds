# Maintainer: George Rawlinson <grawlinson@archlinux.org>
# Contributor: Tavian Barnes <tavianator@tavianator.com>

pkgname=bfs
pkgver=4.1.1
pkgrel=1
pkgdesc='A breadth-first version of find'
arch=(x86_64)
url='https://tavianator.com/projects/bfs.html'
license=(0BSD)
depends=(
  glibc
  acl
  libcap
  liburing
  oniguruma
)
makedepends=(git)
source=("$pkgname::git+https://github.com/tavianator/bfs#tag=$pkgver")
sha512sums=('c489a101790dc69988c84a1e5e0387695118e8c36d749c8b7496fd504a0177823eca3f8fbb9912c93900a4e3a74543b0b7b3d180523a6d402b611324c5c3f8dd')
b2sums=('da4487b4923bb7108f31ed5dfdc1bcc21591863f3832942941de110e5e57c7ec8eaf0007be14364c865a86ab1f259d8e6a713e5da00e8461c01fa26f03d28719')

build() {
  cd "$pkgname"

  ./configure RELEASE=y
  make CFLAGS="$CFLAGS"
}

check() {
  cd "$pkgname"

  make -k check CFLAGS="$CFLAGS"
}

package() {
  cd "$pkgname"

  make install DESTDIR="$pkgdir"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
