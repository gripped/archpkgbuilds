# Maintainer: George Rawlinson <grawlinson@archlinux.org>
# Contributor: Tavian Barnes <tavianator@tavianator.com>

pkgname=bfs
pkgver=4.1.3
pkgrel=1
pkgdesc='A breadth-first version of find'
arch=(x86_64)
url='https://tavianator.com/projects/bfs.html'
license=(0BSD)
depends=(
  glibc
  acl
  libcap
  liburing
  oniguruma
)
makedepends=(git)
source=("$pkgname::git+https://github.com/tavianator/bfs#tag=$pkgver")
sha512sums=('d15551cbf6f174b16daca853595c97bed442b0592a642c5f645a7c275e2dfab8703f4b7e3a806f92e0b93cd6b197cc142ec57bdf248fe475eb8b0b33ec4c061d')
b2sums=('8fc2ab8dbdf7122d7d860b80c0e12fd25141ba137b9297d87999b58a67e98ecac8fba29884d02030500ecfb3edb771ce5f3062170f5a302605f8dcccada58c9c')

build() {
  cd "$pkgname"

  ./configure RELEASE=y
  make CFLAGS="$CFLAGS"
}

check() {
  cd "$pkgname"

  make -k check CFLAGS="$CFLAGS"
}

package() {
  cd "$pkgname"

  make install DESTDIR="$pkgdir"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
