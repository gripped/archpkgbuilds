# Maintainer: George Rawlinson <grawlinson@archlinux.org>
# Contributor: Tavian Barnes <tavianator@tavianator.com>

pkgname=bfs
pkgver=4.1.7
pkgrel=1
pkgdesc='A breadth-first version of find'
arch=(x86_64)
url='https://tavianator.com/projects/bfs.html'
license=(0BSD)
depends=(
  glibc
  acl
  libcap
  liburing
  oniguruma
)
makedepends=(git)
source=("$pkgname::git+https://github.com/tavianator/bfs#tag=$pkgver")
sha512sums=('b2d6a23e82d7f8a0b4668fb19efcb93269bab808f39b6840a4764a36da979b6a4b36652d0c902fedf17f4522beafeceed26e0a230d9d90de6d7e37c5a6fd5529')
b2sums=('1bbfa672dbbd8d208e76c8d1d2dc31b40d3a0a82c251ab0e1afe6f675a5cc8b3b4f1a3a7d84dd5a1e8cae06ab1519ecbcb7924b1282840cc4476bb53c5d18a22')

build() {
  cd "$pkgname"

  ./configure RELEASE=y
  make CFLAGS="$CFLAGS"
}

check() {
  cd "$pkgname"

  make -k check CFLAGS="$CFLAGS"
}

package() {
  cd "$pkgname"

  make install DESTDIR="$pkgdir"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
