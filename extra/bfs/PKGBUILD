# Maintainer: George Rawlinson <grawlinson@archlinux.org>
# Contributor: Tavian Barnes <tavianator@tavianator.com>

pkgname=bfs
pkgver=4.1.5
pkgrel=1
pkgdesc='A breadth-first version of find'
arch=(x86_64)
url='https://tavianator.com/projects/bfs.html'
license=(0BSD)
depends=(
  glibc
  acl
  libcap
  liburing
  oniguruma
)
makedepends=(git)
source=("$pkgname::git+https://github.com/tavianator/bfs#tag=$pkgver")
sha512sums=('f6f0363b21ca232ddfe27fc66363528c10fa4bfa59370a547f6e2697960675fa1bfe79897dbb6655a0ef9e7cffe7f4ca5dd9b6843d0cb80512a9923eb5af3cfe')
b2sums=('998e16b8dc72b123ebbe8282551a2295f6137c782d9d3bf0db37a8843e76bfcd8b9b64ddcc6a767d6e75424c3d1a74fbdc2f5a7c3aea3d55ca24ebc1b60c0bc6')

build() {
  cd "$pkgname"

  ./configure RELEASE=y
  make CFLAGS="$CFLAGS"
}

check() {
  cd "$pkgname"

  make -k check CFLAGS="$CFLAGS"
}

package() {
  cd "$pkgname"

  make install DESTDIR="$pkgdir"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
