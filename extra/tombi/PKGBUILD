# Maintainer: Daniel M. Capella <polyzen@archlinux.org>
# Maintainer: Orhun Parmaksız <orhun@archlinux.org>

pkgname=tombi
pkgver=1.7.1
pkgrel=1
pkgdesc='TOML Formatter / Linter / Language Server'
arch=(x86_64)
url=https://tombi-toml.github.io/tombi/
license=(MIT)
depends=(
  libgcc
)
makedepends=(
  git
  cargo
)
options=(!lto)
source=("git+https://github.com/tombi-toml/tombi.git#tag=v$pkgver")
b2sums=('1ddbb7e6b80c49f2c3cac39ad4a92fa363b1704c136aacdd89f1f5891f7eb588f5d2e59c662b9669d5f4cba287a877e06565a3a2075dec0182dda2826eca0cef')

prepare() {
  cd $pkgname
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $pkgname
  cargo build --release --frozen

  mkdir -p "$srcdir"/completions
  target/release/$pkgname completion bash > "$srcdir"/completions/$pkgname.bash
  target/release/$pkgname completion zsh > "$srcdir"/completions/$pkgname.zsh
  target/release/$pkgname completion fish > "$srcdir"/completions/$pkgname.fish
}

package() {
  cd $pkgname
  install -Dt "$pkgdir"/usr/bin target/release/$pkgname
  install -Dt "$pkgdir"/usr/share/licenses/$pkgname LICENSE

  install -Dm644 "$srcdir"/completions/$pkgname.bash "$pkgdir"/usr/share/bash-completion/completions/$pkgname
  install -Dm644 "$srcdir"/completions/$pkgname.zsh "$pkgdir"/usr/share/zsh/site-functions/_$pkgname
  install -Dm644 "$srcdir"/completions/$pkgname.fish "$pkgdir"/usr/share/fish/vendor_completions.d/$pkgname.fish
}
