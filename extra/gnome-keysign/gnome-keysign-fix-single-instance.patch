From b90bcfd00fd69857c28975fcde1845e10be4603d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ball=C3=B3=20Gy=C3=B6rgy?= <ballogyor@gmail.com>
Date: Sat, 21 Nov 2026 01:50:35 +0100
Subject: [PATCH] Fix application activation and command-line handling

Present the existing window when the application is activated again
instead of creating a new one.

Forward command-line arguments to GApplication.run() and release
the application hold acquired by Twisted's GIReactor.
Also set the application process name for correct help output.
---
 keysign/app.py | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/keysign/app.py b/keysign/app.py
index c6f5464..fe7380b 100755
--- a/keysign/app.py
+++ b/keysign/app.py
@@ -114,6 +114,11 @@ def __init__(self, *args, **kwargs):
         self.pre_sign_widget = None
 
     def on_activate(self, app):
+        window = self.get_active_window()
+        if window:
+            window.present()
+            return
+
         ui_file_path = os.path.join(
             os.path.dirname(os.path.abspath(__file__)),
             "app4.ui")
@@ -215,8 +220,11 @@ def on_handle_exported(toplevel, handle, *args):
         window.present()
         self.add_window(window)
 
-    def run(self, args=[]):
-        super(KeysignApp, self).run()
+    def run(self, args=None):
+        if args is None:
+            args = sys.argv
+        self.release()
+        return super(KeysignApp, self).run(args)
 
     @staticmethod
     def on_delete_window(*args):
@@ -330,14 +338,15 @@ def on_presign_mapped(self, psw):
         self.internet_toggle.hide()
 
 
-def main(args=[]):
+def main(args=None):
+    if args is None:
+        args = sys.argv
+    GLib.set_prgname("gnome-keysign")
     logging.basicConfig(
         level=logging.DEBUG,
         format='%(name)s (%(levelname)s): %(message)s')
     log = logging.getLogger(__name__)
     log.debug('Running main with args: %s', args)
-    if not args:
-        args = []
     Gst.init(None)
 
     Adw.init()
