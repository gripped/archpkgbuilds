# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=gnome-keysign
pkgver=1.9.0
pkgrel=1
pkgdesc='Tool for signing OpenPGP keys'
arch=(any)
url='https://github.com/gnome-keysign/gnome-keysign'
license=(GPL-3.0-or-later)
depends=(
  avahi
  gdk-pixbuf2
  glib2
  gst-plugins-bad
  gst-plugins-base
  gst-plugins-base-libs
  gst-plugins-good
  gst-python
  gstreamer
  gtk4
  hicolor-icon-theme
  libadwaita
  magic-wormhole
  pango
  python
  python-cairo
  python-dbus
  python-gobject
  python-gpgme
  python-qrcode
  python-requests
  python-twisted
)
makedepends=(
  git
  python-babel-glade
  python-build
  python-installer
  python-setuptools
  python-wheel
)
source=(
  "git+https://github.com/gnome-keysign/gnome-keysign.git#tag=$pkgver"
  gnome-keysign-missing-icons.patch
  gnome-keysign-python-3.13.patch
  gnome-keysign-symbolic-icon.patch
)
b2sums=(
  d28e3ed8c491c91efca5c2e5833dc8904a81e5d7d4c68b4e17bd3658c6bd493c50f31bfffb16356e655dbccbdf9921bfc134abc198228140e6d39218c7df0a58
  298018e43f43d6109de6d40cc96041df7ee14b6f6c04087dc9fcf07cbab71f9be897bb38ef55f0405b21f76c767aeaaf11eb1846de9e2e8c6bd29ae87da4303f
  12869a37286fa63a92c635cbeb4a0311eaada2e9079f98cf0aa921220651b22feb8fc56d9ed53c2705727a3101c91fd9fb87c178bd7d448e00ab97382724cf97
  11d4b8c822e5d07dc70aa28e5b5969a6598182c1a15a501f3b8f5a19831ad3cb9da89519d8366941477b29d026a73444f21bc4e4372db6cb5ab8635de6a8a981
)

prepare() {
  cd $pkgname

  # Restore icons lost in GTK 4 UI migration
  # https://github.com/gnome-keysign/gnome-keysign/pull/127
  git apply -3 ../gnome-keysign-missing-icons.patch

  # Fix for Python 3.13
  # https://github.com/gnome-keysign/gnome-keysign/pull/128
  git apply -3 ../gnome-keysign-python-3.13.patch

  # Install symbolic icon
  # https://github.com/gnome-keysign/gnome-keysign/pull/129
  git apply -3 ../gnome-keysign-symbolic-icon.patch

}

build() {
  cd $pkgname
  python -m build --wheel --no-isolation
}

package() {
  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
}
