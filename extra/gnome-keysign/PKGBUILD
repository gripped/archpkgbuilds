# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=gnome-keysign
pkgver=1.9.8
pkgrel=2
pkgdesc='Tool for signing OpenPGP keys'
arch=(any)
url='https://github.com/gnome-keysign/gnome-keysign'
license=(GPL-3.0-or-later)
depends=(
  avahi
  gdk-pixbuf2
  glib2
  gst-plugins-bad
  gst-plugins-base
  gst-plugins-base-libs
  gst-plugins-good
  gst-python
  gstreamer
  gtk4
  hicolor-icon-theme
  libadwaita
  magic-wormhole
  pango
  python
  python-cairo
  python-dbus
  python-gobject
  python-gpgme
  python-qrcode
  python-requests
  python-twisted
)
makedepends=(
  git
  python-babel-glade
  python-build
  python-installer
  python-setuptools
  python-wheel
)
source=(
  "git+https://github.com/gnome-keysign/gnome-keysign.git#tag=$pkgver"
  gnome-keysign-fix-single-instance.patch
  gnome-keysign-dbus-activatable.patch
)
b2sums=(
  d3ad78d8079248844636618190b6a3a51ecc777c9f39289ed809fb6080d3fe395b5c307c88febf3785855c01480477bf72848d8ccff904c71f19d9b2ace55f1a
  c21c0e1c1c09f1642555d201312433c02a7fabfaad30e48e3664bdca046bfff48d6a71cf131841824c620c6fdb5c7e8160405876157985ac516e72089d0d5b6d
  16840b84eb6faf923a501be7ea4b76f898ebabe2fd08263ef18a60a0bdb25a60142aff9354bcc51b38858fe7de255d9fa4ce13e241120812e6701d6034213d43
)

prepare() {
  cd $pkgname

  # Fix application activation and command-line handling
  # https://github.com/gnome-keysign/gnome-keysign/pull/135
  git apply -3 ../gnome-keysign-fix-single-instance.patch

  # Add D-Bus activation support
  # https://github.com/gnome-keysign/gnome-keysign/pull/136
  git apply -3 ../gnome-keysign-dbus-activatable.patch
}

build() {
  cd $pkgname
  python -m build --wheel --no-isolation
}

package() {
  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
}
