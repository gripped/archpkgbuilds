# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=gnome-keysign
pkgver=1.9.7
pkgrel=1
pkgdesc='Tool for signing OpenPGP keys'
arch=(any)
url='https://github.com/gnome-keysign/gnome-keysign'
license=(GPL-3.0-or-later)
depends=(
  avahi
  gdk-pixbuf2
  glib2
  gst-plugins-bad
  gst-plugins-base
  gst-plugins-base-libs
  gst-plugins-good
  gst-python
  gstreamer
  gtk4
  hicolor-icon-theme
  libadwaita
  magic-wormhole
  pango
  python
  python-cairo
  python-dbus
  python-gobject
  python-gpgme
  python-qrcode
  python-requests
  python-twisted
)
makedepends=(
  git
  python-babel-glade
  python-build
  python-installer
  python-setuptools
  python-wheel
)
source=("git+https://github.com/gnome-keysign/gnome-keysign.git#tag=$pkgver")
b2sums=(e9290ebb1a274eb9264aafa8538f7e23c5c09b1ecf4d33c2c6ec91d92ad6b4e24f54d6858d2a347df2859e69c61e509e590664c79e97843430edf25672f7f435)

prepare() {
  cd $pkgname
}

build() {
  cd $pkgname
  python -m build --wheel --no-isolation
}

package() {
  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
}
