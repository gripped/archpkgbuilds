# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=gnome-keysign
pkgver=1.9.6
pkgrel=1
pkgdesc='Tool for signing OpenPGP keys'
arch=(any)
url='https://github.com/gnome-keysign/gnome-keysign'
license=(GPL-3.0-or-later)
depends=(
  avahi
  gdk-pixbuf2
  glib2
  gst-plugins-bad
  gst-plugins-base
  gst-plugins-base-libs
  gst-plugins-good
  gst-python
  gstreamer
  gtk4
  hicolor-icon-theme
  libadwaita
  magic-wormhole
  pango
  python
  python-cairo
  python-dbus
  python-gobject
  python-gpgme
  python-qrcode
  python-requests
  python-twisted
)
makedepends=(
  git
  python-babel-glade
  python-build
  python-installer
  python-setuptools
  python-wheel
)
source=("git+https://github.com/gnome-keysign/gnome-keysign.git#tag=$pkgver")
b2sums=(f9971d3df334783b19e4207076e19682f98415e0061f1c2afaf9be22332264a1e57776f736f39cf6de20c3c8d903bbed3838856e6d9ea6490844be6aa6f29245)

prepare() {
  cd $pkgname
}

build() {
  cd $pkgname
  python -m build --wheel --no-isolation
}

package() {
  cd $pkgname
  python -m installer --destdir="$pkgdir" dist/*.whl
}
