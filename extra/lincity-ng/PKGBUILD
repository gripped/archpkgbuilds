# Maintainer: Carl Smedstad <carsme@archlinux.org>
# Contributor: Eric Bélanger <eric@archlinux.org>

pkgname=lincity-ng
pkgver=2.14.2
pkgrel=3
pkgdesc="A city simulation game"
arch=('x86_64')
url="https://github.com/lincity-ng/lincity-ng"
license=(
  'CC-BY-SA-2.0'
  'GPL-2.0-or-later'
  'LicenseRef-ArevFontsCopyright'
  'LicenseRef-BitstreamVeraFontsCopyright'
)
depends=(
  'fmt'
  'glibc'
  'hicolor-icon-theme'
  'libgcc'
  'libstdc++'
  'libxml++-5.0'
  'libxml2'
  'sdl2'
  'sdl2_image'
  'sdl2_mixer'
  'sdl2_ttf'
  'zlib'
)
makedepends=(
  'cmake'
  'git'
  'libxslt'
)
source=("git+$url.git#tag=lincity-ng-$pkgver")
b2sums=('58cc1c1db1a6fb4601f3863af3190803684df930816dcc417b1a7b3c5bf7f95664d2495c2ade7ec34e7fee464d4957ebb1bfd0a90c7de00b924a2ff1cf1c600c')

build() {
  cmake -S $pkgname -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  cd $pkgname
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" COPYING-data.txt
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" COPYING-fonts.txt
}
