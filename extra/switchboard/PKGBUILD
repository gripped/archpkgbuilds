pkgname=switchboard
pkgver=8.0.3
pkgrel=2
pkgdesc='The Pantheon Control Center'
arch=(x86_64)
url=https://github.com/elementary/switchboard
license=(LGPL-2.1-only)
groups=(pantheon)
depends=(
  dconf
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  libadwaita-1.so
  libgee
  libgranite-7.so
)
makedepends=(
  git
  meson
  sassc
  vala
)
provides=(libswitchboard-3.so)
source=(git+https://github.com/elementary/switchboard.git#tag=${pkgver})
b2sums=('7f245c45c291dbc01acdd8d2e341a2ade0ea5f9bb6128246bd3009412a7adcb468c1bb20a9afa202cb89b1e3f383ff5c22063266ede0355d1223ab3169ee173b')

build() {
  arch-meson switchboard build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" meson install -C build
}

