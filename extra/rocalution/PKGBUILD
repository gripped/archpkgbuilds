# Maintainer: Christian Heusel <gromit@archlinux.org>
# Contributor: Markus Näther <naetherm@informatik.uni-freiburg.de>

pkgname=rocalution
pkgver=10.1
pkgrel=1
pkgdesc='Next generation library for iterative sparse solvers for ROCm platform'
arch=('x86_64')
url='https://rocm.docs.amd.com/projects/rocALUTION/en/latest/index.html'
license=('MIT')
depends=(
  'glibc'
  'hip-runtime-amd'
  'libgcc'
  'openmp'
  'openmpi'
  'rocblas'
  'rocm-core'
  'rocprim'
  'rocrand'
  'rocsolver'
  'rocsparse'
)
makedepends=('cmake' 'rocm-cmake' 'rocm-toolchain' 'rocm-llvm' 'openmp' 'openmpi')
_git='https://github.com/ROCm/rocm-libraries'
source=("$pkgname-$pkgver.tar.gz::$_git/releases/download/therock-$pkgver/$pkgname.tar.gz")
sha256sums=('88e65c897bf0533b020bc9a0e4ab35d9a0138a716b6c82a4dc0b4e8e5ca7e151')
options=(!lto)

build() {
  # -g also emits DWARF for every GPU target into .hip_fatbin, which strip
  # does not remove. Keep host debug info only.
  CXXFLAGS+=" -Xarch_device -g0"
  # -fcf-protection is not supported by HIP, see
  # https://rocm.docs.amd.com/projects/llvm-project/en/latest/reference/rocmcc.html#support-status-of-other-clang-options
  CXXFLAGS+=" -fcf-protection=none"
  export CC=/opt/rocm/lib/llvm/bin/amdclang
  export CXX=/opt/rocm/lib/llvm/bin/amdclang++
  local cmake_args=(
    -Wno-dev
    -S "$pkgname"
    -B build
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_TOOLCHAIN_FILE="$srcdir/$pkgname/toolchain-linux.cmake"
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    -D ROCM_PATH=/opt/rocm
    # FindHIP looks for clang in $ROCM_PATH/llvm/bin
    -D HIP_CLANG_PATH=/opt/rocm/lib/llvm/bin
    -D SUPPORT_HIP=ON
    -D SUPPORT_OMP=ON
    -D SUPPORT_MPI=ON
    -D BUILD_SHARED_LIBS=ON
    # gfx9-generic does not cover gfx908 and gfx90a.
    -D GPU_TARGETS="$(rocm-supported-gfx -e gfx950);gfx908:xnack-;gfx90a:xnack+;gfx90a:xnack-"
  )
  cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$pkgname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
