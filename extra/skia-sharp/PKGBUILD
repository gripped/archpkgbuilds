# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=skia-sharp
pkgver=4.153.1
IFS='.' read -r _major _minor _patch <<< ${pkgver}
pkgrel=1
pkgdesc='The Skia 2D Graphics library from Google exposed to .NET languages and runtimes across the board'
arch=(x86_64)
url=https://github.com/mono/SkiaSharp
license=(MIT)
depends=(
  expat
  fontconfig
  freetype2
  glibc
  libjpeg-turbo
  libheif
  libpng
  libstdc++
  libwebp
  vulkan-icd-loader
  zlib
)
makedepends=(
  clang
  git
  python
  vulkan-headers
)
provides=(libSkiaSharp.so)
source=(
  git+https://github.com/mono/SkiaSharp.git#tag=v${pkgver}
  git+https://chromium.googlesource.com/chromium/tools/depot_tools.git
  git+https://github.com/mono/skia.git
)
b2sums=('bdc6bee547d658e2e9d10495a14d6f8bb4758c2169a4d9ccec139d06ca7b2ceb83c678740dbaeff4ec143edfd3a9e502f7d3f6378fd724e8aec351971903bb36'
        'SKIP'
        'SKIP')

prepare() {
  cd SkiaSharp
  for submodule in externals/{depot_tools,skia}; do
    git submodule init ${submodule}
    git config submodule.${submodule}.url ../${submodule#*/}
    git -c protocol.file.allow=always submodule update ${submodule}
  done

  pushd externals/skia
  python tools/git-sync-deps
  python bin/fetch-ninja
  popd
}

build(){
  cd SkiaSharp/externals/skia

  export PATH="${srcdir}/SkiaSharp/externals/depot_tools:$PATH"

  CFLAGS="$CFLAGS \
    -I/usr/include/freetype2 \
    -DSKIA_C_DLL"

  extra_cflags=""
  for cflag in $CFLAGS; do
    extra_cflags+="\"${cflag}\","
  done
  extra_ldflags=""
  for ldflag in $LDFLAGS; do
    extra_ldflags+="\"${ldflag}\","
  done

  bin/gn gen out \
    --args="target_os=\"linux\" \
            target_cpu=\"x64\" \
            cc=\"clang\" \
            cxx=\"clang++\" \
            extra_cflags=[${extra_cflags}] \
            extra_ldflags=[${extra_ldflags}] \
            skia_enable_ganesh=true \
            skia_enable_graphite=true \
            skia_enable_skottie=true \
            skia_enable_tools=false \
            skia_use_dng_sdk=false \
            skia_use_harfbuzz=false \
            skia_use_icu=false \
            skia_use_partition_alloc=false \
            skia_use_system_expat=true \
            skia_use_system_freetype2=true \
            skia_use_system_libjpeg_turbo=true \
            skia_use_system_libpng=true \
            skia_use_system_libwebp=true \
            skia_use_system_zlib=true \
            skia_use_vulkan=true \
            is_component_build=false \
            is_debug=false \
            is_official_build=true \
            linux_soname_version=\"${_minor}.${_patch}.0\""
  ninja -C out
}

package() {
  install -Dm 755 SkiaSharp/externals/skia/out/libSkiaSharp.so.${_minor}.${_patch}.0 -t "${pkgdir}"/usr/lib/
  ln -s libSkiaSharp.so.${_minor}.${_patch}.0 "${pkgdir}"/usr/lib/libSkiaSharp.so.${_minor}
  ln -s libSkiaSharp.so.${_minor} "${pkgdir}"/usr/lib/libSkiaSharp.so
  install -Dm 644 SkiaSharp/LICENSE.md -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}
