# Maintainer: George Hu <integral@archlinux.org>
# Contributor: Danct12 <danct12@disroot.org>

pkgname=libgbinder
pkgver=1.1.53
pkgrel=1
pkgdesc="GLib-style interface to binder"
arch=('x86_64')
url="https://github.com/mer-hybris/${pkgname}"
license=('BSD-3-Clause')
depends=('libglibutil' 'glib2' 'glibc')
provides=('libgbinder.so')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha512sums=('a32a5b1d61bbf597b6a18d0587ea01a43f70d1f1395686aeab382fe8ff375ddc30799955b558a31d8a5085f64f5d6efe75265a0ee9af8e925bf6d704e0f6e37c')

build() {
	KEEP_SYMBOLS=1 make -C "${pkgname}-${pkgver}" release pkgconfig
}

check() {
	make -C "${pkgname}-${pkgver}" test
}

package() {
	cd "${pkgname}-${pkgver}/"
	DESTDIR="${pkgdir}" make install-dev
	install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
