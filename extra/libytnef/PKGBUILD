pkgname=libytnef
pkgver=2.1.5
pkgrel=1
epoch=1
pkgdesc="Yerase's TNEF stream reader library (decodes winmail.dat)"
arch=(x86_64)
url='https://github.com/Yeraze/ytnef'
license=(GPL-2.0-or-later)
depends=(glibc)
makedepends=(git)
optdepends=('perl: ytnefprocess command')
source=("git+https://github.com/Yeraze/ytnef.git#tag=v$pkgver")
b2sums=(b71f6f47d18eb39db65cde4b1be0201ee053124f0e873d6ba4909ef5f0fca1e29e72cbe308688c01c976ac628c59940c3ac9f21a81a46b811dde5557b7681d73)

prepare() {
  cd ytnef
  autoreconf -fiv
}

build() {
  cd ytnef
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd ytnef
  make DESTDIR="$pkgdir" install
}
