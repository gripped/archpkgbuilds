# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=ukui-window-switch
pkgver=4.21.1.0
pkgrel=1
pkgdesc="Window switcher and multitasking view for the UKUI Wayland desktop"
arch=('x86_64')
license=('LGPL-2.0-or-later' 'GPL-3.0-or-later' 'GPL-2.0-or-later OR LGPL-3.0-only'
         'BSD-3-Clause')
url="https://gitee.com/openkylin/ukui-window-switch"
groups=('ukui')
depends=('bash' 'dbus' 'glibc' 'grep' 'gsettings-qt6' 'kglobalaccel'
         'kylin-wayland-compositor' 'libgcc' 'libglvnd' 'libkysdk-system' 'libkywc'
         'libqtxdg' 'libstdc++' 'procps-ng' 'qt6-base' 'qt6-declarative' 'qt6-wayland'
         'ukui-quick' 'ukui-search')
makedepends=('clang' 'cmake' 'extra-cmake-modules' 'git' 'kconfig' 'kcoreaddons' 'ki18n'
             'kwindowsystem' 'libdrm' 'ninja' 'qt6-tools')
source=("git+https://gitee.com/openkylin/ukui-window-switch.git#tag=debian/$pkgver-1")
sha256sums=('cf463036b65e7f84f2be510d5599a7d398170bf60ffc5a4d1b504fa312a6a51a')

prepare() {
  cd ukui-window-switch
  # Qt 6 takes a byte-array view instead of a pointer and length.
  sed -i 's/qChecksum(idc.constData(), idc.size())/qChecksum(idc)/' \
    windowsview/ukui-window-switch-wlcom/qtsingleapplication/src/qtlocalpeer.cpp
}

build() {
  cmake -S ukui-window-switch -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DQT_DEFAULT_MAJOR_VERSION=6
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # This release installs the launcher without executable permissions.
  install -Dm755 ukui-window-switch/windowsview/ukui-window-switch -t "$pkgdir/usr/bin"
  install -Dm644 ukui-window-switch/man/*.1 -t "$pkgdir/usr/share/man/man1"
  install -Dm644 ukui-window-switch/COPYING ukui-window-switch/debian/copyright \
    -t "$pkgdir/usr/share/licenses/$pkgname"
}
