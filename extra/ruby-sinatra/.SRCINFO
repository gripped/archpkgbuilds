pkgbase = ruby-sinatra
	pkgver = 4.2.2
	pkgrel = 1
	url = https://sinatrarb.com/
	arch = any
	license = MIT
	checkdepends = asciidoctor
	checkdepends = ruby-activesupport
	checkdepends = ruby-builder
	checkdepends = ruby-bundler
	checkdepends = ruby-childprocess
	checkdepends = ruby-erubi
	checkdepends = ruby-falcon
	checkdepends = ruby-haml
	checkdepends = ruby-kramdown
	checkdepends = ruby-minitest
	checkdepends = ruby-multi_json
	checkdepends = ruby-mustermann
	checkdepends = ruby-nokogiri
	checkdepends = ruby-puma
	checkdepends = ruby-rack
	checkdepends = ruby-rack-session
	checkdepends = ruby-rack-test
	checkdepends = ruby-rackup
	checkdepends = ruby-rake
	checkdepends = ruby-rdiscount
	checkdepends = ruby-rspec
	checkdepends = ruby-sass-embedded
	checkdepends = ruby-tilt
	checkdepends = ruby-zeitwerk
	makedepends = ruby-rdoc
	depends = ruby
	options = !emptydirs
	source = https://github.com/sinatra/sinatra/archive/v4.2.2/sinatra-v4.2.2.tar.gz
	source = 0001-use-full-mustermann-compiler-for-string-patterns.patch
	sha512sums = bbdbe07044612d27115e8a63ba36a771511d264e0786be2a164bd21f7c852b6ce06e0e65c0804f4ecb8481f4e0a19ca4f4aad22e8ce4ee845e867e4028a4e34f
	sha512sums = 3e5e5169a6222a1772f669c9384aae08ad023d624d9f10031c556400cf386ee30a2433ccf10fcf7511d06326de4a7d7dbb7ee4909d4acef7ec8ceaf0b20b761a

pkgname = ruby-sinatra
	pkgdesc = Classy web-development dressed in a DSL
	depends = ruby
	depends = ruby-mustermann
	depends = ruby-rack
	depends = ruby-rack-protection
	depends = ruby-rack-session
	depends = ruby-tilt

pkgname = ruby-sinatra-contrib
	pkgdesc = Collection of useful Sinatra extensions
	depends = ruby
	depends = ruby-multi_json
	depends = ruby-mustermann
	depends = ruby-rack-protection
	depends = ruby-sinatra
	depends = ruby-tilt

pkgname = ruby-rack-protection
	pkgdesc = Protect against typical web attacks, works with all Rack apps, including Rails
	depends = ruby
	depends = ruby-base64
	depends = ruby-rack
