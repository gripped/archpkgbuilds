pkgname=libfaketime
pkgver=0.9.14
pkgrel=1
pkgdesc='Report fake dates and times to programs without having to change the system-wide time.'
arch=('x86_64')
url='https://github.com/wolfcw/libfaketime'
license=('GPL-2.0-only')
depends=('glibc'
         'libgcc')
source=("https://github.com/wolfcw/$pkgname/archive/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('d6468957b11bae8e541524ad43f2cdf91e5d87c8996183897c0499856024c90c')
options=(!lto)

build() {
  cd "${pkgname}-${pkgver}"
  make PREFIX=/usr
}

package() {
  cd "${pkgname}-${pkgver}"
  make PREFIX=/usr DESTDIR="${pkgdir}" install
}
