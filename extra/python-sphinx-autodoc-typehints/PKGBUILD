pkgname=python-sphinx-autodoc-typehints
pkgver=3.17.7
pkgrel=1
pkgdesc='Type hints support for the Sphinx autodoc extension'
arch=(any)
url=https://github.com/tox-dev/sphinx-autodoc-typehints
license=(MIT)
depends=(
  python
  python-sphinx
)
makedepends=(
  git
  python-build
  python-hatch-vcs
  python-hatch-fancy-pypi-readme
  python-hatchling
  python-installer
  python-python-sbom
)
checkdepends=(
  python-pytest
  python-sphobjinv
  python-typing_extensions
  python-annotated-doc
  python-pydantic
  python-numpydoc
  python-sphinx-design
)
source=("$pkgname::git+$url.git#tag=$pkgver")
sha512sums=('21b1f43a94fe2317b878fe28a56eb1a65a3f961934c202e7aa543a80cbdc60a94e4ce3cb2d233432b0e348c6eba35443b34b71354146147ae2d17ac9b3cb9be7')
b2sums=('90e93f0519268de9ee6304cba9dadc3bfac2f337c72dc0295623b226ca259c0b9815d8c2f70674aca7079957818897fde9139b1878213441d81a63025cc4376e')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  # temporary install
  python -m installer --destdir="$(pwd)/tmp" dist/*.whl
  local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  export PYTHONPATH="$(pwd)/tmp/$site_packages"

  local pytest_options=(
    -vv
    --deselect tests/test_live_example.py::test_live_example_picker_variant_matches_a_build_with_that_conf["fully qualified"]
    --deselect tests/test_live_example.py::test_live_example_picker_variant_matches_a_build_with_that_conf["defaults"]
    --deselect tests/test_live_example.py::test_live_example_picker_variant_matches_a_build_with_that_conf["no return type"]
    --deselect tests/test_live_example.py::test_live_example_picker_variant_matches_a_build_with_that_conf["return type in the return text"]
    --deselect tests/test_live_example.py::test_live_example_picker_variant_matches_a_build_with_that_conf["three options"]
    --deselect tests/_render/test_intersphinx.py::test_mapped_name_picks_the_class_role_whatever_the_hash_seed["seed-0"]
    --deselect tests/_render/test_intersphinx.py::test_mapped_name_picks_the_class_role_whatever_the_hash_seed["seed-2"]
    --deselect tests/test_live_example.py::test_live_example_shows["conf"]
    --deselect tests/test_live_example.py::test_live_example_shows["source"]
    --deselect tests/test_live_example.py::test_live_example_shows["rendered default"]
    --deselect tests/test_live_example.py::test_live_example_shows["rendered type"]
    --deselect tests/test_live_example.py::test_live_example_tab_order
    --deselect tests/test_live_example.py::test_live_example_builtin_tab_renders_without_the_extension
    --deselect tests/test_live_example.py::test_live_example_links_through_the_parent_inventory
    --deselect tests/test_live_example.py::test_live_example_shows_why_the_builtin_build_fails
    --deselect tests/test_live_example.py::test_live_example_reuses_the_cached_render
  )
  pytest "${pytest_options[@]}"
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
