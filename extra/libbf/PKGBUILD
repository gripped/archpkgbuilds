# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=libbf
pkgver=2023.12.09
_ver=${pkgver//./-}
pkgrel=1
pkgdesc="A small library to handle arbitrary precision floating point numbers"
arch=('x86_64')
url="https://bellard.org/libbf/"
license=('MIT')
depends=('glibc')
source=("https://bellard.org/quickjs/quickjs-$_ver.tar.xz")
sha512sums=('c63cbff2c2e19512845e4fa2c1306eefcf03316f3e0f29187d6176aaddf840d0423d88429ec73d690da0297c78114092acff76b7f089cb8561214628c1e733c8')

build() {
  cd quickjs-$_ver
  # Keep decimal arithmetic and FFT multiplication enabled, as in upstream's build.
  CC="gcc -Wall $CFLAGS $LDFLAGS -DCONFIG_BIGNUM"
  $CC -c -fPIC libbf.c cutils.c
  $CC -shared -o libbf.so libbf.o cutils.o
}

package() {
  cd quickjs-$_ver
  install -Dm755 libbf.so -t "$pkgdir"/usr/lib/
  install -Dm644 libbf.h -t "$pkgdir"/usr/include/
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
# vim:set ts=2 sw=2 et:
