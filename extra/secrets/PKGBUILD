# Maintainer: Fabian Bornschein <fabiscafe@archlinux.org>
# Contibutor: Balló György <ballogyor+arch at gmail dot com>

pkgname=secrets
pkgver=14.1
pkgrel=1
pkgdesc="Password manager for GNOME which makes use of the KeePass v.4 format"
url="https://apps.gnome.org/Secrets"
arch=(any)
license=('GPL-3.0-only')
groups=(gnome-circle)
depends=(
  dconf
  glib2
  graphene
  gtk4
  gtksourceview5
  hicolor-icon-theme
  libadwaita
  python
  python-gobject
  python-pycryptodomex
  python-pyhibp
  python-pykcs11
  python-pykeepass
  python-pyotp
  python-pyusb
  python-requests
  python-validators
  python-yubico
  python-zxcvbn-rs
)
makedepends=(
  git
  gobject-introspection
  meson
)
checkdepends=(python-pytest)
provides=(gnome-passwordsafe)
conflicts=(gnome-passwordsafe)
replaces=(gnome-passwordsafe)
source=("git+https://gitlab.gnome.org/World/secrets.git#tag=${pkgver/[a-z]/.&}")
b2sums=('5793f8d4959878d56ee51b319a07d20a8352b4a0728088f2d8f67046060b75a8eb7e86094d7caebd78d37639621a8b9c895d3188ce2b843bf45dbf2a2a55b1c4')

prepare() {
  cd secrets
}

build() {
  arch-meson secrets build
  meson compile -C build
}

check() (
  export GSETTINGS_SCHEMA_DIR="$PWD/build/data"
  glib-compile-schemas "$GSETTINGS_SCHEMA_DIR"

  export PYTHONPATH="$PWD/build:$PWD/secrets"

  meson test -C build --print-errorlogs
)

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
