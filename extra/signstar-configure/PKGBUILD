# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=signstar-configure
_name=signstar
pkgver=0.1.2
pkgrel=1
pkgdesc="Runtime configuration for Signstar hosts"
arch=(x86_64)
url="https://signstar.archlinux.page/signstar-configure"
_url="https://gitlab.archlinux.org/archlinux/signstar"
license=('Apache-2.0 OR MIT')
depends=(
  glibc
  libgcc
  libusb
)
makedepends=(
  git
  just
  rust
  rust-script
)
source=($_name::git+$_url.git?signed#tag=$pkgname/$pkgver)
sha512sums=('d94d222379219c8d0e99c411cb84995b9f02eb22048e2d2cb70f8f12026874c4684b7e453fea7314832485f4f90e9c6de6d54a640b8db2749fadc5afe46244ca')
b2sums=('c7cbb3a61697ad37b3545a7f813376b8637294488fc13da0cdf3f4f048641ae2c02fb1443c8e6a5d2f0f9fa0a636d46db8efbb90b159b93595f70df354c720ab')
validpgpkeys=(
  991F6E3F0765CF6295888586139B09DA5BF0D338  # David Runge <dvzrv@archlinux.org>
  653909A2F0E37C106F5FAF546C8857E0D8E8F074  # Wiktor Kwapisiewicz <wiktor@metacode.biz>
)

prepare() {
  cd $_name
  cargo fetch --locked --target host-tuple
}

build() {
  cd $_name
  CFLAGS+=' -ffat-lto-objects'
  cargo build --frozen --release --package $pkgname
  just generate shell_completions $pkgname
  just generate manpages $pkgname
}

package() {
  install -vDm 755 $_name/target/release/$pkgname -t "$pkgdir/usr/bin/"
  install -vDm 644 $_name/$pkgname/{CHANGELOG,README}.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -vDm 644 $_name/LICENSES/*.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 $_name/output/manpages/*.1 -t "$pkgdir/usr/share/man/man1/"
  install -vDm 644 $_name/output/shell_completions/$pkgname.bash "$pkgdir/usr/share/bash-completion/completions/$pkgname"
  install -vDm 644 $_name/output/shell_completions/_$pkgname -t "$pkgdir/usr/share/zsh/site-functions/"
  install -vDm 644 $_name/output/shell_completions/$pkgname.fish -t "$pkgdir/usr/share/fish/vendor_completions.d/"
  install -vDm 644 $_name/$pkgname/resources/systemd/*.{service,timer} -t "$pkgdir/usr/lib/systemd/system/"
}

