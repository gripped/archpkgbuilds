# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=vandelay
pkgver=1.0.11
pkgrel=1
pkgdesc='JMAP importer-exporter & backup tool'
arch=(x86_64)
url='https://github.com/stalwartlabs/vandelay'
license=('Apache-2.0 OR MIT')
depends=(glibc libgcc sqlite)
makedepends=(git rust)
options=(!lto)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('8025107eda64d58f8d415997d3f9fae9dec25de31c4f3509425f35f11ec0efa4cc559b4d000bdfa0d8b9b722e72631e219af93c711ec8ba3a70344914ce21cd7')
b2sums=('9847a45ef66acd59e0e6e2a03549254fe72b37f2288abd185eed55a3f9568b83d286e176febdffc884189ebe68de6b0ef0c1d38acd7d69d0c9d044257db8387d')

prepare() {
  cd "$pkgname"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  # unbundle sqlite
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1

  cargo build --frozen --release
}

check() {
  cd "$pkgname"

  cargo test --frozen
}

package() {
  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" "target/release/$pkgname"

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
  cp -vr assets "$pkgdir/usr/share/doc/$pkgname"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSES/*
}
