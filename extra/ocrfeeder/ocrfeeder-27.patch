+    def setBackgroundImage(self, image_path):
+        """Load and set the background image."""
+        self.pixbuf = GdkPixbuf.Pixbuf.new_from_file(image_path)
+        self.image_width = self.pixbuf.get_width()
+        self.image_height = self.pixbuf.get_height()
+        self._update_size()
+        self.queue_draw()
+
+    def _update_size(self):
+        """Update the widget size based on image and scale."""
+        width = int(self.image_width * self._scale * 2)
+        height = int(self.image_height * self._scale * 1.5)
+        self.set_size_request(width, height)
+
+    def _on_draw(self, widget, cr):
+        """Handle the draw signal."""
+        # Apply transform
+        cr.save()
+        cr.scale(self._scale, self._scale)
+
+        # Draw background
+        allocation = self.get_allocation()
+        cr.set_source_rgb(0.9, 0.9, 0.9)
+        cr.rectangle(0, 0, allocation.width / self._scale, allocation.height / self._scale)
+        cr.fill()
+
+        # Draw image
+        if self.pixbuf:
+            Gdk.cairo_set_source_pixbuf(cr, self.pixbuf, 0, 0)
+            cr.paint()
+
+            # Draw frame (shadow effect)
+            r, g, b = self.IMAGE_FRAME_COLOR
+            cr.set_source_rgb(r, g, b)
+            # Right edge
+            cr.rectangle(self.image_width, 0,
+                         self.IMAGE_FRAME_THICKNESS, self.image_height + self.IMAGE_FRAME_THICKNESS)
+            cr.fill()
+            # Bottom edge
+            cr.rectangle(0, self.image_height,
+                         self.image_width + 1, self.IMAGE_FRAME_THICKNESS)
+            cr.fill()
+
+        # Draw all boxes
+        for box in self.boxes:
+            is_selected = box in self.selected_areas
+            box.draw(cr, is_selected, self.area_selected_stroke_rgba)
+
+        # Draw currently created area
+        if self.currently_created_area:
+            self.currently_created_area.draw(cr, True, self.area_selected_stroke_rgba)
+
+        cr.restore()
+        return False
 
