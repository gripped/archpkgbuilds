+class Box:
+    """A draggable, resizable rectangle representing an OCR region."""
+
+    MOUSE_STATE_NORMAL = 0
+    MOUSE_STATE_TOP_DRAG = 1 << 0
+    MOUSE_STATE_BOTTOM_DRAG = 1 << 1
+    MOUSE_STATE_LEFT_DRAG = 1 << 2
+    MOUSE_STATE_RIGHT_DRAG = 1 << 3
+
+    CURSOR_CHANGE_MAX_DISTANCE = 5
+
+    def __init__(self, x, y, width, height, fill_rgba, stroke_rgba):
+        self.x = x
+        self.y = y
+        self.width = width
+        self.height = height
+        self.fill_rgba = fill_rgba  # tuple (r, g, b, a) with values 0-255
+        self.stroke_rgba = stroke_rgba
+        self.start_point = None
+        self._drag_offset = None
+        self._canvas = None  # Reference to parent canvas for redraws
+
+    def set_property(self, name, value):
+        """GooCanvas compatibility: set a property by name."""
+        # Map GooCanvas property names to our attributes
+        prop_map = {
+            'x': 'x',
+            'y': 'y',
+            'width': 'width',
+            'height': 'height',
+            'fill-color-rgba': 'fill_rgba',
+            'fill_color_rgba': 'fill_rgba',
+            'stroke-color-rgba': 'stroke_rgba',
+            'stroke_color_rgba': 'stroke_rgba',
+        }
+        attr_name = prop_map.get(name, name.replace('-', '_'))
+        if attr_name in ('fill_rgba', 'stroke_rgba') and isinstance(value, int):
+            # Convert integer RGBA to tuple
+            value = (
+                (value >> 24) & 0xFF,
+                (value >> 16) & 0xFF,
+                (value >> 8) & 0xFF,
+                value & 0xFF
+            )
+        setattr(self, attr_name, value)
+        if self._canvas:
+            self._canvas.queue_draw()
+
+    def contains_point(self, px, py):
+        """Check if a point is inside the box."""
+        return (self.x <= px <= self.x + self.width and
+                self.y <= py <= self.y + self.height)
+
+    def get_edge_at_point(self, px, py, threshold):
+        """
+        Determine which edge(s) are near the given point.
+        Returns a mouse state flag indicating which edges.
+        """
+        state = self.MOUSE_STATE_NORMAL
+
+        # Check top edge
+        if abs(py - self.y) < threshold and self.x <= px <= self.x + self.width:
+            state |= self.MOUSE_STATE_TOP_DRAG
+        # Check bottom edge
+        if abs(py - (self.y + self.height)) < threshold and self.x <= px <= self.x + self.width:
+            state |= self.MOUSE_STATE_BOTTOM_DRAG
+        # Check left edge
+        if abs(px - self.x) < threshold and self.y <= py <= self.y + self.height:
+            state |= self.MOUSE_STATE_LEFT_DRAG
+        # Check right edge
+        if abs(px - (self.x + self.width)) < threshold and self.y <= py <= self.y + self.height:
+            state |= self.MOUSE_STATE_RIGHT_DRAG
+
+        return state
+
+    def overlaps(self, other):
+        """Check if this box overlaps with another box."""
+        return not (self.x + self.width <= other.x or
+                    other.x + other.width <= self.x or
+                    self.y + self.height <= other.y or
+                    other.y + other.height <= self.y)
+
+    def draw(self, cr, selected=False, selected_stroke_rgba=None):
+        """Draw the box using Cairo."""
+        # Fill
+        r, g, b, a = [c / 255.0 for c in self.fill_rgba]
+        cr.set_source_rgba(r, g, b, a)
+        cr.rectangle(self.x, self.y, self.width, self.height)
+        cr.fill()
+
+        # Stroke
+        if selected and selected_stroke_rgba:
+            r, g, b, a = [c / 255.0 for c in selected_stroke_rgba]
+        else:
+            r, g, b, a = [c / 255.0 for c in self.stroke_rgba]
+        cr.set_source_rgba(r, g, b, a)
+        cr.set_line_width(2.0)
+        cr.rectangle(self.x, self.y, self.width, self.height)
+        cr.stroke()
+
