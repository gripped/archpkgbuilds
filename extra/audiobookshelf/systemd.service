[Unit]
Description=Self-hosted audiobook server for managing and playing audiobooks
Requires=network.target

[Service]
Type=simple
User=audiobookshelf
Group=audiobookshelf
EnvironmentFile=/etc/audiobookshelf.env
WorkingDirectory=/var/lib/audiobookshelf
ExecStart=/usr/bin/node /usr/lib/audiobookshelf/index.js
ExecReload=/bin/kill -HUP $MAINPID
Restart=always

# environment variables that should not be changed
Environment=NODE_ENV=production
Environment=SOURCE=archlinux
Environment=FFMPEG_PATH=/usr/bin/ffmpeg
Environment=FFPROBE_PATH=/usr/bin/ffprobe
Environment=NUSQLITE3_PATH=/usr/lib/libnusqlite3.so
Environment=SKIP_BINARIES_CHECK=1

[Install]
WantedBy=multi-user.target
