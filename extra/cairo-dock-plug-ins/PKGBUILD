pkgname=cairo-dock-plug-ins
pkgver=3.6.2
pkgrel=4
pkgdesc="Plugins for Cairo-Dock"
arch=('x86_64')
url="https://github.com/Cairo-Dock/${pkgname}"
license=('GPL-3.0-or-later')
depends=(
	'cairo-dock'
	'python'
	'python-dbus'
	'python-gobject'
	'ruby'
	'cairo'
	'pango'
	'librsvg'
	'dbus-glib'
	'libxml2'
	'glib2'
	'gtk3'
	'gdk-pixbuf2'
	'alsa-lib'
	'libetpan'
	'gnome-menus'
	'gvfs'
	'libxklavier'
	'libxrandr'
	'libx11'
	'libxxf86vm'
	'upower'
	'zeitgeist'
	'libexif'
	'vte3'
	'lm_sensors'
	'curl'
	'wget'
	'libdbusmenu-glib'
	'libdbusmenu-gtk3'
	'libayatana-indicator'
	'ayatana-ido'
	'libical'
	'libpulse'
	'fftw'
	'json-c'
)
makedepends=('cmake' 'git' 'vala')
replaces=('cairo-dock-plugins')
source=("git+${url}.git#tag=${pkgver}")
sha256sums=('c453c446293660aa0ffe19af679cca0c5eff31afb3247228605927e5be6a7a68')

prepare() {
	cd "${pkgname}/"

	# Fix build with libical 4
	git cherry-pick -n 077af5fd72b4aa42a77c750cef7e85a9ecf84b13

	# Fix clock widget startup when building against libical 4
	git cherry-pick -n 1ff4416a4b83b26b3beba3c1d4c11793f9b4440f
}

build() {
	cmake -B build \
		-S "${pkgname}" \
		-D CMAKE_BUILD_TYPE=None \
		-D CMAKE_PREFIX_PATH=/usr \
		-D WITH_VALA_SRC=yes

	cmake --build build
}

package() {
	DESTDIR="${pkgdir}" cmake --install build
}
