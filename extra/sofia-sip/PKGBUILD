# Contributor: Brian Bidulock <bidulock@openss7.org>
# Contributor: Ionut Biru <ibiru@archlinux.org>
# Contributor: Bjorn Lindeijer <bjorn lindeijer nl>

pkgname=sofia-sip
pkgver=1.13.19
pkgrel=1
pkgdesc="An open-source SIP User-Agent library"
arch=(x86_64)
url="http://sofia-sip.sourceforge.net"
license=('LGPL-2.1-only')
depends=(
  gawk
  glib2
  glibc
  openssl
  zlib
)
makedepends=(
  git
  glib2-devel
)
source=(
  "git+https://github.com/freeswitch/sofia-sip.git#tag=v$pkgver"
)
b2sums=('10f3bb3f09418cc4123df50947d07c1832f495c5f090b3e537ddfcdaeb294f5e076ec2d211144a419c47306fac70f7f458f3beceea7c4367f582e944bde21714')

prepare() {
  cd $pkgname
  # Replace removed OpenSSL APIs: https://github.com/freeswitch/sofia-sip/pull/337
  git cherry-pick -n 3cc785eeb186d6103ea628d15ec4915f1a59be1b
  ./autogen.sh
}

build() {
  cd $pkgname
  ./configure --prefix=/usr --with-openssl
  # Fight unused direct deps
  sed -i -e "s/ -shared / $LDFLAGS\0 /g" libtool
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
