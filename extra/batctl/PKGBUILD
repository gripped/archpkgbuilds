pkgname=batctl
pkgver=2026.4
_advver=$pkgver
pkgrel=1
pkgdesc='B.A.T.M.A.N. advanced control and management tool'
arch=('x86_64')
url='https://www.open-mesh.org/'
license=('GPL-2.0-only' 'MIT')
depends=('libnl')
source=("https://downloads.open-mesh.net/batman/releases/batman-adv-$_advver/batctl-$pkgver.tar.gz"{,.asc})
sha512sums=('de7e3c4b32a9c7f7b55ee97b2920611fd303f0cc5af39a01e6f8c2fa15044b4c7d94b5c622802d94965de81b5c999d828e312820ccb2262f8cef6925ba610cac'
            'SKIP')
validpgpkeys=('2DE9541A85CC87D5D9836D5E0C8A47A2ABD72DF9')  # Simon Wunderlich

build(){
  cd batctl-$pkgver
  make
}

package() {
  cd batctl-$pkgver
  make DESTDIR="$pkgdir" PREFIX=/usr SBINDIR=/usr/bin install
  install -Dm644 LICENSES/preferred/MIT -t $pkgdir/usr/share/licenses/$pkgname/
}
