pkgname=stalwart
pkgver=1.0.0
pkgrel=1
pkgdesc='Stalwart mail and collaboration server'
arch=(x86_64)
url='https://stalw.art'
license=(AGPL-3.0-only)
depends=(
  rocksdb
  stalwart-webadmin
)
makedepends=(
  git
  rust
  protobuf
  clang
  llvm
  python
)
optdepends=(
  'stalwart-cli: management CLI'
  'stalwart-proxy: migration proxy'
  'vandelay: JMAP import/export & backup'
)
backup=(etc/stalwart/config.env)
options=(!lto !debug !buildflags) # LTO causes FTBFS with rocksdb crate
install=stalwart.install
source=(
  "$pkgname::git+https://github.com/stalwartlabs/stalwart#tag=v$pkgver"
  systemd.service
  sysusers.conf
  tmpfiles.conf
  config.env
  use-local-webui-archive.patch
)
