pkgname=(stalwart{,-cli})
pkgver=0.15.5
pkgrel=2
pkgdesc='Stalwart mail and collaboration server'
arch=(x86_64)
url='https://stalw.art'
license=(AGPL-3.0-only)
makedepends=(
  git
  rust
  protobuf
  clang
  llvm
  libgcc
  libstdc++
  rocksdb
  python
)
options=(!lto !debug) # LTO causes FTBFS with rocksdb crate
source=(
  "$pkgbase::git+https://github.com/stalwartlabs/stalwart#tag=v$pkgver"
  systemd.service
  sysusers.conf
  tmpfiles.conf
  config.toml
)
