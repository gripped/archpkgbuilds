prepare() {
  cd "$pkgname"

  # ensure proprietary code is removed
  # https://github.com/stalwartlabs/stalwart/issues/783
  # https://github.com/stalwartlabs/stalwart/issues/768
  python resources/scripts/ossify.py crates/

  # use local webui in repos rather than
  # blindly trusting external file
  patch -p1 -i "$srcdir/use-local-webui-archive.patch"

  # download dependencies
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname"

  # link with system rocksdb
  # https://github.com/rust-rocksdb/rust-rocksdb/issues/310#issuecomment-1537137868
  export ROCKSDB_LIB_DIR="/usr/lib/"
  
  # note: no support for enterprise or foundationdb features
  # because that's a whole other can of beans
  cargo build --release --frozen -p stalwart --no-default-features --features "sqlite postgres mysql rocks s3 redis azure nats"
}

package() {
  depends+=(
    glibc
    libgcc libgcc_s.so
    libstdc++ libstdc++.so
  )
  # systemd integration
  install -vDm644 systemd.service "$pkgdir/usr/lib/systemd/system/stalwart.service"
  install -vDm644 sysusers.conf "$pkgdir/usr/lib/sysusers.d/stalwart.conf"
  install -vDm644 tmpfiles.conf "$pkgdir/usr/lib/tmpfiles.d/stalwart.conf"
  install -vDm640 config.env "$pkgdir/etc/stalwart/config.env"

  cd "$pkgname"

  # binary
  install -vDm755 -t "$pkgdir/usr/bin" "target/release/$pkgname"
}
