+++ b/sql/auth/sql_authentication.cc
@@ -2521,7 +2521,8 @@
       if (!(cert = SSL_get_peer_certificate(ssl))) return true;
       /* If X509 issuer is specified, we check it... */
       if (acl_user->x509_issuer) {
