pkgname=tt-rss
# Check https://github.com/tt-rss/tt-rss/discussions/categories/announcements when updating pkgver
pkgver=r12820.453aaf568
pkgrel=1
epoch=2
pkgdesc='Web-based news feed (RSS/Atom) aggregator'
arch=(any)
url='https://tt-rss.org'
# https://github.com/tt-rss/tt-rss/blob/main/README.md#license
license=('GPL-3.0-or-later')
backup=(etc/webapps/tt-rss/config.php)
# PHP 8.2 is required https://github.com/tt-rss/tt-rss/blob/8b07dc8453e0d029b000d8a73ebc059f95994400/classes/Config.php#L534
depends=('php-interpreter>=8.2')
install=tt-rss.install
optdepends=('postgresql'
            'php-gd-interpreter: for coloured feed badges')
makedepends=('git')
_commit=453aaf568ecc9ffd899f73ea2a412487a720304f
# periodic releases are over https://web.archive.org/web/20230809132536/https://srv.tt-rss.org/oldforum/viewtopic.php@f=10&t=3262.html
source=(git+https://github.com/tt-rss/tt-rss.git#commit=$_commit
       tt-rss.service
       config.php)
sha1sums=('193e948ef49eac6b357b7a6636322555f291e5bc'
          'd764e22065f8e0104b4f1d5dcf41cce01cd7bec5'
          'a572010239b6076fa75f95ba2616c816d3bdea7f')
sha512sums=('fe1f506bd23bfebc7ced9c047b3493b637a1624d706100a8182ee8fcd6a539f9c411cef306fcc627c2284e1535e4cffe7dba833052b0a05dc57fa577ab7dbcd9'
            'ffc4316d8f332b75932b36e9e0a18fb346a62a8f83094d3ca510b06b0d9ae0478bdc05e23bca4fe5e6dfcfc8a8c57ab1654b7c6d16a007f151afbcad31e359a5'
            'd97de631d92f539ff1647a807c7a0647fe7a5e458b70d329dcc7992367adfbae03ed755c2096dda3062847569f4dd1541ad63ae8df7d9eb9f4d2911d0903f4c4')

pkgver() {
  cd tt-rss
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd tt-rss

  # Generate version string following the logic of get_version_from_git()
  # https://github.com/tt-rss/tt-rss/blob/3468317bd34f63ba3c65904a8856cc41afa28102/classes/config.php#L324
  commiter_timestamp=$(git --no-pager log --pretty=%ct -n1 HEAD)
  abbrev_hash=$(git --no-pager log --pretty=%h -n1 HEAD)
  echo $(date --date=@$commiter_timestamp --utc +%y.%m)-$abbrev_hash > version_static.txt

  echo -n "Generated version: "
  cat version_static.txt
}

package() {
  cd tt-rss
  _instdir="$pkgdir"/usr/share/webapps/$pkgname

  install -d "$_instdir"
  cp -ra * "$_instdir/"

  install -Dm640 -g 33 config.php-dist "$pkgdir"/etc/webapps/tt-rss/config.php
  install -Dm644 "$srcdir"/config.php "$_instdir"/config.php

  install -d "$pkgdir"/var/lib/tt-rss
  mv "$_instdir"/{lock,cache} "$pkgdir"/var/lib/tt-rss
  chown -R 33:33 "$pkgdir"/var/lib/tt-rss
  chmod -R 755 "$pkgdir"/var/lib/tt-rss/*

  install -Dm644 "$srcdir"/tt-rss.service "$pkgdir"/usr/lib/systemd/system/tt-rss.service
}
