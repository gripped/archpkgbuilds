# Maintainer: Leonidas Spyropoulos <artafinde@archlinux.org>

pkgname=gitlab-exporter
pkgver=0.5.3
pkgrel=1
pkgdesc='A Gitlab prometheus metric exporter'
arch=('x86_64')
url='https://gitlab.archlinux.org/archlinux/gitlab-exporter'
license=('MIT')
depends=('libgcc' 'libstdc++' 'openssl')
makedepends=('cargo')
source=("https://gitlab.archlinux.org/archlinux/${pkgname}/-/releases/v${pkgver}/downloads/${pkgname}-${pkgver}.tar".gz{,.sig})
sha256sums=('b0faf6598d328d774a49353674b5e586bf3e06757c1d990c3bf0b01abf41a065'
            'SKIP')
b2sums=('05ed4caab9f9a3fbb2d37baa834b3f6659d180f466e76457af41c112b1062c77abdb3d5a366847736240b89802acf62abbc0fb14a67073b9c095ae6bab18f243'
        'SKIP')
validpgpkeys=(
  '2191B89431BAC0A8B96DE93D244740D17C7FD0EC' # Leonidas Spyropoulos <artafinde@archlinux.org>
)

prepare() {
  cd "${pkgname}-${pkgver}"
  # Update the locked OpenSSL bindings for compatibility with system OpenSSL 4.
  # https://github.com/rust-openssl/rust-openssl/pull/2591
#  cargo update -p openssl --precise 0.10.81
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "${pkgname}-${pkgver}"
  CFLAGS+=' -ffat-lto-objects'
  cargo build --release --frozen
}

check() {
  cd "${pkgname}-${pkgver}"
  CFLAGS+=' -ffat-lto-objects'
  cargo test --frozen -- --test-threads 1
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 target/release/${pkgname} -t "${pkgdir}"/usr/bin
  install -Dm644 README.md -t "${pkgdir}"/usr/share/doc/${pkgname}
  install -Dm644 LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}
}

