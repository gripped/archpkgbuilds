From a7d429b9467aabdd14b781479a97d3e5871bd98e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ball=C3=B3=20Gy=C3=B6rgy?= <ballogyor@gmail.com>
Date: Fri, 27 Nov 2026 01:32:47 +0100
Subject: [PATCH] Add D-Bus service file

And mark the application as D-Bus activatable. This allows application
launchers to activate it via D-Bus.
---
 Makefile                             | 44 ++++++++++++++++------------
 data/dev.geopjr.Collision.desktop.in |  1 +
 data/dev.geopjr.Collision.service.in |  3 ++
 3 files changed, 30 insertions(+), 18 deletions(-)
 create mode 100644 data/dev.geopjr.Collision.service.in

diff --git a/Makefile b/Makefile
index 2fd0657..60ab5aa 100644
--- a/Makefile
+++ b/Makefile
@@ -1,4 +1,5 @@
-.PHONY: all install uninstall test check build mo desktop gresource bindings install_nautilus_extension
+.PHONY: all install uninstall test check build mo desktop dbus-service gresource bindings install_nautilus_extension
+DESTDIR ?=
 PREFIX ?= /usr
 PO_LOCATION ?= po
 LOCALE_LOCATION ?= /share/locale
@@ -25,9 +26,9 @@ mo:
 	mkdir -p $(PO_LOCATION)/mo
 	for lang in `cat "$(PO_LOCATION)/LINGUAS"`; do \
 	    if [ "$$lang" = "en" ] || [ -z "$$lang" ]; then continue; fi; \
-	    mkdir -p "$(PREFIX)$(LOCALE_LOCATION)/$$lang/LC_MESSAGES"; \
+	    mkdir -p "$(DESTDIR)$(PREFIX)$(LOCALE_LOCATION)/$$lang/LC_MESSAGES"; \
 	    msgfmt "$(PO_LOCATION)/$$lang.po" -o "$(PO_LOCATION)/mo/$$lang.mo"; \
-		install -D -m 0644 "$(PO_LOCATION)/mo/$$lang.mo" "$(PREFIX)$(LOCALE_LOCATION)/$$lang/LC_MESSAGES/dev.geopjr.Collision.mo"; \
+		install -D -m 0644 "$(PO_LOCATION)/mo/$$lang.mo" "$(DESTDIR)$(PREFIX)$(LOCALE_LOCATION)/$$lang/LC_MESSAGES/dev.geopjr.Collision.mo"; \
 	done
 
 metainfo:
@@ -36,28 +37,35 @@ metainfo:
 desktop:
 	msgfmt --desktop --template data/dev.geopjr.Collision.desktop.in -d "$(PO_LOCATION)" -o data/dev.geopjr.Collision.desktop
 
+dbus-service:
+	sed 's|@bindir@|$(PREFIX)/bin|g' data/dev.geopjr.Collision.service.in > data/dev.geopjr.Collision.service
+
 install_nautilus_extension:
 	mkdir -p  ~/.local/share/nautilus-python/extensions/
 	cp nautilus-extension/collision-extension.py ~/.local/share/nautilus-python/extensions/
 	nautilus -q || true
 
-install: mo metainfo desktop
-	install -D -m 0755 bin/collision $(PREFIX)/bin/collision
-	install -D -m 0644 data/dev.geopjr.Collision.gschema.xml $(PREFIX)/share/glib-2.0/schemas/dev.geopjr.Collision.gschema.xml
-	install -D -m 0644 data/dev.geopjr.Collision.desktop $(PREFIX)/share/applications/dev.geopjr.Collision.desktop
-	install -D -m 0644 data/icons/dev.geopjr.Collision.svg $(PREFIX)/share/icons/hicolor/scalable/apps/dev.geopjr.Collision.svg
-	install -D -m 0644 data/icons/dev.geopjr.Collision-symbolic.svg $(PREFIX)/share/icons/hicolor/symbolic/apps/dev.geopjr.Collision-symbolic.svg
-	gtk-update-icon-cache $(PREFIX)/share/icons/hicolor
-	glib-compile-schemas $(PREFIX)/share/glib-2.0/schemas/
+install: mo metainfo desktop dbus-service
+	install -D -m 0755 bin/collision $(DESTDIR)$(PREFIX)/bin/collision
+	install -D -m 0644 data/dev.geopjr.Collision.gschema.xml $(DESTDIR)$(PREFIX)/share/glib-2.0/schemas/dev.geopjr.Collision.gschema.xml
+	install -D -m 0644 data/dev.geopjr.Collision.service $(DESTDIR)$(PREFIX)/share/dbus-1/services/dev.geopjr.Collision.service
+	install -D -m 0644 data/dev.geopjr.Collision.desktop $(DESTDIR)$(PREFIX)/share/applications/dev.geopjr.Collision.desktop
+	install -D -m 0644 data/dev.geopjr.Collision.metainfo.xml $(DESTDIR)$(PREFIX)/share/metainfo/dev.geopjr.Collision.metainfo.xml
+	install -D -m 0644 data/icons/dev.geopjr.Collision.svg $(DESTDIR)$(PREFIX)/share/icons/hicolor/scalable/apps/dev.geopjr.Collision.svg
+	install -D -m 0644 data/icons/dev.geopjr.Collision-symbolic.svg $(DESTDIR)$(PREFIX)/share/icons/hicolor/symbolic/apps/dev.geopjr.Collision-symbolic.svg
+	gtk-update-icon-cache $(DESTDIR)$(PREFIX)/share/icons/hicolor
+	glib-compile-schemas $(DESTDIR)$(PREFIX)/share/glib-2.0/schemas/
 
 uninstall:
-	rm -f $(PREFIX)/bin/collision
-	rm -f $(PREFIX)/share/glib-2.0/schemas/dev.geopjr.Collision.gschema.xml
-	rm -f $(PREFIX)/share/applications/dev.geopjr.Collision.desktop
-	rm -f $(PREFIX)/share/icons/hicolor/scalable/apps/dev.geopjr.Collision.svg
-	rm -f $(PREFIX)/share/icons/hicolor/symbolic/apps/dev.geopjr.Collision-symbolic.svg
-	rm -rf $(PREFIX)$(LOCALE_LOCATION)/*/*/dev.geopjr.Collision.mo
-	gtk-update-icon-cache $(PREFIX)/share/icons/hicolor
+	rm -f $(DESTDIR)$(PREFIX)/bin/collision
+	rm -f $(DESTDIR)$(PREFIX)/share/glib-2.0/schemas/dev.geopjr.Collision.gschema.xml
+	rm -f $(DESTDIR)$(PREFIX)/share/dbus-1/services/dev.geopjr.Collision.service
+	rm -f $(DESTDIR)$(PREFIX)/share/applications/dev.geopjr.Collision.desktop
+	rm -f $(DESTDIR)$(PREFIX)/share/applications/dev.geopjr.Collision.metainfo.xml
+	rm -f $(DESTDIR)$(PREFIX)/share/icons/hicolor/scalable/apps/dev.geopjr.Collision.svg
+	rm -f $(DESTDIR)$(PREFIX)/share/icons/hicolor/symbolic/apps/dev.geopjr.Collision-symbolic.svg
+	rm -rf $(DESTDIR)$(PREFIX)$(LOCALE_LOCATION)/*/*/dev.geopjr.Collision.mo
+	gtk-update-icon-cache $(DESTDIR)$(PREFIX)/share/icons/hicolor
 
 validate-appstream:
 	appstreamcli validate ./data/dev.geopjr.Collision.metainfo.xml.in
diff --git a/data/dev.geopjr.Collision.desktop.in b/data/dev.geopjr.Collision.desktop.in
index 307941e..0e484e5 100644
--- a/data/dev.geopjr.Collision.desktop.in
+++ b/data/dev.geopjr.Collision.desktop.in
@@ -1,5 +1,6 @@
 [Desktop Entry]
 Type=Application
+DBusActivatable=true
 StartupNotify=true
 StartupWMClass=collision
 Exec=collision %F
diff --git a/data/dev.geopjr.Collision.service.in b/data/dev.geopjr.Collision.service.in
new file mode 100644
index 0000000..c25b915
--- /dev/null
+++ b/data/dev.geopjr.Collision.service.in
@@ -0,0 +1,3 @@
+[D-BUS Service]
+Name=dev.geopjr.Collision
+Exec=@bindir@/collision --gapplication-service
-- 
2.56.1

