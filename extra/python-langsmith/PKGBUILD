pkgname=python-langsmith
pkgver=0.10.1
pkgrel=1
pkgdesc="Client library to connect to the LangSmith Observability and Evaluation Platform"
arch=('any')
url="https://github.com/langchain-ai/langsmith-sdk"
license=('MIT')
depends=(
  'python'
  'python-anyio'
  'python-distro'
  'python-httpx'
  'python-orjson'
  'python-packaging'
  'python-pydantic'
  'python-requests'
  'python-requests-toolbelt'
  'python-sniffio'
  'python-typing_extensions'
  'python-uuid-utils'
  'python-websockets'
  'python-xxhash'
  'python-zstandard'
)
makedepends=(
  'git'
  'python-build'
  'python-hatchling'
  'python-installer'
  'python-wheel'
)
checkdepends=(
  'python-attrs'
  'python-cachetools'
  'python-dataclasses-json'
  'python-langchain-core'
  'python-multipart'
  'python-opentelemetry-api'
  'python-opentelemetry-exporter-otlp-proto-http'
  'python-opentelemetry-sdk'
  'python-pytest'
  'python-pytest-asyncio'
  'python-pytest-httpx'
  'python-pytest-rerunfailures'
  'python-pytest-retry'
  'python-pytest-timeout'
  'python-vcrpy'
)
optdepends=(
  'python-langchain-core: LangChain runnable integration support'
  'python-cachetools: LiveKit and Pipecat tracing support'
  'python-pytest: LangSmith pytest plugin support'
  'python-rich: enhanced pytest output support'
  'python-vcrpy: VCR support'
  'python-opentelemetry-api: OpenTelemetry tracing support'
  'python-opentelemetry-sdk: OpenTelemetry tracing support'
  'python-opentelemetry-exporter-otlp-proto-http: OpenTelemetry export support'
)
source=("git+https://github.com/langchain-ai/langsmith-sdk.git#tag=v$pkgver")
sha512sums=('2db52abed04af588451ce0da3d37989dc6e2ce43764ff16cb291e023704403497b9a37448d74bcc2b1dc9ebaeaa8eec061dcaf0c421f81a70d3a6c86fab90e5d')

build() {
  cd langsmith-sdk/python
  python -m build --wheel --no-isolation
}

check() {
  cd langsmith-sdk/python

  # Evaluation/integration tests use live services; external/wrapper tests need unpackaged optional stacks.
  # Prompt model round-trip cases need unpackaged langchain-anthropic/langchain-openai.
  PYTHONPATH="$PWD" pytest \
    --ignore=tests/evaluation \
    --ignore=tests/external \
    --ignore=tests/integration_tests \
    --ignore=tests/unit_tests/wrappers/test_google_adk.py \
    --ignore=tests/unit_tests/wrappers/test_strands_agents.py \
    --deselect='tests/unit_tests/test_client.py::test_client_gc_after_autoscale' \
    --deselect='tests/unit_tests/test_client.py::test_pull_prompt[True-tools-manifest_data0]' \
    --deselect='tests/unit_tests/test_client.py::test_pull_prompt[True-structured-manifest_data1]' \
    --deselect='tests/unit_tests/test_client.py::test_pull_prompt[True-none-manifest_data2]' \
    --deselect='tests/unit_tests/test_client.py::test_pull_prompt[True-none-manifest_data3]' \
    --deselect='tests/unit_tests/test_client.py::test_pull_and_push_prompt[True-tools-manifest_data0]' \
    --deselect='tests/unit_tests/test_client.py::test_pull_and_push_prompt[True-structured-manifest_data1]' \
    --deselect='tests/unit_tests/test_client.py::test_pull_and_push_prompt[True-none-manifest_data2]' \
    --deselect='tests/unit_tests/test_client.py::test_pull_and_push_prompt[True-none-manifest_data3]'

  # This stress test creates 50k runs; give it enough queue capacity without changing default-queue tests.
  LANGSMITH_TRACING_QUEUE_MAX_SIZE=60000 PYTHONPATH="$PWD" pytest \
    tests/unit_tests/test_client.py::test_client_gc_after_autoscale
}

package() {
  cd langsmith-sdk/python
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 ../LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
