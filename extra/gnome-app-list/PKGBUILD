# Maintainer: Fabian Bornschein <fabiscafe@archlinux.org>

pkgname=gnome-app-list
pkgver=2026.08
pkgrel=1
pkgdesc="Provides app recommendation data for the GNOME project"
arch=(any)
url="https://gitlab.gnome.org/GNOME/gnome-app-list"
license=(LGPL-2.1-or-later)
makedepends=(
  git
  libxml2
  meson
)
checkdepends=(
  flake8
  python-black
)
source=("git+$url.git#tag=${pkgver/[a-z]/.&}")
b2sums=('f88c0c7cb003348a64418619440c30962ea447c523cc5e4af650d37e71a7a7db425af9a917385ceb5b0a9e7e93805e065446cb23799d5f0405e7d66f5be810c8')

prepare() {
  cd $pkgname
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
