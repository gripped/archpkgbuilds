# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=python-mfusepy
pkgver=3.2.0
pkgrel=1
pkgdesc='Ctypes bindings for the high-level API in libfuse 2 & 3'
arch=(any)
url='https://github.com/mxmlnkn/mfusepy'
license=(ISC)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-pytest
  python-pytest-order
  python-pytest-xdist
  fuse2
  fuse3
  python-ioctl-opt
)
optdepends=(fuse2 fuse3)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('2a54de67afe4975c74a3477d9f70487429b31bc228f839506b24f0a416bba2140f61296681f0521ff832031f21190ba21f5db4d3eeacfe78904add9b6c9d51d6')
b2sums=('18af0dba6815a66e976e87c584fd554b6b15e457835f4e8b61f97597bbbb83816e10127100c4eda76a60c2efd73ec511b7fa32d3b33abc5761370429c56083da')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
