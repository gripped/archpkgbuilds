# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=sh4lt
pkgver=0.3.2
pkgrel=1
pkgdesc="Library to share streams of framed data between applications"
arch=(x86_64)
url="https://gitlab.com/sh4lt/sh4lt/"
license=(
  LGPL-2.0-or-later
  LGPL-2.1-or-later
)
depends=(
  glibc
  libgcc
  libstdc++
)
makedepends=(
  cmake
  doxygen
  git
  graphviz
)
source=(
  git+${url}#tag=$pkgver
  "${pkgname}-pybind11::git+https://github.com/pybind/pybind11"  # NOTE: currently still requires vendored pybind11: https://gitlab.com/sh4lt/sh4lt/-/work_items/10
)
sha512sums=('09bc6d743f0817e36096f17b727efeaa1cad5bcc07a3c097b4742acd7620362a00d4eaf41d5d878ed5b0cb8082b8a9d17e2765578d38215c1352c7735d1944dd'
            'SKIP')
b2sums=('79eabac28484f9e95f50f6dd50b1db4cf1b825edde0e792ba016eced1c3ee084bcc9e0ab710959c77e3a8461e4c6d32bb555a03ffb147d5dcc805a4740cebecb'
        'SKIP')

prepare() {
  cd "$pkgname"
  git submodule init

  git config submodule."wrappers/python/pybind11".url "${srcdir}/${pkgname}"-pybind11

  git -c protocol.file.allow=always submodule update
}

build() {
  local cmake_options=(
    -B build
    -S "$pkgname"
    -W no-dev
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

check() {
  local excluded_tests="check-sh4lt-flow|pysh4lt_writer_follower"
  local ctest_flags=(
    --test-dir build
    # show the stdout and stderr when the test fails
    --output-on-failure
    # execute tests in parallel
    --parallel "$(nproc)"
    # exclude problematic tests
    --exclude-regex "$excluded_tests"
  )
  ctest "${ctest_flags[@]}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
