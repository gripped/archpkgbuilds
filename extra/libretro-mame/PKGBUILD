pkgname=libretro-mame
pkgver=20260904.104350.g4fc9a9312baa
pkgrel=1
arch=(x86_64)
pkgdesc='MAME Arcade core'
url=https://github.com/libretro/mame
license=(custom)
groups=(libretro)
depends=(
  alsa-lib
  glibc
  libretro-core-info
  libgl
  zlib
)
makedepends=(
  git
  libglvnd
  python
)
source=(libretro-mame::git+https://github.com/libretro/mame.git#commit=${pkgver##*.g})
b2sums=('ec50ef63e41c2dd0423d488bda233fc01f20feb48fa4830dea2ade748bd617d36439249842eeb964be71859e93ae61a1030bdde48a529c865715d5bfd04f9ee1')

build() {
  cd libretro-mame
  make PTR64=1 -f Makefile.libretro
}

package() {
  install -Dm 644 libretro-mame/mame_libretro.so -t "${pkgdir}"/usr/lib/libretro/
  install -Dm 644 libretro-mame/docs/LICENSE -t "${pkgdir}"/usr/share/licenses/libretro-mame/
}

