# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=janet
pkgver=1.43.0
pkgrel=1
pkgdesc='A dynamic language and bytecode vm'
arch=(x86_64)
url='https://janet-lang.org'
license=(MIT)
makedepends=(
  git
  meson
)
optdepends=(
  'jpm: janet project manager'
  'janet-spork: various Janet utility modules'
)
options=(staticlibs)
source=(
  "$pkgname::git+https://github.com/janet-lang/janet#tag=v$pkgver"
  tmpfiles.conf
)
sha512sums=('499bf2622c61c11cc8e3cc79e32b7fbe82be748a633ba7226ccb1adb5d0b78c6e26a1dc67a2ea830288984018667e456e677eed9ff9e98e8145de1554bd79da3'
            'ea9a756509f989dc3a8250040027a9460be2569a6d7a1bd49c2d94db939605a1976815b4856cb1d5bed0c707216bdeb257e16294c09bb63d8e9ca9272f834e5b')
b2sums=('1291bcc9ebe5030c91509f86e6ead001f9d06293db62ebba954f7e9e67576fd76e7f1f0d936312d7b0d7f6cbfc041a99a098c418a3b7b11590789eda0e2649a4'
        'c375e10b953377cb61d67aba571ac8b5959ea6cccbb7b5cdf9c800befc260e39d8d43615f487b64c729ad0bc0c0757f8c212a38276eab03d4f38bce48e09fa2e')

build() {
  export CFLAGS+=" -fPIC -ffat-lto-objects"
  export LDFLAGS+=" -rdynamic"

  arch-meson "$pkgname" build -Dgit_hash="$(git -C "$pkgname" rev-parse --short HEAD)"

  meson compile -C build

  # generate documentation
  ./build/janet janet/tools/gendoc.janet > doc.html
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  depends+=(glibc)

  meson install -C build --destdir "$pkgdir"

  # systemd integration
  install -vDm644 tmpfiles.conf "$pkgdir/usr/lib/tmpfiles.d/janet.conf"

  # documentation
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" doc.html
  cp -vr "$pkgname/examples" "$pkgdir/usr/share/doc/$pkgname"

  # remove hidden files
  rm -rf \
    "$pkgdir/usr/lib/janet" \
    "$pkgdir/usr/share/doc/janet/examples/numarray/.gitignore"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$pkgname/LICENSE"
}
