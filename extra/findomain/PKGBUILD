# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>
# Contributor: Eduard Tolosa <edu4rdshl@protonmail.com>

pkgname=findomain
_pkgname=Findomain
pkgver=11.0.0
pkgrel=1
pkgdesc='The fastest and cross-platform subdomain enumerator, do not waste your time'
url='https://github.com/Findomain/Findomain'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=(
  'glibc'
  'libgcc' 'libgcc_s.so'
  'openssl' 'libssl.so'
)
makedepends=('cargo')
optdepends=('postgresql: for subdomain monitoring')
source=(
  "https://github.com/${_pkgname}/${_pkgname}/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz"
)
b2sums=('b4437873cb22076a02df5e12786a63815f261784e996570701a65c76d946e2ae7a13aa1de783c8b2e01d0384152c0dfe51a8fa1d1cf2087b30d9280dbbdceeb8')
options=(!lto)

prepare() {
  cd $_pkgname-$pkgver
  cargo fetch --locked --target host-tuple
}

build() {
  cd ${_pkgname}-${pkgver}
  OPENSSL_NO_VENDOR=1 cargo build --release --frozen
}

check() {
  cd ${_pkgname}-${pkgver}
  OPENSSL_NO_VENDOR=1 cargo test --release --frozen
}

package() {
  cd ${_pkgname}-${pkgver}

  install -Dm 755 "target/release/${pkgname}" -t "${pkgdir}/usr/bin"
  install -Dm 644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
  install -Dm 644 "${pkgname}.1" -t "${pkgdir}/usr/share/man/man1"
}

# vim: ts=2 sw=2 et:
