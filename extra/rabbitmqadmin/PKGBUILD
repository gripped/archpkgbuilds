# Maintainer: Carl Smedstad <carsme@archlinux.org>

pkgname=rabbitmqadmin
pkgver=2.31.0
pkgrel=1
epoch=1
pkgdesc="A command line tool for RabbitMQ that uses the HTTP API"
arch=(x86_64)
url="https://github.com/rabbitmq/rabbitmqadmin-ng"
license=("Apache-2.0 OR MIT")
depends=(
  glibc
  libgcc
)
makedepends=(
  cargo
  git
)
options=(!lto)
source=("$pkgname::git+$url.git#tag=v$pkgver")
b2sums=('64cdeb295d6c57186cd7191e1ae53a3801c1306e6800225f35e302e2ddd5853238fe55180e9f7bce477a26a4af5732a52b79da260b03dc7499fc52f428a43866')

prepare() {
  cd $pkgname
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $pkgname
  cargo build --frozen --release --all-features

  target/release/rabbitmqadmin shell completions --shell bash > completion.bash
  target/release/rabbitmqadmin shell completions --shell fish > completion.fish
  target/release/rabbitmqadmin shell completions --shell zsh > completion.zsh
}

check() {
  cd $pkgname
  # Skip integration tests, requires a running RabbitMQ broker.
  cargo test --frozen --all-features --test unit --test proptests
}

package() {
  cd $pkgname
  install -vDm755 -t "$pkgdir/usr/bin" target/release/rabbitmqadmin

  install -vDm644 completion.bash "$pkgdir/usr/share/bash-completion/completions/rabbitmqadmin"
  install -vDm644 completion.fish "$pkgdir/usr/share/fish/vendor_completions.d/rabbitmqadmin.fish"
  install -vDm644 completion.zsh "$pkgdir/usr/share/zsh/site-functions/_rabbitmqadmin"

  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" ./*.md
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE-MIT
}
