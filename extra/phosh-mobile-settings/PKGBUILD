pkgname=phosh-mobile-settings
pkgver=0.59.0
pkgrel=1
pkgdesc='A settings app for mobile specific things'
arch=(x86_64)
url='https://gitlab.gnome.org/World/Phosh/phosh-mobile-settings'
license=(GPL-3.0-or-later)
depends=(
  accountsservice
  cellbroadcastd
  dconf
  feedbackd
  fontconfig
  glib2
  glibc
  gnome-desktop-4
  gsound
  gtk4
  hicolor-icon-theme
  json-glib
  libadwaita
  libgcc
  libgmobile
  libportal
  libportal-gtk4
  libpulse
  libyaml
  lm_sensors
  pango
  phoc
  phosh
  polkit
  wayland
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  meson
  wayland-protocols
)
source=(
  "git+https://gitlab.gnome.org/World/Phosh/phosh-mobile-settings.git?signed#tag=v$pkgver"
  guidog-gvc::git+https://gitlab.gnome.org/guidog/libgnome-volume-control.git
)
b2sums=(
  eb1dec82a372a0209280ed8a5bd19f312f6701baba02773e03dca4a2b19ee352466a75f3982f909fb1f8261f0f46c56f1016d59a06d9cf83f1b7240c223d06e6
  SKIP
)
validpgpkeys=(0DB3932762F78E592F6522AFBB5A2C77584122D3) # Guido Günther <guido@xcpu.ch>

prepare() {
  ln -s "$srcdir/guidog-gvc" "$pkgname/subprojects/gvc"
  meson subprojects checkout --sourcedir $pkgname
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
