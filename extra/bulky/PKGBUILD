# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=bulky
pkgver=4.5
pkgrel=1
pkgdesc='Utility to rename files and directories'
arch=(any)
url='https://github.com/linuxmint/bulky'
license=(GPL-3.0-or-later)
groups=(x-apps)
depends=(
  bash
  dconf
  gdk-pixbuf2
  glib2
  gtk3
  hicolor-icon-theme
  python
  python-gobject
  python-setproctitle
  python-unidecode
  python-xapp
)
makedepends=(git)
source=("git+https://github.com/linuxmint/bulky.git#tag=$pkgver")
b2sums=(fd1f41708348b4f23f5a864a98b24d988482c2a1ac1cdb1af16a3f3c68f0a69d1d7c41346fde0528b66c3b5c3ea16f29af2d11de001fb5fdcacc06a2bb1419e1)

prepare() {
  cd $pkgname

  # Set version number
  sed -i "s/__DEB_VERSION__/$pkgver/" usr/lib/bulky/bulky.py
}

build() {
  cd $pkgname
  make
}

package() {
  cd $pkgname
  cp -r usr "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
