# Maintainer: Orhun Parmaksız <orhun@archlinux.org>

pkgname=intelli-shell
pkgver=3.4.1
pkgrel=1
pkgdesc="Like IntelliSense, but for shells"
arch=('x86_64')
url="https://github.com/lasantosr/intelli-shell"
license=('Apache-2.0')
depends=('libgcc' 'libgit2' 'openssl' 'sqlite' 'zlib')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha512sums=('fe9fd00da79a033b771e5b238b49237d9ac49ff168935d11faae5e0b93677688fa400acf3acbd609b4fba11eb1934a92d1dd12c99598d8a963d818698c6ebe67')
options=('!lto')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  export LIBGIT2_NO_VENDOR=1
  export OPENSSL_NO_VENDOR=true
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
  cargo build --release --frozen
}

check() {
  cd "$pkgname-$pkgver"
  export LIBGIT2_NO_VENDOR=1
  export OPENSSL_NO_VENDOR=true
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm 755 "target/release/$pkgname" -t "$pkgdir/usr/bin"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
}

# vim: ts=2 sw=2 et:
