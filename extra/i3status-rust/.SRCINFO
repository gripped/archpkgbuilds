pkgbase = i3status-rust
	pkgdesc = Resourcefriendly and feature-rich replacement for i3status, written in pure Rust
	pkgver = 0.40.0
	pkgrel = 1
	url = https://github.com/greshake/i3status-rust
	arch = x86_64
	license = GPL-3.0-only
	makedepends = clang
	makedepends = cmake
	makedepends = git
	makedepends = rust
	makedepends = pandoc
	depends = libpipewire
	depends = libpulse
	depends = lm_sensors
	optdepends = alsa-utils: for the volume block
	optdepends = bluez: for the bluetooth block
	optdepends = fakeroot: for the pacman block to show pending updates
	optdepends = kdeconnect: for the kdeconnect block
	optdepends = powerline-fonts: for all themes using the Powerline arrow char
	optdepends = pulseaudio: for the volume block
	optdepends = speedtest-cli: for the speedtest block
	optdepends = otf-font-awesome: for the awesome icons
	optdepends = upower: for the battery block
	options = !lto
	source = i3status-rust-0.40.0.tar.gz::https://github.com/greshake/i3status-rust/archive/refs/tags/v0.40.0.tar.gz
	b2sums = a28ce43a4bed2ae43ee93bde40d8a20b550ea13753f21f2ce2d3d44054bd326bf9111651e5b8134c0569fd291f255818ce2362b07449bb03979149055ab49cc8

