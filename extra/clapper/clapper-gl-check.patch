From 699013e902cabf524d30cb33061bde8fa36898f7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ball=C3=B3=20Gy=C3=B6rgy?= <ballogyor@gmail.com>
Date: Fri, 13 Nov 2026 14:14:48 +0100
Subject: [PATCH] clapper-gtk: Check GL availability before using glsinkbin

Only use glsinkbin when OpenGL is available through GDK.

This prevents GStreamer GL initialization failures on systems where
OpenGL is unavailable or disabled through GDK_DISABLE, while
preserving the GStreamer 1.24+ workaround on systems with GL support.

Closes: https://github.com/Rafostar/clapper/issues/497
---
 src/lib/clapper-gtk/clapper-gtk-video.c | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/src/lib/clapper-gtk/clapper-gtk-video.c b/src/lib/clapper-gtk/clapper-gtk-video.c
index 7b1b666c5..b5a816998 100644
--- a/src/lib/clapper-gtk/clapper-gtk-video.c
+++ b/src/lib/clapper-gtk/clapper-gtk-video.c
@@ -1190,6 +1190,26 @@ clapper_gtk_video_init (ClapperGtkVideo *self)
   gtk_gesture_group (self->touch_gesture, self->click_gesture);
 }
 
+static gboolean
+_is_gl_available (void)
+{
+  GdkDisplay *display = gdk_display_get_default ();
+  GError *error = NULL;
+  gboolean available;
+
+  if (display == NULL)
+    return FALSE;
+
+  available = gdk_display_prepare_gl (display, &error);
+
+  if (error) {
+    GST_DEBUG ("Could not prepare GL: %s", error->message);
+    g_error_free (error);
+  }
+
+  return available;
+}
+
 static void
 clapper_gtk_video_constructed (GObject *object)
 {
@@ -1216,7 +1236,7 @@ clapper_gtk_video_constructed (GObject *object)
     guint major = 0, minor = 0, micro = 0, nano = 0;
 
     gst_version (&major, &minor, &micro, &nano);
-    if (major == 1 && minor >= 24) {
+    if (major == 1 && minor >= 24 && _is_gl_available ()) {
       GstElement *bin;
 
       if ((bin = gst_element_factory_make ("glsinkbin", NULL))) {
