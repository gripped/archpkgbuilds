# Contributor: Bruce Zhang

pkgname=sonic
pkgver=1.7.4
pkgrel=1
pkgdesc='Fast, lightweight & schema-less search backend'
arch=(x86_64)
url='https://github.com/valeriansaliou/sonic'
license=(MPL-2.0)
depends=(
  rocksdb
  zstd
)
makedepends=(
  git
  rust
  clang
  llvm
)
backup=(etc/sonic.cfg)
conflicts=(libsonic)
options=(!lto)
source=(
  "$pkgname::git+$url.git#tag=v$pkgver"
  systemd.service
  sysusers.conf
  tmpfiles.conf
)
