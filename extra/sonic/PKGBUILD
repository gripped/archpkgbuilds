# Contributor: Bruce Zhang

pkgname=sonic
pkgver=1.4.9
pkgrel=2
pkgdesc='Fast, lightweight & schema-less search backend'
arch=(x86_64)
url='https://github.com/valeriansaliou/sonic'
license=(MPL-2.0)
depends=(
  glibc
  libgcc
  libstdc++
)
makedepends=(
  git
  rust
  clang
  llvm
)
backup=(etc/sonic.cfg)
options=(!lto)
source=(
  "$pkgname::git+$url.git#tag=v$pkgver"
  systemd.service
  sysusers.conf
  tmpfiles.conf
)
