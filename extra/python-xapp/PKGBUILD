pkgname=python-xapp
_pkgname=python3-xapp
pkgver=3.0.6
pkgrel=1
pkgdesc='Python Xapp Library'
arch=(any)
url='https://github.com/linuxmint/python3-xapp'
license=(LGPL-2.0-or-later)
depends=(
  glib2
  gtk3
  pango
  python
  python-gobject
  python-psutil
  xapp
)
makedepends=(
  git
  meson
)
source=("git+https://github.com/linuxmint/python3-xapp.git#tag=$pkgver")
b2sums=('d4746cf088bebd2cda6f8a7fcb47c81efa6a945f707fac0b39c3bc808f589d297c1b016074ba14c1664a106911baf256eea8c4ddebd83fd277b5cfafae7d8bf5')

build(){
  arch-meson $_pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
}
