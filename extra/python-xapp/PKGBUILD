pkgname=python-xapp
_pkgname=python3-xapp
pkgver=3.0.5
pkgrel=1
pkgdesc='Python Xapp Library'
arch=(any)
url='https://github.com/linuxmint/python3-xapp'
license=(LGPL-2.0-or-later)
depends=(
  glib2
  gtk3
  pango
  python
  python-gobject
  python-psutil
  xapp
)
makedepends=(
  git
  meson
)
source=("git+https://github.com/linuxmint/python3-xapp.git#tag=$pkgver")
b2sums=(935e7ac1b6aebfef58f1b503cd0257a9e239e1794f5ae8b41b739feacff87992688762c14bae397ee3ff889c02d84772af3a0730fd4660597d552f88ad06cdc9)

build(){
  arch-meson $_pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir="$pkgdir"
}
