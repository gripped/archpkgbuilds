# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=switchboard-plug-parental-controls
pkgver=8.0.1
pkgrel=3
pkgdesc='Switchboard Parental Controls Plug'
arch=(x86_64)
url=https://github.com/elementary/switchboard-plug-parental-controls
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  accountsservice
  flatpak
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  libgee
  libgranite-7.so
  libmalcontent-0.so
  libswitchboard-3.so
  polkit
)
makedepends=(
  git
  meson
  vala
)
source=(git+https://github.com/elementary/switchboard-plug-parental-controls.git#tag=${pkgver})
b2sums=('b45328146463f7f7b21d9a43db3dbd69fbd31ebeb8d45b4766b620ad68eb5c307a044700394cd7ef84302737913926a6fb1de7d706308fbb4676801a23c009d1')

prepare() {
  cd switchboard-plug-parental-controls

  # Fix client quits immediately after launch
  # https://github.com/elementary/settings-screentime-limits/pull/218
  git cherry-pick -n a9cf9faa9ce154755d4c5a6261e4b0dc0e9c66a9

  # Autostart using systemd instead of gnome-session
  # https://github.com/elementary/settings-screentime-limits/pull/217
  git cherry-pick -n 73f0f54fdedd3113cd34414bf893b37315171e19 \
                     120bf5a79c0660ef33e68435cbd4699f907037f8
}

build() {
  arch-meson switchboard-plug-parental-controls build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}

