# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-widgets
pkgver=6.0.21
pkgrel=1
pkgdesc='Desktop widgets service/implementation for DDE'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-widgets"
license=('GPL-3.0-or-later')
# startdde: org.deepin.dde.Display1
depends=('qt5-base' 'dtkcore' 'dtkgui' 'dtkwidget' 'glibc' 'libgcc' 'libstdc++' 'startdde')
makedepends=('git' 'cmake' 'ninja' 'gtest' 'qt5-tools')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/dde-widgets.git#tag=$pkgver")
sha512sums=('d14d1014ca3d0bcd003ca26e88c3ead6b2567600f70ec8c67c135b4aa55839d3d556306c0ed03f1616865c423d32c8e6880977b3276d2783bc87bbf0d1a92804')

prepare() {
  cd dde-widgets
  # Fix link handling for the app and calendar plugin.
  sed -i '/target_link_directories.*interface/d' app/CMakeLists.txt
  sed -i 's|target_link_libraries(${PROJECT_NAME} PRIVATE dde-widgets)|target_link_libraries(${PROJECT_NAME} PRIVATE interface)|' app/CMakeLists.txt
  sed -i '/target_link_libraries(${PROJECT_NAME} PUBLIC ${COMMON_LIBS})/a target_link_directories(${PROJECT_NAME} PUBLIC ${CMAKE_CURRENT_BINARY_DIR}/../interface)\ntarget_link_libraries(${PROJECT_NAME} PRIVATE dde-widgets)' calendar/CMakeLists.txt
}

build() {
  cd dde-widgets
  cmake . -GNinja
  ninja
}

package() {
  cd dde-widgets
  DESTDIR="$pkgdir" ninja install
}
