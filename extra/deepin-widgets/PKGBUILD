# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-widgets
pkgver=6.0.22
pkgrel=1
pkgdesc='Desktop widgets service/implementation for DDE'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-widgets"
license=('GPL-3.0-or-later')
# startdde: org.deepin.dde.Display1
depends=('qt5-base' 'dtkcore' 'dtkgui' 'dtkwidget' 'glibc' 'libgcc' 'libstdc++' 'startdde')
makedepends=('git' 'cmake' 'ninja' 'gtest' 'qt5-tools')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/dde-widgets.git#tag=$pkgver")
sha512sums=('76ba353881c4670dee6942eba08069b7d36bb773b1079ec6f5a50cc86bd5046a481de18819ac5b01e3586b0009376ff40e8e17fa09e75a1a653d551a62d7d04c')

build() {
  cd dde-widgets
  cmake . -GNinja
  ninja
}

package() {
  cd dde-widgets
  DESTDIR="$pkgdir" ninja install
}
