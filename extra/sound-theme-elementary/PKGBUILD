# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=sound-theme-elementary
pkgver=1.1.0
pkgrel=5
pkgdesc='A set of system sounds for elementary OS'
arch=(any)
url=https://github.com/elementary/sound-theme
license=(Unlicense)
groups=(pantheon)
makedepends=(
  git
  meson
)
source=(sound-theme-elementary::git+https://github.com/elementary/sound-theme.git#tag=${pkgver})
b2sums=('fa890c6d87d46ed6f2d8f27088a3b142fa02d2bbf56019c5b18f107d0a3e6f5fecd624c189905d6adba39e52bda4805b4f86437b889df4cc840cfe5938d10638')

build() {
  arch-meson sound-theme-elementary build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}

