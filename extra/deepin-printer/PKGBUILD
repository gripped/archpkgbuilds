# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-printer
pkgver=1.0.7
pkgrel=1
pkgdesc='Printer configuration project for DDE'
arch=('x86_64')
url="https://github.com/linuxdeepin/dde-printer"
license=('GPL-3.0-or-later')
# smbclient: dlopen
depends=('cups' 'deepin-service-manager' 'dtkcore' 'dtkgui' 'dtkwidget' 'glibc' 'libgcc' 'libstdc++' 'libusb' 'qt5-base'
         'hicolor-icon-theme' 'xdg-utils' 'smbclient')
makedepends=('git' 'qt5-tools')
groups=('deepin-extra')
source=("git+https://github.com/linuxdeepin/dde-printer.git#tag=$pkgver")
sha512sums=('1a31096a5eb465a459ed9b4147329c87eae2383e90954defa1ad99168496afc0800ec451295bdc42e649cca9b00e6888c57bad3cd3da17ab5ef5b52b894cff67')

prepare() {
  cd dde-printer
  sed -i '$aOnlyShowIn=Deepin' src/Printer/platform/linux/dde-printer.desktop
}

build() {
  cd dde-printer
  qmake-qt5 PREFIX=/usr
  make
}

package() {
  cd dde-printer
  make INSTALL_ROOT="$pkgdir" install
}
