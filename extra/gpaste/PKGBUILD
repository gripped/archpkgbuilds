# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=gpaste
pkgver=51.2
pkgrel=1
pkgdesc="Clipboard management system"
url="https://www.imagination-land.org/tags/GPaste.html"
license=(BSD-2-Clause)
arch=(x86_64)
depends=(
  dconf
  gcr-4
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  libadwaita
  libgcc
  libpwquality
  libsecret
  libsodium
  libx11
  libxfixes
  mutter
  pango
  sqlite
)
makedepends=(
  dbus
  git
  gjs
  glib2-devel
  gnome-keybindings
  gobject-introspection
  meson
  systemd
  vala
)
checkdepends=(xorg-server-xvfb)
optdepends=("curl: Upload clipboard contents")
source=(
  "git+https://github.com/keruspe/gpaste#tag=v${pkgver/[a-z]/.&}"
  0001-Account-for-window-decorations-in-the-graphical-tool.patch
)
b2sums=('9bc11c32be8f32baa76062846b3e1a24175a28558f157e85ea08c395dd2c1e81e9786ef7a09490543b01090ff39a79edeaf37eecaa53e1f52919e97b37dee057'
        '1f3a3dcb18e84541a3231d6c865bb989470404f7e9c48050a6332b42c3d31c3757cb1d6caf85f825cd0042dd8e9c17369720cfc46eb167c7b62e4ca83c01c447')

prepare() {
  cd gpaste

  # Fix tests
  # https://github.com/Keruspe/GPaste/pull/510
  git apply -3 ../0001-Account-for-window-decorations-in-the-graphical-tool.patch
}

build() {
  arch-meson gpaste build
  meson compile -C build
}

check() {
  GDK_DISABLE=vulkan meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 gpaste/COPYING
}

