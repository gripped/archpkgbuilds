# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=gpaste
pkgver=51.0
pkgrel=1
pkgdesc="Clipboard management system"
url="https://www.imagination-land.org/tags/GPaste.html"
license=(BSD-2-Clause)
arch=(x86_64)
depends=(
  dconf
  gcr-4
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  libadwaita
  libgcc
  libpwquality
  libsecret
  libsodium
  mutter
  pango
  sqlite
)
makedepends=(
  dbus
  git
  gjs
  glib2-devel
  gnome-keybindings
  gobject-introspection
  meson
  systemd
  vala
)
optdepends=("curl: Upload clipboard contents")
source=(
  "git+https://github.com/keruspe/gpaste#tag=v${pkgver/[a-z]/.&}"
)
b2sums=('3f4cbb0b7b9d7ae63a716eaf5f90bc359f1adbe5ba91357ea427119d575b729fd457b788be54cdd88aa5e0128d665b78e66b0ef6590b2cccb205767230387dc9')

prepare() {
  cd gpaste
}

build() {
  arch-meson gpaste build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 gpaste/COPYING
}

