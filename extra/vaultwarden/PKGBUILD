pkgname=vaultwarden
pkgver=1.37.5
pkgrel=2
pkgdesc='Unofficial Bitwarden compatible server written in Rust'
arch=(x86_64 aarch64)
url=https://github.com/dani-garcia/vaultwarden
license=(AGPL-3.0-only)
depends=(
  libgcc
  glibc
  openssl
  sqlite
  zstd
)
depends_aarch64=(postgresql-libs)
depends_x86_64=(postgresql-libs)
makedepends=(
  git
  rust
)
optdepends=('vaultwarden-web: for the web app')
backup=(etc/vaultwarden.env)
options=(!lto)
install=$pkgname.install
source=(
  "git+$url.git#tag=$pkgver"
  systemd.service
  sysusers.conf
  tmpfiles.conf
  env-overrides.patch
)
