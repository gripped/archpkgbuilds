# Maintainer: Levente Polyak <anthraxx[at]archlinux[dot]org>

pkgname=rizin
pkgver=0.9.1
pkgrel=1
pkgdesc='Open-source tools to disasm, debug, analyze and manipulate binary files'
url='https://rizin.re'
arch=(x86_64)
license=(
  Apache-2.0
  BSD-2-Clause
  BSD-3-Clause
  CC-PDDC
  CC0-1.0
  GPL-1.0-or-later
  GPL-2.0-only
  GPL-2.0-or-later
  GPL-3.0-only
  GPL-3.0-or-later
  LGPL-2.0-or-later
  LGPL-2.1-only
  LGPL-2.1-or-later
  LGPL-3.0-only
  MIT
)
depends=(
  glibc
  sh
  openssl
  zlib
  lz4
  xz
)
makedepends=(
  capstone
  file
  libmspack
  libzip
  meson
  ninja
  pcre2
  python
  python-yaml
  tree-sitter
  xxhash
  zstd
)
optdepends=(
  'rz-ghidra: ghidra decompiler plugin'
)
options=(
  '!emptydirs'
)
source=(
  https://github.com/rizinorg/rizin/releases/download/v${pkgver}/rizin-src-v${pkgver}.tar.xz
)
sha512sums=('294825194fc564cf0ab339dd8429be9d169412b20b133203511025b8ce5cb2dde1e06caf2547223cbb95dd5c1f98628b22beccced68913e667c7dba65138aa08')
b2sums=('68e4f2d99ff9286cd13e9357c72b74bd4ae1d4d4dbd998337556a6f7a8fe999b0d7d00ff0970a097d628b46c4a89d656aeba1f3fc714abc418da79c84137c6ae')

build() {
  cd ${pkgname}-v${pkgver}
  arch-meson build \
    -D use_sys_capstone=enabled \
    -D use_capstone_version=v5 \
    -D use_sys_magic=enabled \
    -D use_sys_libzip=enabled \
    -D use_sys_libzstd=enabled \
    -D use_sys_lz4=enabled \
    -D use_sys_lzma=enabled \
    -D use_sys_zlib=enabled \
    -D use_sys_xxhash=enabled \
    -D use_sys_openssl=enabled \
    -D use_sys_pcre2=enabled \
    -D use_sys_tree_sitter=enabled \
    -D use_sys_libmspack=enabled \
    -D use_zlib=true \
    -D use_lzma=true \
    -D local=disabled
  ninja -C build
}

package() {
  depends+=(
    capstone libcapstone.so
    file libmagic.so
    libmspack libmspack.so
    libzip libzip.so
    pcre2 libpcre2-8.so
    tree-sitter libtree-sitter.so
    xxhash libxxhash.so
    zstd libzstd.so
  )

  cd ${pkgname}-v${pkgver}
  DESTDIR="${pkgdir}" ninja -C build install
  install -d "${pkgdir}/usr/share/doc/rizin"
  cp -r doc/* "${pkgdir}/usr/share/doc/rizin"
  install -Dm 644 COPYING* -t "${pkgdir}/usr/share/licenses/rizin"
}

