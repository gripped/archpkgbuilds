# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=ktextaddons
pkgver=2.3.0
pkgrel=1
pkgdesc='Various text handling addons'
arch=(x86_64)
license=(GPL-2.0-or-later)
url='https://invent.kde.org/libraries/ktextaddons'
depends=(
  glibc
  karchive
  kcolorscheme
  kconfig
  kcoreaddons
  ki18n
  kiconthemes
  kio
  kitemviews
  kservice
  ktextwidgets
  kwidgetsaddons
  libstdc++
  qt6-base
  qt6-multimedia
  qt6-speech
  qtkeychain-qt6
  sonnet
  syntax-highlighting
)
makedepends=(
  extra-cmake-modules
  qt6-tools
  vosk-api
)
optdepends=(
  'grammalecte: French grammar checking'
  'languagetool: Grammar checking'
  'libreoffice: Use autocorrection data from LibreOffice'
  'vosk-api: Speech to text plugin'
)
source=(
  https://download.kde.org/stable/$pkgname/$pkgname-$pkgver.tar.xz{,.sig}
  system-vosk.patch
)
sha256sums=('dba60c5872e6b3197b4e3427ca952e9af7d0717ff6503ac52c2a7562ff62bc34'
            'SKIP'
            '5ea5bea4eba5c887cee064fdfb55a8c2df975f353a415e5b22dbe2870a56fa65')
validpgpkeys=(90A774939A973FF1ECC827788FFE4352ED54BB8A) # laurent Montel <montel@kde.org>

prepare() {
# Use system vosk
  patch -d $pkgname-$pkgver -p1 < system-vosk.patch
}

build() {
  cmake -B build -S $pkgname-$pkgver \
    -DBUILD_TESTING=OFF \
    -DBUILD_DESIGNERPLUGIN=ON \
    -DSPEAK_TO_TEXT_VOSK_PLUGIN=ON \
    -DUSE_SYSTEM_VOSK=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
