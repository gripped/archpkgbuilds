pkgname=python-platformdirs
pkgver=4.11.13
pkgrel=1
pkgdesc='A library to determine platform-specific system directories'
arch=(any)
url='https://github.com/tox-dev/platformdirs'
license=(MIT)
depends=(python)
makedepends=(
  git
  python-build
  python-installer
  python-hatchling
  python-hatch-vcs
)
checkdepends=(
  python-pytest
  python-pytest-mock
  python-appdirs
)
source=("$pkgname::git+$url#tag=$pkgver")
sha512sums=('4f81a1eba47236f40cfa961e4343a4fd64a12cc951df056f7ccf81d4d78e3f4de310f6d2998a207f86d9b9af513e724acc3cb10d7843ae57b7c035283b9d5db0')
b2sums=('86d4eb043dbbae781f1f95865b550e7da238252e7beeefc7f9ac241175614bf11c774209aa01505ad757bfc27de4a28b08e18c8f21ca06f5a5fd36d0e1bcdec9')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"

  PYTHONPATH="$(pwd)/src" pytest -v
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
