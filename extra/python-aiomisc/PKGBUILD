# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-aiomisc
pkgver=18.0.40
pkgrel=1
pkgdesc="Miscellaneous utilities for asyncio"
arch=('any')
url="https://github.com/aiokitchen/aiomisc"
license=('MIT')
depends=(
  'python'
  'python-aiothreads'
  'python-colorlog'
  'python-logging-journald'
)
makedepends=(
  'git'
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-setuptools-scm'
  'python-wheel'
)
checkdepends=(
  'python-aiocarbon'
  'python-aiohttp'
  'python-aiohttp-asgi'
  'python-aiomisc-pytest'
  'python-asgiref'
  'python-async-timeout'
  'python-croniter'
  'python-dnslib'
  'python-fastapi'
  'python-grpcio'
  # Pending https://gitlab.archlinux.org/archlinux/packaging/packages/grpc/-/merge_requests/6
  # 'python-grpcio-reflection'
  'python-grpcio-tools'
  'python-pytest'
  'python-rich'
  'python-setproctitle'
  'python-uvloop'
  'uvicorn'
)
optdepends=(
  'python-aiohttp: HTTP services'
  'python-asgiref: ASGI services with uvicorn'
  'python-dnslib: DNS services'
  'python-rich: rich log formatting'
  'python-uvloop: uvloop event loop support'
  'uvicorn: ASGI services'
)
# Upstream uses commit-distance versions; this commit produced PyPI 18.0.40.
source=("git+https://github.com/aiokitchen/aiomisc.git#commit=09203dd2e0910c4a6de091c23d1193796c1a0ecc")
sha512sums=('9512c407e913924a2e494e74d958f1e723f5478ce6ebf10def7ecdac993b2115e6c4486a7384b106390b19a11cceff0c59026aa70d9945e6885722877ab907ae')

prepare() {
  cd aiomisc
  # Defer the optional gRPC import so the other entrypoint tests can collect.
  sed -i \
    -e '/^from aiomisc.service.grpc_server import GRPCService$/d' \
    -e '/^def test_grpc_service(/a\    from aiomisc.service.grpc_server import GRPCService' \
    tests/test_entrypoint.py
}

build() {
  cd aiomisc
  python -m build --wheel --no-isolation
}

check() {
  cd aiomisc
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  # Raven is unmaintained and will not be re-added; grpcio-reflection is pending the MR above.
  test-env/bin/python -m pytest --aiomisc-test-timeout=120 \
    --ignore=tests/test_raven_service.py \
    --deselect=tests/test_entrypoint.py::test_grpc_service
}

package() {
  cd aiomisc
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}
