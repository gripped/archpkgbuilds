# Maintainer: Andreas 'Segaja' Schleifer <segaja at archlinux dot org>
# Maintainer: DeepChirp <deepchirp@archlinux.org>

pkgname='mise'
pkgver=2026.10.5
pkgrel=1
pkgdesc='The front-end to your dev env'
arch=('x86_64')
url='https://github.com/jdx/mise'
license=('MIT')
depends=(
  libgcc
  glibc
  lua51
  openssl
  zstd
)
makedepends=(
  cargo
  clang
  cmake
)
checkdepends=(
  git
)
optdepends=(
  'bash-completion: bash completion support'
  'usage: completion support'
)
conflicts=(
  rtx
)
replaces=(
  rtx
)
options=(
  '!emptydirs'
  '!lto'
)
source=("${url}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz"
        "${pkgname}-${pkgver}.tar.gz.sig::${url}/releases/download/v${pkgver}/v${pkgver}.tar.gz.sig")
validpgpkeys=('24853EC9F655CE80B48E6C3A8B81C9D17413A06D') # mise releases <release@mise.jdx.dev>
sha512sums=('7fe081e49d9f2de7790e37e82f1b966175ce547969f4a219048ec953a701672fda4711062f05748d471605070439c1578a9a8fee5396411994b6f528ee939b03'
            'SKIP')
b2sums=('9a46deb53017c2227f6f1da3073b17bbc1743821a965bfc31c89aa468a0eb3c2e41864cbdb472eb723141498af6f8145c17954f637e7f83ecc436d7338d03dd3'
        'SKIP')

prepare() {
  cd "${pkgname}-${pkgver}"

  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "${pkgname}-${pkgver}"

  export AWS_LC_SYS_NO_JITTER_ENTROPY=1
  export OPENSSL_NO_VENDOR=true
  export ZSTD_SYS_USE_PKG_CONFIG=1

  # use serious profile: https://github.com/jdx/mise/commit/44fc03b2f10d1d9d7e8242c965a957b3b0d42865
  # no need to enable `vendored-lua` and `self_update`
  cargo build --frozen --profile=serious --no-default-features --features native-tls
}

check() {
  cd "${pkgname}-${pkgver}"

  export AWS_LC_SYS_NO_JITTER_ENTROPY=1
  export OPENSSL_NO_VENDOR=true
  export ZSTD_SYS_USE_PKG_CONFIG=1
  export MISE_EXPERIMENTAL=1

  cargo test --frozen --no-default-features --features native-tls

  unset MISE_EXPERIMENTAL
}

package() {
  cd "${pkgname}-${pkgver}"

  # package
  install --verbose -D --mode=0755 "target/serious/${pkgname}" --target-directory "${pkgdir}/usr/bin"

  # license
  install --verbose -D --mode=0644 LICENSE --target-directory "${pkgdir}/usr/share/licenses/${pkgname}"

  # docs
  install --verbose -D --mode=0644 *.md --target-directory "${pkgdir}/usr/share/doc/${pkgname}"
  install --verbose -D --mode=0644 man/man1/mise.1 --target-directory "${pkgdir}/usr/share/man/man1"

  # completion support
  install --verbose -D --mode=0644 completions/mise.bash "${pkgdir}/usr/share/bash-completion/completions/mise"
  install --verbose -D --mode=0644 completions/mise.fish "${pkgdir}/usr/share/fish/vendor_completions.d/mise.fish"
  install --verbose -D --mode=0644 completions/_mise "${pkgdir}/usr/share/zsh/site-functions/_mise"
}

