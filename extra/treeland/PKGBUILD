# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: zccrs <zhangjide@deepin.org>

pkgname=treeland
pkgver=0.8.17
pkgrel=1
pkgdesc='New wayland compositer for DDE'
arch=('x86_64')
url="https://github.com/linuxdeepin/treeland"
license=('Apache-2.0' 'LGPL-3.0-only' 'GPL-2.0-only' 'GPL-3.0-only' 'MIT')
# xwayland is needed for XWayland support (not optional)
depends=('bash' 'ddm' 'dtk6core' 'dtk6declarative' 'dtk6systemsettings' 'glibc' 'libdisplay-info'
         'libdrm' 'libgcc' 'libgl' 'libinput' 'libliftoff' 'libstdc++' 'libxau' 'libxcb' 'libxkbcommon'
         'lcms2' 'mesa' 'mpv' 'pam' 'pixman' 'qt6-base' 'qt6-declarative' 'qt6-remoteobjects' 'seatd'
         'systemd-libs' 'vulkan-icd-loader' 'wayland' 'xcb-util-errors' 'xcb-util-renderutil' 'xcb-util-wm'
         'xorg-xwayland' 'deepin-session')
makedepends=('git' 'cmake' 'ninja' 'glslang' 'hwdata' 'qt6-tools' 'wayland-protocols' 'wlr-protocols'
             'treeland-protocols' 'vulkan-headers')
groups=('deepin')
replaces=('waylib' 'qwlroots')
conflicts=('waylib' 'qwlroots')
source=("git+https://github.com/linuxdeepin/treeland.git#tag=$pkgver")
sha256sums=('cb8a30644ee5dda69e9ee72a69773e7bb1d24ba49d81f963e27f20ac6ea3bf20')

prepare() {
  cd treeland

  # Fix wallpaper paths
  sed -i 's|/usr/share/backgrounds/default_background.jpg|/usr/share/backgrounds/deepin/desktop.jpg|' misc/dconfig/org.deepin.dde.treeland{,.user}.json
  sed -i 's|/usr/share/wallpapers/deepin/deepin-default.jpg|/usr/share/wallpapers/deepin/desktop.jpg|' src/wallpaper/wallpapermanager.cpp
}

build() {
  cd treeland
  # TODO: Fix RUNPATH issue
  cmake . -B build -G Ninja \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DCMAKE_INSTALL_PREFIX=/usr
    # -DCMAKE_SKIP_RPATH=ON
  cmake --build build
}

package() {
  cd treeland
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 3rdparty/wlroots/LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
