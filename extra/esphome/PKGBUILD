# Maintainer: Giovanni Harting <anonfunc@archlinux.org>
# Contributor: sgar < swhaat at github >

pkgname=esphome
pkgver=2026.10.2
pkgrel=1
pkgdesc='Solution for your ESP8266/ESP32 projects with Home Assistant'
url='https://github.com/esphome/ESPHome'
depends=(
  python
  python-voluptuous
  python-yaml
  python-paho-mqtt
  python-tzlocal
  python-tzdata
  python-pyserial
  platformio-core
  esptool
  python-click
  python-aioesphomeapi
  python-zeroconf
  python-ruamel-yaml
  python-pyparsing
  python-argcomplete
  python-pillow
  python-requests
  python-colorama
  python-cryptography
  python-puremagic
  python-freetype-py
  python-esphome-glyphsets
  python-jinja
  python-filelock
  ninja
  python-py7zr
  python-platformdirs
  python-aiohappyeyeballs
)
makedepends=(python-build python-installer python-wheel)
optdepends=(
  'python-bleak: nRF52 BLE logger and OTA'
  'python-resvg_py: SVG images'
  'python-smpclient: nRF52 OTA'
)
license=('MIT AND GPL-3.0-only')
arch=(any)
source=("$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz")
b2sums=('eaeba065545fecd852045083790bd736d56a12c207493a91c7784cdae7adc5e78faf7a3ec4a9054271c3d7a46370c01edcfac69488384683fdd5c82718244164')

prepare() {
  cd $pkgname-$pkgver

  # relax requirements; strip comments first since some contain ';', keep environment markers
  sed -i -e 's/[[:space:]]*#.*//' -e 's/[[:space:]]*==[^;]*//' requirements.txt
  sed -i 's/setuptools==[0-9.]\+/setuptools/' pyproject.toml
  sed -i 's/wheel>=[0-9.]\+,<[0-9.]\+/wheel/' pyproject.toml
}

build() {
  cd $pkgname-$pkgver
  python -m build --wheel --no-isolation
}

package() {
  cd $pkgname-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

