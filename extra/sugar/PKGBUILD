  libwnck3
  libxklavier
  metacity
  mobile-broadband-provider-info
  openssh
  pango
  python
  python-cairo
  python-dbus
  python-gobject
  python-gwebsockets
  python-xapian
  sugar-toolkit-gtk3
  telepathy-gabble
  telepathy-glib
  telepathy-mission-control
  telepathy-salut
  upower
  webkit2gtk-4.1
  xdg-user-dirs
)
makedepends=(
  git
  intltool
  python-empy
)
source=(
  "git+https://github.com/sugarlabs/$pkgname.git#tag=v$pkgver"
  sugar-reset-cursor.patch
  sugar-downloader-libsoup3.patch
)
b2sums=(
  706d2769cf9f946abd68ab3560bbc50dadfa6b11dbe5a6bb40fdffa671a733a97d0deff84cfcd4de5c4d7e8496d3392a052983ba9369d30965576c7b4a561788
  e25f410dcfaeee496db1acd56d32a2430c51343729e3467daa71c081fd51e97a6e2a21dc80949f3496cd29dcaffe6dd21711a27877ea32c550a318ab6aa36688
  2c32ada4faf2de9a7babbcf51911cd593b9b7a043b4ee3670c1711878eadcbe5e3b1c0e085696987fc6b6ef109be220928a7be478d4a91299e589a61ffcff6f3
)

prepare() {
  cd $pkgname

  # Fix build
  git cherry-pick -n 892178ac11fa7d024b6062d956fe76f07499be3e

  # Port to GtkSource 4
  # https://github.com/sugarlabs/sugar/pull/1128
  sed -i "s/'GtkSource', '3.0'/'GtkSource', '4'/" src/jarabe/view/viewsource.py

  # Restore default cursor theme
  # https://github.com/sugarlabs/sugar/pull/1129
  git apply -3 ../sugar-reset-cursor.patch

  # Fix downloader compatibility with libsoup 3
  # https://github.com/sugarlabs/sugar/pull/1130
  git apply -3 ../sugar-downloader-libsoup3.patch

  # DSA keys are no longer supported by OpenSSH
  # https://github.com/sugarlabs/sugar/issues/1004
  sed -i 's/-t dsa/-t rsa/' src/jarabe/intro/window.py

  # Use correct D-Bus config location
  sed -i '/^nmservicedir =/ s/sysconfdir/datadir/' data/Makefile.am

  mkdir m4
  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
