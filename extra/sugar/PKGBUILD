pkgname=sugar
pkgver=0.122
pkgrel=3
pkgdesc='Sugar GTK shell'
arch=(any)
url='https://github.com/sugarlabs/sugar'
license=(GPL-3.0-or-later)
depends=(
  bash
  dconf
  gdk-pixbuf2
  glib2
  gst-python
  gstreamer
  gtk3
  gtksourceview4
  gvfs
  libgudev
  libnm
