pkgname=opendeck
pkgver=2.14.1
pkgrel=1
pkgdesc='A desktop application that provides functionality for stream controller devices'
arch=(x86_64 aarch64)
url='https://github.com/nekename/OpenDeck'
license=(GPL-3.0-or-later)
depends=(
  gtk3
  fontconfig
  libgcc
  openssl
  libxcb
  glib2
  glibc
  libxkbcommon
  libsoup3
  hicolor-icon-theme
  gdk-pixbuf2
  cairo
  dbus
  systemd-libs
  libappindicator
  webkit2gtk-4.1
)
makedepends=(
  git
  deno
  rust
  hidapi
)
optdepends=(
  'wine: Windows plugins'
  'wine-mono: Windows plugins'
  'nodejs: Node.js plugins'
)
options=(!lto)
source=(
  "${pkgname}::git+https://github.com/nekename/OpenDeck#tag=v${pkgver//_/-}"
  disable-telemetry.patch
)
sha512sums=('d8c4fbe37f771b1388d9afa69f64e183c79e7da47aa793fd1ba58402dbbd54c8653e14c97eb6859e5ebaae967931c4c5d5c20a8fec25a3c454b610b237a68e22'
            'be35eb5f29431e28f1033b2a7c22a4f6726eb3ecbbd94cf99929eab29af4377887d78bedab73f4d4120c2deb2c9e166c41ac216d08d32b69b676a8f1b3f31884')
b2sums=('2dc8f6c1212d7585f69049c65d4cf5132c1c16c23655dc4bfc8513ceb7edfc2a1e539b7505a310d6cd34979fec1d00ab7c8411f0c3024c0bfbb80368c65b67e2'
        '89227a9866f12c40cd559c0359c6b7f335e1e123575b7af9b6337c3759f4af660104072be869c07347c1cbe3c3c511cbc720c6305f331f05460c600a5f157ba4')

prepare() {
  cd "$pkgname"

  # telemetry should be opt-in, not opt-out
  patch -p1 -i "$srcdir/disable-telemetry.patch"

  # install frontend dependencies
  deno install

  # download rust dependencies
  cd src-tauri
  cargo fetch --locked --target host-tuple
}
build() {
  cd "$pkgname"

  # disable update check
  export OPENDECK_DISABLE_UPDATE_CHECK=1

  deno task tauri build --bundles deb -- --frozen
}

package() {
  cd "$pkgname"

  cp -a src-tauri/target/release/bundle/deb/opendeck_*/data/* "$pkgdir"
}
