# Contributor: Greg Erwin <first name last name 256 at gmail dot com>

pkgname=libgpiod
pkgver=2.3.2
pkgrel=1
pkgdesc="C library and tools for interacting with the linux GPIO character device"
url="https://git.kernel.org/pub/scm/libs/libgpiod/libgpiod.git"
arch=('x86_64')
license=('LGPL-2.1-or-later' 'GPL-2.0-or-later' 'CC-BY-SA-4.0')
depends=('python')
makedepends=('git' 'meson' 'ninja' 'help2man')
source=("git+$url#tag=v$pkgver")
sha256sums=('14fc504cd97f82459bde1c87f3b345237a2c0cbfba1ba36cd7b8a4701346e253')

build() {
  cd $pkgname

  arch-meson build \
    -Ddefault_library=shared \
    -Dtools=enabled \
    -Dgpioset-interactive=disabled \
    -Dtests=disabled \
    -Dexamples=disabled \
    -Dbindings-cxx=enabled \
    -Dbindings-python=enabled \
    -Dbindings-rust=disabled \
    -Dbindings-glib=disabled \
    -Ddbus=disabled \
    -Dintrospection=disabled \
    -Dsystemd=disabled
  meson compile -C build
}

package() {
  cd $pkgname
  meson install -C build --destdir "$pkgdir"
}
