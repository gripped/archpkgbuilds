# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=clairvoyant
pkgver=3.1.14
pkgrel=3
pkgdesc='Get psychic answers from this fortune teller'
arch=(x86_64)
url='https://apps.gnome.org/Clairvoyant/'
license=(GPL-3.0-or-later)
groups=(gnome-circle)
depends=(
  glib2
  glibc
  gtk4
  hicolor-icon-theme
  libadwaita
)
makedepends=(
  appstream
  git
  meson
  vala
)
source=(
  "git+https://github.com/cassidyjames/clairvoyant.git#tag=$pkgver"
  clairvoyant-dbus-activatable.patch
)
b2sums=(
  0024d11968885f76e8fdeff1512217c4c231df6506abc52fb07e3263e952b09a085b399b7df91e3f2dbfe149eb0ecd267b7ddd803fdafed35da35695bcd0e5cd
  4ac8ecd47fdb73a610d0c7a5d579c12baf7b4e47eda84450d2e12c0dbc976a8353dde1855d063086c8aefd77d0bcde6d8977c0dc3873a269d3b3acf3c9a15fe2
)

prepare() {
  cd $pkgname

  # Add D-Bus service file
  # https://github.com/cassidyjames/clairvoyant/pull/107
  git apply -3 ../clairvoyant-dbus-activatable.patch
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  ln -s com.cassidyjames.clairvoyant "$pkgdir/usr/bin/clairvoyant"
}
