pkgname=qmk
pkgver=1.2.0
pkgrel=4
pkgdesc='CLI tool for customizing supported mechanical keyboards'
arch=(any)
url='https://github.com/qmk/qmk_cli'
license=(MIT)
depends=(
  python
  python-platformdirs
  python-argcomplete
  python-colorama
  python-milc
  python-dotty-dict
  python-jsonschema
  git
  avr-gcc
  arm-none-eabi-gcc
  avr-libc
  arm-none-eabi-binutils
  arm-none-eabi-newlib
  avr-binutils
  dfu-programmer
  dfu-util
  avrdude
  python-hjson
  python-pygments
  python-hid
  python-pyusb
  python-pyserial
  python-pillow
  dos2unix
  qmk-udev
)
makedepends=(
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
optdepends=(
  gcc
  libffi
  libusb-compat
  'clang: chibios-upgrader'
  'zip: some distribution script'
  'wget: some update scripts'
  'diffutils: some update scripts'
)
source=("$pkgname::git+$url#tag=$pkgver")
sha512sums=('d837880c8274caadea9b55e01d94c7050ccd76d44a1bc9609ca7d2de005cd3e04284967d2023f3c6c3ba715570ef0c0e94e32a169a58ba94670e55a5c3a0d868')
b2sums=('0554741c974afa603656cc404223ba1cb079ef1e6bb5c7f68b2505963bb732c1687d61dac8edb20476732a13a6a98008304fd7dd4796f1b3e038f6ec32127aa8')

build() {
  cd "$pkgname"

  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname"

  python -m installer --destdir="$pkgdir" dist/*.whl

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
