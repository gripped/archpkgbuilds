# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=thingy
pkgver=1.2.4
pkgrel=2
pkgdesc='Application to quickly access recent and favorite documents'
arch=(any)
url='https://github.com/linuxmint/thingy'
license=(GPL-3.0-or-later)
groups=(x-apps)
depends=(
  bash
  dconf
  gdk-pixbuf2
  glib2
  gtk3
  hicolor-icon-theme
  pango
  python
  python-gobject
  python-setproctitle
  xapp
)
makedepends=(git)
source=("git+https://github.com/linuxmint/thingy.git#tag=$pkgver")
b2sums=(cda2fa2252f70a8d7cf18135e4c19dd9f3f23e1006cc4fb2143112f5a0660dde8ec53ebf5f1ca7f0fec52b962170493e2d0e538fa5ba8f23f33cc986bc688fc2)

prepare() {
  cd $pkgname

  # Add more supported document readers
  # https://github.com/linuxmint/thingy/pull/21
  sed -i 's/\["xreader"\]/["xreader", "atril", "org.gnome.Evince", "org.gnome.Papers"]/' usr/lib/thingy/thingy.py

  # Set version number
  sed -i "s/__DEB_VERSION__/$pkgver/" usr/lib/thingy/thingy.py
}

build() {
  cd $pkgname
  make
}

package() {
  cd $pkgname
  cp -r usr "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
