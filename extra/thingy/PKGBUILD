# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=thingy
pkgver=1.2.9
pkgrel=1
pkgdesc='Application to quickly access recent and favorite documents'
arch=(any)
url='https://github.com/linuxmint/thingy'
license=(GPL-3.0-or-later)
groups=(x-apps)
depends=(
  bash
  dconf
  gdk-pixbuf2
  glib2
  gnome-desktop
  gtk3
  hicolor-icon-theme
  pango
  python
  python-gobject
  python-setproctitle
  xapp
)
makedepends=(git)
source=("git+https://github.com/linuxmint/thingy.git#tag=$pkgver")
b2sums=(fd99b3896e93a327cd0a754bb583ea08eb2a8aac5572aaf8b473ecef50bfb7ec3d46f59d3f72652579dab050257a641e699ebc44419dfbba577d11fb68c54e10)

prepare() {
  cd $pkgname

  # Set version number
  sed -i "s/__DEB_VERSION__/$pkgver/" usr/lib/thingy/thingy.py
}

build() {
  cd $pkgname
  make
}

package() {
  cd $pkgname
  cp -r usr "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
