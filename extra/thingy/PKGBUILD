# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=thingy
pkgver=1.2.6
pkgrel=1
pkgdesc='Application to quickly access recent and favorite documents'
arch=(any)
url='https://github.com/linuxmint/thingy'
license=(GPL-3.0-or-later)
groups=(x-apps)
depends=(
  bash
  dconf
  gdk-pixbuf2
  glib2
  gtk3
  hicolor-icon-theme
  pango
  python
  python-gobject
  python-setproctitle
  xapp
)
makedepends=(git)
source=("git+https://github.com/linuxmint/thingy.git#tag=$pkgver")
b2sums=(30da817ba378fad35326849204959b8d0f559a4cb71619f7d51bb45453b138a8910297d23aebe7f318765d8cc8452fcd9d878939b71b79981bdad6eef2db2db4)

prepare() {
  cd $pkgname

  # Set version number
  sed -i "s/__DEB_VERSION__/$pkgver/" usr/lib/thingy/thingy.py
}

build() {
  cd $pkgname
  make
}

package() {
  cd $pkgname
  cp -r usr "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
