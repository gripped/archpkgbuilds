# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=pantheon-maps
pkgver=9.0.0
pkgrel=1
pkgdesc='Map viewer designed for Pantheon'
arch=(x86_64)
url=https://github.com/elementary/maps
license=(GPL-3.0-or-later)
groups=(pantheon)
depends=(
  dconf
  geoclue
  geocode-glib-2
  glib2
  glibc
  granite7
  gtk4
  hicolor-icon-theme
  libadwaita
  libshumate
)
makedepends=(
  git
  meson
  vala
)
source=(pantheon-maps::git+https://github.com/elementary/maps.git#tag=${pkgver})
b2sums=('02b180d3a1d6ec4a6c44b2a917cb3852ba835fcd8b2182c8e8768b063e2858844067cd6fa6d2e65b1275ec43c216db3cbb630b86e415d8671579551716825c75')

build() {
  arch-meson pantheon-maps build
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}
