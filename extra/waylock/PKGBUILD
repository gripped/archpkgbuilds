pkgname=waylock
pkgver=1.7.0
pkgrel=1
pkgdesc="A simple screenlocker for wayland compositors"
arch=(x86_64)
url="https://codeberg.org/ifreund/waylock"
license=(ISC)
depends=(
  glibc
  libxkbcommon
  pam
  wayland
)
makedepends=(
  git
  scdoc
  wayland-protocols
  zig
)
_zig_deps=(
  # https://codeberg.org/ifreund/waylock/src/tag/v${pkgver}/build.zig.zon
  wayland-0.7.0-lQa1kuP8AQD5dW7_o-VKLVD_QbqXe7Zob78r2su7Pyex.tar.gz::https://codeberg.org/ifreund/zig-wayland/archive/v0.7.0.tar.gz
  xkbcommon-0.5.0-VDqIe8y3AgDU-cGL02xZplwABH3WbpTimrrgbgTgD_3g.tar.gz::https://codeberg.org/ifreund/zig-xkbcommon/archive/v0.5.0.tar.gz
)
source=(
  "git+$url?signed#tag=v$pkgver"

  "${_zig_deps[@]}"
)
noextract=("${_zig_deps[@]%%::*}")
sha512sums=('422deb565b4b2a53aff90708559e4c3491b0f366baa555d5db51e9805d8a5f592a9db8d8a20de2b2ed88be70507f997b0c32f6b03eb8647473c29ffe24f67ae2'
            'cbf3ae1e3095ba7d61b5d83c5f32cd48f049e8e1a6f5eef85cdd12631d8e237ea7ccf1c6b20368a240ffd539e327232ef7e8328682e4d6b9729a7a2b34ae27e7'
            '60db27f1c10ef7b0b01c97895312a26e53057ccd1da1de844171817d02d01b0ba6356eb14f5864ce6f03ccc817fed57dfc91b2422d980be3dff33dcf149c97f2')
b2sums=('54d30014686b45bcf3ef17f83f7ec716530f8ccef15ea8ccc1b8bfec87ee2f77f253b18717adb08eb08d75e88dbb5e3d39faa28a6b8f7213b40f750ae19cbac5'
        'b4ce2979b59ecc75aaf8dc48107157600f0e3cae0a60a96d6c8fc6fad8b1664da4c3c9637712adc5b4528013db00961bb95d490777c46021d6af0040562fa61c'
        '4e48e8127f9f736066971fb4941ccc5fcfcf638a36728b804bec6a5add2213909030406a3256453ebc33ec370259a0849143132d7f71b4b7d9b994421cc09f30')
validpgpkeys=('5FBDF84DD2278DB2B8AD8A5286DED400DDFD7A11') # Isaac Freund <mail@isaacfreund.com>

prepare() {
  ZIG_GLOBAL_CACHE_DIR="./zig-global-cache"

  # Copy packages into global cache
  mkdir -p "$ZIG_GLOBAL_CACHE_DIR/p/"
  cp "${_zig_deps[@]%%::*}" "$ZIG_GLOBAL_CACHE_DIR/p/"
}

build() {
  cd "$pkgname"

  export ZIG_GLOBAL_CACHE_DIR=../zig-global-cache
  local zig_options=(
    -Dcpu=baseline
    -Dpie
    -Dtarget=native-linux.6.12-gnu.2.42
    --build-id=sha1
    --prefix /usr
    --search-prefix /usr
    --verbose
  )
  DESTDIR=build zig build "${zig_options[@]}"
}

package() {
  depends+=(
    libxkbcommon.so
    libpam.so
    libwayland-client.so
  )

  cd "$pkgname"

  mv -v build/* "$pkgdir"

  install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -vDm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
