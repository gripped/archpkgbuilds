# Maintainer: Levente Polyak <anthraxx[at]archlinux[dot]org>
# Contributor: Xeonacid <h.dwwwwww at gmail dot com>

_pyname=cle
pkgname=python-${_pyname}
pkgver=10.0.6
_testbinaries_ver=${pkgver}
pkgrel=1
pkgdesc='Loads binaries and their libraries, resolves imports and provides an abstraction of process memory'
url='https://github.com/angr/cle'
arch=(any)
license=(BSD-2-Clause)
depends=(
  python
  python-archinfo
  python-arpy
  python-cart
  python-cffi
  python-minidump
  python-pefile
  python-pyelftools
  python-pyvex
  python-pyxbe
  python-pyxdia
  python-sortedcontainers
  python-uefi-firmware
)
makedepends=(
  python-build
  python-installer
  python-setuptools
  python-wheel
)
checkdepends=(
  python-arpy
  python-cart
  python-claripy
  python-minidump
  python-pyaxmlparser
  python-pytest
)
optdepends=(
  'python-claripy: symbolic constraints'
  'python-minidump: minidump'
  'python-pyxbe: xbe'
  'python-arpy: ar'
  'python-pyaxmlparser: apk'
)
source=(
  "${url}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz"
  "https://github.com/angr/binaries/archive/v${_testbinaries_ver}/angr-binaries-${_testbinaries_ver}.tar.gz"
)
sha512sums=('45e6d8f3fb1824411b0597240959137755d5ea4c080acb901c5cca3c064b9dc20cd3f0b5a139d913280efcec0a051d6f31c33310e250cc9943e4951262e77b4a'
            '2c7621b939cc79cd6221357ce1908e92ebd07ed24ee9a6fb52b88de23240e22c1483a413f280e8aec3238e32f4b08fea1ee26e2f469959096ab1ec7dab51ba5a')
b2sums=('c7e005a0ef5a8fd87c4b249567df12cd91fdfb14fb69c643505fe5bdbb84d1985ec4d36893b4fd700ef0c7ab152fb4f70c6bf1d16776ece96ccc97846721ec46'
        '7a8448635d0e9e9c1273145c69beff649f68d677c723f95987918d51492897af02a0330a1b4df0ff8a5f0d8b16d44044291e1a4f08fa23c293386943ce3c9467')

prepare() {
  ln -s binaries-${_testbinaries_ver} binaries
}

build() {
  cd ${_pyname}-${pkgver}
  python -m build --wheel --no-isolation
}

check() {
  cd ${_pyname}-${pkgver}
  PYTHONPATH=build/lib pytest
}

package() {
  cd ${_pyname}-${pkgver}
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm 644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm 644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
}

