# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgbase=deepin-anything
pkgname=(deepin-anything deepin-anything-dkms)
pkgver=7.0.8
_extramodules=extramodules-ARCH
pkgrel=1
pkgdesc="Deepin Anything file search tool"
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-anything"
license=('GPL-3.0-or-later')
makedepends=('git' 'cmake' 'qt6-base' 'libnl' 'lucene++' 'util-linux' 'boost' 'spdlog' 'glib2')
source=(
  "git+https://github.com/linuxdeepin/deepin-anything.git#tag=$pkgver"
  0001-fix-Rename-init_mnt_ns-to-avoid-symbol-clash-with-ke.patch
)
sha512sums=('0c232efda02c203321ed89cdb61127d67623fc57e771a03fd1f77af4025132ba3dd76a04c5058e51718753ebbd6d550f4b288ac01c0c93ce237ff9d29e36666a'
            '4d41abba018d90f186a6c5f5af24dd4f1f43858c5ce977eba98c20f6c86df86382ed26c13fc04d8b93350a202ceb58946cc316eb8364fd6d6c0f4241eee0c3cd')

prepare() {
  cd "$pkgbase"

  # Fix build with kernel 6.15: https://github.com/linuxdeepin/deepin-anything/commit/2ee1165
  git cherry-pick -n 2ee1165

  # Fix build with kernel 6.18
  patch -Np1 < "$srcdir"/0001-fix-Rename-init_mnt_ns-to-avoid-symbol-clash-with-ke.patch

  # Fix configuration with modern CMake
  sed -i 's/cmake_minimum_required(VERSION 3\.1\.0)/cmake_minimum_required(VERSION 3.5)/' CMakeLists.txt src/kernelmod/CMakeLists.txt
  sed -i 's/cmake_minimum_required(VERSION 3\.1)/cmake_minimum_required(VERSION 3.5)/' src/server/CMakeLists.txt

  # Boost.System is header-only in modern Boost.
  sed -i 's/find_package(Boost REQUIRED COMPONENTS system)/find_package(Boost REQUIRED)/' src/server/CMakeLists.txt

  # Fix GCC 16 build failures from upstream's Werror.
  sed -i 's/ -Werror//' src/server/CMakeLists.txt
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

build() {
  cmake -B build -S "$pkgbase" \
    -DCMAKE_BUILD_TYPE='None' \
    -DCMAKE_INSTALL_PREFIX='/usr' \
    -Wno-dev
  cmake --build build
}

package_deepin-anything() {
  depends=('DEEPIN-ANYTHING-MODULE' 'qt6-base' 'libnl' 'lucene++' 'util-linux-libs' 'spdlog' 'glib2')
  groups=('deepin')

  DESTDIR="$pkgdir" cmake --install build

  cd "$pkgdir"
  _pick $pkgbase-dkms usr/src/
}

package_deepin-anything-dkms() {
  depends=('dkms')
  provides=('DEEPIN-ANYTHING-MODULE')
  conflicts=('DEEPIN-ANYTHING-MODULE')

  mv -v $pkgname/* "$pkgdir/"
}
