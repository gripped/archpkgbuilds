 initMagicMime :: IO (Maybe Magic)
 #ifdef WITH_MAGICMIME
-initMagicMime = catchMaybeIO $ do
-	m <- magicOpen [MagicMime]
+initMagicMime = catchMaybeIO $ magicIO $ do
