@@ -21,21 +21,20 @@ import Common
 import Types.Mime
 import Control.Monad.IO.Class
 #ifdef WITH_MAGICMIME
-import Magic
+import Magic.FilePath
+import qualified Data.Text as T
 import Utility.Env
-import Control.Concurrent
-import System.IO.Unsafe (unsafePerformIO)
 #else
 type Magic = ()
