# Maintainer: Orhun Parmaksız <orhun@archlinux.org>

pkgname=esp-generate
pkgver=2.0.0
pkgrel=1
pkgdesc="Template generation tool to create no_std applications for Espressif's chips"
arch=('x86_64')
url="https://github.com/esp-rs/esp-generate"
license=('MIT' 'Apache-2.0')
makedepends=('cargo')
checkdepends=('git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('2aff49fdbc951a5359d12cde936c105e28f8ea19dcbdf730b271aaafcea40d95')
options=('!lto')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --frozen
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm 755 "target/release/$pkgname" -t "$pkgdir/usr/bin"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm 644 LICENSE-MIT -t "$pkgdir/usr/share/licenses/$pkgname"
}

# vim: ts=2 sw=2 et:
