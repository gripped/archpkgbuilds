# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgbase=nunicode
pkgname=(
  libnu
  libnusqlite3
)
pkgver=1.11.1
pkgrel=1
pkgdesc='A i18n library implementing Unicode 13.0'
arch=(x86_64)
url='https://bitbucket.org/alekseyt/nunicode'
license=(MIT)
makedepends=(
  git
  cmake
  sqlite
)
source=("$pkgbase::git+$url#tag=$pkgver")
sha512sums=('4e2d4dd664b2a43776eee60011d13118908dc62f6aaa9cda1b59b4c7ed800aabb86346d0e7636861888a605b50d9e4f74eef347f05b80168d27a6bf08cd45dde')
b2sums=('edf8de659828e8611fe0e6b578aa4cc2a8914583b196ddd1a77e318f990d29aa206b703047a0adb58cdd773f610bd6b95378feebb808e4e85a2d6c10b4501a06')

build() {
  local cmake_options=(
    -B build
    -S "$pkgbase"
    -W no-dev
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
  )

  cmake "${cmake_options[@]}"

  cmake --build build
}

package_libnu() {
  DESTDIR="$pkgdir" cmake --install build

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$pkgbase/LICENSE"
}

package_libnusqlite3() {
  pkgdesc+=' - SQLite extension'
  depends=(glibc)

  install -vDm755 -t "$pkgdir/usr/lib" build/sqlite3/libnusqlite3.so

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$pkgbase/LICENSE"
}
