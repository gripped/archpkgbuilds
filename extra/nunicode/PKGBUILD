# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgbase=nunicode
pkgname=(
  libnu
  libnusqlite3
)
pkgver=1.12
pkgrel=1
pkgdesc='A i18n library implementing Unicode 13.0'
arch=(x86_64)
url='https://bitbucket.org/alekseyt/nunicode'
license=(MIT)
makedepends=(
  git
  cmake
  sqlite
)
source=("$pkgbase::git+$url#tag=$pkgver")
sha512sums=('c15af4b8f8dc7fbdb7bfd93eb823a750feefb5c2d362c3f23c3123d00c59c8ff60a3809a632dfc83e07604a4cb1ec37ae6a743d8ccc0c133de1402cf89ad5808')
b2sums=('c108e7151966776aa3e96b6a7e3741adf7a2a07e09ceff32e02c3449be8bcb5fdb5db8958f784443e7e6694fac631931a4745563dae0b0fa3fc5eb81d61d8e2f')

build() {
  local cmake_options=(
    -B build
    -S "$pkgbase"
    -W no-author
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D NU_BUILD_SQLITE3_EXT=ON
  )

  cmake "${cmake_options[@]}"

  cmake --build build
}

package_libnu() {
  DESTDIR="$pkgdir" cmake --install build

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$pkgbase/LICENSE"
}

package_libnusqlite3() {
  pkgdesc+=' - SQLite extension'
  depends=(glibc)

  install -vDm755 -t "$pkgdir/usr/lib" build/sqlite3/libnusqlite3.so

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$pkgbase/LICENSE"
}
