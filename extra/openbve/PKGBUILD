pkgname=openbve
pkgver=1.14.0.3
pkgrel=1
pkgdesc='3D cab based train simulator'
arch=(any)
url='https://openbve-project.net/'
license=(BSD-2-Clause)
depends=(
  sh
  hicolor-icon-theme
  libglvnd
  mono
  openal
  ttf-font
)
makedepends=(
  git
  mono-msbuild
  nuget
)
source=(
  "$pkgname::git+https://github.com/leezer3/OpenBVE.git#tag=${pkgver}"
  simplify-wrapper-scripts.patch
  update-restart-cfg.patch
  use-uaccess-for-udev.patch
)
