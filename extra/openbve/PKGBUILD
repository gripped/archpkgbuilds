prepare() {
  cd "$pkgname"

  patch -p1 -i "$srcdir/simplify-wrapper-scripts.patch"
  patch -p1 -i "$srcdir/update-restart-cfg.patch"
  patch -p1 -i "$srcdir/use-uaccess-for-udev.patch"

  nuget restore OpenBVE.sln
}

build() {
  cd "$pkgname"

  msbuild /p:Configuration=Release OpenBVE.sln

  # this is Windows only, so can be removed
  rm bin_release/AtsPluginProxy.*
}

package() {
  cd "$pkgname"

  # package
  install -vd "$pkgdir/usr/lib/$pkgname"
  cp -r bin_release/* "$pkgdir/usr/lib/$pkgname"

  # udev rules + config
  install -vDm644 -t "$pkgdir/usr/lib/udev/rules.d" installers/debian/etc/udev/rules.d/99-ps2-train-controllers.rules
  install -vDm644 -t "$pkgdir/etc/openbve" installers/debian/etc/openbve/filesystem.cfg

  # wrapper scripts
  install -vDm755 -t "$pkgdir/usr/bin" debian/wrappers/*

  # man pages
  install -vDm644 -t "$pkgdir/usr/share/man/man6" debian/*.6

  # desktop file and icon
  install -vDm644 debian/$pkgname.desktop "$pkgdir/usr/share/applications/net.openbve_project.OpenBVE.desktop"
  install -vDm644 -t "$pkgdir/usr/share/icons/hicolor/128x128/apps" debian/$pkgname.png
  install -vDm644 -t "$pkgdir/usr/share/metainfo" net.openbve_project.OpenBVE.metainfo.xml

  # licenses
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" licenses/* Readme.md
}
