# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=openbve
_pkgname=OpenBVE
pkgver=1.14.0.1
pkgrel=1
pkgdesc='3D cab based train simulator'
arch=(any)
url='https://openbve-project.net/'
license=(BSD-2-Clause)
depends=(
  hicolor-icon-theme
  libglvnd
  mono
  openal
  ttf-font
)
makedepends=(
  git
  mono-msbuild
  nuget
)
source=(
  "git+https://github.com/leezer3/$_pkgname.git#tag=${pkgver}"
  "$pkgname.sh"
)
b2sums=(
  d9761681cb35548d797c979f5147842635769982b8ad8cbe86ccbd52043a7176543a934634698916289f0b788ab2b11873c54565a36d55d12ab56a5e45f75efb
  715304d258cdd3fbc06e62ca0b1eb204c33a8a09131f4249092f09c46e8b52a47e162e34dda955ed380a55abcc0a43ca0193672ccbed0837184da2af6ca5ae1e
)

prepare() {
  cd $_pkgname
  nuget restore OpenBVE.sln
  sed -i 's/net.openbve_project.OpenBVE.desktop/openbve.desktop/' net.openbve_project.OpenBVE.metainfo.xml
}

build() {
  cd $_pkgname
  msbuild /p:Configuration=Release OpenBVE.sln
}

package() {
  cd $_pkgname

  # Binaries
  install -dm755 "$pkgdir/usr/lib/$pkgname/"
  cp -r bin_release/* "$pkgdir/usr/lib/$pkgname/"

  # Data
  install -dm755 "$pkgdir/usr/share/games/$pkgname/"
  mv "$pkgdir/usr/lib/$pkgname/Data" "$pkgdir/usr/share/games/$pkgname/"
  ln -s ../../share/games/$pkgname/Data "$pkgdir/usr/lib/$pkgname/Data"

  # Executable
  install -Dm755 ../$pkgname.sh "$pkgdir/usr/bin/$pkgname"

  # Desktop file and icon
  install -Dm644 -t "$pkgdir/usr/share/icons/hicolor/128x128/apps/" debian/$pkgname.png
  install -Dm644 -t "$pkgdir/usr/share/applications" debian/$pkgname.desktop
  install -Dm644 -t "$pkgdir/usr/share/metainfo" net.openbve_project.OpenBVE.metainfo.xml

  # License
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" licenses/* Readme.md
}
