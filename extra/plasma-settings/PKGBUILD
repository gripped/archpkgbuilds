pkgname=plasma-settings
pkgver=26.02.0
pkgrel=1
pkgdesc='Settings application for Plasma Mobile'
arch=(x86_64)
url='https://invent.kde.org/plasma-mobile/plasma-settings'
license=(GPL-3.0-or-later)
depends=(
  glibc
  hicolor-icon-theme
  kcmutils
  kconfig
  kcoreaddons
  kcrash
  kdbusaddons
  ki18n
  kirigami
  kirigami-addons
  kitemmodels
  kitemviews
  kservice
  libstdc++
  qqc2-desktop-style
  qt6-base
  qt6-declarative
)
makedepends=(
  cmake
  extra-cmake-modules
)
source=(
  "https://download.kde.org/stable/$pkgname/$pkgname-$pkgver.tar.xz"{,.sig}
  0001-Fix-potential-undefined-behavior-in-menu-list-obtain.patch
)
sha256sums=(
  fa7389a121bde75344caf6eba18964eaab4e21a556be6cb390588e5f986140de
  SKIP
  b6e60f79154bd4916b3d43a912c9d5be1175ac2836ce1cf8d6a8248c094b53b7
)
validpgpkeys=(
  39FFA93CAE9C6AFC212AD00202325448204E452A # Carl Schwan <carl@carlschwan.eu>
  0AAC775BB6437A8D9AF7A3ACFE0784117FBCE11D # Bhushan Shah <bshah@mykolab.com>
  23919AE71103C02137422E3C5E023F97C5BB4C13 # Devin Lin <espidev@gmail.com>
)

prepare() {
  cd $pkgname-$pkgver

  # Fix potential undefined behavior in menu list obtaining
  # https://invent.kde.org/plasma-mobile/plasma-settings/-/merge_requests/150
  patch -Np1 -i ../0001-Fix-potential-undefined-behavior-in-menu-list-obtain.patch
}

build() {
  cmake -B build -S $pkgname-$pkgver
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
