# Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>
# Maintainer: Robin Candau <antiz@archlinux.org>

pkgname=podlet
pkgver=0.3.1
pkgrel=4
pkgdesc="Generate Podman Quadlet files from a Podman command, compose file, or existing object"
arch=('x86_64')
url="https://github.com/containers/podlet"
license=('MPL-2.0')
depends=('glibc' 'libgcc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('9dd2ce4a618563f8cb607106eb8082744b228575627bcc5e144c9f076e4be691')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked --all-features
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm 755 "target/release/$pkgname" -t "$pkgdir/usr/bin"
}
