pkgname=pantheon-shortcut-overlay
pkgver=8.1.0
pkgrel=2
pkgdesc='A native, OS-wide shortcut overlay for Pantheon'
arch=(x86_64)
url=https://github.com/elementary/shortcut-overlay
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  gala
  glib2
  glibc
  gnome-settings-daemon
  gsettings-desktop-schemas
  gtk4
  libgee
  libgranite-7.so
  pantheon-wayland
)
makedepends=(
  git
  meson
  vala
)
source=(pantheon-shortcut-overlay::git+https://github.com/elementary/shortcut-overlay.git#tag=${pkgver})
b2sums=('66d8d2ab9ebf77906191e18d7f857c3771e6134437bba4874edef22025b45da54eea84b7c0824d9f03e981a80ec724f3372c39437e8fbbd5b0a842a07a91de3f')

build() {
  arch-meson pantheon-shortcut-overlay build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}

