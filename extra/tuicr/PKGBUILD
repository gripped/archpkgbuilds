# Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>
# Contributor: Anas Elgarhy <anas.elgarhy.dev@gmail.com>
pkgname=tuicr
pkgver=0.23.0
pkgrel=1
pkgdesc='A code review TUI with vim keybindings'
arch=('x86_64' 'aarch64' 'riscv64')
url='https://github.com/agavra/tuicr'
license=('MIT')
options=('!lto')
depends=('libgit2' 'glibc' 'libgcc' 'oniguruma')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('adce72de532ba0743e373b703590a6bc098bf49efbab21257603c19be8161e88')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$pkgname-$pkgver"
  RUSTONIG_DYNAMIC_LIBONIG=1 cargo build --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm0755 target/release/tuicr "$pkgdir/usr/bin/tuicr"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname/" README.md
}

# vim: ts=2 sw=2 et:
