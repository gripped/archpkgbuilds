# Contributor: Remi Gacogne <rgacogne-arch at coredump dot fr>
# Contributor: George Rawlinson <grawlinson@archlinux.org>

pkgname=sslscan
pkgver=2.2.4
pkgrel=1
pkgdesc="Fast tool to scan SSL services such as HTTPS to determine supported ciphers"
url="https://github.com/rbsec/sslscan"
arch=(x86_64)
license=(GPL-3.0-or-later)
depends=(
  glibc
  openssl-3
)
source=("$url/archive/$pkgver/$pkgname-$pkgver.tar.gz")
sha512sums=('0eaff5b7d4c32a795d92ef882db64139efa906a3bd2e84e0bf1e3a442ae38b03990c985266a924c2a39aa8ba82fb90523e442c75ee6bce2bc000b593cb3ecad7')
b2sums=('8e433ffe1e88a56c3759535e0061cae60d0ccbca1e14ac7ad29909e7b57d5c6820c4b8d5b0676a1555726c22c732b2c4917094237a7486dd0fff3dfeafab4153')

prepare() {
  cd "$pkgname-$pkgver"
  sed -e 's/CFLAGS ?=/CFLAGS +=/' \
    -e 's/LDFLAGS ?=/LDFLAGS +=/' \
    -e "s/^GIT_VERSION =.*/GIT_VERSION = ${pkgver}/" \
    -i Makefile
}

build() {
  cd "$pkgname-$pkgver"
  # OpenSSL 4 removed TLS methods and ASN.1 fields used by sslscan.
  # https://github.com/rbsec/sslscan/issues/361
  CFLAGS="$CFLAGS -I/usr/include/openssl-3" \
    LDFLAGS="$LDFLAGS -L/usr/lib/openssl-3" make
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}

