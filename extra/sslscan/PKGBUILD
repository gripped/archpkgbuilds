# Contributor: George Rawlinson <grawlinson@archlinux.org>

pkgname=sslscan
pkgver=2.2.2
pkgrel=1
pkgdesc="Fast tool to scan SSL services such as HTTPS to determine supported ciphers"
url="https://github.com/rbsec/sslscan"
arch=(x86_64)
license=(GPL-3.0-or-later)
depends=(
  glibc
  openssl
)
source=("$url/archive/$pkgver/$pkgname-$pkgver.tar.gz")
sha512sums=('452ef1df4c272eb15261383cb084155f128d77c7c5add05245a1117a4c1b777d2c702ae674647dbfc2796ec0ec61cfab9053b3c09a2416d92d9f23abfa0c6048')
b2sums=('8264e8da660bbc42ecc701ed7fda9e90e9e37e10e6044e49e50694182abd0e471ec04291eae29b6b2276377b194917d4191f9d80421203117e743f4947f02036')

prepare() {
  cd "$pkgname-$pkgver"
  sed -e 's/CFLAGS ?=/CFLAGS +=/' \
    -e 's/LDFLAGS ?=/LDFLAGS +=/' \
    -e "s/^GIT_VERSION =.*/GIT_VERSION = ${pkgver}/" \
    -i Makefile
}

build() {
  cd "$pkgname-$pkgver"
  make
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}

