# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgbase=ggml
pkgname=(
  ggml
  ggml-sycl
)
pkgver=0.15.3
pkgrel=5
pkgdesc='Tensor library for machine learning'
arch=(x86_64)
url=https://github.com/ggerganov/ggml
license=(MIT)
depends=(
  glibc
  libgcc
  libgomp
  libstdc++
)
conflicts=(ggml)
provides=(
  ggml
  ggml-blas
  ggml-cpu
)
makedepends=(
  cmake
  cuda
  git
  intel-oneapi-toolkit
  level-zero-headers
  nccl
  ninja
  openblas
  #opencl-headers
  procps-ng
  rocm-hip-sdk
  rocm-toolchain
  shaderc
  spirv-headers
  vulkan-headers
  vulkan-icd-loader
)
source=(git+https://github.com/ggml-org/ggml.git#tag=v${pkgver})
b2sums=('5b794b40ad52c9a2eeacd7e5a6c68440d8d0cef2b3669db69f773b3ef83a7de21248158c89a17a98a170b8609c28438e30d31180fead315a203c5982700dab73')

build() {
  cmake -S ggml -B build-all -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DAMDGPU_TARGETS=$(rocm-supported-gfx) \
      -DGGML_BACKEND_DL=ON \
      -DGGML_BACKEND_DIR=/usr/lib/ggml \
      -DGGML_BLAS=ON \
      -DGGML_BLAS_VENDOR=OpenBLAS \
      -DGGML_CPU_ALL_VARIANTS=ON \
      -DGGML_CUDA=ON \
      -DGGML_HIP=ON \
      -DGGML_VULKAN=ON
      #-DGGML_OPENCL=ON \
      #-DGGML_OPENCL_USE_ADRENO_KERNELS=OFF \
  cmake --build build-all

  . /opt/intel/oneapi/setvars.sh

  cmake -S ggml -B build-sycl -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_SKIP_RPATH=ON \
      -DCMAKE_C_COMPILER=icx \
      -DCMAKE_CXX_COMPILER=icpx \
      -DGGML_BACKEND_DL=ON \
      -DGGML_BACKEND_DIR=/usr/lib/ggml \
      -DGGML_BLAS=ON \
      -DGGML_BLAS_VENDOR=Intel10_64lp \
      -DGGML_CPU_ALL_VARIANTS=ON \
      -DGGML_SYCL=ON \
      -DGGML_SYCL_F16=ON
  cmake --build build-sycl
}

package_ggml() {
  optdepends=(
    'cuda: CUDA backend'
    #'ocl-icd: OpenCL backend'
    'nccl: CUDA backend'
    'openblas: BLAS backend'
    'hipblas: ROCm backend'
    'rocblas: ROCm backend'
    'rocm-hip-runtime: ROCm backend'
    'vulkan-icd-loader: Vulkan backend'
  )
  provides+=(
    ggml-cuda
    #ggml-opencl
    ggml-rocm
    ggml-vulkan
  )

  DESTDIR="${pkgdir}" cmake --install build-all
  install -Dm 644 ggml/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}
}

package_ggml-sycl() {
  depends+=(
    intel-oneapi-toolkit
    level-zero-loader
  )

  DESTDIR="${pkgdir}" cmake --install build-sycl
  install -Dm 644 ggml/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}
}
