# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgbase=ggml
pkgname=(
  ggml-rocm
  ggml-vulkan
)
pkgver=0.15.2
pkgrel=2
pkgdesc='Tensor library for machine learning'
arch=(x86_64)
url=https://github.com/ggerganov/ggml
license=(MIT)
depends=(
  glibc
  libgcc
  libstdc++
)
conflicts=(ggml)
provides=(ggml)
makedepends=(
  cmake
  git
  ninja
  rocm-hip-sdk
  rocm-toolchain
  shaderc
  spirv-headers
  vulkan-headers
  vulkan-icd-loader
)
source=(git+https://github.com/ggml-org/ggml.git#tag=v${pkgver})
b2sums=('b52659d43f3b6ffd7da4dccbc2419865efb8f3ace867b0493f319cb4b161b73162e55067ed920274987cff04b231b1bbde9b054f682b1d3de9c9ada1703455d7')

build() {
  cmake -S ggml -B build-rocm -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DAMDGPU_TARGETS=$(rocm-supported-gfx) \
      -DGGML_OPENMP=OFF \
      -DGGML_HIP=ON
  cmake --build build-rocm

  cmake -S ggml -B build-vulkan -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DGGML_OPENMP=OFF \
      -DGGML_VULKAN=ON
  cmake --build build-vulkan
}

package_ggml-rocm() {
  depends+=(
    hipblas
    rocblas
    rocm-hip-runtime
  )

  DESTDIR="${pkgdir}" cmake --install build-rocm
  install -Dm 644 ggml/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}
}

package_ggml-vulkan() {
  depends+=(vulkan-icd-loader)

  DESTDIR="${pkgdir}" cmake --install build-vulkan
  install -Dm 644 ggml/LICENSE -t "${pkgdir}"/usr/share/licenses/${pkgname}
}

