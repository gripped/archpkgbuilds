pkgname=poedit
epoch=1
pkgver=3.9
pkgrel=1
pkgdesc="Cross-platform gettext catalogs (.po files) editor"
arch=('x86_64')
url="https://www.poedit.net/"
license=('MIT')
depends=(
  'boost-libs'
  'glib2'
  'glibc'
  'gtk3'
  'gtkspell3'
  'icu'
  'libgcc'
  'libstdc++'
  'lucene++'
  'pugixml'
  'webkit2gtk-4.1'
  'wxwidgets-gtk3'
)
makedepends=('boost'
             'git'
             'nlohmann-json')
source=(git+https://github.com/vslavik/poedit#tag=v${pkgver}-oss)
sha256sums=('64006234308cce59ea240cf4c44306cfd1a0ddcc219bcde3030b0abfcb99040d')

prepare() {
  cd $pkgname
  git cherry-pick -n 96bc3fe075d369ab953379a8418052c2d79ac250 # Fix spell checking
  autoreconf -fiv
}

build() {
  cd ${pkgname}

  ./configure --prefix=/usr --libexecdir=/usr/lib/poedit
  make
  make -C locales allmo
}

package() {
  cd ${pkgname}

  make DESTDIR="${pkgdir}" install
  install -Dm644 COPYING "${pkgdir}"/usr/share/licenses/${pkgname}/LICENSE
}
