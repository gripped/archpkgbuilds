pkgname=poedit
epoch=1
pkgver=3.9.1
pkgrel=2
pkgdesc="Cross-platform gettext catalogs (.po files) editor"
arch=('x86_64')
url="https://www.poedit.net/"
license=('MIT')
depends=(
  'boost-libs'
  'glib2'
  'glibc'
  'gtk3'
  'gtkspell3'
  'icu'
  'libgcc'
  'libstdc++'
  'lucene++'
  'pugixml'
  'webkit2gtk-4.1'
  'wxwidgets-gtk3'
)
makedepends=('boost'
             'git'
             'nlohmann-json')
source=(git+https://github.com/vslavik/poedit#tag=v${pkgver}-oss)
sha256sums=('178fcce14ad1d7794d8e0da99b7843eb13918a23bb4c2521b8678863a5139c34')

prepare() {
  cd $pkgname
  autoreconf -fiv
}

build() {
  cd ${pkgname}

  ./configure --prefix=/usr --libexecdir=/usr/lib/poedit
  make
  make -C locales allmo
}

package() {
  cd ${pkgname}

  make DESTDIR="${pkgdir}" install
  install -Dm644 COPYING "${pkgdir}"/usr/share/licenses/${pkgname}/LICENSE
}
