# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=incus-ui
pkgver=0.22.1
pkgrel=1
pkgdesc='incus web interface'
arch=(x86_64)
url='https://github.com/zabbly/incus-ui-canonical'
license=(GPL-3.0-only)
makedepends=(git yarn npm)
source=("$pkgname::git+https://github.com/zabbly/incus-ui-canonical.git#tag=incus-${pkgver}")
sha512sums=('6834184283733e2525c4a2d3f50abc025068cb5fdd88c4af1f9c9c2447b0e96515cb8f729f64711fb3aa2119e82a43fd751f8b957de72b8a713c30ea901c6282')
b2sums=('f79321025743aec2e0d11b54b7d965b829ebfe5d87714f576807e861dd79487d080945d7f1edb13338cb39558dcae8671ce4518ef103d8f0a287850334ce92dc')

prepare() {
  cd "$pkgname"

  # See https://github.com/zabbly/incus/blob/2efccf9de6d2245b8c4f2b3203e94613b973cf24/.github/workflows/builds.yml#L366C11-L366C79
  find -type f -name "*.ts" -o -name "*.tsx" -o -name "*.scss" | xargs sed -i \
    -e 's/devlxd/guestapi/g' \
    -e 's/dev\/lxd/dev\/incus/g' \
    -e 's/LXD/Incus/g' \
    -e 's/Lxd/Incus/g' \
    -e 's/lxd/incus/g'

  yarn install
}

build() {
  cd "$pkgname"

  yarn build
}

package() {
  cd "$pkgname"

  install -dm755 "${pkgdir}/usr/share/incus-ui"
  cp -dR --preserve=timestamps "build/ui" -T "${pkgdir}/usr/share/incus-ui"
}
