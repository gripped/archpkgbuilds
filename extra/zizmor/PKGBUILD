# Maintainer: kpcyrd <kpcyrd[at]archlinux[dot]org>
# Maintainer: Orhun Parmaksız <orhun@archlinux.org>

pkgname=zizmor
pkgver=1.30.0
pkgrel=1
pkgdesc="A static analysis tool for GitHub Actions"
url='https://github.com/zizmorcore/zizmor'
arch=('x86_64')
license=('MIT')
depends=(
  'glibc'
  'jemalloc'
  'libgcc'
)
makedepends=(
  'cargo'
)
options=(!lto)
source=(https://github.com/zizmorcore/${pkgname}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz)
sha256sums=('7398a8a4895a7051d6654e1ee7aa6d680a69da5174aba69bf45b73d767329166')
b2sums=('6cc656c388b8764d84b6aa2997581a287484a76af6196b78e1bd8adc59cddd62368c276a621e27d3e8e91bb0654b7b77277885adde3bc4a1a52ec97eb1a38187')

prepare() {
  cd "${pkgname}-${pkgver}"
  cargo fetch --locked --target host-tuple
}

build() {
  cd ${pkgname}-${pkgver}
  export JEMALLOC_OVERRIDE=/usr/lib/libjemalloc.so
  export CARGO_FEATURE_UNPREFIXED_MALLOC_ON_SUPPORTED_PLATFORMS=1
  cargo build --frozen --release
}

check() {
  cd ${pkgname}-${pkgver}
  export JEMALLOC_OVERRIDE=/usr/lib/libjemalloc.so
  export CARGO_FEATURE_UNPREFIXED_MALLOC_ON_SUPPORTED_PLATFORMS=1
  cargo test --frozen -- --skip "e2e"
  target/release/zizmor --help

  target/release/zizmor --format plain crates/zizmor/tests/integration/test-data/template-injection.yml | \
    grep -q 'code injection via template expansion'
  target/release/zizmor --format plain crates/zizmor/tests/integration/test-data/cache-poisoning.yml | \
    grep -q 'runtime artifacts potentially vulnerable to a cache poisoning attack'
}

package() {
  cd ${pkgname}-${pkgver}
  install -Dm 755 -t "${pkgdir}/usr/bin" \
    target/release/zizmor

  install -Dm 644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

# vim: ts=2 sw=2 et:
