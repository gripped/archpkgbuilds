# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-granian
pkgver=2.8.8
pkgrel=1
pkgdesc='Rust HTTP server for Python applications'
arch=('x86_64')
url='https://github.com/emmett-framework/granian'
license=('BSD-3-Clause')
depends=('glibc' 'libgcc' 'python' 'python-click')
makedepends=('cargo' 'git' 'python-build' 'python-installer' 'python-maturin')
checkdepends=('python-httpx' 'python-pytest' 'python-pytest-asyncio' 'python-sniffio' 'python-websockets')
optdepends=(
  'python-dotenv: load environment files'
  'python-setproctitle: set worker process names'
  'python-uvloop: alternative asyncio event loop'
  'python-watchfiles: automatically reload on source changes'
)
# Rust cannot link GCC LTO objects from the ring crypto backend.
# https://github.com/rust-lang/rust/issues/138681
options=('!lto')
source=("git+https://github.com/emmett-framework/granian.git#tag=v$pkgver")
sha512sums=('7d6e5a9a8b6a87b78f7de1a4986db2d7142eb58818f1f3e093a3b86132292ae18323db95ba7a0bcde42ff2d273668e1886e87d4785604ff40e18460e3e348fca')

prepare() {
  cd granian
  cargo fetch --locked
}

build() {
  cd granian
  python -m build --wheel --no-isolation -C build-args='--frozen --compatibility linux'
}

check() {
  cd granian
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  test-env/bin/python -P -m pytest
}

package() {
  cd granian
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
