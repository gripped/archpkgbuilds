# Maintainer: Orhun Parmaksız <orhun@archlinux.org>
# Contributor: Relwi <theofficialdork@hotmail.com>

pkgname=twitch-tui
_pkgname=twt
pkgver=3.0.0
pkgrel=1
pkgdesc="Twitch chat in the terminal"
arch=('x86_64')
url="https://github.com/Xithrius/twitch-tui"
license=('MIT' 'Apache-2.0')
depends=(
  'libgcc'
  'openssl'
)
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha512sums=('ef6bb9ce7d70fda07c3e17f7edfd6db227b32792f0dd6da4f86f330ec1c54d581f5c245db857b09b4d0b1e7ae14f23804121a6529e390e54b68d81b5f3753caa')
options=('!lto')

prepare() {
  cd "$pkgname-$pkgver"
  # Update the locked OpenSSL bindings for compatibility with system OpenSSL 4.
  # https://github.com/rust-openssl/rust-openssl/pull/2591
  cargo update -p openssl --precise 0.10.81
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --frozen
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm 755 "target/release/$_pkgname" -t "$pkgdir/usr/bin"
  install -Dm 644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm 644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# vim: ts=2 sw=2 et:
