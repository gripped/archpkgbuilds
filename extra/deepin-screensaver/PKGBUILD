# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-screensaver
pkgver=6.5.13
pkgrel=1
pkgdesc='Deepin screensaver viewer and tools'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-screensaver"
license=('GPL-3.0-or-later')
depends=('dtk6core' 'dtk6gui' 'dtk6widget' 'qt6-base' 'qt6-declarative' 'qt6-5compat' 'qt6-wayland'
         'libx11' 'libxcb' 'libxss' 'libxext' 'wayland' 'xscreensaver'
         'glibc' 'libgcc' 'libstdc++')
makedepends=('git' 'cmake' 'ninja' 'libxkbcommon' 'qt6-tools' 'wayland-protocols')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/deepin-screensaver.git#tag=$pkgver")
sha512sums=('cb11d3e2d61fe07f3834e880aea8f0a02cf42e90bb29d774eaec00f94ddac598be00120f0ca74a9b4052c434f2ec84fe0fed064da86ea5ed064d87ddaa235aa0')

prepare() {
  cd deepin-screensaver
  # Qt 6.10+ does not import WaylandClientPrivate through WaylandClient.
  sed -i 's/find_package(Qt6 REQUIRED COMPONENTS GuiPrivate)/find_package(Qt6 REQUIRED COMPONENTS GuiPrivate WaylandClientPrivate)/' src/CMakeLists.txt
  # Qt 6.10 removed QWaylandWindow::sendRecursiveExposeEvent(); notify the window directly.
  sed -i '/#include <QWindow>/a #include <qpa/qwindowsysteminterface.h>' src/sessionlock.cpp
  sed -i 's/platform->sendRecursiveExposeEvent();/QWindowSystemInterface::handleExposeEvent(window, QRegion(QRect(QPoint(), size)));/' src/sessionlock.cpp
}

build() {
  cd deepin-screensaver
  cmake -B build -S . -GNinja -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  cd deepin-screensaver
  DESTDIR="$pkgdir" cmake --install build
}
