# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-screensaver
pkgver=6.5.8
pkgrel=1
pkgdesc='Deepin screensaver viewer and tools'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-screensaver"
license=('GPL-3.0-or-later')
depends=('deepin-qt-dbus-factory' 'dtkcore' 'dtkwidget' 'qt5-base' 'qt5-declarative'
         'qt5-quickcontrols2' 'qt5-x11extras' 'libx11' 'libxcb' 'libxss' 'libxext' 'xscreensaver'
         'glibc' 'libgcc' 'libstdc++')
makedepends=('git' 'cmake' 'ninja' 'qt5-tools' 'deepin-desktop-base')
groups=('deepin')
source=("git+https://github.com/linuxdeepin/deepin-screensaver.git#tag=$pkgver")
sha512sums=('09f4ec57a345648f3f10791a97560e488fd8d226cc6ac1eb2b74724456d0da98daa3b3ec474f95b38af44e86de17a2face7d309f10a72c2e4a0b5fba93d08da9')

prepare() {
  cd deepin-screensaver

  # Upstream uses QEvent::Type in dbusscreensaver.h without including QEvent.
  sed -i '/^#include <QObject>$/a #include <QEvent>' src/dbusscreensaver.h

  sed -i 's|/etc/os-version|/etc/deepin-version|' common.pri
}

build() {
  cd deepin-screensaver
  cmake -B build -S . -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DQT_VERSION_MAJOR=5
  cmake --build build
}

package() {
  cd deepin-screensaver
  DESTDIR="$pkgdir" cmake --install build
}
