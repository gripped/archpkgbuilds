# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=deepin-font-manager
pkgver=6.5.32
pkgrel=1
pkgdesc='A font management tool for Deepin desktop'
arch=('x86_64')
url="https://github.com/linuxdeepin/deepin-font-manager"
license=('GPL-3.0-or-later')
depends=('dtk6core' 'dtk6gui' 'dtk6widget' 'qt6-base' 'qt6-svg' 'fontconfig' 'freetype2' 'glibc' 'libgcc' 'libstdc++' 'hicolor-icon-theme')
makedepends=('git' 'cmake' 'deepin-file-manager' 'ninja' 'qt6-tools' 'clang')
optdepends=('deepin-file-manager: font preview in file manager')
groups=('deepin-extra')
source=("git+https://github.com/linuxdeepin/deepin-font-manager.git#tag=$pkgver")
sha512sums=('457c54da87f43fa9c680b48c6d9e617afcf9f06835436b3ac4bd20a55babe76dc95d3b015aca9f246473599da8ac81dce6ac59b7fbb0d6f73cdb61901c455819')

prepare() {
  cd deepin-font-manager

  # Fix stale dfm-base references after upstream switched the lookup to dfm6-base.
  sed -i \
    -e 's/if (dfm-base_FOUND)/if (dfm${DTK_VERSION}-base_FOUND)/g' \
    -e 's/${dfm-base_INCLUDE_DIRS}/${dfm${DTK_VERSION}-base_INCLUDE_DIR}/g' \
    -e 's/list(APPEND LIBS dfm-base)/list(APPEND LIBS ${dfm${DTK_VERSION}-base_LIBRARIES})/' \
    -e 's/elseif(dde-file-manager_FOUND)/elseif(DeepinFileManager_FOUND)/' \
    deepin-font-preview-plugin/CMakeLists.txt
}

build() {
  cd deepin-font-manager
  cmake -GNinja . -DPLUGIN_INSTALL_DIR=  -DCMAKE_INSTALL_PREFIX=/usr
  ninja
}

package() {
  cd deepin-font-manager
  DESTDIR="$pkgdir" ninja install
}
