# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-gdstk
pkgver=1.0.1
pkgrel=1
pkgdesc="Python module for creating GDSII stream files, usually CAD layouts"
url="https://github.com/heitzmann/gdstk"
license=('BSL-1.0')
arch=('x86_64')
depends=('python-numpy' 'qhull')
makedepends=('git' 'python-build' 'python-installer' 'python-wheel' 'python-scikit-build-core' 'cmake')
checkdepends=('python-pytest')
source=("git+https://github.com/heitzmann/gdstk.git#tag=v$pkgver")
sha512sums=('8169abc0cda9b17e9ed4604806293b71c88eee43e17f66a287d71200d651a55f66c928fd2cd7a49c99e4d8ab7c47bb9cca44768f79537ba1282b753994365ba5')

build() {
  cd gdstk
  python -m build --wheel --no-isolation
}

check() {
  cd gdstk
  python -m venv --system-site-packages test-env
  test-env/bin/python -m installer dist/*.whl
  cd tests
  ../test-env/bin/python -m pytest
}

package() {
  cd gdstk
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}
