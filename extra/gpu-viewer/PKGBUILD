# Maintainer: Dan Johansen <strit@archlinux.org>

pkgname=gpu-viewer
_pkgname=GPU-Viewer
pkgver=4.04
pkgrel=1
pkgdesc="A frontend to glxinfo and vulkaninfo."
arch=('i686' 'x86_64' 'aarch64')
url="https://github.com/arunsivaramanneo/$_pkgname/"
license=('GPL-3.0-or-later')
depends=(
        'gtk4'
        'libadwaita'
        'python'
        'python-cairo'
        'python-gobject'
        'vulkan-tools'
        'clinfo'
        'mesa-utils'
        'vdpauinfo'
        'xorg-xdpyinfo'
        'lsb-release'
)
makedepends=(
            'meson'
            'ninja'
)
checkdepends=(
             'appstream'
             'desktop-file-utils')
optdepends=(
            'nvidia: Vulkan nvidia driver'
            'mesa'
            'orchis-theme: Preferred GTK theme'
            'vulkan-radeon: Vulkan AMD drivers'
            'vulkan-intel: Vulkan Intel drivers'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")

build() {
    cd "$_pkgname-$pkgver"
    meson setup -D prefix=/usr _build
}

check() {
    cd $_pkgname-$pkgver
    appstreamcli validate --no-net data/*.metainfo.xml
    desktop-file-validate data/*.desktop
}

package() {
    cd "$_pkgname-$pkgver/_build"
    DESTDIR="$pkgdir" ninja install
}

sha256sums=('5b104d6d50a23e0936ed7a53b1d1a46004fa0711a413b36f632746a8dffe1771')
