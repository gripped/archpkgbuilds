# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=rsop-oct
_name=${pkgname/-*}
pkgver=0.1.6
pkgrel=1
pkgdesc="Stateless OpenPGP (SOP) CLI tool for OpenPGP card devices based on rPGP and rpgpie"
arch=(x86_64)
url="https://codeberg.org/heiko/rsop"
license=(
  'Apache-2.0 OR MIT'
  CC0-1.0
)
groups=(stateless-openpgp)
depends=(
  dbus
  glibc
  libgcc
)
makedepends=(
  pcsclite
  rust
)
source=(
  $pkgname-$pkgver.tar.gz::$url/archive/$pkgname/v$pkgver.tar.gz
)
sha512sums=('6174a7326c0cf9d15e0e247aa073ec5ff519e5976cfde30e2493162cdd1dc3ed6629ee406069bcc2c3716ede2f32c31c8697590bfa3237e148fe538196505ace')
b2sums=('d2794d21d4c1d2ecd6c617d9bbee6350f38f06278728a8b71673957a931fe2202e2b5d001bb8f86a703d9b7356f8fd564bf3aa1fc21fa0513d1e5fcb86b27764')

prepare() {
  cd $_name
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $_name
  cargo build -p $pkgname --frozen --release --all-features
}

check() {
  cd $_name
  cargo test -p $pkgname --frozen --all-features
}

package() {
  depends+=(
    pcsclite libpcsclite.so
  )

  cd $_name
  install -vDm 0755 "target/release/rsoct" -t "$pkgdir/usr/bin/"
  install -vDm 0644 LICENSES/MIT.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
