# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=rsop-oct
_name=${pkgname/-*}
pkgver=0.1.7
pkgrel=1
pkgdesc="Stateless OpenPGP (SOP) CLI tool for OpenPGP card devices based on rPGP and rpgpie"
arch=(x86_64)
url="https://codeberg.org/heiko/rsop"
license=(
  'Apache-2.0 OR MIT'
  CC0-1.0
)
groups=(stateless-openpgp)
depends=(
  dbus
  glibc
  libgcc
)
makedepends=(
  pcsclite
  rust
)
source=(
  $pkgname-$pkgver.tar.gz::$url/archive/$pkgname/v$pkgver.tar.gz
)
sha512sums=('b58d9c2c671b4293d40117940ca6d9aad916aa26487820f632175e38ea18cde7cc2e12957e7245ab65b3df572734c47a89e1f4658c316e1ca14ef5496dd6fdb5')
b2sums=('a4e210848a6207a183f914e3cbbc8c2b88bf178ea74e2eb21f9a9a153ea9c531ca9850de2f6156d121fcffb136d58aa51cc0905d3b48bf8d5fe65509ac619b97')

prepare() {
  cd $_name
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $_name
  cargo build -p $pkgname --frozen --release --all-features
}

check() {
  cd $_name
  cargo test -p $pkgname --frozen --all-features
}

package() {
  depends+=(
    pcsclite libpcsclite.so
  )

  cd $_name
  install -vDm 0755 "target/release/rsoct" -t "$pkgdir/usr/bin/"
  install -vDm 0644 LICENSES/MIT.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
