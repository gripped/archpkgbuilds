pkgname=pantheon-videos
pkgver=9.0.0
pkgrel=1
pkgdesc='The Pantheon Video Player'
arch=(x86_64)
url='https://github.com/elementary/videos'
license=(GPL-3.0-only)
groups=(pantheon)
depends=(
  dconf
  gdk-pixbuf2
  glib2
  glibc
  gst-plugins-base-libs
  gstreamer
  gtk4
  hicolor-icon-theme
  libadwaita-1.so
  libgee
  libgranite-7.so
)
makedepends=(
  cmake
  git
  intltool
  meson
  vala
)
optdepends=(
  'gst-plugins-base: "Base" plugin libraries'
  'gst-plugins-good: "Good" plugin libraries'
  'gst-plugins-bad: "Bad" plugin libraries'
  'gst-plugins-ugly: "Ugly" plugin libraries'
)
source=(pantheon-videos::git+https://github.com/elementary/videos.git#tag=${pkgver})
b2sums=('705c0a8b76c4fdaea6d0dd1f8ec729a261a9c9d21f4caa0693bc7a3fd57dfb0698b81d23c4e0428b111f803e9757b9ef55156f9a839cac4dfc70da84ea4da067')

build() {
  arch-meson pantheon-videos build
  ninja -C build
}

package() {
  DESTDIR="${pkgdir}" ninja -C build install
}

