# Maintainer: George Rawlinson <grawlinson@archlinux.org>

pkgname=ruby-mize
_pkgname="${pkgname#ruby-}"
pkgver=0.8.0
pkgrel=1
pkgdesc='Memoize methods/functions in Ruby'
arch=(any)
url='https://github.com/flori/mize'
license=(MIT)
depends=(ruby)
makedepends=(git ruby-rake)
options=(!emptydirs)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('74f2e4c448bd5a3a5614f601474effb3f00de794bb66af51a3ce617fb908df0ece0143b40fa5f74e97d5873d03cc30ac24d2cf88a7900a8dc75f423dd4d77cdf')
b2sums=('e2b3792579cfc1098dba4fc477f7a1bc284d06d164b65a09fb7b82e22e5e99897e2505d50df6253bd660fc9478c28472b74c65edf0abb100257cd54576610b56')

build() {
  cd "$pkgname"

  gem build mize.gemspec
}

package() {
  cd "$pkgname"

  local _gemdir="$(ruby -e'puts Gem.default_dir')"

  gem install \
    --local \
    --verbose \
    --ignore-dependencies \
    --no-user-install \
    --install-dir "$pkgdir/$_gemdir" \
    --bindir "$pkgdir/usr/bin" \
    "$_pkgname-$pkgver.gem"

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
