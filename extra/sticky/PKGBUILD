# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=sticky
pkgver=1.35
pkgrel=1
pkgdesc='Sticky notes app for the Linux desktop'
arch=(any)
url='https://github.com/linuxmint/sticky'
license=(GPL-2.0-or-later)
groups=(x-apps)
depends=(
  bash
  dconf
  glib2
  gspell
  gtk3
  hicolor-icon-theme
  pango
  python
  python-gobject
  python-xapp
  xapp
)
makedepends=(
  git
  meson
)
source=("git+https://github.com/linuxmint/sticky.git#tag=$pkgver")
b2sums=(bdb69dfe1d6d49d4db0f9fd6928ae7c5c6d323b66627eb44485b56d83f24ec30daaeabd7a245a30a89462bf20d8d03182208b63e9cecf3da85845ca51b26e8d9)

prepare() {
  cd $pkgname

  # Set version number
  sed -i "s/__DEB_VERSION__/$pkgver/" usr/lib/sticky/sticky.py
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
