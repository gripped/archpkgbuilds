# Maintainer: Balló György <ballogyor+arch at gmail dot com>

pkgname=sticky
pkgver=1.32
pkgrel=1
pkgdesc='Sticky notes app for the Linux desktop'
arch=(any)
url='https://github.com/linuxmint/sticky'
license=(GPL-2.0-or-later)
groups=(x-apps)
depends=(
  bash
  dconf
  glib2
  gspell
  gtk3
  hicolor-icon-theme
  pango
  python
  python-gobject
  python-xapp
  xapp
)
makedepends=(
  git
  meson
)
source=("git+https://github.com/linuxmint/sticky.git#tag=$pkgver")
b2sums=(d2895319043611857e24c29d63e164684aef95da302c470989451ce9735af79569a38e99acf50d6daeb2294f53465c1bcf764952baa9007b45f455f19b269cb0)

prepare() {
  cd $pkgname

  # Set window icon
  # https://github.com/linuxmint/sticky/pull/168
  sed -i '/Gtk.Application.do_activate(self)/a\        Gtk.Window.set_default_icon_name("sticky")' usr/lib/sticky/sticky.py

  # Set version number
  sed -i "s/__DEB_VERSION__/$pkgver/" usr/lib/sticky/sticky.py
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
}
