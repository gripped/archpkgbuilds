# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=python-pyreqwest
pkgver=0.15.1
pkgrel=1
pkgdesc='Rust-based HTTP client for Python'
arch=('x86_64')
url='https://github.com/MarkusSintonen/pyreqwest'
license=('Apache-2.0')
depends=('ca-certificates' 'glibc' 'libgcc' 'python' 'zstd')
makedepends=('cargo' 'cmake' 'git' 'python-build' 'python-installer' 'python-maturin')
checkdepends=(
  'python-cryptography'
  'python-dirty-equals'
  'python-docker'
  'python-granian'
  'python-httpx'
  'python-multidict'
  'python-pydantic'
  'python-pytest'
  'python-pytest-asyncio'
  'python-requests-toolbelt'
  'python-starlette'
  'python-syrupy'
  'python-trustme'
  'python-yarl'
)
optdepends=(
  'python-httpx: HTTPX transport integration'
  'python-pytest: HTTP client mocking plugin'
)
# GCC LTO objects lose AWS-LC symbols when linked by Rust.
# https://github.com/rust-lang/rust/issues/138681
options=('!lto')
source=("git+https://github.com/MarkusSintonen/pyreqwest.git#tag=v$pkgver")
sha512sums=('b06e0aac9e5bcf0fbe8e9b050b90ada764f9ab9faef0132214a42c9a37261839d9a8f32ee675e5e01ba908e53e079cb0d26ddb93458ff955c115652b67ed4d2a')

prepare() {
  cd pyreqwest
  # Match pytest 9.2's diff legend in assertion snapshots.
  # https://github.com/pytest-dev/pytest/pull/14756
  sed -i 's/Full diff:$/Full diff: (-: missing in left side, +: extra in left side)/' \
    tests/pytest_mock/__snapshots__/test_mock_assert.ambr
  # Fix jitterentropy builds with optimized CFLAGS and newer cc versions.
  # https://github.com/aws/aws-lc-rs/pull/1254
  cargo update -p aws-lc-rs --precise 1.18.2
  cargo update -p aws-lc-sys --precise 0.46.0
  cargo fetch --locked
}

build() {
  cd pyreqwest
  ZSTD_SYS_USE_PKG_CONFIG=1 python -m build --wheel --no-isolation \
    -C build-args='--frozen --compatibility linux'
}

check() {
  cd pyreqwest
  python -m venv --system-site-packages --without-pip test-env
  test-env/bin/python -m installer dist/*.whl
  # The examples require a running Docker daemon, unavailable in the build chroot.
  test-env/bin/python -m pytest --ignore=tests/test_examples.py
  # Verify plugin discovery without imports from the rest of the suite.
  test-env/bin/python -m pytest tests/pytest_mock/test_plugin_external.py
}

package() {
  cd pyreqwest
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
