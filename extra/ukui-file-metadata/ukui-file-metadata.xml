<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/wps-office.uof">
    <comment>Uniform Office Format document</comment>
    <sub-class-of type="application/xml"/>
    <glob pattern="*.uof"/>
  </mime-type>
  <mime-type type="application/wps-office.uop">
    <comment>Uniform Office Format presentation</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.uop"/>
  </mime-type>
  <mime-type type="application/wps-office.uos">
    <comment>Uniform Office Format spreadsheet</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.uos"/>
  </mime-type>
  <mime-type type="application/wps-office.uot">
    <comment>Uniform Office Format text document</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.uot"/>
  </mime-type>
  <mime-type type="application/wps-office.uot3">
    <comment>Uniform Office Format text document</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.uot3"/>
  </mime-type>
</mime-info>
