# Maintainer: Jakub Klinkovský <lahwaacz at archlinux dot org>

pkgbase=nvtx
pkgname=(nvtx python-nvtx)
pkgver=3.5.0
pkgrel=1
pkgdesc="NVIDIA Tools Extension (NVTX) library"
url="https://nvidia.github.io/NVTX/"
arch=(x86_64)
license=("Apache-2.0 WITH LLVM-exception")
makedepends=(
  cmake
  cython
  git
  python-build
  python-installer
  python-setuptools
  python-wheel
)
source=($pkgbase::git+https://github.com/NVIDIA/NVTX.git#tag=v$pkgver)
b2sums=('1e2b991c0ac647c585f863bbf5892b4a8e17a115aa6918353f86490873979378db8182f0136e5debd8ffee4296039658e1d989bc679e638351684fa0a593ff97')

build() {
  # Build the C/C++ API (header-only)
  local cmake_options=(
    -B build
    -S $pkgbase/c
    -W no-dev
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_INSTALL_PREFIX=/usr
  )
  cmake "${cmake_options[@]}"
  cmake --build build

  # Build the Python API
  cd $pkgbase/python
  python -m build --wheel --no-isolation
}

package_nvtx() {
  # The package is header-only, but commitpkg does not support overriding arch
  # https://gitlab.archlinux.org/archlinux/devtools/-/issues/305
  #arch=(any)
  provides=(nvtx3)
  replaces=(nvtx3)

  DESTDIR="$pkgdir" cmake --install build

  # Install the license
  install -vDm 644 $pkgbase/LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname/
}

package_python-nvtx() {
  pkgdesc+=" - Python bindings"
  depends=(
    glibc
    python
  )
  optdepends=(
    'python-matplotlib: additional colors support'
    'python-numpy: typing annotations'
  )

  cd $pkgbase/python
  python -m installer --destdir="$pkgdir" dist/*.whl

  # Install the license
  install -vDm 644 LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname/
}
