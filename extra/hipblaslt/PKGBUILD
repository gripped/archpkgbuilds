pkgname=hipblaslt
pkgver=10.1
pkgrel=1
pkgdesc='General matrix-matrix operations beyond a traditional BLAS library'
arch=('x86_64')
url='https://rocm.docs.amd.com/projects/hipBLASLt/en/latest/index.html'
license=('MIT')
depends=(
  'comgr'
  'fmt'
  'glibc'
  'hip-runtime-amd'
  'rocm-openmp'
  'hipblas-common'
  'libgcc'
  'libstdc++'
  'rocm-core'
  'amdsmi'
  'roctracer'
  'yaml-cpp'
  'zlib'
)
makedepends=(
  'cmake'
  'gcc-fortran'
  'git'
  'gtest'
  'lapack'
  'msgpack-cxx'
  'ninja'
  'python'
  'python-joblib'
  'python-msgpack'
  'python-orjson'
  'python-packaging'
  'python-pyaml'
  'python-pyyaml'
  'python-setuptools'
  'python-simplejson'
  'python-ujson'
  'rocm-cmake'
  'rocm-toolchain'
  'rocm-llvm'
  'spdlog'
)
_git='https://github.com/ROCm/rocm-libraries'
# The hipblaslt release tarball lacks shared/rocroller, shared/origami,
# shared/stinkytofu and cmake/modules
source=("rocm-libraries::git+$_git.git#tag=therock-$pkgver"
        "hipblaslt-Don-t-fetch-deps-for-rocroller.patch"
        "rocroller-Always-fetch-libdivide-if-it-s-not-install.patch"
        "hipblaslt-7.2.3-cstdint-include.patch")
sha256sums=('2fe2463c0b4344e30f563eb3ee4a94d9426c54d8747d76df15a4ae8018abd6f2'
            '81c0f9ac1872e34555c2f9d64eecec75c42fd8813c4acf54cd665b03e59cb752'
            'b845a96fee02651f2cad2417fc9e8522ab143849b2049b0010d17401e6000e52'
            '337feb845674f8ec6015c902b27bd01bc51f530035cda769b7dea5ad12d41920')
_dirname="rocm-libraries/projects/$pkgname"

prepare() {
  cd rocm-libraries
  patch -Np1 -i "$srcdir/hipblaslt-Don-t-fetch-deps-for-rocroller.patch"
  patch -Np1 -i "$srcdir/rocroller-Always-fetch-libdivide-if-it-s-not-install.patch"
  patch -Np1 -i "$srcdir/hipblaslt-7.2.3-cstdint-include.patch"
  # Keep stinkytofu assertions for CMAKE_BUILD_TYPE=None, as for Release
  sed -i 's/^    CMAKE_CXX_FLAGS_RELEASE$/&\n    CMAKE_CXX_FLAGS_NONE/' \
    shared/stinkytofu/CMakeLists.txt
}

build() {
  export PATH="/opt/rocm/bin:$PATH"

  local cmake_args=(
    -Wno-dev
    -G Ninja
    -B build
    -S "$_dirname"
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_C_COMPILER=amdclang
    -D CMAKE_CXX_COMPILER=amdclang++
    # rocisa asserts on macro body items that Release builds skip
    -D CMAKE_CXX_FLAGS_NONE=-DNDEBUG
    -D CMAKE_INSTALL_PREFIX=/opt/rocm
    -D HIPBLASLT_ENABLE_CLIENT=OFF
    # Exclude the targets missing from SUPPORTED_ARCHITECTURES in
    # cmake/tensilelite_supported_architectures.cmake. Add gfx908 and gfx90a,
    # which gfx9-generic does not cover.
    -D GPU_TARGETS="$(rocm-supported-gfx -e gfx9-generic,gfx1010,gfx1012,gfx1030,gfx1031,gfx1035,gfx1036,gfx1170);gfx908;gfx90a"
  )
  # -fcf-protection is not supported by HIP, see
  # https://rocm.docs.amd.com/projects/llvm-project/en/latest/reference/rocmcc.html#support-status-of-other-clang-options
  CXXFLAGS="${CXXFLAGS} -fcf-protection=none" cmake "${cmake_args[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$_dirname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
