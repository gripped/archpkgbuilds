pkgname=libre
pkgver=4.6.0
pkgrel=2
pkgdesc="Portable library for real-time communications"
arch=('x86_64')
url="https://github.com/baresip/re"
license=('BSD-3-Clause')
depends=('openssl' 'zlib')
makedepends=('cmake')
replaces=('re' 'librem')
conflicts=('re' 'librem')
provides=(libre.so)
source=(
  "${pkgname}-${pkgver}.tar.gz"::"https://github.com/baresip/re/archive/v${pkgver}.tar.gz"
  libre-openssl4.patch
)
sha256sums=('811f19ed3df60f75070c07fc0eb5f767574e5b6dc2f12a679df04df381a43d88'
            'fc79faab67f9fcf0b1e8c25297bcdc5f6c6d6e11edafd8c06bb6816c4ae11009')

prepare() {
  cd re-${pkgver}

  # Carry the upstream OpenSSL 4 compatibility series through the const fix.
  # https://github.com/baresip/re/pull/1565
  # https://github.com/baresip/re/pull/1569
  # https://github.com/baresip/re/pull/1570
  # https://github.com/baresip/re/pull/1572
  # OpenSSL 4.1 no longer checks CN by default; retain libre's existing CN-only behavior.
  patch -Np1 -i ../libre-openssl4.patch
}

build() {
  cd re-${pkgver}
  cmake -B build -DCMAKE_BUILD_TYPE='None' -DCMAKE_INSTALL_PREFIX='/usr' -Wno-dev
  cmake --build build
}

check() {
  cd re-${pkgver}
  cmake --build build --parallel -t retest
	build/test/retest -rv
}

package() {
  cd re-${pkgver}
  DESTDIR="$pkgdir" cmake --install build
  install -vDm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
