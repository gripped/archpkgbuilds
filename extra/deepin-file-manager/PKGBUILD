sha512sums=('f7fbc31746b542a0e77425eda4426960ddee895ec0e6ee9f05cdaf16b50d391675142377e5dbd97fc6d87c4ce4521e46c54598f8983180bbb247b391f7c78516'
            'b2cda989438b90703a5718ac0daf5972f4d70e21ceef5ad9751445178c4299200f8ac3be112e79682bd37b751e6e3fbd3aaef4189adaaf9abe2506132c16ab41')

prepare() {
  cd dde-file-manager
  patch -p1 -i ../gcc-15.patch

  # Migrate search/TextIndex from PCRE1 to PCRE2:
  # https://github.com/linuxdeepin/dde-file-manager/commit/682dffd359abdf42329f03a1cb0ca666eb3a328d
  git cherry-pick -n 682dffd359abdf42329f03a1cb0ca666eb3a328d

  # Fix the extra quote in the moved workspace plugin include.
  sed -i 's|"utils/filedatamanager.h""|"utils/filedatamanager.h"|' \
    src/plugins/filemanager/dfmplugin-workspace/events/workspaceeventreceiver.cpp

  # Qualify DConfig path constants after upstream moved them out of dfmbase.
  sed -i \
    -e 's|kPluginsDConfName|GlobalDConfDefines::ConfigPath::kPluginsDConfName|g' \
    -e 's|dfmbase::kDefaultCfgPath|GlobalDConfDefines::ConfigPath::kDefaultCfgPath|g' \
    src/apps/dde-desktop/main.cpp

  # Upstream regenerates checked-in DBus XML files while other targets consume them,
  # which creates Ninja dependency cycles with globbed sources.
  sed -i '/qt5_generate_dbus_interface/,/)/d' \
    src/plugins/daemon/daemonplugin-core/CMakeLists.txt \
    src/plugins/daemon/daemonplugin-tag/CMakeLists.txt \
    src/plugins/daemon/daemonplugin-vault/CMakeLists.txt

  # Build against Qt5, whose translation tools are shipped as versioned binaries.
  sed -i \
    -e 's|COMMAND lupdate|COMMAND /usr/bin/lupdate-qt5|g' \
    -e 's|COMMAND lrelease|COMMAND /usr/bin/lrelease-qt5|g' \
    src/plugins/filemanager/dfmplugin-disk-encrypt-entry/CMakeLists.txt
  sed -i 's|\<lrelease\>|/usr/bin/lrelease-qt5|' src/translate_generation.sh

}

build() {
  # cmake confused with glob files, see https://github.com/linuxdeepin/developer-center/issues/5158
  cmake -GNinja -B build -S dde-file-manager \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_LIBEXECDIR=lib/dde-file-manager \
    -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DOPT_ENABLE_QT6=OFF \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
  cd build
  ninja
}

package() {
  cd build
  DESTDIR="$pkgdir" ninja install
}
