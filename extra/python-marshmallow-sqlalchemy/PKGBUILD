# Maintainer: Maxime Gauduin <alucryd@archlinux.org>

pkgname=python-marshmallow-sqlalchemy
pkgver=1.6.0
pkgrel=1
pkgdesc='SQLAlchemy integration with marshmallow'
url=https://marshmallow-sqlalchemy.readthedocs.io/
arch=(any)
license=(MIT)
depends=(
  python-marshmallow
  python-sqlalchemy
)
makedepends=(
  git
  python-build
  python-flit-core
  python-installer
)
source=(git+https://github.com/marshmallow-code/marshmallow-sqlalchemy.git#tag=${pkgver})
b2sums=('0790f0aa0667b369235f2457978e6d157647110075cf53f931b8b76971815bd38109b5e5de4d9d0b3dd940647559348528a1855235bcd7c23e5b4197bf129632')

prepare() {
  cd marshmallow-sqlalchemy
  # System has flit-core 4; upstream pins <4 — widen the constraint
  sed -i 's/flit_core<4/flit_core>=3.2/' pyproject.toml
}

build() {
  cd marshmallow-sqlalchemy
  python -m build --wheel --no-isolation
}

package() {
  python -m installer --destdir="${pkgdir}" marshmallow-sqlalchemy/dist/*.whl
  install -Dm 644 marshmallow-sqlalchemy/LICENSE -t "${pkgdir}"/usr/share/licenses/python-marshmallow-sqlalchemy/
}

# vim: ts=2 sw=2 et:
